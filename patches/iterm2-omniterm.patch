+    // Resume opens a real tab in the session's folder through the login
+    // shell, tagged with the session, and the page then offers Show Tab. A
+    // harmless command stands in for the provider's CLI.
+    func testResumeOpensATabInTheSessionsFolder() throws {
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent("omni-resume-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        OmniSidebarViewController.resumeCommandForTesting = "touch resumed; sleep 60"
