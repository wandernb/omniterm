+@implementation OmniScheduler {
+    // All database and schedule work runs here so that a busy main thread
+    // cannot starve clients, and scheduler work cannot stall terminal drawing.
+    // SQLite is opened with SQLITE_OPEN_FULLMUTEX.
+    dispatch_queue_t _queue;
+    // Run report captures run here, one at a time and in order, so a later
+    // capture of the same run always lands after an earlier one.
+    dispatch_queue_t _captureQueue;
+    // Indexing and inference cannot occupy the scheduling queue. Only the
+    // native process writes knowledge.sqlite; its worker holds a memory cache.
+    dispatch_queue_t _knowledgeQueue;
+    // Knowledge requests from people and agents waiting for the queue. The
+    // indexing tick yields to them between its worker calls, so a request
+    // waits for at most one call rather than a whole tick.
+    atomic_int _knowledgeWaiters;
+    // The dispatch memory-pressure level (0 normal, 1 warning, 2 critical).
+    atomic_int _knowledgePressure;
+    dispatch_source_t _knowledgePressureSource;
+    // Indexing tick state, touched only on the knowledge queue.
+    OmniKnowledgeBudget _tickBudget;
+    BOOL _tickBudgeted;
+    double _tickStarted;
+    NSUInteger _tickWriteBytes;
+    NSString *_tickYield;
+    double _lastKnowledgeTick;
+    NSInteger _knowledgePhase;
+    NSInteger _relievedPressure;
+    // The worker still holds writes this scheduler has not saved: no new work is
+    // produced until they are, so its pending set stays bounded.
+    BOOL _knowledgeBackpressure;
+    unsigned long long _knowledgeSavedBytes;
+    unsigned long long _knowledgeSkippedWrites;
+    unsigned long long _knowledgeTicks;
+}
