+// Requests run on the main thread, so an exception here would abort the whole
+// terminal and every session in it. No client input may be able to do that.
+- (NSDictionary *)responseForRequest:(id)request {
+    if (![request isKindOfClass:[NSDictionary class]]) {
+        return @{ @"ok": @NO, @"error": @"Request must be a JSON object" };
+    }
+    // JSON null decodes to NSNull, which survives nil checks and then throws.
+    NSMutableDictionary *arguments = [[request mutableCopy] autorelease];
+    [arguments removeObjectsForKeys:[arguments allKeysForObject:[NSNull null]]];
+    @try {
+        return [self handleRequest:arguments];
+    } @catch (NSException *exception) {
+        NSLog(@"OmniScheduler rejected request %@: %@", arguments[@"op"], exception);
+        return @{ @"ok": @NO, @"error": @"Malformed request" };
+    }
+}
+
+- (NSDictionary *)handleRequest:(NSDictionary *)request {
+    NSString *operation = request[@"op"];
+    if ([@[ @"runner_loop_poll", @"runner_loop_claim", @"runner_loop_ack" ] containsObject:operation ?: @""]) {
+        NSString *runID = [request[@"run_id"] isKindOfClass:NSString.class] ? request[@"run_id"] : @"";
+        NSDictionary *run = [self rowsForSQL:@"SELECT * FROM runs WHERE id=?" bindings:@[ runID ]].firstObject;
+        if (![run[@"state"] isEqual:@"running"]) return @{ @"ok": @NO, @"error": @"Loop run is not running" };
+        NSString *token = [run[@"loop_token"] isKindOfClass:NSString.class] ? run[@"loop_token"] : nil;
+        NSString *state = [run[@"loop_state"] isKindOfClass:NSString.class] ? run[@"loop_state"] : @"none";
+        if ([operation isEqual:@"runner_loop_ack"]) {
+            if ([request[@"token"] isKindOfClass:NSString.class] && [run[@"loop_ack_token"] isEqual:request[@"token"]]) return @{ @"ok": @YES };
+            if (!token || ![token isEqual:request[@"token"]] || ![state isEqual:@"claimed"]) return @{ @"ok": @NO, @"error": @"No matching claimed loop turn" };
+            // The previous turn becomes a run of its own and the live run starts
+            // the next one, all or nothing.
+            if (![self execute:@"BEGIN IMMEDIATE"]) return @{ @"ok": @NO, @"error": @"Loop turn could not be recorded" };
+            const BOOL acknowledged = [self recordFinishedLoopTurnOfRun:run] &&
+                [self runSQL:@"UPDATE runs SET loop_ack_token=?,agent_snapshot=loop_agent,loop_token=NULL,loop_state=NULL,loop_agent=NULL,turn_finished=0,wrap_up_input=NULL,compact_input=NULL,finish_input=NULL WHERE id=?" bindings:@[ token, runID ]];
+            [self execute:acknowledged ? @"COMMIT" : @"ROLLBACK"];
+            if (acknowledged) [self captureStartOfRun:runID workspace:[self workspaceOfRun:run]];
+            return @{ @"ok": @(acknowledged) };
+        }
+        NSString *agentJSON = [run[@"loop_agent"] isKindOfClass:NSString.class] ? run[@"loop_agent"] : nil;
+        NSDictionary *agent = agentJSON ? [NSJSONSerialization JSONObjectWithData:[agentJSON dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil] : nil;
