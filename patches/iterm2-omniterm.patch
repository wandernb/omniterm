+}
+
+// The Agents area as a tree. Agents and groups (two levels at most, `A` or
+// `A/B`) are siblings in one order at every level, saved as keys
+// (`agent:<name>`, `group:<path>`) in settings `sidebar_order`. Siblings the
+// saved order does not list follow: groups first (configured groups in their
+// order, then groups only named by agents, alphabetically), then agents,
+// alphabetically. Configured groups show even when empty.
+struct OmniGroupTree: Equatable {
+    enum Entry: Equatable {
+        case agent(String)
+        case group(Group)
+
+        var key: String {
+            switch self {
+            case .agent(let name): return OmniGroupTree.agentKey(name)
+            case .group(let group): return OmniGroupTree.groupKey(group.path)
+            }
+        }
+    }
+
+    struct Group: Equatable {
+        let path: String
+        var name: String {
+            return path.components(separatedBy: "/").last ?? path
+        }
+        var children: [Entry] = []
+
+        var subgroups: [Group] {
+            return children.compactMap { entry in
+                if case .group(let group) = entry { return group }
+                return nil
+            }
+        }
+
+        var agents: [String] {
+            return children.compactMap { entry in
+                if case .agent(let name) = entry { return name }
+                return nil
+            }
+        }
+    }
+
+    // The top level, in display order.
+    var entries: [Entry] = []
+
+    static let maximumDepth = 2
+
+    static func agentKey(_ name: String) -> String {
+        return "agent:\(name)"
+    }
+
+    static func groupKey(_ path: String) -> String {
+        return "group:\(path)"
+    }
+
+    // `A/B/C` is shown as `A/B`; blank components are dropped.
+    static func normalizedPath(_ path: String?) -> String {
+        let parts = (path ?? "").components(separatedBy: "/")
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { !$0.isEmpty }
+        return parts.prefix(maximumDepth).joined(separator: "/")
+    }
+
+    static func parent(of path: String) -> String {
+        let parts = path.components(separatedBy: "/")
+        return parts.count > 1 ? parts.dropLast().joined(separator: "/") : ""
+    }
+
+    init() {
+    }
+
+    init(agents: [(name: String, group: String?)], configured: [String], order: [String] = []) {
+        var groupOrder: [String] = []
+        func note(_ path: String) {
+            guard !path.isEmpty else { return }
+            let top = path.components(separatedBy: "/")[0]
+            if !groupOrder.contains(top) {
+                groupOrder.append(top)
+            }
+            if path != top, !groupOrder.contains(path) {
+                groupOrder.append(path)
+            }
+        }
+        for path in configured.map(Self.normalizedPath) {
+            note(path)
+        }
+        let derived = Set(agents.map { Self.normalizedPath($0.group) }).filter { !$0.isEmpty }
+        for path in derived.sorted(by: { $0.localizedStandardCompare($1) == .orderedAscending }) {
+            note(path)
+        }
+
+        var members: [String: [String]] = [:]
+        for agent in agents {
+            members[Self.normalizedPath(agent.group), default: []].append(agent.name)
+        }
+        var rank: [String: Int] = [:]
+        for (index, key) in order.enumerated() where rank[key] == nil {
+            rank[key] = index
+        }
+        func fallback(_ entry: Entry) -> (Int, Int, String) {
+            switch entry {
+            case .group(let group): return (0, groupOrder.firstIndex(of: group.path) ?? 0, "")
+            case .agent(let name): return (1, 0, name)
+            }
+        }
+        func sorted(_ entries: [Entry]) -> [Entry] {
+            return entries.sorted { left, right in
+                switch (rank[left.key], rank[right.key]) {
+                case let (l?, r?): return l < r
+                case (_?, nil): return true
+                case (nil, _?): return false
+                case (nil, nil):
+                    let (lk, li, ln) = fallback(left)
+                    let (rk, ri, rn) = fallback(right)
+                    if lk != rk { return lk < rk }
+                    if li != ri { return li < ri }
+                    return ln.localizedStandardCompare(rn) == .orderedAscending
+                }
+            }
+        }
+        func children(of path: String) -> [Entry] {
+            let subgroups = groupOrder.filter { Self.parent(of: $0) == path && (!path.isEmpty || !$0.contains("/")) }
+                .map { Entry.group(Group(path: $0, children: children(of: $0))) }
+            return sorted(subgroups + (members[path] ?? []).map { Entry.agent($0) })
+        }
+        entries = children(of: "")
+    }
+
+    var groups: [Group] {
+        return entries.compactMap { entry in
+            if case .group(let group) = entry { return group }
+            return nil
+        }
+    }
+
+    var ungrouped: [String] {
+        return entries.compactMap { entry in
+            if case .agent(let name) = entry { return name }
+            return nil
+        }
+    }
+
+    var allPaths: [String] {
+        return groups.flatMap { [$0.path] + $0.subgroups.map(\.path) }
+    }
+
+    // Every key in display order, depth first: what `sidebar_order` saves.
+    var displayKeys: [String] {
+        func keys(_ entries: [Entry]) -> [String] {
+            return entries.flatMap { entry -> [String] in
+                if case .group(let group) = entry {
+                    return [entry.key] + keys(group.children)
+                }
+                return [entry.key]
+            }
+        }
+        return keys(entries)
+    }
+
+    func group(_ path: String) -> Group? {
+        for group in groups {
+            if group.path == path {
+                return group
+            }
+            if let subgroup = group.subgroups.first(where: { $0.path == path }) {
+                return subgroup
+            }
+        }
+        return nil
+    }
+}
+
+// `omni agents order` for the scheduler: the sidebar's effective order (the
+// real tree, with its fallback for anything the saved order omits), with only
+// agent slots reordered within each parent. Named agents lead in the order
+// given; the others keep their order; groups and memberships never move.
+@objc(OmniSidebarOrdering)
+final class OmniSidebarOrdering: NSObject {
+    @objc(orderWithAgents:configuredGroups:savedOrder:names:)
+    static func order(agents: [[String: Any]], configuredGroups: [String], savedOrder: [String],
+                      names: [String]) -> [String] {
+        let members = agents.compactMap { agent -> (name: String, group: String?)? in
+            guard let name = agent["name"] as? String else { return nil }
+            return (name, agent["group"] as? String)
+        }
+        let tree = OmniGroupTree(agents: members, configured: configuredGroups, order: savedOrder)
+        func reorder(_ entries: [OmniGroupTree.Entry]) -> [OmniGroupTree.Entry] {
+            let agentNames = entries.compactMap { entry -> String? in
+                if case .agent(let name) = entry { return name }
+                return nil
+            }
+            var wanted: [String] = []
+            for name in names where agentNames.contains(name) && !wanted.contains(name) {
+                wanted.append(name)
+            }
+            var queue = wanted + agentNames.filter { !wanted.contains($0) }
+            return entries.map { entry in
+                switch entry {
+                case .agent:
+                    return .agent(queue.removeFirst())
+                case .group(var group):
+                    group.children = reorder(group.children)
+                    return .group(group)
+                }
+            }
+        }
+        var reordered = tree
+        reordered.entries = reorder(tree.entries)
+        return reordered.displayKeys
+    }
+}
+
+// What a drag in the Agents area changes, computed without touching the
+// view: the new orders to save and the group renames to send.
+enum OmniSidebarMoves {
+    // The saved order after dropping `key` before the sibling `before` (nil:
+    // after its last sibling). Siblings sort by their index in the list, so
+    // only their relative order matters; `renamed` maps a group key whose
+    // path changes in the same drop.
+    static func sidebarOrder(_ keys: [String], moving key: String, before: String?,
+                             renamed: (from: String, to: String)? = nil) -> [String] {
+        var result = moved(keys, key, before: before)
+        if let renamed {
+            result = result.map { $0 == renamed.from ? renamed.to : $0 }
+        }
+        return result
+    }
+
+    // Moves `name` before `before` (nil: to the end).
+    static func moved(_ list: [String], _ name: String, before: String?) -> [String] {
+        var result = list.filter { $0 != name }
+        if let before, let index = result.firstIndex(of: before) {
+            result.insert(name, at: index)
+        } else {
+            result.append(name)
+        }
+        return result
+    }
+
+    // The saved group order after moving `path` before the sibling `before`
+    // (nil: after its last sibling). Subgroups keep their place in the list;
+    // the tree reads their order among themselves.
+    static func groupOrder(_ paths: [String], moving path: String, before: String?) -> [String] {
+        var result = paths.filter { $0 != path }
+        if let before, let index = result.firstIndex(of: before) {
+            result.insert(path, at: index)
+            return result
+        }
+        let parent = OmniGroupTree.parent(of: path)
+        let lastSibling = result.lastIndex { OmniGroupTree.parent(of: $0) == parent &&
+            (parent.isEmpty ? true : $0.hasPrefix(parent + "/")) }
+        if let lastSibling {
+            // After the sibling and, for a top-level group, its subgroups.
+            var index = lastSibling + 1
+            if parent.isEmpty {
+                let siblingPath = result[lastSibling]
+                while index < result.count, result[index].hasPrefix(siblingPath + "/") {
+                    index += 1
+                }
+            }
+            result.insert(path, at: index)
+        } else {
+            result.append(path)
+        }
+        return result
+    }
+
+    // Terminals reorder by moving their tab. Given every tab in window order
+    // and the terminal tabs among them, the index PseudoTerminal's
+    // moveTabAtIndex:toIndex: wants (counted with the moving tab removed) to
+    // put `moving` before `before`, or after the last terminal; nil when the
+    // tab would not move.
+    static func tabDestination(tabs: [Int32], terminals: [Int32], moving: Int32, before: Int32?) -> Int? {
+        guard let from = tabs.firstIndex(of: moving) else { return nil }
+        let others = tabs.filter { $0 != moving }
+        let destination: Int
+        if let before, let index = others.firstIndex(of: before) {
+            destination = index
+        } else if let last = others.lastIndex(where: { terminals.contains($0) }) {
+            destination = last + 1
+        } else {
+            destination = others.count
+        }
+        guard destination != from else { return nil }
+        // Only the terminals' order matters to the sidebar.
+        var after = others
+        after.insert(moving, at: destination)
+        return after.filter { terminals.contains($0) } == tabs.filter { terminals.contains($0) } ? nil : destination
+    }
+
+    // The path a group gets when dropped into `target` ("" for the top
+    // level), or nil when that would nest deeper than two levels, collide,
+    // or change nothing.
+    static func regroupedPath(_ path: String, into target: String, tree: OmniGroupTree) -> String? {
+        let name = path.components(separatedBy: "/").last ?? path
+        let newPath = target.isEmpty ? name : "\(target)/\(name)"
+        guard newPath != path, target != path, !target.hasPrefix(path + "/") else { return nil }
+        guard newPath.components(separatedBy: "/").count <= OmniGroupTree.maximumDepth else { return nil }
+        // A group with subgroups cannot go one level down.
+        if !target.isEmpty, let group = tree.group(path), !group.subgroups.isEmpty {
+            return nil
+        }
+        if tree.allPaths.contains(newPath) {
+            return nil
+        }
+        return newPath
+    }
+}
+
+// Quick checks before a rename reaches the scheduler, which has the last word.
+enum OmniRenameRules {
+    static let maximumLength = 100
+    static let maximumGroupLength = 40
+
+    static func agentNameProblem(_ name: String, current: String, existing: [String]) -> String? {
+        let trimmed = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty {
+            return "A name is required."
+        }
+        // Code points, as the scheduler counts; only Cc controls are refused,
+        // so emoji joined with ZWJ stay allowed.
+        if trimmed.unicodeScalars.count > maximumLength {
+            return "Keep the name to \(maximumLength) characters."
+        }
+        if trimmed.unicodeScalars.contains(where: { $0.properties.generalCategory == .control }) {
+            return "The name cannot contain control characters."
+        }
+        if trimmed != current, existing.contains(trimmed) {
+            return "Another agent already has this name."
+        }
+        return nil
+    }
+
+    static func groupNameProblem(_ name: String, siblings: [String]) -> String? {
+        let trimmed = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty {
+            return "A name is required."
+        }
+        if trimmed.contains("/") {
+            return "Folder names cannot contain “/”."
+        }
+        if trimmed.unicodeScalars.count > maximumGroupLength {
+            return "Keep folder names to \(maximumGroupLength) characters."
+        }
+        if siblings.contains(trimmed) {
+            return "Another folder here already has this name."
+        }
+        return nil
+    }
+
+    // A fresh name such as “New Group 2” that no sibling uses.
+    static func uniqueName(_ base: String, siblings: [String]) -> String {
+        guard siblings.contains(base) else { return base }
+        var index = 2
+        while siblings.contains("\(base) \(index)") {
+            index += 1
+        }
+        return "\(base) \(index)"
+    }
+}
