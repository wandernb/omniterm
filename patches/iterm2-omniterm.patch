+- (void)testCodexCompactSubmitsEnterSeparatelyFromCommandText {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSMutableArray<NSString *> *writes = [NSMutableArray array];
+    [_scheduler setRunInputHandler:^BOOL(NSString *runID, NSString *text) {
+        @synchronized(writes) { [writes addObject:text]; }
+        return YES;
+    }];
+    NSDictionary<NSString *, NSArray<NSString *> *> *expected = @{
+        @"codex": @[ @"/compact", @"\r" ],
+        @"claude": @[ @"/compact\r" ],
+    };
+    for (NSString *provider in @[ @"codex", @"claude" ]) {
+        @synchronized(writes) { [writes removeAllObjects]; }
+        NSString *runID = [@"compact-" stringByAppendingString:provider];
+        [self insertIdleRun:runID provider:provider];
+        NSDictionary *request = @{ @"op": @"runner_input", @"run_id": runID, @"action": @"compact" };
+        XCTAssertEqualObjects([_scheduler responseForRequest:request][@"ok"], @YES);
+        XCTAssertEqualObjects([self settledCompactInputOfRun:runID], @"delivered");
+        NSArray<NSString *> *observed = nil;
+        @synchronized(writes) { observed = [writes copy]; }
+        XCTAssertEqualObjects(observed, expected[provider]);
+    }
+}
