+// MARK: - Folder
+
+// A sidebar folder: its subfolders and agents, each a row that selects it in
+// the sidebar, and the folder's commands.
+final class OmniFolderPane: OmniPane {
+    let path: String
+    private let scroll = OmniColumnScrollView()
+    private var lastSignature = ""
+    // What the page lists, in order: `group:<path>` and `agent:<name>` keys.
+    private(set) var listedKeys: [String] = []
+    private(set) var rows: [OmniFolderEntryRow] = []
+    // Its subfolders and agents; Return opens the selected one.
+    let entriesZone = OmniListZone()
+    private lazy var entriesColumn = makeListColumn(entriesZone)
+    private var buttonsZone: OmniButtonZone?
+
+    override var contentViews: [NSView] {
+        return [scroll]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return [entriesZone] + (buttonsZone.map { [$0] } ?? [])
+    }
+
+    init(path: String) {
+        self.path = path
+        super.init()
+        addSubview(scroll)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        scroll.frame = bounds
+    }
+
+    override func reload() {
+        var agentsResponse: [AnyHashable: Any]?
+        var settingsResponse: [AnyHashable: Any]?
+        var runsResponse: [AnyHashable: Any]?
+        let finish = { [weak self] in
+            guard let self, let agentsResponse, let settingsResponse, let runsResponse else { return }
+            self.render(agents: agentsResponse, settings: settingsResponse, runs: runsResponse)
+        }
+        OmniSchedulerClient.request(["op": "list_agents"]) { response in
+            agentsResponse = response
+            finish()
+        }
+        OmniSchedulerClient.request(["op": "get_settings"]) { response in
+            settingsResponse = response
+            finish()
+        }
+        OmniSchedulerClient.request(["op": "list_runs", "limit": 100, "include_live": true, "foreground": true, "loop_turns": 2]) { response in
+            runsResponse = response
+            finish()
+        }
+    }
+
+    private func render(agents agentsResponse: [AnyHashable: Any], settings settingsResponse: [AnyHashable: Any],
+                        runs runsResponse: [AnyHashable: Any]) {
+        guard Self.isOK(agentsResponse) else {
+            lastSignature = ""
+            showMessage(Self.unreachableMessage(agentsResponse))
+            return
+        }
+        let agentRows = agentsResponse["agents"] as? [[AnyHashable: Any]] ?? []
+        let settings = settingsResponse["settings"] as? [AnyHashable: Any] ?? [:]
+        let configured = settings["sidebar_groups"] as? [String] ?? []
+        let order = settings["sidebar_order"] as? [String] ?? []
+        let runRows = runsResponse["runs"] as? [[AnyHashable: Any]] ?? []
+        let minute = Int(Date().timeIntervalSince1970 / 60)
+        let signature = Self.signature(agentRows, configured, order, runRows, minute)
+        guard signature != lastSignature else { return }
+        lastSignature = signature
+
+        // Background agents (memory consolidation) are listed on the Memory
+        // page, not in folders.
+        let tree = OmniGroupTree(agents: agentRows.compactMap { row in
+            guard !OmniBackgroundAgents.isBackground(row) else { return nil }
+            return (row["name"] as? String).map { ($0, row["group"] as? String) }
+        }, configured: configured, order: order)
+        guard let group = tree.group(path) else {
+            listedKeys = []
+            rows = []
+            entriesZone.setItems([])
+            showMessage("This folder no longer exists.")
+            return
+        }
+        preservingZoneFocus {
+            rebuild(group: group, agentRows: agentRows, runRows: runRows)
+        }
+    }
+
+    private func rebuild(group: OmniGroupTree.Group, agentRows: [[AnyHashable: Any]], runRows: [[AnyHashable: Any]]) {
+        var agentsByName: [String: (OmniAgent, [AnyHashable: Any])] = [:]
+        for row in agentRows {
+            if let agent = OmniAgent(row) {
+                agentsByName[agent.name] = (agent, row)
+            }
+        }
+        // Runs come newest first.
+        var latestRun: [String: OmniRun] = [:]
+        for run in runRows.compactMap(OmniRun.init) where latestRun[run.agent] == nil {
+            latestRun[run.agent] = run
+        }
+
+        let column = scroll.column
+        let origin = scroll.contentView.bounds.origin
+        column.removeAll()
+        entriesColumn.removeAll()
+        rows = []
+        listedKeys = group.children.map(\.key)
+        column.addText(Self.title(group.name), spacing: 4)
+        let subfolderCount = group.subgroups.count
+        let agentCount = group.agents.count
+        var meta: [String] = []
+        if path.contains("/") {
+            meta.append(path.components(separatedBy: "/").joined(separator: " / "))
+        }
+        if subfolderCount > 0 {
+            meta.append(subfolderCount == 1 ? "1 subfolder" : "\(subfolderCount) subfolders")
+        }
+        meta.append(agentCount == 1 ? "1 agent" : "\(agentCount) agents")
+        column.addText(Self.meta(meta), spacing: 12)
+
+        let rename = OmniPaneText.button("Rename", target: self, action: #selector(rename(_:)))
+        let subfolder = OmniPaneText.button("New Subfolder", target: self, action: #selector(newSubfolder(_:)))
+        // Folders nest two levels deep at most.
+        subfolder.isHidden = path.contains("/")
+        let newAgent = OmniPaneText.button("New Agent Here", target: self, action: #selector(newAgent(_:)))
+        let delete = OmniPaneText.button("Delete Folder", target: self, action: #selector(deleteFolder(_:)))
+        delete.toolTip = "Its agents and subfolders move up a level; nothing is deleted with it."
+        let buttons = OmniButtonRow([rename, subfolder, newAgent, delete])
+        buttonsZone = buttons.zone
+        column.add(buttons, spacing: 12) { _ in 30 }
+
+        if group.children.isEmpty {
+            column.addText(OmniPaneText.label("This folder is empty.", color: OmniTheme.secondaryText))
+        }
+        var zoneItems: [(key: String, view: OmniZoneItem)] = []
+        if !group.subgroups.isEmpty {
+            entriesColumn.addSection("Subfolders")
+            for subgroup in group.subgroups {
+                let count = subgroup.agents.count
+                let row = OmniFolderEntryRow(icon: .symbol(SFSymbol.folder.rawValue), iconColor: nil, title: subgroup.name,
+                                             detail: count == 1 ? "1 agent" : "\(count) agents",
+                                             badge: "", status: nil) { [weak self] in
+                    self?.actions?.paneOpen(.group(subgroup.path))
+                }
+                row.contextMenu = { [weak self] in
+                    let menu = NSMenu()
+                    menu.addAction("Open", symbol: .arrowRightCircle) { self?.actions?.paneOpen(.group(subgroup.path)) }
+                    menu.addAction("Rename Folder", symbol: .pencil) { self?.actions?.paneFolder(.rename, path: subgroup.path) }
+                    menu.addAction("New Subfolder", symbol: .folderBadgePlus) { self?.actions?.paneFolder(.newSubfolder, path: subgroup.path) }
+                    menu.addAction("New Agent Here…", symbol: .plus) { self?.actions?.paneFolder(.newAgent, path: subgroup.path) }
+                    menu.addItem(.separator())
+                    menu.addAction("Delete Folder…", symbol: .trash) { self?.actions?.paneFolder(.delete, path: subgroup.path) }
+                    return menu
+                }
+                rows.append(row)
+                zoneItems.append(("group:\(subgroup.path)", row))
+                entriesColumn.add(row, spacing: 2) { _ in OmniFolderEntryRow.height }
+            }
+        }
+        if !group.agents.isEmpty {
+            entriesColumn.addSection("Agents")
+        }
+        for name in group.agents {
+            guard let entry = agentsByName[name] else { continue }
+            let (agent, raw) = entry
+            let run = latestRun[name]
+            var status: NSColor?
+            var state: String
+            if let run, run.isLive {
+                status = run.isWorking ? OmniTheme.running : OmniTheme.waiting
+                state = run.isWorking ? "Running" : "Idle · waiting for you"
+            } else if agent.enabled {
+                state = agent.schedule
+            } else {
+                status = OmniTheme.tertiaryText
+                state = "Paused"
+            }
+            var detail = "\(agent.providerName) · \(state)"
+            if let run, !run.isLive {
+                let summary = run.oneLineSummary
+                detail += " · Last run \(OmniFormat.relative(min(run.started, Date())))" +
+                    (summary.isEmpty ? "" : ": \(summary)")
+            }
+            let badge = agent.enabled ? (agent.nextRun.map { OmniFormat.relative(max($0, Date())) } ?? "") : "Paused"
+            let row = OmniFolderEntryRow(icon: OmniAgentIcon(spec: raw["icon"] as? String) ?? .symbol(OmniAgentIcon.defaultSymbol),
+                                         iconColor: OmniAgentColor.color(raw["color"] as? String),
+                                         title: name, detail: detail, badge: badge, status: status) { [weak self] in
+                self?.actions?.paneOpen(.agent(name))
+            }
+            row.contextMenu = { [weak self] in
+                let menu = OmniContextMenus.agent(name, enabled: agent.enabled, actions: self?.actions, window: self?.window) { self?.reload() }
+                if let run, run.isLive {
+                    menu.insertItem(.separator(), at: 2)
+                    menu.insertItem(OmniMenuItem("Show Terminal", symbol: .terminal) {
+                        _ = self?.actions?.paneShowTerminal(forRun: run.id)
+                    }, at: 2)
+                }
+                return menu
+            }
+            rows.append(row)
+            zoneItems.append(("agent:\(name)", row))
+            entriesColumn.add(row, spacing: 2) { _ in OmniFolderEntryRow.height }
+        }
+        entriesZone.setItems(zoneItems)
+        if !zoneItems.isEmpty {
+            addList(entriesColumn, to: column)
+        }
+        showContent()
+        scroll.relayout()
+        scroll.contentView.scroll(to: origin)
+        scroll.reflectScrolledClipView(scroll.contentView)
+    }
+
+    @objc private func rename(_ sender: Any?) {
+        actions?.paneFolder(.rename, path: path)
+    }
+
+    @objc private func newSubfolder(_ sender: Any?) {
+        actions?.paneFolder(.newSubfolder, path: path)
+    }
+
+    @objc private func newAgent(_ sender: Any?) {
+        actions?.paneFolder(.newAgent, path: path)
+    }
+
+    @objc private func deleteFolder(_ sender: Any?) {
+        actions?.paneFolder(.delete, path: path)
+    }
+}
