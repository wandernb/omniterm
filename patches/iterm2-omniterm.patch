+    private func keyEvent(_ code: UInt16, _ characters: String, _ flags: NSEvent.ModifierFlags = []) -> NSEvent {
+        return NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: flags, timestamp: 0,
+                                windowNumber: window.windowNumber, context: nil, characters: characters,
+                                charactersIgnoringModifiers: characters, isARepeat: false, keyCode: code)!
+    }
+
+    private static func function(_ key: Int) -> String {
+        return String(Character(UnicodeScalar(UInt32(key))!))
+    }
+
+    private var up: NSEvent { keyEvent(126, Self.function(NSUpArrowFunctionKey), [.numericPad, .function]) }
+    private var down: NSEvent { keyEvent(125, Self.function(NSDownArrowFunctionKey), [.numericPad, .function]) }
+    private var left: NSEvent { keyEvent(123, Self.function(NSLeftArrowFunctionKey), [.numericPad, .function]) }
+    private var right: NSEvent { keyEvent(124, Self.function(NSRightArrowFunctionKey), [.numericPad, .function]) }
+    private var returnKey: NSEvent { keyEvent(36, "\r") }
