+- (NSDictionary *)waitForDiffOf:(NSString *)identifier {
+    __block NSDictionary *item = nil;
+    XCTestExpectation *captured = [self expectationWithDescription:@"captured"];
+    __block BOOL done = NO;
+    __weak typeof(self) weakSelf = self;
+    void (^check)(void) = ^{
+        if (done) return;
+        NSArray *items = [weakSelf notifications:@{}][@"notifications"];
+        for (NSDictionary *candidate in items) {
+            if ([candidate[@"id"] isEqual:identifier] && ![candidate[@"diff_state"] isEqual:@"pending"]) {
+                item = candidate;
+                done = YES;
+                [captured fulfill];
+            }
+        }
+    };
+    _scheduler.notificationsChangedHandler = check;
+    // Capture may already have finished.
+    check();
+    [self waitForExpectations:@[ captured ] timeout:30];
+    return item;
+}
