+// The header's breadcrumb: each folder a link back up to it.
+final class OmniBreadcrumb: NSView {
+    private var parts: [NSView] = []
+
+    override var isFlipped: Bool { true }
+
+    // `crumbs` are (label, path); the last is the current folder and is not a link.
+    init(crumbs: [(label: String, path: String)], trailing: String = "", open: @escaping (String) -> Void) {
+        super.init(frame: NSRect(x: 0, y: 0, width: 400, height: OmniExplorerBox.headerHeight))
+        for (index, crumb) in crumbs.enumerated() {
+            if index > 0 {
+                let slash = NSTextField(labelWithString: "/")
+                slash.font = OmniTheme.Font.rowTitle
+                slash.textColor = OmniTheme.tertiaryText
+                parts.append(slash)
+            }
+            let last = index == crumbs.count - 1
+            if last {
+                let label = NSTextField(labelWithString: crumb.label)
+                label.font = OmniTheme.Font.rowTitleEmphasized
+                label.lineBreakMode = .byTruncatingTail
+                parts.append(label)
+            } else {
+                let link = OmniLinkButton(title: crumb.label) { open(crumb.path) }
+                parts.append(link)
+            }
+        }
+        if !trailing.isEmpty {
+            let meta = NSTextField(labelWithString: trailing)
+            meta.font = OmniTheme.Font.meta
+            meta.textColor = OmniTheme.secondaryText
+            meta.alignment = .right
+            meta.identifier = NSUserInterfaceItemIdentifier("trailing")
+            parts.append(meta)
+        }
+        parts.forEach(addSubview)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        // The count keeps its room; a long name truncates before it.
+        let trailing = parts.first { $0.identifier?.rawValue == "trailing" }
+        let trailingWidth = trailing.map { ceil($0.fittingSize.width) } ?? 0
+        let limit = bounds.width - (trailing == nil ? 0 : trailingWidth + 12)
+        var x: CGFloat = 0
+        for part in parts where part !== trailing {
+            let width = ceil(part.fittingSize.width)
+            part.frame = NSRect(x: x, y: (bounds.height - 18) / 2, width: min(width, max(0, limit - x)), height: 18)
+            x = part.frame.maxX + 4
+        }
+        trailing?.frame = NSRect(x: bounds.width - trailingWidth, y: (bounds.height - 16) / 2, width: trailingWidth, height: 16)
+    }
+}
