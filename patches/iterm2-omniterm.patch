+    // Narrower than the collapse width, the sidebar collapses; its last
+    // width comes back with Control-Command-1.
+    private func dragSidebarEdge(to point: NSPoint, finished: Bool) {
+        guard let superview = view.superview else { return }
+        let width = superview.convert(point, from: nil).x - view.frame.minX
+        panelLayout.update(saving: finished) { layout in
+            if width < OmniPanelLayout.sidebarCollapseWidth {
+                layout.sidebarCollapsed = true
+            } else {
+                layout.sidebarCollapsed = false
+                layout.sidebarWidth = OmniPanelLayout.clampedSidebarWidth(width)
+            }
+        }
+    }
