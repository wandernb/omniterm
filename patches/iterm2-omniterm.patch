+    // Knowledge, browsed by folder like a repository: the knowledge
+    // folder's own folders first, then its files.
+    private func buildKnowledge(_ project: [String: Any], _ previous: [(title: String, zone: OmniListZone)]) {
+        let column = scroll.column
+        let knowledge = project["knowledge"] as? [[String: Any]] ?? []
+        guard !knowledge.isEmpty else {
+            column.addText(OmniTheme.meta("This project has no knowledge folder."))
+            return
+        }
+        addOpenFile()
+        let listing = OmniProjectsModel.knowledgeListing(knowledge, in: knowledgePath)
+        var crumbs: [(label: String, path: String)] = [(label: "knowledge", path: "")]
+        var walked = ""
+        for part in knowledgePath.split(separator: "/").map(String.init) {
+            walked = walked.isEmpty ? part : walked + "/" + part
+            crumbs.append((label: part, path: walked))
+        }
+        var rows: [(key: String, row: OmniZoneItem)] = []
+        if !knowledgePath.isEmpty {
+            let parent = OmniProjectsModel.parent(of: knowledgePath)
+            rows.append((key: "..", row: OmniExplorerRow(symbol: .folder, iconColor: OmniTheme.folderTint, name: "..",
+                                                         detail: "", age: "", separator: true) { [weak self] in
+                self?.openKnowledgeFolder(parent)
+            }))
+        }
+        for folder in listing.folders {
+            let path = knowledgePath.isEmpty ? folder.name : knowledgePath + "/" + folder.name
+            rows.append((key: "dir:" + path, row: OmniExplorerRow(symbol: .folderFill, iconColor: OmniTheme.folderTint,
+                                                                  name: folder.name,
+                                                                  detail: folder.count == 1 ? "1 file" : "\(folder.count) files",
+                                                                  age: OmniSessionText.age(folder.modified), separator: true) { [weak self] in
+                self?.openKnowledgeFolder(path)
+            }))
+            fileMenu(rows.last?.row, path: "knowledge/" + path) { [weak self] in self?.openKnowledgeFolder(path) }
+        }
+        for file in listing.files {
+            guard let path = file["path"] as? String else { continue }
+            let modified = (file["modified"] as? NSNumber)?.doubleValue
+            rows.append((key: path, row: OmniExplorerRow(symbol: .docText, iconColor: nil, name: (path as NSString).lastPathComponent,
+                                                         detail: OmniProjectsModel.size((file["size"] as? NSNumber)?.intValue),
+                                                         age: OmniSessionText.age(modified), separator: true) { [weak self] in
+                self?.open(file: path)
+            }))
+            fileMenu(rows.last?.row, path: path) { [weak self] in self?.open(file: path) }
+        }
+        explorer(crumbs: crumbs, trailing: "\(knowledge.count) files", key: "knowledge", previous: previous, rows: rows) { [weak self] path in
+            self?.openKnowledgeFolder(path)
+        }
+    }
