+- (BOOL)applyOmniTermShortcut:(iTermShortcut *)shortcut {
+    iTermShortcut *oldShortcut = [[_omniTermGlobalHotKey.shortcut copy] autorelease];
+    if ((oldShortcut == nil && shortcut == nil) || [oldShortcut isEqualToShortcut:shortcut]) {
+        return YES;
+    }
+    if (_omniTermGlobalHotKey) {
+        [[iTermCarbonHotKeyController sharedInstance] unregisterHotKey:_omniTermGlobalHotKey];
+        _omniTermGlobalHotKey = nil;
