+    func testBarnesHutRepulsionStaysCloseToAllPairs() {
+        var seed: UInt64 = 42
+        func next() -> Double {
+            seed = seed &* 6364136223846793005 &+ 1442695040888963407
+            return Double(seed >> 11) / Double(1 << 53)
+        }
+        let count = 200
+        let x = (0..<count).map { _ in next() * 2000 - 1000 }
+        let y = (0..<count).map { _ in next() * 2000 - 1000 }
+        var exactX = [Double](repeating: 0, count: count), exactY = exactX
+        var fastX = exactX, fastY = exactX
+        OmniMemoryGraphLayout.exactRepulsion(x: x, y: y, k: 95, dx: &exactX, dy: &exactY)
+        OmniMemoryGraphLayout.barnesHutRepulsion(x: x, y: y, k: 95, dx: &fastX, dy: &fastY)
+        var error = 0.0, magnitude = 0.0
+        for i in 0..<count {
+            error += hypot(fastX[i] - exactX[i], fastY[i] - exactY[i])
+            magnitude += hypot(exactX[i], exactY[i])
+        }
+        XCTAssertLessThan(error / magnitude, 0.05, "θ = 0.8 stays within 5% of all pairs")
+        var againX = exactX, againY = exactY
+        OmniMemoryGraphLayout.barnesHutRepulsion(x: x, y: y, k: 95, dx: &againX, dy: &againY)
+        XCTAssertEqual(againX, fastX, "Barnes–Hut is deterministic")
+        let nodes = (0..<120).map { OmniMemoryGraphNode(id: "n\($0)", label: "") }
+        let edges = (1..<120).map { OmniMemoryGraphEdge(source: "n\($0 - 1)", target: "n\($0)", kind: "tag") }
+        let layout = OmniMemoryGraphLayout.network(nodes: nodes, edges: edges, iterations: 20)
+        XCTAssertEqual(layout, OmniMemoryGraphLayout.network(nodes: nodes, edges: edges, iterations: 20))
+        XCTAssertTrue(layout.values.allSatisfy { $0.x.isFinite && $0.y.isFinite })
+        // Coincident points must not recurse without end or produce NaN.
+        var sameX = [Double](repeating: 0, count: 3), sameY = sameX
+        OmniMemoryGraphLayout.barnesHutRepulsion(x: [1, 1, 1], y: [2, 2, 2], k: 10, dx: &sameX, dy: &sameY)
+        XCTAssertTrue((sameX + sameY).allSatisfy(\.isFinite))
+    }
