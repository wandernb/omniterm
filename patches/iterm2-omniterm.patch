+
+    override func resetCursorRects() {
+        addCursorRect(bounds, cursor: .pointingHand)
+    }
+
+    init(symbol: SFSymbol, iconColor: NSColor?, name: String, detail: String, age: String, separator: Bool,
+         action: @escaping () -> Void) {
+        self.action = action
+        self.separator = separator
+        super.init(frame: NSRect(x: 0, y: 0, width: 400, height: Self.height))
+        iconView.image = NSImage(systemSymbolName: symbol.rawValue, accessibilityDescription: nil)
+        iconView.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 13, weight: .regular)
+        iconView.contentTintColor = iconColor ?? OmniTheme.secondaryText
+        addSubview(iconView)
+        self.name.stringValue = name
+        self.name.font = OmniTheme.Font.rowTitle
+        self.name.lineBreakMode = .byTruncatingMiddle
+        addSubview(self.name)
+        self.detail.stringValue = detail
+        self.detail.font = OmniTheme.Font.rowDetail
+        self.detail.textColor = OmniTheme.secondaryText
+        self.detail.lineBreakMode = .byTruncatingTail
+        addSubview(self.detail)
+        self.age.stringValue = age
+        self.age.font = OmniTheme.Font.rowDetail
+        self.age.textColor = OmniTheme.secondaryText
+        self.age.alignment = .right
+        addSubview(self.age)
+        addTrackingArea(NSTrackingArea(rect: .zero, options: [.mouseEnteredAndExited, .activeInKeyWindow, .inVisibleRect],
+                                       owner: self, userInfo: nil))
+        setAccessibilityRole(.button)
+        setAccessibilityLabel(name)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    var titleText: String {
+        return name.stringValue
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let midY = bounds.height / 2
+        iconView.frame = NSRect(x: 14, y: midY - 9, width: 18, height: 18)
+        age.frame = NSRect(x: bounds.width - 104, y: midY - 8, width: 90, height: 16)
+        let nameWidth = min(ceil(name.attributedStringValue.size().width) + 4, max(80, (bounds.width - 150) * 0.45))
+        let nameColumn = max(nameWidth, min(260, (bounds.width - 150) * 0.4))
+        name.frame = NSRect(x: 40, y: midY - 9, width: nameWidth, height: 18)
+        detail.frame = NSRect(x: 40 + nameColumn + 12, y: midY - 8,
+                              width: max(0, age.frame.minX - (40 + nameColumn + 12) - 8), height: 16)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        if isSelected || hovering {
+            let alpha: CGFloat = isSelected ? (zoneHasFocus ? 0.28 : 0.14) : 0.06
+            NSColor.controlAccentColor.withAlphaComponent(alpha).setFill()
+            bounds.fill()
+        }
+        if separator {
+            OmniTheme.titlebarSeparator.setFill()
+            NSRect(x: 0, y: bounds.height - 1, width: bounds.width, height: 1).fill()
+        }
+    }
+
+    override func mouseEntered(with event: NSEvent) {
+        hovering = true
+    }
+
+    override func mouseExited(with event: NSEvent) {
+        hovering = false
+    }
+
+    override func mouseDown(with event: NSEvent) {
+    }
+
+    override func mouseUp(with event: NSEvent) {
+        if bounds.contains(convert(event.locationInWindow, from: nil)) {
+            activate()
+        }
+    }
+
+    func activate() {
+        action()
+    }
+
+    override func accessibilityPerformPress() -> Bool {
+        activate()
+        return true
+    }
+}
