+    @objc private func runIngestNow(_ sender: Any?) {
+        guard let name = ingestAgent?.name else { return }
+        runIngestButton.isEnabled = false
+        OmniSchedulerClient.request(["op": "run_agent", "name": name]) { [weak self] response in
+            guard let self else { return }
+            if !OmniPane.isOK(response) {
+                self.showPlaceholder(response["error"] as? String ?? "The run could not start.", in: self.ingestDetailText)
+            }
+            self.loadIngestRuns()
