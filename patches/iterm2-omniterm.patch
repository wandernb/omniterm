+// Which page a tab selected some other way shows. A run tab shows its run's
+// page, unless the person asked for that tab's full terminal (Open Terminal):
+// then it stays a terminal until a page is chosen again.
+struct OmniTabFollowing {
+    private(set) var explicitTerminalTabID: Int32?
+
+    mutating func terminalShownExplicitly(_ tabID: Int32) {
+        explicitTerminalTabID = tabID
+    }
+
+    mutating func pageShown() {
+        explicitTerminalTabID = nil
+    }
+
+    func route(forTab tabID: Int32, environments: [[AnyHashable: Any]?]) -> OmniPaneRoute? {
