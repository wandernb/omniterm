+        // approve that dialog; only a confirmed idle turn may receive input.
+        if (![run[@"state"] isEqual:@"running"] || !self.runInputHandler ||
+            !OmniIntegerValue(run[@"turn_finished"])) return @{ @"ok": @NO, @"error": @"Run is not ready for lifecycle input" };
+        NSString *text = [action isEqual:@"compact"] ? @"/compact\r" : @"\033[200~OmniTerm: Your planned work budget is nearly over. Start wrapping up: finish the current safe step, record results and remaining work, and return your final report. This is a soft budget; you will not be killed at the deadline.\033[201~\r";
