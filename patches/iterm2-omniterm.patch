+- (void)testASummaryOfAnEarlierTurnIsDropped {
+    [self startSchedulerWithAgentTimeout:@7200];
+    [self insertRun:@"run" state:@"running" started:1 pid:NSNull.null];
+    NSDictionary *(^finish)(NSNumber *) = ^NSDictionary *(NSNumber *turnAt) {
+        return [self->_scheduler responseForRequest:@{ @"op": @"runner_turn", @"run_id": @"run",
+                                                       @"finished": @YES, @"turn_at": turnAt }];
+    };
+    NSDictionary *(^summarize)(NSDictionary *) = ^NSDictionary *(NSDictionary *fields) {
+        NSMutableDictionary *request = [@{ @"op": @"run_summary", @"run_id": @"run" } mutableCopy];
+        [request addEntriesFromDictionary:fields];
+        return [self->_scheduler responseForRequest:request];
+    };
+    XCTAssertEqualObjects(finish(@100)[@"ok"], @YES);
+    XCTAssertEqualObjects(finish(@200)[@"ok"], @YES);
+
+    NSDictionary *stale = summarize(@{ @"state": @"ready", @"summary": @"First turn", @"turn_at": @100 });
+    XCTAssertEqualObjects(stale[@"ok"], @YES);
+    XCTAssertEqualObjects(stale[@"ignored"], @YES);
+    XCTAssertEqualObjects([self runReport:@"run"][@"summary_state"], @"pending");
+    NSDictionary *staleFailure = summarize(@{ @"state": @"failed", @"error": @"old", @"turn_at": @100 });
+    XCTAssertEqualObjects(staleFailure[@"ignored"], @YES);
+    XCTAssertEqualObjects([self runReport:@"run"][@"summary_state"], @"pending");
+
+    NSDictionary *current = summarize(@{ @"state": @"ready", @"summary": @"Second turn", @"turn_at": @200 });
+    XCTAssertNil(current[@"ignored"]);
+    XCTAssertEqualObjects([self runReport:@"run"][@"summary"], @"Second turn");
+
+    // A runner that sends no turn_at is still heard.
+    finish(@300);
+    XCTAssertNil(summarize(@{ @"state": @"ready", @"summary": @"Third turn" })[@"ignored"]);
+    XCTAssertEqualObjects([self runReport:@"run"][@"summary"], @"Third turn");
+    XCTAssertEqualObjects(summarize(@{ @"state": @"ready", @"summary": @"S", @"turn_at": @"soon" })[@"code"],
+                          @"invalid_request");
+}
