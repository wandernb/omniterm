+- (void)testDefaultNotificationPolicyKeepsEarlierBehaviour {
+    NSDictionary *defaults = [_scheduler defaultSettings][@"notifications"];
+    NSDictionary *urgent = [self alertFor:@{ @"severity": @"urgent" } settings:defaults];
+    XCTAssertEqualObjects((urgent[@"banner"]), @YES);
+    XCTAssertEqualObjects((urgent[@"sound"]), @YES);
+    XCTAssertEqualObjects((urgent[@"count"]), @YES);
+    NSDictionary *attention = [self alertFor:@{ @"severity": @"attention" } settings:defaults];
+    XCTAssertEqualObjects((attention[@"banner"]), @NO);
+    XCTAssertEqualObjects((attention[@"count"]), @YES);
+    NSDictionary *info = [self alertFor:@{ @"severity": @"info" } settings:defaults];
+    XCTAssertEqualObjects((info[@"banner"]), @NO);
+    XCTAssertEqualObjects((info[@"count"]), @NO);
+    // Missing or garbled settings behave as the defaults.
+    XCTAssertEqualObjects(([self alertFor:@{ @"severity": @"urgent" } settings:@{ @"levels": @"x" }][@"banner"]), @YES);
+}
