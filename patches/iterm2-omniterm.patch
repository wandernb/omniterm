+    // MARK: Session folders
+
+    private func saveSessionLayout(_ layout: OmniProjectLayout, problemOn key: String? = nil) {
+        let saved = sessionLayout
+        sessionLayout = layout
+        rebuild()
+        OmniSchedulerClient.request(["op": "set_settings", "settings": ["session_folders": layout.dictionary]]) { [weak self] response in
+            guard let self else { return }
+            guard response["ok"] as? Bool == true else {
+                self.sessionLayout = saved
+                self.rebuild()
+                if let key, let row = self.itemCache[key] {
+                    self.showRenameProblem(Self.problem(response, fallback: "The folders could not be saved."), on: row)
+                }
+                return
+            }
+            if let settings = response["settings"] as? [String: Any] {
+                self.sessionLayout = OmniProjectLayout(settings["session_folders"])
+                self.rebuild()
+            }
+        }
+    }
+
+    private var sessionTree: OmniGroupTree {
+        return sessionLayout.tree(roots: Array(sessionLayout.folders.keys))
+    }
+
+    private func createSessionFolder(in parent: String) {
+        let siblings = sessionTree.allPaths.filter { OmniGroupTree.parent(of: $0) == parent }
+            .map { $0.components(separatedBy: "/").last ?? $0 }
+        let name = OmniRenameRules.uniqueName(parent.isEmpty ? "New Folder" : "New Subfolder", siblings: siblings)
+        let path = parent.isEmpty ? name : "\(parent)/\(name)"
+        var layout = sessionLayout
+        layout.add(folder: path, tree: sessionTree)
+        pendingEditKey = "sessionFolder|\(path)"
+        saveSessionLayout(layout)
+    }
+
+    @objc private func newSessionFolder(_ sender: NSMenuItem) {
+        createSessionFolder(in: sender.representedObject as? String ?? "")
+    }
+
+    @objc private func deleteSessionFolder(_ sender: NSMenuItem) {
+        guard let path = sender.representedObject as? String else { return }
+        var layout = sessionLayout
+        // Its sessions move up a level (out of a top-level folder: to Other).
+        layout.delete(folder: path, tree: sessionTree)
+        saveSessionLayout(layout)
+    }
+
+    @objc private func moveSession(_ sender: NSMenuItem) {
+        guard let pair = sender.representedObject as? [String], pair.count == 2 else { return }
+        fileSession(pair[0], into: pair[1])
+    }
+
+    private func fileSession(_ id: String, into folder: String) {
+        var layout = sessionLayout
+        if folder.isEmpty {
+            layout.folders[id] = nil
+            layout.order.removeAll { $0 == OmniProjectLayout.key(id) }
+        } else {
+            layout.move(project: id, into: folder, before: nil, tree: sessionTree)
+        }
+        saveSessionLayout(layout)
+    }
+
+    private func renameSessionFolder(_ row: OmniSidebarItem, to newName: String) {
+        let path = row.groupPath
+        let parent = OmniGroupTree.parent(of: path)
+        let siblings = sessionTree.allPaths.filter { OmniGroupTree.parent(of: $0) == parent && $0 != path }
+            .map { $0.components(separatedBy: "/").last ?? $0 }
+        if let problem = OmniRenameRules.groupNameProblem(newName, siblings: siblings) {
+            showRenameProblem(problem, on: row)
+            return
+        }
+        let newPath = parent.isEmpty ? newName : "\(parent)/\(newName)"
+        guard newPath != path else { return }
+        var layout = sessionLayout
+        layout.move(folder: path, to: newPath, before: nil, tree: sessionTree)
+        saveSessionLayout(layout, problemOn: "sessionFolder|\(newPath)")
+    }
