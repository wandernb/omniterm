+// MARK: - Sidebar arrangement
+
+// How the person arranged projects in the sidebar's Projects mode: folders
+// (two levels, as for agents), the order of projects and folders, each
+// project's folder and its name in OmniTerm. Stored as `projects` in
+// ~/.omni/settings.json through `set_settings`; a project is keyed by its
+// root path, so a rename never loses its place. Pure, so tests can check it.
+struct OmniProjectLayout: Equatable {
+    var groups: [String] = []
+    var order: [String] = []
+    var folders: [String: String] = [:]
+    var names: [String: String] = [:]
+    // Icon specs and colour names, as for agents: by project root, and by
+    // `group:<path>` for folders.
+    var icons: [String: String] = [:]
+    var colors: [String: String] = [:]
+
+    init() {
+    }
+
+    init(_ value: Any?) {
+        let dictionary = value as? [String: Any] ?? [:]
+        groups = (dictionary["groups"] as? [String] ?? []).map(OmniGroupTree.normalizedPath).filter { !$0.isEmpty }
+        order = dictionary["order"] as? [String] ?? []
+        folders = (dictionary["folders"] as? [String: String] ?? [:]).mapValues(OmniGroupTree.normalizedPath)
+        names = dictionary["names"] as? [String: String] ?? [:]
+        icons = dictionary["icons"] as? [String: String] ?? [:]
+        colors = dictionary["colors"] as? [String: String] ?? [:]
+    }
+
+    var dictionary: [String: Any] {
+        return ["groups": groups, "order": order, "folders": folders.filter { !$0.value.isEmpty },
+                "names": names.filter { !$0.value.isEmpty },
+                "icons": icons.filter { !$0.value.isEmpty }, "colors": colors.filter { !$0.value.isEmpty }]
+    }
+
+    static func folderKey(_ path: String) -> String {
+        return "group:" + path
+    }
+
+    // A project's (by root) or folder's (by `folderKey`) icon and colour.
+    func appearance(_ key: String) -> (icon: OmniAgentIcon?, color: String?) {
+        return (OmniAgentIcon(spec: icons[key]), colors[key].flatMap { $0.isEmpty ? nil : $0 })
+    }
+
+    mutating func setAppearance(_ key: String, icon: String, color: String) {
+        icons[key] = icon.isEmpty ? nil : icon
+        colors[key] = color.isEmpty ? nil : color
+    }
+
+    // Folder appearance follows a folder to its new path.
+    private mutating func moveAppearance(_ rename: (String) -> String?) {
+        func moved(_ map: [String: String]) -> [String: String] {
+            var result: [String: String] = [:]
+            for (key, value) in map {
+                if key.hasPrefix("group:") {
+                    guard let path = rename(String(key.dropFirst("group:".count))) else { continue }
+                    result[Self.folderKey(path)] = value
+                } else {
+                    result[key] = value
+                }
+            }
+            return result
+        }
+        icons = moved(icons)
+        colors = moved(colors)
+    }
+
+    static func key(_ root: String) -> String {
+        return OmniGroupTree.agentKey(root)
+    }
+
+    // Projects sit in the tree by root; folders by path.
+    func tree(roots: [String]) -> OmniGroupTree {
+        return OmniGroupTree(agents: roots.map { (name: $0, group: folders[$0]) }, configured: groups, order: order)
+    }
+
+    func name(_ root: String) -> String? {
+        let name = names[root] ?? ""
+        return name.isEmpty ? nil : name
+    }
+
+    mutating func rename(project root: String, to name: String) {
+        let trimmed = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        names[root] = trimmed.isEmpty ? nil : String(trimmed.prefix(120))
+    }
+
+    mutating func move(project root: String, into folder: String, before: String?, tree: OmniGroupTree) {
+        order = OmniSidebarMoves.sidebarOrder(tree.displayKeys, moving: Self.key(root), before: before)
+        folders[root] = folder.isEmpty ? nil : folder
+    }
+
+    mutating func reorder(folder path: String, before: String?, tree: OmniGroupTree) {
+        order = OmniSidebarMoves.sidebarOrder(tree.displayKeys, moving: OmniGroupTree.groupKey(path), before: before)
+    }
+
+    mutating func add(folder path: String, tree: OmniGroupTree) {
+        let known = groups.isEmpty ? tree.allPaths : groups
+        groups = known.contains(path) ? known : known + [path]
+    }
+
+    // A folder and everything in it take a new path; `before` places it among its new siblings.
+    mutating func move(folder path: String, to newPath: String, before: String?, tree: OmniGroupTree) {
+        func renamed(_ value: String) -> String {
+            if value == path { return newPath }
+            if value.hasPrefix(path + "/") { return newPath + value.dropFirst(path.count) }
+            return value
+        }
+        let known = groups.isEmpty ? tree.allPaths : groups
+        groups = known.map(renamed)
+        folders = folders.mapValues(renamed)
+        moveAppearance { renamed($0) }
+        let keys = tree.displayKeys.map { key -> String in
+            guard key.hasPrefix("group:") else { return key }
+            return OmniGroupTree.groupKey(renamed(String(key.dropFirst("group:".count))))
+        }
+        order = OmniSidebarMoves.sidebarOrder(keys, moving: OmniGroupTree.groupKey(newPath), before: before)
+    }
+
+    // Its projects, its subfolders' included, move up to its parent.
+    mutating func delete(folder path: String, tree: OmniGroupTree) {
+        let parent = OmniGroupTree.parent(of: path)
+        let known = groups.isEmpty ? tree.allPaths : groups
+        groups = known.filter { $0 != path && !$0.hasPrefix(path + "/") }
+        moveAppearance { $0 == path || $0.hasPrefix(path + "/") ? nil : $0 }
+        folders = folders.mapValues { $0 == path || $0.hasPrefix(path + "/") ? parent : $0 }
+        order = order.filter { $0 != OmniGroupTree.groupKey(path) && !$0.hasPrefix(OmniGroupTree.groupKey(path + "/")) }
+    }
+}
