diff --git a/sources/OmniTerm/OmniAgentEditor.swift b/sources/OmniTerm/OmniAgentEditor.swift
new file mode 100644
index 0000000000000000000000000000000000000000..2f6eb54eef4b89d9864d285308bfe8c267b43bf6
--- /dev/null
+++ b/sources/OmniTerm/OmniAgentEditor.swift
@@ -0,0 +1,747 @@
+import AppKit
+import Foundation
+
+// Choices the editor offers. Validation is not repeated here: helpers/omni
+// normalizes every definition (`omni agents normalize`), as its own editor
+// does, so the rules live in one place.
+enum OmniAgentRules {
+    static let providers = ["claude", "codex"]
+
+    static let permissionModes: [String: [String]] = [
+        "claude": ["", "auto", "acceptEdits", "plan", "manual", "dontAsk", "bypassPermissions"],
+        "codex": ["", "untrusted", "on-request", "never", "dangerous"],
+    ]
+
+    static let dangerousModes: [String: String] = ["claude": "bypassPermissions", "codex": "dangerous"]
+
+    static func isDangerous(provider: String, mode: String) -> Bool {
+        return dangerousModes[provider] == mode
+    }
+
+    static func timeoutText(_ seconds: Int?) -> String {
+        guard let seconds, seconds > 0 else { return "off" }
+        if seconds % 86400 == 0 { return "\(seconds / 86400)d" }
+        if seconds % 3600 == 0 { return "\(seconds / 3600)h" }
+        if seconds % 60 == 0 { return "\(seconds / 60)m" }
+        return "\(seconds)s"
+    }
+}
+
+// Runs the bundled `omni` helper's read-only JSON commands off the main
+// thread. They never touch the scheduler socket.
+enum OmniHelper {
+    static let timeout: TimeInterval = 10
+
+    static var path: String? {
+        return Bundle.main.path(forResource: "omni", ofType: nil, inDirectory: "Helpers")
+    }
+
+    static func run(_ arguments: [String], input: [String: Any]? = nil,
+                    completion: @escaping ([AnyHashable: Any]) -> Void) {
+        guard let path else {
+            completion(["ok": false, "error": "The omni helper is missing from the app bundle."])
+            return
+        }
+        let stdin = input.flatMap { try? JSONSerialization.data(withJSONObject: $0) }
+        DispatchQueue.global(qos: .userInitiated).async {
+            let result = runSynchronously(path: path, arguments: arguments, input: stdin)
+            DispatchQueue.main.async {
+                completion(result)
+            }
+        }
+    }
+
+    private static func runSynchronously(path: String, arguments: [String], input: Data?) -> [AnyHashable: Any] {
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/usr/bin/python3")
+        process.arguments = [path] + arguments
+        let output = Pipe()
+        let inputPipe = Pipe()
+        process.standardOutput = output
+        process.standardError = FileHandle.nullDevice
+        process.standardInput = inputPipe
+        do {
+            try process.run()
+        } catch {
+            return ["ok": false, "error": "The omni helper could not start: \(error.localizedDescription)"]
+        }
+        let timer = DispatchWorkItem { [weak process] in
+            if process?.isRunning == true {
+                process?.terminate()
+            }
+        }
+        DispatchQueue.global().asyncAfter(deadline: .now() + timeout, execute: timer)
+        if let input {
+            // A helper that exits early closes the pipe; that is its answer.
+            try? inputPipe.fileHandleForWriting.write(contentsOf: input)
+        }
+        try? inputPipe.fileHandleForWriting.close()
+        let data = output.fileHandleForReading.readDataToEndOfFile()
+        process.waitUntilExit()
+        timer.cancel()
+        return decode(data, status: process.terminationStatus, reason: process.terminationReason)
+    }
+
+    static func decode(_ data: Data, status: Int32, reason: Process.TerminationReason) -> [AnyHashable: Any] {
+        if reason == .uncaughtSignal {
+            return ["ok": false, "error": "The omni helper took too long."]
+        }
+        guard let object = try? JSONSerialization.jsonObject(with: data) as? [AnyHashable: Any] else {
+            return ["ok": false, "error": status == 0 ? "The omni helper returned no result." :
+                        "The omni helper failed (exit \(status))."]
+        }
+        return object
+    }
+}
+
+// The agent form, shown in a sheet: every setting, a live schedule preview,
+// and errors under the field they belong to. Create mode adds the name; a
+// saved agent's name never changes. A person is at the keyboard, so
+// dangerous permission modes may be chosen here; they are marked with ⚠.
+final class OmniAgentEditorView: NSView, NSTextFieldDelegate, NSTextViewDelegate {
+    // Keys match `omni agents normalize` input fields, so its errors land
+    // under the right row.
+    fileprivate enum Field: String, CaseIterable {
+        case name
+        case workspace
+        case provider
+        case kind
+        case sessionPolicy = "session_policy"
+        case compactOnEnd = "compact_on_end"
+        case runBudget = "run_budget_seconds"
+        case wrapUp = "wrap_up_seconds"
+        case model
+        case permissionMode = "permission_mode"
+        case overlap
+        case timeout
+        case schedule = "schedule_phrase"
+        case startupPrompt = "startup_prompt"
+        case systemPrompt = "system_prompt"
+
+        var title: String {
+            switch self {
+            case .name: return "Name"
+            case .workspace: return "Workspace"
+            case .provider: return "Provider"
+            case .kind: return String(localized: "OmniAgent.Kind", defaultValue: "Agent kind", comment: "Agent lifecycle type field")
+            case .sessionPolicy: return String(localized: "OmniAgent.SessionPolicy", defaultValue: "Session reuse", comment: "Session reuse policy field")
+            case .compactOnEnd: return String(localized: "OmniAgent.Compact", defaultValue: "Compact on end", comment: "Compaction option field")
+            case .runBudget: return String(localized: "OmniAgent.Budget", defaultValue: "Soft budget (s)", comment: "Work budget in seconds")
+            case .wrapUp: return String(localized: "OmniAgent.Warning", defaultValue: "Warn before (s)", comment: "Seconds before work budget to warn")
+            case .model: return "Model"
+            case .permissionMode: return "Permissions"
+            case .overlap: return "Overlap"
+            case .timeout: return "Timeout"
+            case .schedule: return "Schedule"
+            case .startupPrompt: return "Startup prompt"
+            case .systemPrompt: return "System prompt"
+            }
+        }
+    }
+
+    // nil creates a new agent.
+    let agentName: String?
+    private var stored: [AnyHashable: Any] = [:]
+    private var errors: [Field: String] = [:]
+    private var labels: [Field: NSTextField] = [:]
+    private var errorLabels: [Field: NSTextField] = [:]
+    private var schedulePreviewWork: DispatchWorkItem?
+
+    private let nameField = NSTextField()
+    private let workspaceField = NSTextField()
+    private let chooseButton = NSButton(title: "Choose…", target: nil, action: nil)
+    private let revealButton = NSButton(title: "Reveal", target: nil, action: nil)
+    private let appearanceButton = NSButton(title: "Icon & Colour…", target: nil, action: nil)
+    private let providerPopUp = NSPopUpButton()
+    private let kindPopUp = NSPopUpButton()
+    private let sessionPopUp = NSPopUpButton()
+    private let compactPopUp = NSPopUpButton()
+    private let budgetField = NSTextField()
+    private let warningField = NSTextField()
+    private let modelField = NSTextField()
+    private let permissionPopUp = NSPopUpButton()
+    private let overlapPopUp = NSPopUpButton()
+    private let timeoutField = NSTextField()
+    private let scheduleField = NSTextField()
+    private let schedulePreview = NSTextField(wrappingLabelWithString: "")
+    private let systemPrompt = OmniMarkdownEditor()
+    private let startupPrompt = OmniMarkdownEditor()
+    let status = NSTextField(wrappingLabelWithString: "")
+    var didChangeHeight: (() -> Void)?
+
+    override var isFlipped: Bool { true }
+
+    init(agentName: String?) {
+        self.agentName = agentName
+        super.init(frame: NSRect(x: 0, y: 0, width: 520, height: 600))
+        for field in Field.allCases {
+            let label = NSTextField(labelWithString: field.title)
+            label.font = NSFont.systemFont(ofSize: 12)
+            label.textColor = .secondaryLabelColor
+            label.alignment = .right
+            labels[field] = label
+            addSubview(label)
+            let error = NSTextField(wrappingLabelWithString: "")
+            error.font = NSFont.systemFont(ofSize: 11)
+            error.textColor = .systemRed
+            error.isHidden = true
+            errorLabels[field] = error
+            addSubview(error)
+        }
+        for field in [nameField, workspaceField, modelField, timeoutField, scheduleField, budgetField, warningField] {
+            field.font = NSFont.systemFont(ofSize: 13)
+            field.delegate = self
+            addSubview(field)
+        }
+        nameField.placeholderString = "Derived from the workspace if empty"
+        // A new agent gets its icon from the sidebar once it exists.
+        appearanceButton.isHidden = agentName == nil
+        nameField.isEditable = agentName == nil
+        nameField.isSelectable = true
+        if agentName != nil {
+            nameField.isBezeled = false
+            nameField.drawsBackground = false
+            nameField.font = NSFont.systemFont(ofSize: 13, weight: .semibold)
+        }
+        workspaceField.lineBreakMode = .byTruncatingHead
+        modelField.placeholderString = "Provider default"
+        timeoutField.placeholderString = "2h"
+        scheduleField.placeholderString = "daily at 09:00"
+        for (button, action) in [(chooseButton, #selector(chooseWorkspace(_:))),
+                                 (revealButton, #selector(revealWorkspace(_:))),
+                                 (appearanceButton, #selector(editAppearance(_:)))] {
+            button.bezelStyle = .rounded
+            button.controlSize = .small
+            button.target = self
+            button.action = action
+            addSubview(button)
+        }
+        providerPopUp.addItems(withTitles: OmniAgentRules.providers.map(\.capitalized))
+        kindPopUp.addItems(withTitles: [
+            String(localized: "OmniAgent.Scheduled", defaultValue: "Scheduled agent", comment: "Normal agent kind"),
+            String(localized: "OmniAgent.Loop", defaultValue: "Loop — one persistent session", comment: "Loop keeps one session")])
+        sessionPopUp.addItems(withTitles: [
+            String(localized: "OmniAgent.Fresh", defaultValue: "Start fresh", comment: "Start a new session each run"),
+            String(localized: "OmniAgent.Resume", defaultValue: "Resume when available", comment: "Reuse compatible completed session")])
+        compactPopUp.addItems(withTitles: [
+            String(localized: "OmniAgent.CompactOff", defaultValue: "Off", comment: "Compaction disabled"),
+            String(localized: "OmniAgent.CompactOn", defaultValue: "After work finishes", comment: "Compact completed work")])
+        budgetField.toolTip = String(localized: "OmniAgent.BudgetHelp", defaultValue: "A soft work budget, not a kill deadline. Zero disables it; retention is separate.", comment: "Explains soft budget")
+        overlapPopUp.addItems(withTitles: ["A new run replaces the last", "Runs in parallel", "Same persistent session"])
+        for popUp in [providerPopUp, permissionPopUp, overlapPopUp, kindPopUp, sessionPopUp, compactPopUp] {
+            popUp.target = self
+            popUp.action = #selector(popUpChanged(_:))
+            addSubview(popUp)
+        }
+        schedulePreview.font = NSFont.systemFont(ofSize: 11.5)
+        schedulePreview.textColor = .secondaryLabelColor
+        schedulePreview.isSelectable = true
+        addSubview(schedulePreview)
+        for prompt in [startupPrompt, systemPrompt] {
+            prompt.textView.delegate = self
+            addSubview(prompt)
+        }
+        status.font = NSFont.systemFont(ofSize: 11.5)
+        status.textColor = .systemRed
+        addSubview(status)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    // MARK: - Data
+
+    func load(_ agent: [AnyHashable: Any]) {
+        stored = agent
+        let model = OmniAgent(agent)
+        nameField.stringValue = agentName ?? ""
+        workspaceField.stringValue = model?.workspace ?? (agent["workspace"] as? String ?? "")
+        let provider = model?.provider ?? (agent["provider"] as? String ?? "claude")
+        providerPopUp.selectItem(at: OmniAgentRules.providers.firstIndex(of: provider) ?? 0)
+        modelField.stringValue = model?.model ?? (agent["model"] as? String ?? "")
+        fillPermissions(provider: provider, selected: model?.permissionMode ?? (agent["permission_mode"] as? String ?? ""))
+        let loop = agent["kind"] as? String == "loop"
+        kindPopUp.selectItem(at: loop ? 1 : 0)
+        sessionPopUp.selectItem(at: (agent["session_policy"] as? String ?? "resume") == "resume" ? 1 : 0)
+        compactPopUp.selectItem(at: agent["compact_on_end"] as? Bool == true ? 1 : 0)
+        budgetField.stringValue = "\((agent["run_budget_seconds"] as? NSNumber)?.intValue ?? (loop ? 600 : 0))"
+        warningField.stringValue = "\((agent["wrap_up_seconds"] as? NSNumber)?.intValue ?? 120)"
+        overlapPopUp.isEnabled = !loop
+        overlapPopUp.item(at: 2)?.isHidden = !loop
+        sessionPopUp.isEnabled = !loop
+        if loop { sessionPopUp.selectItem(at: 1) }
+        overlapPopUp.selectItem(at: loop ? 2 : ((model?.overlap ?? agent["overlap"] as? String) == "parallel" ? 1 : 0))
+        timeoutField.stringValue = OmniAgentRules.timeoutText((agent["timeout_seconds"] as? NSNumber)?.intValue)
+        let schedule = agent["schedule"] as? [AnyHashable: Any]
+        scheduleField.stringValue = schedule?["phrase"] as? String ?? (agent["schedule_phrase"] as? String ?? "")
+        startupPrompt.text = model?.startupPrompt ?? ""
+        systemPrompt.text = model?.systemPrompt ?? ""
+        errors = [:]
+        status.stringValue = ""
+        previewSchedule(after: 0)
+        relayout()
+    }
+
+    private func fillPermissions(provider: String, selected: String) {
+        permissionPopUp.removeAllItems()
+        for mode in OmniAgentRules.permissionModes[provider] ?? [] {
+            let dangerous = OmniAgentRules.isDangerous(provider: provider, mode: mode)
+            let title = mode.isEmpty ? "Provider default" : (dangerous ? "⚠ \(mode)" : mode)
+            permissionPopUp.addItem(withTitle: title)
+            permissionPopUp.lastItem?.representedObject = mode
+        }
+        let index = (OmniAgentRules.permissionModes[provider] ?? []).firstIndex(of: selected) ?? 0
+        permissionPopUp.selectItem(at: index)
+    }
+
+    private var selectedProvider: String {
+        return OmniAgentRules.providers[max(0, providerPopUp.indexOfSelectedItem)]
+    }
+
+    // What the form says, in the shape `omni agents normalize` reads. Fields
+    // the form does not edit come from the stored definition.
+    private var candidate: [String: Any] {
+        var agent: [String: Any] = [:]
+        for key in ["advanced_args", "enabled"] {
+            if let value = stored[key] {
+                agent[key] = value
+            }
+        }
+        agent["name"] = agentName ?? nameField.stringValue.trimmingCharacters(in: .whitespaces)
+        agent["workspace"] = workspaceField.stringValue
+        agent["provider"] = selectedProvider
+        agent["kind"] = kindPopUp.indexOfSelectedItem == 1 ? "loop" : "scheduled"
+        agent["session_policy"] = sessionPopUp.indexOfSelectedItem == 1 ? "resume" : "fresh"
+        agent["compact_on_end"] = compactPopUp.indexOfSelectedItem == 1
+        agent["run_budget_seconds"] = Int(budgetField.stringValue).map { $0 as Any } ?? budgetField.stringValue
+        agent["wrap_up_seconds"] = Int(warningField.stringValue).map { $0 as Any } ?? warningField.stringValue
+        agent["model"] = modelField.stringValue.trimmingCharacters(in: .whitespaces)
+        agent["permission_mode"] = permissionPopUp.selectedItem?.representedObject as? String ?? ""
+        agent["overlap"] = kindPopUp.indexOfSelectedItem == 1 || overlapPopUp.indexOfSelectedItem == 1 ? "parallel" : "replace"
+        agent["timeout"] = timeoutField.stringValue
+        agent["schedule_phrase"] = scheduleField.stringValue
+        agent["system_prompt"] = systemPrompt.text
+        agent["startup_prompt"] = startupPrompt.text
+        return agent
+    }
+
+    private func relayout() {
+        resizeSubviews(withOldSize: bounds.size)
+        didChangeHeight?()
+    }
+
+    // Shows the parsed phrase and the next runs, or why it does not parse.
+    private func previewSchedule(after delay: TimeInterval) {
+        schedulePreviewWork?.cancel()
+        let phrase = scheduleField.stringValue.trimmingCharacters(in: .whitespaces)
+        guard !phrase.isEmpty else {
+            schedulePreview.stringValue = ""
+            relayout()
+            return
+        }
+        let work = DispatchWorkItem { [weak self] in
+            OmniHelper.run(["schedule", "parse", "--json", "--count", "3", phrase]) { response in
+                guard let self, self.scheduleField.stringValue.trimmingCharacters(in: .whitespaces) == phrase else {
+                    return
+                }
+                self.schedulePreview.stringValue = Self.schedulePreviewText(response)
+                self.schedulePreview.textColor = OmniPane.isOK(response) ? .secondaryLabelColor : .systemRed
+                self.relayout()
+            }
+        }
+        schedulePreviewWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: work)
+    }
+
+    static func schedulePreviewText(_ response: [AnyHashable: Any]) -> String {
+        guard OmniPane.isOK(response) else {
+            return response["error"] as? String ?? "This schedule could not be read."
+        }
+        let phrase = response["phrase"] as? String ?? ""
+        let occurrences = (response["occurrences"] as? [NSNumber] ?? []).map {
+            OmniFormat.date(Date(timeIntervalSince1970: $0.doubleValue))
+        }
+        if occurrences.isEmpty {
+            return phrase.isEmpty ? "Never runs." : "\(phrase) · never runs again"
+        }
+        return "\(phrase) · next: " + occurrences.joined(separator: ", ")
+    }
+
+    // MARK: - Saving
+
+    // Normalizes through the helper and saves. Calls back with the saved
+    // agent's name, or nil after showing why it could not be saved.
+    func save(completion: @escaping (String?) -> Void) {
+        errors = [:]
+        status.textColor = .secondaryLabelColor
+        status.stringValue = "Checking…"
+        relayout()
+        OmniHelper.run(["agents", "normalize", "--json"], input: candidate) { [weak self] response in
+            guard let self else { return }
+            guard OmniPane.isOK(response), var agent = response["agent"] as? [String: Any],
+                  let name = agent["name"] as? String else {
+                self.showNormalizeErrors(response)
+                completion(nil)
+                return
+            }
+            // Names are immutable, as in the CLI editor.
+            if let agentName = self.agentName, name != agentName {
+                self.showError("The agent’s name cannot change.")
+                completion(nil)
+                return
+            }
+            if self.agentName == nil {
+                agent["enabled"] = true
+            }
+            self.status.stringValue = "Saving…"
+            let op = self.agentName == nil ? "create_agent" : "update_agent"
+            OmniSchedulerClient.request(["op": op, "agent": agent]) { [weak self] response in
+                guard let self else { return }
+                guard OmniPane.isOK(response) else {
+                    let code = response["code"] as? String
+                    if code == "agent_exists" {
+                        self.errors[.name] = "An agent with this name already exists."
+                        self.showError("")
+                    } else {
+                        self.showError(response["error"] as? String ?? "The agent could not be saved.")
+                    }
+                    completion(nil)
+                    return
+                }
+                completion(name)
+            }
+        }
+    }
+
+    private func showError(_ message: String) {
+        status.textColor = .systemRed
+        status.stringValue = message
+        relayout()
+    }
+
+    private func showNormalizeErrors(_ response: [AnyHashable: Any]) {
+        var fieldErrors: [Field: String] = [:]
+        var general: [String] = []
+        for (key, value) in response["errors"] as? [String: Any] ?? [:] {
+            let message = value as? String ?? "\(value)"
+            if let field = Field(rawValue: key) ?? (key == "timeout_seconds" ? .timeout : nil) ??
+                (key == "schedule" ? .schedule : nil) {
+                fieldErrors[field] = message
+            } else {
+                general.append(message)
+            }
+        }
+        if let error = response["error"] as? String {
+            general.append(error)
+        }
+        errors = fieldErrors
+        showError(general.isEmpty ? "Fix the fields marked in red." : general.joined(separator: "\n"))
+    }
+
+    // MARK: - Actions
+
+    func controlTextDidChange(_ notification: Notification) {
+        if (notification.object as? NSTextField) === scheduleField {
+            previewSchedule(after: 0.5)
+        }
+    }
+
+    @objc private func popUpChanged(_ sender: NSPopUpButton) {
+        if sender === kindPopUp {
+            let loop = kindPopUp.indexOfSelectedItem == 1
+            overlapPopUp.isEnabled = !loop
+            overlapPopUp.item(at: 2)?.isHidden = !loop
+            sessionPopUp.isEnabled = !loop
+            if loop {
+                overlapPopUp.selectItem(at: 2)
+                sessionPopUp.selectItem(at: 1)
+                timeoutField.stringValue = "24h"
+                budgetField.stringValue = "600"
+                warningField.stringValue = "120"
+            } else if overlapPopUp.indexOfSelectedItem == 2 {
+                overlapPopUp.selectItem(at: 0)
+            }
+        }
+        if sender === providerPopUp {
+            fillPermissions(provider: selectedProvider, selected: "")
+        }
+    }
+
+    @objc private func chooseWorkspace(_ sender: Any?) {
+        let panel = NSOpenPanel()
+        panel.canChooseDirectories = true
+        panel.canChooseFiles = false
+        panel.allowsMultipleSelection = false
+        panel.directoryURL = URL(fileURLWithPath: (workspaceField.stringValue as NSString).expandingTildeInPath)
+        guard let window else { return }
+        panel.beginSheetModal(for: window) { [weak self] response in
+            guard let self, response == .OK, let url = panel.url else { return }
+            self.workspaceField.stringValue = url.path
+        }
+    }
+
+    // Saved at once, like the sidebar's picker; Cancel does not undo it.
+    @objc private func editAppearance(_ sender: NSButton) {
+        guard let agentName else { return }
+        let icon = OmniAgentIcon(spec: stored["icon"] as? String)
+        let color = stored["color"] as? String
+        OmniAppearancePicker.show(icon: icon, color: color, relativeTo: sender.bounds, of: sender) { [weak self] icon, color in
+            self?.stored["icon"] = icon
+            self?.stored["color"] = color
+            OmniSchedulerClient.request(["op": "set_agent_appearance", "name": agentName, "icon": icon, "color": color]) { response in
+                guard response["ok"] as? Bool != true else { return }
+                self?.showError(response["error"] as? String ?? "The icon could not be saved.")
+            }
+        }
+    }
+
+    @objc private func revealWorkspace(_ sender: Any?) {
+        let path = (workspaceField.stringValue as NSString).expandingTildeInPath
+        guard FileManager.default.fileExists(atPath: path) else {
+            showError("The workspace does not exist.")
+            return
+        }
+        NSWorkspace.shared.activateFileViewerSelecting([URL(fileURLWithPath: path)])
+    }
+
+    // MARK: - Layout
+
+    // The height the form needs at a width.
+    func preferredHeight(width: CGFloat) -> CGFloat {
+        return layoutForm(width: width, apply: false)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        layoutForm(width: bounds.width, apply: true)
+    }
+
+    @discardableResult
+    private func layoutForm(width: CGFloat, apply: Bool) -> CGFloat {
+        let labelWidth: CGFloat = 110
+        let x = labelWidth + 12
+        let fieldWidth = max(80, width - x)
+        var y: CGFloat = 0
+
+        func error(_ field: Field, x errorX: CGFloat, width errorWidth: CGFloat) {
+            guard let label = errorLabels[field] else { return }
+            let message = errors[field] ?? ""
+            label.stringValue = message
+            label.isHidden = message.isEmpty
+            guard !message.isEmpty else { return }
+            let height = ceil(label.sizeThatFits(NSSize(width: errorWidth, height: 100)).height)
+            if apply {
+                label.frame = NSRect(x: errorX, y: y, width: errorWidth, height: height)
+            }
+            y += height + 4
+        }
+
+        func row(_ field: Field, _ view: NSView, height: CGFloat, width customWidth: CGFloat? = nil, spacing: CGFloat = 8) {
+            if apply {
+                labels[field]?.frame = NSRect(x: 0, y: y + 3, width: labelWidth, height: 17)
+                view.frame = NSRect(x: x, y: y, width: customWidth ?? fieldWidth, height: height)
+            }
+            y += height + 4
+            error(field, x: x, width: fieldWidth)
+            y += spacing
+        }
+
+        row(.name, nameField, height: 22, spacing: agentName == nil ? 8 : 0)
+        if agentName != nil {
+            if apply {
+                appearanceButton.sizeToFit()
+                appearanceButton.frame = NSRect(x: x - 4, y: y, width: appearanceButton.frame.width + 6, height: 22)
+            }
+            y += 32
+        }
+        row(.workspace, workspaceField, height: 22, spacing: 0)
+        if apply {
+            chooseButton.sizeToFit()
+            revealButton.sizeToFit()
+            chooseButton.frame = NSRect(x: x - 4, y: y, width: chooseButton.frame.width + 6, height: 22)
+            revealButton.frame = NSRect(x: chooseButton.frame.maxX + 4, y: y, width: revealButton.frame.width + 6, height: 22)
+        }
+        y += 32
+        row(.provider, providerPopUp, height: 24, width: 200)
+        row(.kind, kindPopUp, height: 24, width: 260)
+        row(.sessionPolicy, sessionPopUp, height: 24, width: 260)
+        row(.compactOnEnd, compactPopUp, height: 24, width: 260)
+        row(.runBudget, budgetField, height: 22, width: 90)
+        row(.wrapUp, warningField, height: 22, width: 90)
+        row(.model, modelField, height: 22, width: 200)
+        row(.permissionMode, permissionPopUp, height: 24, width: 200)
+        row(.overlap, overlapPopUp, height: 24, width: 240)
+        row(.timeout, timeoutField, height: 22, width: 90)
+        row(.schedule, scheduleField, height: 22, spacing: 0)
+        let previewHeight = schedulePreview.stringValue.isEmpty ? 0 :
+            ceil(schedulePreview.sizeThatFits(NSSize(width: fieldWidth, height: 200)).height)
+        if apply {
+            schedulePreview.frame = NSRect(x: x, y: y, width: fieldWidth, height: previewHeight)
+        }
+        y += previewHeight + 12
+        let promptHeight: CGFloat = 140
+        for (field, prompt) in [(Field.startupPrompt, startupPrompt), (Field.systemPrompt, systemPrompt)] {
+            if apply {
+                labels[field]?.alignment = .left
+                labels[field]?.frame = NSRect(x: 0, y: y, width: width, height: 17)
+                prompt.frame = NSRect(x: 0, y: y + 20, width: width, height: promptHeight)
+            }
+            y += 20 + promptHeight + 4
+            error(field, x: 0, width: width)
+            y += 8
+        }
+        let statusHeight = status.stringValue.isEmpty ? 0 :
+            ceil(status.sizeThatFits(NSSize(width: width, height: 200)).height)
+        if apply {
+            status.frame = NSRect(x: 0, y: y, width: width, height: statusHeight)
+        }
+        return y + statusHeight + 4
+    }
+}
