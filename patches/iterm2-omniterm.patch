+    // MARK: - Digest
+
+    private var selectedWorkspace: String? {
+        return workspacePopUp.indexOfSelectedItem > 0 ? workspacePopUp.titleOfSelectedItem : nil
+    }
+
+    private func refreshWorkspaces() {
+        let workspaces = Array(Set(memories.flatMap(\.workspaces))).sorted()
+        let current = workspacePopUp.titleOfSelectedItem
+        guard workspacePopUp.itemTitles != ["All workspaces"] + workspaces else { return }
+        workspacePopUp.removeAllItems()
+        workspacePopUp.addItems(withTitles: ["All workspaces"] + workspaces)
+        if let current, workspacePopUp.itemTitles.contains(current) {
+            workspacePopUp.selectItem(withTitle: current)
+        }
+    }
