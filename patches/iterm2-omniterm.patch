+            // Waiting for the runner to poll would let a keystroke slip between
+            // the guard and termination. There is deliberately no SIGKILL timer.
+            if (delivered && [action isEqual:@"finish"]) delivered = kill(-processGroup, SIGTERM) == 0;
+            if (!delivered || !separateEnter) {
+                acknowledge(delivered);
+                return;
+            }
+            // The handler refuses Enter if a person typed in the meantime; the
+            // command then stays visible in their composer and is reported rejected.
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+                acknowledge(kill(-processGroup, 0) == 0 && self.runInputHandler &&
+                            self.runInputHandler(run[@"id"], @"\r"));
+            });
+        });
