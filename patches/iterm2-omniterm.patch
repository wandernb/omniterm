+    private func createGroup(in parent: String, fromKeyboard: Bool) {
+        let siblings = groupTree.allPaths.filter { OmniGroupTree.parent(of: $0) == parent }
+            .map { $0.components(separatedBy: "/").last ?? $0 }
+        let name = OmniRenameRules.uniqueName(parent.isEmpty ? "New Folder" : "New Subfolder", siblings: siblings)
+        let path = parent.isEmpty ? name : "\(parent)/\(name)"
+        let groups = configuredGroups.isEmpty ? groupTree.allPaths : configuredGroups
+        pendingEditKey = "group|\(path)"
+        pendingEditFromKeyboard = fromKeyboard
+        if !parent.isEmpty {
+            var collapsed = collapsedGroups
+            collapsed.remove(parent)
+            collapsedGroups = collapsed
+        }
+        saveGroups(groups + [path])
+    }
