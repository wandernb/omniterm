+//
+//  OmniMarkdownEditorTests.swift
+//  ModernTests
+//
+//  The prompt editor styles Markdown in place. Styling must never change the
+//  text, markers stay visible but dimmed, and Return, Tab and the formatting
+//  shortcuts edit lists and emphasis as a Markdown editor would.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniMarkdownEditorTests: XCTestCase {
+    private var window: NSWindow?
+
+    override func tearDown() {
+        window?.close()
+        window = nil
+        super.tearDown()
+    }
+
+    private func spans(_ text: String) -> [OmniMarkdownSpan] {
+        return OmniMarkdownStyler.spans(text)
+    }
+
+    private func span(_ location: Int, _ length: Int, _ style: OmniMarkdownStyle) -> OmniMarkdownSpan {
+        return OmniMarkdownSpan(range: NSRange(location: location, length: length), style: style)
+    }
+
+    private func styles(_ text: String, at location: Int) -> [OmniMarkdownStyle] {
+        return spans(text).filter { NSLocationInRange(location, $0.range) }.map(\.style)
+    }
+
+    // MARK: - Styler
+
+    func testHeadings() {
+        XCTAssertEqual(spans("# One"), [span(0, 5, .heading(1)), span(0, 2, .marker)])
+        XCTAssertEqual(spans("### Three"), [span(0, 9, .heading(3)), span(0, 4, .marker)])
+        XCTAssertEqual(spans("#tag"), [])
+    }
+
+    func testBoldItalicAndBoth() {
+        XCTAssertEqual(spans("a **b** c"), [span(2, 2, .marker), span(4, 1, .bold), span(5, 2, .marker)])
+        XCTAssertEqual(spans("*i*"), [span(0, 1, .marker), span(1, 1, .italic), span(2, 1, .marker)])
+        XCTAssertEqual(spans("_i_"), [span(0, 1, .marker), span(1, 1, .italic), span(2, 1, .marker)])
+        XCTAssertEqual(spans("snake_case_name"), [])
+        XCTAssertEqual(spans("2 * 3 * 4"), [])
+        let both = "***x***"
+        XCTAssertEqual(Set(styles(both, at: 3).map { "\($0)" }), Set(["bold", "italic"]))
+    }
+
+    func testInlineCodeHidesEmphasis() {
+        XCTAssertEqual(spans("`a*b*`"), [span(0, 1, .marker), span(1, 4, .code), span(5, 1, .marker)])
+    }
+
+    func testFencedBlockIsCodeUntilItCloses() {
+        let text = "```swift\n**not bold**\n```\n**bold**"
+        XCTAssertEqual(styles(text, at: 12), [.codeBlock])
+        XCTAssertEqual(styles(text, at: 0), [.codeBlock, .marker])
+        XCTAssertEqual(styles(text, at: 22), [.codeBlock, .marker])
+        XCTAssertEqual(styles(text, at: 28), [.bold])
+        // An unclosed fence runs to the end, as in CommonMark.
+        XCTAssertEqual(styles("```\n# x", at: 5), [.codeBlock])
+    }
+
+    func testListsQuotesAndLinks() {
+        XCTAssertEqual(spans("- item"), [span(0, 6, .listItem), span(0, 2, .marker)])
+        XCTAssertEqual(spans("  12. item"), [span(0, 10, .listItem), span(2, 4, .marker)])
+        XCTAssertEqual(spans("- [x] done"), [span(0, 10, .listItem), span(0, 6, .marker)])
+        XCTAssertEqual(spans("> quoted"), [span(0, 8, .quote), span(0, 2, .marker)])
+        XCTAssertEqual(spans("[text](https://x.io)"),
+                       [span(0, 1, .marker), span(1, 4, .link), span(5, 2, .marker), span(7, 12, .linkTarget),
+                        span(19, 1, .marker)])
+        XCTAssertEqual(spans("[not a link]"), [])
+    }
+
+    func testMarkersAreDimmedAndSmaller() {
+        let text = NSMutableAttributedString(string: "## Plan with **bold** text")
+        OmniMarkdownStyler.apply(to: text, fontSize: 13)
+        let markerColor = text.attribute(.foregroundColor, at: 0, effectiveRange: nil) as? NSColor
+        let markerFont = text.attribute(.font, at: 0, effectiveRange: nil) as? NSFont
+        let titleFont = text.attribute(.font, at: 3, effectiveRange: nil) as? NSFont
+        XCTAssertEqual(markerColor, NSColor.tertiaryLabelColor)
+        XCTAssertLessThan(markerFont?.pointSize ?? 99, titleFont?.pointSize ?? 0)
+        XCTAssertGreaterThan(titleFont?.pointSize ?? 0, 13)
+
+        let boldMarker = text.attribute(.foregroundColor, at: 13, effectiveRange: nil) as? NSColor
+        let boldFont = text.attribute(.font, at: 15, effectiveRange: nil) as? NSFont
+        XCTAssertEqual(boldMarker, NSColor.tertiaryLabelColor)
+        XCTAssertTrue(boldFont?.fontDescriptor.symbolicTraits.contains(.bold) ?? false)
+    }
+
+    func testStylingNeverChangesTheText() {
+        let markdown = "# Title\n\n- one **two**\n  1. `three`\n> quote [x](y)\n```\ncode *\n```\nend 🎉 é\n"
+        let attributed = NSMutableAttributedString(string: markdown)
+        OmniMarkdownStyler.apply(to: attributed, fontSize: 13)
+        XCTAssertEqual(attributed.string, markdown)
+
+        let editor = OmniMarkdownEditor()
+        editor.text = markdown
+        editor.textView.setSelectedRange(NSRange(location: (markdown as NSString).length, length: 0))
+        editor.textView.insertText("**more**", replacementRange: editor.textView.selectedRange())
+        XCTAssertEqual(editor.text, markdown + "**more**")
+        XCTAssertEqual(editor.textView.string, markdown + "**more**")
+        // The typed text was styled too.
+        let font = editor.textView.textStorage?.attribute(.font, at: (markdown as NSString).length + 3,
+                                                           effectiveRange: nil) as? NSFont
+        XCTAssertTrue(font?.fontDescriptor.symbolicTraits.contains(.bold) ?? false)
+    }
+
+    // MARK: - Return and Tab
+
+    func testReturnContinuesAList() {
+        XCTAssertEqual(OmniMarkdownEditing.newline(in: "- one", selection: NSRange(location: 5, length: 0)),
+                       OmniMarkdownEdit(range: NSRange(location: 5, length: 0), replacement: "\n- ",
+                                        selection: NSRange(location: 8, length: 0)))
+        XCTAssertEqual(OmniMarkdownEditing.newline(in: "  9) x", selection: NSRange(location: 6, length: 0))?.replacement,
+                       "\n  10) ")
+        XCTAssertEqual(OmniMarkdownEditing.newline(in: "- [x] a", selection: NSRange(location: 7, length: 0))?.replacement,
+                       "\n- [ ] ")
+        XCTAssertNil(OmniMarkdownEditing.newline(in: "plain", selection: NSRange(location: 5, length: 0)))
+        XCTAssertNil(OmniMarkdownEditing.newline(in: "```\n- x", selection: NSRange(location: 7, length: 0)))
+
+        let editor = OmniMarkdownEditor()
+        editor.text = "1. first"
+        editor.textView.setSelectedRange(NSRange(location: 8, length: 0))
+        editor.textView.insertNewline(nil)
+        editor.textView.insertText("second", replacementRange: editor.textView.selectedRange())
+        XCTAssertEqual(editor.text, "1. first\n2. second")
+    }
+
+    func testReturnOnAnEmptyItemEndsTheList() {
+        XCTAssertEqual(OmniMarkdownEditing.newline(in: "- a\n- ", selection: NSRange(location: 6, length: 0)),
+                       OmniMarkdownEdit(range: NSRange(location: 4, length: 2), replacement: "",
+                                        selection: NSRange(location: 4, length: 0)))
+
+        let editor = OmniMarkdownEditor()
+        editor.text = "- a"
+        editor.textView.setSelectedRange(NSRange(location: 3, length: 0))
+        editor.textView.insertNewline(nil)
+        editor.textView.insertNewline(nil)
+        XCTAssertEqual(editor.text, "- a\n")
+        editor.textView.insertNewline(nil)
+        XCTAssertEqual(editor.text, "- a\n\n")
+    }
+
+    func testTabIndentsAndShiftTabOutdentsListItems() {
+        let indent = OmniMarkdownEditing.indent(in: "- a\n- b", selection: NSRange(location: 6, length: 0), outdent: false)
+        XCTAssertEqual(indent, OmniMarkdownEdit(range: NSRange(location: 4, length: 3), replacement: "    - b",
+                                                selection: NSRange(location: 10, length: 0)))
+        let outdent = OmniMarkdownEditing.indent(in: "- a\n    - b", selection: NSRange(location: 4, length: 7),
+                                                 outdent: true)
+        XCTAssertEqual(outdent?.replacement, "- b")
+        XCTAssertEqual(outdent?.selection, NSRange(location: 4, length: 3))
+        XCTAssertNil(OmniMarkdownEditing.indent(in: "text", selection: NSRange(location: 2, length: 0), outdent: false))
+
+        let editor = OmniMarkdownEditor()
+        editor.text = "- a\n- b"
+        editor.textView.setSelectedRange(NSRange(location: 0, length: 7))
+        editor.textView.insertTab(nil)
+        XCTAssertEqual(editor.text, "    - a\n    - b")
+        editor.textView.insertBacktab(nil)
+        XCTAssertEqual(editor.text, "- a\n- b")
+    }
+
+    // MARK: - Shortcuts
+
+    func testToggleBoldAndItalic() {
+        let bold = OmniMarkdownEditing.toggle("**", in: "a word", selection: NSRange(location: 2, length: 4))
+        XCTAssertEqual(bold, OmniMarkdownEdit(range: NSRange(location: 2, length: 4), replacement: "**word**",
+                                              selection: NSRange(location: 4, length: 4)))
+        let unbold = OmniMarkdownEditing.toggle("**", in: "a **word**", selection: NSRange(location: 4, length: 4))
+        XCTAssertEqual(unbold.replacement, "word")
+        XCTAssertEqual(unbold.range, NSRange(location: 2, length: 8))
+        // Italic on bold text adds italic rather than stripping a star.
+        XCTAssertEqual(OmniMarkdownEditing.toggle("*", in: "**w**", selection: NSRange(location: 2, length: 1)).replacement,
+                       "*w*")
+        XCTAssertEqual(OmniMarkdownEditing.toggle("*", in: "", selection: NSRange(location: 0, length: 0)),
+                       OmniMarkdownEdit(range: NSRange(location: 0, length: 0), replacement: "**",
+                                        selection: NSRange(location: 1, length: 0)))
+    }
+
+    func testLinkShortcut() {
+        XCTAssertEqual(OmniMarkdownEditing.link(in: "see docs", selection: NSRange(location: 4, length: 4)),
+                       OmniMarkdownEdit(range: NSRange(location: 4, length: 4), replacement: "[docs]()",
+                                        selection: NSRange(location: 11, length: 0)))
+        XCTAssertEqual(OmniMarkdownEditing.link(in: "https://a.b", selection: NSRange(location: 0, length: 11)).replacement,
+                       "[](https://a.b)")
+    }
+
+    private func commandKey(_ character: String, keyCode: UInt16, in window: NSWindow) -> NSEvent {
+        return NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: .command, timestamp: 0,
+                                windowNumber: window.windowNumber, context: nil, characters: character,
+                                charactersIgnoringModifiers: character, isARepeat: false, keyCode: keyCode)!
+    }
+
+    func testCommandBWrapsTheSelectionOnlyWhileFocused() {
+        let window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 400, height: 200), styleMask: [.titled],
+                              backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+        self.window = window
+        let editor = OmniMarkdownEditor()
+        editor.frame = NSRect(x: 0, y: 0, width: 400, height: 200)
+        window.contentView?.addSubview(editor)
+        editor.text = "make this bold"
+        editor.textView.setSelectedRange(NSRange(location: 10, length: 4))
+        let commandB = commandKey("b", keyCode: 11, in: window)
+
+        window.makeFirstResponder(nil)
+        XCTAssertFalse(editor.textView.performKeyEquivalent(with: commandB))
+        XCTAssertEqual(editor.text, "make this bold")
+
+        window.makeFirstResponder(editor.textView)
+        XCTAssertTrue(editor.textView.performKeyEquivalent(with: commandB))
+        XCTAssertEqual(editor.text, "make this **bold**")
+        XCTAssertEqual(editor.textView.selectedRange(), NSRange(location: 12, length: 4))
+        XCTAssertTrue(editor.textView.performKeyEquivalent(with: commandB))
+        XCTAssertEqual(editor.text, "make this bold")
+        editor.textView.undoManager?.removeAllActions()
+    }
+
+    // MARK: - Read-only view
+
+    func testReadOnlyViewFitsItsContent() {
+        let view = OmniMarkdownView(text: "One line")
+        XCTAssertFalse(view.textView.isEditable)
+        XCTAssertTrue(view.textView.isSelectable)
+        let carded = view.height(forWidth: 300 + 2 * OmniMarkdownView.cardPadding)
+        view.drawsCard = false
+        let one = view.height(forWidth: 300)
+        XCTAssertEqual(carded, one + 2 * OmniMarkdownView.cardPadding, "The card adds its padding around the text")
+        XCTAssertGreaterThan(one, 10)
+        view.text = "# Title\n\nOne\nTwo\nThree"
+        let five = view.height(forWidth: 300)
+        XCTAssertGreaterThan(five, one * 3)
+        view.text = String(repeating: "word ", count: 80)
+        XCTAssertGreaterThan(view.height(forWidth: 150), view.height(forWidth: 600))
+    }
+
+    func testReadOnlyViewCollapsesLongText() {
+        let lines = (1...30).map { "Line \($0)" }.joined(separator: "\n")
+        let view = OmniMarkdownView(text: lines)
+        view.drawsCard = false
+        let full = view.height(forWidth: 300)
+        var heightChanges = 0
+        view.didChangeHeight = { heightChanges += 1 }
+        view.collapsedHeight = 80
+        XCTAssertTrue(view.isCollapsible(width: 300))
+        let collapsed = view.height(forWidth: 300)
+        XCTAssertLessThanOrEqual(collapsed, 80 + OmniMarkdownView.toggleHeight)
+        XCTAssertGreaterThan(collapsed, OmniMarkdownView.toggleHeight)
+        view.toggleExpanded(nil)
+        XCTAssertTrue(view.isExpanded)
+        XCTAssertEqual(view.height(forWidth: 300), full + OmniMarkdownView.toggleHeight)
+        XCTAssertEqual(heightChanges, 2)
+
+        let short = OmniMarkdownView(text: "Short")
+        let shortHeight = short.height(forWidth: 300)
+        short.collapsedHeight = 80
+        XCTAssertFalse(short.isCollapsible(width: 300))
+        XCTAssertEqual(short.height(forWidth: 300), shortHeight)
+    }
+
+    // MARK: - Rendered view
+
+    func testFrontMatterIsReadAsProperties() {
+        let text = "---\ntitle: \"Plan\"\ntags: [a, b]\naliases:\n  - one\n  - two\n---\n# Body"
+        let front = OmniMarkdownFrontMatter.parse(text)
+        XCTAssertEqual(front?.entries, [.init(key: "title", value: "Plan"), .init(key: "tags", value: "a, b"),
+                                        .init(key: "aliases", value: "one, two")])
+        XCTAssertEqual(front?.body, "# Body")
+        XCTAssertNil(OmniMarkdownFrontMatter.parse("Text\n---\nMore"), "A rule later on is not front matter")
+        XCTAssertNil(OmniMarkdownFrontMatter.parse("---\nnever closed"))
+
+        let view = OmniMarkdownView(text: text)
+        view.drawsCard = false
+        view.rendersMarkdown = true
+        XCTAssertEqual(view.text, text, "The view keeps the Markdown it was given")
+        XCTAssertEqual(view.textView.string, "Body", "Front matter starts collapsed and syntax is hidden")
+        XCTAssertFalse(view.propertiesButton.isHidden)
+        let collapsed = view.height(forWidth: 300)
+        view.toggleProperties(nil)
+        XCTAssertTrue(view.textView.string.contains("title\tPlan"))
+        XCTAssertGreaterThan(view.height(forWidth: 300), collapsed)
+    }
+
+    func testRenderedTablesListsAndCode() {
+        let rendered = OmniMarkdownRenderer.render("| A | B |\n|---|--:|\n| **x** | `y` |\n\n- [x] done\n1. one\n\n```sh\nls\n```")
+        let string = rendered.string
+        XCTAssertFalse(string.contains("|") || string.contains("**") || string.contains("`") || string.contains("[x]"))
+        var cells = 0
+        rendered.enumerateAttribute(.paragraphStyle, in: NSRange(location: 0, length: rendered.length)) { value, _, _ in
+            if (value as? NSParagraphStyle)?.textBlocks.first is NSTextTableBlock {
+                cells += 1
+            }
+        }
+        XCTAssertGreaterThan(cells, 0)
+        let header = rendered.attribute(.font, at: (string as NSString).range(of: "A").location, effectiveRange: nil) as? NSFont
+        XCTAssertTrue(header?.fontDescriptor.symbolicTraits.contains(.bold) ?? false, "Header cells are bold")
+        XCTAssertTrue(string.contains("☑\tdone"))
+        XCTAssertTrue(string.contains("1.\tone"))
+        let code = rendered.attribute(.font, at: (string as NSString).range(of: "ls").location, effectiveRange: nil) as? NSFont
+        XCTAssertTrue(code?.isFixedPitch ?? false)
+        XCTAssertEqual(OmniMarkdownRenderer.codeBlock("a ``` b"), "````\na ``` b\n````")
+    }
+
+    // Badges, images and raw HTML read as GitHub shows them; code keeps its tags.
+    func testRenderedImagesAndHTMLShowTheirText() {
+        let markdown = "[![Tests](https://x/badge.svg)](https://x/actions) ![Shot](a.png)\n"
+            + "<p align=\"center\">\n<a href=\"https://x\"><strong>Download</strong></a><br>\n</p>\n\n```html\n<b>kept</b>\n```"
+        let text = OmniMarkdownRenderer.render(markdown).string
+        XCTAssertTrue(text.contains("Tests"))
+        XCTAssertTrue(text.contains("Shot"))
+        XCTAssertTrue(text.contains("Download"))
+        XCTAssertFalse(text.contains("!["))
+        XCTAssertFalse(text.contains("<a"))
+        XCTAssertFalse(text.contains("<p"))
+        XCTAssertTrue(text.contains("<b>kept</b>"))
+    }
+}
