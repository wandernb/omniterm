+    // Shows one memory's neighbourhood in place of the current graph.
+    func pushGraphFocus(_ id: String, label: String) {
+        let id = Self.memoryID(forGraphNode: id)
+        guard graphFocus != id else { return }
+        graphFocusStack.append(OmniGraphFocus(id: id, label: label, members: [id]))
+        updateGraphBreadcrumb()
+        loadGraph(fit: true)
+    }
