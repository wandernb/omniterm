+// Each turn of a loop shows as its own run, while the loop keeps one live run,
+// tab and provider session.
+- (void)testEachFinishedLoopTurnIsRecordedAsItsOwnRun {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSMutableDictionary *agent = [[_scheduler responseForRequest:@{ @"op": @"show_agent", @"name": @"Review" }][@"agent"] mutableCopy];
+    agent[@"kind"] = @"loop";
+    agent[@"startup_prompt"] = @"Next unit";
+    [_scheduler responseForRequest:@{ @"op": @"save_agent", @"agent": agent }];
+    NSString *runID = [_scheduler startAgentNamed:@"Review" reason:@"scheduled" resumeSessionID:nil][@"run_id"];
+    [_scheduler runSQL:@"UPDATE runs SET state='running',started=100,pgid=2147483647 WHERE id=?" bindings:@[ runID ]];
+    XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"runner_turn", @"run_id": runID, @"finished": @YES,
+                                                             @"turn_at": @200, @"final_message": @"First turn done" }][@"ok"]), @YES);
+    XCTAssertTrue(([_scheduler runSQL:@"INSERT INTO notifications(id,created,updated,title,body,severity,run_id) "
+                                       @"VALUES('n1',150,150,'During the first turn','x','attention',?)" bindings:@[ runID ]]));
+    XCTAssertEqualObjects(([_scheduler startAgentNamed:@"Review" reason:@"scheduled" resumeSessionID:nil][@"run_id"]), runID);
+    NSString *token = [_scheduler responseForRequest:@{ @"op": @"runner_loop_poll", @"run_id": runID }][@"token"];
+    XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"runner_loop_claim", @"run_id": runID, @"token": token }][@"ok"]), @YES);
+    // The runner sees the new turn start in the transcript before it acknowledges it.
+    XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"runner_turn", @"run_id": runID, @"finished": @NO }][@"ok"]), @YES);
+    XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"runner_loop_ack", @"run_id": runID, @"token": token }][@"ok"]), @YES);
+
+    NSDictionary *turn = [_scheduler rowsForSQL:@"SELECT * FROM runs WHERE loop_parent=?" bindings:@[ runID ]].firstObject;
+    XCTAssertNotNil(turn);
+    XCTAssertEqualObjects(turn[@"state"], @"completed");
+    XCTAssertEqualObjects(turn[@"started"], @100);
+    XCTAssertEqualObjects(turn[@"finished"], @200);
+    XCTAssertEqualObjects(turn[@"final_message"], @"First turn done");
+    XCTAssertEqualObjects(turn[@"session_id"], runID, @"The turn ran in the loop's provider session");
+    XCTAssertEqualObjects(turn[@"pgid"], NSNull.null, @"A recorded turn must never be signalled");
+    NSDictionary *live = [_scheduler rowsForSQL:@"SELECT * FROM runs WHERE id=?" bindings:@[ runID ]].firstObject;
+    XCTAssertEqualObjects(live[@"state"], @"running");
+    XCTAssertEqualObjects(live[@"turn_finished"], @0);
+    XCTAssertEqualObjects(live[@"final_message"], NSNull.null);
+    XCTAssertEqualObjects(live[@"turn_at"], NSNull.null);
+    XCTAssertGreaterThan([live[@"started"] doubleValue], 200);
+    NSDictionary *notification = [_scheduler rowsForSQL:@"SELECT run_id FROM notifications WHERE title='During the first turn'" bindings:@[]].firstObject;
+    XCTAssertEqualObjects(notification[@"run_id"], turn[@"id"]);
+
+    // A summary of the first turn that arrives late goes to its own row.
+    XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"run_summary", @"run_id": runID, @"state": @"ready",
+                                                             @"summary": @"Did the first unit", @"turn_at": @200 }][@"ok"]), @YES);
+    XCTAssertEqualObjects(([_scheduler rowsForSQL:@"SELECT summary FROM runs WHERE id=?" bindings:@[ turn[@"id"] ]].firstObject[@"summary"]),
+                          @"Did the first unit");
+    XCTAssertEqualObjects(([_scheduler rowsForSQL:@"SELECT summary FROM runs WHERE id=?" bindings:@[ runID ]].firstObject[@"summary"]), NSNull.null);
+    // The summarizer reads the run as it was for its turn.
+    XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"get_run", @"id": runID, @"turn_at": @200 }][@"run"][@"id"]), turn[@"id"]);
+    XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"get_run", @"id": runID }][@"run"][@"id"]), runID);
+
+    // Listing shows both, newest first.
+    NSArray *runs = [_scheduler responseForRequest:@{ @"op": @"list_runs", @"agent": @"Review" }][@"runs"];
+    XCTAssertEqualObjects([runs valueForKey:@"id"], (@[ runID, turn[@"id"] ]));
+
+    // A stopped loop resumes in its own row, never in a recorded turn.
+    [_scheduler runSQL:@"UPDATE runs SET state='completed',turn_finished=1,finished=?,pid=NULL,pgid=NULL WHERE id=?"
+              bindings:@[ @(NSDate.date.timeIntervalSince1970), runID ]];
+    XCTAssertEqualObjects(([_scheduler startAgentNamed:@"Review" reason:@"scheduled" resumeSessionID:nil][@"run_id"]), runID);
+}
