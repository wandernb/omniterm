+// The base of every pane: a flipped view with a centered message for the
+// loading, empty and unreachable states.
+class OmniPane: NSView {
+    weak var actions: OmniPaneActions?
+    weak var layoutStore: OmniPanelLayoutStore?
+    let messageLabel = NSTextField(wrappingLabelWithString: "")
+
+    override var isFlipped: Bool { true }
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 800, height: 600))
+        wantsLayer = true
+        layer?.backgroundColor = OmniTheme.contentBackground.cgColor
+        messageLabel.alignment = .center
+        messageLabel.textColor = OmniTheme.secondaryText
+        messageLabel.font = OmniTheme.Font.placeholder
+        addSubview(messageLabel)
+        showMessage("Loading…")
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func viewDidChangeEffectiveAppearance() {
+        super.viewDidChangeEffectiveAppearance()
+        effectiveAppearance.performAsCurrentDrawingAppearance {
+            layer?.backgroundColor = OmniTheme.contentBackground.cgColor
+        }
+    }
+
+    func reload() {
+    }
+
+    // Collapsed panels and dragged sizes, from the window's layout.
+    func applyPanelLayout(_ layout: OmniPanelLayout) {
+    }
+
+    // A page's own shortcuts while one of its zones has the keyboard.
+    func handlePaneShortcut(_ event: NSEvent) -> Bool {
+        return false
+    }
+
+    // The page's keyboard zones in Tab order; the first is where Right from
+    // the sidebar lands.
+    var focusZones: [OmniFocusZone] {
+        return []
+    }
+
+    // Rebuilding a list takes its zone out of the window for a moment; the
+    // zone that had the keyboard gets it back.
+    func preservingZoneFocus(_ body: () -> Void) {
+        let focused = focusZones.first { window?.firstResponder === $0.zoneFirstResponder }
+        body()
+        if let focused, focused.zoneCanEnter, window?.firstResponder !== focused.zoneFirstResponder {
+            window?.makeFirstResponder(focused.zoneFirstResponder)
+        }
+    }
+
+    // A message replaces the content until showContent() is called.
+    func showMessage(_ message: String) {
+        messageLabel.stringValue = message
+        messageLabel.isHidden = false
+        for view in contentViews {
+            view.isHidden = true
+        }
+        layoutPane()
+    }
+
+    func showContent() {
+        messageLabel.isHidden = true
+        for view in contentViews {
+            view.isHidden = false
+            OmniPointer.install(in: view)
+        }
+        layoutPane()
+    }
+
+    var contentViews: [NSView] {
+        return []
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        layoutPane()
+    }
+
+    func layoutPane() {
+        // Controls a page builds once its data arrives get the pointer here.
+        OmniPointer.install(in: self)
+        let width = max(100, bounds.width - 80)
+        let height = messageLabel.sizeThatFits(NSSize(width: width, height: 200)).height
+        messageLabel.frame = NSRect(x: (bounds.width - width) / 2, y: bounds.height / 2 - height / 2 - 20,
+                                    width: width, height: height)
+    }
+
+    static func unreachableMessage(_ response: [AnyHashable: Any]) -> String {
+        let error = response["error"] as? String
+        return "The OmniTerm scheduler is unavailable." + (error.map { "\n\($0)" } ?? "")
+    }
+
+    static func isOK(_ response: [AnyHashable: Any]) -> Bool {
+        return response["ok"] as? Bool == true
+    }
+}
