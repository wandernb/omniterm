+    private func configureTable(_ table: OmniMemoryTableView, in scroll: NSScrollView, label: String) {
+        let column = NSTableColumn(identifier: NSUserInterfaceItemIdentifier("main"))
+        table.addTableColumn(column)
+        table.headerView = nil
+        table.rowHeight = Self.rowHeight
+        table.style = .plain
+        table.intercellSpacing = NSSize(width: 0, height: 0)
+        table.backgroundColor = .clear
+        table.dataSource = self
+        table.delegate = self
+        table.setAccessibilityLabel(label)
+        scroll.documentView = table
+        scroll.hasVerticalScroller = true
+        scroll.drawsBackground = false
+        scroll.borderType = .noBorder
+    }
+
+    private func configureText(_ text: NSTextView, in scroll: NSScrollView) {
+        text.isEditable = false
+        text.isSelectable = true
+        text.drawsBackground = false
+        text.textContainerInset = NSSize(width: 18, height: 16)
+        text.isVerticallyResizable = true
+        text.isHorizontallyResizable = false
+        text.autoresizingMask = [.width]
+        text.textContainer?.widthTracksTextView = true
+        scroll.documentView = text
+        scroll.hasVerticalScroller = true
+        scroll.drawsBackground = false
+        scroll.borderType = .noBorder
+    }
