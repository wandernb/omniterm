+// Sends every scheduler call to the scheduler's own serial queue, as socket
+// requests are. Once started, the scheduler's tick reloads agent files on that
+// queue; a call from the test thread could otherwise race a reload that has
+// not yet seen a file written a moment earlier and lose the agent.
+static void *const OmniSchedulerTestQueueKey = (void *)&OmniSchedulerTestQueueKey;
+
+@interface OmniSchedulerQueueProxy : NSProxy
+- (instancetype)initWithScheduler:(OmniScheduler *)scheduler;
+@end
+
+@implementation OmniSchedulerQueueProxy {
+    OmniScheduler *_target;
+    dispatch_queue_t _queue;
+}
+
+- (instancetype)initWithScheduler:(OmniScheduler *)scheduler {
+    _target = scheduler;
+    _queue = [scheduler valueForKey:@"queue"];
+    dispatch_queue_set_specific(_queue, OmniSchedulerTestQueueKey, OmniSchedulerTestQueueKey, NULL);
+    return self;
+}
+
+- (NSMethodSignature *)methodSignatureForSelector:(SEL)selector {
+    return [_target methodSignatureForSelector:selector];
+}
+
+- (BOOL)respondsToSelector:(SEL)selector {
+    return [_target respondsToSelector:selector];
+}
+
+- (void)forwardInvocation:(NSInvocation *)invocation {
+    // Lifecycle and wiring stay on the caller's thread: stop waits on the
+    // queue itself, and the paths are set before anything runs.
+    static NSSet<NSString *> *direct;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        direct = [NSSet setWithArray:@[ @"start", @"stop", @"performRequest:completion:",
+                                        @"valueForKey:", @"setValue:forKey:",
+                                        @"setNotificationsChangedHandler:", @"setShowInboxHandler:",
+                                        @"setRunScreenRequestHandler:", @"notificationsChangedHandler",
+                                        @"showInboxHandler", @"runScreenRequestHandler",
+                                        // Called from the knowledge queue; it hops onto the queue itself.
+                                        @"raiseKnowledgeNotification:" ]];
+    });
+    if ([direct containsObject:NSStringFromSelector(invocation.selector)] ||
+        dispatch_get_specific(OmniSchedulerTestQueueKey)) {
+        [invocation invokeWithTarget:_target];
+        return;
+    }
+    [invocation retainArguments];
+    const BOOL returnsObject = invocation.methodSignature.methodReturnType[0] == '@';
+    OmniScheduler *target = _target;
+    dispatch_sync(_queue, ^{
+        [invocation invokeWithTarget:target];
+        if (returnsObject) {
+            // Keep the (autoreleased) result alive past the queue's pool.
+            __unsafe_unretained id result = nil;
+            [invocation getReturnValue:&result];
+            if (result) {
+                CFRetain((__bridge CFTypeRef)result);
+            }
+        }
+    });
+    if (returnsObject) {
+        __unsafe_unretained id result = nil;
+        [invocation getReturnValue:&result];
+        if (result) {
+            CFAutorelease((__bridge CFTypeRef)result);
+        }
+    }
+}
+
+@end
