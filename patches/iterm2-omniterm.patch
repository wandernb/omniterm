+    // Agents mode search: rows whose name or detail holds the query; a
+    // folder stays while any row in it matches.
+    private static func filtered(_ rows: [OmniSidebarItem], query: String) -> [OmniSidebarItem] {
+        return rows.compactMap { row in
+            if row.isFolder {
+                let children = filtered(row.children, query: query)
+                guard !children.isEmpty else { return nil }
+                row.children = children
+                return row
+            }
+            let text = (row.title + " " + row.detail).lowercased()
+            return text.contains(query) ? row : nil
+        }
+    }
