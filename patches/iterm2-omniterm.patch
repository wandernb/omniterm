+    // A node a link named: selected once the graph has it, then opened as a
+    // double-click would.
+    private var pendingNode: (id: String, open: Bool)?
+
+    private func applyPendingNode() {
+        guard let pending = pendingNode, canvas.positions[pending.id] != nil else { return }
+        pendingNode = nil
+        canvas.select(pending.id)
+        if pending.open {
+            canvas.openNode?(pending.id)
+        }
+    }
+
+    // Loads the overview and the shown tab. The page's periodic reload calls
+    // this; each part redraws only when its data changed.
+    func reload() {
+        guard isViewLoaded, Date().timeIntervalSince(lastBackgroundLoad) >= Self.backgroundReloadInterval else { return }
+        loadTab()
+    }
+
+    // One request of each kind at a time: a reload while an answer is still
+    // on its way waits for that answer instead of queueing another.
+    private func request(_ kind: String, _ arguments: [String: Any], completion: @escaping ([AnyHashable: Any]) -> Void) {
+        guard !inFlight.contains(kind) else { return }
+        inFlight.insert(kind)
+        OmniSchedulerClient.request(arguments) { [weak self] response in
+            self?.inFlight.remove(kind)
+            completion(response)
+        }
+    }
+
+    private func loadTab() {
+        lastBackgroundLoad = Date()
+        request("overview", ["op": "memory_overview"]) { [weak self] response in
+            self?.renderOverview(response)
+        }
+        switch tab {
+        case .browse: loadMemories()
+        case .search: break
+        case .process: loadEvents()
+        case .digest: loadDigest(regenerate: false)
+        case .graph:
+            loadEvents()
+            loadGraph(fit: false)
+        case .ingest: loadIngestRuns()
+        }
+    }
+
+    private func renderOverview(_ response: [AnyHashable: Any]) {
+        guard OmniPane.isOK(response), let overview = response["overview"] as? [AnyHashable: Any] else {
+            summaryLabel.stringValue = response["error"] as? String ?? "Memory is unavailable"
+            return
+        }
+        self.overview = overview
+        let coverage = OmniMemoryText.coverageLine((overview["pipeline"] as? [AnyHashable: Any])?["coverage"]
+                                                   as? [AnyHashable: Any])
+        if coverage != ingestCoverage.stringValue {
+            ingestCoverage.stringValue = coverage
+            if isViewLoaded { layout(root.bounds.size) }
+        }
+        let count = OmniMemoryText.number(overview["memories"]) ?? 0
+        let fading = OmniMemoryText.number(overview["expiry_candidates"]) ?? 0
+        let pipeline = overview["pipeline"] as? [AnyHashable: Any] ?? [:]
+        var parts = [count == 1 ? "1 memory" : "\(count) memories"]
+        if fading > 0 { parts.append("\(fading) fading") }
+        if let pending = OmniMemoryText.number(pipeline["candidates_pending"]) {
+            let cap = OmniMemoryText.number(pipeline["candidates_pending_cap"]) ?? 10000
+            parts.append(pending > cap ? "\(cap)+ candidates waiting" : "\(pending) candidates waiting")
+        }
+        if pipeline["scan_in_progress"] as? Bool == true { parts.append("indexing") }
+        summaryLabel.stringValue = parts.joined(separator: "  ·  ")
+        pipelineView.update(overview: overview)
+    }
