+    @objc func focusSidebar() {
+        guard let window = view.window else { return }
+        if panelLayout.layout.sidebarCollapsed {
+            panelLayout.update { $0.sidebarCollapsed = false }
+        }
+        let focused = window.makeFirstResponder(outlineView)
+        omniSidebarKeysLog.notice("focusSidebar makeFirstResponder -> \(focused, privacy: .public)")
+        if outlineView.selectedRow < 0 {
+            moveSelection(by: 1)
+        }
+    }
+
+    // Tab or Return on a page: the page's first control, or the terminal.
+    private func focusContent() {
+        guard let window = view.window else { return }
+        if contentHost.isShowingPane, contentHost.coversTerminal, contentHost.window === window {
+            if contentHost.enterFirstZone() {
+                return
+            }
+            let first = contentHost.pane.flatMap { Self.firstKeyView(in: $0) }
+            window.makeFirstResponder(first ?? contentHost)
+        } else if let session = terminal?.currentTab()?.activeSession {
+            session.takeFocus()
+        }
+    }
+
+    private static func firstKeyView(in view: NSView) -> NSView? {
+        for subview in view.subviews where !subview.isHidden {
+            if subview.canBecomeKeyView {
+                return subview
+            }
+            if let found = firstKeyView(in: subview) {
+                return found
+            }
+        }
+        return nil
+    }
+
+    // TEMP sidebar-keys: navigation keys and shortcuts by code, never text.
+    @objc(loggableKey:)
+    static func loggableKey(_ event: NSEvent) -> String {
+        let navigation: Set<UInt16> = [36, 48, 53, 76, 123, 124, 125, 126]
+        let flags = modifiers(event)
+        guard navigation.contains(event.keyCode) || !flags.isDisjoint(with: [.command, .control]) else { return "other" }
+        return "\(event.keyCode) flags=\(flags.rawValue)"
+    }
+
+    private static func modifiers(_ event: NSEvent) -> NSEvent.ModifierFlags {
+        return event.modifierFlags.intersection([.command, .option, .control, .shift])
+    }
+
+    // Every key in the window passes here first. Control-Command-S works
+    // from anywhere in the window (Command-0 is iTerm2's Make Text Normal
+    // Size); everything else only while the sidebar has focus, so nothing is
+    // taken from a terminal. Other Command keys still reach the menus, and
+    // Escape keeps its double-Escape meaning.
+    @objc(handleWindowKeyDown:)
+    func handleWindowKeyDown(_ event: NSEvent) -> Bool {
+        guard event.type == .keyDown else { return false }
+        let flags = Self.modifiers(event)
+        if flags == [.control, .command], event.charactersIgnoringModifiers?.lowercased() == "s" {
+            omniSidebarKeysLog.notice("handleWindowKeyDown ctrl-cmd-S -> focus sidebar")
+            focusSidebar()
+            return true
+        }
+        // The keyboard map: Command-/ from anywhere in the window; ? only
+        // while the sidebar or a page's zone has the keyboard, so typing it
+        // in a terminal still types it.
+        if let window = view.window, isKeyboardMapKey(event) {
+            OmniKeyboardMap.show(for: window)
+            return true
+        }
+        // Command-, Settings; Command-K the navigator; Command-F the search
+        // (an editor's own Find keeps it while it has the keyboard).
+        if flags == .command, let key = event.charactersIgnoringModifiers?.lowercased() {
+            switch key {
+            case ",":
+                showSettings()
+                return true
+            case "k":
+                showQuickNav(query: nil)
+                return true
+            case "f":
+                if let editor = view.window?.firstResponder as? NSTextView, editor.isEditable, !editor.isFieldEditor {
+                    return false
+                }
+                focusSearch()
+                return true
+            default:
+                break
+            }
+        }
+        // Control-Command-1 to 4 show and hide the panels from anywhere in
+        // the window (Command-0 is iTerm2's Make Text Normal Size).
+        let panels: [UInt16: OmniPanel] = [18: .sidebar, 19: .runs, 20: .band, 21: .diff]
+        if flags == [.control, .command], let panel = panels[event.keyCode] {
+            return togglePanel(panel)
+        }
+        // Shift-Command-1 and 2: the sidebar's Agents and Sessions modes.
+        if flags == [.shift, .command], event.keyCode == 18 || event.keyCode == 19 || event.keyCode == 20 {
+            setMode(event.keyCode == 18 ? .projects : event.keyCode == 19 ? .sessions : .agents)
+            return true
+        }
+        // A page's zone has the keyboard: its keys go to it ahead of the
+        // dashboard's routing, which would otherwise take the arrows.
+        if contentHost.window === view.window, contentHost.handleZoneKey(event) {
+            omniSidebarKeysLog.notice("handleWindowKeyDown key \(Self.loggableKey(event), privacy: .public) -> zone")
+            return true
+        }
+        let responder = view.window?.firstResponder.map { String(describing: type(of: $0)) } ?? "nil"
+        guard sidebarHasFocus, event.keyCode != 53 else {
+            omniSidebarKeysLog.notice("handleWindowKeyDown pass: sidebar not focused (firstResponder \(responder, privacy: .public))")
+            return false
+        }
+        if !flags.isDisjoint(with: [.command, .control]) {
+            let handled = handleSidebarKey(event)
+            omniSidebarKeysLog.notice("handleWindowKeyDown command key \(event.keyCode, privacy: .public) handled=\(handled, privacy: .public)")
+            return handled
+        }
+        omniSidebarKeysLog.notice("handleWindowKeyDown key \(Self.loggableKey(event), privacy: .public) -> outline")
+        outlineView.keyDown(with: event)
+        return true
+    }
+
+    private func isKeyboardMapKey(_ event: NSEvent) -> Bool {
+        let flags = Self.modifiers(event)
+        if flags == .command, event.charactersIgnoringModifiers == "/" {
+            return true
+        }
+        guard event.characters == "?", flags.isSubset(of: [.shift]) else { return false }
+        return sidebarHasFocus || (contentHost.window === view.window && contentHost.hasZoneFocus)
+    }
+
+    // The sidebar's own keys while it has focus; false leaves the key to the
+    // outline view (type-to-select) or the menus.
+    func handleSidebarKey(_ event: NSEvent) -> Bool {
+        guard editing == nil else { return false }
+        let flags = Self.modifiers(event)
+        let key = event.charactersIgnoringModifiers?.lowercased() ?? ""
+        let plain = flags.isEmpty
+        let moveFlags: NSEvent.ModifierFlags = [.option, .command]
+        switch event.keyCode {
+        case 126 where plain:
+            moveSelection(by: -1)
+        case 125 where plain:
+            moveSelection(by: 1)
+        case 126 where flags == moveFlags:
+            moveSelectedItem(by: -1)
+        case 125 where flags == moveFlags:
+            moveSelectedItem(by: 1)
+        case 124 where plain:
+            moveRight()
+        case 123 where plain:
+            collapseSelection()
+        case 36 where plain, 76 where plain:
+            if let item = selectedItem, item.kind == .agent || item.isFolder || item.kind == .project {
+                beginEditing(item, fromKeyboard: true)
+            } else {
+                focusContent()
+            }
+        case 48 where plain:
+            focusContent()
+        default:
+            if flags == .command, key == "i" {
+                // Taken even off an agent: Edit Session would edit a hidden tab.
+                if let item = selectedItem, Self.takesAppearance(item) {
+                    showAppearancePicker(for: item)
+                }
+            } else if flags == .command, key == "n" {
+                presentNewAgent(group: selectedItem?.kind == .group ? selectedItem?.groupPath : nil)
+            } else if flags == [.command, .shift], key == "n", mode == .projects {
+                let folder = selectedItem?.kind == .projectFolder ? selectedItem?.groupPath ?? "" : ""
+                createProjectFolder(in: folder.contains("/") ? "" : folder, fromKeyboard: true)
+            } else if flags == [.command, .shift], key == "n" {
+                // In a selected top-level folder, a subfolder; else top level.
+                let folder = selectedItem?.kind == .group ? selectedItem?.groupPath ?? "" : ""
+                createGroup(in: folder.contains("/") ? "" : folder, fromKeyboard: true)
+            } else {
+                return false
+            }
+        }
+        return true
+    }
+
+    // The next selectable row up or down; section headers are skipped.
+    private func moveSelection(by step: Int) {
+        let count = outlineView.numberOfRows
+        var index = outlineView.selectedRow < 0 ? (step > 0 ? -1 : count) : outlineView.selectedRow
+        repeat {
+            index += step
+        } while index >= 0 && index < count && (outlineView.item(atRow: index) as? OmniSidebarItem)?.isSelectable == false
+        guard index >= 0, index < count else { return }
+        outlineView.selectRowIndexes(IndexSet(integer: index), byExtendingSelection: false)
+        outlineView.scrollRowToVisible(index)
+    }
+
+    // Right opens a closed folder; on anything else it goes into the page's
+    // first zone. An open folder whose page is not ready yet goes to its
+    // first item instead.
+    private func moveRight() {
+        guard let item = selectedItem else { return }
+        if item.isFolder, !outlineView.isItemExpanded(item) {
+            outlineView.expandItem(item)
+            return
+        }
+        if contentHost.window === view.window, contentHost.enterFirstZone() {
+            return
+        }
+        if item.isFolder, let first = item.children.first {
+            let index = outlineView.row(forItem: first)
+            if index >= 0 {
+                outlineView.selectRowIndexes(IndexSet(integer: index), byExtendingSelection: false)
+                outlineView.scrollRowToVisible(index)
+            }
+        }
+    }
+
+    // Left closes an open folder, or goes to the folder an item is in.
+    private func collapseSelection() {
+        guard let item = selectedItem else { return }
+        if item.isFolder, outlineView.isItemExpanded(item) {
+            outlineView.collapseItem(item)
+            return
+        }
+        guard let parent = outlineView.parent(forItem: item) as? OmniSidebarItem, parent.isFolder else { return }
+        let index = outlineView.row(forItem: parent)
+        if index >= 0 {
+            outlineView.selectRowIndexes(IndexSet(integer: index), byExtendingSelection: false)
+            outlineView.scrollRowToVisible(index)
+        }
+    }
+
+    // Option-Command-Up/Down: the same saved order a drag writes.
+    private func moveSelectedItem(by step: Int) {
+        guard let item = selectedItem, let key = Self.orderKey(item),
+              let parent = outlineView.parent(forItem: item) as? OmniSidebarItem else { return }
+        let siblings = parent.children.compactMap(Self.orderKey)
+        guard let index = siblings.firstIndex(of: key) else { return }
+        let target = index + step
+        guard target >= 0, target < siblings.count else {
+            NSSound.beep()
+            return
+        }
+        let before: String? = step < 0 ? siblings[target] : (target + 1 < siblings.count ? siblings[target + 1] : nil)
+        let saved = sidebarOrder
+        let order = OmniSidebarMoves.sidebarOrder(groupTree.displayKeys, moving: key, before: before)
+        sidebarOrder = order
+        rebuild()
+        let revertKey = item.key
+        request(["op": "set_sidebar_order", "items": order], revertKey: revertKey) { [weak self] key, message in
+            guard let self else { return }
+            self.sidebarOrder = saved
+            self.rebuild()
+            if let row = self.itemCache[key] {
+                self.showRenameProblem(message, on: row)
+            }
+        }
+    }
+}
