+    func testNetworkLayoutIsDeterministicAndPullsLinkedNodesTogether() {
+        let nodes = (0..<12).map { OmniMemoryGraphNode(id: "n\($0)", label: "N\($0)") }
+        let edges = [OmniMemoryGraphEdge(source: "n0", target: "n1", kind: "tag", strength: 1),
+                     OmniMemoryGraphEdge(source: "n1", target: "n2", kind: "session", strength: 1)]
+        let first = OmniMemoryGraphLayout.network(nodes: nodes, edges: edges)
+        let second = OmniMemoryGraphLayout.network(nodes: nodes, edges: edges)
+        XCTAssertEqual(first, second)
+        XCTAssertEqual(first.count, 12)
+        func distance(_ a: String, _ b: String) -> CGFloat {
+            return hypot(first[a]!.x - first[b]!.x, first[a]!.y - first[b]!.y)
+        }
+        let linked = distance("n0", "n1")
+        let unlinked = (3..<12).map { distance("n0", "n\($0)") }.reduce(0, +) / 9
+        XCTAssertLessThan(linked, unlinked)
+        XCTAssertTrue(first.values.allSatisfy { $0.x.isFinite && $0.y.isFinite })
+        XCTAssertEqual(OmniMemoryGraphLayout.network(nodes: [], edges: []), [:])
+    }
