+    // MARK: - NSMenuDelegate
+
+    func menuNeedsUpdate(_ menu: NSMenu) {
+        menu.removeAllItems()
+        guard menu === contextMenu,
+              let row = outlineView.item(atRow: outlineView.clickedRow) as? OmniSidebarItem else { return }
+        func add(_ title: String, _ action: Selector, _ object: Any?) {
+            let menuItem = menu.addItem(withTitle: title, action: action, keyEquivalent: "")
+            menuItem.target = self
+            menuItem.representedObject = object
+        }
+        // The shared commands for what the row shows, ahead of the
+        // sidebar's own (rename, pin, move, appearance).
+        func merge(_ other: NSMenu) {
+            for item in other.items {
+                other.removeItem(item)
+                menu.addItem(item)
+            }
+            menu.addItem(.separator())
+        }
+        let window = view.window
+        switch row.kind {
+        case .agent:
+            let name = row.title
+            let agent = agents.first { $0["name"] as? String == name }
+            // The sidebar renames in place, below.
+            let shared = OmniContextMenus.agent(name, enabled: (agent?["enabled"] as? NSNumber)?.boolValue, actions: self,
+                                                window: window, rename: false) { [weak self] in self?.requestSchedulerState() }
+            if let live = recentRuns.first(where: { $0.agent == name && $0.isLive }) {
+                shared.insertItem(OmniMenuItem("Show Terminal", symbol: .terminal) { [weak self] in
+                    _ = self?.paneShowTerminal(forRun: live.id)
+                }, at: 2)
+                shared.insertItem(OmniMenuItem("Stop Run", symbol: .stopCircle) {
+                    OmniSchedulerClient.request(["op": "stop_run", "run_id": live.id]) { _ in }
+                }, at: 3)
+            }
+            merge(shared)
+        case .session:
+            if case .session(let id) = row.route {
+                let session = sessions.first { $0["session_id"] as? String == id } ?? ["session_id": id]
+                merge(OmniContextMenus.session(session, actions: self, window: window, rename: false))
+            }
+        case .run, .recentRun:
+            if case .run(let id) = row.route {
+                let run = recentRuns.first { $0.id == id }
+                merge(OmniContextMenus.run(id, agent: run?.agent, live: row.kind == .run || run?.isLive == true,
+                                           actions: self, window: window) { [weak self] in self?.requestSchedulerState() })
+            }
+        case .terminal:
+            if let tab = row.tab {
+                menu.addAction("Show Terminal", symbol: .terminal) { [weak self] in
+                    if let item = tab.tabViewItem {
+                        self?.selectTab(item)
+                    }
+                }
+                menu.addItem(.separator())
+                menu.addAction("Close Tab", symbol: .xmark) { [weak self] in
+                    _ = self?.terminal?.closeTabIfConfirmed(tab)
+                }
+            }
+        case .project:
+            if case .project(let root) = row.route {
+                menu.addAction("Open", symbol: .arrowRightCircle) { [weak self] in self?.paneOpen(.project(root)) }
+                menu.addItem(.separator())
+            }
+        default:
+            break
+        }
+        switch row.kind {
+        case .session:
+            add("Rename…", #selector(renameSession(_:)), row)
+            if case .session(let id) = row.route {
+                add(Self.pinnedSessions.contains(id) ? "Unpin" : "Pin", #selector(togglePinSession(_:)), id)
+            }
+            if Self.sessionsView == .folders, case .session(let id) = row.route {
+                let move = NSMenuItem(title: "Move to", action: nil, keyEquivalent: "")
+                let submenu = NSMenu()
+                let none = submenu.addItem(withTitle: "No Folder", action: #selector(moveSession(_:)), keyEquivalent: "")
+                none.target = self
+                none.representedObject = [id, ""]
+                none.state = sessionLayout.folders[id] == nil ? .on : .off
+                for path in sessionTree.allPaths {
+                    let entry = submenu.addItem(withTitle: path.components(separatedBy: "/").last ?? path,
+                                                action: #selector(moveSession(_:)), keyEquivalent: "")
+                    entry.target = self
+                    entry.indentationLevel = path.components(separatedBy: "/").count - 1
+                    entry.representedObject = [id, path]
+                    entry.state = sessionLayout.folders[id] == path ? .on : .off
+                }
+                submenu.addItem(.separator())
+                let fresh = submenu.addItem(withTitle: "New Folder", action: #selector(newSessionFolder(_:)), keyEquivalent: "")
+                fresh.target = self
+                fresh.representedObject = ""
+                move.submenu = submenu
+                menu.addItem(move)
+            }
+        case .agent:
+            add("Rename…", #selector(renameItem(_:)), row)
+            add("Icon & Colour…", #selector(editAppearance(_:)), row)
+            let move = NSMenuItem(title: "Move to", action: nil, keyEquivalent: "")
+            let submenu = NSMenu()
+            let ungrouped = submenu.addItem(withTitle: "No Folder", action: #selector(moveAgent(_:)), keyEquivalent: "")
+            ungrouped.target = self
+            ungrouped.representedObject = [row.title, ""]
+            ungrouped.state = row.groupPath.isEmpty ? .on : .off
+            if !groupTree.allPaths.isEmpty {
+                submenu.addItem(.separator())
+            }
+            for path in groupTree.allPaths {
+                let depth = path.components(separatedBy: "/").count - 1
+                let entry = submenu.addItem(withTitle: path.components(separatedBy: "/").last ?? path,
+                                            action: #selector(moveAgent(_:)), keyEquivalent: "")
+                entry.target = self
+                entry.indentationLevel = depth
+                entry.representedObject = [row.title, path]
+                entry.state = row.groupPath == path ? .on : .off
+            }
+            submenu.addItem(.separator())
+            let newGroup = submenu.addItem(withTitle: "New Folder…", action: #selector(moveAgentToNewGroup(_:)), keyEquivalent: "")
+            newGroup.target = self
+            newGroup.representedObject = row.title
+            move.submenu = submenu
+            menu.addItem(move)
+        case .group:
+            add("Rename Folder", #selector(renameItem(_:)), row)
+            add("Icon & Colour…", #selector(editAppearance(_:)), row)
+            if !row.groupPath.contains("/") {
+                add("New Subfolder", #selector(newGroup(_:)), row.groupPath)
+            }
+            menu.addItem(.separator())
+            add("Delete Folder…", #selector(deleteGroup(_:)), row.groupPath)
+        case .section where row === agentsSection:
+            add("New Agent…", #selector(newAgent(_:)), nil)
+            add("New Folder", #selector(newGroup(_:)), nil)
+        case .project:
+            guard let root = Self.projectRoot(row) else { break }
+            add("Rename…", #selector(renameItem(_:)), row)
+            add("Icon & Colour…", #selector(editAppearance(_:)), row)
+            if projectLayout.name(root) != nil {
+                add("Use Folder Name", #selector(resetProjectName(_:)), root)
+            }
+            let move = NSMenuItem(title: "Move to", action: nil, keyEquivalent: "")
+            let submenu = NSMenu()
+            let top = submenu.addItem(withTitle: "No Folder", action: #selector(moveProject(_:)), keyEquivalent: "")
+            top.target = self
+            top.representedObject = [root, ""]
+            top.state = row.groupPath.isEmpty ? .on : .off
+            if !projectTree.allPaths.isEmpty {
+                submenu.addItem(.separator())
+            }
+            for path in projectTree.allPaths {
+                let entry = submenu.addItem(withTitle: path.components(separatedBy: "/").last ?? path,
+                                            action: #selector(moveProject(_:)), keyEquivalent: "")
+                entry.target = self
+                entry.indentationLevel = path.components(separatedBy: "/").count - 1
+                entry.representedObject = [root, path]
+                entry.state = row.groupPath == path ? .on : .off
+            }
+            move.submenu = submenu
+            menu.addItem(move)
+            menu.addItem(.separator())
+            add("Reveal in Finder", #selector(revealProject(_:)), root)
+        case .projectFolder:
+            add("Rename Folder", #selector(renameItem(_:)), row)
+            add("Icon & Colour…", #selector(editAppearance(_:)), row)
+            if !row.groupPath.contains("/") {
+                add("New Subfolder", #selector(newProjectFolder(_:)), row.groupPath)
+            }
+            menu.addItem(.separator())
+            add("Delete Folder", #selector(deleteProjectFolder(_:)), row.groupPath)
+        case .section where row === forgeProjectsSection:
+            add("New Folder", #selector(newProjectFolder(_:)), "")
+        case .sessionFolder:
+            add("Rename Folder", #selector(renameItem(_:)), row)
+            if !row.groupPath.contains("/") {
+                add("New Subfolder", #selector(newSessionFolder(_:)), row.groupPath)
+            }
+            add("Delete Folder", #selector(deleteSessionFolder(_:)), row.groupPath)
+        case .section where row === folderSessionsSection:
+            add("New Folder", #selector(newSessionFolder(_:)), "")
+        case .viewGroup:
+            if row.route != nil {
+                add("Open Project", #selector(openRowRoute(_:)), row)
+            }
+        default:
+            break
+        }
+        menu.tidySeparators()
+    }
+
+    // MARK: - Drag and drop
+
+    // Agents move between rows (order and group) or onto a group or the
+    // Agents header; groups reorder among their siblings, nest one level, or
+    // come back to the top. Anything deeper than two levels is refused.
+    func outlineView(_ outlineView: NSOutlineView, pasteboardWriterForItem item: Any) -> NSPasteboardWriting? {
+        guard let row = item as? OmniSidebarItem, editing == nil else { return nil }
+        let pasteboardItem = NSPasteboardItem()
+        switch row.kind {
+        case .agent:
+            // By project, agents stay where their workspace puts them.
+            guard Self.agentsView == .folders || mode != .agents else { return nil }
+            pasteboardItem.setString(row.title, forType: Self.agentDragType)
+        case .session:
+            guard mode == .sessions, Self.sessionsView == .folders, case .session(let id) = row.route else { return nil }
+            pasteboardItem.setString(id, forType: Self.sessionDragType)
+        case .group:
+            pasteboardItem.setString(row.groupPath, forType: Self.groupDragType)
+        case .terminal:
+            guard let tab = row.tab else { return nil }
+            pasteboardItem.setString(String(tab.uniqueId), forType: Self.terminalDragType)
+        case .project:
+            guard let root = Self.projectRoot(row) else { return nil }
+            pasteboardItem.setString(root, forType: Self.projectDragType)
+        case .projectFolder:
+            pasteboardItem.setString(row.groupPath, forType: Self.projectFolderDragType)
+        default:
+            return nil
+        }
+        return pasteboardItem
+    }
+
+    private enum SidebarDrop {
+        case agent(name: String, group: String, before: String?)
+        case group(path: String, newPath: String?, before: String?)
+    }
+
+    private static func orderKey(_ row: OmniSidebarItem) -> String? {
+        switch row.kind {
+        case .agent: return OmniGroupTree.agentKey(row.title)
+        case .group, .projectFolder: return OmniGroupTree.groupKey(row.groupPath)
+        case .project: return projectRoot(row).map(OmniProjectLayout.key)
+        default: return nil
+        }
+    }
+
+    // The sibling at an insertion index, agent or group alike.
+    private func siblingKey(in container: OmniSidebarItem, at index: Int, excluding key: String) -> String? {
+        guard index >= 0, index < container.children.count else { return nil }
+        return container.children[index...].lazy.compactMap(Self.orderKey).first { $0 != key }
+    }
+
+    private func sidebarDrop(_ info: NSDraggingInfo, item: Any?, index: Int) -> SidebarDrop? {
+        guard let target = item as? OmniSidebarItem else { return nil }
+        let container: OmniSidebarItem
+        let path: String
+        switch target.kind {
+        case .group:
+            container = target
+            path = target.groupPath
+        case .section where target === agentsSection:
+            container = target
+            path = ""
+        default:
+            return nil
+        }
+        let onItem = index == NSOutlineViewDropOnItemIndex
+        if let name = info.draggingPasteboard.string(forType: Self.agentDragType) {
+            let before = onItem ? nil : siblingKey(in: container, at: index, excluding: OmniGroupTree.agentKey(name))
+            return .agent(name: name, group: path, before: before)
+        }
+        guard let moving = info.draggingPasteboard.string(forType: Self.groupDragType) else { return nil }
+        let before = onItem ? nil : siblingKey(in: container, at: index, excluding: OmniGroupTree.groupKey(moving))
+        if OmniGroupTree.parent(of: moving) == path {
+            // Among its siblings: only a reorder, and only between rows.
+            return onItem ? nil : .group(path: moving, newPath: nil, before: before)
+        }
+        guard let newPath = OmniSidebarMoves.regroupedPath(moving, into: path, tree: groupTree) else { return nil }
+        return .group(path: moving, newPath: newPath, before: before)
+    }
+
+    // Terminals reorder within their section by moving their tabs; Runs keep
+    // their time order.
+    private func terminalDrop(_ info: NSDraggingInfo, item: Any?, index: Int) -> (from: Int, to: Int)? {
+        guard let value = info.draggingPasteboard.string(forType: Self.terminalDragType), let moving = Int32(value),
+              (item as? OmniSidebarItem) === terminalsSection, index != NSOutlineViewDropOnItemIndex,
+              let tabs = terminal?.tabs() else { return nil }
+        let rows = terminalsSection.children
+        let before = index < rows.count ? rows[index...].first { $0.tab?.uniqueId != moving }?.tab?.uniqueId : nil
+        let ids = tabs.map(\.uniqueId)
+        guard let from = ids.firstIndex(of: moving),
+              let to = OmniSidebarMoves.tabDestination(tabs: ids, terminals: rows.compactMap { $0.tab?.uniqueId },
+                                                       moving: moving, before: before) else { return nil }
+        return (from, to)
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, validateDrop info: NSDraggingInfo, proposedItem item: Any?,
+                     proposedChildIndex index: Int) -> NSDragOperation {
+        if info.draggingPasteboard.string(forType: Self.terminalDragType) != nil {
+            return terminalDrop(info, item: item, index: index) != nil ? .move : []
+        }
+        if info.draggingPasteboard.string(forType: Self.sessionDragType) != nil {
+            return sessionDropFolder(item) != nil ? .move : []
+        }
+        if info.draggingPasteboard.availableType(from: [Self.projectDragType, Self.projectFolderDragType]) != nil {
+            return projectDrop(info, item: item, index: index) != nil ? .move : []
+        }
+        guard sidebarDrop(info, item: item, index: index) != nil else { return [] }
+        return .move
+    }
+
+    // A session dropped on a folder files it there; on Other, takes it out.
+    private func sessionDropFolder(_ item: Any?) -> String? {
+        guard let target = item as? OmniSidebarItem else { return nil }
+        switch target.kind {
+        case .sessionFolder: return target.groupPath
+        case .section where target === otherSessionsSection: return ""
+        default: return nil
+        }
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, acceptDrop info: NSDraggingInfo, item: Any?, childIndex index: Int) -> Bool {
+        if let id = info.draggingPasteboard.string(forType: Self.sessionDragType) {
+            guard let folder = sessionDropFolder(item) else { return false }
+            fileSession(id, into: folder)
+            return true
+        }
+        if let move = terminalDrop(info, item: item, index: index) {
+            // The tab order is the model; the window's arrangement keeps it.
+            terminal?.moveTab(at: move.from, to: move.to)
+            rebuildAfterDrop()
+            return true
+        }
+        if info.draggingPasteboard.availableType(from: [Self.projectDragType, Self.projectFolderDragType]) != nil {
+            guard let drop = projectDrop(info, item: item, index: index) else { return false }
+            acceptProjectDrop(drop)
+            return true
+        }
+        guard let drop = sidebarDrop(info, item: item, index: index) else { return false }
+        // Applied at once; a refusal puts everything back.
+        let saved = (agents: agents, order: sidebarOrder)
+        let revert: (String, String) -> Void = { [weak self] key, message in
+            guard let self else { return }
+            self.agents = saved.agents
+            self.sidebarOrder = saved.order
+            self.rebuildAfterDrop()
+            if let row = self.itemCache[key] {
+                self.showRenameProblem(message, on: row)
+            }
+        }
+        let keys = groupTree.displayKeys
+        switch drop {
+        case .agent(let name, let group, let before):
+            let order = OmniSidebarMoves.sidebarOrder(keys, moving: OmniGroupTree.agentKey(name), before: before)
+            sidebarOrder = order
+            let current = agents.first { $0["name"] as? String == name }.map { OmniGroupTree.normalizedPath($0["group"] as? String) }
+            if current != group {
+                agents = agents.map { agent in
+                    guard agent["name"] as? String == name else { return agent }
+                    var moved = agent
+                    moved["group"] = group
+                    return moved
+                }
+                setAppearanceChecked(of: name, ["group": group]) { [weak self] problem in
+                    if let problem {
+                        revert("agent|\(name)", problem)
+                    } else {
+                        self?.request(["op": "set_sidebar_order", "items": order], revertKey: "agent|\(name)", revert: revert)
+                    }
+                }
+            } else {
+                request(["op": "set_sidebar_order", "items": order], revertKey: "agent|\(name)", revert: revert)
+            }
+        case .group(let path, let newPath, let before):
+            let key = OmniGroupTree.groupKey(path)
+            guard let newPath else {
+                let order = OmniSidebarMoves.sidebarOrder(keys, moving: key, before: before)
+                sidebarOrder = order
+                request(["op": "set_sidebar_order", "items": order], revertKey: "group|\(path)", revert: revert)
+                break
+            }
+            let newKey = OmniGroupTree.groupKey(newPath)
+            let order = OmniSidebarMoves.sidebarOrder(keys, moving: key, before: before, renamed: (key, newKey))
+            sidebarOrder = order
+            agents = agents.map { agent in
+                guard OmniGroupTree.normalizedPath(agent["group"] as? String) == path else { return agent }
+                var moved = agent
+                moved["group"] = newPath
+                return moved
+            }
+            OmniSchedulerClient.request(["op": "rename_group", "from": path, "to": newPath]) { [weak self] response in
+                guard let self else { return }
+                guard response["ok"] as? Bool == true else {
+                    revert("group|\(path)", Self.problem(response, fallback: "The folder could not be moved."))
+                    return
+                }
+                self.moveAgentFolderAppearance(from: path, to: newPath)
+                self.request(["op": "set_sidebar_order", "items": order], revertKey: "group|\(newPath)", revert: revert)
+            }
+        }
+        rebuildAfterDrop()
+        return true
+    }
+
+    private func request(_ body: [String: Any], revertKey: String, revert: @escaping (String, String) -> Void) {
+        OmniSchedulerClient.request(body) { [weak self] response in
+            guard let self else { return }
+            if response["ok"] as? Bool != true {
+                revert(revertKey, Self.problem(response, fallback: "The sidebar could not be rearranged."))
+            }
+            self.requestSchedulerState()
+        }
+    }
+
+    private func setAppearanceChecked(of name: String, _ changes: [String: String], completion: @escaping (String?) -> Void) {
+        var body: [String: Any] = ["op": "set_agent_appearance", "name": name]
+        for (key, value) in changes {
+            body[key] = value
+        }
+        OmniSchedulerClient.request(body) { response in
+            completion(response["ok"] as? Bool == true ? nil : Self.problem(response, fallback: "The agent could not be moved."))
+        }
+    }
+
+    // The drop lands while the mouse may still read as down; update after it.
+    private func rebuildAfterDrop() {
+        DispatchQueue.main.async { [weak self] in
+            self?.rebuild()
+        }
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, draggingSession session: NSDraggingSession, endedAt screenPoint: NSPoint,
+                     operation: NSDragOperation) {
+        finishInteraction()
+    }
+
+    // MARK: - NSOutlineViewDataSource
+
+    func outlineView(_ outlineView: NSOutlineView, numberOfChildrenOfItem item: Any?) -> Int {
+        guard let item = item as? OmniSidebarItem else { return rootItems.count }
+        return item.children.count
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, child index: Int, ofItem item: Any?) -> Any {
+        guard let item = item as? OmniSidebarItem else { return rootItems[index] }
+        return item.children[index]
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, isItemExpandable item: Any) -> Bool {
+        let kind = (item as? OmniSidebarItem)?.kind
+        return kind == .section || kind == .group || kind == .projectFolder || kind == .viewGroup || kind == .sessionFolder
+            || (kind == .session && !((item as? OmniSidebarItem)?.children.isEmpty ?? true))
+    }
+
+    // MARK: - NSOutlineViewDelegate
+
+    func outlineView(_ outlineView: NSOutlineView, isGroupItem item: Any) -> Bool {
+        return (item as? OmniSidebarItem)?.kind == .section
+    }
+
+    // The Projects list is the last thing in the sidebar: it has no Hide.
+    func outlineView(_ outlineView: NSOutlineView, shouldShowOutlineCellForItem item: Any) -> Bool {
+        return (item as? OmniSidebarItem) !== forgeProjectsSection
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, shouldCollapseItem item: Any) -> Bool {
+        return (item as? OmniSidebarItem) !== forgeProjectsSection
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, shouldSelectItem item: Any) -> Bool {
+        return (item as? OmniSidebarItem)?.isSelectable ?? false
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, typeSelectStringFor tableColumn: NSTableColumn?, item: Any) -> String? {
+        guard let row = item as? OmniSidebarItem, row.isSelectable else { return nil }
+        return row.title
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, heightOfRowByItem item: Any) -> CGFloat {
+        guard let item = item as? OmniSidebarItem else { return 24 }
+        if item.isTopGroup {
+            return OmniTheme.Sidebar.topRowHeight
+        }
+        if item.kind == .divider {
+            return OmniTheme.Sidebar.groupGap + 1
+        }
+        if item.kind == .modeSwitch {
+            return Self.modeSwitchRowHeight
+        }
+        return item.kind == .section ? 26 : (item.detail.isEmpty ? 28 : 38)
+    }
+
+    // Every row a person can select shows the pointer over it.
+    func outlineView(_ outlineView: NSOutlineView, rowViewForItem item: Any) -> NSTableRowView? {
+        guard let item = item as? OmniSidebarItem, item.isSelectable else { return nil }
+        let rowView = OmniSidebarRowView()
+        rowView.accent = item.accent
+        if item.isTopGroup {
+            rowView.panelEdge = item === overviewItem ? .top : (item === settingsItem ? .bottom : .middle)
+        }
+        return rowView
+    }
+
+    func outlineView(_ outlineView: NSOutlineView, viewFor tableColumn: NSTableColumn?, item: Any) -> NSView? {
+        let cell = sidebarCell(for: item)
+        // Buttons inside cells (the mode switch, disclosure) get the pointing hand.
+        if let cell {
+            OmniPointer.install(in: cell)
+        }
+        return cell
+    }
+
+    private func sidebarCell(for item: Any) -> NSView? {
+        guard let item = item as? OmniSidebarItem else { return nil }
+        if item.kind == .divider {
+            return OmniSidebarDividerCell()
+        }
+        if item.kind == .modeSwitch {
+            let cell = OmniSidebarModeSwitchCell()
+            cell.host(modeControl)
+            return cell
+        }
+        if item.kind == .section {
+            let cell = OmniSidebarSectionCell()
+            let accessory: NSView? = item === terminalsSection ? newTerminalButton
+                : item === agentsSection ? agentsHeaderAccessory
+                : item === runsSection ? runsHeaderAccessory
+                : item === sessionsViewSection ? sessionsHeaderAccessory
+                : item === forgeProjectsSection ? projectsHeaderAccessory : nil
+            cell.configure(title: item.title, accessory: accessory, icon: item.icon,
+                           iconColor: OmniAgentColor.color(item.iconColor))
+            cell.toolTip = item === agentsSection ? "Keyboard\n" + OmniSidebarShortcuts.tooltip : nil
+            return cell
+        }
+        let identifier = NSUserInterfaceItemIdentifier("OmniSidebarCell")
+        let cell = outlineView.makeView(withIdentifier: identifier, owner: self) as? OmniSidebarCell ?? OmniSidebarCell()
+        cell.identifier = identifier
+        switch item.kind {
+        case .agent, .run, .recentRun:
+            let icon = item.icon ?? .symbol(OmniAgentIcon.defaultSymbol)
+            cell.configure(title: item.title, detail: item.detail, icon: icon,
+                           iconColor: OmniAgentColor.color(item.iconColor), status: item.color, pulses: item.pulses)
+        case .project:
+            cell.configure(title: item.title, detail: item.detail, icon: item.icon ?? .symbol(SFSymbol.shippingbox.rawValue),
+                           iconColor: OmniAgentColor.color(item.iconColor), status: nil, pulses: false)
+        case .memoryResult:
+            cell.configure(title: item.title, detail: item.detail, icon: .symbol(SFSymbol.brain.rawValue),
+                           iconColor: nil, status: nil, pulses: false)
+        case .searchAll:
+            cell.configure(title: item.title, detail: "", icon: .symbol(SFSymbol.magnifyingglass.rawValue),
+                           iconColor: .linkColor, status: nil, pulses: false)
+        case .viewGroup, .sessionFolder:
+            let open = outlineView.isItemExpanded(item)
+            cell.configure(title: item.title, detail: item.detail,
+                           icon: item.icon ?? .symbol(open ? SFSymbol.folder.rawValue : SFSymbol.folderFill.rawValue),
+                           iconColor: OmniAgentColor.color(item.iconColor), status: nil, pulses: false)
+        case .group, .projectFolder:
+            let open = outlineView.isItemExpanded(item)
+            cell.configure(title: item.title, detail: "",
+                           icon: item.icon ?? .symbol(open ? SFSymbol.folder.rawValue : SFSymbol.folderFill.rawValue),
+                           iconColor: OmniAgentColor.color(item.iconColor), status: nil, pulses: false)
+        default:
+            cell.configure(title: item.title, detail: item.detail, color: item.color, pulses: item.pulses)
+        }
+        if item.kind == .session {
+            cell.configure(title: item.title, detail: item.detail,
+                           icon: item.icon ?? .symbol(OmniSessionText.providerSymbol(nil)), iconColor: nil,
+                           status: item.color, pulses: item.pulses)
+            // A row kept across a reload still shows a changed project colour.
+            let index = outlineView.row(forItem: item)
+            if index >= 0, let rowView = outlineView.rowView(atRow: index, makeIfNecessary: false) as? OmniSidebarRowView,
+               rowView.accent != item.accent {
+                rowView.accent = item.accent
+                rowView.needsDisplay = true
+            }
+        }
+        if item.kind == .inbox {
+            let symbol: SFSymbol = item.count.isEmpty ? .tray : .trayFull
+            cell.configure(title: item.title, detail: "", icon: .symbol(symbol.rawValue), iconColor: nil,
+                           status: nil, pulses: false)
+        } else if item.kind == .memory {
+            cell.configure(title: item.title, detail: "", icon: .symbol(SFSymbol.brain.rawValue), iconColor: nil,
+                           status: nil, pulses: false)
+        } else if item.kind == .settings {
+            cell.configure(title: item.title, detail: "", icon: .symbol(SFSymbol.gearshape.rawValue), iconColor: nil,
+                           status: nil, pulses: false)
+        } else if item.kind == .projects {
+            cell.configure(title: item.title, detail: "", icon: .symbol(SFSymbol.shippingbox.rawValue), iconColor: nil,
+                           status: nil, pulses: false)
+        } else if item.kind == .unblocker {
+            cell.configure(title: item.title, detail: "", icon: .symbol(SFSymbol.forwardCircle.rawValue), iconColor: nil,
+                           status: nil, pulses: false)
+        } else if item.kind == .overview {
+            cell.configure(title: item.title, detail: "", icon: .symbol(SFSymbol.squareGrid2x2.rawValue), iconColor: nil,
+                           status: nil, pulses: false)
+        }
+        cell.isTopRow = item.isTopGroup
+        cell.setCount(item.count, needsAttention: item.countNeedsAttention)
+        cell.setAccessibilityLabel(item.count.isEmpty ? item.title : "\(item.title), \(item.count) unread")
+        return cell
+    }
+
+    func outlineViewSelectionDidChange(_ notification: Notification) {
+        guard !syncingSelection else { return }
+        let keepFocus = sidebarHasFocus
+        let item = outlineView.item(atRow: outlineView.selectedRow) as? OmniSidebarItem
+        if item?.kind == .loadMore {
+            loadMoreSessions()
+            syncSelection()
+            return
+        }
+        if item?.kind == .projectFolder {
+            projectFolderSelectedOver = .some(contentHost.route)
+        }
+        if let route = item?.route {
+            showPane(route)
+            // A transcript match opens its session at the matching message.
+            if case .session = route, let message = item?.matchMessageID {
+                (contentHost.pane as? OmniSessionPane)?.focus(onMessage: message)
+            }
+            // A memory result opens that memory in Browse.
+            if let memoryID = item?.memoryID, let pane = contentHost.pane as? OmniMemoryPane {
+                pane.memory.show(named: OmniMemoryTab.browse.title, mindMap: false)
+                pane.memory.selectMemory(memoryID)
+            }
+        } else if let tab = item?.tab {
+            show(tab)
+        }
+        syncSelection()
+        // Selecting a tab focuses its session; the keyboard stays here.
+        if keepFocus, !sidebarHasFocus {
+            focusSidebar()
+        }
+    }
+
+    // MARK: - Keyboard
+
+    private var sidebarHasFocus: Bool {
+        return view.window?.firstResponder === outlineView
+    }
+
+    private var selectedItem: OmniSidebarItem? {
+        return outlineView.item(atRow: outlineView.selectedRow) as? OmniSidebarItem
+    }
