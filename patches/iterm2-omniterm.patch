+    private func setUpGraph() {
+        graphModeControl.selectedSegment = 0
+        graphModeControl.target = self
+        graphModeControl.action = #selector(graphOptionsChanged(_:))
+        for (kind, title) in [("session", "Sessions"), ("tag", "Tags"), ("lineage", "Lineage"),
+                              ("similarity", "Similar"), ("workspace", "Workspaces"), ("concept", "Concepts")] {
+            let button = NSButton(checkboxWithTitle: title, target: self, action: #selector(graphOptionsChanged(_:)))
+            // Workspace and concept hubs group memories by project and by the
+            // files, commands and errors they name, so they are on by default.
+            button.state = .on
+            button.contentTintColor = OmniTheme.memoryEdgeColor(kind)
+            edgeToggles.append((kind, button))
+            graphView.addSubview(button)
+        }
+        // Typing highlights; return focuses the best match.
+        graphSearch.placeholderString = "Highlight, return to focus"
+        graphSearch.target = self
+        graphSearch.action = #selector(graphHighlight(_:))
+        fitButton.target = self
+        fitButton.action = #selector(fitGraph(_:))
+        canvas.selectionDidChange = { [weak self] id in self?.graphSelectionChanged(id) }
+        canvas.openNode = { [weak self] id in self?.openFromGraph(id) }
+        canvas.expandNode = { [weak self] id in
+            self?.expandGraph(id, force: NSEvent.modifierFlags.contains(.option)) ?? false
+        }
+        canvas.toggleNode = { [weak self] id in self?.toggleMindMapBranch(id) }
+        canvas.contextMenu = { [weak self] node in
+            guard let self else { return nil }
+            let menu = NSMenu()
+            if let node {
+                menu.addAction("Open", symbol: .arrowRightCircle) { [weak self] in self?.openFromGraph(node.id) }
+                menu.addAction("Expand Neighbours", symbol: .plusCircle) { [weak self] in
+                    _ = self?.expandGraph(node.id, force: false)
+                }
+                if node.childrenCount > 0 {
+                    menu.addAction(node.collapsed ? "Expand Branch" : "Collapse Branch", symbol: .chevronDown) { [weak self] in
+                        self?.toggleMindMapBranch(node.id)
+                    }
+                }
+                menu.addAction("Center on It", symbol: .scope) { [weak self] in self?.canvas.center(on: node.id) }
+                menu.addItem(.separator())
+                menu.addAction("Copy Label", symbol: .docOnDoc) { OmniContextMenus.copy(node.label) }
+                menu.addItem(.separator())
+            }
+            menu.addAction("Fit to View", symbol: .arrowUpLeftAndArrowDownRight) { [weak self] in self?.fitGraph(nil) }
+            menu.addAction("Overview", symbol: .squareGrid2x2) { [weak self] in self?.graphOverview(nil) }
+            return menu
+        }
+        canvas.keyHandler = { [weak self] event in
+            guard let self else { return false }
+            // Option-Return expands the selected node's neighbourhood.
+            if event.keyCode == 36 || event.keyCode == 76, event.modifierFlags.contains(.option),
+               let id = self.canvas.selectedID {
+                return self.expandGraph(id, force: true)
+            }
+            return self.graphZone.zoneHandleKey(event)
+        }
+        graphStatus.font = OmniTheme.Font.meta
+        graphStatus.textColor = OmniTheme.secondaryText
+        graphStatus.lineBreakMode = .byTruncatingTail
+        graphTypePopUp.addItems(withTitles: ["All types"] + Self.types)
+        graphWorkspacePopUp.addItem(withTitle: "All workspaces")
+        graphTimePopUp.addItems(withTitles: Self.graphTimeRanges.map { $0.title })
+        graphWeightPopUp.addItems(withTitles: Self.graphMinimumWeights.map { $0.title })
+        for popUp in [graphTypePopUp, graphWorkspacePopUp, graphTimePopUp, graphWeightPopUp] {
+            popUp.controlSize = .small
+            popUp.font = NSFont.systemFont(ofSize: NSFont.smallSystemFontSize)
+            popUp.target = self
+            popUp.action = #selector(graphOptionsChanged(_:))
+        }
+        graphBackButton.target = self
+        graphBackButton.action = #selector(graphBack(_:))
+        graphOverviewButton.target = self
+        graphOverviewButton.action = #selector(graphOverview(_:))
+        graphTrail.font = OmniTheme.Font.meta
+        graphTrail.textColor = OmniTheme.secondaryText
+        graphTrail.lineBreakMode = .byTruncatingMiddle
+        for view in [graphModeControl, graphSearch, fitButton, graphTypePopUp, graphWorkspacePopUp, graphTimePopUp,
+                     graphWeightPopUp, canvas, graphBackButton, graphOverviewButton, graphTrail, graphStatus] as [NSView] {
+            graphView.addSubview(view)
+        }
+        updateGraphBreadcrumb()
+    }
