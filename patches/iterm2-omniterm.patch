+    // MARK: - Tabs
+
+    @objc private func tabChanged(_ sender: NSSegmentedControl) {
+        showTab(OmniMemoryTab(rawValue: sender.selectedSegment) ?? .browse)
+    }
+
+    func showTab(_ tab: OmniMemoryTab) {
+        self.tab = tab
+        tabControl.selectedSegment = tab.rawValue
+        browseView.isHidden = tab != .browse
+        searchView.isHidden = tab != .search
+        processView.isHidden = tab != .process
+        digestView.isHidden = tab != .digest
+        graphView.isHidden = tab != .graph
+        ingestView.isHidden = tab != .ingest
+        layout(root.bounds.size)
+        loadTab()
+    }
+
+    // A tab by its lowercased title, as a link names it; unknown names keep
+    // the current tab.
+    func show(named name: String?, mindMap: Bool, query: String? = nil, node: String? = nil, openNode: Bool = false) {
+        graphModeControl.selectedSegment = mindMap ? 1 : 0
+        let tab = OmniMemoryTab.allCases.first { $0.title.lowercased() == name?.lowercased() } ?? self.tab
+        if tab == .graph, let node, !node.isEmpty {
+            pendingNode = (node, openNode)
+        }
+        showTab(tab)
+        if let query, !query.isEmpty, tab == .search {
+            searchField.stringValue = query
+            runSearch(nil)
+        }
+        applyPendingNode()
+    }
