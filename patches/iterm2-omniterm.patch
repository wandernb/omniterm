+- (void)testKnowledgeUnchangedRecordIsNotRewritten {
+    OmniKnowledgeTestScheduler *scheduler = [self knowledgeScheduler];
+    NSDictionary *write = @{ @"key": @"memory:same", @"value": @{ @"body": @"Same" } };
+    XCTAssertTrue(([scheduler commitKnowledgeResponse:@{ @"_writes": @[ write ] }]));
+    XCTAssertEqualObjects([scheduler valueForKey:@"knowledgeSkippedWrites"], @0);
+    XCTAssertTrue(([scheduler commitKnowledgeResponse:@{ @"_writes": @[ write ] }]));
+    XCTAssertEqualObjects([scheduler valueForKey:@"knowledgeSkippedWrites"], @1);
+    XCTAssertTrue(([scheduler commitKnowledgeResponse:@{ @"_writes": @[ @{ @"key": @"memory:same", @"value": @{ @"body": @"Changed" } } ] }]));
+    XCTAssertEqualObjects([self savedKnowledgeRecord:@"memory:same"], (@{ @"body": @"Changed" }));
+    XCTAssertTrue(([scheduler commitKnowledgeResponse:@{ @"_writes": @[ @{ @"key": @"memory:same", @"value": NSNull.null } ] }]));
+    XCTAssertNil([self savedKnowledgeRecord:@"memory:same"]);
+    XCTAssertEqualObjects([scheduler valueForKey:@"knowledgeSkippedWrites"], @1);
+    [scheduler stop];
+}
