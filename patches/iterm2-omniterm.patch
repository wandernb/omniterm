+- (NSString *)runGit:(NSArray *)arguments inDirectory:(NSString *)directory {
+    NSTask *task = [[NSTask alloc] init];
+    task.executableURL = [NSURL fileURLWithPath:@"/usr/bin/env"];
+    task.arguments = [@[ @"git", @"-C", directory, @"-c", @"user.name=Test", @"-c", @"user.email=t@example.com",
+                          @"-c", @"commit.gpgsign=false" ] arrayByAddingObjectsFromArray:arguments];
+    NSPipe *pipe = [NSPipe pipe];
+    task.standardOutput = pipe;
+    task.standardError = [NSFileHandle fileHandleWithNullDevice];
+    [task launch];
+    NSData *data = [pipe.fileHandleForReading readDataToEndOfFile];
+    [task waitUntilExit];
+    return [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
+}
