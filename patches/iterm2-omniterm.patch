+import AppKit
+import Foundation
+
+// One icon the picker offers: an SF Symbol name with its category and the
+// words a search also matches.
+struct OmniAppearanceIcon: Equatable {
+    let name: String
+    let category: String
+    let keywords: [String]
+}
+
+// The icons and colours an agent may use, from the bundled helper's
+// allow-list (`omni agents appearance --json`), loaded once.
+enum OmniAppearanceCatalog {
+    private(set) static var icons: [OmniAppearanceIcon] = []
+    private(set) static var colors: [String] = OmniAgentColor.names
+    private static var loaded = false
+    private static var waiting: [() -> Void] = []
+
+    // Unit tests supply the allow-list instead of running the helper.
+    static func setForTesting(icons: [String], colors: [String]) {
+        setForTesting(entries: icons.map { OmniAppearanceIcon(name: $0, category: "", keywords: []) }, colors: colors)
+    }
+
+    static func setForTesting(entries: [OmniAppearanceIcon], colors: [String]) {
+        self.icons = entries
+        self.colors = colors
+        loaded = true
+    }
+
+    // Entries are symbol names, or objects with a name, category and keywords.
+    static func icons(from response: [AnyHashable: Any]) -> [OmniAppearanceIcon] {
+        return (response["icons"] as? [Any] ?? []).compactMap { entry -> OmniAppearanceIcon? in
+            let object = entry as? [AnyHashable: Any]
+            guard var name = (entry as? String) ?? (object?["name"] as? String) else { return nil }
+            if name.hasPrefix("sf:") {
+                name = String(name.dropFirst(3))
+            }
+            guard NSImage(systemSymbolName: name, accessibilityDescription: nil) != nil else { return nil }
+            return OmniAppearanceIcon(name: name, category: object?["category"] as? String ?? "",
+                                      keywords: object?["keywords"] as? [String] ?? [])
+        }
+    }
+
+    static func load(_ completion: @escaping () -> Void) {
+        if loaded {
+            completion()
+            return
+        }
+        waiting.append(completion)
+        guard waiting.count == 1 else { return }
+        OmniHelper.run(["agents", "appearance", "--json"]) { response in
+            icons = Self.icons(from: response)
+            let names = (response["colors"] as? [Any] ?? []).compactMap { entry in
+                (entry as? String) ?? ((entry as? [AnyHashable: Any])?["name"] as? String)
+            }.filter { OmniAgentColor.color($0) != nil }
+            if !names.isEmpty {
+                colors = names
+            }
+            // A failed load is retried next time the picker opens.
+            loaded = OmniPane.isOK(response) || !icons.isEmpty
+            let callbacks = waiting
+            waiting = []
+            callbacks.forEach { $0() }
+        }
+    }
+}
