+//
+//  OmniTerminalSnapshotTests.swift
+//  ModernTests
+//
+//  A saved run screen is untrusted: only SGR styling survives rendering.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniTerminalSnapshotTests: XCTestCase {
+    private let font = NSFont.monospacedSystemFont(ofSize: 12, weight: .regular)
+
+    private func color(_ string: NSAttributedString, at index: Int, _ key: NSAttributedString.Key = .foregroundColor) -> NSColor? {
+        return string.attribute(key, at: index, effectiveRange: nil) as? NSColor
+    }
+
+    func testSGRColoursAreRenderedAndReset() {
+        let rendered = OmniTerminalSnapshotView.render("\u{1b}[31mred\u{1b}[0m plain", font: font)
+        XCTAssertEqual(rendered.string, "red plain")
+        XCTAssertEqual(color(rendered, at: 0), OmniTerminalSnapshotView.paletteColor(1))
+        XCTAssertEqual(color(rendered, at: 4), OmniTerminalSnapshotView.defaultForeground)
+    }
+
+    func testExtendedColoursInBothForms() {
+        let rendered = OmniTerminalSnapshotView.render("\u{1b}[38;5;196ma\u{1b}[48;2;1;2;3mb\u{1b}[38:2::10:20:30mc", font: font)
+        XCTAssertEqual(rendered.string, "abc")
+        XCTAssertEqual(color(rendered, at: 0), OmniTerminalSnapshotView.paletteColor(196))
+        XCTAssertEqual(color(rendered, at: 1, .backgroundColor),
+                       NSColor(srgbRed: 1 / 255, green: 2 / 255, blue: 3 / 255, alpha: 1))
+        XCTAssertEqual(color(rendered, at: 2),
+                       NSColor(srgbRed: 10 / 255, green: 20 / 255, blue: 30 / 255, alpha: 1))
+    }
+
+    func testEveryOtherSequenceAndControlCharacterIsDropped() {
+        let hostile = "a\u{1b}]8;;https://example.com\u{7}link\u{1b}]8;;\u{1b}\\" +
+            "\u{1b}[2J\u{1b}[?1049h\u{1b}P1;2q\u{1b}\\\u{1b}(B\u{7}\u{8}\r\u{9b}b\n\tc"
+        let rendered = OmniTerminalSnapshotView.render(hostile, font: font)
+        XCTAssertEqual(rendered.string, "alinkb\n\tc")
+        XCTAssertNil(rendered.attribute(.link, at: 1, effectiveRange: nil))
+    }
+
+    func testLongLinesWrapAndTheViewOpensAtTheBottomLeft() {
+        let view = OmniTerminalSnapshotView(frame: NSRect(x: 0, y: 0, width: 300, height: 200))
+        let line = String(repeating: "wide-line ", count: 40)
+        view.show(screen: (0..<60).map { "\($0) \(line)" }.joined(separator: "\n"))
+
+        guard let document = view.documentView else {
+            return XCTFail("No document view")
+        }
+        XCTAssertLessThanOrEqual(document.frame.width, view.contentSize.width + 0.5, "Nothing extends sideways")
+        XCTAssertFalse(view.hasHorizontalScroller)
+        let visible = view.documentVisibleRect
+        XCTAssertEqual(visible.minX, 0)
+        XCTAssertEqual(visible.maxY, document.frame.height, accuracy: 1, "Opens at the end of the screen")
+    }
+
+    func testShowingTheSameScreenAgainKeepsTheScrollPosition() {
+        let view = OmniTerminalSnapshotView(frame: NSRect(x: 0, y: 0, width: 300, height: 200))
+        let screen = (0..<200).map { "line \($0)" }.joined(separator: "\n")
+        view.show(screen: screen)
+        view.contentView.scroll(to: .zero)
+        view.reflectScrolledClipView(view.contentView)
+        view.show(screen: screen)
+        XCTAssertEqual(view.documentVisibleRect.minY, 0)
+    }
+
+    func testAnUnfinishedSequenceAtTheEndDoesNotCrash() {
+        XCTAssertEqual(OmniTerminalSnapshotView.render("ok\u{1b}[38;5", font: font).string, "ok")
+        XCTAssertEqual(OmniTerminalSnapshotView.render("ok\u{1b}", font: font).string, "ok")
+    }
+}
