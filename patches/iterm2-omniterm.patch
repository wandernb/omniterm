+// A batch that cannot be saved is never acknowledged: the worker keeps it and
+// the next tick saves it. Nothing new is produced meanwhile.
+- (void)testKnowledgeTickFailedCommitKeepsWritesPendingAndRetries {
+    OmniKnowledgeTestScheduler *scheduler = [self knowledgeScheduler];
+    [scheduler setValue:@YES forKey:@"knowledgeEnabled"];
+    __block BOOL broken = YES;
+    NSMutableArray *operations = [NSMutableArray array];
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        [operations addObject:request[@"op"]];
+        if ([request[@"op"] isEqual:@"ack_writes"]) return @{ @"ok": @YES };
+        if (!broken && [operations containsObject:@"saved"]) return @{ @"ok": @YES };
+        // An unknown namespace makes the whole batch fail to save.
+        NSString *key = broken ? @"settings:unexpected" : @"memory:retried";
+        if (!broken) [operations addObject:@"saved"];
+        return @{ @"ok": @YES, @"_writes": @[ @{ @"key": key, @"value": @{ @"body": @"R" } } ], @"_revision": @1, @"_more_writes": @NO };
+    };
+    [scheduler tickKnowledge];
+    XCTAssertFalse([operations containsObject:@"ack_writes"], @"a failed save is never acknowledged");
+    XCTAssertNil([self savedKnowledgeRecord:@"memory:retried"]);
+    broken = NO;
+    [operations removeAllObjects];
+    [scheduler tickKnowledge];
+    XCTAssertTrue([operations containsObject:@"ack_writes"]);
+    XCTAssertNotNil([self savedKnowledgeRecord:@"memory:retried"]);
+    scheduler.workerRequest = nil;
+    [scheduler stop];
+}
