+    // Control-Command-1 to 4 and the page's toggles. False when the panel
+    // is not on screen, so the key goes on.
+    @discardableResult
+    func togglePanel(_ panel: OmniPanel) -> Bool {
+        let card = contentHost.card
+        switch panel {
+        case .sidebar:
+            break
+        case .runs:
+            guard let card, case .agent = card.route else { return false }
+        case .band:
+            guard card != nil else { return false }
+        case .diff:
+            guard let card, card.showsDiff || panelLayout.layout.diffCollapsed else { return false }
+        }
+        panelLayout.update { $0.toggle(panel) }
+        return true
+    }
