+// The window server's Spaces, through SkyLight. There is no public API for a
+// window's Space; each call is skipped when its symbol is missing.
+enum OmniWindowSpaces {
+    private typealias MainConnection = @convention(c) () -> Int32
+    private typealias CopySpacesForWindows = @convention(c) (Int32, Int32, CFArray) -> Unmanaged<CFArray>?
+    private typealias CopyManagedDisplaySpaces = @convention(c) (Int32) -> Unmanaged<CFArray>?
+    private typealias MoveWindowsToManagedSpace = @convention(c) (Int32, CFArray, UInt64) -> Void
+
+    private static let skyLight = dlopen("/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight", RTLD_LAZY)
+
+    private static func symbol<T>(_ name: String, as type: T.Type) -> T? {
+        guard let skyLight, let pointer = dlsym(skyLight, name) else { return nil }
+        return unsafeBitCast(pointer, to: type)
+    }
+
+    private static var connection: Int32? {
+        return symbol("SLSMainConnectionID", as: MainConnection.self)?()
+    }
+
+    // The window's Space, nil when it is on none (never shown since launch).
+    static func space(of window: NSWindow) -> UInt64? {
+        guard window.windowNumber > 0, let connection,
+              let copy = symbol("SLSCopySpacesForWindows", as: CopySpacesForWindows.self),
+              let spaces = copy(connection, 7, [NSNumber(value: window.windowNumber)] as CFArray)?
+                .takeRetainedValue() as? [NSNumber] else { return nil }
+        return spaces.first.map { $0.uint64Value }
+    }
+
+    // Every desktop Space on every display (full-screen Spaces left out).
+    static func userSpaces() -> Set<UInt64> {
+        guard let connection, let copy = symbol("SLSCopyManagedDisplaySpaces", as: CopyManagedDisplaySpaces.self),
+              let displays = copy(connection)?.takeRetainedValue() as? [[String: Any]] else { return [] }
+        var result = Set<UInt64>()
+        for display in displays {
+            for space in display["Spaces"] as? [[String: Any]] ?? [] where (space["type"] as? Int) == 0 {
+                if let id = (space["ManagedSpaceID"] as? NSNumber)?.uint64Value {
+                    result.insert(id)
+                }
+            }
+        }
+        return result
+    }
+
+    static func activeSpace() -> UInt64? {
+        typealias ActiveSpace = @convention(c) (Int32) -> UInt64
+        guard let connection, let active = symbol("SLSGetActiveSpace", as: ActiveSpace.self) else { return nil }
+        return active(connection)
+    }
+
+    static func move(_ window: NSWindow, to space: UInt64) {
+        guard window.windowNumber > 0, let connection,
+              let move = symbol("SLSMoveWindowsToManagedSpace", as: MoveWindowsToManagedSpace.self) else { return }
+        move(connection, [NSNumber(value: window.windowNumber)] as CFArray, space)
+    }
+}
