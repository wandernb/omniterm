+- (void)dealloc {
+    [self stop];
+    dispatch_release(_queue);
+    dispatch_release(_captureQueue);
+    dispatch_release(_knowledgeQueue);
+    [_launchHandler release];
+    [_supportPath release];
+    [_socketPath release];
+    [_instanceID release];
+    [_configPath release];
+    [_agentsPath release];
+    [_settingsPath release];
+    [_agentFilesFingerprint release];
+    [_notificationsChangedHandler release];
+    [_settingsChangedHandler release];
+    [_showInboxHandler release];
+    [_runScreenRequestHandler release];
+    [_runInputHandler release];
+    [super dealloc];
+}
