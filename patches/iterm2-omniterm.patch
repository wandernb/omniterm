+// An edit to make for a keystroke: replace `range` of the old text with
+// `replacement`, then select `selection` in the new text.
+struct OmniMarkdownEdit: Equatable {
+    let range: NSRange
+    let replacement: String
+    let selection: NSRange
+}
+
+// What Return, Tab and the formatting shortcuts do, without a view.
+enum OmniMarkdownEditing {
+    static let indentUnit = "    "
+
+    struct ListItem {
+        let indent: NSRange
+        // The bullet or number, its space, and a task box if there is one.
+        let marker: NSRange
+        let bullet: String
+        let number: Int?
+        let delimiter: String
+        let task: Bool
+    }
+
+    private static let listPattern: NSRegularExpression = {
+        do {
+            return try NSRegularExpression(pattern: "^([ \\t]*)(?:([-*+])|([0-9]{1,9})([.)]))( +\\[[ xX]\\])? ",
+                                           options: [])
+        } catch {
+            it_fatalError("Bad list pattern: \(error)")
+        }
+    }()
+
+    static func listItem(_ string: NSString, line: NSRange) -> ListItem? {
+        guard let match = listPattern.firstMatch(in: string as String, options: [.anchored], range: line) else {
+            return nil
+        }
+        let bulletRange = match.range(at: 2)
+        let numberRange = match.range(at: 3)
+        let markerStart = match.range(at: 1).location + match.range(at: 1).length
+        return ListItem(indent: match.range(at: 1),
+                        marker: NSRange(location: markerStart, length: NSMaxRange(match.range) - markerStart),
+                        bullet: bulletRange.location == NSNotFound ? "" : string.substring(with: bulletRange),
+                        number: numberRange.location == NSNotFound ? nil : Int(string.substring(with: numberRange)),
+                        delimiter: match.range(at: 4).location == NSNotFound ? "" : string.substring(with: match.range(at: 4)),
+                        task: match.range(at: 5).location != NSNotFound)
+    }
+
+    // The line holding `location`, without its line break.
+    private static func line(_ string: NSString, at location: Int) -> NSRange {
+        var start = 0
+        var end = 0
+        var contentsEnd = 0
+        string.getLineStart(&start, end: &end, contentsEnd: &contentsEnd, for: NSRange(location: location, length: 0))
+        return NSRange(location: start, length: contentsEnd - start)
+    }
+
+    private static func isInsideFence(_ text: String, at location: Int) -> Bool {
+        return OmniMarkdownStyler.spans(text).contains {
+            $0.style == .codeBlock && $0.range.location < location && location <= NSMaxRange($0.range)
+        }
+    }
+
+    // Return in a list item: continue the list, or end it on an empty item.
+    // nil means an ordinary line break.
+    static func newline(in text: String, selection: NSRange) -> OmniMarkdownEdit? {
+        guard selection.length == 0 else { return nil }
+        let string = text as NSString
+        let lineRange = line(string, at: selection.location)
+        guard let item = listItem(string, line: lineRange), selection.location >= NSMaxRange(item.marker),
+              !isInsideFence(text, at: selection.location) else {
+            return nil
+        }
+        let content = string.substring(with: NSRange(location: NSMaxRange(item.marker),
+                                                     length: NSMaxRange(lineRange) - NSMaxRange(item.marker)))
+        if content.trimmingCharacters(in: .whitespaces).isEmpty {
+            return OmniMarkdownEdit(range: lineRange, replacement: "",
+                                    selection: NSRange(location: lineRange.location, length: 0))
+        }
+        let marker = item.number.map { "\($0 + 1)\(item.delimiter)" } ?? item.bullet
+        let insertion = "\n" + string.substring(with: item.indent) + marker + (item.task ? " [ ]" : "") + " "
+        return OmniMarkdownEdit(range: selection, replacement: insertion,
+                                selection: NSRange(location: selection.location + (insertion as NSString).length, length: 0))
+    }
+
+    // Tab and Shift-Tab on list items. nil means the selection has no list
+    // item, so Tab does what it always does.
+    static func indent(in text: String, selection: NSRange, outdent: Bool) -> OmniMarkdownEdit? {
+        let string = text as NSString
+        let first = line(string, at: selection.location)
+        let lastLocation = selection.length > 0 ? NSMaxRange(selection) - 1 : selection.location
+        let last = line(string, at: max(selection.location, lastLocation))
+        let block = NSRange(location: first.location, length: NSMaxRange(last) - first.location)
+        var lines: [NSRange] = []
+        string.enumerateSubstrings(in: block, options: [.byLines, .substringNotRequired]) { _, range, _, _ in
+            lines.append(range)
+        }
+        if lines.isEmpty {
+            lines = [block]
+        }
+        guard lines.contains(where: { listItem(string, line: $0) != nil }) else { return nil }
+        // Each list line's start and how many characters it gains or loses.
+        var changes: [(start: Int, delta: Int)] = []
+        for range in lines where listItem(string, line: range) != nil {
+            if !outdent {
+                changes.append((range.location, (indentUnit as NSString).length))
+                continue
+            }
+            var removed = 0
+            if range.length > 0, string.character(at: range.location) == 0x09 {
+                removed = 1
+            } else {
+                while removed < (indentUnit as NSString).length, removed < range.length,
+                      string.character(at: range.location + removed) == 0x20 {
+                    removed += 1
+                }
+            }
+            if removed > 0 {
+                changes.append((range.location, -removed))
+            }
+        }
+        let result = NSMutableString(string: string.substring(with: block))
+        for change in changes.reversed() {
+            let offset = change.start - block.location
+            if change.delta > 0 {
+                result.insert(indentUnit, at: offset)
+            } else {
+                result.deleteCharacters(in: NSRange(location: offset, length: -change.delta))
+            }
+        }
+        func moved(_ position: Int) -> Int {
+            var shifted = position
+            for change in changes where change.start <= position {
+                shifted += change.delta > 0 ? change.delta : -min(-change.delta, position - change.start)
+            }
+            return shifted
+        }
+        let start = moved(selection.location)
+        let end = moved(NSMaxRange(selection))
+        return OmniMarkdownEdit(range: block, replacement: result as String,
+                                selection: NSRange(location: start, length: max(0, end - start)))
+    }
+
+    // ⌘B with "**" and ⌘I with "*": wraps the selection, or unwraps it when
+    // it is already wrapped. An empty selection gets an empty pair.
+    static func toggle(_ marker: String, in text: String, selection: NSRange) -> OmniMarkdownEdit {
+        let string = text as NSString
+        let width = (marker as NSString).length
+        let character = (marker as NSString).character(at: 0)
+        let selected = string.substring(with: selection)
+        func wrapped(_ count: Int) -> Bool {
+            return width == 2 ? count == 2 || count == 3 : count % 2 == 1
+        }
+        func runBefore(_ location: Int) -> Int {
+            var count = 0
+            while location - count > 0, string.character(at: location - count - 1) == character {
+                count += 1
+            }
+            return count
+        }
+        func runAfter(_ location: Int) -> Int {
+            var count = 0
+            while location + count < string.length, string.character(at: location + count) == character {
+                count += 1
+            }
+            return count
+        }
+        if selection.length > 0, wrapped(runBefore(selection.location)), wrapped(runAfter(NSMaxRange(selection))) {
+            return OmniMarkdownEdit(range: NSRange(location: selection.location - width, length: selection.length + 2 * width),
+                                    replacement: selected,
+                                    selection: NSRange(location: selection.location - width, length: selection.length))
+        }
+        let selectedString = selected as NSString
+        if selection.length > 2 * width, selected.hasPrefix(marker), selected.hasSuffix(marker) {
+            let inner = selectedString.substring(with: NSRange(location: width, length: selection.length - 2 * width))
+            return OmniMarkdownEdit(range: selection, replacement: inner,
+                                    selection: NSRange(location: selection.location, length: (inner as NSString).length))
+        }
+        return OmniMarkdownEdit(range: selection, replacement: marker + selected + marker,
+                                selection: NSRange(location: selection.location + width, length: selection.length))
+    }
+
+    // ⌘K: the selection becomes a link's text, or its target when it looks
+    // like a URL. The caret goes where the missing half belongs.
+    static func link(in text: String, selection: NSRange) -> OmniMarkdownEdit {
+        let selected = (text as NSString).substring(with: selection)
+        let length = selection.length
+        if ["http://", "https://", "mailto:"].contains(where: { selected.lowercased().hasPrefix($0) }) {
+            return OmniMarkdownEdit(range: selection, replacement: "[](\(selected))",
+                                    selection: NSRange(location: selection.location + 1, length: 0))
+        }
+        let caret = length == 0 ? selection.location + 1 : selection.location + length + 3
+        return OmniMarkdownEdit(range: selection, replacement: "[\(selected)]()",
+                                selection: NSRange(location: caret, length: 0))
+    }
+}
