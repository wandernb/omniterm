+// What fills the terminal band when the previewed run has no live tab: the
+// run's last screen (`run_screen`) when one was recorded, else a message;
+// either way with the buttons that bring a live session back.
+private final class OmniSnapshotBand: NSView {
+    // Its buttons get the pointing hand as they are added.
+    override func didAddSubview(_ subview: NSView) {
+        super.didAddSubview(subview)
+        OmniPointer.install(in: subview)
+    }
+
+    private static let barHeight: CGFloat = 40
+
+    private let title = NSTextField(labelWithString: "")
+    private let detail = NSTextField(wrappingLabelWithString: "")
+    private let caption = NSTextField(labelWithString: "")
+    private let snapshot = OmniTerminalSnapshotView(frame: .zero)
+    private var buttons: [NSButton] = []
+    private var runID: String?
+    private var shownScreen: String?
+    let zone = OmniButtonZone()
+
+    override var isFlipped: Bool { true }
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 600, height: 300))
+        wantsLayer = true
+        layer?.backgroundColor = OmniTerminalSnapshotView.snapshotBackground.cgColor
+        appearance = NSAppearance(named: .darkAqua)
+        title.font = OmniTheme.Font.bandTitle
+        title.textColor = NSColor.white.withAlphaComponent(0.85)
+        title.alignment = .center
+        addSubview(title)
+        detail.font = OmniTheme.Font.fact
+        detail.textColor = NSColor.white.withAlphaComponent(0.55)
+        detail.alignment = .center
+        addSubview(detail)
+        caption.font = OmniTheme.Font.rowDetail
+        caption.textColor = NSColor.white.withAlphaComponent(0.55)
+        caption.lineBreakMode = .byTruncatingTail
+        addSubview(caption)
+        snapshot.isHidden = true
+        addSubview(snapshot)
+        zone.buttons = { [weak self] in self?.buttons ?? [] }
+        addSubview(zone)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    func configure(title: String, detail: String, buttons: [NSButton]) {
+        self.title.stringValue = title
+        self.detail.stringValue = detail
+        for button in self.buttons {
+            button.removeFromSuperview()
+        }
+        self.buttons = buttons
+        for button in buttons {
+            addSubview(button, positioned: .below, relativeTo: zone)
+        }
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    // Fetches the run's recorded screen; nil clears it. A turn that finishes
+    // later overwrites the snapshot, so each reload asks again.
+    // Runs without a recorded screen (all from before snapshots) fall back to
+    // the end of their provider transcript, rendered like a terminal.
+    // Fetched once per run and output stamp (state, finish, report update).
+    func load(runID: String?, stamp: String, caption text: String) {
+        baseCaption = text
+        if runID != self.runID {
+            self.runID = runID
+            shownScreen = nil
+            loadedStamp = nil
+            showSnapshot(nil, truncated: false, fromTranscript: false)
+        }
+        guard let runID, stamp != loadedStamp else { return }
+        loadedStamp = stamp
+        OmniSchedulerClient.request(["op": "run_screen", "id": runID]) { [weak self] response in
+            guard let self, self.runID == runID else { return }
+            if OmniPane.isOK(response), let screen = response["screen"] as? String, !screen.isEmpty {
+                self.show(screen, truncated: (response["truncated"] as? NSNumber)?.boolValue ?? false, fromTranscript: false)
+                return
+            }
+            OmniHelper.run(["run", runID, "--tail", "--json", "--lines", "400"]) { [weak self] tail in
+                guard let self, self.runID == runID else { return }
+                let text = OmniPane.isOK(tail) ? tail["text"] as? String : nil
+                self.show(text, truncated: (tail["truncated"] as? NSNumber)?.boolValue ?? false, fromTranscript: true)
+            }
+        }
+    }
+
+    private var baseCaption = ""
+    private var loadedStamp: String?
+
+    private func show(_ screen: String?, truncated: Bool, fromTranscript: Bool) {
+        guard screen != shownScreen else { return }
+        shownScreen = screen
+        showSnapshot(screen, truncated: truncated, fromTranscript: fromTranscript)
+    }
+
+    private func showSnapshot(_ screen: String?, truncated: Bool, fromTranscript: Bool) {
+        let hasScreen = !(screen ?? "").isEmpty
+        snapshot.isHidden = !hasScreen
+        caption.isHidden = !hasScreen
+        title.isHidden = hasScreen
+        detail.isHidden = hasScreen
+        if let screen, hasScreen {
+            snapshot.show(screen: screen)
+            var text = fromTranscript ? "From the session transcript" : baseCaption
+            if truncated {
+                text += fromTranscript ? " · earlier output not shown" : " · truncated to the last 2000 lines"
+            }
+            caption.stringValue = text
+        }
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        zone.frame = bounds
+        let width = bounds.width
+        if !snapshot.isHidden {
+            // A bar above the snapshot carries the caption and the buttons.
+            var right = width - 12
+            for button in buttons.reversed() {
+                button.controlSize = .regular
+                button.sizeToFit()
+                right -= button.frame.width + 8
+                button.frame = NSRect(x: right, y: (Self.barHeight - 28) / 2, width: button.frame.width + 8, height: 28)
+                right -= 6
+            }
+            caption.frame = NSRect(x: 16, y: (Self.barHeight - 16) / 2, width: max(0, right - 24), height: 16)
+            snapshot.frame = NSRect(x: 0, y: Self.barHeight, width: width, height: max(0, bounds.height - Self.barHeight))
+            return
+        }
+        let textWidth = min(460, max(0, width - 40))
+        let top = max(24, bounds.height * 0.25)
+        title.frame = NSRect(x: 20, y: top, width: max(0, width - 40), height: 22)
+        let detailHeight = ceil(detail.sizeThatFits(NSSize(width: textWidth, height: 200)).height)
+        detail.frame = NSRect(x: (width - textWidth) / 2, y: top + 30, width: textWidth, height: detailHeight)
+        var total: CGFloat = 0
+        for button in buttons {
+            button.controlSize = .large
+            button.sizeToFit()
+            total += button.frame.width + 16
+        }
+        var x = (width - total + 12) / 2
+        for button in buttons {
+            button.frame = NSRect(x: x, y: detail.frame.maxY + 16, width: button.frame.width + 4, height: 32)
+            x = button.frame.maxX + 12
+        }
+    }
+}
