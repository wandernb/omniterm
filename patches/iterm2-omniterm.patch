+    [_scheduler runSQL:@"UPDATE runs SET diff_path=?,diff_state='captured' WHERE id='old'" bindings:@[ oldFile ]];
+    [_scheduler runSQL:@"UPDATE runs SET diff_path=?,diff_state='captured' WHERE id='new'" bindings:@[ newFile ]];
+
+    [_scheduler pruneRunDiffs];
+
+    XCTAssertFalse([[NSFileManager defaultManager] fileExistsAtPath:oldFile]);
+    XCTAssertTrue([[NSFileManager defaultManager] fileExistsAtPath:newFile]);
+    XCTAssertEqualObjects([self runReport:@"old"][@"diff_state"], @"expired");
+    XCTAssertEqualObjects([self runReport:@"new"][@"diff_state"], @"captured");
+}
