+    private func buildSettings(_ project: [String: Any]) {
+        let column = scroll.column
+        let root = project["root"] as? String ?? ""
+        let nameField = NSTextField(string: aliases[root] ?? "")
+        nameField.placeholderString = project["display_name"] as? String ?? project["name"] as? String ?? ""
+        nameField.font = OmniTheme.Font.rowTitle
+        nameField.delegate = self
+        nameField.identifier = NSUserInterfaceItemIdentifier("project-name")
+        column.addSection("Name")
+        column.add(OmniSettingRow(title: "Name in OmniTerm", detail: "Blank uses the folder’s name. Double-click it in the sidebar to rename too.",
+                                  control: nameField, controlWidth: 220), spacing: 8) { _ in OmniSettingRow.height }
+        if statusLabel.stringValue.isEmpty == false {
+            column.addText(statusLabel, spacing: 8)
+        }
+        var facts: [(String, String)] = [("Folder", OmniProjectsModel.abbreviated(root))]
+        if let main = project["main"] as? String {
+            facts.append(("Main checkout", OmniProjectsModel.abbreviated(main)))
+        }
+        facts.append(("Layout", project["layout"] as? String == "forge" ? "Forge (@head beside its worktrees)" : "Plain repository"))
+        facts.append(("Knowledge folder", project["forge"] as? Bool == true ? "Yes" : "No"))
+        facts.append(("Registered", project["registered"] as? Bool == true ? "Yes (forge projects add, or a session opened in it)" : "Found by the scan"))
+        let folders = layout["folders"] as? [String: String] ?? [:]
+        facts.append(("Sidebar folder", folders[root].map { $0.isEmpty ? "None" : $0 } ?? "None"))
+        column.addSection("Forge")
+        column.addText(OmniPane.facts(facts + repositoryFacts(project).filter { $0.0 == "Exposure" }), spacing: 8)
+        column.addText(OmniTheme.meta("Exposure comes from Forge’s private exposure map and is changed there, not here."), spacing: 10)
+        let reveal = OmniPaneText.button("Reveal in Finder", target: self, action: #selector(revealRoot(_:)))
+        let copy = OmniPaneText.button("Copy Path", target: self, action: #selector(copyPath(_:)))
+        let refresh = OmniPaneText.button("Refresh", target: self, action: #selector(refreshProject(_:)))
+        let buttons = OmniButtonRow([reveal, copy, refresh])
+        buttonsZone = buttons.zone
+        column.add(buttons, spacing: 10) { _ in 30 }
+    }
+
+    private func section(_ title: String, key: String, previous: [(title: String, zone: OmniListZone)],
+                         rows: [(key: String, row: OmniZoneItem)], header: Bool = true) {
+        guard !rows.isEmpty else { return }
+        let column = scroll.column
+        if header {
+            column.addSection(title)
+        }
+        let zone = previous.first { $0.title == key }?.zone ?? OmniListZone()
+        let list = OmniColumnView()
+        list.inset = 0
+        list.topPadding = 0
+        list.bottomPadding = 0
+        list.overlay = zone
+        for (_, row) in rows {
+            list.add(row, spacing: 2) { _ in OmniFolderEntryRow.height }
+        }
+        zone.setItems(rows.map { (key: $0.key, view: $0.row) })
+        column.add(list, spacing: 8) { [weak list] width in
+            list?.layoutColumn(width: width) ?? 0
+        }
+        zones.append((title: key, zone: zone))
+    }
