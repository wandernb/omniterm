+//
+//  OmniWindowTypeTests.m
+//  ModernTests
+//
+//  OmniTerm's window keeps a standard title bar whatever the shared theme.
+//
+
+#import <XCTest/XCTest.h>
+
+#import "ITAddressBookMgr.h"
+
+@interface OmniWindowTypeTests : XCTestCase
+@end
+
+@implementation OmniWindowTypeTests
+
+- (void)testCompactWindowTypesBecomeTitledWindows {
+    XCTAssertEqual(iTermThemedWindowType(WINDOW_TYPE_COMPACT), WINDOW_TYPE_NORMAL);
+    XCTAssertEqual(iTermThemedWindowType(WINDOW_TYPE_COMPACT_MAXIMIZED), WINDOW_TYPE_MAXIMIZED);
+    XCTAssertEqual(iTermThemedWindowType(WINDOW_TYPE_COMPACT_CENTERED), WINDOW_TYPE_CENTERED);
+}
+
+- (void)testDefaultWindowIsTitledEvenUnderTheMinimalTheme {
+    // Reads only: the shared tab style is whatever the machine has, and the
+    // result must not depend on it.
+    XCTAssertEqual(iTermThemedWindowType(WINDOW_TYPE_NORMAL), WINDOW_TYPE_NORMAL);
+    XCTAssertEqual(iTermWindowDefaultType(), WINDOW_TYPE_NORMAL);
+}
+
+- (void)testOtherWindowTypesAreUnchanged {
+    XCTAssertEqual(iTermThemedWindowType(WINDOW_TYPE_LION_FULL_SCREEN), WINDOW_TYPE_LION_FULL_SCREEN);
+    XCTAssertEqual(iTermThemedWindowType(WINDOW_TYPE_NO_TITLE_BAR), WINDOW_TYPE_NO_TITLE_BAR);
+    XCTAssertEqual(iTermThemedWindowType(WINDOW_TYPE_TOP_PERCENTAGE), WINDOW_TYPE_TOP_PERCENTAGE);
+}
+
+@end
