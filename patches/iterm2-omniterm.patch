+    }
+    if ([operation isEqual:@"runner_input"] || [operation isEqual:@"runner_input_status"]) {
+        NSString *action = request[@"action"];
+        if (![@[ @"wrap_up", @"compact", @"finish" ] containsObject:action ?: @""]) return @{ @"ok": @NO, @"error": @"Unknown lifecycle input" };
+        NSDictionary *run = [self rowsForSQL:@"SELECT * FROM runs WHERE id=?" bindings:@[ request[@"run_id"] ?: @"" ]].firstObject;
+        if (!run) return @{ @"ok": @NO, @"error": @"Run not found" };
+        if ([operation isEqual:@"runner_input"] && [action isEqual:@"finish"]) {
+            NSString *json = [run[@"agent_snapshot"] isKindOfClass:NSString.class] ? run[@"agent_snapshot"] : nil;
+            NSDictionary *snapshot = json ? [NSJSONSerialization JSONObjectWithData:[json dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil] : nil;
