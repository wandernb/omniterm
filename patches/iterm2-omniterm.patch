+- (void)testMixedSidebarOrderIsValidatedAndMaintained {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSMutableDictionary *base = [[self agentFileNamed:@"Review"] mutableCopy];
+    NSDictionary *groups = @{ @"Alpha": @"A", @"Nested": @"A/B", @"Loose": @"" };
+    for (NSString *name in groups) {
+        NSMutableDictionary *agent = [base mutableCopy];
+        agent[@"name"] = name;
+        agent[@"group"] = groups[name];
+        XCTAssertEqualObjects(([self request:@{ @"op": @"create_agent", @"agent": agent }][@"ok"]), @YES);
+    }
+    [self request:@{ @"op": @"set_sidebar_groups", @"groups": @[ @"Empty" ] }];
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"], @[]);
+
+    NSArray *items = @[ @"agent:Loose", @"group: A ", @"agent:Ghost", @"group:Empty", @"group:Nowhere",
+                        @"agent:Review", @"group:A/B", @"agent:Loose" ];
+    NSDictionary *response = [self request:@{ @"op": @"set_sidebar_order", @"items": items }];
+    NSArray *expected = @[ @"agent:Loose", @"group:A", @"group:Empty", @"agent:Review", @"group:A/B" ];
+    XCTAssertEqualObjects(response[@"items"], expected, @"Normalized, deduped, unknown agents and groups dropped");
+    XCTAssertEqualObjects([self request:@{ @"op": @"get_settings" }][@"settings"][@"sidebar_order"], expected);
+
+    for (id bad in @[ @[ @"agent:" ], @[ @"group:a/b/c" ], @[ @"folder:A" ], @"agent:Loose" ]) {
+        response = [self request:@{ @"op": @"set_sidebar_order", @"items": bad }];
+        XCTAssertEqualObjects(response[@"code"], @"invalid_appearance", @"%@", bad);
+        XCTAssertEqualObjects(response[@"field"], @"sidebar_order", @"%@", bad);
+    }
+    XCTAssertFalse([_scheduler updateSettings:@{ @"sidebar_order": @[ @"x" ] } error:nil]);
+
+    // A rename keeps the agent's place; a delete removes it.
+    [self request:@{ @"op": @"rename_agent", @"name": @"Review", @"new_name": @"Critic" }];
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"],
+                          (@[ @"agent:Loose", @"group:A", @"group:Empty", @"agent:Critic", @"group:A/B" ]));
+    [self request:@{ @"op": @"delete_agent", @"name": @"Loose" }];
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"],
+                          (@[ @"group:A", @"group:Empty", @"agent:Critic", @"group:A/B" ]));
+
+    // Renaming a group rewrites its key and its subgroups' keys in place.
+    [self request:@{ @"op": @"rename_group", @"from": @"A", @"to": @"Z" }];
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"],
+                          (@[ @"group:Z", @"group:Empty", @"agent:Critic", @"group:Z/B" ]));
+    // Dissolving puts what the group held into its slot: the promoted
+    // subgroup listed earlier keeps its turn, the unlisted agent follows.
+    [self request:@{ @"op": @"rename_group", @"from": @"Z", @"to": @"" }];
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"],
+                          (@[ @"group:B", @"agent:Alpha", @"group:Empty", @"agent:Critic" ]));
+    XCTAssertEqualObjects([self agentFileNamed:@"Nested"][@"group"], @"B");
+    XCTAssertNil([self agentFileNamed:@"Alpha"][@"group"]);
+
+    // Moving a group into another keeps its own key in place.
+    [self request:@{ @"op": @"rename_group", @"from": @"Empty", @"to": @"P/Empty" }];
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"],
+                          (@[ @"group:B", @"agent:Alpha", @"group:P/Empty", @"agent:Critic" ]));
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_agent_order"], @[], @"The legacy order still round-trips");
+}
