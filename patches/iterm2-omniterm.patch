+    // MARK: - Tables
+
+    private func stepTable(_ table: NSTableView, by delta: Int) {
+        let count = numberOfRows(in: table)
+        guard count > 0 else { return }
+        let target = table.selectedRow < 0 ? 0 : min(max(0, table.selectedRow + delta), count - 1)
+        table.selectRowIndexes(IndexSet(integer: target), byExtendingSelection: false)
+        table.scrollRowToVisible(target)
+    }
+
+    func numberOfRows(in tableView: NSTableView) -> Int {
+        switch tableView {
+        case memoryTable: return memories.count
+        case searchTable: return searchResults.count
+        case eventsTable: return events.count
+        case ingestTable: return ingestRuns.count
+        default: return 0
+        }
+    }
+
+    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
+        let cell = OmniMemoryRowView()
+        switch tableView {
+        case memoryTable:
+            let item = memories[row]
+            var meta = [item.evidenceCount == 1 ? "1 source" : "\(item.evidenceCount) sources"]
+            if let updated = item.updated { meta.append(OmniMemoryText.time(updated)) }
+            if item.pinned { meta.append("pinned") }
+            if item.expiring { meta.append("fading") }
+            cell.configure(title: item.title, detail: meta.joined(separator: " · "),
+                           color: OmniTheme.memoryTypeColor(item.memoryType), faded: item.expiring,
+                           chip: item.memoryType, weight: item.effectiveWeight)
+        case searchTable:
+            let result = searchResults[row]
+            if let item = OmniMemoryItem(result), result["title"] != nil {
+                cell.configure(title: item.title, detail: item.detailLine, color: OmniTheme.memoryTypeColor(item.memoryType),
+                               faded: item.expiring)
+            } else {
+                let text = (result["text"] as? String ?? "").replacingOccurrences(of: "\n", with: " ")
+                let origin = [result["session_id"] as? String, result["role"] as? String]
+                    .compactMap { $0 }.joined(separator: " · ")
+                // With a snippet, the row leads with where the match came from and the snippet shows it.
+                let hasSnippet = (result["snippet"] as? String)?.isEmpty == false
+                cell.configure(title: hasSnippet ? origin : text, detail: hasSnippet ? "" : origin,
+                               color: OmniTheme.ended, faded: false)
+            }
+            if let snippet = result["snippet"] as? String, !snippet.isEmpty {
+                cell.setDetail(OmniSearchQuery.snippet(snippet, font: OmniTheme.Font.rowDetail,
+                                                       color: OmniTheme.secondaryText))
+            }
+        case eventsTable:
+            let event = events[row]
+            let kind = event["kind"] as? String ?? ""
+            cell.configure(title: OmniMemoryText.kindTitle(kind) + " · " + OmniMemoryText.time(event["at"]),
+                           detail: OmniMemoryText.eventSummary(event), color: OmniMemoryText.kindColor(kind), faded: false)
+        case ingestTable:
+            let run = ingestRuns[row]
+            let outcome = (run.finalMessage ?? run.summary ?? "").replacingOccurrences(of: "\n", with: " ")
+            cell.configure(title: run.statusLine + " · " + OmniMemoryText.time(run.started.timeIntervalSince1970),
+                           detail: OmniReportText.sanitized(outcome.isEmpty ? run.state.capitalized : outcome),
+                           color: run.outcomeColor, faded: false)
+        default:
+            break
+        }
+        return cell
+    }
+
+    func tableViewSelectionDidChange(_ notification: Notification) {
+        guard let table = notification.object as? NSTableView, table.selectedRow >= 0 else { return }
+        let row = table.selectedRow
+        switch table {
+        case memoryTable where row < memories.count:
+            if memories[row].id != selectedMemoryID || detailText.string.isEmpty {
+                selectMemory(memories[row].id)
+            }
+        case searchTable where row < searchResults.count:
+            showSearchResult(searchResults[row])
+        case eventsTable where row < events.count:
+            showEvent(events[row])
+        case ingestTable where row < ingestRuns.count:
+            showIngestRun(ingestRuns[row])
+        default:
+            break
+        }
+    }
+}
