+// OmniTerm lays its pages over the terminal. While one covers the pointer,
+// the terminal keeps no document cursor, so its text cursor never shows
+// through the page's buttons and rows.
+- (BOOL)omniPageCoversEvent:(NSEvent *)event {
+    NSView *contentView = self.window.contentView;
+    if (!contentView || !event) {
+        return NO;
+    }
+    NSView *base = contentView.superview ?: contentView;
+    NSView *hit = [contentView hitTest:[base convertPoint:event.locationInWindow fromView:nil]];
+    if (!hit || hit == self || [hit isDescendantOf:self]) {
+        return NO;
+    }
+    for (NSView *view = hit; view; view = view.superview) {
+        if ([NSStringFromClass([view class]) hasSuffix:@"OmniContentHost"]) {
+            return YES;
+        }
+    }
+    return NO;
+}
