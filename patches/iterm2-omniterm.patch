+- (void)testRunScreensExpireAfterThirtyDaysAndBeyondTheNewest200 {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSFileManager *fileManager = [NSFileManager defaultManager];
+    NSString *directory = [_scheduler runScreensPath];
+    XCTAssertTrue([fileManager createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:nil]);
+    NSDate *now = [NSDate date];
+    for (int i = 0; i < 202; i++) {
+        NSString *path = [directory stringByAppendingPathComponent:[NSString stringWithFormat:@"%04x.ansi", i]];
+        XCTAssertTrue([[NSData data] writeToFile:path atomically:NO]);
+        // 0000 is the newest; 00c9 (201) the oldest.
+        [fileManager setAttributes:@{ NSFileModificationDate: [now dateByAddingTimeInterval:-i] }
+                      ofItemAtPath:path
+                             error:nil];
+    }
+    NSString *expired = [directory stringByAppendingPathComponent:@"0000.ansi"];
+    [fileManager setAttributes:@{ NSFileModificationDate: [now dateByAddingTimeInterval:-31 * 24 * 60 * 60] }
+                  ofItemAtPath:expired
+                         error:nil];
+    NSString *unrelated = [directory stringByAppendingPathComponent:@"notes.txt"];
+    XCTAssertTrue([[NSData data] writeToFile:unrelated atomically:NO]);
+
+    [_scheduler pruneRunScreens];
+
+    XCTAssertFalse([fileManager fileExistsAtPath:expired], @"Older than 30 days");
+    XCTAssertTrue([fileManager fileExistsAtPath:[directory stringByAppendingPathComponent:@"0001.ansi"]]);
+    XCTAssertTrue([fileManager fileExistsAtPath:[directory stringByAppendingPathComponent:@"00c8.ansi"]]);
+    XCTAssertFalse([fileManager fileExistsAtPath:[directory stringByAppendingPathComponent:@"00c9.ansi"]],
+                   @"Beyond the newest 200");
+    XCTAssertTrue([fileManager fileExistsAtPath:unrelated], @"Only screen files are pruned");
+}
