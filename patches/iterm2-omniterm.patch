+- (void)testNativeWorkerRestartReadsDurableProjectionAndKeepsMemoryWhenSourceDisappears {
+    [self startKnowledgeIntegrationFixture];
+    NSDictionary *ready = [self integrationKnowledgeRequest:@{ @"op": @"knowledge_status" }];
+    XCTAssertEqualObjects(ready[@"ok"], @YES);
+    [self runIntegrationKnowledgeTick];
+    NSDictionary *memory = [self createIntegrationMemoryFromTranscript];
+    XCTAssertNotNil(memory);
+
+    // Hold maintenance while testing restart reads, so a source removed below
+    // cannot be re-read or reconciled until the explicit next native cycle.
+    [self pauseIntegrationKnowledgeMaintenance];
+    NSTask *ownedWorker = [_knowledgeIntegrationScheduler valueForKey:@"knowledgeTask"];
+    XCTAssertTrue(ownedWorker.running);
+    pid_t originalPID = ownedWorker.processIdentifier;
+    XCTestExpectation *exited = [self expectationWithDescription:@"owned index worker exited"];
+    ownedWorker.terminationHandler = ^(NSTask *task) { [exited fulfill]; };
+    [ownedWorker terminate];
+    [self waitForExpectations:@[ exited ] timeout:10];
+    XCTAssertFalse(ownedWorker.running);
+    XCTAssertTrue([[NSFileManager defaultManager] removeItemAtPath:[self integrationTranscriptPath] error:nil]);
+
+    NSDictionary *restored = [self integrationKnowledgeRequest:@{ @"op": @"get_session", @"session_id": @"claude:5b55042e-4145-4dcc-967a-bca3c66267f9" }];
+    XCTAssertEqualObjects(restored[@"ok"], @YES);
+    XCTAssertEqual([restored[@"messages"] count], 1u);
+    NSTask *newWorker = [_knowledgeIntegrationScheduler valueForKey:@"knowledgeTask"];
+    XCTAssertTrue(newWorker.running);
+    XCTAssertNotEqual(newWorker.processIdentifier, originalPID);
+
+    [self runIntegrationKnowledgeTick];
+    NSDictionary *retained = [self integrationKnowledgeRequest:@{ @"op": @"search_memories", @"query": @"duplicate receipts" }];
+    NSDictionary *retainedMemory = [retained[@"memories"] firstObject];
+    XCTAssertEqualObjects(retainedMemory[@"id"], @"native-e2e-memory");
+    XCTAssertEqualObjects([retainedMemory[@"sources"] firstObject][@"available"], @NO);
+    NSDictionary *gone = [self integrationKnowledgeRequest:@{ @"op": @"get_session", @"session_id": @"claude:5b55042e-4145-4dcc-967a-bca3c66267f9" }];
+    XCTAssertEqualObjects(gone[@"code"], @"session_not_found");
+}
