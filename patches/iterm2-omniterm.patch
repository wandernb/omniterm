+    private static func find<T: NSView>(_ type: T.Type, in view: NSView, where test: (T) -> Bool = { _ in true }) -> T? {
+        if let match = view as? T, test(match) {
+            return match
+        }
+        for subview in view.subviews {
+            if let match = find(type, in: subview, where: test) {
+                return match
+            }
+        }
+        return nil
+    }
