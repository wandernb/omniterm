+    XCTAssertEqualObjects(([scheduler responseForKnowledgeRequest:@{ @"op": @"upsert_memory" }][@"ok"]), @YES);
+    XCTAssertEqualObjects(operations, (@[ @"upsert_memory", @"ack_writes", @"drain_writes", @"ack_writes" ]));
