+- (NSDictionary *)settings {
+    NSData *data = [NSData dataWithContentsOfFile:_settingsPath];
+    NSDictionary *stored = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+    NSMutableDictionary *settings = [NSMutableDictionary dictionaryWithDictionary:[self defaultSettings]];
+    if ([stored isKindOfClass:[NSDictionary class]]) {
+        [settings addEntriesFromDictionary:stored];
+    }
+    settings[@"schema_version"] = @2;
+    // A hand-edited list keeps its valid entries.
+    NSMutableArray *groups = [NSMutableArray array];
+    if ([settings[@"sidebar_groups"] isKindOfClass:[NSArray class]]) {
+        for (id entry in settings[@"sidebar_groups"]) {
+            NSString *group = OmniValidGroupPath(entry);
+            if (group && ![groups containsObject:group]) {
+                [groups addObject:group];
+            }
+        }
+    }
+    settings[@"sidebar_groups"] = groups;
+    NSMutableOrderedSet<NSString *> *order = [NSMutableOrderedSet orderedSet];
+    if ([settings[@"sidebar_agent_order"] isKindOfClass:[NSArray class]]) {
+        for (id entry in settings[@"sidebar_agent_order"]) {
+            NSString *name = OmniValidAgentName(entry);
+            if (name) {
+                [order addObject:name];
+            }
+        }
+    }
+    settings[@"sidebar_agent_order"] = order.array;
+    NSMutableOrderedSet<NSString *> *items = [NSMutableOrderedSet orderedSet];
+    if ([settings[@"sidebar_order"] isKindOfClass:[NSArray class]]) {
+        for (id entry in settings[@"sidebar_order"]) {
+            NSString *key = OmniValidSidebarKey(entry);
+            if (key) {
+                [items addObject:key];
+            }
+        }
+    }
+    settings[@"sidebar_order"] = items.array;
+    // A hand-edited layout that does not validate falls back to the defaults.
+    settings[@"layout"] = OmniValidLayout(settings[@"layout"]) ?: @{};
+    if (![settings[@"summaries"] isKindOfClass:[NSNumber class]]) {
+        settings[@"summaries"] = @YES;
+    }
+    NSString *model = [settings[@"summary_model"] isKindOfClass:[NSString class]] ? settings[@"summary_model"] : nil;
+    model = [model stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    // The runner passes the model to `claude --model`; it must not read as a flag.
+    if (!model.length || [model hasPrefix:@"-"]) {
+        settings[@"summary_model"] = @"haiku";
+    }
+    // Hand-edited notification rules and agent defaults keep their valid fields.
+    settings[@"notifications"] = OmniValidNotificationSettings(settings[@"notifications"], NO, NULL);
+    settings[@"agent_defaults"] = OmniValidAgentDefaults(settings[@"agent_defaults"], NO, NULL);
+    return settings;
+}
+
+// Validates every change before anything is written; one invalid key rejects
+// the whole request. Returns the values to store, or nil with the key named.
+- (NSDictionary *)validatedSettingChanges:(NSDictionary *)changes invalidKey:(NSString **)invalidKey {
+    NSDictionary *current = [self settings];
+    NSMutableDictionary *validated = [NSMutableDictionary dictionary];
+    for (id key in changes) {
+        if (![key isKindOfClass:[NSString class]] || ![OmniSettableSettingKeys() containsObject:key]) {
+            if (invalidKey) *invalidKey = [key description];
+            return nil;
+        }
+        id value = OmniValidSettingValue(key, changes[key], current, invalidKey);
+        if (!value) return nil;
+        validated[key] = value;
+    }
+    return validated;
+}
+
+- (NSDictionary *)setSettingsResponse:(NSDictionary *)request {
+    if (![request[@"settings"] isKindOfClass:[NSDictionary class]] || ![(NSDictionary *)request[@"settings"] count]) {
+        return @{ @"ok": @NO, @"code": @"invalid_settings", @"error": @"settings must be a non-empty object" };
+    }
+    NSString *invalidKey = nil;
+    if (![self validatedSettingChanges:request[@"settings"] invalidKey:&invalidKey]) {
+        return @{ @"ok": @NO, @"code": @"invalid_settings", @"field": invalidKey ?: @"settings",
+                  @"error": [NSString stringWithFormat:@"Invalid setting: %@", invalidKey ?: @"settings"] };
+    }
+    // updateSettings validates and merges the raw changes itself; passing it
+    // already-merged values would merge them a second time.
+    NSError *error = nil;
+    if (![self updateSettings:request[@"settings"] error:&error]) {
+        return @{ @"ok": @NO, @"code": @"write_failed", @"error": error.localizedDescription ?: @"Could not save settings" };
+    }
+    [self settingsDidChange];
+    return @{ @"ok": @YES, @"settings": [self settings] };
+}
+
+- (void)settingsDidChange {
+    void (^handler)(void) = self.settingsChangedHandler;
+    if (handler) {
+        dispatch_async(dispatch_get_main_queue(), handler);
+    }
+    // Mute and the notification rules change what the menu bar counts and banners.
+    [self notificationsDidChange];
+}
+
+- (NSDictionary *)currentSettings {
+    return [self settings];
+}
