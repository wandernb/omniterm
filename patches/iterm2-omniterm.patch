+    // MARK: - Views by project and by folder
+
+    // A forge project's root for a session, from the worker's annotation.
+    private static func sessionRoot(_ session: [AnyHashable: Any]) -> String? {
+        guard let project = session["project"] as? [String: Any] else { return nil }
+        return project["root"] as? String ?? project["id"] as? String
+    }
+
+    // Rows under each project, the projects under the person's project
+    // folders (as Projects mode arranges them); the rest under "Other".
+    private func projectTree(prefix: String, rowsByRoot: [String: [OmniSidebarItem]], names: [String: String],
+                             noun: String) -> [OmniSidebarItem] {
+        let tree = projectLayout.tree(roots: Array(rowsByRoot.keys))
+        func build(_ entries: [OmniGroupTree.Entry]) -> [OmniSidebarItem] {
+            return entries.compactMap { entry in
+                switch entry {
+                case .agent(let root):
+                    let children = rowsByRoot[root] ?? []
+                    guard !children.isEmpty else { return nil }
+                    let title = projectLayout.name(root) ?? names[root] ?? (root as NSString).lastPathComponent
+                    // Runs listed beside their agents are not counted.
+                    let count = children.filter { $0.kind != .run && $0.kind != .recentRun }.count
+                    let row = item(.viewGroup, key: "\(prefix)project|\(root)", title: title,
+                                   detail: count == 1 ? "1 \(noun)" : "\(count) \(noun)s",
+                                   route: .project(root))
+                    let look = projectLayout.appearance(root)
+                    row.icon = look.icon ?? .symbol(SFSymbol.shippingbox.rawValue)
+                    row.iconColor = look.color
+                    row.children = children
+                    return row
+                case .group(let group):
+                    let children = build(group.children)
+                    guard !children.isEmpty else { return nil }
+                    let row = item(.viewGroup, key: "\(prefix)folder|\(group.path)", title: group.name)
+                    let look = projectLayout.appearance(OmniProjectLayout.folderKey(group.path))
+                    row.icon = look.icon
+                    row.iconColor = look.color
+                    row.children = children
+                    return row
+                }
+            }
+        }
+        return build(tree.entries)
+    }
+
+    private func sessionsByProject(_ rest: [(row: OmniSidebarItem, session: [AnyHashable: Any])]) -> [OmniSidebarItem] {
+        var byRoot: [String: [OmniSidebarItem]] = [:]
+        var names: [String: String] = [:]
+        var other: [(key: String, title: String, rows: [OmniSidebarItem])] = []
+        for (row, session) in rest {
+            if let root = Self.sessionRoot(session) {
+                byRoot[root, default: []].append(row)
+                names[root] = (session["project"] as? [String: Any])?["name"] as? String
+            } else {
+                // Outside any project: by folder, under Other.
+                let group = OmniProjectsModel.sessionGroup(session, aliases: projectLayout.names)
+                if let index = other.firstIndex(where: { $0.key == group.key }) {
+                    other[index].rows.append(row)
+                } else {
+                    other.append((group.key, group.title.isEmpty ? "No Folder" : group.title, [row]))
+                }
+            }
+        }
+        projectSessionsSection.children = projectTree(prefix: "sessions-", rowsByRoot: byRoot, names: names, noun: "session")
+        otherSessionsSection.children = other.map { group in
+            let row = item(.viewGroup, key: "sessions-other|\(group.key)", title: group.title)
+            row.children = group.rows
+            return row
+        }
+        return [projectSessionsSection, otherSessionsSection].filter { !$0.children.isEmpty }
+    }
+
+    // MARK: Pinned sessions
+
+    private func requestPinnedSessions(_ ids: [String]) {
+        for id in ids where !pinnedRequested.contains(id) {
+            pinnedRequested.insert(id)
+            OmniSchedulerClient.request(["op": "get_session", "session_id": id, "limit": 1]) { [weak self] response in
+                guard let self else { return }
+                guard let session = response["session"] as? [AnyHashable: Any] else {
+                    // Asked again on a later rebuild (the worker may be starting).
+                    self.pinnedRequested.remove(id)
+                    return
+                }
+                self.pinnedExtras[id] = session
+                self.rebuild()
+            }
+        }
+    }
+
+    private func setPinned(_ id: String, _ pin: Bool) {
+        var ids = Self.pinnedSessions.filter { $0 != id }
+        if pin {
+            ids.append(id)
+        }
+        setSessionsPreference(Self.pinnedSessionsKey, ids.isEmpty ? nil : ids as CFArray)
+        rebuild()
+    }
+
+    @objc private func togglePinSession(_ sender: NSMenuItem) {
+        guard let id = sender.representedObject as? String else { return }
+        setPinned(id, !Self.pinnedSessions.contains(id))
+    }
+
+    // Double-click on a session row: its title, renamed the provider's way.
+    private func renameSessionInPlace(_ row: OmniSidebarItem, to newName: String) {
+        guard case .session(let id) = row.route, !newName.isEmpty else {
+            finishInteraction()
+            return
+        }
+        let oldName = row.title
+        row.title = newName
+        outlineView.reloadItem(row)
+        OmniSchedulerClient.request(["op": "rename_session", "session_id": id, "title": newName]) { [weak self] response in
+            guard let self else { return }
+            guard response["ok"] as? Bool == true else {
+                row.title = oldName
+                self.outlineView.reloadItem(row)
+                self.showRenameProblem(response["error"] as? String ?? "The session could not be renamed.", on: row)
+                return
+            }
+            if let index = self.sessions.firstIndex(where: { $0["session_id"] as? String == id }) {
+                self.sessions[index]["title"] = newName
+            }
+            (self.contentHost.pane as? OmniSessionPane)?.reload()
+            self.finishInteraction()
+            self.rebuild()
+        }
+    }
+
+    private func sessionsInFolders(_ rest: [(row: OmniSidebarItem, session: [AnyHashable: Any])]) -> [OmniSidebarItem] {
+        let rowsByID = Dictionary(rest.compactMap { entry in (entry.session["session_id"] as? String).map { ($0, entry.row) } },
+                                  uniquingKeysWith: { first, _ in first })
+        let filed = rowsByID.keys.filter { sessionLayout.folders[$0] != nil }
+        let tree = sessionLayout.tree(roots: filed)
+        func build(_ entries: [OmniGroupTree.Entry]) -> [OmniSidebarItem] {
+            return entries.compactMap { entry in
+                switch entry {
+                case .agent(let id):
+                    let row = rowsByID[id]
+                    row?.groupPath = sessionLayout.folders[id] ?? ""
+                    return row
+                case .group(let group):
+                    let row = item(.sessionFolder, key: group.path, title: group.name)
+                    row.groupPath = group.path
+                    row.children = build(group.children)
+                    return row
+                }
+            }
+        }
+        folderSessionsSection.children = build(tree.entries)
+        otherSessionsSection.children = rest.map(\.row).filter { row in
+            guard case .session(let id) = row.route else { return true }
+            return sessionLayout.folders[id] == nil
+        }
+        return [folderSessionsSection, otherSessionsSection]
+    }
+
+    // Agents by project: the agents under their workspace's project, in the
+    // person's project folders; agents outside any project under Other.
+    private func arrangeAgentsByProject(runs: [OmniSidebarItem] = []) {
+        let rows = Self.flattened(agentsSection.children).filter { $0.kind == .agent }
+        var runsByAgent: [String: [OmniSidebarItem]] = [:]
+        for run in runs {
+            runsByAgent[run.title, default: []].append(run)
+        }
+        let agentNames = Set(rows.map(\.title))
+        var workspaces: [String: String] = [:]
+        for agent in agents {
+            if let name = agent["name"] as? String, let workspace = agent["workspace"] as? String {
+                workspaces[name] = workspace
+            }
+        }
+        requestAgentProjects(Array(Set(workspaces.values)))
+        var byRoot: [String: [OmniSidebarItem]] = [:]
+        var other: [OmniSidebarItem] = []
+        // Each agent, then its runs (live first, as listed).
+        for row in rows {
+            let group = [row] + (runsByAgent[row.title] ?? [])
+            if let workspace = workspaces[row.title], let root = agentProjectRoots[workspace] {
+                byRoot[root, default: []] += group
+            } else {
+                other += group
+            }
+        }
+        // Runs of agents not listed (renamed or deleted) go to Other.
+        other += runs.filter { !agentNames.contains($0.title) }
+        var children = projectTree(prefix: "agents-", rowsByRoot: byRoot, names: [:], noun: "agent")
+        if !other.isEmpty {
+            let row = item(.viewGroup, key: "agents-other", title: "Other")
+            row.children = other
+            children.append(row)
+        }
+        agentsSection.children = children
+    }
+
+    // In folders, runs sit under their agent's folder; runs of agents
+    // outside any folder stay at the top level.
+    private func arrangeRuns() {
+        let rows = runsSection.children
+        guard !rows.isEmpty else { return }
+        var byAgent: [String: [OmniSidebarItem]] = [:]
+        for row in rows {
+            byAgent[row.title, default: []].append(row)
+        }
+        var placed = Set<String>()
+        func build(_ entries: [OmniGroupTree.Entry]) -> [OmniSidebarItem] {
+            return entries.flatMap { entry -> [OmniSidebarItem] in
+                switch entry {
+                case .agent(let name):
+                    placed.insert(name)
+                    return byAgent[name] ?? []
+                case .group(let group):
+                    let children = build(group.children)
+                    guard !children.isEmpty else { return [] }
+                    let row = item(.viewGroup, key: "runs-folder|\(group.path)", title: group.name)
+                    row.icon = OmniAgentIcon(spec: agentFolderIcons[group.path])
+                    row.iconColor = agentFolderColors[group.path]
+                    row.children = children
+                    return [row]
+                }
+            }
+        }
+        let arranged = build(groupTree.entries)
+        runsSection.children = arranged + rows.filter { !placed.contains($0.title) }
+    }
+
+    private func requestAgentProjects(_ workspaces: [String]) {
+        let missing = workspaces.filter { !agentProjectsRequested.contains($0) }
+        guard !missing.isEmpty else { return }
+        agentProjectsRequested.formUnion(missing)
+        OmniSchedulerClient.request(["op": "project_of", "paths": missing]) { [weak self] response in
+            guard let self, response["ok"] as? Bool == true else {
+                // Asked again on a later rebuild (the worker may be starting).
+                self?.agentProjectsRequested.subtract(missing)
+                return
+            }
+            let owners = response["projects"] as? [String: Any] ?? [:]
+            var changed = false
+            for (workspace, owner) in owners {
+                if let root = owner as? String, self.agentProjectRoots[workspace] != root {
+                    self.agentProjectRoots[workspace] = root
+                    changed = true
+                }
+            }
+            // The worker answers from its cache: unknown ones are asked again later.
+            let unknown = missing.filter { !(owners[$0] is String) }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 10) { [weak self] in
+                self?.agentProjectsRequested.subtract(unknown)
+            }
+            if changed {
+                self.rebuild()
+            }
+        }
+    }
