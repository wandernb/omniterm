+- (void)testDiffIsCapturedFrozenAndPrivateWithoutRunningRepositoryFilters {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSString *repository = [_temporaryPath stringByAppendingPathComponent:@"repo"];
+    [[NSFileManager defaultManager] createDirectoryAtPath:repository withIntermediateDirectories:YES attributes:nil error:nil];
+    [self runGit:@[ @"init", @"-q" ] inDirectory:repository];
+    NSString *file = [repository stringByAppendingPathComponent:@"a.txt"];
+    [@"one\n" writeToFile:file atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    [self runGit:@[ @"add", @"a.txt" ] inDirectory:repository];
+    [self runGit:@[ @"commit", @"-q", @"-m", @"init" ] inDirectory:repository];
+    // A repository-configured textconv and filter must not run during capture.
+    NSString *marker = [_temporaryPath stringByAppendingPathComponent:@"filter-ran"];
+    [self runGit:@[ @"config", @"diff.evil.textconv", [NSString stringWithFormat:@"touch '%@'; cat", marker] ] inDirectory:repository];
+    [self runGit:@[ @"config", @"filter.evil.clean", [NSString stringWithFormat:@"touch '%@'; cat", marker] ] inDirectory:repository];
+    [@"*.txt diff=evil filter=evil\n" writeToFile:[repository stringByAppendingPathComponent:@".gitattributes"]
+                                      atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    [@"two\n" writeToFile:file atomically:YES encoding:NSUTF8StringEncoding error:nil];
+
+    NSDictionary *created = [self notify:@{ @"title": @"Changed", @"workspace": repository }];
+    XCTAssertEqualObjects(created[@"ok"], @YES);
+    NSDictionary *item = [self waitForDiffOf:created[@"id"]];
+    XCTAssertEqualObjects(item[@"diff_state"], @"captured");
+    XCTAssertTrue([item[@"diff_files"] containsObject:@" M a.txt"], @"%@", item[@"diff_files"]);
+    XCTAssertFalse([[NSFileManager defaultManager] fileExistsAtPath:marker], @"A repository filter ran");
+
+    NSDictionary *diff = [_scheduler responseForRequest:@{ @"op": @"notification_diff", @"id": created[@"id"] }];
+    XCTAssertTrue([diff[@"diff"] containsString:@"+two"], @"%@", diff[@"diff"]);
+
+    // Later work does not change what was captured.
+    [@"three\n" writeToFile:file atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    diff = [_scheduler responseForRequest:@{ @"op": @"notification_diff", @"id": created[@"id"] }];
+    XCTAssertFalse([diff[@"diff"] containsString:@"+three"]);
+
+    NSString *diffsPath = [_temporaryPath stringByAppendingPathComponent:@"notification-diffs"];
+    NSString *diffFile = [diffsPath stringByAppendingPathComponent:[created[@"id"] stringByAppendingPathExtension:@"diff"]];
+    NSDictionary *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:diffFile error:nil];
+    XCTAssertEqual([attributes[NSFilePosixPermissions] integerValue], 0600);
+
+    [_scheduler responseForRequest:@{ @"op": @"notification_delete", @"id": created[@"id"] }];
+    XCTAssertFalse([[NSFileManager defaultManager] fileExistsAtPath:diffFile]);
+}
