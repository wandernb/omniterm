+//
+//  OmniMemoryTests.swift
+//  ModernTests
+//
+//  The Memory page against a fake scheduler: each tab asks for its data,
+//  Browse shows a memory's evidence, the graph opens a memory, the journal
+//  explains itself; and the graph layouts are deterministic.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniMemoryTests: XCTestCase {
+    private var requests: [[String: Any]] = []
+    private var window: NSWindow?
+    // Per-op answers a test sets, ahead of the fixed fake scheduler below.
+    private var responders: [String: ([String: Any]) -> [AnyHashable: Any]] = [:]
+
+    private static let memories: [[String: Any]] = [
+        ["id": "m1", "title": "Sign native builds", "body": "Sign and verify.", "memory_type": "procedural",
+         "weight": 7.5, "effective_weight": 7.4, "evidence_count": 2, "tags": ["build"], "revision": 2,
+         "workspaces": ["/work/omni"], "pinned": false, "expiry_candidate": false],
+        ["id": "m2", "title": "Prefers terse reports", "body": "Short answers.", "memory_type": "autobiographical",
+         "weight": 8, "effective_weight": 0.3, "evidence_count": 1, "tags": [], "revision": 1,
+         "workspaces": [], "pinned": false, "expiry_candidate": true],
+    ]
+
+    override func setUp() {
+        super.setUp()
+        requests = []
+        responders = [:]
+        OmniSchedulerClient.testTransport = { [unowned self] request, completion in
+            self.requests.append(request)
+            var response: [AnyHashable: Any]
+            switch request["op"] as? String {
+            case "memory_overview":
+                response = ["ok": true, "overview": [
+                    "memories": 2, "expiry_candidates": 1, "expiry_threshold": 0.5,
+                    "events_24h": ["memory_created": 1],
+                    "pipeline": ["messages": 1200, "sessions": 9, "vectors": 800, "candidates_pending": 14,
+                                 "candidates_considered": 6, "candidates_cited": 2, "candidates_dismissed": 4,
+                                 "memories": 2, "expiry_candidates": 1, "scan_in_progress": true, "backlog_files": 3,
+                                 "mirrored_sessions": 40, "stale_native_sources": 2, "orphan_threads": 6]]]
+            case "list_memories":
+                response = ["ok": true, "memories": Self.memories, "total": 2]
+            case "get_memory":
+                var memory = Self.memories[0]
+                memory["evidence"] = [["session_id": "claude:s1", "message_id": "x", "role": "assistant",
+                                       "excerpt": "We sign every build", "session_title": "Release work",
+                                       "available": true]]
+                memory["revisions"] = [["revision": 2, "title": "Sign native builds", "body": "Sign and verify."]]
+                memory["events"] = [["id": "e1", "kind": "memory_revised", "at": Date().timeIntervalSince1970,
+                                     "title": "Sign native builds", "revision": 2]]
+                memory["related"] = [["source": "m1", "target": "m2", "kind": "tag", "strength": 0.5]]
+                response = ["ok": true, "memory": memory]
+            case "memory_events":
+                response = ["ok": true, "events": [
+                    ["id": "e2", "kind": "candidate_dismissed", "at": Date().timeIntervalSince1970,
+                     "reason": "Transient status", "message_ids": ["x"]],
+                    ["id": "e1", "kind": "memory_created", "at": Date().timeIntervalSince1970, "memory_id": "m1",
+                     "title": "Sign native builds", "memory_type": "procedural",
+                     "actor": ["run_id": "run-7", "agent": "Omni Memory"]]]]
+            case "memory_graph":
+                response = ["ok": true, "total_memories": 2, "truncated": false, "similarity_available": false,
+                            "nodes": [["id": "m1", "kind": "memory", "label": "Sign native builds",
+                                       "memory_type": "procedural", "effective_weight": 7.4],
+                                      ["id": "m2", "kind": "memory", "label": "Prefers terse reports",
+                                       "memory_type": "autobiographical", "effective_weight": 0.3,
+                                       "expiry_candidate": true]],
+                            "edges": [["source": "m1", "target": "m2", "kind": "tag", "strength": 0.5]],
+                            "mindmap": ["id": "root", "kind": "root", "label": "Memory", "children": [
+                                ["id": "type:procedural", "kind": "type", "label": "procedural", "children": [
+                                    ["id": "tag:procedural:build", "kind": "tag", "label": "build", "children": [
+                                        ["id": "m1", "kind": "memory", "label": "Sign native builds",
+                                         "memory_type": "procedural"]]]]]]]]
+            case "list_agents":
+                response = ["ok": true, "agents": [
+                    ["name": "Builder", "provider": "claude", "enabled": true],
+                    ["name": "Omni Memory", "provider": "codex", "model": "gpt-6-luna", "enabled": true,
+                     "omni_managed": "memory_consolidator:v1",
+                     "schedule": ["kind": "interval", "phrase": "every 15 minutes"],
+                     "next_run": Date().timeIntervalSince1970 + 600]]]
+            case "list_runs":
+                let started = Date().timeIntervalSince1970 - 900
+                response = ["ok": true, "runs": request["agent"] as? String == "Omni Memory" ? [
+                    ["id": "ingest-2", "agent": "Omni Memory", "state": "completed", "provider": "codex",
+                     "started": started + 600, "finished": started + 700, "origin": "scheduled",
+                     "final_message": "Examined 47 candidates and created 2 durable memories."],
+                    ["id": "ingest-1", "agent": "Omni Memory", "state": "completed", "provider": "codex",
+                     "started": started, "finished": started + 60, "origin": "scheduled",
+                     "summary": "No candidates were available."]] : []]
+            case "memory_digest":
+                response = ["ok": true, "digest": ["markdown": "# Memory digest — all workspaces\n",
+                                                   "generated_at": Date().timeIntervalSince1970, "bytes": 33,
+                                                   "stale": true]]
+            default:
+                response = ["ok": true]
+            }
+            if let op = request["op"] as? String, let responder = self.responders[op] {
+                response = responder(request)
+            }
+            DispatchQueue.main.async {
+                completion(response)
+            }
+        }
+    }
+
+    override func tearDown() {
+        OmniSchedulerClient.testTransport = nil
+        window?.orderOut(nil)
+        window = nil
+        super.tearDown()
+    }
+
+    // Generous: the first test in the class also waits out the app's launch.
+    private func wait(_ message: String, until condition: () -> Bool) {
+        let deadline = Date().addingTimeInterval(30)
+        while !condition() && Date() < deadline {
+            RunLoop.main.run(mode: .default, before: Date().addingTimeInterval(0.01))
+        }
+        XCTAssertTrue(condition(), message)
+    }
+
+    private func makePane() -> OmniMemoryPane {
+        let pane = OmniMemoryPane()
+        let window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 1100, height: 700), styleMask: [.titled],
+                              backing: .buffered, defer: false)
+        window.contentView = pane
+        pane.frame = window.contentView?.bounds ?? .zero
+        self.window = window
+        pane.reload()
+        return pane
+    }
+
+    private func ops() -> [String] {
+        return requests.compactMap { $0["op"] as? String }
+    }
+
+    func testBrowseListsMemoriesAndShowsEvidence() {
+        let pane = makePane()
+        let memory = pane.memory
+        wait("the list loads") { memory.memories.count == 2 }
+        XCTAssertEqual(memory.memories.map(\.id), ["m1", "m2"])
+        XCTAssertEqual(memory.memoryTable.numberOfRows, 2)
+        wait("the first memory's detail loads") { ops().contains("get_memory") }
+        XCTAssertEqual(requests.first { $0["op"] as? String == "get_memory" }?["id"] as? String, "m1")
+        XCTAssertTrue(memory.memories[1].expiring)
+        XCTAssertTrue(memory.memories[1].detailLine.contains("fading"))
+        XCTAssertEqual(pane.focusZones.count, 2)
