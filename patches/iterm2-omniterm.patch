+    @objc private func doubleClicked(_ sender: Any?) {
+        let row = outlineView.clickedRow >= 0 ? outlineView.clickedRow : outlineView.selectedRow
+        let event = NSApp.currentEvent
+        let point = event.flatMap { event -> NSPoint? in
+            guard event.type == .leftMouseDown || event.type == .leftMouseUp,
+                  event.windowNumber == outlineView.window?.windowNumber else { return nil }
+            return outlineView.convert(event.locationInWindow, from: nil)
+        }
+        handleDoubleClick(row: row, at: point)
+    }
+
+    // A double-click on an agent's icon opens its icon and colour picker;
+    // anywhere else on an agent or group row renames it in place.
+    func handleDoubleClick(row: Int, at point: NSPoint?) {
+        guard let item = outlineView.item(atRow: row) as? OmniSidebarItem,
+              item.kind == .agent || item.isFolder || item.kind == .project || item.kind == .session else { return }
+        if Self.takesAppearance(item), let point,
+           let cell = outlineView.view(atColumn: 0, row: row, makeIfNecessary: false) as? OmniSidebarCell,
+           let icon = cell.iconFrame, cell.convert(icon, to: outlineView).insetBy(dx: -3, dy: -3).contains(point) {
+            showAppearancePicker(for: item, anchor: cell.convert(icon, to: outlineView))
+            return
+        }
+        beginEditing(item, fromKeyboard: false)
+    }
+
+    // The picker last shown, for tests; the popover owns it.
+    private(set) var appearancePopover: NSPopover?
+
+    // Agents, agent folders, projects and project folders share one picker.
+    private func showAppearancePicker(for row: OmniSidebarItem, anchor: NSRect) {
+        let name = row.title
+        let kind = row.kind
+        let path = row.groupPath
+        let root = Self.projectRoot(row)
+        appearancePopover = OmniAppearancePicker.show(icon: row.icon, color: row.iconColor, relativeTo: anchor,
+                                                      of: outlineView) { [weak self] icon, color in
+            guard let self else { return }
+            switch kind {
+            case .agent:
+                self.setAppearance(of: name, ["icon": icon, "color": color])
+            case .group:
+                var icons = self.agentFolderIcons
+                var colors = self.agentFolderColors
+                icons[path] = icon
+                colors[path] = color
+                self.saveAgentFolderAppearance(icons: icons, colors: colors)
+            case .project, .projectFolder:
+                guard let key = kind == .project ? root : OmniProjectLayout.folderKey(path) else { return }
+                var layout = self.projectLayout
+                layout.setAppearance(key, icon: icon, color: color)
+                self.saveProjectLayout(layout)
+            default:
+                break
+            }
+        }
+    }
+
+    private static func takesAppearance(_ row: OmniSidebarItem) -> Bool {
+        return row.kind == .agent || row.kind == .group || row.kind == .project || row.kind == .projectFolder
+    }
+
+    private func beginEditing(_ item: OmniSidebarItem, fromKeyboard: Bool) {
+        let row = outlineView.row(forItem: item)
+        guard row >= 0, editing == nil,
+              let cell = outlineView.view(atColumn: 0, row: row, makeIfNecessary: true) as? OmniSidebarCell else { return }
+        editingFromKeyboard = fromKeyboard
+        outlineView.scrollRowToVisible(row)
+        let field = cell.titleField
+        field.isEditable = true
+        field.isSelectable = true
+        field.isBezeled = false
+        field.drawsBackground = true
+        field.backgroundColor = .textBackgroundColor
+        field.delegate = self
+        editing = (item, field, false)
+        view.window?.makeFirstResponder(field)
+        field.currentEditor()?.selectAll(nil)
+    }
+
+    private func beginPendingEdit() {
+        guard let key = pendingEditKey, let row = itemCache[key] else { return }
+        pendingEditKey = nil
+        let fromKeyboard = pendingEditFromKeyboard
+        pendingEditFromKeyboard = false
+        DispatchQueue.main.async { [weak self] in
+            self?.beginEditing(row, fromKeyboard: fromKeyboard)
+        }
+    }
+
+    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+        if control === sessionSearchField {
+            if commandSelector == #selector(NSResponder.insertNewline(_:)), !sessionQuery.isEmpty {
+                showPane(.search(sessionQuery))
+                return true
+            }
+            if commandSelector == #selector(NSResponder.moveDown(_:)) {
+                focusSidebar()
+                return true
+            }
+            return false
+        }
+        guard let editing, control === editing.field else { return false }
+        if commandSelector == #selector(NSResponder.cancelOperation(_:)) {
+            self.editing?.cancelled = true
+            view.window?.makeFirstResponder(nil)
+            return true
+        }
+        return false
+    }
+
+    // Return or a click elsewhere saves; Escape cancels.
+    func controlTextDidEndEditing(_ notification: Notification) {
+        guard let editing, (notification.object as? NSTextField) === editing.field else { return }
+        self.editing = nil
+        let field = editing.field
+        field.isEditable = false
+        // A selectable title keeps the text cursor over a clickable row.
+        field.isSelectable = false
+        field.drawsBackground = false
+        field.delegate = nil
+        let row = editing.row
+        let newName = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        field.stringValue = row.title
+        if editingFromKeyboard {
+            editingFromKeyboard = false
+            // Not while the field editor is still resigning.
+            DispatchQueue.main.async { [weak self] in
+                self?.focusSidebar()
+            }
+        }
+        guard !editing.cancelled, newName != row.title else {
+            finishInteraction()
+            return
+        }
+        switch row.kind {
+        case .agent:
+            renameAgent(row, to: newName)
+        case .project:
+            renameProject(row, to: newName)
+        case .projectFolder:
+            renameProjectFolder(row, to: newName)
+        case .sessionFolder:
+            renameSessionFolder(row, to: newName)
+        case .session:
+            renameSessionInPlace(row, to: newName)
+        default:
+            renameGroup(row, to: newName)
+        }
+    }
+
+    private func finishInteraction() {
+        if reloadDeferred {
+            rebuild()
+        }
+    }
+
+    private func renameAgent(_ row: OmniSidebarItem, to newName: String) {
+        let names = agents.compactMap { $0["name"] as? String }
+        if let problem = OmniRenameRules.agentNameProblem(newName, current: row.title, existing: names) {
+            showRenameProblem(problem, on: row)
+            return
+        }
+        let oldName = row.title
+        // Show the new name at once; a refusal puts the old one back.
+        row.title = newName
+        outlineView.reloadItem(row)
+        OmniSchedulerClient.request(["op": "rename_agent", "name": oldName, "new_name": newName]) { [weak self] response in
+            guard let self else { return }
+            guard response["ok"] as? Bool == true else {
+                row.title = oldName
+                self.outlineView.reloadItem(row)
+                let message: String
+                switch response["code"] as? String {
+                case "agent_exists": message = "Another agent already has this name."
+                case "invalid_name": message = response["error"] as? String ?? "That name cannot be used."
+                case "agent_not_found": message = "This agent no longer exists."
+                default: message = response["error"] as? String ?? "The agent could not be renamed."
+                }
+                self.showRenameProblem(message, on: row)
+                return
+            }
+            if self.contentHost.route == .agent(oldName) {
+                self.contentHost.hide()
+                self.showPane(.agent(newName))
+            }
+            self.requestSchedulerState()
+            self.finishInteraction()
+        }
+    }
+
+    private func siblingGroupNames(of path: String) -> [String] {
+        let parent = OmniGroupTree.parent(of: path)
+        return groupTree.allPaths.filter { $0 != path && OmniGroupTree.parent(of: $0) == parent }
+            .map { $0.components(separatedBy: "/").last ?? $0 }
+    }
+
+    private func renameGroup(_ row: OmniSidebarItem, to newName: String) {
+        let path = row.groupPath
+        if let problem = OmniRenameRules.groupNameProblem(newName, siblings: siblingGroupNames(of: path)) {
+            showRenameProblem(problem, on: row)
+            return
+        }
+        let parent = OmniGroupTree.parent(of: path)
+        let newPath = parent.isEmpty ? newName : "\(parent)/\(newName)"
+        moveGroup(path, to: newPath)
+    }
+
+    // Renames or (with `to` the parent or "") dissolves a group. The
+    // scheduler moves its agents and subgroups and rewrites sidebar_groups.
+    private func moveGroup(_ path: String, to newPath: String) {
+        OmniSchedulerClient.request(["op": "rename_group", "from": path, "to": newPath]) { [weak self] response in
+            guard let self else { return }
+            if response["ok"] as? Bool == true {
+                self.moveAgentFolderAppearance(from: path, to: newPath)
+            }
+            if response["ok"] as? Bool != true, let row = self.itemCache["group|\(path)"] {
+                self.showRenameProblem(Self.problem(response, fallback: "The folder could not be changed."), on: row)
+            } else if response["ok"] as? Bool == true, case .group(let shown) = self.contentHost.route,
+                      shown == path || shown.hasPrefix(path + "/") {
+                // The folder page follows its folder; a deleted one gives way
+                // to where its contents went.
+                let dissolved = newPath == OmniGroupTree.parent(of: path)
+                let next = dissolved ? newPath : newPath + shown.dropFirst(path.count)
+                self.contentHost.hide()
+                self.showPane(next.isEmpty ? .overview : .group(next))
+            }
+            self.requestSchedulerState()
+            self.finishInteraction()
+        }
+    }
+
+    private func saveGroups(_ groups: [String]) {
+        var unique: [String] = []
+        for group in groups where !group.isEmpty && !unique.contains(group) {
+            unique.append(group)
+        }
+        OmniSchedulerClient.request(["op": "set_sidebar_groups", "groups": unique]) { [weak self] response in
+            guard let self else { return }
+            if response["ok"] as? Bool == true {
+                self.configuredGroups = unique
+            }
+            self.requestSchedulerState()
+            self.finishInteraction()
+        }
+    }
+
+    // The scheduler's reason, plain text, for a refused change.
+    static func problem(_ response: [AnyHashable: Any], fallback: String) -> String {
+        guard let error = response["error"] as? String, !error.isEmpty else { return fallback }
+        return OmniReportText.firstLine(error, limit: 120) ?? fallback
+    }
+
+    // A short shake and the reason under the name, then the row as it was.
+    private func showRenameProblem(_ message: String, on row: OmniSidebarItem) {
+        let index = outlineView.row(forItem: row)
+        if index >= 0, let cell = outlineView.view(atColumn: 0, row: index, makeIfNecessary: false) as? OmniSidebarCell {
+            cell.showProblem(message)
+        }
+        finishInteraction()
+    }
