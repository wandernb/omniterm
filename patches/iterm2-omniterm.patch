+        let nodes = (0..<30).map { OmniMemoryGraphNode(id: "n\($0)", label: "N\($0)") }
+        let edges = (1..<30).map { OmniMemoryGraphEdge(source: "n\($0 / 2)", target: "n\($0)", kind: "tag") }
+        let cold = OmniMemoryGraphLayout.network(nodes: nodes, edges: edges)
+        let grown = nodes + [OmniMemoryGraphNode(id: "new", label: "New")]
+        let warm = OmniMemoryGraphLayout.network(nodes: grown, edges: edges + [OmniMemoryGraphEdge(source: "n7", target: "new", kind: "tag")],
+                                                 previous: cold)
+        XCTAssertTrue(OmniMemoryGraphLayout.isWarm(grown, previous: cold))
+        let k = (Double(grown.count) * 9000 / Double(grown.count)).squareRoot()
+        for node in nodes {
+            XCTAssertEqual(warm[node.id]!.x, cold[node.id]!.x, accuracy: k * 0.3, node.id)
+            XCTAssertEqual(warm[node.id]!.y, cold[node.id]!.y, accuracy: k * 0.3, node.id)
+        }
+        XCTAssertLessThan(hypot(warm["new"]!.x - warm["n7"]!.x, warm["new"]!.y - warm["n7"]!.y), CGFloat(k * 3))
+        XCTAssertEqual(warm, OmniMemoryGraphLayout.network(nodes: grown, edges: edges + [OmniMemoryGraphEdge(source: "n7", target: "new", kind: "tag")],
+                                                           previous: cold), "A warm layout is deterministic too")
+        XCTAssertFalse(OmniMemoryGraphLayout.isWarm(grown, previous: ["n0": .zero]), "Under half known is a cold layout")
+    }
