+private final class OmniSidebarCell: NSTableCellView {
+    private let title = NSTextField(labelWithString: "")
+    private let detail = NSTextField(labelWithString: "")
+    // A run's outcome; the detail text spells it out, the dot only reinforces it.
+    private let dot = NSView()
+    // Agents and groups: their icon (a tinted symbol or an emoji).
+    private let iconView = NSImageView()
+    private let emojiLabel = NSTextField(labelWithString: "")
+    // Rows with an icon show their status dot at the trailing edge.
+    private var dotTrailing = false
+    private var problemWork: DispatchWorkItem?
+    private var shownDetail = ""
+    let badge = OmniSidebarBadge()
+
+    // Dashboard and Inbox: one line, a 15 pt icon in a 20 pt slot and a
+    // medium title.
+    var isTopRow = false {
+        didSet {
+            title.font = isTopRow ? OmniTheme.Sidebar.topTitleFont : OmniTheme.Font.rowTitle
+            title.textColor = isTopRow ? OmniTheme.Sidebar.topTitleColor : .labelColor
+            iconView.symbolConfiguration = isTopRow ? OmniTheme.Sidebar.topIcon
+                : NSImage.SymbolConfiguration(pointSize: 13, weight: .regular)
+            updateTopRowTint()
+            resizeSubviews(withOldSize: bounds.size)
+        }
+    }
+
+    // A trailing count as a capsule; empty hides it.
+    func setCount(_ count: String, needsAttention: Bool) {
+        badge.text = count
+        badge.needsAttention = needsAttention
+        badge.isHidden = count.isEmpty
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    // The selected row draws its icon and badge in the selected-content colours.
+    override var backgroundStyle: NSView.BackgroundStyle {
+        didSet {
+            badge.isOnSelection = backgroundStyle == .emphasized
+            updateTopRowTint()
+        }
+    }
+
+    private func updateTopRowTint() {
+        guard isTopRow else { return }
+        iconView.contentTintColor = backgroundStyle == .emphasized ? OmniTheme.Sidebar.selectedIconTint
+            : OmniTheme.Sidebar.iconTint
+    }
+
+    var titleField: NSTextField {
+        return title
+    }
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 220, height: 38))
+        wantsLayer = true
+        title.font = OmniTheme.Font.rowTitle
+        title.lineBreakMode = .byTruncatingTail
+        title.cell?.isScrollable = false
+        addSubview(title)
+        textField = title
+        detail.font = OmniTheme.Font.rowDetail
+        detail.textColor = OmniTheme.secondaryText
+        detail.lineBreakMode = .byTruncatingTail
+        addSubview(detail)
+        dot.wantsLayer = true
+        dot.layer?.cornerRadius = 3
+        addSubview(dot)
+        iconView.imageScaling = .scaleProportionallyUpOrDown
+        iconView.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 13, weight: .regular)
+        addSubview(iconView)
+        emojiLabel.font = OmniTheme.Font.emoji(14)
+        emojiLabel.alignment = .center
+        addSubview(emojiLabel)
+        badge.isHidden = true
+        addSubview(badge)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    // Runs and terminals: a leading status dot.
+    func configure(title: String, detail: String, color: NSColor?, pulses: Bool) {
+        iconView.isHidden = true
+        emojiLabel.isHidden = true
+        dotTrailing = false
+        apply(title: title, detail: detail, status: color, pulses: pulses)
+    }
+
+    // Agents and groups: a leading icon, the status dot trailing.
+    func configure(title: String, detail: String, icon: OmniAgentIcon, iconColor: NSColor?, status: NSColor?, pulses: Bool) {
+        dotTrailing = true
+        switch icon {
+        case .symbol(let name):
+            iconView.image = OmniIconImage.image(name) ??
+                NSImage(systemSymbolName: OmniAgentIcon.defaultSymbol, accessibilityDescription: nil)
+            iconView.contentTintColor = iconColor ?? OmniTheme.secondaryText
+            iconView.isHidden = false
+            emojiLabel.isHidden = true
+        case .emoji(let emoji):
+            emojiLabel.stringValue = emoji
+            emojiLabel.isHidden = false
+            iconView.isHidden = true
+        }
+        apply(title: title, detail: detail, status: status, pulses: pulses)
+    }
+
+    private func apply(title: String, detail: String, status: NSColor?, pulses: Bool) {
+        problemWork?.cancel()
+        problemWork = nil
+        self.title.stringValue = title
+        shownDetail = detail
+        self.detail.stringValue = detail
+        self.detail.textColor = OmniTheme.secondaryText
+        self.detail.isHidden = detail.isEmpty
+        dot.isHidden = status == nil
+        // Muted: the subline already says the state in words.
+        dot.layer?.backgroundColor = (dotTrailing ? status.map(OmniTheme.mutedStatus) : status)?.cgColor
+        // A subtle glow while the agent works.
+        if pulses, dot.layer?.animation(forKey: "pulse") == nil {
+            let animation = CABasicAnimation(keyPath: "opacity")
+            animation.fromValue = 1
+            animation.toValue = 0.35
+            animation.duration = 0.9
+            animation.autoreverses = true
+            animation.repeatCount = .infinity
+            animation.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
+            dot.layer?.add(animation, forKey: "pulse")
+        } else if !pulses {
+            dot.layer?.removeAnimation(forKey: "pulse")
+        }
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    // A refused rename: a short shake and the reason in red for a moment.
+    func showProblem(_ message: String) {
+        detail.stringValue = message
+        detail.textColor = OmniTheme.failed
+        detail.isHidden = false
+        resizeSubviews(withOldSize: bounds.size)
+        let shake = CAKeyframeAnimation(keyPath: "transform.translation.x")
+        shake.values = [0, -6, 6, -4, 4, -2, 0]
+        shake.duration = 0.35
+        layer?.add(shake, forKey: "shake")
+        NSAccessibility.post(element: self, notification: .announcementRequested,
+                             userInfo: [.announcement: message, .priority: NSAccessibilityPriorityLevel.high.rawValue])
+        let work = DispatchWorkItem { [weak self] in
+            guard let self else { return }
+            self.detail.stringValue = self.shownDetail
+            self.detail.textColor = OmniTheme.secondaryText
+            self.detail.isHidden = self.shownDetail.isEmpty
+            self.resizeSubviews(withOldSize: self.bounds.size)
+        }
+        problemWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 2.5, execute: work)
+    }
+
+    // Where the icon is, for a double-click on it.
+    var iconFrame: NSRect? {
+        if !iconView.isHidden { return iconView.frame }
+        if !emojiLabel.isHidden { return emojiLabel.frame }
+        return nil
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let hasIcon = !iconView.isHidden || !emojiLabel.isHidden
+        let leadingDot = !dot.isHidden && !dotTrailing
+        let x: CGFloat = hasIcon ? 24 : (leadingDot ? 14 : 2)
+        // A trailing dot follows the subline's text, so leave it room.
+        let dotRoom: CGFloat = (!dot.isHidden && dotTrailing) ? 12 : 0
+        let countWidth: CGFloat = badge.isHidden ? 0 : badge.fittingWidth + 8
+        let width = max(0, bounds.width - x - 4 - countWidth)
+        // Cell views are not flipped: y grows upwards.
+        let titleY = detail.isHidden ? (bounds.height - 17) / 2 : bounds.height - 21
+        title.frame = NSRect(x: x, y: titleY, width: detail.isHidden ? max(0, width - dotRoom) : width, height: 17)
+        detail.frame = NSRect(x: x, y: 4, width: max(0, width - dotRoom), height: 14)
+        let iconY = titleY + 0.5
+        if isTopRow {
+            let slot = OmniTheme.Sidebar.iconSlot
+            iconView.frame = NSRect(x: 12 - slot / 2, y: (bounds.height - slot) / 2, width: slot, height: slot)
+        } else {
+            iconView.frame = NSRect(x: 2, y: iconY, width: 16, height: 16)
+        }
+        emojiLabel.frame = NSRect(x: 0, y: iconY - 1, width: 20, height: 18)
+        let badgeHeight = OmniTheme.Sidebar.Badge.height
+        badge.frame = NSRect(x: bounds.width - badge.fittingWidth - 4, y: title.frame.midY - badgeHeight / 2,
+                             width: badge.fittingWidth, height: badgeHeight)
+        if dotTrailing {
+            let line = detail.isHidden ? title : detail
+            let textWidth = min(ceil(line.attributedStringValue.size().width), line.frame.width)
+            dot.frame = NSRect(x: line.frame.minX + textWidth + 5, y: line.frame.midY - 3, width: 6, height: 6)
+        } else {
+            dot.frame = NSRect(x: 2, y: titleY + 5, width: 6, height: 6)
+        }
+    }
+}
