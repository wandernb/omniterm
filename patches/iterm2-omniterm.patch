+
+    private func loadEvents() {
+        request("events", ["op": "memory_events", "limit": 200]) { [weak self] response in
+            guard let self, OmniPane.isOK(response) else { return }
+            let loaded = response["events"] as? [[AnyHashable: Any]] ?? []
+            let ids = loaded.compactMap { $0["id"] as? String }
+            guard ids != self.events.compactMap({ $0["id"] as? String }) else { return }
+            self.events = loaded
+            self.eventsTable.reloadData()
+            self.updateRecentlyTouched()
+            if let selected = self.selectedEvent?["id"] as? String, let row = ids.firstIndex(of: selected) {
+                self.eventsTable.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+            } else if !loaded.isEmpty {
+                self.eventsTable.selectRowIndexes(IndexSet(integer: 0), byExtendingSelection: false)
+            } else {
+                self.showPlaceholder("Nothing has happened yet. Consolidation, revisions, dismissals and ingestion snapshots appear here.",
+                                     in: self.eventText)
+                self.updateEventButtons()
+            }
+        }
+    }
+
+    // The graph's process overlay: what consolidation touched in the last ten minutes.
+    private func updateRecentlyTouched() {
+        let cutoff = Date().timeIntervalSince1970 - 600
+        var touched = Set<String>()
+        for event in events {
+            guard let at = (event["at"] as? NSNumber)?.doubleValue, at >= cutoff else { continue }
+            if let id = event["memory_id"] as? String { touched.insert(id) }
+        }
+        canvas.recentlyTouched = touched
+    }
