+// The canvas. Coordinates: layout space is centred on the origin; the view
+// maps it with `scale` and `offset`. Drag pans, the scroll wheel pans,
+// Command-scroll and pinch zoom, a click selects, a double-click opens.
+final class OmniMemoryGraphView: NSView {
+    private(set) var nodes: [OmniMemoryGraphNode] = []
+    private(set) var edges: [OmniMemoryGraphEdge] = []
+    private(set) var positions: [String: CGPoint] = [:]
+    private(set) var selectedID: String?
+    private(set) var hoveredID: String?
+    var highlightQuery = "" {
+        didSet { invalidateEdgeCache() }
+    }
+    // Memories touched by recent consolidation events: the process overlay.
+    var recentlyTouched: Set<String> = [] {
+        didSet { needsDisplay = true }
+    }
+    var hiddenEdgeKinds: Set<String> = [] {
+        didSet { invalidateEdgeCache() }
+    }
+    // The focused memory of an ego network: drawn larger, its neighbours labelled.
+    var focusID: String? {
+        didSet {
+            updateNeighbours()
+            invalidateEdgeCache()
+        }
+    }
+    // Community regions are drawn in the overview only.
+    var showsCommunityRegions = false {
+        didSet { needsDisplay = true }
+    }
+    var selectionDidChange: ((String?) -> Void)?
+    var openNode: ((String) -> Void)?
+    // A double-click on a node that was not already selected: returns true
+    // when it expanded the node instead of opening it.
+    var expandNode: ((String) -> Bool)?
+    // A click on a mind-map branch with children opens or closes it.
+    var toggleNode: ((String) -> Void)?
+    var keyHandler: ((NSEvent) -> Bool)?
+
+    private(set) var scale: CGFloat = 1
+    private(set) var offset = CGPoint.zero
+    private var dragOrigin: CGPoint?
+    private var dragged = false
+    private var selectedAtMouseDown: String?
+
+    private var nodeIndex: [String: Int] = [:]
+    private var focusNeighbours: Set<String> = []
+    private var tagGroups: [String: Int] = [:]
+    // Communities shown as regions, and the memberships last rendered.
+    private(set) var regionCommunities: [(id: String, label: String, members: [String])] = []
+    private var lastCommunityMembers: [String: Set<String>]?
+
+    // The edge layer: the visible edges stroked once into a bitmap covering
+    // a margin around the viewport, blitted while panning and zooming nearby.
+    private struct EdgeCacheKey: Equatable {
+        let generation: Int
+        let lowZoom: Bool
+        let hidden: Set<String>
+        let searching: Bool
+    }
+    private var edgeCache: (key: EdgeCacheKey, image: NSImage, area: CGRect, scale: CGFloat)?
+    private var layoutGeneration = 0
+    private(set) var edgeCacheBuilds = 0
+    private var hoverArea: NSTrackingArea?
+
+    override var isFlipped: Bool { true }
+    override var acceptsFirstResponder: Bool { true }
+
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        // Labels and the background must never paint over the toolbar.
+        if #available(macOS 14, *) {
+            clipsToBounds = true
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    func setGraph(nodes: [OmniMemoryGraphNode], edges: [OmniMemoryGraphEdge], positions: [String: CGPoint],
+                  fit: Bool) {
+        self.nodes = nodes
+        self.edges = edges
+        self.positions = positions
+        nodeIndex = Dictionary(nodes.enumerated().map { ($1.id, $0) }, uniquingKeysWith: { first, _ in first })
+        tagGroups = OmniMemoryGraphLayout.tagGroupSizes(edges)
+        if let selectedID, nodeIndex[selectedID] == nil {
+            self.selectedID = nil
+        }
+        if let hoveredID, nodeIndex[hoveredID] == nil {
+            self.hoveredID = nil
+        }
+        updateNeighbours()
+        updateRegions()
+        layoutGeneration += 1
+        invalidateEdgeCache()
+        if fit {
+            fitToView()
+        }
+        setAccessibilityLabel("Memory graph, \(nodes.count) nodes, \(edges.count) links")
+    }
+
+    private func updateNeighbours() {
+        guard let focusID else {
+            focusNeighbours = []
+            return
+        }
+        var found = Set<String>()
+        for edge in edges {
+            if edge.source == focusID { found.insert(edge.target) }
+            if edge.target == focusID { found.insert(edge.source) }
+        }
+        focusNeighbours = found
+    }
+
+    // A refresh that changed nothing still counts as a render for the
+    // stability guard: a community first seen last time is drawn now.
+    func refreshRegions() {
+        guard showsCommunityRegions else { return }
+        let before = regionCommunities.map { $0.id }
+        updateRegions()
+        if regionCommunities.map({ $0.id }) != before {
+            needsDisplay = true
+        }
+    }
+
+    private func updateRegions() {
+        guard showsCommunityRegions else {
+            regionCommunities = []
+            return
+        }
+        var members: [String: Set<String>] = [:]
+        var labels: [String: String] = [:]
+        for node in nodes where node.kind == "memory" {
+            guard let community = node.communityID else { continue }
+            members[community, default: []].insert(node.id)
+            labels[community] = node.communityLabel ?? ""
+        }
+        let shown = OmniMemoryGraphLayout.stableCommunities(members, previous: lastCommunityMembers)
+        lastCommunityMembers = members
+        regionCommunities = shown.sorted().map { (id: $0, label: labels[$0] ?? "", members: members[$0]?.sorted() ?? []) }
+    }
+
+    func select(_ id: String?, notify: Bool = true) {
+        guard id != selectedID else { return }
+        selectedID = id
+        needsDisplay = true
+        if notify {
+            selectionDidChange?(id)
+        }
+    }
+
+    func fitToView() {
+        let points = Array(positions.values)
+        guard !points.isEmpty, bounds.width > 0, bounds.height > 0 else {
+            scale = 1
+            offset = .zero
+            return
+        }
+        let minX = points.map(\.x).min() ?? 0, maxX = points.map(\.x).max() ?? 0
+        let minY = points.map(\.y).min() ?? 0, maxY = points.map(\.y).max() ?? 0
+        let width = max(1, maxX - minX), height = max(1, maxY - minY)
+        scale = max(0.15, min(2.5, min((bounds.width - 120) / width, (bounds.height - 80) / height)))
+        offset = CGPoint(x: -(minX + maxX) / 2, y: -(minY + maxY) / 2)
+        needsDisplay = true
+    }
+
+    // Centres the view on a node without changing the zoom.
+    func center(on id: String) {
+        guard let position = positions[id] else { return }
+        offset = CGPoint(x: -position.x, y: -position.y)
+        needsDisplay = true
+    }
+
+    func viewPoint(_ point: CGPoint) -> CGPoint {
+        return CGPoint(x: bounds.midX + (point.x + offset.x) * scale, y: bounds.midY + (point.y + offset.y) * scale)
+    }
+
+    func radius(_ node: OmniMemoryGraphNode) -> CGFloat {
+        switch node.kind {
+        case "root": return 22
+        case "type": return 16
+        case "tag", "topic": return 9
+        case "topics": return 16
+        case "workspace": return 11
+        case "concept": return 8
+        default:
+            let base = 4 + CGFloat(max(0, min(10, node.weight))) * 1.1
+            guard let focusID else { return base }
+            if node.id == focusID { return base * 1.6 }
+            return focusNeighbours.contains(node.id) ? base : base * 0.7
+        }
+    }
+
+    // Hubs are told apart by shape as well as colour: a workspace is a rounded
+    // square, a concept a diamond, everything else a circle.
+    static func shape(for kind: String, in rect: NSRect) -> NSBezierPath {
+        switch kind {
+        case "workspace":
+            return NSBezierPath(roundedRect: rect, xRadius: 3, yRadius: 3)
+        case "concept":
+            let path = NSBezierPath()
+            path.move(to: NSPoint(x: rect.midX, y: rect.minY))
+            path.line(to: NSPoint(x: rect.maxX, y: rect.midY))
+            path.line(to: NSPoint(x: rect.midX, y: rect.maxY))
+            path.line(to: NSPoint(x: rect.minX, y: rect.midY))
+            path.close()
+            return path
+        default:
+            return NSBezierPath(ovalIn: rect)
+        }
+    }
+
+    func node(at point: CGPoint) -> OmniMemoryGraphNode? {
+        var best: (OmniMemoryGraphNode, CGFloat)?
+        for node in nodes {
+            guard let position = positions[node.id] else { continue }
+            let center = viewPoint(position)
+            let distance = hypot(center.x - point.x, center.y - point.y)
+            if distance <= radius(node) * max(1, scale) + 4, best == nil || distance < best!.1 {
+                best = (node, distance)
+            }
+        }
+        return best?.0
+    }
+
+    private func matches(_ node: OmniMemoryGraphNode) -> Bool {
+        let query = highlightQuery.trimmingCharacters(in: .whitespaces)
+        return !query.isEmpty && node.label.localizedCaseInsensitiveContains(query)
+    }
+
+    // MARK: - Drawing
+
+    private var emphasised: Set<String> {
+        return Set([selectedID, hoveredID].compactMap { $0 })
+    }
+
+    // The edges drawn at the current zoom, emphasised ones included.
+    func visibleEdges() -> [OmniMemoryGraphEdge] {
+        let emphasised = self.emphasised
+        return edges.filter { edge in
+            !hiddenEdgeKinds.contains(edge.kind) &&
+                OmniMemoryGraphLayout.edgeVisible(edge, scale: scale, tagGroupSize: tagGroups[edge.label ?? ""] ?? 0,
+                                                  emphasised: emphasised)
+        }
+    }
+
+    private func invalidateEdgeCache() {
+        edgeCache = nil
+        needsDisplay = true
+    }
+
+    private func strokeEdge(_ edge: OmniMemoryGraphEdge, from start: CGPoint, to end: CGPoint, emphasised: Bool,
+                            searching: Bool, lineScale: CGFloat) {
+        let path = NSBezierPath()
+        path.move(to: start)
+        if edge.kind == "tree" {
+            let mid = CGPoint(x: (start.x + end.x) / 2, y: (start.y + end.y) / 2)
+            path.curve(to: end, controlPoint1: CGPoint(x: mid.x, y: start.y), controlPoint2: CGPoint(x: mid.x, y: end.y))
+        } else {
+            path.line(to: end)
+        }
+        path.lineWidth = (emphasised ? 2 : CGFloat(0.6 + edge.strength)) * lineScale
+        // Similarity is told apart by a lighter stroke: dashes cost too much.
+        var alpha: CGFloat = emphasised ? 0.95 : (searching ? 0.15 : 0.45)
+        if edge.kind == "similarity" && !emphasised {
+            alpha *= 0.6
+        }
+        OmniTheme.memoryEdgeColor(edge.kind).withAlphaComponent(alpha).setStroke()
+        path.stroke()
+    }
+
+    // The layout-space rectangle the view shows.
+    private func visibleLayoutRect() -> CGRect {
+        let topLeft = layoutPoint(CGPoint(x: bounds.minX, y: bounds.minY))
+        return CGRect(x: topLeft.x, y: topLeft.y, width: bounds.width / scale, height: bounds.height / scale)
+    }
+
+    private func edgeCacheImage(key: EdgeCacheKey, searching: Bool) -> (NSImage, CGRect)? {
+        let visible = visibleLayoutRect()
+        if let cache = edgeCache, cache.key == key, cache.area.contains(visible),
+           scale / cache.scale > 0.75, scale / cache.scale < 1.33 {
+            return (cache.image, cache.area)
+        }
+        // A margin of half a viewport on each side absorbs small pans.
+        let area = visible.insetBy(dx: -visible.width / 2, dy: -visible.height / 2)
+        let backing = window?.backingScaleFactor ?? 2
+        let pixelWidth = Int((area.width * scale * backing).rounded(.up))
+        let pixelHeight = Int((area.height * scale * backing).rounded(.up))
+        guard pixelWidth > 0, pixelHeight > 0, pixelWidth <= 8192, pixelHeight <= 8192,
+              let context = CGContext(data: nil, width: pixelWidth, height: pixelHeight, bitsPerComponent: 8,
+                                      bytesPerRow: 0, space: CGColorSpace(name: CGColorSpace.sRGB)!,
+                                      bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else { return nil }
+        edgeCacheBuilds += 1
+        // Flipped, in points, with the area's top-left at the origin.
+        context.translateBy(x: 0, y: CGFloat(pixelHeight))
+        context.scaleBy(x: backing, y: -backing)
+        let graphics = NSGraphicsContext(cgContext: context, flipped: true)
+        NSGraphicsContext.saveGraphicsState()
+        NSGraphicsContext.current = graphics
+        func cachePoint(_ point: CGPoint) -> CGPoint {
+            return CGPoint(x: (point.x - area.minX) * scale, y: (point.y - area.minY) * scale)
+        }
+        // Every edge the zoom shows, whatever is selected: the selected and
+        // hovered nodes' edges are drawn live on top, so selection never
+        // rebuilds the layer.
+        for edge in edges where !hiddenEdgeKinds.contains(edge.kind) &&
+            OmniMemoryGraphLayout.edgeVisible(edge, scale: scale, tagGroupSize: tagGroups[edge.label ?? ""] ?? 0,
+                                              emphasised: []) {
+            guard let a = positions[edge.source], let b = positions[edge.target] else { continue }
+            guard CGRect(x: min(a.x, b.x), y: min(a.y, b.y), width: abs(a.x - b.x), height: abs(a.y - b.y))
+                .insetBy(dx: -1, dy: -1).intersects(area) else { continue }
+            strokeEdge(edge, from: cachePoint(a), to: cachePoint(b), emphasised: false, searching: searching, lineScale: 1)
+        }
+        NSGraphicsContext.restoreGraphicsState()
+        guard let image = context.makeImage() else { return nil }
+        let picture = NSImage(cgImage: image, size: NSSize(width: area.width * scale, height: area.height * scale))
+        edgeCache = (key, picture, area, scale)
+        return (picture, area)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        let signpostID = OSSignpostID(log: OmniMemoryGraphLayout.signpostLog)
+        os_signpost(.begin, log: OmniMemoryGraphLayout.signpostLog, name: "draw", signpostID: signpostID,
+                    "%d nodes, %d edges", nodes.count, edges.count)
+        defer { os_signpost(.end, log: OmniMemoryGraphLayout.signpostLog, name: "draw", signpostID: signpostID) }
+        OmniTheme.contentBackground.setFill()
+        bounds.intersection(dirtyRect).fill()
+        let searching = !highlightQuery.trimmingCharacters(in: .whitespaces).isEmpty
+        if showsCommunityRegions {
+            drawRegions()
+        }
+        let emphasised = self.emphasised
+        let key = EdgeCacheKey(generation: layoutGeneration, lowZoom: scale < OmniMemoryGraphLayout.lowZoom,
+                               hidden: hiddenEdgeKinds, searching: searching)
+        if let cached = edgeCacheImage(key: key, searching: searching) {
+            let (image, area) = cached
+            let origin = viewPoint(area.origin)
+            image.draw(in: NSRect(x: origin.x, y: origin.y, width: area.width * scale, height: area.height * scale),
+                       from: .zero, operation: .sourceOver, fraction: 1, respectFlipped: true, hints: nil)
+        }
+        // The selected and hovered nodes' edges, drawn live over the layer.
+        if !emphasised.isEmpty {
+            for edge in edges where !hiddenEdgeKinds.contains(edge.kind) &&
+                (emphasised.contains(edge.source) || emphasised.contains(edge.target)) {
+                guard let a = positions[edge.source], let b = positions[edge.target] else { continue }
+                let start = viewPoint(a), end = viewPoint(b)
+                guard CGRect(x: min(start.x, end.x), y: min(start.y, end.y), width: abs(start.x - end.x),
+                             height: abs(start.y - end.y)).insetBy(dx: -2, dy: -2).intersects(dirtyRect) else { continue }
+                strokeEdge(edge, from: start, to: end, emphasised: true, searching: searching, lineScale: 1)
+            }
+        }
+        var labels: [(node: OmniMemoryGraphNode, center: CGPoint, r: CGFloat, priority: Int)] = []
+        for node in nodes {
+            guard let position = positions[node.id] else { continue }
+            let center = viewPoint(position)
+            let r = radius(node) * max(0.6, min(1.6, scale))
+            let rect = NSRect(x: center.x - r, y: center.y - r, width: 2 * r, height: 2 * r)
+            guard rect.insetBy(dx: -4, dy: -4).intersects(dirtyRect) || rect.insetBy(dx: -260, dy: -20).intersects(dirtyRect)
+            else { continue }
+            let dimmed = searching && !matches(node) && node.id != selectedID
+            // A mind map's type branch takes its type's colour.
+            var color = OmniTheme.memoryTypeColor(node.memoryType ?? (node.kind == "type" ? node.label : node.kind))
+            if node.expiring {
+                color = color.withAlphaComponent(0.35)
+            }
+            if dimmed {
+                color = color.withAlphaComponent(0.2)
+            }
+            if rect.insetBy(dx: -6, dy: -6).intersects(dirtyRect) {
+                if recentlyTouched.contains(node.id) {
+                    OmniTheme.accent.withAlphaComponent(0.45).setFill()
+                    NSBezierPath(ovalIn: rect.insetBy(dx: -5, dy: -5)).fill()
+                }
+                color.setFill()
+                let shape = Self.shape(for: node.kind, in: rect)
+                shape.fill()
+                if node.pinned {
+                    NSColor.labelColor.withAlphaComponent(0.7).setStroke()
+                    shape.lineWidth = 1.5
+                    shape.stroke()
+                }
+                if node.id == selectedID || node.id == focusID || matches(node) {
+                    OmniTheme.accent.setStroke()
+                    let ring = NSBezierPath(ovalIn: rect.insetBy(dx: -3, dy: -3))
+                    ring.lineWidth = 2.5
+                    ring.stroke()
+                }
+                if node.collapsed && node.childrenCount > 0 {
+                    drawBadge(node.childrenCount, at: CGPoint(x: rect.maxX - 2, y: rect.minY + 2))
+                }
+            }
+            if let priority = labelPriority(node), !node.label.isEmpty, !dimmed {
+                labels.append((node, center, r, priority))
+            }
+        }
+        drawLabels(labels)
+        if nodes.isEmpty {
+            let message = "No memories to draw yet." as NSString
+            let attributes: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.placeholder,
+                                                             .foregroundColor: OmniTheme.secondaryText]
+            let size = message.size(withAttributes: attributes)
+            message.draw(at: CGPoint(x: bounds.midX - size.width / 2, y: bounds.midY - size.height / 2), withAttributes: attributes)
+        }
+    }
+
+    // Lower is placed first; nil is not labelled at all.
+    private func labelPriority(_ node: OmniMemoryGraphNode) -> Int? {
+        if node.id == selectedID { return 0 }
+        if node.id == hoveredID { return 1 }
+        if node.id == focusID { return 2 }
+        if matches(node) { return 3 }
+        if node.kind != "memory" { return 4 }
+        if focusID != nil {
+            // In focus, neighbours are labelled; the second ring only on hover.
+            return focusNeighbours.contains(node.id) ? 5 : nil
+        }
+        return scale >= 0.7 || nodes.count <= 40 ? 6 : nil
+    }
+
+    private func drawLabels(_ labels: [(node: OmniMemoryGraphNode, center: CGPoint, r: CGFloat, priority: Int)]) {
+        let regular: [NSAttributedString.Key: Any] = [.font: NSFont.systemFont(ofSize: 10.5),
+                                                      .foregroundColor: NSColor.labelColor]
+        let strong: [NSAttributedString.Key: Any] = [.font: NSFont.systemFont(ofSize: 12, weight: .semibold),
+                                                     .foregroundColor: NSColor.labelColor]
+        let ordered = labels.sorted { ($0.priority, -$0.node.weight, $0.node.id) < ($1.priority, -$1.node.weight, $1.node.id) }
+        var texts: [String: (NSString, CGPoint, [NSAttributedString.Key: Any])] = [:]
+        var candidates: [(id: String, rect: CGRect)] = []
+        for label in ordered {
+            let attributes = label.node.kind == "type" || label.node.kind == "root" ? strong : regular
+            let text = OmniMemoryGraphLayout.shortLabel(label.node) as NSString
+            let size = text.size(withAttributes: attributes)
+            let origin = CGPoint(x: label.center.x + label.r + 4, y: label.center.y - 7)
+            texts[label.node.id] = (text, origin, attributes)
+            candidates.append((label.node.id, CGRect(origin: origin, size: size)))
+        }
+        for id in OmniMemoryGraphLayout.placeLabels(candidates) {
+            guard let label = texts[id] else { continue }
+            label.0.draw(at: label.1, withAttributes: label.2)
+        }
+    }
+
+    private func drawBadge(_ count: Int, at point: CGPoint) {
+        let text = String(count) as NSString
+        let attributes: [NSAttributedString.Key: Any] = [.font: NSFont.systemFont(ofSize: 9, weight: .semibold),
+                                                         .foregroundColor: NSColor.white]
+        let size = text.size(withAttributes: attributes)
+        let rect = NSRect(x: point.x, y: point.y - size.height / 2 - 1, width: max(size.height, size.width + 8),
+                          height: size.height + 2)
+        OmniTheme.accent.withAlphaComponent(0.9).setFill()
+        NSBezierPath(roundedRect: rect, xRadius: rect.height / 2, yRadius: rect.height / 2).fill()
+        text.draw(at: CGPoint(x: rect.midX - size.width / 2, y: rect.minY + 1), withAttributes: attributes)
+    }
+
+    private func drawRegions() {
+        let labelAttributes: [NSAttributedString.Key: Any] = [.font: NSFont.systemFont(ofSize: 11, weight: .semibold),
+                                                              .foregroundColor: OmniTheme.secondaryText]
+        for community in regionCommunities {
+            let points = community.members.compactMap { positions[$0] }.map { viewPoint($0) }
+            let hull = OmniMemoryGraphLayout.convexHull(points)
+            guard hull.count >= 2 else { continue }
+            let hash = OmniMemoryGraphLayout.stableHash(community.id)
+            let tint = NSColor(calibratedHue: CGFloat(hash % 360) / 360, saturation: 0.45, brightness: 0.8, alpha: 1)
+            let path = NSBezierPath()
+            path.move(to: hull[0])
+            for point in hull.dropFirst() {
+                path.line(to: point)
+            }
+            path.close()
+            path.lineJoinStyle = .round
+            path.lineWidth = 28
+            tint.withAlphaComponent(0.08).setFill()
+            tint.withAlphaComponent(0.08).setStroke()
+            path.fill()
+            path.stroke()
+            guard !community.label.isEmpty else { continue }
+            let text = (community.label.count > 32 ? String(community.label.prefix(31)) + "…" : community.label) as NSString
+            let size = text.size(withAttributes: labelAttributes)
+            let top = hull.map { $0.y }.min() ?? 0
+            let midX = hull.map { $0.x }.reduce(0, +) / CGFloat(hull.count)
+            text.draw(at: CGPoint(x: midX - size.width / 2, y: top - 14 - size.height), withAttributes: labelAttributes)
+        }
+    }
+
+    // MARK: - Mouse
+
+    override func updateTrackingAreas() {
+        super.updateTrackingAreas()
+        if let hoverArea {
+            removeTrackingArea(hoverArea)
+        }
+        let area = NSTrackingArea(rect: .zero, options: [.mouseMoved, .mouseEnteredAndExited, .activeInKeyWindow,
+                                                          .inVisibleRect], owner: self, userInfo: nil)
+        addTrackingArea(area)
+        hoverArea = area
+    }
+
+    override func mouseMoved(with event: NSEvent) {
+        hover(node(at: convert(event.locationInWindow, from: nil))?.id)
+    }
+
+    override func mouseExited(with event: NSEvent) {
+        hover(nil)
+    }
+
+    // The hovered node's edges and label come forward; its full label is the tooltip.
+    // Right-click: the node under the pointer (selected first), or nil on the background.
+    var contextMenu: ((OmniMemoryGraphNode?) -> NSMenu?)?
+
+    override func menu(for event: NSEvent) -> NSMenu? {
+        let hit = node(at: convert(event.locationInWindow, from: nil))
+        if let hit, hit.id != selectedID {
+            select(hit.id)
+        }
+        return contextMenu?(hit) ?? super.menu(for: event)
+    }
+
+    func hover(_ id: String?) {
+        guard id != hoveredID else { return }
+        // A node opens on click: the pointing hand over it.
+        (id == nil ? NSCursor.arrow : NSCursor.pointingHand).set()
+        hoveredID = id
+        toolTip = id.flatMap { nodeIndex[$0] }.map { nodes[$0].label }
+        needsDisplay = true
+    }
+
+    override func mouseDown(with event: NSEvent) {
+        window?.makeFirstResponder(self)
+        let point = convert(event.locationInWindow, from: nil)
+        dragOrigin = point
+        dragged = false
+        if event.clickCount <= 1 {
+            selectedAtMouseDown = selectedID
+        }
+        if event.clickCount >= 2, let node = node(at: point) {
+            let wasSelected = selectedAtMouseDown == node.id
+            select(node.id)
+            if !wasSelected, expandNode?(node.id) == true {
+                return
+            }
+            openNode?(node.id)
+        }
+    }
+
+    override func mouseDragged(with event: NSEvent) {
+        guard let origin = dragOrigin else { return }
+        let point = convert(event.locationInWindow, from: nil)
+        if hypot(point.x - origin.x, point.y - origin.y) > 2 {
+            dragged = true
+        }
+        offset.x += (point.x - origin.x) / scale
+        offset.y += (point.y - origin.y) / scale
+        dragOrigin = point
+        needsDisplay = true
+    }
+
+    override func mouseUp(with event: NSEvent) {
+        defer { dragOrigin = nil }
+        guard !dragged, event.clickCount < 2 else { return }
+        let hit = node(at: convert(event.locationInWindow, from: nil))
+        select(hit?.id)
+        if let hit, hit.childrenCount > 0, hit.kind != "root" {
+            toggleNode?(hit.id)
+        }
+    }
+
+    override func scrollWheel(with event: NSEvent) {
+        if event.modifierFlags.contains(.command) {
+            zoom(by: 1 + event.scrollingDeltaY * 0.01, around: convert(event.locationInWindow, from: nil))
+        } else {
+            offset.x += event.scrollingDeltaX / scale
+            offset.y += event.scrollingDeltaY / scale
+            needsDisplay = true
+        }
+    }
+
+    override func magnify(with event: NSEvent) {
+        zoom(by: 1 + event.magnification, around: convert(event.locationInWindow, from: nil))
+    }
+
+    func zoom(by factor: CGFloat, around point: CGPoint) {
+        let before = layoutPoint(point)
+        scale = max(0.1, min(5, scale * factor))
+        let after = layoutPoint(point)
+        offset.x += after.x - before.x
+        offset.y += after.y - before.y
+        needsDisplay = true
+    }
+
+    private func layoutPoint(_ point: CGPoint) -> CGPoint {
+        return CGPoint(x: (point.x - bounds.midX) / scale - offset.x, y: (point.y - bounds.midY) / scale - offset.y)
+    }
+
+    override func keyDown(with event: NSEvent) {
+        if keyHandler?(event) == true {
+            return
+        }
+        super.keyDown(with: event)
+    }
+
+    // Up and Down walk the nodes by weight; the canvas follows the selection.
+    func step(_ delta: Int) {
+        let order = nodes.filter { $0.kind == "memory" }.sorted { ($0.weight, $1.id) > ($1.weight, $0.id) }
+        guard !order.isEmpty else { return }
+        let current = order.firstIndex { $0.id == selectedID }
+        let target = current.map { min(max(0, $0 + delta), order.count - 1) } ?? 0
+        select(order[target].id)
+        center(on: order[target].id)
+    }
+}
diff --git a/sources/OmniTerm/OmniMemoryPane.swift b/sources/OmniTerm/OmniMemoryPane.swift
new file mode 100644
index 0000000000000000000000000000000000000000..79d6d5819503037be512c22d34a54a7a38c067e0
--- /dev/null
+++ b/sources/OmniTerm/OmniMemoryPane.swift
@@ -0,0 +1,2481 @@
+import AppKit
+import Foundation
+
+// The Memory page: OmniTerm's hippocampus, laid out as a memory browser.
+// Browse lists long-term memories by type and weight with their evidence,
+// revisions and journal; Search spans memories and transcripts; Process shows
+// how memory is built (the ingestion → candidate → memory pipeline and the
+// consolidation journal); Digest is the mid-term layer; Graph draws memories
+// as a network or a mind map; Ingest lists the background consolidation runs,
+// which the sidebar's Runs leaves out. Memory text is untrusted and shown as
+// plain text.
+
+enum OmniMemoryTab: Int, CaseIterable {
+    case browse
+    case search
+    case process
+    case digest
+    case graph
+    case ingest
+
+    var title: String {
+        switch self {
+        case .browse: return "Browse"
+        case .search: return "Search"
+        case .process: return "Process"
+        case .digest: return "Digest"
+        case .graph: return "Graph"
+        case .ingest: return "Ingest"
+        }
+    }
+}
+
+struct OmniMemoryItem: Equatable {
+    let id: String
+    let title: String
+    let body: String
+    let memoryType: String
+    let weight: Double
+    let effectiveWeight: Double
+    let evidenceCount: Int
+    let pinned: Bool
+    let expiring: Bool
+    let tags: [String]
+    let workspaces: [String]
+    let updated: Double?
+    let revision: Int
+    let archived: Bool
+
+    init?(_ value: [AnyHashable: Any]) {
+        guard let id = value["id"] as? String else { return nil }
+        self.id = id
+        title = value["title"] as? String ?? ""
+        body = value["body"] as? String ?? ""
+        memoryType = value["memory_type"] as? String ?? "declarative"
+        weight = (value["weight"] as? NSNumber)?.doubleValue ?? 0
+        effectiveWeight = (value["effective_weight"] as? NSNumber)?.doubleValue ?? weight
+        evidenceCount = (value["evidence_count"] as? NSNumber)?.intValue ?? 0
+        pinned = value["pinned"] as? Bool ?? false
+        expiring = value["expiry_candidate"] as? Bool ?? false
+        tags = value["tags"] as? [String] ?? []
+        workspaces = value["workspaces"] as? [String] ?? []
+        updated = (value["updated"] as? NSNumber)?.doubleValue
+        revision = (value["revision"] as? NSNumber)?.intValue ?? 1
+        archived = value["archived"] as? Bool ?? false
+    }
+
+    var detailLine: String {
+        var parts = [memoryType, String(format: "weight %.1f", effectiveWeight),
+                     evidenceCount == 1 ? "1 source" : "\(evidenceCount) sources"]
+        if pinned { parts.append("pinned") }
+        if expiring { parts.append("fading") }
+        if archived { parts.append("archived") }
+        return parts.joined(separator: " · ")
+    }
+}
+
+// Words for journal events and the detail panes. Everything a memory or an
+// event carries is untrusted: it is shown, never interpreted.
+enum OmniMemoryText {
+    static let kindTitles: [String: String] = [
+        "candidates_offered": "Candidates offered",
+        "memory_created": "Memory created",
+        "memory_revised": "Memory revised",
+        "memory_attributes": "Memory adjusted",
+        "memory_deleted": "Memory deleted",
+        "candidate_dismissed": "Candidate dismissed",
+        "digest_regenerated": "Digest regenerated",
+        "ingest_snapshot": "Ingestion snapshot",
+        "memory_archived": "Memory archived",
+        "memory_restored": "Memory restored",
+    ]
+
+    static func kindTitle(_ kind: String) -> String {
+        return kindTitles[kind] ?? kind
+    }
+
+    static func kindColor(_ kind: String) -> NSColor {
+        switch kind {
+        case "memory_created": return OmniTheme.completed
+        case "memory_revised", "memory_attributes": return OmniTheme.running
+        case "memory_deleted": return OmniTheme.failed
+        case "candidate_dismissed": return OmniTheme.ended
+        case "candidates_offered": return OmniTheme.waiting
+        default: return OmniTheme.accent
+        }
+    }
+
+    static func number(_ value: Any?) -> Int? {
+        return (value as? NSNumber)?.intValue
+    }
+
+    // The Ingest tab's semantic-coverage line, from knowledge_status.embedding.coverage.
+    static func coverageLine(_ coverage: [AnyHashable: Any]?) -> String {
+        guard let coverage else { return "" }
+        func percent(_ corpus: [AnyHashable: Any]?) -> String? {
+            guard let ratio = (corpus?["ratio"] as? NSNumber)?.doubleValue else { return nil }
+            return String(format: "%.1f%%", ratio * 100)
+        }
+        let transcript = coverage["transcript"] as? [AnyHashable: Any]
+        var parts: [String] = []
+        if let share = percent(transcript), let total = number(transcript?["embeddable"]),
+           let done = number(transcript?["embedded"]) {
+            parts.append("transcripts \(share) (\(done.formatted()) of \(total.formatted()))")
+        } else {
+            parts.append("transcripts counting…")
+        }
+        if let share = percent(coverage["memory"] as? [AnyHashable: Any]) {
+            parts.append("memories \(share)")
+        }
+        var line = "Semantic coverage: " + parts.joined(separator: " · ")
+        if let rejected = number(coverage["rejected_chunks"]), rejected > 0 {
+            line += "\n\(rejected.formatted()) chunks without a vector (not English)"
+        }
+        if let cap = coverage["transcript_vector_cap"] as? [AnyHashable: Any], cap["capped"] as? Bool == true {
+            line += "\nPaused at the vector cap until compaction"
+        }
+        return line
+    }
+
+    static func eventSummary(_ event: [AnyHashable: Any]) -> String {
+        let kind = event["kind"] as? String ?? ""
+        let title = (event["title"] as? String).map { "“\(OmniReportText.sanitized($0))”" }
+        switch kind {
+        case "candidates_offered":
+            return "\(number(event["count"]) ?? 0) transcript messages offered to the consolidator"
+        case "memory_created":
+            return [title, (event["memory_type"] as? String).map { "as \($0)" }].compactMap { $0 }.joined(separator: " ")
+        case "memory_revised":
+            let changed = (event["changed"] as? [String])?.joined(separator: ", ")
+            return [title, number(event["revision"]).map { "to revision \($0)" },
+                    changed.map { "(\($0))" }].compactMap { $0 }.joined(separator: " ")
+        case "memory_attributes":
+            let changes = (event["changes"] as? [String: Any])?.keys.sorted().joined(separator: ", ")
+            return [title, changes.map { "changed \($0)" },
+                    event["reinforced"] as? Bool == true ? "reinforced" : nil].compactMap { $0 }.joined(separator: " ")
+        case "memory_deleted":
+            return title ?? "A memory was deleted"
+        case "candidate_dismissed":
+            return (event["reason"] as? String).map { OmniReportText.sanitized($0) } ?? "Dismissed without a reason"
+        case "digest_regenerated":
+            let scope = (event["workspace"] as? String) ?? "all workspaces"
+            return "\(number(event["count"]) ?? 0) memories for \(scope)"
+        case "ingest_snapshot":
+            return "\(number(event["messages"]) ?? 0) messages, \(number(event["vectors"]) ?? 0) vectors, " +
+                "\(number(event["backlog_files"]) ?? 0) files waiting"
+        default:
+            return ""
+        }
+    }
+
+    static func time(_ seconds: Any?) -> String {
+        guard let seconds = (seconds as? NSNumber)?.doubleValue else { return "" }
+        let date = Date(timeIntervalSince1970: seconds)
+        return OmniSchedulerClient.relativeFormatter.localizedString(for: date, relativeTo: Date())
+    }
+
+    private static func attributes(_ font: NSFont, _ color: NSColor = .labelColor,
+                                   spacing: CGFloat = 4) -> [NSAttributedString.Key: Any] {
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.paragraphSpacing = spacing
+        paragraph.lineBreakMode = .byWordWrapping
+        return [.font: font, .foregroundColor: color, .paragraphStyle: paragraph]
+    }
+
+    private static func append(_ text: NSMutableAttributedString, _ string: String, _ font: NSFont,
+                               _ color: NSColor = .labelColor, spacing: CGFloat = 4) {
+        text.append(NSAttributedString(string: string + "\n", attributes: attributes(font, color, spacing: spacing)))
+    }
+
+    private static func header(_ text: NSMutableAttributedString, _ title: String) {
+        append(text, "", OmniTheme.Font.rowDetail, spacing: 2)
+        append(text, title.uppercased(), OmniTheme.Font.sectionHeader, OmniTheme.secondaryText, spacing: 6)
+    }
+
+    // A session's title is its first prompt, often wrapped in command markup:
+    // keep the words, drop the tags, and keep it to one short line.
+    static func sessionTitle(_ source: [AnyHashable: Any]) -> String {
+        let raw = ((source["session_title"] as? String) ?? "")
+            .replacingOccurrences(of: "<command-message>[^<]{0,200}</command-message>", with: " ", options: .regularExpression)
+        let words = raw.replacingOccurrences(of: "<[^>]{1,80}>", with: " ", options: .regularExpression)
+            .split(whereSeparator: \.isWhitespace).joined(separator: " ")
+        let title = words.isEmpty ? (source["session_id"] as? String ?? "") : words
+        return title.count > 90 ? String(title.prefix(89)) + "…" : title
+    }
+
+    // The detail of one memory from `get_memory`. `titles` names related
+    // memories by ID.
+    static func memoryDetail(_ memory: [AnyHashable: Any], titles: [String: String]) -> NSAttributedString {
+        let text = NSMutableAttributedString()
+        guard let item = OmniMemoryItem(memory) else { return text }
+        append(text, OmniReportText.sanitized(item.title), OmniTheme.Font.subtitle, spacing: 6)
+        let base = (memory["base_weight"] as? NSNumber)?.doubleValue ?? 0
+        let decay = (memory["decay_rate"] as? NSNumber)?.doubleValue ?? 0
+        var meta = [item.memoryType.uppercased(),
+                    String(format: "weight %.2f of %.1f (base %.0f, −%.2f a day)", item.effectiveWeight, item.weight, base, decay),
+                    "revision \(item.revision)"]
+        if let updated = memory["updated"] { meta.append("updated " + time(updated)) }
+        if item.pinned { meta.append("pinned: never fades") }
+        if item.expiring { meta.append("fading: below the expiry threshold") }
+        text.append(NSAttributedString(string: meta.joined(separator: "  ·  ") + "\n",
+                                       attributes: attributes(OmniTheme.Font.meta, OmniTheme.memoryTypeColor(item.memoryType))))
+        if !item.tags.isEmpty {
+            append(text, item.tags.map { "#" + OmniReportText.sanitized($0) }.joined(separator: "  "),
+                   OmniTheme.Font.meta, OmniTheme.secondaryText)
+        }
+        if !item.workspaces.isEmpty {
+            append(text, item.workspaces.map(OmniReportText.sanitized).joined(separator: "\n"), OmniTheme.Font.mono,
+                   OmniTheme.secondaryText)
+        }
+        append(text, "", OmniTheme.Font.rowDetail, spacing: 2)
+        append(text, OmniReportText.sanitized(item.body), OmniTheme.Font.body, spacing: 6)
+
+        let evidence = memory["evidence"] as? [[AnyHashable: Any]] ?? []
+        header(text, "Evidence (\(evidence.count))")
+        // Sources from one session sit under its title, named once.
+        var previousSession: String?
+        for source in evidence {
+            let session = sessionTitle(source)
+            if session != previousSession {
+                append(text, OmniReportText.sanitized(session), OmniTheme.Font.rowTitleEmphasized, spacing: 2)
+                previousSession = session
+            }
+            var line: [String] = []
+            if let role = source["role"] as? String { line.append(role) }
+            if let timestamp = source["timestamp"] as? String { line.append(timestamp) }
+            if source["available"] as? Bool == false { line.append("no longer in its transcript") }
+            if !line.isEmpty {
+                append(text, "• " + line.joined(separator: " · "), OmniTheme.Font.meta, OmniTheme.secondaryText, spacing: 1)
+            }
+            if let excerpt = source["excerpt"] as? String {
+                append(text, OmniReportText.sanitized(excerpt), OmniTheme.Font.meta, OmniTheme.secondaryText, spacing: 8)
+            }
+        }
+        let revisions = memory["revisions"] as? [[AnyHashable: Any]] ?? []
+        if !revisions.isEmpty {
+            header(text, "Revisions (\(revisions.count))")
+            for revision in revisions {
+                let number = (revision["revision"] as? NSNumber)?.intValue ?? 0
+                append(text, "r\(number) · \(time(revision["updated"])) — " +
+                       OmniReportText.sanitized(revision["title"] as? String ?? ""), OmniTheme.Font.rowTitle, spacing: 1)
+                append(text, OmniReportText.sanitized(revision["body"] as? String ?? ""), OmniTheme.Font.meta,
+                       OmniTheme.secondaryText, spacing: 8)
+            }
+        }
+        let related = memory["related"] as? [[AnyHashable: Any]] ?? []
+        if !related.isEmpty {
+            header(text, "Related")
+            for edge in related {
+                let other = (edge["source"] as? String) == item.id ? edge["target"] as? String : edge["source"] as? String
+                let name = other.flatMap { titles[$0] } ?? other ?? ""
+                let kind = edge["kind"] as? String ?? ""
+                let strength = (edge["strength"] as? NSNumber)?.doubleValue ?? 0
+                append(text, String(format: "%@ · %@ (%.2f)", kind, OmniReportText.sanitized(name), strength),
+                       OmniTheme.Font.meta, spacing: 2)
+            }
+        }
+        let events = memory["events"] as? [[AnyHashable: Any]] ?? []
+        if !events.isEmpty {
+            header(text, "Journal")
+            for event in events {
+                let kind = event["kind"] as? String ?? ""
+                append(text, "\(time(event["at"])) · \(kindTitle(kind)) — \(eventSummary(event))", OmniTheme.Font.meta,
+                       spacing: 2)
+                if let reason = event["reason"] as? String, kind != "candidate_dismissed" {
+                    append(text, "Reason: " + OmniReportText.sanitized(reason), OmniTheme.Font.meta, OmniTheme.secondaryText)
+                }
+            }
+        }
+        return text
+    }
+
+    // The detail of one journal event.
+    static func ingestRunDetail(_ run: OmniRun, agent: OmniAgent?) -> NSAttributedString {
+        let text = NSMutableAttributedString()
+        append(text, run.statusLine, OmniTheme.Font.subtitle, spacing: 4)
+        var meta = ["Started " + time(run.started.timeIntervalSince1970)]
+        if let finished = run.finished {
+            meta.append("took " + OmniFormat.duration(from: run.started, to: finished))
+        }
+        if let provider = run.provider ?? agent?.provider {
+            meta.append([provider.capitalized, agent?.model].compactMap { $0 }.joined(separator: " "))
+        }
+        meta.append(run.origin == "manual" || run.reason == "manual" ? "started by hand" : "scheduled")
+        append(text, OmniReportText.sanitized(meta.joined(separator: " · ")), OmniTheme.Font.meta,
+               OmniTheme.secondaryText, spacing: 8)
+        if let message = run.finalMessage, !message.isEmpty {
+            header(text, "Result")
+            append(text, OmniReportText.sanitized(message), OmniTheme.Font.body, spacing: 8)
+        }
+        if let summary = run.summary, !summary.isEmpty {
+            header(text, "Summary")
+            append(text, OmniReportText.sanitized(summary), OmniTheme.Font.body, spacing: 8)
+        }
+        if run.finalMessage == nil && run.summary == nil {
+            append(text, run.isWorking ? "Consolidating now." : "No report was recorded.", OmniTheme.Font.body,
+                   OmniTheme.secondaryText)
+        }
+        if let agent {
+            header(text, "Schedule")
+            var schedule = agent.enabled ? agent.schedule : "Paused"
+            if agent.enabled, let next = agent.nextRun {
+                schedule += " · next " + OmniFormat.relative(max(next, Date()))
+            }
+            append(text, OmniReportText.sanitized(schedule), OmniTheme.Font.meta, OmniTheme.secondaryText)
+        }
+        return text
+    }
+
+    static func eventDetail(_ event: [AnyHashable: Any]) -> NSAttributedString {
+        let text = NSMutableAttributedString()
+        let kind = event["kind"] as? String ?? ""
+        append(text, kindTitle(kind), OmniTheme.Font.subtitle, spacing: 4)
+        append(text, time(event["at"]), OmniTheme.Font.meta, OmniTheme.secondaryText, spacing: 8)
+        append(text, eventSummary(event), OmniTheme.Font.body, spacing: 8)
+        if let actor = event["actor"] as? [String: Any] {
+            append(text, "By " + [actor["agent"] as? String, (actor["run_id"] as? String).map { "run \($0)" }]
+                .compactMap { $0 }.map(OmniReportText.sanitized).joined(separator: ", "), OmniTheme.Font.meta)
+        }
+        if let reason = event["reason"] as? String {
+            append(text, "Reason: " + OmniReportText.sanitized(reason), OmniTheme.Font.meta)
+        }
+        if let changes = event["changes"] as? [String: [Any]] {
+            for key in changes.keys.sorted() {
+                let values = changes[key]?.map { "\($0)" } ?? []
+                append(text, "\(key): " + values.joined(separator: " → "), OmniTheme.Font.mono)
+            }
+        }
+        let skip: Set<String> = ["id", "kind", "at", "actor", "reason", "changes", "title"]
+        let rest = event.compactMap { key, value -> String? in
+            guard let key = key as? String, !skip.contains(key) else { return nil }
+            if let list = value as? [Any] {
+                return "\(key): " + list.prefix(8).map { "\($0)" }.joined(separator: ", ") + (list.count > 8 ? " …" : "")
+            }
+            return "\(key): \(value)"
+        }.sorted()
+        if !rest.isEmpty {
+            header(text, "Details")
+            append(text, OmniReportText.sanitized(rest.joined(separator: "\n")), OmniTheme.Font.mono, OmniTheme.secondaryText)
+        }
+        return text
+    }
+}
