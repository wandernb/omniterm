+- (NSArray<NSDictionary *> *)integrationMCPResponsesForFrames:(NSArray<NSDictionary *> *)frames {
+    NSString *shim = @"import importlib.machinery, importlib.util, sys\n"
+                      "loader = importlib.machinery.SourceFileLoader('omni_mcp_native_test', sys.argv[1])\n"
+                      "module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))\n"
+                      "loader.exec_module(module)\n"
+                      "module.SOCKET = module.Path(sys.argv[2])\n"
+                      "original_request = module.scheduler_request\n"
+                      "def no_launch(payload, launch=True):\n"
+                      "    return original_request(payload, launch=False)\n"
+                      "module.scheduler_request = no_launch\n"
+                      "def forbidden_launch():\n"
+                      "    raise RuntimeError('The isolated MCP test must never launch an app')\n"
+                      "module.launch_command = forbidden_launch\n"
+                      "module.main()\n";
+    NSTask *adapter = [[NSTask alloc] init];
+    adapter.launchPath = @"/usr/bin/python3";
+    adapter.arguments = @[ @"-c", shim,
+                           [_knowledgeIntegrationScheduler.fixtureHelpers stringByAppendingPathComponent:@"omni-mcp"],
+                           [_knowledgeIntegrationScheduler valueForKey:@"socketPath"] ];
+    adapter.currentDirectoryPath = _knowledgeIntegrationScheduler.fixtureHome;
+    adapter.environment = @{ @"HOME": _knowledgeIntegrationScheduler.fixtureHome, @"PATH": @"/usr/bin:/bin",
+                              @"LANG": @"en_US.UTF-8", @"PYTHONDONTWRITEBYTECODE": @"1" };
+    NSPipe *input = [NSPipe pipe];
+    NSPipe *output = [NSPipe pipe];
+    adapter.standardInput = input;
+    adapter.standardOutput = output;
+    adapter.standardError = [NSFileHandle fileHandleWithNullDevice];
+    NSError *launchError = nil;
+    const BOOL launched = [adapter launchAndReturnError:&launchError];
+    XCTAssertTrue(launched, @"%@", launchError);
+    if (!launched) return @[];
+
+    XCTestExpectation *answered = [self expectationWithDescription:@"MCP adapter completed private native round trip"];
+    __block NSData *stdoutData = nil;
+    __block NSInteger status = -1;
+    __block BOOL oversized = NO;
+    __block BOOL finished = NO;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        NSMutableData *data = [NSMutableData data];
+        @try {
+            while (YES) {
+                NSData *chunk = [output.fileHandleForReading readDataOfLength:65536];
+                if (!chunk.length) break;
+                if (data.length + chunk.length > 2 * 1024 * 1024) {
+                    oversized = YES;
+                    if (adapter.running) [adapter terminate];
+                    break;
+                }
+                [data appendData:chunk];
+            }
+        } @catch (NSException *exception) {
+            if (adapter.running) [adapter terminate];
+        }
+        [adapter waitUntilExit];
+        NSInteger exitStatus = adapter.terminationStatus;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (finished) return;
+            stdoutData = data;
+            status = exitStatus;
+            finished = YES;
+            [answered fulfill];
+        });
+    });
+    NSMutableData *stdinData = [NSMutableData data];
+    for (NSDictionary *frame in frames) {
+        [stdinData appendData:[NSJSONSerialization dataWithJSONObject:frame options:0 error:nil]];
+        [stdinData appendBytes:"\n" length:1];
+    }
+    @try {
+        [input.fileHandleForWriting writeData:stdinData];
+        [input.fileHandleForWriting closeFile];
+    } @catch (NSException *exception) {
+        if (adapter.running) [adapter terminate];
+        XCTFail(@"Could not write the isolated MCP protocol frames: %@", exception.name);
+    }
+    [self waitForExpectations:@[ answered ] timeout:20];
+    finished = YES;
+    if (adapter.running) [adapter terminate];
+    XCTAssertFalse(oversized);
+    XCTAssertEqual(status, 0);
+    XCTAssertNotNil(stdoutData);
+    if (!stdoutData) return @[];
+    NSString *text = [[NSString alloc] initWithData:stdoutData encoding:NSUTF8StringEncoding];
+    XCTAssertNotNil(text);
+    NSMutableArray *responses = [NSMutableArray array];
+    for (NSString *line in [text componentsSeparatedByCharactersInSet:NSCharacterSet.newlineCharacterSet]) {
+        if (!line.length) continue;
+        id response = [NSJSONSerialization JSONObjectWithData:[line dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];
+        XCTAssertTrue([response isKindOfClass:[NSDictionary class]], @"Stdout must contain JSON-RPC frames only");
+        if ([response isKindOfClass:[NSDictionary class]]) [responses addObject:response];
+    }
+    return responses;
+}
