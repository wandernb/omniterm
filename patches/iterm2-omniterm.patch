+- (void)testMutePredicateFollowsStoredSettings {
+    XCTAssertTrue([OmniScheduler notificationsMutedInSettings:@{ @"muted_until": @"forever" } now:1000]);
+    XCTAssertTrue([OmniScheduler notificationsMutedInSettings:@{ @"muted_until": @2000 } now:1000]);
+    XCTAssertFalse([OmniScheduler notificationsMutedInSettings:@{ @"muted_until": @999 } now:1000]);
+    XCTAssertFalse([OmniScheduler notificationsMutedInSettings:@{ @"muted_until": @0 } now:1000]);
+    XCTAssertFalse([OmniScheduler notificationsMutedInSettings:@"forever" now:1000], @"Garbled settings are not muted");
+    XCTAssertFalse([OmniScheduler notificationsMutedInSettings:nil now:1000]);
+
+    XCTAssertFalse([_scheduler notificationsMuted]);
+    XCTAssertEqualObjects(([self setSettings:@{ @"notifications": @{ @"muted_until": @"forever" } }][@"ok"]), @YES);
+    XCTAssertTrue([_scheduler notificationsMuted]);
+    XCTAssertEqualObjects(([self setSettings:@{ @"notifications": @{ @"muted_until": @0 } }][@"ok"]), @YES);
+    XCTAssertFalse([_scheduler notificationsMuted]);
+}
+
+// The menu-bar mute must silence the terminal's own notifications (bell, idle,
+// triggers, OSC 9/777 from Claude and Codex), which go through this controller.
+- (void)testMutedNotificationControllerPostsNothing {
+    iTermNotificationController *controller = [iTermNotificationController sharedInstance];
+    BOOL (^previous)(void) = controller.omniMutedProvider;
+    controller.omniMutedProvider = ^BOOL{ return YES; };
+    XCTAssertTrue([controller omniMuted]);
+    XCTAssertFalse([controller notify:@"Bell" withDescription:@"x" windowIndex:0 tabIndex:0 viewIndex:0]);
+    XCTAssertFalse([controller notifyRich:@"Claude" withSubtitle:nil withDescription:@"waiting" withImage:nil
+                              windowIndex:0 tabIndex:0 viewIndex:0]);
+    controller.omniMutedProvider = nil;
+    XCTAssertFalse([controller omniMuted], @"No provider means not muted");
+    controller.omniMutedProvider = previous;
+}
+
+- (void)testLevelKindAndAgentRulesApplyInOrder {
+    NSDictionary *quietUrgent = @{ @"levels": @{ @"urgent": @{ @"banner": @NO } } };
+    XCTAssertEqualObjects(([self alertFor:@{ @"severity": @"urgent" } settings:quietUrgent][@"banner"]), @NO);
+    NSDictionary *loudInfo = @{ @"levels": @{ @"info": @{ @"banner": @YES, @"sound": @NO, @"count": @YES } } };
+    NSDictionary *info = [self alertFor:@{ @"severity": @"info" } settings:loudInfo];
+    XCTAssertEqualObjects((info[@"banner"]), @YES);
+    XCTAssertEqualObjects((info[@"sound"]), @NO);
+    // Every channel is a JSON boolean, not 0 or 1.
+    for (NSString *channel in @[ @"banner", @"sound", @"count", @"muted" ]) {
+        XCTAssertEqual(CFGetTypeID((CFTypeRef)info[channel]), CFBooleanGetTypeID(), @"%@", channel);
+    }
+    XCTAssertEqualObjects((info[@"count"]), @YES);
+
+    NSDictionary *kinds = @{ @"kinds": @{ @"storage": @"inbox", @"wrap_up": @"always" } };
+    NSDictionary *storage = [self alertFor:@{ @"severity": @"urgent", @"kind": @"storage" } settings:kinds];
+    XCTAssertEqualObjects((storage[@"banner"]), @NO);
+    XCTAssertEqualObjects((storage[@"count"]), @NO);
+    XCTAssertEqualObjects(([self alertFor:@{ @"severity": @"info", @"kind": @"wrap_up" } settings:kinds][@"banner"]), @YES);
+    // A row without a kind is an agent's.
+    XCTAssertEqualObjects(([self alertFor:@{ @"severity": @"urgent" } settings:kinds][@"banner"]), @YES);
+
+    NSDictionary *agents = @{ @"agents": @{ @"Nightly": @"urgent", @"Chatty": @"inbox" },
+                              @"kinds": @{ @"agent": @"always" } };
+    NSDictionary *nightlyAttention = [self alertFor:@{ @"severity": @"attention", @"agent": @"Nightly" } settings:agents];
+    XCTAssertEqualObjects((nightlyAttention[@"banner"]), @NO);
+    XCTAssertEqualObjects((nightlyAttention[@"count"]), @NO);
+    XCTAssertEqualObjects(([self alertFor:@{ @"severity": @"urgent", @"agent": @"Nightly" } settings:agents][@"banner"]), @YES);
+    NSDictionary *chatty = [self alertFor:@{ @"severity": @"urgent", @"agent": @"Chatty" } settings:agents];
+    XCTAssertEqualObjects((chatty[@"banner"]), @NO);
+    XCTAssertEqualObjects((chatty[@"count"]), @NO);
+    XCTAssertEqualObjects(([self alertFor:@{ @"severity": @"attention", @"agent": @"Other" } settings:agents][@"banner"]), @YES);
+}
+
+- (void)testSetSettingsValidatesMergesAndPersists {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSDictionary *saved = [self setSettings:@{ @"notifications": @{ @"muted_until": @"forever",
+                                                                     @"agents": @{ @"Review": @"urgent" } },
+                                               @"agent_defaults": @{ @"provider": @"codex",
+                                                                     @"models": @{ @"codex": @"gpt-5" } },
+                                               @"retained_run_tabs": @12 }];
+    XCTAssertEqualObjects((saved[@"ok"]), @YES, @"%@", saved);
+    NSDictionary *settings = [_scheduler settings];
+    XCTAssertEqualObjects((settings[@"notifications"][@"muted_until"]), @"forever");
+    XCTAssertEqualObjects((settings[@"notifications"][@"agents"]), (@{ @"Review": @"urgent" }));
+    XCTAssertEqualObjects((settings[@"notifications"][@"levels"][@"urgent"][@"banner"]), @YES);
+    XCTAssertEqualObjects((settings[@"agent_defaults"][@"provider"]), @"codex");
+    XCTAssertEqualObjects((settings[@"agent_defaults"][@"models"]), (@{ @"claude": @"", @"codex": @"gpt-5" }));
+    XCTAssertEqualObjects((settings[@"retained_run_tabs"]), @12);
+
+    // A later partial change keeps the rest; "follow" removes an override.
+    XCTAssertEqualObjects(([self setSettings:@{ @"notifications": @{ @"muted_until": @0,
+                                                                     @"agents": @{ @"Review": @"follow" } } }][@"ok"]), @YES);
+    settings = [_scheduler settings];
+    XCTAssertEqualObjects((settings[@"notifications"][@"muted_until"]), @0);
+    XCTAssertEqualObjects((settings[@"notifications"][@"agents"]), (@{}));
+    XCTAssertEqualObjects((settings[@"agent_defaults"][@"provider"]), @"codex");
+
+    NSArray *invalid = @[ @{},
+                          @{ @"notifications": @{ @"levels": @{ @"urgent": @{ @"banner": @"yes" } } } },
+                          @{ @"notifications": @{ @"levels": @{ @"loud": @{} } } },
+                          @{ @"notifications": @{ @"kinds": @{ @"agent": @"sometimes" } } },
+                          @{ @"notifications": @{ @"muted_until": @-5 } },
+                          @{ @"notifications": @{ @"agents": @{ @"Review": @"never" } } },
+                          @{ @"agent_defaults": @{ @"provider": @"gpt" } },
+                          @{ @"agent_defaults": @{ @"permission_modes": @{ @"claude": @"bypassPermissions" } } },
+                          @{ @"agent_defaults": @{ @"permission_modes": @{ @"codex": @"dangerous" } } },
+                          @{ @"agent_defaults": @{ @"models": @{ @"claude": @"--dangerously-skip-permissions" } } },
+                          @{ @"retained_run_tabs": @0 },
+                          @{ @"double_escape_interval_ms": @5000 },
+                          @{ @"timezone": @"Mars/Olympus" },
+                          @{ @"summaries": @1 },
+                          @{ @"global_shortcut": @{} },
+                          @{ @"launch_at_login": @YES },
+                          @{ @"sidebar_groups": @[] },
+                          @{ @"retained_run_tabs": @5, @"layout": @{} } ];
+    for (NSDictionary *changes in invalid) {
+        NSDictionary *response = [self setSettings:changes];
+        XCTAssertEqualObjects((response[@"ok"]), @NO, @"%@", changes);
+        XCTAssertEqualObjects((response[@"code"]), @"invalid_settings", @"%@", changes);
+    }
+    // A rejected request writes nothing, not even its valid keys.
+    XCTAssertEqualObjects(([_scheduler settings][@"retained_run_tabs"]), @12);
+}
+
+- (void)testHandEditedNotificationSettingsKeepValidFields {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSDictionary *stored = @{ @"notifications": @{ @"muted_until": @"later",
+                                                   @"levels": @{ @"info": @{ @"banner": @YES, @"count": @"x" } },
+                                                   @"kinds": @{ @"storage": @"inbox", @"bogus": @"inbox" } },
+                              @"agent_defaults": @{ @"provider": @"llama", @"overlap": @"parallel" } };
+    NSData *data = [NSJSONSerialization dataWithJSONObject:stored options:0 error:nil];
+    XCTAssertTrue([data writeToFile:[_scheduler valueForKey:@"settingsPath"] atomically:YES]);
+    NSDictionary *settings = [_scheduler settings];
+    XCTAssertEqualObjects((settings[@"notifications"][@"muted_until"]), @0);
+    XCTAssertEqualObjects((settings[@"notifications"][@"levels"][@"info"][@"banner"]), @YES);
+    XCTAssertEqualObjects((settings[@"notifications"][@"levels"][@"info"][@"count"]), @NO);
+    XCTAssertEqualObjects((settings[@"notifications"][@"kinds"][@"storage"]), @"inbox");
+    XCTAssertNil(settings[@"notifications"][@"kinds"][@"bogus"]);
+    XCTAssertEqualObjects((settings[@"agent_defaults"][@"provider"]), @"claude");
+    XCTAssertEqualObjects((settings[@"agent_defaults"][@"overlap"]), @"parallel");
+}
+
+- (void)testMutedUrgentNotificationIsStoredWithoutABanner {
+    [self startSchedulerWithAgentTimeout:@7200];
+    XCTAssertEqualObjects(([self setSettings:@{ @"notifications": @{ @"muted_until": @"forever" } }][@"ok"]), @YES);
+    [self notify:@{ @"title": @"Deploy blocked", @"severity": @"urgent" }];
+    NSDictionary *listed = [self notifications:@{ @"unread": @YES }];
+    XCTAssertEqual(([listed[@"notifications"] count]), 1);
+    XCTAssertEqualObjects((listed[@"notifications"][0][@"alert"][@"banner"]), @NO);
+    XCTAssertEqualObjects((listed[@"attention_count"]), @1);
+    XCTAssertEqualObjects((listed[@"muted"]), @YES);
+    XCTAssertEqual(([[self notifications:@{ @"unread": @YES, @"bannerable": @YES }][@"notifications"] count]), 0);
+
+    XCTAssertEqualObjects(([self setSettings:@{ @"notifications": @{ @"muted_until": @0 } }][@"ok"]), @YES);
+    NSArray *bannerable = [self notifications:@{ @"unread": @YES, @"bannerable": @YES }][@"notifications"];
+    XCTAssertEqual((bannerable.count), 1);
+    XCTAssertEqualObjects(([self notifications:@{}][@"muted"]), @NO);
+}
+
+- (void)testCountsFollowTheNotificationSettings {
+    [self startSchedulerWithAgentTimeout:@7200];
+    [self notify:@{ @"title": @"FYI", @"severity": @"info" }];
+    // No diff: an asynchronous capture would outlive the test.
+    [self notify:@{ @"title": @"Look", @"severity": @"attention", @"run_id": @"none", @"agent": @"Review",
+                    @"include_diff": @NO }];
+    XCTAssertEqualObjects(([self notifications:@{}][@"attention_count"]), @1);
+    XCTAssertEqualObjects(([self setSettings:@{ @"notifications": @{ @"levels": @{ @"info": @{ @"count": @YES } },
+                                                                     @"agents": @{ @"Review": @"inbox" } } }][@"ok"]), @YES);
+    NSDictionary *listed = [self notifications:@{}];
+    XCTAssertEqualObjects((listed[@"attention_count"]), @1);
+    NSArray *counted = [self notifications:@{ @"counted": @YES }][@"notifications"];
+    XCTAssertEqual((counted.count), 1);
+    XCTAssertEqualObjects((counted.firstObject[@"title"]), @"FYI");
+}
+
+- (void)testNotificationKindsComeFromTheProducer {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSString *agentID = [self notify:@{ @"title": @"Agent says" }][@"id"];
+    NSDictionary *compaction = [self notify:@{ @"title": @"Compact", @"kind": @"compaction" }];
+    XCTAssertEqualObjects((compaction[@"ok"]), @YES);
+    for (id kind in @[ @"run_limit", @"bogus", @5 ]) {
+        XCTAssertEqualObjects(([self notify:@{ @"title": @"x", @"kind": kind }][@"ok"]), @NO, @"%@", kind);
+    }
+    [_scheduler raiseKnowledgeNotification:@{ @"title": @"Storage", @"severity": @"attention",
+                                              @"dedupe_key": @"knowledge-storage-budget" }];
+    NSArray *rows = [self notifications:@{}][@"notifications"];
+    NSMutableDictionary *kinds = [NSMutableDictionary dictionary];
+    for (NSDictionary *row in rows) kinds[row[@"title"]] = row[@"kind"];
+    XCTAssertEqualObjects((kinds[@"Agent says"]), @"agent");
+    XCTAssertEqualObjects((kinds[@"Compact"]), @"compaction");
+    XCTAssertEqualObjects((kinds[@"Storage"]), @"storage");
+    NSArray *agentRows = [self notifications:@{ @"kind": @"agent" }][@"notifications"];
+    XCTAssertEqual((agentRows.count), 1);
+    XCTAssertEqualObjects((agentRows.firstObject[@"id"]), agentID);
+}
+
+- (void)testRunLimitSummaryIsItsOwnKind {
+    [self startSchedulerWithAgentTimeout:@7200];
+    for (NSInteger index = 0; index < 21; index++) {
+        [self notify:@{ @"title": [NSString stringWithFormat:@"Item %ld", (long)index], @"run_id": @"run-a" }];
+    }
+    NSArray *rows = [self notifications:@{ @"kind": @"run_limit" }][@"notifications"];
+    XCTAssertEqual((rows.count), 1);
+}
+
+- (void)testExistingNotificationsGetAKindFromTheirDedupeKey {
+    sqlite3 *database = NULL;
+    NSString *path = [_temporaryPath stringByAppendingPathComponent:@"scheduler.sqlite"];
+    XCTAssertEqual((sqlite3_open(path.fileSystemRepresentation, &database)), SQLITE_OK);
+    // An older database: no kind column.
+    const char *setup = "CREATE TABLE notifications (id TEXT PRIMARY KEY, created REAL NOT NULL, updated REAL NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL, severity TEXT NOT NULL, agent TEXT, run_id TEXT, workspace TEXT, read REAL, dedupe_key TEXT, suppressed INTEGER NOT NULL DEFAULT 0, diff_state TEXT, diff_path TEXT, diff_files TEXT);"
+        "INSERT INTO notifications(id,created,updated,title,body,severity,dedupe_key) VALUES"
+        "('a',1,1,'A','','attention','wrap-up-r1'),('b',1,1,'B','','attention','knowledge-storage-budget'),"
+        "('c',1,1,'C','','urgent',NULL),('d',1,1,'D','','attention','omni:run-limit:r2');";
+    XCTAssertEqual((sqlite3_exec(database, setup, NULL, NULL, NULL)), SQLITE_OK);
+    sqlite3_close(database);
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSMutableDictionary *kinds = [NSMutableDictionary dictionary];
+    for (NSDictionary *row in [_scheduler rowsForSQL:@"SELECT id, kind FROM notifications" bindings:@[]]) kinds[row[@"id"]] = row[@"kind"];
+    XCTAssertEqualObjects((kinds), (@{ @"a": @"wrap_up", @"b": @"storage", @"c": @"agent", @"d": @"run_limit" }));
+}
+
+@end
