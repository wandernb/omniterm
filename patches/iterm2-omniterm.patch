+static NSDate *OmniMonthlyOccurrence(NSCalendar *calendar,
+                                     NSDate *anchor,
+                                     NSInteger monthOffset,
+                                     NSInteger requestedDay,
+                                     NSInteger hour,
+                                     NSInteger minute) {
+    NSDateComponents *anchorComponents = [calendar components:(NSCalendarUnitYear | NSCalendarUnitMonth)
+                                                      fromDate:anchor];
+    const NSInteger monthIndex = anchorComponents.year * 12 + anchorComponents.month - 1 + monthOffset;
+    NSDateComponents *components = [[[NSDateComponents alloc] init] autorelease];
+    components.year = monthIndex / 12;
+    components.month = monthIndex % 12 + 1;
+    components.day = 1;
+    components.hour = hour;
+    components.minute = minute;
+    NSDate *first = [calendar dateFromComponents:components];
+    const NSRange days = [calendar rangeOfUnit:NSCalendarUnitDay
+                                        inUnit:NSCalendarUnitMonth
+                                       forDate:first];
+    components.day = MIN(MAX(1, requestedDay), (NSInteger)days.length);
+    return [calendar dateFromComponents:components];
+}
