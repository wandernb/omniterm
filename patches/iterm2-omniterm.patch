+// Holds the Agents/Sessions/Projects switch as a row under the shared
+// pages' panel, close to the list it switches.
+private final class OmniSidebarModeSwitchCell: NSTableCellView {
+    static let controlTop: CGFloat = 10
+    static let controlHeight: CGFloat = 24
+    static let bottomMargin: CGFloat = 3
+    static let rowHeight = controlTop + controlHeight + bottomMargin
+    private weak var control: NSView?
+
+    override var isFlipped: Bool { true }
+
+    func host(_ control: NSView) {
+        control.removeFromSuperview()
+        addSubview(control)
+        self.control = control
+        needsLayout = true
+    }
+
+    override func layout() {
+        super.layout()
+        guard let control else { return }
+        // Span the row like the panel above, not the indented cell.
+        let inset = OmniTheme.Sidebar.panelInsetX
+        let rowWidth = superview?.bounds.width ?? bounds.width
+        let width = max(60, rowWidth - inset * 2)
+        control.frame = NSRect(x: inset - frame.minX, y: Self.controlTop, width: width, height: Self.controlHeight)
+        if let segments = control as? NSSegmentedControl {
+            Self.fit(segments, width: width - 8)
+        }
+    }
+
+    // Every segment shows its icon and label when they fit; in a narrow
+    // sidebar the others keep only their icons and the selected one its
+    // label too.
+    static let labels = ["Projects", "Sessions", "Agents"]
+    private static let segmentChrome: CGFloat = 32
+    private static let iconOnlyWidth: CGFloat = 34
+
+    static func fit(_ segments: NSSegmentedControl, width: CGFloat) {
+        let count = min(segments.segmentCount, labels.count)
+        guard count > 0 else { return }
+        let font = segments.font ?? NSFont.systemFont(ofSize: NSFont.smallSystemFontSize)
+        let needed = labels.prefix(count).map { ($0 as NSString).size(withAttributes: [.font: font]).width + segmentChrome }
+        let share = floor(width / CGFloat(count))
+        let allFit = needed.allSatisfy { $0 <= share }
+        for segment in 0..<count {
+            let selected = segment == segments.selectedSegment
+            let showsLabel = allFit || selected
+            segments.setLabel(showsLabel ? labels[segment] : "", forSegment: segment)
+            let others = CGFloat(count - 1) * iconOnlyWidth
+            segments.setWidth(allFit ? share : (selected ? max(iconOnlyWidth, width - others) : iconOnlyWidth),
+                              forSegment: segment)
+        }
+    }
+
+}
