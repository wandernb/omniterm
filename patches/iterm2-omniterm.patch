+// The board: one column per status or priority, side by side.
+final class OmniTicketBoardView: NSView {
+    private struct Column {
+        let heading: OmniTicketGroupHeading
+        let list: OmniColumnView
+        let zone: OmniListZone
+    }
+
+    private var columns: [Column] = []
+    static let gap: CGFloat = 12
+    static let minimumWidth: CGFloat = 170
+
+    override var isFlipped: Bool { true }
+
+    func addColumn(title: String, symbol: SFSymbol, color: NSColor, zone: OmniListZone,
+                   items: [(key: String, view: OmniZoneItem)]) {
+        let heading = OmniTicketGroupHeading(title: title, count: items.count, symbol: symbol, color: color)
+        addSubview(heading)
+        let list = OmniColumnView()
+        list.inset = 6
+        list.topPadding = 6
+        list.bottomPadding = 6
+        list.wantsLayer = true
+        list.layer?.cornerRadius = 8
+        list.layer?.backgroundColor = OmniTheme.wellBackground.cgColor
+        list.overlay = zone
+        for item in items {
+            list.add(item.view, spacing: 6) { _ in OmniTicketRow.cardHeight }
+        }
+        zone.setItems(items)
+        addSubview(list)
+        columns.append(Column(heading: heading, list: list, zone: zone))
+    }
+
+    override func viewDidChangeEffectiveAppearance() {
+        super.viewDidChangeEffectiveAppearance()
+        effectiveAppearance.performAsCurrentDrawingAppearance {
+            for column in columns {
+                column.list.layer?.backgroundColor = OmniTheme.wellBackground.cgColor
+            }
+        }
+    }
+
+    // Lays the columns out across `width` and returns the board's height.
+    func layoutBoard(width: CGFloat) -> CGFloat {
+        guard !columns.isEmpty else { return 0 }
+        let count = CGFloat(columns.count)
+        let columnWidth = max(Self.minimumWidth, floor((width - Self.gap * (count - 1)) / count))
+        var height: CGFloat = 0
+        for column in columns {
+            height = max(height, column.list.layoutColumn(width: columnWidth))
+        }
+        height = max(height, 80)
+        for (index, column) in columns.enumerated() {
+            let x = CGFloat(index) * (columnWidth + Self.gap)
+            column.heading.frame = NSRect(x: x, y: 0, width: columnWidth, height: OmniTicketGroupHeading.height)
+            column.list.layoutColumn(width: columnWidth)
+            column.list.frame = NSRect(x: x, y: OmniTicketGroupHeading.height + 6, width: columnWidth, height: height)
+            column.zone.frame = column.list.bounds
+        }
+        let total = OmniTicketGroupHeading.height + 6 + height
+        setFrameSize(NSSize(width: width, height: total))
+        return total
+    }
+}
