+#import "OmniScheduler.h"
+
+@import SQLite3;
+#import <sys/socket.h>
+#import <sys/stat.h>
+#import <sys/un.h>
+#import <signal.h>
+
+@interface OmniScheduler ()
+@property(nonatomic, copy) void (^launchHandler)(NSString *, NSString *);
+@property(nonatomic) sqlite3 *database;
+@property(nonatomic) int listener;
+@property(nonatomic) dispatch_source_t listenerSource;
+@property(nonatomic) dispatch_source_t timer;
+@property(nonatomic, copy) NSString *supportPath;
+@property(nonatomic, copy) NSString *socketPath;
+@property(nonatomic, copy) NSString *instanceID;
+@property(nonatomic, copy) NSString *configPath;
+@property(nonatomic, copy) NSString *agentsPath;
+@property(nonatomic, copy) NSString *settingsPath;
+@property(nonatomic, copy) NSString *agentFilesFingerprint;
+- (id)nextRunForAgent:(NSDictionary *)agent after:(NSTimeInterval)timestamp;
+- (void)enforceRunRetention;
+- (void)reloadAgentFilesIfNeeded:(BOOL)force;
+- (BOOL)writeAgentFile:(NSDictionary *)agent;
+- (NSDictionary *)settings;
+- (NSString *)agentPathForName:(NSString *)name;
+- (NSDictionary *)configurationForAgent:(NSDictionary *)agent;
+- (NSDictionary *)startAgentNamed:(NSString *)name reason:(NSString *)reason resumeSessionID:(nullable NSString *)resumeSessionID;
+@end
+
+@implementation OmniScheduler
+
+- (instancetype)initWithLaunchHandler:(void (^)(NSString *, NSString *))launchHandler {
+    self = [super init];
+    if (self) {
+        _launchHandler = [launchHandler copy];
+        _listener = -1;
+        NSString *library = NSSearchPathForDirectoriesInDomains(NSApplicationSupportDirectory,
+                                                                 NSUserDomainMask,
+                                                                 YES).firstObject;
+        _supportPath = [[library stringByAppendingPathComponent:@"OmniTerm"] copy];
+        _socketPath = [[_supportPath stringByAppendingPathComponent:@"scheduler.sock"] copy];
+        _instanceID = [NSUUID.UUID.UUIDString.lowercaseString copy];
+        _configPath = [[NSHomeDirectory() stringByAppendingPathComponent:@".omni"] copy];
+        _agentsPath = [[_configPath stringByAppendingPathComponent:@"agents"] copy];
+        _settingsPath = [[_configPath stringByAppendingPathComponent:@"settings.json"] copy];
+    }
+    return self;
+}
+
+- (void)dealloc {
+    [self stop];
+    [_launchHandler release];
+    [_supportPath release];
+    [_socketPath release];
+    [_instanceID release];
+    [_configPath release];
+    [_agentsPath release];
+    [_settingsPath release];
+    [_agentFilesFingerprint release];
+    [super dealloc];
+}
+
+- (BOOL)execute:(NSString *)sql {
+    char *error = NULL;
+    const int result = sqlite3_exec(_database, sql.UTF8String, NULL, NULL, &error);
+    if (result != SQLITE_OK) {
+        NSLog(@"OmniScheduler SQL error: %s", error ?: "unknown");
+        sqlite3_free(error);
+        return NO;
+    }
+    return YES;
+}
+
+- (void)start {
+    if (_database) {
+        return;
+    }
+    [[NSFileManager defaultManager] createDirectoryAtPath:_supportPath
+                              withIntermediateDirectories:YES
+                                               attributes:@{ NSFilePosixPermissions: @0700 }
+                                                    error:nil];
+    chmod(_supportPath.fileSystemRepresentation, 0700);
+    NSString *databasePath = [_supportPath stringByAppendingPathComponent:@"scheduler.sqlite"];
+    const int openResult = sqlite3_open_v2(databasePath.fileSystemRepresentation,
+                        &_database,
+                        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX,
+                        NULL);
+    if (openResult != SQLITE_OK) {
+        NSString *message = [NSString stringWithFormat:@"sqlite open %d: %s", openResult,
+                             _database ? sqlite3_errmsg(_database) : "no handle"];
+        [message writeToFile:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"]
+                  atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        if (_database) sqlite3_close(_database);
+        _database = NULL;
+        return;
+    }
+    [self execute:@"PRAGMA journal_mode=WAL"];
+    chmod(databasePath.fileSystemRepresentation, 0600);
+    chmod([[databasePath stringByAppendingString:@"-wal"] fileSystemRepresentation], 0600);
+    chmod([[databasePath stringByAppendingString:@"-shm"] fileSystemRepresentation], 0600);
+    [self execute:@"PRAGMA foreign_keys=ON"];
+    [self execute:@"CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL)"];
+    [self execute:@"CREATE TABLE IF NOT EXISTS agents (name TEXT PRIMARY KEY, definition TEXT NOT NULL, enabled INTEGER NOT NULL, next_run REAL, last_run REAL)"];
+    [self execute:@"CREATE TABLE IF NOT EXISTS runs (id TEXT PRIMARY KEY, agent TEXT NOT NULL, state TEXT NOT NULL, reason TEXT, started REAL NOT NULL, finished REAL, pid INTEGER, pgid INTEGER, session_id TEXT, resume_session_id TEXT, FOREIGN KEY(agent) REFERENCES agents(name) ON DELETE CASCADE)"];
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN session_id TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN resume_session_id TEXT", NULL, NULL, NULL);
+    [self execute:@"INSERT OR REPLACE INTO metadata(key,value) VALUES('schema_version','2')"];
+
+    [[NSFileManager defaultManager] createDirectoryAtPath:_agentsPath
+                              withIntermediateDirectories:YES
+                                               attributes:@{ NSFilePosixPermissions: @0700 }
+                                                    error:nil];
+    chmod(_configPath.fileSystemRepresentation, 0700);
+    chmod(_agentsPath.fileSystemRepresentation, 0700);
+    if (![[NSFileManager defaultManager] fileExistsAtPath:_settingsPath]) {
+        NSDictionary *defaults = @{ @"schema_version": @1,
+                                    @"default_timeout_seconds": @7200,
+                                    @"retained_run_tabs": @10,
+                                    @"timezone": NSTimeZone.localTimeZone.name };
+        NSData *data = [NSJSONSerialization dataWithJSONObject:defaults options:NSJSONWritingPrettyPrinted error:nil];
+        [data writeToFile:_settingsPath options:NSDataWritingAtomic error:nil];
+        chmod(_settingsPath.fileSystemRepresentation, 0600);
+    } else {
+        NSData *data = [NSData dataWithContentsOfFile:_settingsPath];
+        NSMutableDictionary *settings = data ? [[NSJSONSerialization JSONObjectWithData:data options:NSJSONReadingMutableContainers error:nil] mutableCopy] : nil;
+        if (settings && !settings[@"timezone"]) {
+            settings[@"timezone"] = NSTimeZone.localTimeZone.name;
+            NSData *updated = [NSJSONSerialization dataWithJSONObject:settings
+                                                               options:(NSJSONWritingPrettyPrinted | NSJSONWritingSortedKeys)
+                                                                 error:nil];
+            [updated writeToFile:_settingsPath options:NSDataWritingAtomic error:nil];
+            chmod(_settingsPath.fileSystemRepresentation, 0600);
+        }
+        [settings release];
+    }
+    // One-time migration from database-only definitions to file-backed agents.
+    for (NSDictionary *row in [self rowsForSQL:@"SELECT * FROM agents" bindings:@[]]) {
+        NSDictionary *agent = [self decodedAgentRow:row];
+        if (![[NSFileManager defaultManager] fileExistsAtPath:[self agentPathForName:agent[@"name"]]]) {
+            [self writeAgentFile:agent];
+        }
+    }
+    [self reloadAgentFilesIfNeeded:YES];
+
+    unlink(_socketPath.fileSystemRepresentation);
+    _listener = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (_listener < 0) {
+        [@"socket creation failed" writeToFile:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        return;
+    }
+    struct sockaddr_un address = { 0 };
+    address.sun_family = AF_UNIX;
+    strlcpy(address.sun_path, _socketPath.fileSystemRepresentation, sizeof(address.sun_path));
+    if (bind(_listener, (struct sockaddr *)&address, sizeof(address)) != 0 || listen(_listener, 16) != 0) {
+        NSString *message = [NSString stringWithFormat:@"socket bind/listen failed: %s", strerror(errno)];
+        [message writeToFile:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        close(_listener);
+        _listener = -1;
+        return;
+    }
+    chmod(_socketPath.fileSystemRepresentation, 0600);
+    [[NSFileManager defaultManager] removeItemAtPath:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"] error:nil];
+    _listenerSource = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, _listener, 0,
+                                              dispatch_get_main_queue());
+    __block OmniScheduler *weakSelf = self;
+    dispatch_source_set_event_handler(_listenerSource, ^{
+        [weakSelf acceptClient];
+    });
+    dispatch_resume(_listenerSource);
+
+    _timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+    dispatch_source_set_timer(_timer, dispatch_time(DISPATCH_TIME_NOW, 0), 2 * NSEC_PER_SEC,
+                              250 * NSEC_PER_MSEC);
+    dispatch_source_set_event_handler(_timer, ^{
+        [weakSelf checkNow];
+    });
+    dispatch_resume(_timer);
+}
+
+- (void)stop {
+    if (_timer) {
+        dispatch_source_cancel(_timer);
+        dispatch_release(_timer);
+        _timer = nil;
+    }
+    if (_listenerSource) {
+        dispatch_source_cancel(_listenerSource);
+        dispatch_release(_listenerSource);
+        _listenerSource = nil;
+    }
+    if (_listener >= 0) {
+        close(_listener);
+        _listener = -1;
+    }
+    unlink(_socketPath.fileSystemRepresentation);
+    if (_database) {
+        sqlite3_close(_database);
+        _database = NULL;
+    }
+}
+
+- (void)acceptClient {
+    const int client = accept(_listener, NULL, NULL);
+    if (client < 0) {
+        return;
+    }
+    uid_t peerUID = (uid_t)-1;
+    gid_t peerGID = (gid_t)-1;
+    if (getpeereid(client, &peerUID, &peerGID) != 0 || peerUID != geteuid()) {
+        close(client);
+        return;
+    }
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        NSMutableData *data = [NSMutableData data];
+        char buffer[8192];
+        while (data.length < 1024 * 1024) {
+            const ssize_t count = read(client, buffer, sizeof(buffer));
+            if (count <= 0) break;
+            [data appendBytes:buffer length:(NSUInteger)count];
+            if (memchr(buffer, '\n', (size_t)count)) break;
+        }
+        NSDictionary *request = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+        __block NSDictionary *response = nil;
+        dispatch_sync(dispatch_get_main_queue(), ^{
+            response = [[self handleRequest:request ?: @{}] retain];
+        });
+        NSData *encoded = [NSJSONSerialization dataWithJSONObject:response options:0 error:nil];
+        write(client, encoded.bytes, encoded.length);
+        write(client, "\n", 1);
+        [response release];
+        close(client);
+    });
+}
+
+- (NSArray *)rowsForSQL:(NSString *)sql bindings:(NSArray *)bindings {
+    sqlite3_stmt *statement = NULL;
+    NSMutableArray *rows = [NSMutableArray array];
+    if (sqlite3_prepare_v2(_database, sql.UTF8String, -1, &statement, NULL) != SQLITE_OK) {
+        return rows;
+    }
+    [bindings enumerateObjectsUsingBlock:^(id value, NSUInteger index, BOOL *stop) {
+        if ([value isKindOfClass:[NSNumber class]]) {
+            sqlite3_bind_double(statement, (int)index + 1, [value doubleValue]);
+        } else if (value == [NSNull null]) {
+            sqlite3_bind_null(statement, (int)index + 1);
+        } else {
+            sqlite3_bind_text(statement, (int)index + 1, [value UTF8String], -1, SQLITE_TRANSIENT);
+        }
+    }];
+    while (sqlite3_step(statement) == SQLITE_ROW) {
+        NSMutableDictionary *row = [NSMutableDictionary dictionary];
+        for (int column = 0; column < sqlite3_column_count(statement); column++) {
+            NSString *key = [NSString stringWithUTF8String:sqlite3_column_name(statement, column)];
+            const int type = sqlite3_column_type(statement, column);
+            if (type == SQLITE_INTEGER) row[key] = @(sqlite3_column_int64(statement, column));
+            else if (type == SQLITE_FLOAT) row[key] = @(sqlite3_column_double(statement, column));
+            else if (type == SQLITE_TEXT) row[key] = [NSString stringWithUTF8String:(const char *)sqlite3_column_text(statement, column)];
+            else row[key] = [NSNull null];
+        }
+        [rows addObject:row];
+    }
+    sqlite3_finalize(statement);
+    return rows;
+}
+
+- (BOOL)runSQL:(NSString *)sql bindings:(NSArray *)bindings {
+    sqlite3_stmt *statement = NULL;
+    if (sqlite3_prepare_v2(_database, sql.UTF8String, -1, &statement, NULL) != SQLITE_OK) return NO;
+    [bindings enumerateObjectsUsingBlock:^(id value, NSUInteger index, BOOL *stop) {
+        if ([value isKindOfClass:[NSNumber class]]) sqlite3_bind_double(statement, (int)index + 1, [value doubleValue]);
+        else if (value == [NSNull null]) sqlite3_bind_null(statement, (int)index + 1);
+        else sqlite3_bind_text(statement, (int)index + 1, [value UTF8String], -1, SQLITE_TRANSIENT);
+    }];
+    const BOOL ok = sqlite3_step(statement) == SQLITE_DONE;
+    sqlite3_finalize(statement);
+    return ok;
+}
+
+- (NSDictionary *)decodedAgentRow:(NSDictionary *)row {
+    NSData *data = [row[@"definition"] dataUsingEncoding:NSUTF8StringEncoding];
+    NSMutableDictionary *agent = [[NSJSONSerialization JSONObjectWithData:data options:NSJSONReadingMutableContainers error:nil] mutableCopy];
+    agent[@"enabled"] = @([row[@"enabled"] boolValue]);
+    agent[@"next_run"] = row[@"next_run"];
+    agent[@"last_run"] = row[@"last_run"];
+    return [agent autorelease];
+}
+
+- (NSDictionary *)configurationForAgent:(NSDictionary *)agent {
+    NSMutableDictionary *configuration = [[agent mutableCopy] autorelease];
+    [configuration removeObjectForKey:@"next_run"];
+    [configuration removeObjectForKey:@"last_run"];
+    [configuration removeObjectForKey:@"timezone"];
+    return configuration;
+}
+
+- (NSString *)agentPathForName:(NSString *)name {
+    NSMutableCharacterSet *allowed = [[[NSCharacterSet alphanumericCharacterSet] mutableCopy] autorelease];
+    [allowed addCharactersInString:@"-_"];
+    NSString *filename = [name stringByAddingPercentEncodingWithAllowedCharacters:allowed];
+    return [_agentsPath stringByAppendingPathComponent:[filename stringByAppendingPathExtension:@"json"]];
+}
+
+- (BOOL)writeAgentFile:(NSDictionary *)agent {
+    NSDictionary *configuration = [self configurationForAgent:agent];
+    NSData *data = [NSJSONSerialization dataWithJSONObject:configuration
+                                                   options:(NSJSONWritingPrettyPrinted | NSJSONWritingSortedKeys)
+                                                     error:nil];
+    NSString *path = [self agentPathForName:agent[@"name"]];
+    const BOOL ok = [data writeToFile:path options:NSDataWritingAtomic error:nil];
+    if (ok) chmod(path.fileSystemRepresentation, 0600);
+    return ok;
+}
+
+- (NSDictionary *)settings {
+    NSData *data = [NSData dataWithContentsOfFile:_settingsPath];
+    NSDictionary *settings = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+    if (![settings isKindOfClass:[NSDictionary class]]) {
+        return @{ @"schema_version": @1,
+                  @"default_timeout_seconds": @7200,
+                  @"retained_run_tabs": @10,
+                  @"timezone": NSTimeZone.localTimeZone.name };
+    }
+    return settings;
+}
+
+- (void)reloadAgentFilesIfNeeded:(BOOL)force {
+    NSArray *files = [[[NSFileManager defaultManager] contentsOfDirectoryAtPath:_agentsPath error:nil]
+        filteredArrayUsingPredicate:[NSPredicate predicateWithBlock:^BOOL(NSString *name, NSDictionary *bindings) {
+            return [name.pathExtension.lowercaseString isEqualToString:@"json"];
+        }]];
+    files = [files sortedArrayUsingSelector:@selector(compare:)];
+    NSMutableString *fingerprint = [NSMutableString string];
+    for (NSString *filename in files) {
+        NSString *path = [_agentsPath stringByAppendingPathComponent:filename];
+        NSDictionary *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:path error:nil];
+        [fingerprint appendFormat:@"%@:%@:%@;", filename, attributes[NSFileModificationDate], attributes[NSFileSize]];
+    }
+    if (!force && [_agentFilesFingerprint isEqualToString:fingerprint]) return;
+    self.agentFilesFingerprint = fingerprint;
+
+    NSMutableSet *names = [NSMutableSet set];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    for (NSString *filename in files) {
+        NSString *path = [_agentsPath stringByAppendingPathComponent:filename];
+        NSData *data = [NSData dataWithContentsOfFile:path];
+        NSMutableDictionary *agent = data ? [[NSJSONSerialization JSONObjectWithData:data options:NSJSONReadingMutableContainers error:nil] mutableCopy] : nil;
+        if (![agent isKindOfClass:[NSDictionary class]] || ![agent[@"name"] isKindOfClass:[NSString class]]) {
+            [agent release];
+            continue;
+        }
+        if (agent[@"timezone"]) {
+            [agent removeObjectForKey:@"timezone"];
+            [self writeAgentFile:agent];
+        }
+        [names addObject:agent[@"name"]];
+        NSData *encoded = [NSJSONSerialization dataWithJSONObject:agent options:NSJSONWritingSortedKeys error:nil];
+        NSString *json = [[[NSString alloc] initWithData:encoded encoding:NSUTF8StringEncoding] autorelease];
+        NSArray *existing = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ agent[@"name"] ]];
+        NSDictionary *oldConfiguration = existing.count ? [self configurationForAgent:[self decodedAgentRow:existing.firstObject]] : nil;
+        const BOOL changed = ![oldConfiguration isEqual:agent];
+        id nextRun = nil;
+        if (existing.count && !changed) {
+            nextRun = existing.firstObject[@"next_run"];
+        } else if ([agent[@"schedule"][@"kind"] isEqualToString:@"once"]) {
+            nextRun = agent[@"schedule"][@"at"] ?: [NSNull null];
+        } else {
+            nextRun = [self nextRunForAgent:agent after:now];
+        }
+        [self runSQL:@"INSERT INTO agents(name,definition,enabled,next_run) VALUES(?,?,?,?) ON CONFLICT(name) DO UPDATE SET definition=excluded.definition,enabled=excluded.enabled,next_run=excluded.next_run"
+            bindings:@[ agent[@"name"], json, agent[@"enabled"] ?: @YES, nextRun ?: [NSNull null] ]];
+        [agent release];
+    }
+    for (NSDictionary *row in [self rowsForSQL:@"SELECT name FROM agents" bindings:@[]]) {
+        if (![names containsObject:row[@"name"]]) {
+            [self runSQL:@"DELETE FROM agents WHERE name=?" bindings:@[ row[@"name"] ]];
+        }
+    }
+}
+
+- (NSDictionary *)handleRequest:(NSDictionary *)request {
+    NSString *operation = request[@"op"];
+    if ([operation isEqualToString:@"ping"]) {
+        return @{ @"ok": @YES, @"instance_id": _instanceID };
+    }
+    if ([operation isEqualToString:@"get_settings"]) {
+        return @{ @"ok": @YES, @"settings": [self settings] };
+    }
+    if ([operation isEqualToString:@"list_agents"]) {
+        NSArray *rows = [self rowsForSQL:@"SELECT * FROM agents ORDER BY name" bindings:@[]];
+        NSMutableArray *agents = [NSMutableArray array];
+        for (NSDictionary *row in rows) {
+            [agents addObject:[self decodedAgentRow:row]];
+        }
+        return @{ @"ok": @YES, @"agents": agents };
+    }
+    if ([operation isEqualToString:@"show_agent"] || [operation isEqualToString:@"run_spec"]) {
+        NSString *name = request[@"name"];
+        NSDictionary *run = nil;
+        if ([operation isEqualToString:@"run_spec"]) {
+            NSArray *runs = [self rowsForSQL:@"SELECT * FROM runs WHERE id=?" bindings:@[ request[@"run_id"] ?: @"" ]];
+            run = runs.firstObject;
+            name = run[@"agent"];
+        }
+        NSArray *rows = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ name ?: @"" ]];
+        if (!rows.count) return @{ @"ok": @NO, @"error": @"Agent not found" };
+        return run ? @{ @"ok": @YES, @"agent": [self decodedAgentRow:rows.firstObject], @"run": run } : @{ @"ok": @YES, @"agent": [self decodedAgentRow:rows.firstObject] };
+    }
+    if ([operation isEqualToString:@"create_agent"] || [operation isEqualToString:@"update_agent"]) {
+        NSDictionary *agent = request[@"agent"];
+        NSString *name = [agent[@"name"] isKindOfClass:[NSString class]] ? agent[@"name"] : @"";
+        NSArray *existing = [self rowsForSQL:@"SELECT name FROM agents WHERE name=?" bindings:@[ name ]];
+        if ([operation isEqualToString:@"create_agent"] && existing.count) {
+            return @{ @"ok": @NO, @"code": @"agent_exists", @"error": @"Agent already exists" };
+        }
+        if ([operation isEqualToString:@"update_agent"] && !existing.count) {
+            return @{ @"ok": @NO, @"code": @"agent_not_found", @"error": @"Agent not found" };
+        }
+        if (!name.length || ![agent[@"provider"] isKindOfClass:[NSString class]] ||
+            ![agent[@"workspace"] isKindOfClass:[NSString class]] ||
+            ![agent[@"schedule"] isKindOfClass:[NSDictionary class]]) {
+            return @{ @"ok": @NO, @"code": @"invalid_agent", @"error": @"Incomplete agent definition" };
+        }
+        if (![self writeAgentFile:agent]) {
+            return @{ @"ok": @NO, @"code": @"write_failed", @"error": @"Could not write agent configuration" };
+        }
+        NSDictionary *configuration = [self configurationForAgent:agent];
+        NSData *data = [NSJSONSerialization dataWithJSONObject:configuration options:NSJSONWritingSortedKeys error:nil];
+        NSString *json = [[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease];
+        const BOOL ok = [self runSQL:@"INSERT INTO agents(name,definition,enabled,next_run) VALUES(?,?,?,?) ON CONFLICT(name) DO UPDATE SET definition=excluded.definition,enabled=excluded.enabled,next_run=excluded.next_run"
+                              bindings:@[ name, json, agent[@"enabled"] ?: @YES, agent[@"next_run"] ?: [NSNull null] ]];
+        self.agentFilesFingerprint = nil;
+        return @{ @"ok": @(ok), @"agent": [self decodedAgentRow:[self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ name ]].firstObject] };
+    }
+    if ([operation isEqualToString:@"save_agent"]) {
+        NSDictionary *agent = request[@"agent"];
+        if (![self writeAgentFile:agent]) return @{ @"ok": @NO, @"error": @"Could not write agent configuration" };
+        NSDictionary *configuration = [self configurationForAgent:agent];
+        NSData *data = [NSJSONSerialization dataWithJSONObject:configuration options:NSJSONWritingSortedKeys error:nil];
+        NSString *json = [[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease];
+        const BOOL ok = [self runSQL:@"INSERT INTO agents(name,definition,enabled,next_run) VALUES(?,?,?,?) ON CONFLICT(name) DO UPDATE SET definition=excluded.definition,enabled=excluded.enabled,next_run=excluded.next_run"
+                              bindings:@[ agent[@"name"], json, agent[@"enabled"] ?: @YES, agent[@"next_run"] ?: [NSNull null] ]];
+        self.agentFilesFingerprint = nil;
+        return @{ @"ok": @(ok) };
+    }
+    if ([operation isEqualToString:@"delete_agent"]) {
+        NSString *name = request[@"name"] ?: @"";
+        [[NSFileManager defaultManager] removeItemAtPath:[self agentPathForName:name] error:nil];
+        self.agentFilesFingerprint = nil;
+        return @{ @"ok": @([self runSQL:@"DELETE FROM agents WHERE name=?" bindings:@[ name ]]) };
+    }
+    if ([operation isEqualToString:@"set_enabled"]) {
+        NSArray *rows = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ request[@"name"] ]];
+        if (!rows.count) return @{ @"ok": @NO, @"error": @"Agent not found" };
+        NSMutableDictionary *agent = [[[self decodedAgentRow:rows.firstObject] mutableCopy] autorelease];
+        agent[@"enabled"] = request[@"enabled"];
+        if (![self writeAgentFile:agent]) return @{ @"ok": @NO, @"error": @"Could not write agent configuration" };
+        self.agentFilesFingerprint = nil;
+        return @{ @"ok": @([self runSQL:@"UPDATE agents SET enabled=? WHERE name=?" bindings:@[ request[@"enabled"], request[@"name"] ]]) };
+    }
+    if ([operation isEqualToString:@"run_agent"]) {
+        return [self startAgentNamed:request[@"name"] reason:@"manual" resumeSessionID:nil];
+    }
+    if ([operation isEqualToString:@"resume_run"]) {
+        NSArray *rows = [self rowsForSQL:@"SELECT agent,session_id FROM runs WHERE id=?" bindings:@[ request[@"run_id"] ?: @"" ]];
+        NSDictionary *run = rows.firstObject;
+        NSString *sessionID = [run[@"session_id"] isKindOfClass:[NSString class]] ? run[@"session_id"] : nil;
+        if (!sessionID.length) return @{ @"ok": @NO, @"error": @"This run has no resumable provider session ID" };
+        return [self startAgentNamed:run[@"agent"] reason:@"resumed" resumeSessionID:sessionID];
+    }
+    if ([operation isEqualToString:@"list_runs"]) {
+        NSString *name = request[@"name"];
+        NSString *sql = name.length ? @"SELECT * FROM runs WHERE agent=? ORDER BY started DESC LIMIT 100" : @"SELECT * FROM runs ORDER BY started DESC LIMIT 100";
+        return @{ @"ok": @YES, @"runs": [self rowsForSQL:sql bindings:name.length ? @[ name ] : @[]] };
+    }
+    if ([operation isEqualToString:@"runner_started"]) {
+        [self runSQL:@"UPDATE runs SET state='running',pid=?,pgid=?,session_id=COALESCE(?,session_id) WHERE id=?"
+            bindings:@[ request[@"pid"], request[@"pgid"], request[@"session_id"] ?: [NSNull null], request[@"run_id"] ]];
+        return @{ @"ok": @YES };
+    }
+    if ([operation isEqualToString:@"runner_session"]) {
+        [self runSQL:@"UPDATE runs SET session_id=? WHERE id=?"
+            bindings:@[ request[@"session_id"], request[@"run_id"] ]];
+        return @{ @"ok": @YES };
+    }
+    if ([operation isEqualToString:@"runner_finished"]) {
+        NSArray *existing = [self rowsForSQL:@"SELECT state,pid FROM runs WHERE id=?"
+                                     bindings:@[ request[@"run_id"] ]];
+        NSDictionary *run = existing.firstObject;
+        if ([run[@"state"] isEqualToString:@"evicting"]) {
+            [self runSQL:@"UPDATE runs SET state='evicted',reason='retention age',finished=? WHERE id=?"
+                bindings:@[ @([NSDate date].timeIntervalSince1970), request[@"run_id"] ]];
+            const pid_t runnerPID = [run[@"pid"] intValue];
+            if (runnerPID > 1) {
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 200 * NSEC_PER_MSEC),
+                               dispatch_get_main_queue(), ^{
+                    kill(runnerPID, SIGUSR1);
+                });
+            }
+        } else {
+            [self runSQL:@"UPDATE runs SET state=?,reason=?,finished=? WHERE id=?"
+                bindings:@[ request[@"state"] ?: @"completed", request[@"reason"] ?: @"exited", @([NSDate date].timeIntervalSince1970), request[@"run_id"] ]];
+        }
+        [self enforceRunRetention];
+        return @{ @"ok": @YES };
+    }
+    if ([operation isEqualToString:@"stop_run"]) {
+        NSArray *rows = [self rowsForSQL:@"SELECT pgid FROM runs WHERE id=? AND state IN ('starting','running')" bindings:@[ request[@"run_id"] ?: @"" ]];
+        const pid_t processGroup = (pid_t)[[rows.firstObject objectForKey:@"pgid"] intValue];
+        if (processGroup > 1) kill(-processGroup, SIGTERM);
+        return @{ @"ok": @(rows.count > 0) };
+    }
+    return @{ @"ok": @NO, @"error": @"Unknown operation" };
+}
+
+- (NSDictionary *)startAgentNamed:(NSString *)name reason:(NSString *)reason resumeSessionID:(NSString *)resumeSessionID {
+    NSArray *rows = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ name ?: @"" ]];
+    if (!rows.count) return @{ @"ok": @NO, @"error": @"Agent not found" };
+    NSDictionary *agent = [self decodedAgentRow:rows.firstObject];
+    NSArray *active = [self rowsForSQL:@"SELECT id,pgid FROM runs WHERE agent=? AND state IN ('starting','running')" bindings:@[ name ]];
+    if ([agent[@"overlap"] isEqualToString:@"replace"]) {
+        for (NSDictionary *run in active) {
+            const pid_t processGroup = [run[@"pgid"] intValue];
+            if (processGroup > 1) {
+                kill(-processGroup, SIGTERM);
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC),
+                               dispatch_get_main_queue(), ^{
+                    if (kill(-processGroup, 0) == 0) kill(-processGroup, SIGKILL);
+                });
+            }
+            [self runSQL:@"UPDATE runs SET state='replaced',reason='replaced',finished=? WHERE id=?"
+                bindings:@[ @([NSDate date].timeIntervalSince1970), run[@"id"] ]];
+        }
+    }
+    NSString *runID = NSUUID.UUID.UUIDString.lowercaseString;
+    NSString *sessionID = resumeSessionID ?: ([agent[@"provider"] isEqualToString:@"claude"] ? runID : nil);
+    [self runSQL:@"INSERT INTO runs(id,agent,state,reason,started,session_id,resume_session_id) VALUES(?,?,'starting',?,?,?,?)"
+        bindings:@[ runID, name, reason, @([NSDate date].timeIntervalSince1970), sessionID ?: [NSNull null], resumeSessionID ?: [NSNull null] ]];
+    NSString *runner = [NSBundle.mainBundle pathForResource:@"omni-runner" ofType:nil inDirectory:@"Helpers"];
+    NSString *escapedRunner = [runner stringByReplacingOccurrencesOfString:@"'" withString:@"'\\''"];
+    NSString *command = [NSString stringWithFormat:@"'%@' %@", escapedRunner, runID];
+    self.launchHandler(command, [NSString stringWithFormat:@"AGENT · %@%@", name, resumeSessionID ? @" ↻" : @""]);
+    [self enforceRunRetention];
+    return @{ @"ok": @YES, @"run_id": runID };
+}
+
+- (void)enforceRunRetention {
+    NSArray *rows = [self rowsForSQL:@"SELECT runs.id,runs.pid,runs.pgid,runs.state,runs.started,agents.definition FROM runs JOIN agents ON agents.name=runs.agent WHERE runs.state!='evicted' ORDER BY runs.started DESC"
+                             bindings:@[]];
+    const NSUInteger retainedCount = MAX(1, MIN(100, [[self settings][@"retained_run_tabs"] unsignedIntegerValue] ?: 10));
+    if (rows.count <= retainedCount) return;
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    for (NSUInteger index = retainedCount; index < rows.count; index++) {
+        NSDictionary *run = rows[index];
+        NSDictionary *agent = [NSJSONSerialization JSONObjectWithData:[run[@"definition"] dataUsingEncoding:NSUTF8StringEncoding]
+                                                               options:0
+                                                                 error:nil];
+        NSNumber *timeout = agent[@"timeout_seconds"];
+        if (![timeout isKindOfClass:[NSNumber class]] || now - [run[@"started"] doubleValue] < timeout.doubleValue) {
+            continue;
+        }
+        if ([run[@"state"] isEqualToString:@"running"] || [run[@"state"] isEqualToString:@"starting"]) {
+            const pid_t processGroup = [run[@"pgid"] intValue];
+            if (processGroup <= 1) continue;
+            kill(-processGroup, SIGTERM);
+            [self runSQL:@"UPDATE runs SET state='evicting',reason='retention age' WHERE id=?"
+                bindings:@[ run[@"id"] ]];
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC),
+                           dispatch_get_main_queue(), ^{
+                if (kill(-processGroup, 0) == 0) kill(-processGroup, SIGKILL);
+            });
+            continue;
+        }
+        const pid_t runnerPID = [run[@"pid"] intValue];
+        if (runnerPID > 1) kill(runnerPID, SIGUSR1);
+        [self runSQL:@"UPDATE runs SET state='evicted',reason='retention age' WHERE id=?"
+            bindings:@[ run[@"id"] ]];
+    }
+}
+
+- (void)checkNow {
+    [self reloadAgentFilesIfNeeded:NO];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    NSArray *due = [self rowsForSQL:@"SELECT name,definition FROM agents WHERE enabled=1 AND next_run IS NOT NULL AND next_run<=?" bindings:@[ @(now) ]];
+    for (NSDictionary *row in due) {
+        NSDictionary *agent = [NSJSONSerialization JSONObjectWithData:[row[@"definition"] dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];
+        id next = [self nextRunForAgent:agent after:now];
+        [self runSQL:@"UPDATE agents SET last_run=?,next_run=? WHERE name=?" bindings:@[ @(now), next, row[@"name"] ]];
+        [self startAgentNamed:row[@"name"] reason:@"scheduled" resumeSessionID:nil];
+    }
+    [self enforceRunRetention];
+}
+
+- (id)nextRunForAgent:(NSDictionary *)agent after:(NSTimeInterval)timestamp {
+    NSDictionary *schedule = agent[@"schedule"];
+    NSString *kind = schedule[@"kind"];
+    if ([kind isEqualToString:@"once"]) return (id)[NSNull null];
+    if ([kind isEqualToString:@"interval"]) return @(timestamp + [schedule[@"interval_seconds"] doubleValue]);
+    NSTimeZone *zone = [NSTimeZone timeZoneWithName:[self settings][@"timezone"]] ?: NSTimeZone.localTimeZone;
+    NSCalendar *calendar = [[[NSCalendar alloc] initWithCalendarIdentifier:NSCalendarIdentifierGregorian] autorelease];
+    calendar.timeZone = zone;
+    NSDate *date = [NSDate dateWithTimeIntervalSince1970:timestamp];
+    NSDateComponents *components = [[[NSDateComponents alloc] init] autorelease];
+    components.hour = [schedule[@"hour"] integerValue];
+    components.minute = [schedule[@"minute"] integerValue];
+    if ([kind isEqualToString:@"weekly"]) {
+        // Python uses Monday=0; NSCalendar uses Sunday=1.
+        components.weekday = (([schedule[@"weekday"] integerValue] + 1) % 7) + 1;
+    }
+    NSDate *next = [calendar nextDateAfterDate:date
+                               matchingComponents:components
+                                          options:NSCalendarMatchNextTimePreservingSmallerUnits];
+    if ([kind isEqualToString:@"weekdays"]) {
+        while ([calendar isDateInWeekend:next]) {
+            next = [calendar nextDateAfterDate:next
+                            matchingComponents:components
+                                       options:NSCalendarMatchNextTimePreservingSmallerUnits];
+        }
+    }
+    return @(next.timeIntervalSince1970);
+}
+
+@end
