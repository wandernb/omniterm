+// The Inbox's unread count: a capsule with monospaced digits. Orange when
+// something needs the person; light on the selected row.
+final class OmniSidebarBadge: NSView {
+    var text = "" {
+        didSet { needsDisplay = true }
+    }
+    var needsAttention = false {
+        didSet { needsDisplay = true }
+    }
+    var isOnSelection = false {
+        didSet { needsDisplay = true }
+    }
+
+    private typealias Badge = OmniTheme.Sidebar.Badge
+
+    var fillColor: NSColor {
+        if isOnSelection {
+            return Badge.selectedFill
+        }
+        return needsAttention ? Badge.attentionFill : Badge.fill
+    }
+
+    var textColor: NSColor {
+        if isOnSelection {
+            return Badge.selectedText
+        }
+        return needsAttention ? Badge.attentionText : Badge.text
+    }
+
+    var fittingWidth: CGFloat {
+        let textWidth = ceil((text as NSString).size(withAttributes: [.font: Badge.font]).width)
+        return max(Badge.height, textWidth + Badge.horizontalPadding * 2)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        let radius = bounds.height / 2
+        fillColor.setFill()
+        NSBezierPath(roundedRect: bounds, xRadius: radius, yRadius: radius).fill()
+        let attributes: [NSAttributedString.Key: Any] = [.font: Badge.font, .foregroundColor: textColor]
+        let size = (text as NSString).size(withAttributes: attributes)
+        (text as NSString).draw(at: NSPoint(x: (bounds.width - size.width) / 2, y: (bounds.height - size.height) / 2),
+                                withAttributes: attributes)
+    }
+}
