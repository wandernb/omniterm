+
+// A job iTerm2 adopts from its server after a relaunch comes back without the
+// environment its tab was launched with. Run tabs are recognised by
+// OMNITERM_* variables, so they are read back from the job's own process.
+@objc(OmniProcessEnvironment)
+final class OmniProcessEnvironment: NSObject {
+    // The OMNITERM_* variables of a running process of this user; empty when
+    // it has none or cannot be read.
+    @objc(omniTermVariablesForProcess:)
+    static func omniTermVariables(forProcess pid: pid_t) -> [String: String] {
+        guard pid > 0, let data = processArguments(pid) else { return [:] }
+        return omniTermVariables(fromProcessArguments: data)
+    }
+
+    // KERN_PROCARGS2: argc, the executable path, padding, argv, then the
+    // environment, each NUL-terminated.
+    static func omniTermVariables(fromProcessArguments data: Data) -> [String: String] {
+        guard data.count > MemoryLayout<Int32>.size else { return [:] }
+        let argc = Int(data.withUnsafeBytes { $0.loadUnaligned(as: Int32.self) })
+        let bytes = [UInt8](data.dropFirst(MemoryLayout<Int32>.size))
+        var strings: [String] = []
+        var index = 0
+        // The executable path, then any padding NULs.
+        while index < bytes.count, bytes[index] != 0 { index += 1 }
+        while index < bytes.count, bytes[index] == 0 { index += 1 }
+        while index < bytes.count {
+            let start = index
+            while index < bytes.count, bytes[index] != 0 { index += 1 }
+            if index > start {
+                strings.append(String(decoding: bytes[start..<index], as: UTF8.self))
+            } else {
+                break
+            }
+            index += 1
+        }
+        guard strings.count >= argc else { return [:] }
+        var result: [String: String] = [:]
+        for entry in strings.dropFirst(argc) where entry.hasPrefix("OMNITERM_") {
+            guard let equals = entry.firstIndex(of: "=") else { continue }
+            result[String(entry[..<equals])] = String(entry[entry.index(after: equals)...])
+        }
+        return result
+    }
+
+    private static func processArguments(_ pid: pid_t) -> Data? {
+        var mib: [Int32] = [CTL_KERN, KERN_PROCARGS2, pid]
+        var size = 0
+        guard sysctl(&mib, 3, nil, &size, nil, 0) == 0, size > 0 else { return nil }
+        var buffer = [UInt8](repeating: 0, count: size)
+        guard sysctl(&mib, 3, &buffer, &size, nil, 0) == 0 else { return nil }
+        return Data(buffer.prefix(size))
+    }
+}
+
+// What OmniTerm changes about iTerm2's restoration of its window.
+@objc(OmniRestoration)
+final class OmniRestoration: NSObject {
+    // iTerm2 tells a session adopted from its job server that its contents
+    // were not saved. A run tab gets its run's page and report instead, so
+    // only other sessions are told.
+    @objc(announcesRestoredOrphanWithEnvironment:)
+    static func announcesRestoredOrphan(environment: [AnyHashable: Any]?) -> Bool {
+        guard let runID = environment?["OMNITERM_RUN_ID"] as? String else { return true }
+        return runID.isEmpty
+    }
+}
+
+// The sidebar's two modes: OmniTerm's agents and runs, or every Claude and
+// Codex session on the machine. Inbox, Memory and Settings show in both.
+enum OmniSidebarMode: String {
+    case agents
+    case sessions
+    case projects
+
+    // Its place in the sidebar's mode switch.
+    var segment: Int {
+        switch self {
+        case .projects: return 0
+        case .sessions: return 1
+        case .agents: return 2
+        }
+    }
+
+    init(segment: Int) {
+        switch segment {
+        case 0: self = .projects
+        case 1: self = .sessions
+        default: self = .agents
+        }
+    }
+
+    static let preferenceKey = "OmniSidebarMode" as CFString
+
+    static func stored(in domain: CFString) -> OmniSidebarMode {
+        let value = CFPreferencesCopyAppValue(preferenceKey, domain) as? String
+        return value.flatMap(OmniSidebarMode.init(rawValue:)) ?? .agents
+    }
+
+    func store(in domain: CFString) {
+        CFPreferencesSetAppValue(Self.preferenceKey, rawValue as CFString, domain)
+        CFPreferencesAppSynchronize(domain)
+    }
+}
+
+// How a provider session reads in the sidebar and on its page. Titles come
+// from transcripts: untrusted text, shown plain.
+enum OmniSessionText {
+    // A session title without the provider's markup (`<command-name>` and
+    // the like), on one line.
+    static func title(_ raw: String?) -> String {
+        var text = raw ?? ""
+        text = text.replacingOccurrences(of: "<[^>]{1,80}>", with: " ", options: .regularExpression)
+        text = text.components(separatedBy: .whitespacesAndNewlines).filter { !$0.isEmpty }.joined(separator: " ")
+        text = OmniReportText.sanitized(text)
+        if text.isEmpty {
+            return "Untitled session"
+        }
+        return text.count > 160 ? String(text.prefix(160)) + "…" : text
+    }
+
+    static func providerName(_ provider: String?) -> String {
+        switch provider {
+        case "claude": return "Claude"
+        case "codex": return "Codex"
+        default: return (provider ?? "").capitalized
+        }
+    }
+
+    // The provider's own mark (see OmniIconImage), drawn in the row's tint.
+    static func providerSymbol(_ provider: String?) -> String {
+        return provider == "codex" ? OmniIconImage.codex : OmniIconImage.claude
+    }
+
+    static func folder(_ workspace: String?) -> String {
+        guard let workspace, !workspace.isEmpty else { return "" }
+        return (workspace as NSString).lastPathComponent
+    }
+
+    // "now", "5m", "3h", "2d", or a date.
+    static func age(_ timestamp: Double?, now: Date = Date()) -> String {
+        guard let timestamp, timestamp > 0 else { return "" }
+        let seconds = max(0, now.timeIntervalSince1970 - timestamp)
+        if seconds < 60 { return "now" }
+        if seconds < 3600 { return "\(Int(seconds / 60))m" }
+        if seconds < 86400 { return "\(Int(seconds / 3600))h" }
+        if seconds < 86400 * 14 { return "\(Int(seconds / 86400))d" }
+        let formatter = DateFormatter()
+        formatter.dateStyle = .medium
+        formatter.timeStyle = .none
+        return formatter.string(from: Date(timeIntervalSince1970: timestamp))
+    }
+
+    // "14:05", or "24/11/2026, 14:05" on another day.
+    static func dateText(_ timestamp: Double) -> String {
+        let date = Date(timeIntervalSince1970: timestamp)
+        let formatter = DateFormatter()
+        formatter.dateStyle = Calendar.current.isDateInToday(date) ? .none : .short
+        formatter.timeStyle = .short
+        return formatter.string(from: date)
+    }
+
+    static func isLive(_ session: [AnyHashable: Any]) -> Bool {
+        return session["state"] as? String == "running"
+    }
+
+    // "Claude · OmniTerm · 3h"
+    // "Claude · Project · @head · 5m": the project (the person's name for it)
+    // when known, then the folder when it says something more.
+    static func detail(_ session: [AnyHashable: Any], project: String? = nil) -> String {
+        let folder = folder(session["workspace"] as? String)
+        let parts = [providerName(session["provider"] as? String),
+                     project ?? "",
+                     folder == project ? "" : folder,
+                     isLive(session) ? "Live" : age((session["updated"] as? NSNumber)?.doubleValue)]
+        return parts.filter { !$0.isEmpty }.joined(separator: " · ")
+    }
+}
+
+// The command that reopens a provider session. IDs come from transcripts and
+// the index, so anything but a plain identifier is refused rather than quoted.
+enum OmniSessionResume {
+    static func command(provider: String?, rawID: String?) -> String? {
+        guard let rawID, rawID.range(of: "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$", options: .regularExpression) != nil else {
+            return nil
+        }
+        switch provider {
+        case "claude": return "claude --resume \(rawID)"
+        case "codex": return "codex resume \(rawID)"
+        default: return nil
+        }
+    }
+
+    static func rawID(_ session: [AnyHashable: Any]) -> String? {
+        if let raw = session["raw_id"] as? String {
+            return raw
+        }
+        guard let id = session["session_id"] as? String, let colon = id.firstIndex(of: ":") else { return nil }
+        return String(id[id.index(after: colon)...])
+    }
+}
+
+// Icon images by name: Claude's and Codex's own marks as template images
+// (tinted like a symbol, subtle grey by default), else an SF Symbol.
+enum OmniIconImage {
+    static let claude = "omni.provider.claude"
+    static let codex = "omni.provider.codex"
+
+    static func image(_ name: String) -> NSImage? {
+        switch name {
+        case claude: return claudeMark
+        case codex: return codexMark
+        default: return NSImage(systemSymbolName: name, accessibilityDescription: nil)
+        }
+    }
+
+    // The spark from Claude's menu-bar template, cropped to fill the same
+    // square as the Codex mark.
+    private static let claudeMark = mark(claudePNG, accessibility: "Claude")
+    // The cloud and prompt: the glyph layer of Codex's own app icon, as one shape.
+    private static let codexMark = mark(codexPNG, accessibility: "Codex")
+
+    private static func mark(_ base64: String, accessibility: String) -> NSImage? {
+        guard let data = Data(base64Encoded: base64), let image = NSImage(data: data) else { return nil }
+        image.size = NSSize(width: 15, height: 15)
+        image.isTemplate = true
+        image.accessibilityDescription = accessibility
+        return image
+    }
+
+    private static let claudePNG = ""
+    private static let codexPNG = ""
+}
