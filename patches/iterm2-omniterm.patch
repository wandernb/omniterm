+import AppKit
+import Foundation
+
+// MARK: - Model
+
+// One thing a search found, and where it leads.
+struct OmniSearchHit: Equatable {
+    enum Target: Equatable {
+        case route(OmniPaneRoute)
+        // A session, at a matching message when the hit came from its transcript.
+        case session(String, message: String?)
+        case memory(String)
+    }
+
+    let key: String
+    let title: String
+    let detail: String
+    let icon: OmniAgentIcon
+    let iconColor: NSColor?
+    let target: Target
+}
+
+struct OmniSearchSection: Equatable {
+    let title: String
+    var hits: [OmniSearchHit]
+}
+
+// What the search looks through, as the scheduler answered it.
+struct OmniSearchSources {
+    var projects: [[String: Any]] = []
+    var layout = OmniProjectLayout()
+    var sessions: [[AnyHashable: Any]] = []
+    var transcripts: [[AnyHashable: Any]] = []
+    var agents: [[AnyHashable: Any]] = []
+    var memories: [[AnyHashable: Any]] = []
+}
+
+// Turns a query and its sources into sections: pages, projects, sessions,
+// transcript matches, agents and memories. With no query it is the quick
+// navigator's start: the pages, then recent projects and sessions. Pure, so
+// tests check it without a window.
+enum OmniSearchModel {
+    static let pages: [(title: String, symbol: SFSymbol, route: OmniPaneRoute)] = [
+        ("Dashboard", .squareGrid2x2, .overview),
+        ("Inbox", .tray, .inbox),
+        ("Memory", .brain, .memory),
+        ("Unblocker", .forwardCircle, .unblocker),
+        ("Settings", .gearshape, .settings),
+        ("All Projects", .shippingbox, .projects),
+    ]
+
+    static func sections(query raw: String, sources: OmniSearchSources, limit: Int) -> [OmniSearchSection] {
+        let query = raw.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        func matches(_ texts: String?...) -> Bool {
+            return query.isEmpty || texts.contains { ($0 ?? "").lowercased().contains(query) }
+        }
+        var sections: [OmniSearchSection] = []
+        func add(_ title: String, _ hits: [OmniSearchHit]) {
+            if !hits.isEmpty {
+                sections.append(OmniSearchSection(title: title, hits: Array(hits.prefix(limit))))
+            }
+        }
+
+        add(query.isEmpty ? "Go to" : "Pages", pages.filter { matches($0.title) }.map { page in
+            OmniSearchHit(key: "page|\(page.title)", title: page.title, detail: "", icon: .symbol(page.symbol.rawValue),
+                          iconColor: nil, target: .route(page.route))
+        })
+
+        let layout = sources.layout
+        let projects = sources.projects.sorted {
+            (($0["updated"] as? NSNumber)?.doubleValue ?? 0) > (($1["updated"] as? NSNumber)?.doubleValue ?? 0)
+        }
+        add(query.isEmpty ? "Recent projects" : "Projects", projects.compactMap { project in
+            guard let root = project["root"] as? String else { return nil }
+            let name = layout.name(root) ?? OmniProjectsModel.name(project)
+            guard matches(name, project["name"] as? String, root) else { return nil }
+            let look = layout.appearance(root)
+            let folder = layout.folders[root].map { $0.replacingOccurrences(of: "/", with: " / ") }
+            let detail = [folder, OmniProjectsModel.abbreviated(root)].compactMap { $0 }.joined(separator: " · ")
+            return OmniSearchHit(key: "project|\(root)", title: name, detail: detail,
+                                 icon: look.icon ?? .symbol(SFSymbol.shippingbox.rawValue),
+                                 iconColor: OmniAgentColor.color(look.color), target: .route(.project(root)))
+        })
+
+        func projectName(_ session: [AnyHashable: Any]) -> String? {
+            guard let project = session["project"] as? [String: Any],
+                  let root = project["root"] as? String ?? project["id"] as? String else { return nil }
+            return layout.name(root) ?? project["name"] as? String
+        }
+        var seen = Set<String>()
+        add(query.isEmpty ? "Recent sessions" : "Sessions", sources.sessions.compactMap { session in
+            guard let id = session["session_id"] as? String, !seen.contains(id) else { return nil }
+            let project = projectName(session)
+            guard matches(session["title"] as? String, session["workspace"] as? String, project) else { return nil }
+            seen.insert(id)
+            return OmniSearchHit(key: "session|\(id)", title: OmniSessionText.title(session["title"] as? String),
+                                 detail: OmniSessionText.detail(session, project: project),
+                                 icon: .symbol(OmniSessionText.providerSymbol(session["provider"] as? String)),
+                                 iconColor: OmniSessionText.isLive(session) ? OmniTheme.running : nil,
+                                 target: .session(id, message: nil))
+        })
+
+        if !query.isEmpty {
+            var matched = Set<String>()
+            add("In transcripts", sources.transcripts.compactMap { match in
+                guard let id = match["session_id"] as? String, matched.insert(id).inserted else { return nil }
+                let known = sources.sessions.first { $0["session_id"] as? String == id } ?? match
+                return OmniSearchHit(key: "match|\(id)", title: OmniSessionText.title(known["title"] as? String),
+                                     detail: OmniSessionText.title(match["snippet"] as? String ?? match["text"] as? String),
+                                     icon: .symbol(OmniSessionText.providerSymbol(known["provider"] as? String)),
+                                     iconColor: nil, target: .session(id, message: match["message_id"] as? String))
+            })
+        }
+
+        add("Agents", sources.agents.compactMap { agent in
+            guard let name = agent["name"] as? String, !query.isEmpty,
+                  matches(name, agent["workspace"] as? String, agent["group"] as? String) else { return nil }
+            let detail = [OmniSessionText.providerName(agent["provider"] as? String),
+                          (agent["workspace"] as? String).map { OmniProjectsModel.abbreviated($0) } ?? ""]
+                .filter { !$0.isEmpty }.joined(separator: " · ")
+            return OmniSearchHit(key: "agent|\(name)", title: name, detail: detail,
+                                 icon: OmniAgentIcon(spec: agent["icon"] as? String) ?? .symbol(OmniAgentIcon.defaultSymbol),
+                                 iconColor: OmniAgentColor.color(agent["color"] as? String), target: .route(.agent(name)))
+        })
+
+        if !query.isEmpty {
+            add("Memory", sources.memories.compactMap { result in
+                guard let memory = OmniMemoryItem(result) else { return nil }
+                return OmniSearchHit(key: "memory|\(memory.id)", title: OmniSessionText.title(memory.title),
+                                     detail: memory.memoryType, icon: .symbol(SFSymbol.brain.rawValue), iconColor: nil,
+                                     target: .memory(memory.id))
+            })
+        }
+        return sections
+    }
+}
+
+// MARK: - Engine
+
+// Asks the scheduler for what the search looks through and answers each
+// query as results arrive: local lists at once, transcripts and memories a
+// moment after typing pauses. Used by the results page and the quick navigator.
+final class OmniSearchEngine {
+    var onResults: (([OmniSearchSection]) -> Void)?
+    var limit: Int
+    private var sources = OmniSearchSources()
+    private var query = ""
+    private var generation = 0
+    private var pending: DispatchWorkItem?
+
+    init(limit: Int) {
+        self.limit = limit
+        load()
+    }
+
+    private func load() {
+        OmniSchedulerClient.request(["op": "get_settings"]) { [weak self] response in
+            self?.sources.layout = OmniProjectLayout((response["settings"] as? [String: Any])?["projects"])
+            self?.publish()
+        }
+        sources.projects = OmniProjectsCache.load()
+        OmniSchedulerClient.request(["op": "list_projects"]) { [weak self] response in
+            guard OmniPane.isOK(response) else { return }
+            self?.sources.projects = response["projects"] as? [[String: Any]] ?? []
+            self?.publish()
+        }
+        OmniSchedulerClient.request(["op": "list_sessions", "order": "recent", "limit": 100]) { [weak self] response in
+            self?.sources.sessions = response["sessions"] as? [[AnyHashable: Any]] ?? []
+            self?.publish()
+        }
+        OmniSchedulerClient.request(["op": "list_agents"]) { [weak self] response in
+            let agents = response["agents"] as? [[AnyHashable: Any]] ?? []
+            let background = OmniBackgroundAgents.names(agents)
+            self?.sources.agents = agents.filter { !background.contains($0["name"] as? String ?? "") }
+            self?.publish()
+        }
+    }
+
+    func search(_ text: String) {
+        query = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        generation += 1
+        sources.transcripts = []
+        sources.memories = []
+        publish()
+        pending?.cancel()
+        guard query.count >= 2 else { return }
+        let generation = self.generation
+        let query = self.query
+        let work = DispatchWorkItem { [weak self] in
+            OmniSchedulerClient.request(["op": "search_transcripts", "query": query, "limit": 30]) { [weak self] response in
+                guard let self, generation == self.generation, OmniPane.isOK(response) else { return }
+                let matches = response["matches"] as? [[AnyHashable: Any]] ?? []
+                self.sources.transcripts = matches.filter { ["claude", "codex"].contains($0["provider"] as? String ?? "") }
+                self.publish()
+            }
+            OmniSchedulerClient.request(["op": "search_memories", "query": query, "mode": "lexical", "limit": 20]) { [weak self] response in
+                guard let self, generation == self.generation, OmniPane.isOK(response) else { return }
+                self.sources.memories = response["memories"] as? [[AnyHashable: Any]] ?? []
+                self.publish()
+            }
+        }
+        pending = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.25, execute: work)
+    }
+
+    private func publish() {
+        onResults?(OmniSearchModel.sections(query: query, sources: sources, limit: limit))
+    }
+}
+
+// MARK: - Results page
+
+// Every result of a search on one page (`.search(query)`): what Enter in the
+// sidebar's search field, or See All Results, opens.
+final class OmniSearchPane: OmniPane, NSSearchFieldDelegate {
+    private let scroll = OmniColumnScrollView()
+    private let field = NSSearchField()
+    private let engine = OmniSearchEngine(limit: 50)
+    private var sections: [OmniSearchSection] = []
+    private var zones: [OmniListZone] = []
+
+    override var contentViews: [NSView] {
+        return [field, scroll]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return zones
+    }
+
+    init(query: String) {
+        super.init()
+        field.stringValue = query
+        field.placeholderString = "Search projects, sessions, agents and memory"
+        field.controlSize = .large
+        field.font = NSFont.systemFont(ofSize: 15)
+        field.sendsSearchStringImmediately = true
+        field.target = self
+        field.action = #selector(queryChanged(_:))
+        addSubview(field)
+        addSubview(scroll)
+        engine.onResults = { [weak self] sections in
+            self?.sections = sections
+            self?.rebuild()
+        }
+        engine.search(query)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    var query: String {
+        return field.stringValue
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        field.frame = NSRect(x: 28, y: 20, width: max(100, min(720, bounds.width - 56)), height: 30)
+        scroll.frame = NSRect(x: 0, y: 60, width: bounds.width, height: max(0, bounds.height - 60))
+    }
+
+    override func reload() {
+    }
+
+    @objc private func queryChanged(_ sender: NSSearchField) {
+        engine.search(sender.stringValue)
+    }
+
+    private func rebuild() {
+        preservingZoneFocus {
+            scroll.rebuildKeepingScroll {
+                let column = scroll.column
+                column.removeAll()
+                zones = []
+                let total = sections.reduce(0) { $0 + $1.hits.count }
+                let trimmed = query.trimmingCharacters(in: .whitespaces)
+                column.addText(OmniTheme.title(trimmed.isEmpty ? "Search" : "Results for “\(trimmed)”"), spacing: 4)
+                column.addText(OmniTheme.meta(total == 1 ? "1 result" : "\(total) results"), spacing: 10)
+                for section in sections {
+                    column.addSection("\(section.title) · \(section.hits.count)")
+                    let zone = OmniListZone()
+                    let list = OmniColumnView()
+                    list.inset = 0
+                    list.topPadding = 0
+                    list.bottomPadding = 0
+                    list.overlay = zone
+                    var items: [(key: String, view: OmniZoneItem)] = []
+                    for hit in section.hits {
+                        let row = OmniFolderEntryRow(icon: hit.icon, iconColor: hit.iconColor, title: hit.title,
+                                                     detail: hit.detail, badge: "", status: nil) { [weak self] in
+                            self?.actions?.paneOpenSearchHit(hit)
+                        }
+                        row.contextMenu = { [weak self] in
+                            let menu = NSMenu()
+                            menu.addAction("Open", symbol: .arrowRightCircle) { self?.actions?.paneOpenSearchHit(hit) }
+                            menu.addAction("Copy Title", symbol: .docOnDoc) { OmniContextMenus.copy(hit.title) }
+                            return menu
+                        }
+                        items.append((hit.key, row))
+                        list.add(row, spacing: 2) { _ in OmniFolderEntryRow.height }
+                    }
+                    zone.setItems(items)
+                    column.add(list, spacing: 8) { [weak list] width in list?.layoutColumn(width: width) ?? 0 }
+                    zones.append(zone)
+                }
+            }
+        }
+        showContent()
+    }
+}
+
+// MARK: - Quick navigator
+
+// Command-K: a search over everything and a way to go anywhere, floating
+// over the window. Arrows pick, Return opens, Command-Return opens every
+// result on a page, Escape or a click outside closes it.
+final class OmniQuickNav: NSView, NSSearchFieldDelegate {
+    static let width: CGFloat = 620
+    private static let rowHeight: CGFloat = 40
+    private static let headerHeight: CGFloat = 24
+    private static let maxListHeight: CGFloat = 420
+
+    let field = NSSearchField()
+    private let glass = NSImageView()
+    private let card = OmniQuickNavCard()
+    private let list = OmniQuickNavList()
+    private let listScroll = NSScrollView()
+    private let footer = NSTextField(labelWithString: "↑↓ to move · ⏎ to open · ⌘⏎ for all results · esc to close")
+    private let engine = OmniSearchEngine(limit: 6)
+    private let open: (OmniSearchHit) -> Void
+    private let openAll: (String) -> Void
+    private var hits: [OmniSearchHit] = []
+    private var selected = 0
+
+    override var isFlipped: Bool { true }
+
+    init(open: @escaping (OmniSearchHit) -> Void, openAll: @escaping (String) -> Void) {
+        self.open = open
+        self.openAll = openAll
+        super.init(frame: .zero)
+        wantsLayer = true
+        layer?.backgroundColor = NSColor.black.withAlphaComponent(0.28).cgColor
+        card.wantsLayer = true
+        card.layer?.cornerRadius = 12
+        card.layer?.masksToBounds = true
+        card.layer?.borderWidth = 1
+        card.layer?.borderColor = OmniTheme.cardBorder.cgColor
+        let blur = NSVisualEffectView()
+        blur.material = .popover
+        blur.blendingMode = .withinWindow
+        blur.state = .active
+        blur.autoresizingMask = [.width, .height]
+        card.addSubview(blur)
+        field.placeholderString = "Search or jump to…"
+        field.font = NSFont.systemFont(ofSize: 17)
+        field.controlSize = .large
+        field.focusRingType = .none
+        field.isBordered = false
+        field.drawsBackground = false
+        field.sendsSearchStringImmediately = true
+        field.delegate = self
+        field.target = self
+        field.action = #selector(queryChanged(_:))
+        // The cell's own magnifier overlaps large text, so it is drawn beside the field instead.
+        (field.cell as? NSSearchFieldCell)?.searchButtonCell = nil
+        card.addSubview(field)
+        glass.image = NSImage(systemSymbolName: SFSymbol.magnifyingglass.rawValue, accessibilityDescription: nil)
+        glass.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 16, weight: .regular)
+        glass.contentTintColor = OmniTheme.secondaryText
+        card.addSubview(glass)
+        list.pick = { [weak self] index in self?.activate(index) }
+        listScroll.documentView = list
+        listScroll.drawsBackground = false
+        listScroll.hasVerticalScroller = true
+        listScroll.autohidesScrollers = true
+        card.addSubview(listScroll)
+        footer.font = OmniTheme.Font.rowDetail
+        footer.textColor = OmniTheme.secondaryText
+        card.addSubview(footer)
+        addSubview(card)
+        engine.onResults = { [weak self] sections in self?.show(sections) }
+        engine.search("")
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    // Shown over `view`, the window's content, with the keyboard in its field.
+    func present(in view: NSView, query: String = "") {
+        frame = view.bounds
+        autoresizingMask = [.width, .height]
+        view.addSubview(self, positioned: .above, relativeTo: nil)
+        field.stringValue = query
+        engine.search(query)
+        window?.makeFirstResponder(field)
+    }
+
+    func dismiss() {
+        removeFromSuperview()
+    }
+
+    var shownHits: [OmniSearchHit] {
+        return hits
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let width = min(Self.width, bounds.width - 40)
+        let listHeight = min(Self.maxListHeight, list.contentHeight)
+        let height = 56 + listHeight + 30
+        card.frame = NSRect(x: (bounds.width - width) / 2, y: min(110, bounds.height * 0.14), width: width, height: height)
+        card.subviews.first?.frame = card.bounds
+        glass.frame = NSRect(x: 16, y: 16, width: 22, height: 24)
+        field.frame = NSRect(x: 46, y: 14, width: width - 60, height: 28)
+        listScroll.frame = NSRect(x: 6, y: 56, width: width - 12, height: listHeight)
+        list.frame = NSRect(x: 0, y: 0, width: listScroll.contentSize.width, height: list.contentHeight)
+        footer.frame = NSRect(x: 16, y: height - 24, width: width - 32, height: 16)
+    }
+
+    override func mouseDown(with event: NSEvent) {
+        if !card.frame.contains(convert(event.locationInWindow, from: nil)) {
+            dismiss()
+        }
+    }
+
+    @objc private func queryChanged(_ sender: NSSearchField) {
+        engine.search(sender.stringValue)
+    }
+
+    private func show(_ sections: [OmniSearchSection]) {
+        hits = sections.flatMap(\.hits)
+        selected = min(selected, max(0, hits.count - 1))
+        if field.stringValue != "" && hits.first.map({ _ in true }) == true && selected >= hits.count {
+            selected = 0
+        }
+        list.show(sections, selected: selected)
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    private func move(_ delta: Int) {
+        guard !hits.isEmpty else { return }
+        selected = (selected + delta + hits.count) % hits.count
+        list.select(selected)
+        if let rect = list.rectForHit(selected) {
+            list.scrollToVisible(rect)
+        }
+    }
+
+    private func activate(_ index: Int) {
+        guard hits.indices.contains(index) else { return }
+        let hit = hits[index]
+        dismiss()
+        open(hit)
+    }
+
+    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+        switch commandSelector {
+        case #selector(NSResponder.moveDown(_:)):
+            move(1)
+        case #selector(NSResponder.moveUp(_:)):
+            move(-1)
+        case #selector(NSResponder.insertNewline(_:)):
+            if NSApp.currentEvent?.modifierFlags.contains(.command) == true {
+                let query = field.stringValue
+                dismiss()
+                openAll(query)
+            } else {
+                activate(selected)
+            }
+        case #selector(NSResponder.cancelOperation(_:)):
+            dismiss()
+        default:
+            return false
+        }
+        return true
+    }
+
+    func controlTextDidChange(_ notification: Notification) {
+        selected = 0
+    }
+}
+
+// The navigator's card: laid out top down.
+private final class OmniQuickNavCard: NSView {
+    override var isFlipped: Bool { true }
+}
+
+// The navigator's results: section headings and rows, the chosen one lit.
+private final class OmniQuickNavList: NSView {
+    var pick: ((Int) -> Void)?
+    private(set) var contentHeight: CGFloat = 0
+    private var rows: [(frame: NSRect, index: Int)] = []
+    private var selected = 0
+
+    override var isFlipped: Bool { true }
+
+    func show(_ sections: [OmniSearchSection], selected: Int) {
+        subviews.forEach { $0.removeFromSuperview() }
+        rows = []
+        self.selected = selected
+        var y: CGFloat = 4
+        var index = 0
+        let width = max(200, bounds.width)
+        if sections.isEmpty {
+            let none = NSTextField(labelWithString: "No matches")
+            none.font = OmniTheme.Font.rowTitle
+            none.textColor = OmniTheme.secondaryText
+            none.frame = NSRect(x: 14, y: 10, width: width - 28, height: 18)
+            addSubview(none)
+            y = 36
+        }
+        for section in sections {
+            let header = OmniTheme.sectionHeader(section.title)
+            header.frame = NSRect(x: 12, y: y + 6, width: width - 24, height: 16)
+            header.autoresizingMask = [.width]
+            addSubview(header)
+            y += 24
+            for hit in section.hits {
+                let row = OmniQuickNavRow(hit: hit)
+                row.frame = NSRect(x: 0, y: y, width: width, height: 40)
+                row.autoresizingMask = [.width]
+                row.isSelected = index == selected
+                let chosen = index
+                row.onClick = { [weak self] in self?.pick?(chosen) }
+                addSubview(row)
+                rows.append((row.frame, index))
+                y += 40
+                index += 1
+            }
+        }
+        contentHeight = y + 4
+    }
+
+    func select(_ index: Int) {
+        selected = index
+        for case let row as OmniQuickNavRow in subviews {
+            row.isSelected = rows.first { $0.frame == row.frame }?.index == index
+        }
+    }
+
+    func rectForHit(_ index: Int) -> NSRect? {
+        return rows.first { $0.index == index }?.frame
+    }
+}
+
+private final class OmniQuickNavRow: NSView {
+    var onClick: (() -> Void)?
+
+    override func resetCursorRects() {
+        addCursorRect(bounds, cursor: .pointingHand)
+    }
+    var isSelected = false {
+        didSet { needsDisplay = true }
+    }
+    private let iconView = NSImageView()
+    private let emoji = NSTextField(labelWithString: "")
+    private let title = NSTextField(labelWithString: "")
+    private let detail = NSTextField(labelWithString: "")
+
+    override var isFlipped: Bool { true }
+
+    init(hit: OmniSearchHit) {
+        super.init(frame: .zero)
+        switch hit.icon {
+        case .symbol(let name):
+            iconView.image = OmniIconImage.image(name)
+            iconView.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 14, weight: .regular)
+            iconView.contentTintColor = hit.iconColor ?? OmniTheme.secondaryText
+            addSubview(iconView)
+        case .emoji(let value):
+            emoji.stringValue = value
+            emoji.font = OmniTheme.Font.emoji(16)
+            emoji.alignment = .center
+            addSubview(emoji)
+        }
+        title.stringValue = hit.title
+        title.font = OmniTheme.Font.rowTitle
+        title.lineBreakMode = .byTruncatingTail
+        addSubview(title)
+        detail.stringValue = hit.detail
+        detail.font = OmniTheme.Font.rowDetail
+        detail.textColor = OmniTheme.secondaryText
+        detail.lineBreakMode = .byTruncatingTail
+        addSubview(detail)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        iconView.frame = NSRect(x: 12, y: 10, width: 20, height: 20)
+        emoji.frame = NSRect(x: 10, y: 9, width: 24, height: 22)
+        let titleWidth = min(ceil(title.attributedStringValue.size().width) + 4, bounds.width * 0.55)
+        title.frame = NSRect(x: 42, y: 11, width: titleWidth, height: 18)
+        detail.frame = NSRect(x: title.frame.maxX + 10, y: 12, width: max(0, bounds.width - title.frame.maxX - 22), height: 16)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        guard isSelected else { return }
+        NSColor.controlAccentColor.withAlphaComponent(0.28).setFill()
+        NSBezierPath(roundedRect: bounds.insetBy(dx: 4, dy: 1), xRadius: 7, yRadius: 7).fill()
+    }
+
+    override func mouseDown(with event: NSEvent) {
+    }
+
+    override func mouseUp(with event: NSEvent) {
+        if bounds.contains(convert(event.locationInWindow, from: nil)) {
+            onClick?()
+        }
+    }
+}
diff --git a/sources/OmniTerm/OmniSessionChat.swift b/sources/OmniTerm/OmniSessionChat.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cb8345ed2133052247beb942dee597102b824aa5
--- /dev/null
+++ b/sources/OmniTerm/OmniSessionChat.swift
@@ -0,0 +1,1334 @@
+import AppKit
+import Foundation
+
+// MARK: - Model
+
+// One indexed transcript record, as `get_session` returns it. Long records
+// arrive in parts; the builder joins them.
+struct OmniTranscriptRecord: Equatable {
+    let id: String
+    let role: String
+    let kind: String
+    let text: String
+    let sourcePath: String
+    let sourceLine: Int
+    let part: Int
+    let timestamp: String?
+
+    init?(_ message: [AnyHashable: Any]) {
+        guard let id = (message["message_id"] ?? message["id"]) as? String else { return nil }
+        self.id = id
+        role = message["role"] as? String ?? ""
+        kind = message["kind"] as? String ?? ""
+        text = message["text"] as? String ?? ""
+        sourcePath = message["source_path"] as? String ?? ""
+        sourceLine = (message["source_line"] as? NSNumber)?.intValue ?? 0
+        part = (message["part"] as? NSNumber)?.intValue ?? 0
+        timestamp = message["timestamp"] as? String
+    }
+
+    init(id: String, role: String, kind: String, text: String, sourcePath: String = "", sourceLine: Int = 0,
+         part: Int = 0, timestamp: String? = nil) {
+        self.id = id
+        self.role = role
+        self.kind = kind
+        self.text = text
+        self.sourcePath = sourcePath
+        self.sourceLine = sourceLine
+        self.part = part
+        self.timestamp = timestamp
+    }
+
+    // Long lines are read field by field: their parts count from a billion,
+    // one sequence per field (a tool call's name, then each input).
+    var isStreamed: Bool {
+        return part >= 1_000_000_000
+    }
+
+    // Parts of one block share their path, line, role, kind and block index;
+    // a streamed line's fields are one block.
+    var blockKey: String {
+        return "\(sourcePath)|\(sourceLine)|\(role)|\(kind)|\(isStreamed ? -1 : part / 100_000)"
+    }
+}
+
+struct OmniToolStep: Equatable {
+    var name: String
+    var input: String
+    var output: String?
+}
+
+// What a transcript shows, in reading order.
+struct OmniTranscriptItem: Equatable {
+    enum Kind: Equatable {
+        // What the person typed.
+        case user
+        // A slash command (or `!` shell input) the person ran.
+        case command(name: String, arguments: String)
+        // A skill's or command's instructions, expanded into the prompt.
+        case skill(name: String)
+        // Text the harness added: reminders, hook output, environment,
+        // project instructions, command output.
+        case context(label: String)
+        case assistant
+        // Consecutive tool calls with their outputs.
+        case tools
+        case interrupted
+    }
+
+    let key: String
+    var kind: Kind
+    var text: String
+    var steps: [OmniToolStep] = []
+    var recordIDs: [String] = []
+    var timestamp: String?
+    // An assistant or tools item that opens the agent's turn.
+    var startsTurn = false
+    // A caption, such as a prompt sent while the agent was working.
+    var note: String?
+    // Images a prompt referred to: a file path, or a label such as "Image #2".
+    var attachments: [String] = []
+}
+
+// Turns records into items. Pure, so it is tested without a window.
+enum OmniTranscriptBuilder {
+    // `startsMidSession`: the records begin after the session's start, so a
+    // leading continuation of a longer record waits for the page before it.
+    static func build(_ records: [OmniTranscriptRecord], startsMidSession: Bool = false) -> [OmniTranscriptItem] {
+        var items: [OmniTranscriptItem] = []
+        var pendingSkill: String?
+        var blocks = merged(records)
+        if startsMidSession, let first = blocks.first?.first, first.part % 100_000 != 0 {
+            blocks.removeFirst()
+        }
+        for block in blocks {
+            var first = block.first!
+            // A streamed tool call's fields (name, then inputs) read one per line.
+            var text = ""
+            for (index, record) in block.enumerated() {
+                if index > 0, record.isStreamed, record.part / 1_000_000_000 != block[index - 1].part / 1_000_000_000,
+                   first.kind == "tool" {
+                    text += "\n"
+                }
+                text += record.text
+            }
+            // A session imported from another agent keeps its tool calls as
+            // tagged assistant text.
+            if first.role == "assistant", first.kind == "message", text.hasPrefix("[external_agent_tool_") {
+                first = OmniTranscriptRecord(id: first.id, role: text.hasPrefix("[external_agent_tool_result]") ? "tool" : "assistant",
+                                             kind: text.hasPrefix("[external_agent_tool_result]") ? "output" : "tool",
+                                             text: "", sourcePath: first.sourcePath, sourceLine: first.sourceLine,
+                                             part: first.part, timestamp: first.timestamp)
+            }
+            let ids = block.map(\.id)
+            func add(_ kind: OmniTranscriptItem.Kind, _ body: String, key suffix: String = "") {
+                items.append(OmniTranscriptItem(key: first.id + suffix, kind: kind, text: body, recordIDs: ids,
+                                                timestamp: first.timestamp))
+            }
+            switch (first.role, first.kind) {
+            case (_, "tool"), ("tool", _):
+                let isCall = first.kind == "tool" && first.role != "tool"
+                if items.last?.kind != .tools {
+                    items.append(OmniTranscriptItem(key: first.id, kind: .tools, text: "", recordIDs: [],
+                                                    timestamp: first.timestamp))
+                }
+                var group = items.removeLast()
+                group.recordIDs += ids
+                if isCall {
+                    var lines = text.split(separator: "\n", maxSplits: 1, omittingEmptySubsequences: false).map(String.init)
+                    if let header = lines.first, header.hasPrefix("[external_agent_tool_call:") {
+                        lines[0] = header.dropFirst("[external_agent_tool_call:".count).trimmingCharacters(in: CharacterSet(charactersIn: " ]"))
+                    }
+                    group.steps.append(OmniToolStep(name: lines.first ?? "tool",
+                                                    input: lines.count > 1 ? lines[1] : "", output: nil))
+                } else if let waiting = group.steps.firstIndex(where: { $0.output == nil }) {
+                    // Parallel calls answer in order.
+                    group.steps[waiting].output = text.hasPrefix("[external_agent_tool_result]") ?
+                        String(text.dropFirst("[external_agent_tool_result]".count)).trimmingCharacters(in: .newlines) : text
+                } else {
+                    group.steps.append(OmniToolStep(name: "Output", input: "", output: text))
+                }
+                items.append(group)
+                // A skill the agent launched: its instructions arrive next, as
+                // a user record nobody typed.
+                pendingSkill = group.steps.last.flatMap(skillName)
+            case ("assistant", "summary"):
+                add(.context(label: "Summary"), text)
+            case ("assistant", _) where text.hasPrefix("<EXTERNAL SESSION IMPORTED>"):
+                add(.context(label: "Imported from another agent"), text)
+            case ("assistant", _):
+                add(.assistant, text)
+                pendingSkill = nil
+            case ("system", _):
+                // Harness suggestions also arrive as system records.
+                let label = reminderLabel(text)
+                add(.context(label: label == "System reminder" ? "System" : label), text)
+            case ("developer", _):
+                add(.context(label: "Developer instructions"), text)
+            case ("document", _):
+                add(.context(label: "Document"), text)
+            case ("user", _):
+                let (injectedPrompt, extras) = splitInjected(text)
+                let (prompt, attachments) = extractImages(injectedPrompt)
+                if prompt.isEmpty, !attachments.isEmpty {
+                    // Pasted images follow their prompt as records of their own:
+                    // they join it, taking the place of its "[Image #n]" labels.
+                    if let owner = items.lastIndex(where: { item in
+                        switch item.kind {
+                        case .context: return false
+                        default: return true
+                        }
+                    }), items[owner].kind == .user || { if case .command = items[owner].kind { return true }; return false }() {
+                        var merged = items[owner].attachments
+                        for path in attachments {
+                            if let label = merged.firstIndex(where: { $0.hasPrefix("Image #") }) {
+                                merged[label] = path
+                            } else {
+                                merged.append(path)
+                            }
+                        }
+                        items[owner].attachments = merged
+                    } else {
+                        add(.user, "")
+                        items[items.count - 1].attachments = attachments
+                    }
+                }
+                if !prompt.isEmpty {
+                    let classified = classifyUser(prompt, pendingSkill: pendingSkill)
+                    switch classified.kind {
+                    case .command(let name, _):
+                        pendingSkill = name
+                    case .skill:
+                        pendingSkill = nil
+                    case .user:
+                        pendingSkill = nil
+                    default:
+                        break
+                    }
+                    if classified.keep {
+                        add(classified.kind, classified.body)
+                        items[items.count - 1].note = classified.note
+                        if classified.kind == .user {
+                            items[items.count - 1].attachments = attachments
+                        } else if case .command(let name, let arguments) = classified.kind {
+                            // A command's arguments can carry pasted images too.
+                            let (clean, images) = extractImages(arguments)
+                            items[items.count - 1].kind = .command(name: name, arguments: clean)
+                            items[items.count - 1].attachments = attachments + images
+                        }
+                    }
+                }
+                for (index, extra) in extras.enumerated() {
+                    add(.context(label: extra.label), extra.body, key: "#\(index)")
+                }
+            default:
+                add(.context(label: first.role.capitalized), text)
+            }
+        }
+        // Each agent turn gets one header, on its first item.
+        var inTurn = false
+        for index in items.indices {
+            switch items[index].kind {
+            case .assistant, .tools:
+                items[index].startsTurn = !inTurn
+                inTurn = true
+            case .user, .command, .skill, .interrupted:
+                inTurn = false
+            case .context:
+                break
+            }
+        }
+        return items
+    }
+
+    // Consecutive parts of one block, joined.
+    static func merged(_ records: [OmniTranscriptRecord]) -> [[OmniTranscriptRecord]] {
+        var blocks: [[OmniTranscriptRecord]] = []
+        for record in records {
+            if let last = blocks.last?.last, last.blockKey == record.blockKey, last.part < record.part {
+                blocks[blocks.count - 1].append(record)
+            } else {
+                blocks.append([record])
+            }
+        }
+        return blocks
+    }
+
+    private static let injectedTags: [(tag: String, label: String)] = [
+        ("system-reminder", "System reminder"),
+        ("user-prompt-submit-hook", "Hook"),
+        ("task-notification", "Background task"),
+    ]
+
+    // What a harness reminder is: a suggestion to the model, a check-in, the
+    // project's instructions, a file it was shown, or another reminder.
+    static func reminderLabel(_ body: String) -> String {
+        let text = body.trimmingCharacters(in: .whitespacesAndNewlines)
+        let lower = text.lowercased()
+        if lower.contains("hasn't heard from you") || lower.contains("haven't been used recently") ||
+            lower.contains("hasn't been used recently") || lower.hasPrefix("consider ") || lower.contains(" you may want to ") ||
+            lower.hasPrefix("stop hook feedback") || lower.contains("say in a few words what you're doing") {
+            return "Suggestion"
+        }
+        if text.hasPrefix("Goal check-in") {
+            return "Goal check-in"
+        }
+        if text.hasPrefix("[SYSTEM NOTIFICATION") {
+            return "Background task"
+        }
+        if text.hasPrefix("Called the Read tool") || text.hasPrefix("Called the ") {
+            return "File context"
+        }
+        if text.hasPrefix("Codebase and user instructions") || text.hasPrefix("Contents of ") ||
+            text.hasPrefix("Attribution for git") || text.hasPrefix("As you answer the user") ||
+            text.hasPrefix("Instruction files were re-read") {
+            return "Project instructions"
+        }
+        if text.hasPrefix("Other agents active") {
+            return "Agents"
+        }
+        if text.hasPrefix("Your final report is delivered") {
+            return "Agent instructions"
+        }
+        if text.hasPrefix("<tools-used-before-summary>") {
+            return "Summary note"
+        }
+        return "System reminder"
+    }
+
+    // A prompt with reminders appended: the prompt, and each reminder.
+    static func splitInjected(_ text: String) -> (String, [(label: String, body: String)]) {
+        var prompt = text
+        var extras: [(label: String, body: String)] = []
+        for (tag, label) in injectedTags {
+            while let open = prompt.range(of: "<\(tag)>"),
+                  let close = prompt.range(of: "</\(tag)>", range: open.upperBound..<prompt.endIndex) {
+                let body = String(prompt[open.upperBound..<close.lowerBound]).trimmingCharacters(in: .whitespacesAndNewlines)
+                extras.append((tag == "system-reminder" ? reminderLabel(body) : label, body))
+                prompt.removeSubrange(open.lowerBound..<close.upperBound)
+            }
+        }
+        return (prompt.trimmingCharacters(in: .whitespacesAndNewlines), extras)
+    }
+
+    static func tagged(_ text: String, _ tag: String) -> String? {
+        guard let open = text.range(of: "<\(tag)>"),
+              let close = text.range(of: "</\(tag)>", range: open.upperBound..<text.endIndex) else { return nil }
+        return String(text[open.upperBound..<close.lowerBound]).trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    // The skill a Skill tool call launched.
+    static func skillName(_ step: OmniToolStep) -> String? {
+        guard step.name == "Skill" else { return nil }
+        if let object = try? JSONSerialization.jsonObject(with: Data(step.input.utf8)) as? [String: Any],
+           let name = object["skill"] as? String ?? object["command"] as? String, !name.isEmpty {
+            return name
+        }
+        return "skill"
+    }
+
+    // `[Image #2]` and `[Image: source: /path.png]` in a prompt: the prompt
+    // without them, and what they refer to.
+    static func extractImages(_ text: String) -> (String, [String]) {
+        guard text.contains("[Image") else { return (text, []) }
+        var attachments: [String] = []
+        var result = text
+        let pattern = try! NSRegularExpression(pattern: "\\[Image(?: #(\\d+))?(?:: ([^\\]]*))?\\]")
+        let range = NSRange(result.startIndex..., in: result)
+        for match in pattern.matches(in: result, range: range).reversed() {
+            let number = Range(match.range(at: 1), in: result).map { String(result[$0]) }
+            let detail = Range(match.range(at: 2), in: result).map { String(result[$0]) }
+            if let detail, detail.hasPrefix("source: ") {
+                attachments.insert(String(detail.dropFirst("source: ".count)).trimmingCharacters(in: .whitespaces), at: 0)
+            } else if let number {
+                attachments.insert("Image #\(number)", at: 0)
+            }
+            if let whole = Range(match.range, in: result) {
+                result.removeSubrange(whole)
+            }
+        }
+        // Where labels stood, blank lines would stack up.
+        result = result.replacingOccurrences(of: "\n[ \t]*(\n[ \t]*)+\n", with: "\n\n", options: .regularExpression)
+        return (result.trimmingCharacters(in: .whitespacesAndNewlines), attachments)
+    }
+
+    // An attribute of a tag, such as `from` in `<agent-message from="…">`.
+    static func attribute(_ text: String, tag: String, name: String) -> String? {
+        guard let open = text.range(of: "<\(tag)"), let end = text.range(of: ">", range: open.upperBound..<text.endIndex) else { return nil }
+        let head = String(text[open.upperBound..<end.lowerBound])
+        guard let key = head.range(of: name + "=\""),
+              let close = head.range(of: "\"", range: key.upperBound..<head.endIndex) else { return nil }
+        return String(head[key.upperBound..<close.lowerBound])
+    }
+
+    // The text inside a tag that carries attributes.
+    static func taggedBody(_ text: String, _ tag: String) -> String? {
+        guard let open = text.range(of: "<\(tag)"), let end = text.range(of: ">", range: open.upperBound..<text.endIndex) else { return nil }
+        let close = text.range(of: "</\(tag)>", range: end.upperBound..<text.endIndex)
+        return String(text[end.upperBound..<(close?.lowerBound ?? text.endIndex)]).trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    // A JSON notice between agents ({"type":"idle_notification","summary":…})
+    // reads as its kind and summary; anything else is kept as sent.
+    static func readableNotice(_ body: String) -> String {
+        guard body.hasPrefix("{"), let object = try? JSONSerialization.jsonObject(with: Data(body.utf8)) as? [String: Any],
+              let type = object["type"] as? String else { return body }
+        let kind = type.replacingOccurrences(of: "_", with: " ").capitalized
+        let summary = (object["summary"] ?? object["message"] ?? object["text"]) as? String
+        return summary.map { kind + ": " + $0 } ?? kind
+    }
+
+    static let queuedPrefix = "The user sent a new message while you were working:"
+
+    static func classifyUser(_ text: String, pendingSkill: String?)
+        -> (kind: OmniTranscriptItem.Kind, body: String, keep: Bool, note: String?) {
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        // A prompt typed while the agent worked: Claude Code wraps it in an
+        // explanation for the model. The person's words are what is shown.
+        if trimmed.hasPrefix(queuedPrefix) {
+            var body = String(trimmed.dropFirst(queuedPrefix.count))
+            if let explanation = body.range(of: "\n\nThis is how Claude Code surfaces messages") {
+                body = String(body[..<explanation.lowerBound])
+            }
+            return (.user, body.trimmingCharacters(in: .whitespacesAndNewlines), true, "Sent while it was working")
+        }
+        let result = classifyUnqueued(trimmed, pendingSkill: pendingSkill)
+        return (result.kind, result.body, result.keep, nil)
+    }
+
+    private static func classifyUnqueued(_ trimmed: String, pendingSkill: String?)
+        -> (kind: OmniTranscriptItem.Kind, body: String, keep: Bool) {
+        if trimmed.hasPrefix("<command-message>") || trimmed.hasPrefix("<command-name>") {
+            let name = tagged(trimmed, "command-name") ?? tagged(trimmed, "command-message").map { "/" + $0 } ?? "/command"
+            return (.command(name: name, arguments: tagged(trimmed, "command-args") ?? ""), "", true)
+        }
+        if trimmed.hasPrefix("<bash-input>") {
+            return (.command(name: "!", arguments: tagged(trimmed, "bash-input") ?? ""), "", true)
+        }
+        for (tag, label) in [("local-command-stdout", "Command output"), ("local-command-stderr", "Command output"),
+                             ("bash-stdout", "Shell output"), ("bash-stderr", "Shell output")] where trimmed.hasPrefix("<\(tag)>") {
+            let body = trimmed.replacingOccurrences(of: "</?[a-z-]+>", with: "", options: .regularExpression)
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            return (.context(label: label), body, !body.isEmpty)
+        }
+        if trimmed.hasPrefix("<local-command-caveat>") || trimmed.hasPrefix("Caveat: The messages below were generated") {
+            return (.context(label: "Caveat"), trimmed, false)
+        }
+        if trimmed.hasPrefix("[Request interrupted") || trimmed.hasPrefix("<turn_aborted>") {
+            return (.interrupted, "", true)
+        }
+        if trimmed.hasPrefix("<environment_context>") {
+            return (.context(label: "Environment"), trimmed, true)
+        }
+        if trimmed.hasPrefix("# AGENTS.md instructions") || trimmed.hasPrefix("<user_instructions>") ||
+            trimmed.hasPrefix("<INSTRUCTIONS>") {
+            return (.context(label: "Project instructions"), trimmed, true)
+        }
+        if trimmed.hasPrefix("This session is being continued from a previous conversation") {
+            return (.context(label: "Conversation summary"), trimmed, true)
+        }
+        // Messages from other sessions and agents, Codex's skill and context
+        // blocks, and OmniTerm's own notes: each in its own tag.
+        if trimmed.hasPrefix("Another Claude session sent a message") || trimmed.hasPrefix("<agent-message") {
+            let sender = attribute(trimmed, tag: "agent-message", name: "from").map { String($0.prefix(8)) } ??
+                attribute(trimmed, tag: "teammate-message", name: "teammate_id") ??
+                attribute(trimmed, tag: "teammate-message", name: "from")
+            var body = taggedBody(trimmed, "agent-message") ?? taggedBody(trimmed, "teammate-message") ?? trimmed
+            if body.hasPrefix("Another Claude session sent a message") {
+                body = String(body.drop { $0 != "\n" }).trimmingCharacters(in: .whitespacesAndNewlines)
+            }
+            return (.context(label: "Agent message" + (sender.map { " · from " + $0 } ?? "")), readableNotice(body), true)
+        }
+        if trimmed.hasPrefix("<teammate-message") {
+            let from = (attribute(trimmed, tag: "teammate-message", name: "teammate_id") ??
+                        attribute(trimmed, tag: "teammate-message", name: "from")).map { " · " + $0 } ?? ""
+            return (.context(label: "Teammate message" + from), taggedBody(trimmed, "teammate-message") ?? trimmed, true)
+        }
+        if trimmed.hasPrefix("<skill>") {
+            return (.skill(name: tagged(trimmed, "name") ?? "skill"), trimmed, true)
+        }
+        if trimmed.hasPrefix("Base directory for this skill:") {
+            let directory = trimmed.dropFirst("Base directory for this skill:".count)
+                .components(separatedBy: .newlines).first?.trimmingCharacters(in: .whitespaces) ?? ""
+            return (.skill(name: pendingSkill ?? (directory as NSString).lastPathComponent), trimmed, true)
+        }
+        if trimmed.hasPrefix("<codex_internal_context") {
+            return (.context(label: "Codex context"), taggedBody(trimmed, "codex_internal_context") ?? trimmed, true)
+        }
+        if trimmed.hasPrefix("[OmniTerm ") {
+            return (.context(label: "OmniTerm"), trimmed, true)
+        }
+        if trimmed.hasPrefix("[handback-send-enforce]") || trimmed.hasPrefix("[Subagent hand-back]") {
+            return (.context(label: "Hand-back notice"), trimmed, true)
+        }
+        if trimmed.hasPrefix("[SYSTEM NOTIFICATION") {
+            return (.context(label: "Background task"), trimmed, true)
+        }
+        if trimmed.hasPrefix("A session-scoped Stop hook is now active") || trimmed.hasPrefix("Goal check-in") {
+            return (.context(label: "Goal"), trimmed, true)
+        }
+        if trimmed.hasPrefix("Stop hook feedback:") {
+            return (.context(label: "Suggestion"), trimmed, true)
+        }
+        for prefix in ["PreToolUse:", "PostToolUse:", "SessionStart:", "UserPromptSubmit"] where trimmed.hasPrefix(prefix) {
+            return (.context(label: "Hook"), trimmed, true)
+        }
+        if let pendingSkill {
+            return (.skill(name: pendingSkill), trimmed, true)
+        }
+        return (.user, trimmed, true)
+    }
+
+    // A tool call's input in one line: its command, path or query.
+    static func inputSummary(_ input: String) -> String {
+        let data = Data(input.utf8)
+        if let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] {
+            for key in ["command", "cmd", "file_path", "path", "pattern", "url", "query", "description", "prompt", "skill"] {
+                if let value = object[key] as? String, !value.isEmpty {
+                    return oneLine(value)
+                }
+                if let value = object[key] as? [String], !value.isEmpty {
+                    return oneLine(value.joined(separator: " "))
+                }
+            }
+        }
+        return oneLine(input)
+    }
+
+    static func oneLine(_ text: String, limit: Int = 200) -> String {
+        let line = text.components(separatedBy: .newlines).map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { !$0.isEmpty }.joined(separator: " ⏎ ")
+        return line.count > limit ? String(line.prefix(limit)) + "…" : line
+    }
+
+    // As Claude's apps put it: "Ran 2 commands, read a file, used a tool".
+    static func toolsSummary(_ steps: [OmniToolStep]) -> String {
+        var commands = 0, reads = 0, edits = 0, searches = 0, others = 0
+        var skills: [String] = []
+        for step in steps {
+            if let skill = skillName(step) {
+                skills.append(skill)
+                continue
+            }
+            switch step.name.lowercased() {
+            case "bash", "shell", "exec_command", "local_shell", "run_command", "command":
+                commands += 1
+            case "read", "view", "read_file", "notebookread":
+                reads += 1
+            case "edit", "write", "multiedit", "apply_patch", "notebookedit", "str_replace_editor":
+                edits += 1
+            case "grep", "glob", "search", "websearch", "find":
+                searches += 1
+            default:
+                others += 1
+            }
+        }
+        func count(_ number: Int, _ one: String, _ many: String) -> String {
+            return number == 1 ? one : "\(number) \(many)"
+        }
+        var parts: [String] = []
+        if !skills.isEmpty { parts.append("launched skill " + skills.joined(separator: ", ")) }
+        if commands > 0 { parts.append("ran " + count(commands, "a command", "commands")) }
+        if reads > 0 { parts.append("read " + count(reads, "a file", "files")) }
+        if edits > 0 { parts.append("edited " + count(edits, "a file", "files")) }
+        if searches > 0 { parts.append("searched " + count(searches, "once", "times")) }
+        if others > 0 { parts.append("used " + count(others, "a tool", "tools")) }
+        let sentence = parts.joined(separator: ", ")
+        return sentence.prefix(1).uppercased() + sentence.dropFirst()
+    }
+
+    // "Ran 4 tools · Bash ×2, Read, Edit"
+    static func toolNames(_ steps: [OmniToolStep]) -> String {
+        var order: [String] = []
+        var counts: [String: Int] = [:]
+        for step in steps {
+            if counts[step.name] == nil {
+                order.append(step.name)
+            }
+            counts[step.name, default: 0] += 1
+        }
+        let names = order.prefix(5).map { counts[$0]! > 1 ? "\($0) ×\(counts[$0]!)" : $0 }.joined(separator: ", ")
+        let more = order.count > 5 ? ", …" : ""
+        let noun = steps.count == 1 ? "tool" : "tools"
+        return "Ran \(steps.count) \(noun) · \(names)\(more)"
+    }
+}
+
+// MARK: - Layout
+
+// Measures and lays out one item. The cell and the table's row heights use
+// the same numbers, so what is measured is what is drawn.
+enum OmniChatLayout {
+    static let maxColumn: CGFloat = 780
+    static let sideInset: CGFloat = 28
+    static let bubblePadding = NSEdgeInsets(top: 9, left: 14, bottom: 9, right: 14)
+    static let rowGap: CGFloat = 14
+    static let turnHeader: CGFloat = 24
+    static let cardHeader: CGFloat = 30
+    static let maxCharacters = 16_000
+
+    static func column(_ width: CGFloat) -> (x: CGFloat, width: CGFloat) {
+        let columnWidth = min(maxColumn, max(200, width - sideInset * 2))
+        return (max(sideInset, (width - columnWidth) / 2), columnWidth)
+    }
+
+    private static let measureField: NSTextField = {
+        let field = NSTextField(wrappingLabelWithString: "")
+        field.isSelectable = false
+        return field
+    }()
+
+    static func height(_ text: NSAttributedString, width: CGFloat) -> CGFloat {
+        guard text.length > 0 else { return 0 }
+        measureField.attributedStringValue = text
+        return ceil(measureField.cell!.cellSize(forBounds: NSRect(x: 0, y: 0, width: width, height: .greatestFiniteMagnitude)).height)
+    }
+
+    static func naturalWidth(_ text: NSAttributedString, limit: CGFloat) -> CGFloat {
+        guard text.length > 0 else { return 0 }
+        measureField.attributedStringValue = text
+        return ceil(min(limit, measureField.cell!.cellSize(forBounds: NSRect(x: 0, y: 0, width: limit, height: 100_000)).width))
+    }
+
+    static func capped(_ text: String, limit: Int = maxCharacters) -> String {
+        return text.count > limit ? String(text.prefix(limit)) + "\n… (shortened here)" : text
+    }
+}
+
+// MARK: - View
+
+// The transcript as a chat: the person's prompts in bubbles on the right,
+// the agent's replies across the column, commands, skills, tool runs and
+// injected context set apart. A table recycles its rows, so a long session
+// costs only what is on screen; heights are measured once per width.
+final class OmniChatView: NSView, NSTableViewDataSource, NSTableViewDelegate {
+    let scrollView = NSScrollView()
+    let tableView = NSTableView()
+    private(set) var items: [OmniTranscriptItem] = []
+    private(set) var expanded: Set<String> = []
+    var provider: String?
+    var highlightedRecordID: String? {
+        didSet { tableView.reloadData() }
+    }
+    // Scrolled close to the top or the bottom.
+    var nearTop: (() -> Void)?
+    var nearBottom: (() -> Void)?
+    // The ↓ button: the newest message, which the page may need to load.
+    var jumpToLatest: (() -> Void)?
+    let latestButton = NSButton()
+    private var heights: [String: CGFloat] = [:]
+    private var measuredWidth: CGFloat = 0
+    private var texts: [String: NSAttributedString] = [:]
+
+    override var isFlipped: Bool { true }
+
+    override init(frame: NSRect) {
+        super.init(frame: frame)
+        let column = NSTableColumn(identifier: NSUserInterfaceItemIdentifier("chat"))
+        column.resizingMask = .autoresizingMask
+        tableView.addTableColumn(column)
+        tableView.headerView = nil
+        tableView.backgroundColor = .clear
+        tableView.selectionHighlightStyle = .none
+        tableView.intercellSpacing = .zero
+        tableView.usesAlternatingRowBackgroundColors = false
+        tableView.columnAutoresizingStyle = .uniformColumnAutoresizingStyle
+        tableView.dataSource = self
+        tableView.delegate = self
+        tableView.style = .plain
+        scrollView.documentView = tableView
+        scrollView.hasVerticalScroller = true
+        scrollView.autohidesScrollers = true
+        scrollView.drawsBackground = false
+        scrollView.borderType = .noBorder
+        scrollView.contentView.postsBoundsChangedNotifications = true
+        addSubview(scrollView)
+        latestButton.bezelStyle = .circular
+        latestButton.image = NSImage(systemSymbolName: SFSymbol.arrowDown.rawValue, accessibilityDescription: "Jump to the newest message")
+        latestButton.toolTip = "Jump to the newest message"
+        latestButton.target = self
+        latestButton.action = #selector(latestClicked(_:))
+        latestButton.isHidden = true
+        addSubview(latestButton)
+        NotificationCenter.default.addObserver(self, selector: #selector(scrolled),
+                                               name: NSView.boundsDidChangeNotification, object: scrollView.contentView)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    deinit {
+        NotificationCenter.default.removeObserver(self)
+    }
+
+    // The width rows are measured and drawn at: the visible width.
+    var contentWidth: CGFloat {
+        return max(200, scrollView.contentSize.width)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        scrollView.frame = bounds
+        latestButton.frame = NSRect(x: (bounds.width - 32) / 2, y: bounds.height - 48, width: 32, height: 32)
+        tableView.tableColumns.first?.width = contentWidth
+        let width = contentWidth
+        if abs(width - measuredWidth) > 0.5 {
+            measuredWidth = width
+            heights = [:]
+            if !items.isEmpty {
+                let anchor = topAnchor()
+                tableView.reloadData()
+                restore(anchor)
+            }
+        }
+    }
+
+    // MARK: Items
+
+    // Replaces the items, keeping what is on screen where it is (paging in
+    // older messages above), or following the end when it was shown.
+    func setItems(_ newItems: [OmniTranscriptItem], followEnd: Bool) {
+        let anchor = followEnd ? nil : topAnchor()
+        let changed = Set(newItems.map(\.key)).union(items.map(\.key))
+        for key in changed where items.first(where: { $0.key == key }) != newItems.first(where: { $0.key == key }) {
+            heights = heights.filter { !$0.key.hasPrefix(key + "|") }
+            texts = texts.filter { !$0.key.hasPrefix(key + "|") }
+        }
+        items = newItems
+        tableView.reloadData()
+        if followEnd {
+            scrollToEnd()
+        } else {
+            restore(anchor)
+        }
+        updateLatestButton()
+    }
+
+    var isAtEnd: Bool {
+        let clip = scrollView.contentView.bounds
+        return clip.maxY >= tableView.bounds.height - 40
+    }
+
+    func scrollToEnd() {
+        tableView.layoutSubtreeIfNeeded()
+        let y = max(0, tableView.bounds.height - scrollView.contentView.bounds.height)
+        scrollView.contentView.scroll(to: NSPoint(x: 0, y: y))
+        scrollView.reflectScrolledClipView(scrollView.contentView)
+    }
+
+    func scrollTo(recordID: String) {
+        guard let row = items.firstIndex(where: { $0.recordIDs.contains(recordID) || $0.key == recordID }) else { return }
+        let rect = tableView.rect(ofRow: row)
+        scrollView.contentView.scroll(to: NSPoint(x: 0, y: max(0, rect.minY - 40)))
+        scrollView.reflectScrolledClipView(scrollView.contentView)
+    }
+
+    private func topAnchor() -> (key: String, delta: CGFloat)? {
+        let clip = scrollView.contentView.bounds
+        let row = tableView.row(at: NSPoint(x: 1, y: clip.minY + 1))
+        guard row >= 0, row < items.count else { return nil }
+        return (items[row].key, clip.minY - tableView.rect(ofRow: row).minY)
+    }
+
+    private func restore(_ anchor: (key: String, delta: CGFloat)?) {
+        guard let anchor, let row = items.firstIndex(where: { $0.key == anchor.key }) else { return }
+        tableView.layoutSubtreeIfNeeded()
+        let y = max(0, tableView.rect(ofRow: row).minY + anchor.delta)
+        scrollView.contentView.scroll(to: NSPoint(x: 0, y: y))
+        scrollView.reflectScrolledClipView(scrollView.contentView)
+    }
+
+    @objc private func latestClicked(_ sender: Any?) {
+        if let jumpToLatest {
+            jumpToLatest()
+        } else {
+            scrollToEnd()
+        }
+    }
+
+    // The ↓ button shows while the end is out of sight, or not loaded.
+    var hasUnloadedEnd = false {
+        didSet { updateLatestButton() }
+    }
+
+    func updateLatestButton() {
+        latestButton.isHidden = items.isEmpty || (isAtEnd && !hasUnloadedEnd)
+    }
+
+    @objc private func scrolled() {
+        updateLatestButton()
+        let clip = scrollView.contentView.bounds
+        if clip.minY < 600 {
+            nearTop?()
+        }
+        if clip.maxY > tableView.bounds.height - 600 {
+            nearBottom?()
+        }
+    }
+
+    func toggle(_ key: String) {
+        if expanded.contains(key) {
+            expanded.remove(key)
+        } else {
+            expanded.insert(key)
+        }
+        guard let row = items.firstIndex(where: { $0.key == key }) else { return }
+        heights = heights.filter { !$0.key.hasPrefix(key + "|") }
+        tableView.noteHeightOfRows(withIndexesChanged: IndexSet(integer: row))
+        tableView.reloadData(forRowIndexes: IndexSet(integer: row), columnIndexes: IndexSet(integer: 0))
+    }
+
+    // MARK: Images
+
+    private var thumbnails: [String: NSImage] = [:]
+
+    // A prompt's image, read once.
+    func thumbnail(_ path: String) -> NSImage? {
+        if let cached = thumbnails[path] {
+            return cached
+        }
+        guard FileManager.default.fileExists(atPath: path), let image = NSImage(contentsOfFile: path) else { return nil }
+        thumbnails[path] = image
+        return image
+    }
+
+    // MARK: Text
+
+    func attributed(_ item: OmniTranscriptItem, part: String) -> NSAttributedString {
+        let cacheKey = "\(item.key)|\(part)"
+        if let cached = texts[cacheKey] {
+            return cached
+        }
+        let value: NSAttributedString
+        switch part {
+        case "body":
+            value = Self.serif(OmniReportText.attributed(OmniChatLayout.capped(item.text), fontSize: 15))
+        case "markdown":
+            value = OmniReportText.attributed(OmniChatLayout.capped(item.text), fontSize: 13.5)
+        case "plain":
+            value = NSAttributedString(string: OmniReportText.sanitized(OmniChatLayout.capped(item.text)), attributes: [
+                .font: NSFont.systemFont(ofSize: 14), .foregroundColor: NSColor.labelColor,
+                .paragraphStyle: Self.paragraph])
+        case "mono":
+            value = NSAttributedString(string: OmniReportText.sanitized(OmniChatLayout.capped(item.text, limit: 8000)), attributes: [
+                .font: NSFont.monospacedSystemFont(ofSize: 11.5, weight: .regular), .foregroundColor: NSColor.secondaryLabelColor])
+        case "tools":
+            value = Self.toolsText(item.steps)
+        default:
+            value = NSAttributedString()
+        }
+        texts[cacheKey] = value
+        return value
+    }
+
+    // Replies read in the system serif, as Claude's apps set them; code keeps
+    // its monospaced face.
+    static func serif(_ text: NSAttributedString) -> NSAttributedString {
+        let result = NSMutableAttributedString(attributedString: text)
+        result.enumerateAttribute(.font, in: NSRange(location: 0, length: result.length)) { value, range, _ in
+            guard let font = value as? NSFont else { return }
+            if font.fontDescriptor.symbolicTraits.contains(.monoSpace) {
+                // Code sits on a faint ground, as in Claude's and ChatGPT's apps.
+                result.addAttribute(.backgroundColor, value: Self.codeGround, range: range)
+                return
+            }
+            guard let descriptor = font.fontDescriptor.withDesign(.serif),
+                  let serif = NSFont(descriptor: descriptor, size: font.pointSize) else { return }
+            result.addAttribute(.font, value: serif, range: range)
+        }
+        return result
+    }
+
+    private static let codeGround = NSColor(name: nil) { appearance in
+        appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua ?
+            NSColor(white: 1, alpha: 0.08) : NSColor(white: 0, alpha: 0.06)
+    }
+
+    private static let paragraph: NSParagraphStyle = {
+        let style = NSMutableParagraphStyle()
+        style.lineSpacing = 3
+        return style
+    }()
+
+    static func toolsText(_ steps: [OmniToolStep]) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        let name: [NSAttributedString.Key: Any] = [.font: NSFont.monospacedSystemFont(ofSize: 11.5, weight: .semibold),
+                                                   .foregroundColor: NSColor.labelColor]
+        let input: [NSAttributedString.Key: Any] = [.font: NSFont.monospacedSystemFont(ofSize: 11.5, weight: .regular),
+                                                    .foregroundColor: NSColor.labelColor]
+        let output: [NSAttributedString.Key: Any] = [.font: NSFont.monospacedSystemFont(ofSize: 11, weight: .regular),
+                                                     .foregroundColor: NSColor.secondaryLabelColor]
+        for (index, step) in steps.prefix(60).enumerated() {
+            if index > 0 {
+                result.append(NSAttributedString(string: "\n\n", attributes: output))
+            }
+            result.append(NSAttributedString(string: step.name, attributes: name))
+            let summary = OmniTranscriptBuilder.inputSummary(step.input)
+            if !summary.isEmpty {
+                result.append(NSAttributedString(string: "  " + OmniReportText.sanitized(summary), attributes: input))
+            }
+            if let text = step.output, !text.isEmpty {
+                let lines = OmniReportText.sanitized(text).components(separatedBy: "\n")
+                var shown = lines.prefix(24).joined(separator: "\n")
+                if shown.count > 3000 {
+                    shown = String(shown.prefix(3000))
+                }
+                if lines.count > 24 || shown.count < text.count {
+                    shown += "\n…"
+                }
+                result.append(NSAttributedString(string: "\n" + shown, attributes: output))
+            }
+        }
+        if steps.count > 60 {
+            result.append(NSAttributedString(string: "\n\n… \(steps.count - 60) more", attributes: output))
+        }
+        return result
+    }
+
+    // MARK: Table
+
+    func numberOfRows(in tableView: NSTableView) -> Int {
+        return items.count
+    }
+
+    func tableView(_ tableView: NSTableView, heightOfRow row: Int) -> CGFloat {
+        guard row < items.count else { return 20 }
+        let item = items[row]
+        let width = contentWidth
+        let cacheKey = "\(item.key)|\(Int(width))|\(expanded.contains(item.key))"
+        if let height = heights[cacheKey] {
+            return height
+        }
+        let height = OmniChatCell.layout(item, in: self, width: width, expanded: expanded.contains(item.key)).height
+        heights[cacheKey] = height
+        return height
+    }
+
+    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
+        let identifier = NSUserInterfaceItemIdentifier("OmniChatCell")
+        let cell = tableView.makeView(withIdentifier: identifier, owner: self) as? OmniChatCell ?? OmniChatCell()
+        cell.identifier = identifier
+        let item = items[row]
+        cell.configure(item, in: self, expanded: expanded.contains(item.key),
+                       highlighted: highlightedRecordID.map { item.recordIDs.contains($0) || item.key == $0 } ?? false)
+        return cell
+    }
+
+    func tableView(_ tableView: NSTableView, shouldSelectRow row: Int) -> Bool {
+        return false
+    }
+}
+
+// One row of the chat. Its parts are laid out by hand from `layout`, which
+// the table also uses for the row's height.
+final class OmniChatCell: NSTableCellView {
+    private let bubble = NSView()
+    private let icon = NSImageView()
+    private let header = NSTextField(labelWithString: "")
+    private let body = NSTextField(wrappingLabelWithString: "")
+    private let toggleButton = NSButton(title: "", target: nil, action: nil)
+    // Inserted content's tag: an icon and what it is.
+    private let chip = NSView()
+    private let chipIcon = NSImageView()
+    private let chipLabel = NSTextField(labelWithString: "")
+    // The left edge of an opened inserted card.
+    private let accentBar = NSView()
+    private var attachmentViews: [NSView] = []
+    private var itemKey = ""
+    private weak var chat: OmniChatView?
+    private var itemText = ""
+
+    override var isFlipped: Bool { true }
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 600, height: 40))
+        bubble.wantsLayer = true
+        bubble.layer?.cornerRadius = 14
+        addSubview(bubble)
+        icon.imageScaling = .scaleProportionallyDown
+        addSubview(icon)
+        header.lineBreakMode = .byTruncatingTail
+        addSubview(header)
+        body.isSelectable = true
+        body.allowsEditingTextAttributes = true
+        body.drawsBackground = false
+        addSubview(body)
+        toggleButton.bezelStyle = .inline
+        toggleButton.isBordered = false
+        toggleButton.font = NSFont.systemFont(ofSize: 11.5, weight: .medium)
+        toggleButton.contentTintColor = OmniTheme.secondaryText
+        toggleButton.target = self
+        toggleButton.action = #selector(toggled(_:))
+        addSubview(toggleButton)
+        chip.wantsLayer = true
+        chip.layer?.cornerRadius = 11
+        chipIcon.imageScaling = .scaleProportionallyDown
+        chipIcon.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 10.5, weight: .semibold)
+        chip.addSubview(chipIcon)
+        chipLabel.font = Self.chipFont
+        chip.addSubview(chipLabel)
+        addSubview(chip)
+        accentBar.wantsLayer = true
+        accentBar.layer?.cornerRadius = 1.5
+        addSubview(accentBar)
+    }
+
+    static let chipFont = NSFont.systemFont(ofSize: 11, weight: .semibold)
+
+    // What inserted content is called and its icon.
+    static func tag(for item: OmniTranscriptItem) -> (label: String, detail: String, symbol: SFSymbol)? {
+        switch item.kind {
+        case .tools:
+            return ("Tools", OmniTranscriptBuilder.toolsSummary(item.steps), .wrenchAndScrewdriver)
+        case .skill(let name):
+            return ("Skill", name + " · inserted instructions", .book)
+        case .context(let label):
+            let parts = label.components(separatedBy: " · ")
+            let name = parts[0]
+            // A notice with a summary (background tasks) previews that.
+            let untagged = OmniTranscriptBuilder.tagged(item.text, "summary") ??
+                item.text.replacingOccurrences(of: "</?[A-Za-z_-]+[^>]*>", with: " ", options: .regularExpression)
+            var detail = OmniTranscriptBuilder.oneLine(untagged, limit: 120)
+            if parts.count > 1 {
+                detail = parts.dropFirst().joined(separator: " · ") + (detail.isEmpty ? "" : " · " + detail)
+            }
+            let symbols: [String: SFSymbol] = [
+                "Agent message": .bubbleLeftAndBubbleRight, "Teammate message": .person2, "Suggestion": .lightbulb,
+                "Goal": .target, "Goal check-in": .target, "Background task": .bell, "Project instructions": .docText,
+                "File context": .doc, "Command output": .terminal, "Shell output": .terminal, "Environment": .gearshape,
+                "Hook": .link, "System": .exclamationmarkBubble, "System reminder": .exclamationmarkBubble,
+                "Codex context": .cpu, "Developer instructions": .cpu, "OmniTerm": .sparkles, "Hand-back notice": .arrowTurnDownRight,
+                "Summary": .scroll, "Conversation summary": .scroll, "Project instructions ": .docText]
+            return (name, detail, symbols[name] ?? .textBubble)
+        default:
+            return nil
+        }
+    }
+
+    static func chipWidth(_ label: String) -> CGFloat {
+        let width = (label as NSString).size(withAttributes: [.font: chipFont]).width
+        return ceil(width) + 8 + 13 + 5 + 9
+    }
+
+    private static let attachmentSize: CGFloat = 72
+
+    // A thumbnail keeps its image's shape, 72 points high and at most 220 wide.
+    static func attachmentWidth(_ attachment: String, in chat: OmniChatView?) -> CGFloat {
+        guard attachment.hasPrefix("/"), let image = chat?.thumbnail(attachment), image.size.height > 0 else {
+            let label = attachment.hasPrefix("/") ? (attachment as NSString).lastPathComponent : attachment
+            return ceil(("Image · " + label as NSString).size(withAttributes: [.font: chipFont]).width) + 4
+        }
+        return min(220, max(40, attachmentSize * image.size.width / image.size.height))
+    }
+
+    // A prompt's images: thumbnails of files that still exist, else tags.
+    static func attachmentsHeight(_ item: OmniTranscriptItem) -> CGFloat {
+        guard !item.attachments.isEmpty else { return 0 }
+        let thumbnails = item.attachments.contains { $0.hasPrefix("/") && FileManager.default.fileExists(atPath: $0) }
+        return (thumbnails ? attachmentSize : 22) + 8
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    struct Layout {
+        var height: CGFloat
+        var bubble: NSRect = .zero
+        var icon: NSRect = .zero
+        var header: NSRect = .zero
+        var body: NSRect = .zero
+        var toggle: NSRect = .zero
+        var chip: NSRect = .zero
+        var accent: NSRect = .zero
+        var attachments: NSRect = .zero
+        var bodyText: NSAttributedString?
+    }
+
+    private static let userBubble = NSColor(name: nil) { appearance in
+        appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua ?
+            NSColor(white: 1, alpha: 0.09) : NSColor(white: 0, alpha: 0.055)
+    }
+    private static let commandBubble = NSColor(name: nil) { appearance in
+        OmniTheme.accent.withAlphaComponent(appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua ? 0.18 : 0.22)
+    }
+    private static let card = NSColor(name: nil) { appearance in
+        appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua ?
+            NSColor(white: 1, alpha: 0.045) : NSColor(white: 0, alpha: 0.03)
+    }
+
+    static func layout(_ item: OmniTranscriptItem, in chat: OmniChatView, width: CGFloat, expanded: Bool) -> Layout {
+        let (x, columnWidth) = OmniChatLayout.column(width)
+        let gap = OmniChatLayout.rowGap
+        let padding = OmniChatLayout.bubblePadding
+        switch item.kind {
+        case .user, .command:
+            let text: NSAttributedString
+            var headerHeight: CGFloat = 0
+            if case .command(_, let arguments) = item.kind {
+                text = NSAttributedString(string: OmniReportText.sanitized(OmniChatLayout.capped(arguments)), attributes: [
+                    .font: NSFont.systemFont(ofSize: 13.5), .foregroundColor: NSColor.labelColor])
+                headerHeight = 18
+            } else {
+                text = chat.attributed(item, part: "plain")
+            }
+            let maxBubble = columnWidth * 0.82
+            let textLimit = maxBubble - padding.left - padding.right
+            let headerWidth: CGFloat = headerHeight > 0 ? 160 : 0
+            let attachmentHeight = attachmentsHeight(item)
+            let attachmentWidth = min(textLimit, item.attachments.prefix(6).reduce(0) { $0 + attachmentWidth($1, in: chat) + 8 })
+            let natural = max(OmniChatLayout.naturalWidth(text, limit: textLimit), min(textLimit, headerWidth), attachmentWidth)
+            let textHeight = OmniChatLayout.height(text, width: natural)
+            let bubbleWidth = natural + padding.left + padding.right
+            let bubbleHeight = headerHeight + attachmentHeight + textHeight + padding.top + padding.bottom
+            let caption: CGFloat = item.note == nil ? 0 : 17
+            let bubble = NSRect(x: x + columnWidth - bubbleWidth, y: gap / 2 + caption, width: bubbleWidth, height: bubbleHeight)
+            var layout = Layout(height: bubbleHeight + gap + caption, bubble: bubble)
+            if caption > 0 {
+                layout.header = NSRect(x: x, y: gap / 2, width: columnWidth, height: 15)
+            }
+            if headerHeight > 0 {
+                layout.header = NSRect(x: bubble.minX + padding.left, y: bubble.minY + padding.top - 1, width: natural, height: 17)
+            }
+            if attachmentHeight > 0 {
+                layout.attachments = NSRect(x: bubble.minX + padding.left, y: bubble.minY + padding.top + headerHeight,
+                                            width: natural, height: attachmentHeight - 8)
+            }
+            layout.body = NSRect(x: bubble.minX + padding.left, y: bubble.minY + padding.top + headerHeight + attachmentHeight,
+                                 width: natural, height: textHeight)
+            layout.bodyText = text.length > 0 ? text : nil
+            return layout
+        case .assistant:
+            // No name over each reply: alignment and the bubble tell who spoke.
+            // The reply is parsed Markdown, so it sits on the Markdown card.
+            let pad: CGFloat = 14
+            let text = chat.attributed(item, part: "body")
+            let textHeight = OmniChatLayout.height(text, width: columnWidth - 2 * pad)
+            var layout = Layout(height: textHeight + 2 * pad + gap + 4)
+            layout.bubble = NSRect(x: x, y: gap / 2 + 2, width: columnWidth, height: textHeight + 2 * pad)
+            layout.body = NSRect(x: x + pad, y: gap / 2 + 2 + pad, width: columnWidth - 2 * pad, height: textHeight)
+            layout.bodyText = text
+            return layout
+        case .tools, .skill, .context:
+            // Inserted content: a tag saying what it is, a muted preview, and
+            // opened, a card marked by an accent bar. Never a bubble: nobody
+            // typed it.
+            var layout = Layout(height: 0)
+            let label = tag(for: item)?.label ?? ""
+            let chipWidth = chipWidth(label)
+            layout.chip = NSRect(x: x, y: 6, width: chipWidth, height: 22)
+            layout.toggle = NSRect(x: x + chipWidth + 6, y: 7, width: max(40, columnWidth - chipWidth - 6), height: 20)
+            var height: CGFloat = 34
+            if expanded {
+                let part: String
+                switch item.kind {
+                case .tools: part = "tools"
+                case .skill: part = "markdown"
+                default: part = "mono"
+                }
+                let text = chat.attributed(item, part: part)
+                let textWidth = columnWidth - 34
+                let textHeight = OmniChatLayout.height(text, width: textWidth)
+                layout.bubble = NSRect(x: x, y: 34, width: columnWidth, height: textHeight + 20)
+                layout.accent = NSRect(x: x, y: 34, width: 3, height: textHeight + 20)
+                layout.body = NSRect(x: x + 18, y: 44, width: textWidth, height: textHeight)
+                layout.bodyText = text
+                height += textHeight + 26
+            }
+            layout.height = height
+            return layout
+        case .interrupted:
+            var layout = Layout(height: 0)
+            layout.toggle = NSRect(x: x, y: 4, width: columnWidth, height: 18)
+            layout.height = 26
+            return layout
+        }
+    }
+
+    func configure(_ item: OmniTranscriptItem, in chat: OmniChatView, expanded: Bool, highlighted: Bool) {
+        self.chat = chat
+        itemKey = item.key
+        itemText = item.kind == .tools ? OmniChatView.toolsText(item.steps).string : item.text
+        let layout = Self.layout(item, in: chat, width: chat.contentWidth, expanded: expanded)
+        bubble.isHidden = layout.bubble == .zero
+        bubble.frame = layout.bubble
+        bubble.layer?.borderWidth = 0
+        bubble.layer?.cornerRadius = 14
+        icon.isHidden = layout.icon == .zero
+        icon.frame = layout.icon
+        header.isHidden = layout.header == .zero
+        header.frame = layout.header
+        body.isHidden = layout.bodyText == nil
+        body.frame = layout.body
+        body.attributedStringValue = layout.bodyText ?? NSAttributedString()
+        toggleButton.isHidden = layout.toggle == .zero
+        toggleButton.frame = layout.toggle
+        chip.isHidden = layout.chip == .zero
+        chip.frame = layout.chip
+        accentBar.isHidden = layout.accent == .zero
+        accentBar.frame = layout.accent
+        configureAttachments(item, in: layout.attachments)
+        if let tag = Self.tag(for: item) {
+            chipIcon.image = NSImage(systemSymbolName: tag.symbol.rawValue, accessibilityDescription: tag.label)
+            chipIcon.frame = NSRect(x: 8, y: 4, width: 13, height: 14)
+            chipLabel.stringValue = tag.label
+            chipLabel.frame = NSRect(x: 26, y: 3, width: layout.chip.width - 30, height: 15)
+        }
+        toggleButton.alignment = .left
+        toggleButton.imagePosition = .imageLeading
+        let providerName = OmniSessionText.providerName(chat.provider)
+        effectiveAppearance.performAsCurrentDrawingAppearance {
+            switch item.kind {
+            case .user:
+                bubble.layer?.backgroundColor = Self.userBubble.cgColor
+                header.stringValue = item.note ?? ""
+                header.font = NSFont.systemFont(ofSize: 11)
+                header.textColor = OmniTheme.secondaryText
+                header.alignment = .right
+            case .command(let name, _):
+                bubble.layer?.backgroundColor = Self.commandBubble.cgColor
+                header.alignment = .left
+                header.stringValue = name == "!" ? "! shell" : name
+                header.font = NSFont.monospacedSystemFont(ofSize: 12.5, weight: .semibold)
+                header.textColor = .labelColor
+                header.isHidden = false
+            case .assistant:
+                bubble.layer?.backgroundColor = OmniTheme.cardFill.cgColor
+                bubble.layer?.cornerRadius = OmniMarkdownCard.cornerRadius
+                bubble.layer?.borderWidth = 1
+                bubble.layer?.borderColor = OmniTheme.cardBorder.cgColor
+            case .tools, .skill, .context:
+                bubble.layer?.backgroundColor = Self.card.cgColor
+                bubble.layer?.cornerRadius = 8
+                chip.layer?.backgroundColor = Self.chipGround.cgColor
+                chipIcon.contentTintColor = OmniTheme.accent
+                chipLabel.textColor = .labelColor
+                accentBar.layer?.backgroundColor = OmniTheme.accent.withAlphaComponent(0.7).cgColor
+                // A skill's instructions are parsed Markdown: the Markdown card.
+                if case .skill = item.kind {
+                    bubble.layer?.backgroundColor = OmniTheme.cardFill.cgColor
+                    bubble.layer?.borderWidth = 1
+                    bubble.layer?.borderColor = OmniTheme.cardBorder.cgColor
+                }
+            case .interrupted:
+                bubble.layer?.backgroundColor = Self.card.cgColor
+                bubble.layer?.cornerRadius = 8
+            }
+            if highlighted {
+                bubble.isHidden = false
+                if bubble.frame == .zero {
+                    bubble.frame = layout.body.insetBy(dx: -8, dy: -6)
+                }
+                bubble.layer?.borderWidth = 1.5
+                bubble.layer?.borderColor = OmniTheme.accent.cgColor
+            }
+        }
+        toolTip = item.timestamp.flatMap(Self.time)
+        if !header.isHidden, item.startsTurn {
+            header.alignment = .left
+            header.stringValue = providerName
+            header.font = NSFont.systemFont(ofSize: 12.5, weight: .semibold)
+            header.textColor = OmniTheme.secondaryText
+            icon.image = OmniIconImage.image(OmniSessionText.providerSymbol(chat.provider))
+            icon.contentTintColor = OmniTheme.accent
+        }
+        let chevron = expanded ? SFSymbol.chevronDown : SFSymbol.chevronRight
+        switch item.kind {
+        case .tools, .skill, .context:
+            let tag = Self.tag(for: item)
+            toggleButton.title = tag?.detail ?? ""
+            toggleButton.image = NSImage(systemSymbolName: chevron.rawValue, accessibilityDescription: nil)
+            toggleButton.imagePosition = .imageTrailing
+            toggleButton.isEnabled = true
+            switch item.kind {
+            case .tools:
+                toggleButton.toolTip = "Run by the agent: " + OmniTranscriptBuilder.toolNames(item.steps)
+            case .skill:
+                toggleButton.toolTip = "Instructions a skill or command inserted into the prompt, not typed by the person"
+            default:
+                toggleButton.toolTip = "Inserted by the harness or another agent, not typed by the person"
+            }
+        case .interrupted:
+            toggleButton.title = "\(providerName)’s response was interrupted."
+            toggleButton.image = NSImage(systemSymbolName: SFSymbol.stopCircle.rawValue, accessibilityDescription: nil)
+            toggleButton.isEnabled = false
+        default:
+            break
+        }
+        toggleButton.lineBreakMode = .byTruncatingTail
+        (toggleButton.cell as? NSButtonCell)?.lineBreakMode = .byTruncatingTail
+    }
+
+    private static let chipGround = NSColor(name: nil) { appearance in
+        OmniTheme.accent.withAlphaComponent(appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua ? 0.16 : 0.2)
+    }
+
+    private func configureAttachments(_ item: OmniTranscriptItem, in frame: NSRect) {
+        attachmentViews.forEach { $0.removeFromSuperview() }
+        attachmentViews = []
+        guard frame != .zero else { return }
+        var x = frame.minX
+        for attachment in item.attachments.prefix(6) {
+            let view: NSView
+            if attachment.hasPrefix("/"), let image = chat?.thumbnail(attachment) {
+                let imageView = NSImageView(image: image)
+                imageView.imageScaling = .scaleProportionallyUpOrDown
+                imageView.wantsLayer = true
+                imageView.layer?.cornerRadius = 6
+                imageView.layer?.masksToBounds = true
+                imageView.toolTip = attachment
+                imageView.frame = NSRect(x: x, y: frame.minY, width: Self.attachmentWidth(attachment, in: chat), height: Self.attachmentSize)
+                imageView.layer?.borderWidth = 1
+                imageView.layer?.borderColor = NSColor.separatorColor.cgColor
+                view = imageView
+            } else {
+                let label = attachment.hasPrefix("/") ? (attachment as NSString).lastPathComponent : attachment
+                let tag = NSTextField(labelWithString: "Image · " + label)
+                tag.font = Self.chipFont
+                tag.textColor = OmniTheme.secondaryText
+                tag.toolTip = attachment
+                tag.sizeToFit()
+                tag.frame = NSRect(x: x, y: frame.minY + 2, width: tag.frame.width, height: 18)
+                view = tag
+            }
+            addSubview(view)
+            attachmentViews.append(view)
+            x = view.frame.maxX + 8
+        }
+    }
+
+    private static let isoFormatter: ISO8601DateFormatter = {
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return formatter
+    }()
+
+    // A record's time, for the hover tip.
+    static func time(_ timestamp: String) -> String? {
+        guard let date = isoFormatter.date(from: timestamp) ?? ISO8601DateFormatter().date(from: timestamp) else { return nil }
+        return OmniSessionText.dateText(date.timeIntervalSince1970)
+    }
+
+    @objc private func toggled(_ sender: Any?) {
+        chat?.toggle(itemKey)
+    }
+
+    override func menu(for event: NSEvent) -> NSMenu? {
+        let menu = NSMenu(title: "Message")
+        let copy = NSMenuItem(title: "Copy Message", action: #selector(copyMessage(_:)), keyEquivalent: "")
+        copy.target = self
+        menu.addItem(copy)
+        return menu
+    }
+
+    @objc private func copyMessage(_ sender: Any?) {
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(itemText, forType: .string)
+    }
+}
+
+// A plain container laid out top-down.
+final class OmniFlippedView: NSView {
+    override var isFlipped: Bool { true }
+}
