+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        let header = Self.headerHeight
+        headerBar.frame = NSRect(x: 0, y: 0, width: bounds.width, height: header)
+        let (x, width) = OmniChatLayout.column(bounds.width)
+        titleField.frame = NSRect(x: x - 2, y: 16, width: width + 4, height: 26)
+        metaLabel.frame = NSRect(x: x, y: 44, width: width, height: 16)
+        buttons.frame = NSRect(x: x + 4, y: 64, width: width, height: 30)
+        buttons.resizeSubviews(withOldSize: buttons.frame.size)
+        separatorLine.frame = NSRect(x: 0, y: header - 1, width: bounds.width, height: 1)
+        let composerArea = Self.composerHeight + 24
+        var top = header
+        if !systemBar.isHidden {
+            systemBar.frame = NSRect(x: x - 2, y: header + 6, width: width, height: 22)
+            top += Self.systemBarHeight
+            if systemExpanded {
+                let panelHeight = min(max(140, (bounds.height - top - composerArea) * 0.45), 420)
+                systemPanel.frame = NSRect(x: x, y: top, width: width, height: panelHeight)
+                systemText.frame.size.width = systemPanel.contentSize.width
+                top += panelHeight + 8
+            }
+        }
+        chat.frame = NSRect(x: 0, y: top, width: bounds.width, height: max(0, bounds.height - top - composerArea))
+        composer.frame = NSRect(x: x, y: bounds.height - Self.composerHeight - 14, width: width, height: Self.composerHeight)
+        for button in [resumeButton, showTabButton] {
+            button.sizeToFit()
+            button.frame = NSRect(x: width - button.frame.width - 14, y: (Self.composerHeight - 28) / 2,
+                                  width: button.frame.width + 6, height: 28)
+        }
+        composerLabel.frame = NSRect(x: 20, y: (Self.composerHeight - 18) / 2, width: max(40, width - 160), height: 18)
+        pagingLabel.frame = NSRect(x: 0, y: header + 6, width: bounds.width, height: 16)
+    }
+
+    // MARK: - Loading
+
+    // Every refresh tick: the first loads the newest page; later ones follow
+    // a live session's end.
+    private var notIndexed: (focus: String?, waiting: Bool)?
+
+    override func reload() {
+        updateHeader()
+        if let pending = notIndexed, pending.waiting {
+            notIndexed = (pending.focus, false)
+            if let message = pending.focus {
+                focus(onMessage: message)
+            } else {
+                loadTail()
+            }
+            return
+        }
+        guard started else {
+            started = true
+            loadTail()
+            return
+        }
+        if isLive, !hasNewer {
+            loadNewer(force: true)
+        }
+    }
+
+    private func request(_ arguments: [String: Any], completion: @escaping ([AnyHashable: Any]) -> Void) {
+        var request: [String: Any] = ["op": "get_session", "session_id": sessionID, "limit": Self.pageSize]
+        request.merge(arguments) { $1 }
+        let generation = self.generation
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self, generation == self.generation else { return }
+            completion(response)
+        }
+    }
+
+    private func loadTail() {
+        generation += 1
+        request(["tail": true]) { [weak self] response in
+            self?.start(with: response, focus: nil)
+        }
+    }
+
+    // A transcript search match: the session from a little before it, with
+    // older and newer messages paged in either way.
+    func focus(onMessage messageID: String) {
+        generation += 1
+        started = true
+        loadingOlder = false
+        loadingNewer = false
+        request(["message_id": messageID, "offset": 0]) { [weak self] response in
+            // A match on a request echo resolves to the record it echoed.
+            self?.start(with: response, focus: response["focus_message_id"] as? String ?? messageID)
+        }
+    }
+
+    private func start(with response: [AnyHashable: Any], focus: String?) {
+        guard OmniPane.isOK(response) else {
+            if response["code"] as? String == "session_not_found" {
+                // Indexing (or the worker's start) catches up: each refresh tick
+                // asks again.
+                notIndexed = (focus: focus, waiting: true)
+                showMessage("This session has not been indexed yet.\nIts messages appear here once they are read.")
+                return
+            }
+            notIndexed = nil
+            let error = response["error"] as? String
+            showMessage(error.map { "This session cannot be read.\n\($0)" } ?? OmniPane.unreachableMessage(response))
+            return
+        }
+        if let fresh = response["session"] as? [AnyHashable: Any] {
+            session = fresh
+        }
+        records = Self.records(response)
+        rawStart = (response["offset"] as? NSNumber)?.intValue ?? 0
+        rawEnd = (response["end_offset"] as? NSNumber)?.intValue ?? rawStart + records.count
+        hasNewer = (response["next_offset"] as? NSNumber) != nil
+        chat.provider = session["provider"] as? String
+        chat.highlightedRecordID = focus
+        updateHeader()
+        if renamePending {
+            renamePending = false
+            rename(nil)
+        }
+        if records.isEmpty {
+            showMessage(response["partial_index"] as? Bool == true ? "This session is still being indexed." :
+                            "This session has no messages.")
+            return
+        }
+        showContent()
+        let rendering = Date()
+        render(followEnd: focus == nil)
+        if let focus {
+            // A match inside a tagged row (a skill's instructions, a tool's
+            // output) opens that row.
+            if let item = chat.items.first(where: { $0.recordIDs.contains(focus) || $0.key == focus }) {
+                switch item.kind {
+                case .tools, .skill, .context:
+                    if !chat.expanded.contains(item.key) {
+                        chat.toggle(item.key)
+                    }
+                default:
+                    break
+                }
+            }
+            chat.scrollTo(recordID: focus)
+        }
+        let total = Int(Date().timeIntervalSince(openedAt) * 1000)
+        let drawn = Int(Date().timeIntervalSince(rendering) * 1000)
+        omniSessionPageLog.notice("first page \(self.sessionID, privacy: .public): \(total)ms (render \(drawn)ms), \(self.records.count) records, \(self.chat.items.count) items")
+    }
+
+    private static func records(_ response: [AnyHashable: Any]) -> [OmniTranscriptRecord] {
+        return (response["messages"] as? [[AnyHashable: Any]] ?? []).compactMap(OmniTranscriptRecord.init)
+    }
+
+    private func render(followEnd: Bool) {
+        chat.setItems(OmniTranscriptBuilder.build(records, startsMidSession: rawStart > 0), followEnd: followEnd)
+        chat.hasUnloadedEnd = hasNewer
+    }
+
+    // The ↓ button: the end, reloaded from the newest page when the page
+    // opened at a match and has not loaded that far.
+    private func jumpToLatest() {
+        if hasNewer {
+            chat.highlightedRecordID = nil
+            loadingOlder = false
+            loadingNewer = false
+            loadTail()
+        } else {
+            chat.scrollToEnd()
+        }
+    }
+
+    // Scrolled near the top: the page before the first shown message. A page
+    // the response cap cut short is completed before it is shown, so no
+    // record is skipped.
+    private func loadOlder() {
+        guard started, rawStart > 0, !loadingOlder, !records.isEmpty else { return }
+        loadingOlder = true
+        pagingLabel.stringValue = "Loading earlier messages…"
+        pagingLabel.isHidden = false
+        let end = rawStart
+        let begin = max(0, end - Self.pageSize)
+        var collected: [OmniTranscriptRecord] = []
+        func fetch(_ offset: Int) {
+            request(["offset": offset, "limit": end - offset]) { [weak self] response in
+                guard let self else { return }
+                guard OmniPane.isOK(response) else {
+                    self.loadingOlder = false
+                    self.pagingLabel.isHidden = true
+                    return
+                }
+                collected += Self.records(response)
+                let reached = (response["end_offset"] as? NSNumber)?.intValue ?? end
+                if reached < end, reached > offset {
+                    fetch(reached)
+                    return
+                }
+                self.records = collected + self.records
+                self.rawStart = begin
+                self.loadingOlder = false
+                self.pagingLabel.isHidden = true
+                self.render(followEnd: false)
+            }
+        }
+        fetch(begin)
+    }
+
+    // Scrolled near the end, or a live session's tick: what came after.
+    private func loadNewer(force: Bool = false) {
+        guard started, !loadingNewer, !records.isEmpty, hasNewer || force else { return }
+        loadingNewer = true
+        let wasAtEnd = chat.isAtEnd
+        request(["offset": rawEnd]) { [weak self] response in
+            guard let self else { return }
+            self.loadingNewer = false
+            guard OmniPane.isOK(response) else { return }
+            if let fresh = response["session"] as? [AnyHashable: Any] {
+                self.session.merge(fresh) { $1 }
+            }
+            let newer = Self.records(response)
+            self.rawEnd = (response["end_offset"] as? NSNumber)?.intValue ?? self.rawEnd + newer.count
+            self.hasNewer = (response["next_offset"] as? NSNumber) != nil
+            guard !newer.isEmpty else { return }
+            self.records += newer
+            self.render(followEnd: wasAtEnd && self.chat.highlightedRecordID == nil)
+        }
+    }
+
+    // MARK: - Header
+
+    private func updateHeader() {
+        if !renaming {
+            titleField.stringValue = OmniSessionText.title(session["title"] as? String)
+        }
+        var parts = [OmniSessionText.providerName(session["provider"] as? String)]
+        if isLive {
+            parts.append("Live")
+        } else if session["state"] as? String == "archived" {
+            parts.append("Archived")
+        }
+        if let workspace = session["workspace"] as? String, !workspace.isEmpty {
+            parts.append((workspace as NSString).abbreviatingWithTildeInPath)
+        }
+        if let updated = (session["updated"] as? NSNumber)?.doubleValue {
+            parts.append("Last active " + OmniSessionText.dateText(updated))
+        }
+        metaLabel.stringValue = parts.joined(separator: " · ")
+        metaLabel.toolTip = sessionID
+        let hasTab = actions?.paneHasTab(forSession: sessionID) ?? false
+        showTabButton.isHidden = !hasTab
+        resumeButton.isHidden = hasTab || isLive
+        resumeButton.toolTip = "Open this session in a new tab, in its folder (" +
+            (session["provider"] as? String == "codex" ? "codex resume" : "claude --resume") + ")."
+        composerLabel.stringValue = hasTab ? "This session is open in a tab." :
+            (isLive ? "Running in another terminal. New messages appear here." : "Resume this session to continue it.")
+        effectiveAppearance.performAsCurrentDrawingAppearance {
+            composer.layer?.backgroundColor = NSColor.controlBackgroundColor.cgColor
+            composer.layer?.borderColor = NSColor.separatorColor.cgColor
+        }
+        buttons.resizeSubviews(withOldSize: buttons.frame.size)
+    }
+
+    // MARK: - Rename
+
+    private var renamePending = false
+
+    // From the sidebar's Rename…: as soon as the session is known.
+    func renameWhenLoaded() {
+        if session.isEmpty {
+            renamePending = true
+        } else {
+            rename(nil)
+        }
+    }
+
+    @objc func rename(_ sender: Any?) {
+        guard !session.isEmpty else { return }
+        renaming = true
+        titleField.isEditable = true
+        titleField.isSelectable = true
+        titleField.isBordered = true
+        titleField.drawsBackground = true
+        titleField.bezelStyle = .roundedBezel
+        window?.makeFirstResponder(titleField)
+        titleField.currentEditor()?.selectAll(nil)
+    }
+
+    private func endRenaming() {
+        renaming = false
+        titleField.isEditable = false
+        titleField.isSelectable = false
+        titleField.isBordered = false
+        titleField.drawsBackground = false
+        updateHeader()
+    }
+
+    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+        if commandSelector == #selector(cancelOperation(_:)) {
+            endRenaming()
+            window?.makeFirstResponder(chat.tableView)
+            return true
+        }
+        return false
+    }
+
+    // Return in the title: the provider's own rename (Claude's /rename
+    // record, Codex's thread name), then the list follows.
+    @objc func commitRename(_ sender: Any?) {
+        guard renaming else { return }
+        let title = titleField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !title.isEmpty, title != OmniSessionText.title(session["title"] as? String) else {
+            endRenaming()
+            return
+        }
+        buttons.status.stringValue = "Renaming…"
+        OmniSchedulerClient.request(["op": "rename_session", "session_id": sessionID, "title": title]) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response) {
+                self.session["title"] = response["title"] as? String ?? title
+                self.buttons.status.stringValue = ""
+                self.actions?.paneSessionsChanged()
+            } else {
+                self.buttons.status.stringValue = (response["error"] as? String).map { "Not renamed: \($0)" } ?? "Not renamed"
+            }
+            self.endRenaming()
+        }
+    }
+
+    // MARK: - System prompt
+
+    private func loadSystemPrompt() {
+        OmniSchedulerClient.request(["op": "get_system_prompt", "session_id": sessionID]) { [weak self] response in
+            guard let self, OmniPane.isOK(response) else { return }
+            self.systemPrompt = response["system_prompt"] as? String ?? ""
+            let tools = response["tools"] as? [String] ?? []
+            guard !self.systemPrompt.isEmpty else { return }
+            let size = self.systemPrompt.count >= 1000 ?
+                String(format: "%.1fk characters", Double(self.systemPrompt.count) / 1000) : "\(self.systemPrompt.count) characters"
+            var title = "System prompt · " + size
+            if !tools.isEmpty {
+                title += " · \(tools.count) tools"
+            }
+            self.systemBar.title = title
+            self.systemBar.toolTip = tools.isEmpty ? self.systemBar.toolTip : "Tools: " + tools.joined(separator: ", ")
+            var text = OmniReportText.sanitized(self.systemPrompt)
+            if !tools.isEmpty {
+                text += "\n\n— Tools —\n" + tools.joined(separator: "\n")
+            }
+            self.systemText.string = text
+            self.systemBar.isHidden = false
+            self.updateSystemBarChevron()
+            self.layoutPane()
+            if self.openSystemPromptPending {
+                self.openSystemPromptPending = false
+                // The banner's own button, as a click would press it.
+                self.systemBar.performClick(nil)
+            }
+        }
+    }
+
+    private func updateSystemBarChevron() {
+        systemBar.image = NSImage(systemSymbolName: (systemExpanded ? SFSymbol.chevronDown : SFSymbol.chevronRight).rawValue,
+                                  accessibilityDescription: systemExpanded ? "Hide the system prompt" : "Show the system prompt")
+    }
+
+    private var openSystemPromptPending = false
+
+    // omniterm://session/<id>?system=1: open as soon as it has loaded.
+    func openSystemPromptWhenLoaded() {
+        if systemBar.isHidden {
+            openSystemPromptPending = true
+        } else if !systemExpanded {
+            systemBar.performClick(nil)
+        }
+    }
+
+    @objc func toggleSystemPrompt(_ sender: Any?) {
+        systemExpanded.toggle()
+        systemPanel.isHidden = !systemExpanded
+        effectiveAppearance.performAsCurrentDrawingAppearance {
+            systemPanel.layer?.backgroundColor = NSColor(white: effectiveAppearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua ? 1 : 0,
+                                                         alpha: 0.045).cgColor
+        }
+        updateSystemBarChevron()
+        layoutPane()
+    }
+
+    // MARK: - Auto-unblock
+
+    private func loadUnblock() {
+        OmniSchedulerClient.request(["op": "get_unblock", "session_id": sessionID]) { [weak self] response in
+            self?.applyUnblock(response)
+        }
+    }
+
+    private func applyUnblock(_ response: [AnyHashable: Any]) {
+        guard OmniPane.isOK(response) else { return }
+        autoUnblock = (response["auto_unblock"] as? NSNumber)?.boolValue ?? true
+        unblockButton.title = autoUnblock ? "Auto-Unblock On" : "Auto-Unblock Off"
+        unblockButton.toolTip = autoUnblock ?
+            "While this session waits on a question, OmniTerm's unblocker may answer it from the project's guidance. " +
+            "Permission and trust prompts always wait for you. Click to turn off." :
+            "OmniTerm will not answer this session. Click to turn on."
+        if let waiting = response["waiting"] as? [AnyHashable: Any], let kind = waiting["kind"] as? String,
+           buttons.status.stringValue.isEmpty {
+            buttons.status.stringValue = kind == "idle" ? "Waiting for an answer" : "Waiting for your approval"
+        }
+        buttons.needsLayout = true
+        buttons.resizeSubviews(withOldSize: buttons.frame.size)
+    }
+
+    @objc private func toggleUnblock(_ sender: Any?) {
+        unblockButton.isEnabled = false
+        OmniSchedulerClient.request(["op": "set_unblock", "session_id": sessionID, "enabled": !autoUnblock]) { [weak self] response in
+            guard let self else { return }
+            self.unblockButton.isEnabled = true
+            if OmniPane.isOK(response) {
+                self.applyUnblock(response)
+            } else {
+                self.buttons.status.stringValue = response["error"] as? String ?? "Could not change auto-unblock"
+            }
+        }
+    }
+
+    // MARK: - Actions
+
+    // Liveness is read again first: the page may have loaded before the
+    // session started elsewhere.
+    @objc private func resume(_ sender: Any?) {
+        guard !session.isEmpty else { return }
+        resumeButton.isEnabled = false
+        OmniSchedulerClient.request(["op": "get_session", "session_id": sessionID, "limit": 1]) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response), let fresh = response["session"] as? [AnyHashable: Any] {
+                self.session.merge(fresh) { $1 }
+            }
+            self.updateHeader()
+            if let problem = self.actions?.paneResumeSession(self.session) {
+                self.buttons.status.stringValue = problem
+            } else {
+                self.buttons.status.stringValue = ""
+            }
+        }
+    }
+
+    @objc private func showTab(_ sender: Any?) {
+        _ = actions?.paneShowTerminal(forSession: sessionID)
+    }
+
+    @objc private func copyID(_ sender: Any?) {
+        let raw = session["raw_id"] as? String ?? OmniSessionResume.rawID(["session_id": sessionID]) ?? sessionID
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(raw, forType: .string)
+        buttons.status.stringValue = "Copied \(raw)"
+    }
+
+    @objc private func searchMemory(_ sender: Any?) {
+        actions?.paneSearchMemory("session:\(sessionID) ")
+    }
+}
