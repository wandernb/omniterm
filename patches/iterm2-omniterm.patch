+    // MARK: - Search
+
+    @objc private func runSearch(_ sender: Any?) {
+        let query = searchField.stringValue.trimmingCharacters(in: .whitespaces)
+        updateSearchChips(query)
+        guard !query.isEmpty else {
+            searchLike = nil
+            searchResults = []
+            searchTable.reloadData()
+            searchStatus.stringValue = ""
+            return
+        }
+        searchField.recentSearches = OmniRecentSearches.record(query, in: recentSearchDefaults)
+        performSearch(["query": query])
+    }
+
+    // Records like the clicked (or selected) result: its stored vector is the query.
+    @objc func moreLikeThis(_ sender: Any?) {
+        let row = searchTable.clickedRow >= 0 ? searchTable.clickedRow : searchTable.selectedRow
+        guard row >= 0, row < searchResults.count else { return }
+        let result = searchResults[row]
+        let key: String
+        if result["title"] != nil, let id = result["id"] as? String {
+            key = "memory:" + id
+        } else if let id = result["message_id"] as? String ?? result["id"] as? String {
+            key = "message:" + id
+        } else {
+            return
+        }
+        let title = (result["title"] as? String ?? result["text"] as? String ?? "")
+            .replacingOccurrences(of: "\n", with: " ")
+        searchLike = String(OmniReportText.sanitized(title).prefix(60))
+        performSearch(["like": key])
+    }
+
+    private func performSearch(_ arguments: [String: Any]) {
+        let memoriesCorpus = corpusControl.selectedSegment == 0
+        let mode = ["lexical", "semantic", "hybrid"][max(0, modeControl.selectedSegment)]
+        if arguments["like"] == nil {
+            searchLike = nil
+        }
+        searchStatus.stringValue = "Searching…"
+        var request: [String: Any] = ["op": memoriesCorpus ? "search_memories" : "search_transcripts",
+                                      "mode": mode, "limit": 50]
+        request.merge(arguments) { _, new in new }
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self else { return }
+            guard OmniPane.isOK(response) else {
+                self.searchResults = []
+                self.searchTable.reloadData()
+                self.searchStatus.stringValue = response["error"] as? String ?? "Search failed."
+                return
+            }
+            self.searchResults = (response[memoriesCorpus ? "memories" : "matches"] as? [[AnyHashable: Any]]) ?? []
+            self.searchTable.reloadData()
+            var status = self.searchResults.count == 1 ? "1 result" : "\(self.searchResults.count) results"
+            if let like = self.searchLike {
+                status = "More like “\(like)” · " + status
+            }
+            if response["partial_index"] as? Bool == true {
+                status += " · the semantic index is still catching up"
+            }
+            self.searchStatus.stringValue = status
+            if !self.searchResults.isEmpty {
+                self.searchTable.selectRowIndexes(IndexSet(integer: 0), byExtendingSelection: false)
+            }
+        }
+    }
+
+    private func updateSearchChips(_ query: String) {
+        let tokens = OmniSearchQuery.tokens(in: query)
+        searchTokenSource = query
+        guard tokens != searchTokens || searchChips.subviews.count != tokens.count else { return }
+        searchTokens = tokens
+        searchChips.subviews.forEach { $0.removeFromSuperview() }
+        for (index, token) in tokens.enumerated() {
+            let chip = NSButton(title: token.label + "  ✕", target: self, action: #selector(removeSearchChip(_:)))
+            chip.bezelStyle = .inline
+            chip.controlSize = .small
+            chip.font = OmniTheme.Font.meta
+            chip.tag = index
+            chip.setAccessibilityLabel("Remove filter " + token.label)
+            chip.toolTip = "Remove this filter from the query"
+            searchChips.addSubview(chip)
+        }
+        layout(view.bounds.size)
+    }
+
+    private func layoutSearchChips() {
+        var x: CGFloat = 0
+        for case let chip as NSButton in searchChips.subviews {
+            chip.sizeToFit()
+            chip.frame = NSRect(x: x, y: 1, width: chip.frame.width, height: 20)
+            chip.isHidden = chip.frame.maxX > searchChips.bounds.width && x > 0
+            x = chip.frame.maxX + 6
+        }
+    }
+
+    // Removing a chip removes its token from the query and searches again.
+    @objc func removeSearchChip(_ sender: NSButton) {
+        guard sender.tag >= 0, sender.tag < searchTokens.count else { return }
+        searchField.stringValue = OmniSearchQuery.removing(searchTokens[sender.tag], from: searchTokenSource)
+        runSearch(sender)
+    }
+
+    private static func recentSearchesMenu() -> NSMenu {
+        let menu = NSMenu(title: "Recent searches")
+        let title = NSMenuItem(title: "Recent Searches", action: nil, keyEquivalent: "")
+        title.tag = NSSearchField.recentsTitleMenuItemTag
+        menu.addItem(title)
+        let recents = NSMenuItem(title: "", action: nil, keyEquivalent: "")
+        recents.tag = NSSearchField.recentsMenuItemTag
+        menu.addItem(recents)
+        let none = NSMenuItem(title: "No Recent Searches", action: nil, keyEquivalent: "")
+        none.tag = NSSearchField.noRecentsMenuItemTag
+        menu.addItem(none)
+        return menu
+    }
+
+    private func showSearchResult(_ result: [AnyHashable: Any]) {
+        let text = NSMutableAttributedString()
+        let body: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.body, .foregroundColor: NSColor.labelColor]
+        let meta: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.meta, .foregroundColor: OmniTheme.secondaryText]
+        if let title = result["title"] as? String {
+            text.append(NSAttributedString(string: OmniReportText.sanitized(title) + "\n",
+                                           attributes: [.font: OmniTheme.Font.subtitle, .foregroundColor: NSColor.labelColor]))
+            text.append(NSAttributedString(string: (OmniMemoryItem(result)?.detailLine ?? "") + "\n\n", attributes: meta))
+            if let snippet = result["snippet"] as? String, snippet.contains("«") {
+                text.append(OmniSearchQuery.snippet(snippet, font: OmniTheme.Font.body, color: OmniTheme.secondaryText))
+                text.append(NSAttributedString(string: "\n\n", attributes: body))
+            }
+            text.append(NSAttributedString(string: OmniReportText.sanitized(result["body"] as? String ?? ""), attributes: body))
+            text.append(NSAttributedString(string: "\n\nReturn or a double-click opens it in Browse.", attributes: meta))
+        } else {
+            let header = [result["session_id"] as? String, result["role"] as? String, result["timestamp"] as? String,
+                          result["workspace"] as? String].compactMap { $0 }.joined(separator: " · ")
+            text.append(NSAttributedString(string: OmniReportText.sanitized(header) + "\n\n", attributes: meta))
+            if let snippet = result["snippet"] as? String, snippet.contains("«") {
+                text.append(OmniSearchQuery.snippet(snippet, font: OmniTheme.Font.body, color: OmniTheme.secondaryText))
+                text.append(NSAttributedString(string: "\n\n", attributes: body))
+            }
+            text.append(NSAttributedString(string: OmniReportText.sanitized(result["text"] as? String ?? result["chunk"] as? String ?? ""),
+                                           attributes: body))
+        }
+        if let score = (result["score"] as? NSNumber)?.doubleValue {
+            text.append(NSAttributedString(string: String(format: "\n\nScore %.3f", score), attributes: meta))
+        }
+        searchDetailText.textStorage?.setAttributedString(text)
+    }
+
