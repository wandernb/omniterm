+// A clickable run row: outcome stripe, title and one-line summary.
+final class OmniRunRowView: NSView, OmniZoneItem, OmniContextRow {
+    private let stripe = NSView()
+    private let title = NSTextField(labelWithString: "")
+    private let detail = NSTextField(labelWithString: "")
+    private let badge = OmniBadgeView()
+    private let action: () -> Void
+    private var hovering = false {
+        didSet { needsDisplay = true }
+    }
+    var isSelected = false {
+        didSet { needsDisplay = true }
+    }
+    var zoneHasFocus = false {
+        didSet {
+            if zoneHasFocus != oldValue && isSelected {
+                needsDisplay = true
+            }
+        }
+    }
+
+    static let height: CGFloat = 46
+
+    override var isFlipped: Bool { true }
+
+    var contextMenu: (() -> NSMenu?)?
+
+    override func menu(for event: NSEvent) -> NSMenu? {
+        return contextMenu?() ?? super.menu(for: event)
+    }
+
+    override func resetCursorRects() {
+        addCursorRect(bounds, cursor: .pointingHand)
+    }
+
+    init(title: String, detail: String, badge badgeText: String, color: NSColor, action: @escaping () -> Void) {
+        self.action = action
+        super.init(frame: NSRect(x: 0, y: 0, width: 400, height: Self.height))
+        wantsLayer = true
+        stripe.wantsLayer = true
+        stripe.layer?.cornerRadius = 1.5
+        stripe.layer?.backgroundColor = color.cgColor
+        addSubview(stripe)
+        self.title.stringValue = title
+        self.title.font = OmniTheme.Font.rowTitleEmphasized
+        self.title.lineBreakMode = .byTruncatingTail
+        addSubview(self.title)
+        self.detail.stringValue = detail
+        self.detail.font = OmniTheme.Font.rowDetail
+        self.detail.textColor = OmniTheme.secondaryText
+        self.detail.lineBreakMode = .byTruncatingTail
+        addSubview(self.detail)
+        badge.configure(text: badgeText.uppercased(), color: color)
+        addSubview(badge)
+        addTrackingArea(NSTrackingArea(rect: .zero, options: [.mouseEnteredAndExited, .activeInKeyWindow, .inVisibleRect],
+                                       owner: self, userInfo: nil))
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        badge.sizeToFitLabel()
+        badge.frame.origin = NSPoint(x: bounds.width - badge.frame.width - 8, y: 8)
+        stripe.frame = NSRect(x: 4, y: 7, width: 3, height: bounds.height - 14)
+        title.frame = NSRect(x: 16, y: 6, width: max(0, badge.frame.minX - 24), height: 18)
+        detail.frame = NSRect(x: 16, y: 25, width: max(0, bounds.width - 24), height: 16)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        OmniZoneItemStyle.drawBackground(in: bounds, selected: isSelected, focused: zoneHasFocus, hovering: hovering)
+    }
+
+    override func mouseEntered(with event: NSEvent) {
+        hovering = true
+    }
+
+    override func mouseExited(with event: NSEvent) {
+        hovering = false
+    }
+
+    override func mouseDown(with event: NSEvent) {
+    }
+
+    override func mouseUp(with event: NSEvent) {
+        if bounds.contains(convert(event.locationInWindow, from: nil)) {
+            action()
+        }
+    }
+
+    func activate() {
+        action()
+    }
+
+    static func forRun(_ run: OmniRun, showAgent: Bool, action: @escaping () -> Void) -> OmniRunRowView {
+        let when = OmniFormat.relative(min(run.started, Date()))
+        let title = showAgent ? "\(run.agent) · \(when)" : when
+        let summary = run.oneLineSummary
+        return OmniRunRowView(title: title,
+                              detail: summary.isEmpty ? "No summary yet" : summary,
+                              badge: run.outcomeName,
+                              color: run.outcomeColor,
+                              action: action)
+    }
+}
+
+// A list row's background: hover, selection, and selection while its zone
+// has the keyboard, drawn in the accent colour.
+enum OmniZoneItemStyle {
+    static func drawBackground(in rect: NSRect, selected: Bool, focused: Bool, hovering: Bool) {
+        let alpha: CGFloat
+        if selected {
+            alpha = focused ? 0.34 : 0.18
+        } else if hovering {
+            alpha = 0.08
+        } else {
+            return
+        }
+        NSColor.controlAccentColor.withAlphaComponent(alpha).setFill()
+        NSBezierPath(roundedRect: rect, xRadius: 6, yRadius: 6).fill()
+    }
+}
