+    private enum ProjectDrop {
+        case project(root: String, folder: String, before: String?)
+        case folder(path: String, newPath: String?, before: String?)
+    }
+
+    private func projectDrop(_ info: NSDraggingInfo, item: Any?, index: Int) -> ProjectDrop? {
+        guard let target = item as? OmniSidebarItem else { return nil }
+        let path: String
+        switch target.kind {
+        case .projectFolder: path = target.groupPath
+        case .section where target === forgeProjectsSection: path = ""
+        default: return nil
+        }
+        let onItem = index == NSOutlineViewDropOnItemIndex
+        func before(excluding key: String) -> String? {
+            guard !onItem, index >= 0, index < target.children.count else { return nil }
+            return target.children[index...].lazy.compactMap(Self.orderKey).first { $0 != key }
+        }
+        if let root = info.draggingPasteboard.string(forType: Self.projectDragType) {
+            return .project(root: root, folder: path, before: before(excluding: OmniProjectLayout.key(root)))
+        }
+        guard let moving = info.draggingPasteboard.string(forType: Self.projectFolderDragType) else { return nil }
+        let key = before(excluding: OmniGroupTree.groupKey(moving))
+        if OmniGroupTree.parent(of: moving) == path {
+            return onItem ? nil : .folder(path: moving, newPath: nil, before: key)
+        }
+        guard let newPath = OmniSidebarMoves.regroupedPath(moving, into: path, tree: projectTree) else { return nil }
+        return .folder(path: moving, newPath: newPath, before: key)
+    }
+
+    private func acceptProjectDrop(_ drop: ProjectDrop) {
+        var layout = projectLayout
+        switch drop {
+        case .project(let root, let folder, let before):
+            layout.move(project: root, into: folder, before: before, tree: projectTree)
+            saveProjectLayout(layout, problemOn: "project|\(root)")
+        case .folder(let path, let newPath, let before):
+            if let newPath {
+                layout.move(folder: path, to: newPath, before: before, tree: projectTree)
+            } else {
+                layout.reorder(folder: path, before: before, tree: projectTree)
+            }
+            saveProjectLayout(layout, problemOn: "projectFolder|\(newPath ?? path)")
+        }
+    }
+
+    // Reloads the whole list only when rows come or go, and never while a
+    // mouse button is down, so a refresh cannot swallow a click. Otherwise
+    // only the rows that changed are redrawn.
+    private var lastStructure = ""
+    private var lastContent: [String: String] = [:]
+
+    private static func structure(_ row: OmniSidebarItem) -> String {
+        guard !row.children.isEmpty else { return row.key }
+        return row.key + "(" + row.children.map(structure).joined(separator: ",") + ")"
+    }
+
+    private static func flattened(_ rows: [OmniSidebarItem]) -> [OmniSidebarItem] {
+        return rows.flatMap { [$0] + flattened($0.children) }
+    }
+
+    // The machine's real mouse state; tests that run beside a person using
+    // the mouse replace it.
+    static var mouseButtonIsDown: () -> Bool = { NSEvent.pressedMouseButtons != 0 }
+
+    // Also waits out an inline rename and a drag (a mouse button is down).
+    private var isInteracting: Bool {
+        return Self.mouseButtonIsDown() || editing != nil
+    }
+
+    private func applyUpdate(items: [OmniSidebarItem], structure: String) {
+        if isInteracting {
+            reloadDeferred = true
+            return
+        }
+        reloadDeferred = false
+        let rows = Self.flattened(items)
+        let liveKeys = Set(rows.map(\.key))
+        itemCache = itemCache.filter { liveKeys.contains($0.value.key) }
+        if structure != lastStructure {
+            lastStructure = structure
+            rootItems = items
+            lastContent = [:]
+            for row in rows {
+                lastContent[row.key] = row.contentSignature
+            }
+            // The selection is put back by route afterwards; a row that moved
+            // under it must not open its own page meanwhile.
+            syncingSelection = true
+            outlineView.reloadData()
+            restoreExpansion()
+            syncingSelection = false
+            beginPendingEdit()
+            return
+        }
+        // A row's kind fixes its height, so redrawing the row is enough.
+        for row in rows where lastContent[row.key] != row.contentSignature {
+            lastContent[row.key] = row.contentSignature
+            outlineView.reloadItem(row)
+        }
+    }
+
+    // MARK: - Groups: expansion
+
+    private var collapsedGroups: Set<String> {
+        get {
+            let value = CFPreferencesCopyAppValue(Self.collapsedGroupsKey, Self.preferencesDomain)
+            return Set(value as? [String] ?? [])
+        }
+        set {
+            CFPreferencesSetAppValue(Self.collapsedGroupsKey, Array(newValue).sorted() as CFArray, Self.preferencesDomain)
+            CFPreferencesAppSynchronize(Self.preferencesDomain)
+        }
+    }
+
+    // Sections are always open; groups open unless the person closed them.
+    private func restoreExpansion() {
+        restoringExpansion = true
+        let collapsed = collapsedGroups
+        for section in rootItems where section.kind == .section {
+            outlineView.expandItem(section)
+            for row in section.children where row.kind == .session && !row.children.isEmpty {
+                outlineView.expandItem(row)
+            }
+        }
+        for row in Self.flattened(agentsSection.children) where row.kind == .group {
+            if collapsed.contains(row.groupPath) {
+                outlineView.collapseItem(row)
+            } else {
+                outlineView.expandItem(row)
+            }
+        }
+        let collapsedViews = collapsedViewGroups
+        for row in Self.flattened(rootItems) where row.kind == .viewGroup || row.kind == .sessionFolder {
+            if collapsedViews.contains(row.key) {
+                outlineView.collapseItem(row)
+            } else {
+                outlineView.expandItem(row)
+            }
+        }
+        let collapsedProjects = collapsedProjectFolders
+        for row in Self.flattened(forgeProjectsSection.children) where row.kind == .projectFolder {
+            if collapsedProjects.contains(row.groupPath) {
+                outlineView.collapseItem(row)
+            } else {
+                outlineView.expandItem(row)
+            }
+        }
+        restoringExpansion = false
+    }
+
+    func outlineViewItemDidExpand(_ notification: Notification) {
+        rememberExpansion(notification, collapsed: false)
+    }
+
+    // The project folder being closed, while AppKit closes its subfolders with it.
+    private weak var collapsingProjectFolder: OmniSidebarItem?
+
+    func outlineViewItemWillCollapse(_ notification: Notification) {
+        if let row = notification.userInfo?["NSObject"] as? OmniSidebarItem, row.kind == .projectFolder,
+           collapsingProjectFolder == nil {
+            collapsingProjectFolder = row
+            DispatchQueue.main.async { [weak self] in
+                self?.collapsingProjectFolder = nil
+            }
+        }
+    }
+
+    func outlineViewItemDidCollapse(_ notification: Notification) {
+        rememberExpansion(notification, collapsed: true)
+    }
+
+    private var collapsedViewGroups: Set<String> {
+        get { Set(CFPreferencesCopyAppValue(Self.collapsedViewGroupsKey, Self.preferencesDomain) as? [String] ?? []) }
+        set {
+            CFPreferencesSetAppValue(Self.collapsedViewGroupsKey, Array(newValue).sorted() as CFArray, Self.preferencesDomain)
+            CFPreferencesAppSynchronize(Self.preferencesDomain)
+        }
+    }
+
+    private func rememberExpansion(_ notification: Notification, collapsed: Bool) {
+        if !restoringExpansion, let row = notification.userInfo?["NSObject"] as? OmniSidebarItem,
+           row.kind == .viewGroup || row.kind == .sessionFolder {
+            var groups = collapsedViewGroups
+            if collapsed { groups.insert(row.key) } else { groups.remove(row.key) }
+            collapsedViewGroups = groups
+            return
+        }
+        guard !restoringExpansion,
+              let row = notification.userInfo?["NSObject"] as? OmniSidebarItem, row.isFolder else { return }
+        if row.kind == .projectFolder {
+            // Closing a folder hides its subfolders too; only the folder itself is remembered.
+            if collapsed, let parent = outlineView.parent(forItem: row) as? OmniSidebarItem, parent.kind == .projectFolder,
+               !outlineView.isItemExpanded(parent) || parent === collapsingProjectFolder {
+                return
+            }
+            var folders = collapsedProjectFolders
+            if collapsed {
+                folders.insert(row.groupPath)
+            } else {
+                folders.remove(row.groupPath)
+            }
+            collapsedProjectFolders = folders
+            return
+        }
+        var groups = collapsedGroups
+        if collapsed {
+            groups.insert(row.groupPath)
+        } else {
+            groups.remove(row.groupPath)
+        }
+        collapsedGroups = groups
+    }
+
+    // A tab selected some other way (keyboard, a new run, restoration) takes
+    // over from the pane, unless it is the card's own live tab; a tab that
+    // closed under a pane does not. The dashboard tab is never shown:
+    // Overview stands in for it.
+    private func followCurrentTab(tabs: [PTYTab], dashboardTabIDs: Set<Int32>, backgroundAgents: Set<String>) {
+        if let pendingRunID {
+            if runTab(pendingRunID) != nil {
+                self.pendingRunID = nil
+                if let pendingRoute, contentHost.route == pendingFromRoute {
+                    contentHost.show(pendingRoute)
+                }
+            } else if Date() > pendingRunDeadline {
+                self.pendingRunID = nil
+            }
+        }
+        let current = terminal?.currentTab()
+        let currentID = current?.uniqueId
+        // A background agent's run tab is housekeeping with no sidebar row:
+        // selected by accident (a closing neighbour, a launch), it never takes
+        // over the window. Open Terminal on its run page still shows it.
+        let incidentalBackground = current.map {
+            Self.isBackgroundRunTab($0, backgroundAgents: backgroundAgents) &&
+                $0.uniqueId != tabFollowing.explicitTerminalTabID
+        } ?? false
+        if contentHost.isShowingPane, let last = lastCurrentTabID, currentID != last,
+           tabs.contains(where: { $0.uniqueId == last }),
+           current == nil || current !== cardTab(), !incidentalBackground {
+            contentHost.hide()
+        }
+        lastCurrentTabID = currentID
+        if !contentHost.isShowingPane, let currentID,
+           dashboardTabIDs.contains(currentID) || incidentalBackground {
+            contentHost.show(.overview)
+        } else if !contentHost.isShowingPane, let current,
+                  let route = tabFollowing.route(forTab: current.uniqueId,
+                                                 environments: (current.sessions() ?? []).map { $0.environment }) {
+            // A run tab selected some other way (at launch, a new run, the
+            // keyboard) shows its run's page, as its row does: the row is
+            // selected and the window is named after the run.
+            contentHost.show(route)
+        }
+    }
+
+    private var tabFollowing = OmniTabFollowing()
+
+    // A run tab's page, by the OMNITERM_RUN_ID its session was launched with
+    // or, for a job adopted after a relaunch, read back from its process.
+    static func runRoute(forSessionEnvironments environments: [[AnyHashable: Any]?]) -> OmniPaneRoute? {
+        for environment in environments {
+            guard let environment, environment["OMNITERM_KIND"] as? String == "run",
+                  let runID = environment["OMNITERM_RUN_ID"] as? String, !runID.isEmpty else { continue }
+            return .run(runID)
+        }
+        return nil
+    }
+
+    // Puts the card's live tab under it, gives the window the header inset
+    // and the host its cover, and sends keys to whatever is on screen.
+    // Diagnosis aid for the blank terminal under a card; remove with it.
+    // `defaults write com.omniterm.app OmniDebugForceInset -int 104` insets
+    // plain terminal rows too, with no host over them.
+    private static var debugForcedInset: CGFloat? {
+        let value = CFPreferencesCopyAppValue("OmniDebugForceInset" as CFString, "com.omniterm.app" as CFString)
+        guard let number = value as? NSNumber, number.doubleValue > 0 else { return nil }
+        return CGFloat(number.doubleValue)
+    }
+
+    private func layoutContent() {
+        guard let terminal else { return }
+        var inset: CGFloat = 0
+        var covers = true
+        if let card = contentHost.card {
+            let tab = cardTab()
+            card.terminalAvailable = tab != nil
+            if let tab, tab !== terminal.currentTab(), let item = tab.tabViewItem {
+                lastCurrentTabID = tab.uniqueId
+                selectTab(item)
+            }
+            // Header and details take a share of the panel; the terminal band
+            // gets the rest, or nearly all of it when expanded.
+            let panel = terminal.tabView().frame.height + appliedInset
+            card.panelHeight = panel
+            let header = OmniCardPane.headerHeight
+            if card.expanded {
+                inset = OmniCardPane.stripHeight
+            } else if card.bandCollapsed {
+                // The card covers the panel; the terminal under it keeps
+                // nearly all of its rows.
+                inset = header
+            } else if let share = panelLayout.layout.detailsShare {
+                inset = min(max(header + 80, (panel * share).rounded()), max(header + 80, panel - 80))
+            } else {
+                // Short details give their unused height to the terminal band.
+                let most = (panel * OmniCardPane.detailsShare).rounded()
+                let wanted = header + ceil(min(card.detailsPreferredHeight, most))
+                inset = max(header + 80, min(most, wanted))
+            }
+            card.contentInset = inset
+            covers = card.coversTerminal
+        }
+        if contentHost.card == nil, let forced = Self.debugForcedInset {
+            inset = forced
+        }
+        if inset != appliedInset {
+            appliedInset = inset
+            terminal.setOmniContentTopInset(inset, animated: true)
+        }
+        contentHost.setLayout(headerHeight: inset, coversTerminal: covers)
+
+        let showsTerminal = !contentHost.isShowingPane || !covers
+        if !showsTerminal {
+            contentHost.takeKeyFocus()
+        }
+        let focusKey = "\(String(describing: contentHost.route))|\(terminal.currentTab()?.uniqueId ?? -1)|\(showsTerminal)"
+        guard focusKey != lastFocusKey else { return }
+        lastFocusKey = focusKey
+        // Moving through the sidebar or a page's zone with the keyboard keeps
+        // focus there.
+        if sidebarHasFocus || contentHost.hasZoneFocus {
+            return
+        }
+        if showsTerminal {
+            terminal.currentTab()?.activeSession?.takeFocus()
+        } else {
+            contentHost.takeKeyFocus()
+        }
+    }
+
+    // MARK: - Selection
+
+    // Highlights the row of the pane or the tab the window shows, however it
+    // was selected.
+    private func syncSelection() {
+        var row = -1
+        let route = contentHost.route
+        let title: String?
+        switch route {
+        case .overview: title = "Dashboard"
+        case .inbox: title = "Inbox"
+        case .memory: title = "Memory"
+        case .settings: title = "Settings"
+        case .unblocker: title = "Unblocker"
+        case .projects: title = "Projects"
+        case .search(let query): title = query.isEmpty ? "Search" : "Search · \(query)"
+        case .project(let root): title = (root as NSString).lastPathComponent
+        case .agent(let name): title = name
+        case .run(let id): title = recentRuns.first { $0.id == id }.map { "\($0.agent) · Run" } ?? "Run"
+        case .group(let path): title = path.components(separatedBy: "/").last ?? path
+        case .session(let id):
+            title = sessions.first { $0["session_id"] as? String == id }
+                .map { OmniSessionText.title($0["title"] as? String) } ?? "Session"
+        case nil: title = nil
+        }
+        if title != paneTitle {
+            paneTitle = title
+            paneTitleDidChange?()
+        }
+        // A project folder has no page: once chosen it keeps the selection
+        // (for the arrow keys and rename) until another page opens.
+        if let folder = selectedItem, folder.kind == .projectFolder, route == projectFolderSelectedOver {
+            return
+        }
+        projectFolderSelectedOver = nil
+        let current = terminal?.currentTab()
+        for index in 0..<outlineView.numberOfRows {
+            guard let item = outlineView.item(atRow: index) as? OmniSidebarItem, item.isSelectable else {
+                continue
+            }
+            let matches: Bool
+            if case .project = route, mode != .projects {
+                // A project's page keeps the Projects row highlighted.
+                matches = item.kind == .projects
+            } else if let route {
+                matches = item.route == route
+            } else {
+                matches = item.route == nil && current != nil && item.tab === current
+            }
+            if matches {
+                row = index
+                break
+            }
+        }
+        guard row != outlineView.selectedRow else { return }
+        syncingSelection = true
+        if row >= 0 {
+            outlineView.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+            outlineView.scrollRowToVisible(row)
+        } else {
+            outlineView.deselectAll(nil)
+        }
+        syncingSelection = false
+    }
+
+    private func show(_ tab: PTYTab) {
+        guard let tabViewItem = tab.tabViewItem else { return }
+        // Open Terminal or a terminal row: the full terminal, not its page.
+        tabFollowing.terminalShownExplicitly(tab.uniqueId)
+        contentHost.hide()
+        selectTab(tabViewItem)
+        lastCurrentTabID = tab.uniqueId
+        layoutContent()
+        syncSelection()
+    }
+
+    private func showPane(_ route: OmniPaneRoute) {
+        tabFollowing.pageShown()
+        lastCurrentTabID = terminal?.currentTab()?.uniqueId
+        contentHost.show(route)
+        layoutContent()
+        syncSelection()
+    }
