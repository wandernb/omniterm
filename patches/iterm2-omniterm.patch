+// A worker that exits after a save but before its acknowledgement: the save
+// stands, the tick ends without failing, and the restarted worker (which
+// starts with nothing pending) lets the next tick produce again.
+- (void)testKnowledgeTickSurvivesAWorkerRestartBetweenSaveAndAcknowledgement {
+    OmniKnowledgeTestScheduler *scheduler = [self knowledgeScheduler];
+    [scheduler setValue:@YES forKey:@"knowledgeEnabled"];
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        if ([request[@"op"] isEqual:@"ack_writes"]) return @{ @"ok": @NO, @"code": @"knowledge_transport", @"error": @"Worker exited" };
+        return @{ @"ok": @YES, @"_writes": @[ @{ @"key": @"memory:kept", @"value": @{ @"body": @"K" } } ],
+                  @"_revision": @1, @"_more_writes": @YES };
+    };
+    [scheduler tickKnowledge];
+    XCTAssertEqualObjects([self savedKnowledgeRecord:@"memory:kept"], (@{ @"body": @"K" }));
+    NSMutableArray *operations = [NSMutableArray array];
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        [operations addObject:request[@"op"]];
+        return @{ @"ok": @YES };
+    };
+    [scheduler tickKnowledge];
+    XCTAssertTrue([operations containsObject:@"scan"], @"the restarted worker is indexed again");
+    XCTAssertEqualObjects(scheduler.knowledgeMaintenance[@"writes_waiting"], @NO);
+    scheduler.workerRequest = nil;
+    [scheduler stop];
+}
