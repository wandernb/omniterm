+- (NSDictionary *)integrationKnowledgeRequest:(NSDictionary *)request until:(BOOL (^)(NSDictionary *response))condition {
+    XCTestExpectation *answered = [self expectationWithDescription:@"native knowledge response"];
+    __block NSDictionary *result = nil;
+    __block BOOL finished = NO;
+    __block void (^send)(void) = nil;
+    NSDate *deadline = [NSDate dateWithTimeIntervalSinceNow:20];
+    OmniKnowledgeIntegrationScheduler *scheduler = _knowledgeIntegrationScheduler;
+    send = ^{
+        if (finished) return;
+        [scheduler performRequest:request completion:^(NSDictionary *response) {
+            if (finished) return;
+            NSString *code = response[@"code"];
+            const BOOL starting = [code isEqual:@"knowledge_unavailable"] || [code isEqual:@"knowledge_starting"];
+            const BOOL waitingForResult = [response[@"ok"] isEqual:@YES] && condition && !condition(response);
+            if ((starting || waitingForResult) && deadline.timeIntervalSinceNow > 0) {
+                // Poll actual startup/indexing responses with a deadline;
+                // elapsed time alone never establishes readiness.
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_MSEC), dispatch_get_main_queue(), send);
+                return;
+            }
+            result = response;
+            finished = YES;
+            [answered fulfill];
+        }];
+    };
+    send();
+    [self waitForExpectations:@[ answered ] timeout:35];
+    finished = YES;
+    send = nil;
+    XCTAssertNotNil(result);
+    return result;
+}
+
+- (NSDictionary *)integrationKnowledgeRequest:(NSDictionary *)request {
+    return [self integrationKnowledgeRequest:request until:nil];
+}
+
+- (void)runIntegrationKnowledgeTick {
+    XCTestExpectation *ticked = [self expectationWithDescription:@"native indexing cycle"];
+    OmniKnowledgeIntegrationScheduler *scheduler = _knowledgeIntegrationScheduler;
+    dispatch_queue_t queue = [scheduler valueForKey:@"knowledgeQueue"];
+    dispatch_async(queue, ^{
+        [scheduler tickKnowledge];
+        dispatch_async(dispatch_get_main_queue(), ^{ [ticked fulfill]; });
+    });
+    [self waitForExpectations:@[ ticked ] timeout:35];
+}
+
+- (void)pauseIntegrationKnowledgeMaintenance {
+    XCTestExpectation *paused = [self expectationWithDescription:@"native index maintenance paused"];
+    OmniKnowledgeIntegrationScheduler *scheduler = _knowledgeIntegrationScheduler;
+    dispatch_queue_t queue = [scheduler valueForKey:@"knowledgeQueue"];
+    dispatch_async(queue, ^{
+        dispatch_source_t timer = [scheduler valueForKey:@"knowledgeTimer"];
+        dispatch_source_cancel(timer);
+        dispatch_async(dispatch_get_main_queue(), ^{ [paused fulfill]; });
+    });
+    [self waitForExpectations:@[ paused ] timeout:35];
+}
