+    // The shared rows, then the person's folders of forge projects.
+    private func rebuildProjects() {
+        buildProjectSection()
+        inboxItem.count = inboxUnread > 0 ? "\(inboxUnread)" : ""
+        inboxItem.countNeedsAttention = inboxUnread > 0 && inboxAttention > 0
+        let items = sharedItems + [forgeProjectsSection]
+        applyUpdate(items: items, structure: "projects;" + items.map(Self.structure).joined(separator: ";"))
+        // Opened again if an earlier version left it hidden.
+        if !outlineView.isItemExpanded(forgeProjectsSection) {
+            outlineView.expandItem(forgeProjectsSection)
+        }
+        followCurrentTab(tabs: terminal?.tabs() ?? [], dashboardTabIDs: [], backgroundAgents: OmniBackgroundAgents.names(agents))
+        layoutContent()
+        syncSelection()
+    }
+
+    // Projects mode's list: forge projects in the person's folders.
+    private func buildProjectSection() {
+        let roots = forgeProjects.compactMap { $0["root"] as? String }
+        projectTree = projectLayout.tree(roots: roots)
+        let byRoot = Dictionary(forgeProjects.compactMap { project in (project["root"] as? String).map { ($0, project) } },
+                                uniquingKeysWith: { first, _ in first })
+        func rows(_ entries: [OmniGroupTree.Entry]) -> [OmniSidebarItem] {
+            return entries.compactMap { entry in
+                switch entry {
+                case .agent(let root):
+                    guard let project = byRoot[root] else { return nil }
+                    let title = projectLayout.name(root) ?? OmniProjectsModel.name(project)
+                    let updated = (project["updated"] as? NSNumber)?.doubleValue
+                    let row = item(.project, key: root, title: title, detail: OmniSessionText.age(updated),
+                                   route: .project(root))
+                    row.groupPath = projectLayout.folders[root] ?? ""
+                    (row.icon, row.iconColor) = projectLayout.appearance(root)
+                    row.children = []
+                    return row
+                case .group(let group):
+                    let row = item(.projectFolder, key: group.path, title: group.name)
+                    row.groupPath = group.path
+                    (row.icon, row.iconColor) = projectLayout.appearance(OmniProjectLayout.folderKey(group.path))
+                    row.children = rows(group.children)
+                    return row
+                }
+            }
+        }
+        forgeProjectsSection.children = rows(projectTree.entries)
+    }
+
+    // The search: projects, sessions (by title and folder, then inside
+    // transcripts), agents, runs and terminals, and memories, each under
+    // its own header; empty headers are left out.
+    private func rebuildSearch() {
+        let query = sessionQuery.lowercased()
+        buildProjectSection()
+        forgeProjectsSection.children = Self.filtered(forgeProjectsSection.children, query: query)
+        let built = buildAgentSections()
+        for section in [agentsSection, runsSection, terminalsSection] {
+            section.children = Self.filtered(section.children, query: query)
+        }
+        func sessionRow(_ session: [AnyHashable: Any], key: String, detail: String? = nil) -> OmniSidebarItem? {
+            guard let id = session["session_id"] as? String else { return nil }
+            let project = sessionProject(session)
+            let row = item(.session, key: key, title: OmniSessionText.title(session["title"] as? String),
+                           detail: detail ?? OmniSessionText.detail(session, project: project.name), route: .session(id),
+                           color: OmniSessionText.isLive(session) ? OmniTheme.running : nil, pulses: false)
+            row.icon = .symbol(OmniSessionText.providerSymbol(session["provider"] as? String))
+            row.accent = project.color
+            row.children = []
+            return row
+        }
+        var seen = Set<String>()
+        searchSessionsSection.children = sessions.compactMap { session in
+            guard let id = session["session_id"] as? String, !seen.contains(id) else { return nil }
+            let haystack = ((session["title"] as? String ?? "") + " " + (session["workspace"] as? String ?? "")).lowercased()
+            guard haystack.contains(query) else { return nil }
+            seen.insert(id)
+            return sessionRow(session, key: "search|\(id)")
+        }
+        var matched = Set<String>()
+        matchesSection.children = sessionMatches.compactMap { match in
+            guard let id = match["session_id"] as? String, matched.insert(id).inserted else { return nil }
+            let known = sessions.first { $0["session_id"] as? String == id } ?? match
+            let snippet = OmniSessionText.title(match["snippet"] as? String ?? match["text"] as? String)
+            let row = sessionRow(known, key: "match|\(id)", detail: snippet)
+            row?.matchMessageID = match["message_id"] as? String
+            return row
+        }
+        memoriesSection.children = memoryMatches.compactMap { result in
+            guard let memory = OmniMemoryItem(result) else { return nil }
+            let row = item(.memoryResult, key: memory.id, title: OmniSessionText.title(memory.title),
+                           detail: memory.memoryType, route: .memory)
+            row.memoryID = memory.id
+            row.children = []
+            return row
+        }
+        inboxItem.count = inboxUnread > 0 ? "\(inboxUnread)" : ""
+        inboxItem.countNeedsAttention = inboxUnread > 0 && inboxAttention > 0
+        let sections = [forgeProjectsSection, searchSessionsSection, matchesSection, agentsSection, runsSection,
+                        terminalsSection, memoriesSection].filter { !$0.children.isEmpty }
+        var items = sharedItems + sections
+        if sections.isEmpty {
+            items.append(searchEmptyItem)
+        }
+        searchAllItem.route = .search(sessionQuery)
+        items.append(searchAllItem)
+        applyUpdate(items: items, structure: "search;" + items.map(Self.structure).joined(separator: ";"))
+        followCurrentTab(tabs: built.tabs, dashboardTabIDs: built.dashboardTabIDs, backgroundAgents: built.background)
+        layoutContent()
+        syncSelection()
+    }
+
+    private func searchMemories() {
+        memorySearchGeneration += 1
+        let generation = memorySearchGeneration
+        guard sessionQuery.count >= 2 else { return }
+        OmniSchedulerClient.request(["op": "search_memories", "query": sessionQuery, "mode": "lexical",
+                                     "limit": 20]) { [weak self] response in
+            guard let self, generation == self.memorySearchGeneration, response["ok"] as? Bool == true else { return }
+            self.memoryMatches = response["memories"] as? [[AnyHashable: Any]] ?? []
+            self.rebuild()
+        }
+    }
+
+    private var collapsedProjectFolders: Set<String> {
+        get {
+            let value = CFPreferencesCopyAppValue(Self.collapsedProjectFoldersKey, Self.preferencesDomain)
+            return Set(value as? [String] ?? [])
+        }
+        set {
+            CFPreferencesSetAppValue(Self.collapsedProjectFoldersKey, Array(newValue).sorted() as CFArray, Self.preferencesDomain)
+            CFPreferencesAppSynchronize(Self.preferencesDomain)
+        }
+    }
+
+    // Shows the change at once and saves it; a refusal puts the old arrangement back.
+    private func saveProjectLayout(_ layout: OmniProjectLayout, problemOn key: String? = nil) {
+        let saved = projectLayout
+        projectLayout = layout
+        rebuild()
+        OmniSchedulerClient.request(["op": "set_settings", "settings": ["projects": layout.dictionary]]) { [weak self] response in
+            guard let self else { return }
+            guard response["ok"] as? Bool == true else {
+                self.projectLayout = saved
+                self.rebuild()
+                if let key, let row = self.itemCache[key] {
+                    self.showRenameProblem(Self.problem(response, fallback: "The projects could not be rearranged."), on: row)
+                }
+                return
+            }
+            if let settings = response["settings"] as? [String: Any] {
+                self.projectLayout = OmniProjectLayout(settings["projects"])
+            }
+            self.finishInteraction()
+            self.rebuild()
+            self.contentHost.pane?.reload()
+        }
+    }
+
+    private func renameProject(_ row: OmniSidebarItem, to newName: String) {
+        guard let root = Self.projectRoot(row) else { return }
+        if newName.unicodeScalars.count > 120 {
+            showRenameProblem("Keep project names to 120 characters.", on: row)
+            return
+        }
+        var layout = projectLayout
+        layout.rename(project: root, to: newName)
+        saveProjectLayout(layout, problemOn: row.key)
+    }
+
+    private func renameProjectFolder(_ row: OmniSidebarItem, to newName: String) {
+        let path = row.groupPath
+        let parent = OmniGroupTree.parent(of: path)
+        let siblings = projectTree.allPaths.filter { $0 != path && OmniGroupTree.parent(of: $0) == parent }
+            .map { $0.components(separatedBy: "/").last ?? $0 }
+        if let problem = OmniRenameRules.groupNameProblem(newName, siblings: siblings) {
+            showRenameProblem(problem, on: row)
+            return
+        }
+        let newPath = parent.isEmpty ? newName : "\(parent)/\(newName)"
+        var layout = projectLayout
+        let before = projectTree.displayKeys.drop { $0 != OmniGroupTree.groupKey(path) }.dropFirst()
+            .first { !$0.hasPrefix(OmniGroupTree.groupKey(path + "/")) && !(projectTree.group(path)?.children.map(\.key).contains($0) ?? false) }
+        layout.move(folder: path, to: newPath, before: before, tree: projectTree)
+        var collapsed = collapsedProjectFolders
+        if collapsed.remove(path) != nil {
+            collapsed.insert(newPath)
+            collapsedProjectFolders = collapsed
+        }
+        saveProjectLayout(layout, problemOn: "projectFolder|\(newPath)")
+    }
+
+    private func createProjectFolder(in parent: String, fromKeyboard: Bool) {
+        let siblings = projectTree.allPaths.filter { OmniGroupTree.parent(of: $0) == parent }
+            .map { $0.components(separatedBy: "/").last ?? $0 }
+        let name = OmniRenameRules.uniqueName(parent.isEmpty ? "New Folder" : "New Subfolder", siblings: siblings)
+        let path = parent.isEmpty ? name : "\(parent)/\(name)"
+        var layout = projectLayout
+        layout.add(folder: path, tree: projectTree)
+        pendingEditKey = "projectFolder|\(path)"
+        pendingEditFromKeyboard = fromKeyboard
+        if !parent.isEmpty {
+            var collapsed = collapsedProjectFolders
+            collapsed.remove(parent)
+            collapsedProjectFolders = collapsed
+        }
+        saveProjectLayout(layout)
+    }
