+// A bordered box with a header bar, as a repository host shows a folder or
+// a file: the header holds a breadcrumb or a file's name, the body rows or
+// the file itself.
+final class OmniExplorerBox: NSView {
+    static let headerHeight: CGFloat = 40
+    static let cornerRadius: CGFloat = 8
+    private let header: NSView
+    private let body: NSView
+    private let bodyHeight: (CGFloat) -> CGFloat
+    private let bodyInset: CGFloat
+
+    override var isFlipped: Bool { true }
+
+    init(header: NSView, body: NSView, bodyInset: CGFloat = 0, bodyHeight: @escaping (CGFloat) -> CGFloat) {
+        self.header = header
+        self.body = body
+        self.bodyHeight = bodyHeight
+        self.bodyInset = bodyInset
+        super.init(frame: NSRect(x: 0, y: 0, width: 400, height: 100))
+        wantsLayer = true
+        layer?.cornerRadius = Self.cornerRadius
+        layer?.masksToBounds = true
+        addSubview(header)
+        addSubview(body)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    func height(forWidth width: CGFloat) -> CGFloat {
+        return Self.headerHeight + bodyHeight(width - 2 * bodyInset) + 2 * bodyInset
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        header.frame = NSRect(x: 12, y: 0, width: max(0, bounds.width - 24), height: Self.headerHeight)
+        body.frame = NSRect(x: bodyInset, y: Self.headerHeight + bodyInset, width: max(0, bounds.width - 2 * bodyInset),
+                            height: max(0, bounds.height - Self.headerHeight - 2 * bodyInset))
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        OmniTheme.cardFill.setFill()
+        NSRect(x: 0, y: 0, width: bounds.width, height: Self.headerHeight).fill()
+        OmniTheme.titlebarSeparator.setFill()
+        NSRect(x: 0, y: Self.headerHeight - 1, width: bounds.width, height: 1).fill()
+        let border = NSBezierPath(roundedRect: bounds.insetBy(dx: 0.5, dy: 0.5), xRadius: Self.cornerRadius - 0.5,
+                                  yRadius: Self.cornerRadius - 0.5)
+        border.lineWidth = 1
+        OmniTheme.cardBorder.setStroke()
+        border.stroke()
+    }
+}
