+    // MARK: - Window frame
+
+    private weak var observedWindow: NSWindow?
+
+    // A resize the person makes is the window's size; a move keeps that size
+    // and takes the new place. A resize made in code (iTerm2 fitting the
+    // window to its tabs) is not saved, so the next show undoes it.
+    private func observeWindowFrame() {
+        guard let window = view.window, window !== observedWindow else { return }
+        let center = NotificationCenter.default
+        if let observedWindow {
+            center.removeObserver(self, name: NSWindow.didEndLiveResizeNotification, object: observedWindow)
+            center.removeObserver(self, name: NSWindow.didMoveNotification, object: observedWindow)
+            center.removeObserver(self, name: NSWindow.didResizeNotification, object: observedWindow)
+            center.removeObserver(self, name: NSWindow.didChangeOcclusionStateNotification, object: observedWindow)
+        }
+        observedWindow = window
+        center.addObserver(self, selector: #selector(windowDidEndLiveResize(_:)),
+                           name: NSWindow.didEndLiveResizeNotification, object: window)
+        center.addObserver(self, selector: #selector(windowDidMove(_:)), name: NSWindow.didMoveNotification, object: window)
+        center.addObserver(self, selector: #selector(windowFrameDidChange(_:)),
+                           name: NSWindow.didResizeNotification, object: window)
+        center.addObserver(self, selector: #selector(windowOcclusionDidChange(_:)),
+                           name: NSWindow.didChangeOcclusionStateNotification, object: window)
+    }
+
+    // Tests stand in for the window server.
+    static var windowIsOnScreen: (NSWindow) -> Bool = { $0.occlusionState.contains(.visible) }
+
+    // Whether the person has shown the window in this process (the hotkey,
+    // the menu bar, the Dock) or resized it. Until then its frame is iTerm2's
+    // (the startup arrangement, a fit to its tabs), never theirs: a window
+    // that only flashed on screen while launching does not count.
+    private(set) var windowShownSinceLaunch = false
+    // The stored frame is applied once, on first show, whatever showed it.
+    private var appliedStoredWindowFrame = false
+
+    // Hiding (Command-W, Command-Q, the hotkey) posts this from inside
+    // orderOut, while the window still has the frame the person last saw;
+    // anything iTerm2 does to it while hidden comes later and is not saved.
+    @objc private func windowOcclusionDidChange(_ notification: Notification) {
+        guard let window = notification.object as? NSWindow else { return }
+        if Self.windowIsOnScreen(window) {
+            if !appliedStoredWindowFrame {
+                restoreWindowFrame(on: window.screen, centered: false)
+            }
+            return
+        }
+        // Covered by another window is not hidden.
+        guard windowShownSinceLaunch, !window.isVisible else { return }
+        storeWindowPlace(window.frame, reason: "hide")
+    }
+
+    // The hotkey, the menu bar or the Dock is showing the window.
+    @objc func noteWindowShownByPerson() {
+        windowShownSinceLaunch = true
+        frameSettlesUntil = Date().addingTimeInterval(2)
+    }
+
+    // On quit: where a window still on screen is. A hidden one's was saved
+    // when it hid.
+    @objc func saveWindowFrame() {
+        noteWindowSpace()
+        guard let window = view.window, windowShownSinceLaunch, window.isVisible else { return }
+        storeWindowPlace(window.frame, reason: "quit")
+    }
+
+    // Hiding, moving and quitting keep the person's size and take the
+    // window's place. The size changes only when they resize the window;
+    // before they ever have, the window's frame is taken whole.
+    private func storeWindowPlace(_ frame: NSRect, reason: String) {
+        let size = panelLayout.layout.windowFrame?.size ?? frame.size
+        storeWindowFrame(NSRect(origin: frame.origin, size: size), reason: reason)
+    }
+
+    private func storeWindowFrame(_ frame: NSRect, reason: String) {
+        guard frame.width >= OmniPanelLayout.windowMinSize.width, frame.height >= OmniPanelLayout.windowMinSize.height else {
+            return
+        }
+        omniWindowFrameLog.notice("save \(reason, privacy: .public) \(NSStringFromRect(frame), privacy: .public)")
+        panelLayout.update { $0.windowFrame = frame }
+    }
+
+    // Whether the window has a frame of the person's to come back to.
+    @objc var hasStoredWindowFrame: Bool {
+        return panelLayout.layout.windowFrame != nil
+    }
+
+    @objc private func windowDidEndLiveResize(_ notification: Notification) {
+        guard let window = notification.object as? NSWindow else { return }
+        windowShownSinceLaunch = true
+        storeWindowFrame(window.frame, reason: "resize")
+    }
+
+    // Just after the person shows the window, iTerm2 and macOS may still
+    // move or reshape it (initial placement, tiling, a Space change). Until
+    // then, a change the person is not making is undone, not saved.
+    private var frameSettlesUntil = Date.distantPast
+    private var frameRestorePending = false
+
+    private var windowFrameIsSettling: Bool {
+        guard let window = view.window, Date() < frameSettlesUntil, window.isVisible,
+              !window.styleMask.contains(.fullScreen), !window.inLiveResize else { return false }
+        return NSEvent.pressedMouseButtons == 0
+    }
+
+    @objc private func windowFrameDidChange(_ notification: Notification) {
+        guard windowFrameIsSettling, !frameRestorePending, let window = view.window,
+              let stored = panelLayout.layout.windowFrame, window.frame != stored else { return }
+        frameRestorePending = true
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.frameRestorePending = false
+            guard self.windowFrameIsSettling, let window = self.view.window else { return }
+            omniWindowFrameLog.notice("frame changed to \(NSStringFromRect(window.frame), privacy: .public) while opening; restoring")
+            self.restoreWindowFrame(on: nil, centered: false)
+        }
+    }
+
+    @objc private func windowDidMove(_ notification: Notification) {
+        if windowFrameIsSettling {
+            windowFrameDidChange(notification)
+            return
+        }
+        guard let window = notification.object as? NSWindow, window.isVisible, windowShownSinceLaunch,
+              let stored = panelLayout.layout.windowFrame, stored.origin != window.frame.origin else { return }
+        panelLayout.update(saving: false) { $0.windowFrame = NSRect(origin: window.frame.origin, size: stored.size) }
+        panelLayout.saveSoon()
+    }
+
+    // Before the window shows: the place and size the person gave it, on
+    // `screen` or, without one, on the screen it was on. False when there is
+    // none yet, so the window keeps iTerm2's.
+    @objc(restoreWindowFrameOnScreen:centered:)
+    @discardableResult
+    func restoreWindowFrame(on screen: NSScreen?, centered: Bool) -> Bool {
+        guard let window = view.window, let stored = panelLayout.layout.windowFrame,
+              let visible = (screen ?? Self.screen(holding: stored) ?? window.screen ?? NSScreen.main)?.visibleFrame
+        else { return false }
+        appliedStoredWindowFrame = true
+        // Exactly where it was left, pinned or not; moved onto a screen only
+        // when the one it was on has gone.
+        let frame: NSRect
+        if screen == nil, let home = Self.screen(holding: stored), home.frame.contains(stored) {
+            frame = stored
+        } else {
+            frame = OmniPanelLayout.restoredWindowFrame(stored, in: visible, centered: centered)
+        }
+        omniWindowFrameLog.notice("apply \(NSStringFromRect(frame), privacy: .public) from \(NSStringFromRect(stored), privacy: .public) was \(NSStringFromRect(window.frame), privacy: .public)")
+        if window.frame != frame {
+            window.setFrame(frame, display: window.isVisible)
+        }
+        return true
+    }
