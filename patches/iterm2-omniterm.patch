+    private func updateMemory(_ arguments: [String: Any]) {
+        guard let id = selectedMemoryID else { return }
+        OmniSchedulerClient.request(["op": "update_memory", "id": id].merging(arguments) { $1 }) { [weak self] response in
+            guard let self else { return }
+            if !OmniPane.isOK(response) {
+                self.detailButtons.status.stringValue = response["error"] as? String ?? "The change was not saved."
+            }
+            self.memories = []
+            self.loadMemories()
+            self.selectMemory(id)
+        }
+    }
