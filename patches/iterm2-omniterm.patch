@@ -0,0 +1,325 @@
+import AppKit
+import Foundation
+
+// A read-only view of a run's last terminal screen, as saved by the scheduler
+// (`run_screen`). The text is untrusted: SGR colour and style sequences are
+// rendered, every other escape sequence and control character is dropped, and
+// nothing is ever interpreted as a link or a command.
+@objc(OmniTerminalSnapshotView)
+final class OmniTerminalSnapshotView: NSScrollView {
+    static let snapshotBackground = NSColor(srgbRed: 0.08, green: 0.08, blue: 0.08, alpha: 1)
+    static let defaultForeground = NSColor(srgbRed: 0.86, green: 0.86, blue: 0.86, alpha: 1)
+
+    private static let font = NSFont.monospacedSystemFont(ofSize: 12, weight: .regular)
+
+    // TextKit 1 from the start: height() reads layoutManager, and switching a
+    // TextKit 2 view over leaves its TextKit 2 objects and subviews behind.
+    private let textView = NSTextView(usingTextLayoutManager: false)
+    private var shownScreen: String?
+
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        hasVerticalScroller = true
+        hasHorizontalScroller = false
+        autohidesScrollers = true
+        borderType = .noBorder
+        drawsBackground = true
+        backgroundColor = Self.snapshotBackground
+        textView.isEditable = false
+        textView.isSelectable = true
+        textView.isRichText = false
+        textView.importsGraphics = false
+        textView.isAutomaticLinkDetectionEnabled = false
+        textView.isAutomaticDataDetectionEnabled = false
+        textView.drawsBackground = true
+        textView.backgroundColor = Self.snapshotBackground
+        textView.textContainerInset = NSSize(width: 14, height: 12)
+        // Lines wrap to the view's width, so nothing is ever off to the side.
+        textView.frame = NSRect(origin: .zero, size: contentSize)
+        textView.minSize = NSSize(width: 0, height: contentSize.height)
+        textView.maxSize = NSSize(width: CGFloat.greatestFiniteMagnitude, height: CGFloat.greatestFiniteMagnitude)
+        textView.isVerticallyResizable = true
+        textView.isHorizontallyResizable = false
+        textView.autoresizingMask = [.width]
+        textView.textContainer?.widthTracksTextView = true
+        textView.textContainer?.containerSize = NSSize(width: contentSize.width, height: CGFloat.greatestFiniteMagnitude)
+        documentView = textView
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    // Shows the screen and scrolls to its end, where the run left off, at the
+    // start of the line. Showing the same screen again keeps the scroll position.
+    @objc func show(screen: String) {
+        guard screen != shownScreen else { return }
+        shownScreen = screen
+        let rendered = NSMutableAttributedString(attributedString: Self.render(screen, font: Self.font))
+        rendered.addAttribute(.paragraphStyle,
+                              value: Self.paragraphStyle,
+                              range: NSRange(location: 0, length: rendered.length))
+        textView.textStorage?.setAttributedString(rendered)
+        scrollToBottomLeft()
+    }
+
+    func scrollToBottomLeft() {
+        if let layoutManager = textView.layoutManager, let container = textView.textContainer {
+            layoutManager.ensureLayout(for: container)
+        }
+        textView.sizeToFit()
+        let visibleHeight = contentView.bounds.height
+        contentView.scroll(to: NSPoint(x: 0, y: max(0, textView.frame.height - visibleHeight)))
+        reflectScrolledClipView(contentView)
+    }
+
+    // Wrapped continuations are indented by two cells so each terminal line
+    // still reads as one.
+    private static let paragraphStyle: NSParagraphStyle = {
+        let style = NSMutableParagraphStyle()
+        let cell = ("M" as NSString).size(withAttributes: [.font: font]).width
+        style.lineBreakMode = .byCharWrapping
+        style.firstLineHeadIndent = 0
+        style.headIndent = cell * 2
+        style.lineHeightMultiple = 1.12
+        return style
+    }()
+
+    // MARK: - Rendering
+
+    private struct Style: Equatable {
+        var foreground: NSColor?
+        var background: NSColor?
+        var bold = false
+        var faint = false
+        var italic = false
+        var underline = false
+        var inverse = false
+    }
+
+    static func render(_ text: String, font: NSFont) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        var style = Style()
+        var buffer = String.UnicodeScalarView()
+
+        func flush() {
+            guard !buffer.isEmpty else { return }
+            result.append(NSAttributedString(string: String(buffer), attributes: attributes(for: style, font: font)))
+            buffer.removeAll()
+        }
+
+        let scalars = Array(text.unicodeScalars)
+        var index = 0
+        while index < scalars.count {
+            let scalar = scalars[index]
+            switch scalar.value {
+            case 0x1B:
+                let (parameters, end) = Self.skipEscape(scalars, from: index)
+                if let parameters {
+                    flush()
+                    style = Self.apply(parameters, to: style)
+                }
+                index = end
+                continue
+            case 0x0A, 0x09:
+                buffer.append(scalar)
+            case 0x00..<0x20, 0x7F, 0x80..<0xA0:
+                break
+            default:
+                buffer.append(scalar)
+            }
+            index += 1
+        }
+        flush()
+        return result
+    }
+
+    // Skips the escape sequence starting at `start`. Returns the parameters of
+    // an SGR sequence (CSI … m), nil for anything else, and the index after it.
+    private static func skipEscape(_ scalars: [Unicode.Scalar], from start: Int) -> (String?, Int) {
+        var index = start + 1
+        guard index < scalars.count else { return (nil, index) }
+        let introducer = scalars[index].value
+        index += 1
+        switch introducer {
+        case 0x5B: // CSI
+            var parameters = String.UnicodeScalarView()
+            var hasIntermediates = false
+            while index < scalars.count {
+                let value = scalars[index].value
+                index += 1
+                switch value {
+                case 0x30...0x3F:
+                    parameters.append(scalars[index - 1])
+                case 0x20...0x2F:
+                    hasIntermediates = true
+                case 0x40...0x7E:
+                    let parameterString = String(parameters)
+                    let isSGR = value == 0x6D && !hasIntermediates &&
+                        parameterString.unicodeScalars.allSatisfy { ("0"..."9").contains($0) || $0 == ";" || $0 == ":" }
+                    return (isSGR ? parameterString : nil, index)
+                default:
+                    // Malformed: stop here and keep the rest as text.
+                    return (nil, index - 1)
+                }
+            }
+            return (nil, index)
+        case 0x5D, 0x50, 0x58, 0x5E, 0x5F: // OSC, DCS, SOS, PM, APC: skip to the terminator.
+            while index < scalars.count {
+                let value = scalars[index].value
+                if value == 0x07 {
+                    return (nil, index + 1)
+                }
+                if value == 0x1B, index + 1 < scalars.count, scalars[index + 1] == "\\" {
+                    return (nil, index + 2)
+                }
+                index += 1
+            }
+            return (nil, index)
+        case 0x20...0x2F: // nF sequences: intermediates, then a final byte.
+            while index < scalars.count, (0x20...0x2F).contains(scalars[index].value) {
+                index += 1
+            }
+            return (nil, min(index + 1, scalars.count))
+        default:
+            return (nil, index)
+        }
+    }
+
+    private static func apply(_ parameters: String, to current: Style) -> Style {
+        var style = current
+        let groups = parameters.isEmpty ? ["0"] : parameters.split(separator: ";", omittingEmptySubsequences: false).map(String.init)
+        var index = 0
+        func number(_ string: String) -> Int {
+            return Int(string) ?? 0
+        }
+        while index < groups.count {
+            let group = groups[index]
+            // Colon form: 38:5:n or 38:2:[colourspace:]r:g:b in a single group.
+            if group.contains(":") {
+                let parts = group.split(separator: ":", omittingEmptySubsequences: false).map { number(String($0)) }
+                if let code = parts.first, code == 38 || code == 48, parts.count >= 3 {
+                    var color: NSColor?
+                    if parts[1] == 5 {
+                        color = paletteColor(parts[2])
+                    } else if parts[1] == 2 {
+                        let rgb = Array(parts.suffix(3))
+                        if rgb.count == 3 {
+                            color = rgbColor(rgb[0], rgb[1], rgb[2])
+                        }
+                    }
+                    if code == 38 { style.foreground = color } else { style.background = color }
+                } else if parts.first == 4 {
+                    style.underline = parts.count < 2 || parts[1] != 0
+                }
+                index += 1
+                continue
+            }
+            let code = number(group)
+            switch code {
+            case 0:
+                style = Style()
+            case 1:
+                style.bold = true
+            case 2:
+                style.faint = true
+            case 3:
+                style.italic = true
+            case 4:
+                style.underline = true
+            case 7:
+                style.inverse = true
+            case 22:
+                style.bold = false
+                style.faint = false
+            case 23:
+                style.italic = false
+            case 24:
+                style.underline = false
+            case 27:
+                style.inverse = false
+            case 30...37:
+                style.foreground = paletteColor(code - 30)
+            case 39:
+                style.foreground = nil
+            case 40...47:
+                style.background = paletteColor(code - 40)
+            case 49:
+                style.background = nil
+            case 90...97:
+                style.foreground = paletteColor(code - 90 + 8)
+            case 100...107:
+                style.background = paletteColor(code - 100 + 8)
+            case 38, 48:
+                var color: NSColor?
+                if index + 2 < groups.count, number(groups[index + 1]) == 5 {
+                    color = paletteColor(number(groups[index + 2]))
+                    index += 2
+                } else if index + 4 < groups.count, number(groups[index + 1]) == 2 {
+                    color = rgbColor(number(groups[index + 2]), number(groups[index + 3]), number(groups[index + 4]))
+                    index += 4
+                }
+                if code == 38 { style.foreground = color } else { style.background = color }
+            default:
+                break
+            }
+            index += 1
+        }
+        return style
+    }
+
+    private static let basicPalette: [NSColor] = [
+        (0x00, 0x00, 0x00), (0xCD, 0x31, 0x31), (0x0D, 0xBC, 0x79), (0xE5, 0xE5, 0x10),
+        (0x44, 0x8C, 0xFF), (0xBC, 0x3F, 0xBC), (0x11, 0xA8, 0xCD), (0xE5, 0xE5, 0xE5),
+        (0x76, 0x76, 0x76), (0xF1, 0x4C, 0x4C), (0x23, 0xD1, 0x8B), (0xF5, 0xF5, 0x43),
+        (0x6B, 0xA4, 0xFF), (0xD6, 0x70, 0xD6), (0x29, 0xB8, 0xDB), (0xFF, 0xFF, 0xFF),
+    ].map { rgbColor($0.0, $0.1, $0.2) }
+
+    static func paletteColor(_ index: Int) -> NSColor? {
+        switch index {
+        case 0..<16:
+            return basicPalette[index]
+        case 16..<232:
+            let cube = index - 16
+            let steps = [0, 95, 135, 175, 215, 255]
+            return rgbColor(steps[cube / 36], steps[(cube / 6) % 6], steps[cube % 6])
+        case 232..<256:
+            let gray = 8 + (index - 232) * 10
+            return rgbColor(gray, gray, gray)
+        default:
+            return nil
+        }
+    }
+
+    private static func rgbColor(_ red: Int, _ green: Int, _ blue: Int) -> NSColor {
+        func component(_ value: Int) -> CGFloat {
+            return CGFloat(max(0, min(255, value))) / 255
+        }
+        return NSColor(srgbRed: component(red), green: component(green), blue: component(blue), alpha: 1)
+    }
+
+    private static func attributes(for style: Style, font: NSFont) -> [NSAttributedString.Key: Any] {
+        var foreground = style.foreground ?? defaultForeground
+        var background = style.background
+        if style.inverse {
+            let swapped = background ?? snapshotBackground
+            background = foreground
+            foreground = swapped
+        }
+        if style.faint {
+            foreground = foreground.withAlphaComponent(0.6)
+        }
+        var resolvedFont = style.bold ? NSFont.monospacedSystemFont(ofSize: font.pointSize, weight: .bold) : font
+        if style.italic {
+            resolvedFont = NSFontManager.shared.convert(resolvedFont, toHaveTrait: .italicFontMask)
+        }
+        var attributes: [NSAttributedString.Key: Any] = [.font: resolvedFont, .foregroundColor: foreground]
+        if let background {
+            attributes[.backgroundColor] = background
+        }
+        if style.underline {
+            attributes[.underlineStyle] = NSUnderlineStyle.single.rawValue
+        }
+        return attributes
+    }
+}
diff --git a/sources/OmniTerm/OmniTheme.swift b/sources/OmniTerm/OmniTheme.swift
new file mode 100644
index 0000000000000000000000000000000000000000..26a3332896562327fbb0856e79a7e79bea24b304
--- /dev/null
+++ b/sources/OmniTerm/OmniTheme.swift
@@ -0,0 +1,329 @@
+//
+//  OmniTheme.swift
+//  iTerm2SharedARC
+//
+//  OmniTerm's look, shared by the main window and the Inbox: a vibrant
+//  source-list sidebar beside content panes, one type scale, status chips,
+//  list rows with an accent bar, and the peach of the window's chrome.
+//
+
+import AppKit
+
+enum OmniTheme {
+    // MARK: - Colours
+
+    // The peach of the terminal window's border and chrome.
+    static let accent = NSColor(srgbRed: 247.0 / 255.0, green: 177.0 / 255.0, blue: 133.0 / 255.0, alpha: 1)
+    // Text on the accent is charcoal, never white, so it stays legible in
+    // light and dark mode.
+    static let onAccent = NSColor(srgbRed: 0.13, green: 0.13, blue: 0.14, alpha: 1)
+
+    static let contentBackground: NSColor = .textBackgroundColor
+    static let barBackground: NSColor = .windowBackgroundColor
+    // Under captured output such as a diff.
+    static let wellBackground: NSColor = .underPageBackgroundColor
+    // The hairline between a window's title bar and its content, across
+    // the sidebar and the page alike.
+    static let titlebarSeparator: NSColor = .separatorColor
+    static let secondaryText: NSColor = .secondaryLabelColor
+    static let tertiaryText: NSColor = .tertiaryLabelColor
+    // Cards: Markdown, file boxes and their header bars sit a shade lighter
+    // than the page, with a hairline border.
+    static let cardFill = NSColor(name: nil) { appearance in
+        appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua
+            ? NSColor.white.withAlphaComponent(0.045)
+            : NSColor.black.withAlphaComponent(0.025)
+    }
+    // Folders in file listings, as a repository host tints them.
+    static let folderTint = NSColor.systemBlue.withAlphaComponent(0.75)
+    static let cardBorder = NSColor(name: nil) { appearance in
+        appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua
+            ? NSColor.white.withAlphaComponent(0.12)
+            : NSColor.black.withAlphaComponent(0.12)
+    }
+
+    // MARK: - Status
+
+    // Green done, blue working, orange waiting for the person, red only for
+    // things that actually went wrong, grey for everything that just ended.
+    static let completed: NSColor = .systemGreen
+    static let failed: NSColor = .systemRed
+    static let ended: NSColor = .systemGray
+    static let running: NSColor = .systemBlue
+    static let waiting: NSColor = .systemOrange
+
+    // A trailing status dot is muted: the subline already says the state in words.
+    static func mutedStatus(_ color: NSColor) -> NSColor {
+        return color.withAlphaComponent(0.7)
+    }
+
+    // MARK: - Memory
+
+    // One colour per hippocampus memory type, and for the mind map's root,
+    // type, tag and topic nodes and workspace and concept hubs.
+    static func memoryTypeColor(_ type: String) -> NSColor {
+        switch type {
+        case "declarative": return .systemBlue
+        case "episodic": return .systemPurple
+        case "procedural": return .systemGreen
+        case "prospective": return .systemOrange
+        case "autobiographical": return .systemPink
+        case "spatial": return .systemTeal
+        case "conditioning": return .systemYellow
+        case "root": return accent
+        case "workspace": return .systemBrown
+        case "concept": return .systemCyan
+        case "topics", "topic": return .systemIndigo
+        default: return .systemGray
+        }
+    }
+
+    // Graph links by why they connect two memories.
+    static func memoryEdgeColor(_ kind: String) -> NSColor {
+        switch kind {
+        case "session": return .systemBlue
+        case "tag": return .systemGreen
+        case "lineage": return .systemOrange
+        case "similarity": return .systemPurple
+        case "workspace": return .systemBrown
+        case "concept": return .systemCyan
+        default: return .tertiaryLabelColor
+        }
+    }
+
+    // MARK: - Type scale
+
+    enum Font {
+        static let title = NSFont.systemFont(ofSize: 22, weight: .semibold)
+        static let subtitle = NSFont.systemFont(ofSize: 17, weight: .semibold)
+        // Section headers are set in capitals; see sectionHeader(_:).
+        static let sectionHeader = NSFont.systemFont(ofSize: 11, weight: .semibold)
+        static let body = NSFont.systemFont(ofSize: 13.5)
+        static let meta = NSFont.systemFont(ofSize: 12)
+        static let rowTitle = NSFont.systemFont(ofSize: 13)
+        static let rowTitleEmphasized = NSFont.systemFont(ofSize: 13, weight: .semibold)
+        static let rowDetail = NSFont.systemFont(ofSize: 11)
+        static let chip = NSFont.systemFont(ofSize: 10, weight: .bold)
+        static let mono = NSFont.monospacedSystemFont(ofSize: 11.5, weight: .regular)
+        static let placeholder = NSFont.systemFont(ofSize: 14)
+        // Label/value facts and a band's explanation.
+        static let fact = NSFont.systemFont(ofSize: 12.5)
+        // Big numbers on the Overview.
+        static let stat = NSFont.monospacedDigitSystemFont(ofSize: 26, weight: .semibold)
+        // The terminal band's message when there is no terminal.
+        static let bandTitle = NSFont.systemFont(ofSize: 15, weight: .semibold)
+        // The sidebar's title when a card is expanded to a strip.
+        static let stripTitle = NSFont.systemFont(ofSize: 13, weight: .semibold)
+
+        static func emoji(_ size: CGFloat) -> NSFont {
+            return NSFont.systemFont(ofSize: size)
+        }
+    }
+
+    // MARK: - Spacing
+
+    enum Metrics {
+        static let pageInset: CGFloat = 28
+        static let pageTop: CGFloat = 22
+        static let sectionGap: CGFloat = 14
+        static let barHeight: CGFloat = 44
+        static let buttonHeight: CGFloat = 28
+        static let buttonGap: CGFloat = 6
+        static let rowHeight: CGFloat = 38
+        static let rowIconSize: CGFloat = 16
+        static let statusDot: CGFloat = 6
+        static let accentBarWidth: CGFloat = 3
+        static let cornerRadius: CGFloat = 6
+        static let sidebarWidth: CGFloat = 240
+    }
+
+    // MARK: - Sidebar
+
+    // The source list's rows, as in Mail and Finder: Dashboard and Inbox are
+    // ordinary rows set apart only by a rule under them.
+    enum Sidebar {
+        // Dashboard and Inbox: one line, an icon and a title.
+        static let topRowHeight: CGFloat = 30
+        static let topTitleFont = NSFont.systemFont(ofSize: 13, weight: .medium)
+        static let topTitleColor: NSColor = .labelColor
+        static let topIcon = NSImage.SymbolConfiguration(pointSize: 15, weight: .medium)
+        static let iconSlot: CGFloat = 20
+        static let iconTint: NSColor = .secondaryLabelColor
+        static let selectedIconTint: NSColor = .alternateSelectedControlTextColor
+
+        // The rounded fill under the pointer, on every row, inset like the
+        // selection.
+        static let hover = NSColor.labelColor.withAlphaComponent(0.06)
+        static let rowInsetX: CGFloat = 10
+        static let rowCornerRadius: CGFloat = 5
+
+        // The top group sits on a slightly lighter rounded panel.
+        static let panelInsetX: CGFloat = 6
+        static let panelCornerRadius: CGFloat = 8
+        static let panelFill = NSColor(name: nil) { appearance in
+            appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua
+                ? NSColor.white.withAlphaComponent(0.06)
+                : NSColor.white.withAlphaComponent(0.55)
+        }
+
+        // The gap and rule between the top group and Agents.
+        static let groupGap: CGFloat = 10
+        static let groupRuleInset: CGFloat = 12
+
+        // The Inbox's unread count, as a capsule at the row's trailing edge.
+        enum Badge {
+            static let font = NSFont.monospacedDigitSystemFont(ofSize: 11, weight: .semibold)
+            static let horizontalPadding: CGFloat = 5
+            static let height: CGFloat = 16
+            static let fill: NSColor = .quaternaryLabelColor
+            static let text: NSColor = .secondaryLabelColor
+            // Something needs the person.
+            static let attentionFill: NSColor = OmniTheme.waiting
+            static let attentionText: NSColor = .white
+            // On the selected row.
+            static let selectedFill = NSColor.white.withAlphaComponent(0.25)
+            static let selectedText: NSColor = .white
+        }
+    }
+
+    // MARK: - Factories
+
+    static func sectionHeader(_ title: String) -> NSTextField {
+        let label = NSTextField(labelWithString: title.uppercased())
+        label.font = Font.sectionHeader
+        label.textColor = secondaryText
+        label.lineBreakMode = .byTruncatingTail
+        return label
+    }
+
+    static func title(_ text: String = "") -> NSTextField {
+        let field = NSTextField(wrappingLabelWithString: text)
+        field.font = Font.title
+        field.maximumNumberOfLines = 2
+        field.lineBreakMode = .byTruncatingTail
+        field.isSelectable = true
+        return field
+    }
+
+    static func meta(_ text: String = "") -> NSTextField {
+        let field = NSTextField(labelWithString: text)
+        field.font = Font.meta
+        field.textColor = secondaryText
+        field.lineBreakMode = .byTruncatingMiddle
+        field.isSelectable = true
+        return field
+    }
+
+    static func chip(_ text: String, color: NSColor) -> OmniBadgeView {
+        let chip = OmniBadgeView()
+        chip.configure(text: text, color: color)
+        return chip
+    }
+
+    static func button(_ title: String, target: AnyObject?, action: Selector?) -> NSButton {
+        let button = NSButton(title: title, target: target, action: action)
+        button.bezelStyle = .rounded
+        button.controlSize = .regular
+        return button
+    }
+
+    // The source-list material Mail and Notes use for their sidebars.
+    static func configureSidebar(_ view: NSVisualEffectView) {
+        view.material = .sidebar
+        view.blendingMode = .behindWindow
+        view.state = .followsWindowActiveState
+    }
+
+    // A pane beside the sidebar.
+    static func card() -> OmniResizingView {
+        let view = OmniResizingView()
+        view.fillColor = contentBackground
+        return view
+    }
+
+    // A 1 pt line in the title-bar separator colour, which follows the
+    // appearance.
+    static func titlebarSeparatorLine() -> NSBox {
+        let line = NSBox()
+        line.boxType = .custom
+        line.borderWidth = 0
+        line.fillColor = titlebarSeparator
+        line.contentViewMargins = .zero
+        return line
+    }
+
+    // A standard title bar draws the same hairline itself.
+    static func applyTitlebarSeparator(to window: NSWindow) {
+        window.titlebarSeparatorStyle = .line
+    }
+
+    // A bar of controls above content, with a hairline below it.
+    static func bar() -> OmniResizingView {
+        let view = OmniResizingView()
+        view.fillColor = barBackground
+        view.drawsBottomSeparator = true
+        return view
+    }
+}
+
+// A small rounded label such as COMPLETED or URGENT. The words carry the
+// meaning; the colour only reinforces it.
+final class OmniBadgeView: NSView {
+    private var text = ""
+    private var color = NSColor.tertiaryLabelColor
+
+    private var attributes: [NSAttributedString.Key: Any] {
+        return [.font: OmniTheme.Font.chip, .foregroundColor: color]
+    }
+
+    func configure(text: String, color: NSColor) {
+        self.text = text.uppercased()
+        self.color = color
+        sizeToFitLabel()
+        needsDisplay = true
+    }
+
+    func sizeToFitLabel() {
+        let size = (text as NSString).size(withAttributes: attributes)
+        setFrameSize(NSSize(width: ceil(size.width) + 14, height: 18))
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        let path = NSBezierPath(roundedRect: bounds.insetBy(dx: 0.5, dy: 0.5), xRadius: 9, yRadius: 9)
+        color.withAlphaComponent(0.16).setFill()
+        path.fill()
+        color.withAlphaComponent(0.55).setStroke()
+        path.stroke()
+        let size = (text as NSString).size(withAttributes: attributes)
+        (text as NSString).draw(at: NSPoint(x: (bounds.width - size.width) / 2, y: (bounds.height - size.height) / 2),
+                                withAttributes: attributes)
+    }
+}
+
+// The source-list background, reporting its size like OmniResizingView.
+final class OmniSidebarBackgroundView: NSVisualEffectView {
+    var didResize: ((NSSize) -> Void)? {
+        didSet { needsLayout = true }
+    }
+
+    override var isFlipped: Bool { true }
+
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        OmniTheme.configureSidebar(self)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        didResize?(bounds.size)
+    }
+
+    override func layout() {
+        super.layout()
+        didResize?(bounds.size)
+    }
+}
diff --git a/sources/OmniTerm/OmniTickets.swift b/sources/OmniTerm/OmniTickets.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a728f25ff229d3f55ae7a0cc310f928ce8fe5f86
--- /dev/null
+++ b/sources/OmniTerm/OmniTickets.swift
@@ -0,0 +1,1285 @@
+import AppKit
+import CryptoKit
+import Foundation
+
+// MARK: - Model
+
+// A project's tickets: a small backlog and board kept by OmniTerm, one file
+// per project root, never inside the project's own folders.
+enum OmniTicketStatus: String, CaseIterable, Codable {
+    case open
+    case inProgress = "in_progress"
+    case done
+    case discarded
+
+    var label: String {
+        switch self {
+        case .open: return "Open"
+        case .inProgress: return "In Progress"
+        case .done: return "Done"
+        case .discarded: return "Discarded"
+        }
+    }
+
+    var symbol: SFSymbol {
+        switch self {
+        case .open: return .circle
+        case .inProgress: return .circleLefthalfFilled
+        case .done: return .checkmarkCircleFill
+        case .discarded: return .xmarkCircle
+        }
+    }
+
+    var color: NSColor {
+        switch self {
+        case .open: return OmniTheme.secondaryText
+        case .inProgress: return OmniTheme.waiting
+        case .done: return OmniTheme.completed
+        case .discarded: return OmniTheme.ended
+        }
+    }
+}
+
+enum OmniTicketPriority: String, CaseIterable, Codable {
+    case urgent
+    case shortTerm = "short_term"
+    case middleTerm = "middle_term"
+    case longTerm = "long_term"
+
+    var label: String {
+        switch self {
+        case .urgent: return "Urgent"
+        case .shortTerm: return "Short-term"
+        case .middleTerm: return "Middle-term"
+        case .longTerm: return "Long-term"
+        }
+    }
+
+    var symbol: SFSymbol {
+        return self == .urgent ? .exclamationmarkCircleFill : .flagFill
+    }
+
+    var color: NSColor {
+        switch self {
+        case .urgent: return OmniTheme.failed
+        case .shortTerm: return OmniTheme.waiting
+        case .middleTerm: return OmniTheme.running
+        case .longTerm: return OmniTheme.ended
+        }
+    }
+}
+
+struct OmniTicket: Codable, Equatable {
+    var id: String
+    var number: Int
+    var title: String
+    var content: String
+    var status: OmniTicketStatus
+    var priority: OmniTicketPriority
+    var created: Date
+    var updated: Date
+}
+
+enum OmniTicketGrouping: String, Codable {
+    case status
+    case priority
+}
+
+enum OmniTicketLayout: String, Codable {
+    case list
+    case board
+}
+
+// The properties a ticket row can show besides its title.
+enum OmniTicketField: String, CaseIterable, Codable {
+    case number
+    case status
+    case priority
+    case updated
+
+    var label: String {
+        switch self {
+        case .number: return "ID"
+        case .status: return "Status"
+        case .priority: return "Priority"
+        case .updated: return "Updated"
+        }
+    }
+}
+
+// How the tickets tab shows them: list or board, grouped by status or
+// priority, with the statuses and priorities shown (the backlog filter and
+// the board's columns) and the row properties.
+struct OmniTicketView: Codable, Equatable {
+    var layout = OmniTicketLayout.list
+    var grouping = OmniTicketGrouping.status
+    var statuses: [OmniTicketStatus] = [.open, .inProgress, .done]
+    var priorities: [OmniTicketPriority] = OmniTicketPriority.allCases
+    var fields: [OmniTicketField] = [.number, .priority, .updated]
+}
+
+struct OmniTicketFile: Codable, Equatable {
+    var root: String
+    var nextNumber = 1
+    var tickets: [OmniTicket] = []
+    var view = OmniTicketView()
+
+    init(root: String) {
+        self.root = root
+    }
+
+    // Older or hand-edited files may lack keys; keep what is there.
+    init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        root = try values.decodeIfPresent(String.self, forKey: .root) ?? ""
+        tickets = try values.decodeIfPresent([OmniTicket].self, forKey: .tickets) ?? []
+        nextNumber = try values.decodeIfPresent(Int.self, forKey: .nextNumber) ?? ((tickets.map(\.number).max() ?? 0) + 1)
+        view = (try? values.decodeIfPresent(OmniTicketView.self, forKey: .view)) ?? OmniTicketView()
+    }
+}
+
+// Grouping, filtering and ordering. Pure so tests can check it without a window.
+enum OmniTicketsModel {
+    struct Group: Equatable {
+        let key: String
+        let title: String
+        let tickets: [OmniTicket]
+    }
+
+    static func visible(_ tickets: [OmniTicket], view: OmniTicketView) -> [OmniTicket] {
+        return tickets.filter { view.statuses.contains($0.status) && view.priorities.contains($0.priority) }
+    }
+
+    // One group per shown status or priority, in their natural order, empty
+    // ones included so the board keeps its columns.
+    static func groups(_ tickets: [OmniTicket], view: OmniTicketView) -> [Group] {
+        let shown = visible(tickets, view: view)
+        func ordered(_ list: [OmniTicket]) -> [OmniTicket] {
+            return list.sorted { a, b in
+                let pa = OmniTicketPriority.allCases.firstIndex(of: a.priority)!
+                let pb = OmniTicketPriority.allCases.firstIndex(of: b.priority)!
+                let sa = OmniTicketStatus.allCases.firstIndex(of: a.status)!
+                let sb = OmniTicketStatus.allCases.firstIndex(of: b.status)!
+                let first = view.grouping == .status ? (pa, sa) : (sa, pa)
+                let second = view.grouping == .status ? (pb, sb) : (sb, pb)
+                if first != second {
+                    return first < second
+                }
+                return a.number > b.number
+            }
+        }
+        switch view.grouping {
+        case .status:
+            return OmniTicketStatus.allCases.filter { view.statuses.contains($0) }.map { status in
+                Group(key: status.rawValue, title: status.label, tickets: ordered(shown.filter { $0.status == status }))
+            }
+        case .priority:
+            return OmniTicketPriority.allCases.filter { view.priorities.contains($0) }.map { priority in
+                Group(key: priority.rawValue, title: priority.label, tickets: ordered(shown.filter { $0.priority == priority }))
+            }
+        }
+    }
+
+    // The group a ticket moves to `delta` columns away, or nil at an edge.
+    static func neighbour(of ticket: OmniTicket, delta: Int, view: OmniTicketView) -> String? {
+        let keys = groups([], view: view).map(\.key)
+        let current = view.grouping == .status ? ticket.status.rawValue : ticket.priority.rawValue
+        guard let index = keys.firstIndex(of: current), keys.indices.contains(index + delta) else { return nil }
+        return keys[index + delta]
+    }
+
+    static func moved(_ ticket: OmniTicket, to key: String, grouping: OmniTicketGrouping) -> OmniTicket {
+        var ticket = ticket
+        switch grouping {
+        case .status: ticket.status = OmniTicketStatus(rawValue: key) ?? ticket.status
+        case .priority: ticket.priority = OmniTicketPriority(rawValue: key) ?? ticket.priority
+        }
+        return ticket
+    }
+
+    static func updatedText(_ date: Date, now: Date = Date()) -> String {
+        let formatter = RelativeDateTimeFormatter()
+        formatter.unitsStyle = .abbreviated
+        return now.timeIntervalSince(date) < 60 ? "now" : formatter.localizedString(for: date, relativeTo: now)
+    }
+}
+
+enum OmniTicketStore {
+    static var directory: URL = {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first ??
+            URL(fileURLWithPath: NSHomeDirectory() + "/Library/Application Support")
+        return base.appendingPathComponent("OmniTerm/tickets", isDirectory: true)
+    }()
+
+    static func url(for root: String) -> URL {
+        let digest = SHA256.hash(data: Data(root.utf8)).map { String(format: "%02x", $0) }.joined()
+        return directory.appendingPathComponent(String(digest.prefix(24)) + ".json")
+    }
+
+    static func load(root: String) -> OmniTicketFile {
+        guard let data = try? Data(contentsOf: url(for: root)) else { return OmniTicketFile(root: root) }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        do {
+            var file = try decoder.decode(OmniTicketFile.self, from: data)
+            file.root = root
+            return file
+        } catch {
+            // Keep the unreadable file beside the new one rather than overwrite it.
+            let aside = url(for: root).deletingPathExtension().appendingPathExtension("unreadable-\(Int(Date().timeIntervalSince1970)).json")
+            try? FileManager.default.moveItem(at: url(for: root), to: aside)
+            DLog("Unreadable tickets file for \(root), moved to \(aside.path): \(error)")
+            return OmniTicketFile(root: root)
+        }
+    }
+
+    @discardableResult
+    static func save(_ file: OmniTicketFile) -> Bool {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            try encoder.encode(file).write(to: url(for: file.root), options: .atomic)
+            return true
+        } catch {
+            DLog("Could not save tickets for \(file.root): \(error)")
+            return false
+        }
+    }
+}
+
+// MARK: - Controller
+
+// The Tickets tab of a project page. It builds into the page's column and
+// handles the tab's keys; the page owns the scroll view and focus zones.
+final class OmniTicketsController: NSObject, NSTextFieldDelegate, NSTextViewDelegate, NSMenuDelegate {
+    private(set) var file: OmniTicketFile
+    private var openID: String?
+    private var selectedID: String?
+    private var rows: [String: OmniTicketRow] = [:]
+    private var groupZones: [(key: String, zone: OmniListZone)] = []
+    private var saveTimer: Timer?
+    private let titleField = NSTextField(string: "")
+    private let editor = OmniMarkdownEditor(fontSize: 14)
+    private let statusPopup = NSPopUpButton(frame: .zero, pullsDown: false)
+    private let priorityPopup = NSPopUpButton(frame: .zero, pullsDown: false)
+    private let detailMeta = OmniTheme.meta()
+    private var focusAfterBuild: (() -> Void)?
+
+    // Rebuilds the page; the controller never rebuilds while text is typed.
+    var requestRebuild: () -> Void = {}
+    // The height the page shows, for sizing the editor.
+    var visibleHeight: () -> CGFloat = { 600 }
+    var window: () -> NSWindow? = { nil }
+    private(set) var buttonsZone: OmniButtonZone?
+
+    init(root: String) {
+        file = OmniTicketStore.load(root: root)
+        super.init()
+        focusSelection()
+        titleField.font = OmniTheme.Font.title
+        titleField.isBordered = false
+        titleField.drawsBackground = false
+        titleField.focusRingType = .none
+        titleField.placeholderString = "Ticket title"
+        titleField.delegate = self
+        titleField.cell?.wraps = true
+        titleField.cell?.isScrollable = false
+        editor.textView.delegate = self
+        for status in OmniTicketStatus.allCases {
+            statusPopup.addItem(withTitle: status.label)
+            statusPopup.lastItem?.image = Self.image(status.symbol, color: status.color)
+        }
+        for priority in OmniTicketPriority.allCases {
+            priorityPopup.addItem(withTitle: priority.label)
+            priorityPopup.lastItem?.image = Self.image(priority.symbol, color: priority.color)
+        }
+        statusPopup.target = self
+        statusPopup.action = #selector(detailStatusChanged(_:))
+        priorityPopup.target = self
+        priorityPopup.action = #selector(detailPriorityChanged(_:))
+    }
+
+    deinit {
+        // Only typing waits to be saved; everything else saved at once.
+        if saveTimer != nil {
+            saveTimer?.invalidate()
+            OmniTicketStore.save(file)
+        }
+    }
+
+    var isEditingTicket: Bool {
+        return openID != nil
+    }
+
+    private var view: OmniTicketView {
+        get { file.view }
+        set {
+            file.view = newValue
+            save()
+        }
+    }
+
+    private func ticket(_ id: String?) -> OmniTicket? {
+        return file.tickets.first { $0.id == id }
+    }
+
+    private func update(_ id: String, _ change: (inout OmniTicket) -> Void) {
+        guard let index = file.tickets.firstIndex(where: { $0.id == id }) else { return }
+        var ticket = file.tickets[index]
+        change(&ticket)
+        guard ticket != file.tickets[index] else { return }
+        ticket.updated = Date()
+        file.tickets[index] = ticket
+    }
+
+    private func save() {
+        saveTimer?.invalidate()
+        saveTimer = nil
+        OmniTicketStore.save(file)
+    }
+
+    // Typing saves shortly after it pauses.
+    private func saveSoon() {
+        saveTimer?.invalidate()
+        saveTimer = Timer.scheduledTimer(withTimeInterval: 0.6, repeats: false) { [weak self] _ in
+            self?.save()
+        }
+    }
+
+    // MARK: Building
+
+    // Builds the tab into `column`; returns the list zones in Tab order.
+    func build(into column: OmniColumnView, previous: [(title: String, zone: OmniListZone)]) -> [(title: String, zone: OmniListZone)] {
+        rows = [:]
+        groupZones = []
+        if let openID, let ticket = ticket(openID) {
+            buildDetail(ticket, into: column)
+            runFocusAfterBuild()
+            return []
+        }
+        openID = nil
+        buildToolbar(into: column)
+        let groups = OmniTicketsModel.groups(file.tickets, view: view)
+        var zones: [(title: String, zone: OmniListZone)] = []
+        if file.tickets.isEmpty {
+            column.addText(OmniPaneText.label("No tickets yet. Press C, or New Ticket, to write the first one.",
+                                              size: 13, color: OmniTheme.secondaryText), spacing: 8)
+        } else if groups.isEmpty {
+            column.addText(OmniPaneText.label("Every status or priority is filtered out. Choose some under Filter.",
+                                              size: 13, color: OmniTheme.secondaryText), spacing: 8)
+        } else if view.layout == .board {
+            let board = OmniTicketBoardView()
+            for group in groups {
+                let zone = previous.first { $0.title == "tickets-" + group.key }?.zone ?? OmniListZone()
+                let items = group.tickets.map { ticket -> (key: String, view: OmniZoneItem) in
+                    let row = makeRow(ticket, card: true, zone: zone)
+                    return (key: ticket.id, view: row)
+                }
+                board.addColumn(title: group.title, symbol: symbol(forGroup: group.key), color: color(forGroup: group.key),
+                                zone: zone, items: items)
+                zones.append((title: "tickets-" + group.key, zone: zone))
+                groupZones.append((key: group.key, zone: zone))
+            }
+            column.add(board, spacing: 8) { [weak board] width in board?.layoutBoard(width: width) ?? 0 }
+        } else {
+            for group in groups where !group.tickets.isEmpty || view.grouping == .status {
+                let zone = previous.first { $0.title == "tickets-" + group.key }?.zone ?? OmniListZone()
+                let heading = OmniTicketGroupHeading(title: group.title, count: group.tickets.count,
+                                                     symbol: symbol(forGroup: group.key), color: color(forGroup: group.key))
+                column.add(heading, spacing: 4) { _ in OmniTicketGroupHeading.height }
+                guard !group.tickets.isEmpty else { continue }
+                let list = OmniColumnView()
+                list.inset = 0
+                list.topPadding = 0
+                list.bottomPadding = 0
+                list.overlay = zone
+                var items: [(key: String, view: OmniZoneItem)] = []
+                for ticket in group.tickets {
+                    let row = makeRow(ticket, card: false, zone: zone)
+                    list.add(row, spacing: 1) { _ in OmniTicketRow.listHeight }
+                    items.append((key: ticket.id, view: row))
+                }
+                zone.setItems(items)
+                column.add(list, spacing: 12) { [weak list] width in list?.layoutColumn(width: width) ?? 0 }
+                zones.append((title: "tickets-" + group.key, zone: zone))
+                groupZones.append((key: group.key, zone: zone))
+            }
+        }
+        for (_, zone) in groupZones {
+            zone.selectionDidChange = { [weak self] key in self?.selectedID = key }
+            zone.activateItem = { [weak self] key in self?.open(key) }
+        }
+        if let selectedID, let owner = groupZones.first(where: { $0.zone.keys.contains(selectedID) }) {
+            owner.zone.select(selectedID)
+        }
+        runFocusAfterBuild()
+        return zones
+    }
+
+    private func runFocusAfterBuild() {
+        guard let focus = focusAfterBuild else { return }
+        focusAfterBuild = nil
+        DispatchQueue.main.async(execute: focus)
+    }
+
+    private func makeRow(_ ticket: OmniTicket, card: Bool, zone: OmniListZone) -> OmniTicketRow {
+        let row = OmniTicketRow(ticket: ticket, fields: view.fields, card: card) { [weak self, weak zone] in
+            guard let self else { return }
+            self.selectedID = ticket.id
+            zone?.select(ticket.id)
+            self.open(ticket.id)
+        }
+        row.contextMenu = { [weak self, weak zone] in
+            zone?.select(ticket.id)
+            self?.selectedID = ticket.id
+            return self?.contextMenu(for: ticket.id)
+        }
+        rows[ticket.id] = row
+        return row
+    }
+
+    // Right-click on a ticket: the same commands as its keys.
+    private func contextMenu(for id: String) -> NSMenu? {
+        guard let ticket = ticket(id) else { return nil }
+        let menu = NSMenu()
+        menu.addAction("Open", symbol: .arrowRightCircle) { [weak self] in self?.open(id) }
+        menu.addSubmenu("Status", symbol: ticket.status.symbol) { submenu in
+            for status in OmniTicketStatus.allCases {
+                submenu.addAction(status.label, state: ticket.status == status ? .on : .off) { [weak self] in
+                    self?.change(id) { $0.status = status }
+                }.image = Self.image(status.symbol, color: status.color)
+            }
+        }
+        menu.addSubmenu("Priority", symbol: ticket.priority.symbol) { submenu in
+            for priority in OmniTicketPriority.allCases {
+                submenu.addAction(priority.label, state: ticket.priority == priority ? .on : .off) { [weak self] in
+                    self?.change(id) { $0.priority = priority }
+                }.image = Self.image(priority.symbol, color: priority.color)
+            }
+        }
+        menu.addItem(.separator())
+        menu.addAction("Copy Title", symbol: .docOnDoc) { OmniContextMenus.copy(ticket.title) }
+        menu.addAction("Copy as Markdown", symbol: .docOnDoc) {
+            OmniContextMenus.copy("# \(ticket.title)\n\n\(ticket.content)")
+        }
+        menu.addItem(.separator())
+        menu.addAction("Delete Ticket…", symbol: .trash) { [weak self] in
+            guard let self, self.delete(id) else { return }
+            self.focusSelection()
+            self.requestRebuild()
+        }
+        return menu
+    }
+
+    private func change(_ id: String, _ body: (inout OmniTicket) -> Void) {
+        update(id, body)
+        save()
+        focusSelection()
+        requestRebuild()
+    }
+
+    private func symbol(forGroup key: String) -> SFSymbol {
+        return OmniTicketStatus(rawValue: key)?.symbol ?? OmniTicketPriority(rawValue: key)?.symbol ?? .circle
+    }
+
+    private func color(forGroup key: String) -> NSColor {
+        return OmniTicketStatus(rawValue: key)?.color ?? OmniTicketPriority(rawValue: key)?.color ?? OmniTheme.secondaryText
+    }
+
+    private func buildToolbar(into column: OmniColumnView) {
+        let new = OmniPaneText.button("New Ticket", target: self, action: #selector(newTicket(_:)))
+        let layout = OmniPaneText.button(view.layout == .list ? "View: List" : "View: Board",
+                                         target: self, action: #selector(toggleLayout(_:)))
+        let group = OmniPaneText.button(view.grouping == .status ? "Group: Status" : "Group: Priority",
+                                        target: self, action: #selector(toggleGrouping(_:)))
+        let filter = OmniPaneText.button(filterTitle, target: self, action: #selector(showFilterMenu(_:)))
+        let display = OmniPaneText.button("Display", target: self, action: #selector(showDisplayMenu(_:)))
+        let buttons = OmniButtonRow([new, layout, group, filter, display])
+        buttonsZone = buttons.zone
+        column.add(buttons, spacing: 4) { [weak buttons] width in buttons?.height(forWidth: width) ?? 30 }
+        column.addText(OmniTheme.meta("C new · Return open · S status · P priority · ⌘B list or board · G group · F filter · D display · ⇧←→ move card · ⌘⌫ delete"),
+                       spacing: 14)
+    }
+
+    private var filterTitle: String {
+        let all = OmniTicketStatus.allCases.count
+        let statuses = view.statuses.count
+        let priorities = view.priorities.count
+        if statuses == all, priorities == OmniTicketPriority.allCases.count {
+            return "Filter: All"
+        }
+        if priorities == OmniTicketPriority.allCases.count, statuses == 1, let only = view.statuses.first {
+            return "Filter: " + only.label
+        }
+        return "Filter: \(statuses) of \(all) statuses" + (priorities < OmniTicketPriority.allCases.count ? ", \(priorities) priorities" : "")
+    }
+
+    private func buildDetail(_ ticket: OmniTicket, into column: OmniColumnView) {
+        let back = OmniPaneText.button("‹ All Tickets", target: self, action: #selector(closeTicket(_:)))
+        let delete = OmniPaneText.button("Delete", target: self, action: #selector(deleteOpenTicket(_:)))
+        let buttons = OmniButtonRow([back, statusPopup, priorityPopup, delete])
+        buttonsZone = buttons.zone
+        column.add(buttons, spacing: 12) { [weak buttons] width in buttons?.height(forWidth: width) ?? 30 }
+        if titleField.stringValue != ticket.title, titleField.currentEditor() == nil {
+            titleField.stringValue = ticket.title
+        }
+        if editor.text != ticket.content, editor.window?.firstResponder !== editor.textView {
+            editor.text = ticket.content
+        }
+        statusPopup.selectItem(at: OmniTicketStatus.allCases.firstIndex(of: ticket.status) ?? 0)
+        priorityPopup.selectItem(at: OmniTicketPriority.allCases.firstIndex(of: ticket.priority) ?? 0)
+        column.add(titleField, spacing: 4) { [weak titleField] width in
+            guard let titleField else { return 32 }
+            return max(32, ceil(titleField.cell?.cellSize(forBounds: NSRect(x: 0, y: 0, width: width, height: 1000)).height ?? 32))
+        }
+        detailMeta.stringValue = "#\(ticket.number) · created " + OmniTicketsModel.updatedText(ticket.created) +
+            " · updated " + OmniTicketsModel.updatedText(ticket.updated) + " · Escape returns to the tickets"
+        column.addText(detailMeta, spacing: 10)
+        column.add(editor, spacing: 8) { [weak self] _ in max(260, (self?.visibleHeight() ?? 600) - 210) }
+    }
+
+    // MARK: Actions
+
+    func open(_ id: String) {
+        guard ticket(id) != nil else { return }
+        openID = id
+        selectedID = id
+        titleField.stringValue = ticket(id)?.title ?? ""
+        editor.text = ticket(id)?.content ?? ""
+        focusAfterBuild = { [weak self] in
+            guard let self else { return }
+            self.window()?.makeFirstResponder(self.editor.textView)
+            self.editor.textView.setSelectedRange(NSRange(location: (self.editor.text as NSString).length, length: 0))
+        }
+        requestRebuild()
+    }
+
+    @objc func closeTicket(_ sender: Any?) {
+        commitDetail()
+        openID = nil
+        focusSelection()
+        requestRebuild()
+    }
+
+    // After a rebuild, give the keyboard to the selected ticket's list.
+    private func focusSelection() {
+        focusAfterBuild = { [weak self] in
+            guard let self else { return }
+            let owner = self.groupZones.first { self.selectedID != nil && $0.zone.keys.contains(self.selectedID!) } ?? self.groupZones.first
+            guard let owner else {
+                if let buttons = self.buttonsZone, buttons.zoneCanEnter {
+                    buttons.zoneEnter()
+                }
+                return
+            }
+            if let selectedID = self.selectedID, owner.zone.keys.contains(selectedID) {
+                owner.zone.select(selectedID)
+            }
+            if owner.zone.zoneCanEnter {
+                owner.zone.zoneEnter()
+                self.rows[self.selectedID ?? ""]?.scrollToVisible(self.rows[self.selectedID ?? ""]?.bounds ?? .zero)
+            }
+        }
+    }
+
+    private func commitDetail() {
+        guard let openID else { return }
+        let title = titleField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        let content = editor.text
+        update(openID) {
+            $0.title = title
+            $0.content = content
+        }
+        save()
+    }
+
+    @objc func newTicket(_ sender: Any?) {
+        var status = OmniTicketStatus.open
+        var priority = OmniTicketPriority.middleTerm
+        // On a board grouped by status, or in a group, start in the selected one's group.
+        if let selected = ticket(selectedID) {
+            if view.grouping == .status, selected.status != .done, selected.status != .discarded {
+                status = selected.status
+            } else if view.grouping == .priority {
+                priority = selected.priority
+            }
+        }
+        if !view.statuses.contains(status) {
+            view.statuses.append(status)
+        }
+        if !view.priorities.contains(priority) {
+            view.priorities.append(priority)
+        }
+        let now = Date()
+        let ticket = OmniTicket(id: UUID().uuidString, number: file.nextNumber, title: "", content: "",
+                                status: status, priority: priority, created: now, updated: now)
+        file.nextNumber += 1
+        file.tickets.append(ticket)
+        save()
+        openID = ticket.id
+        selectedID = ticket.id
+        titleField.stringValue = ""
+        editor.text = ""
+        focusAfterBuild = { [weak self] in
+            guard let self else { return }
+            self.window()?.makeFirstResponder(self.titleField)
+        }
+        requestRebuild()
+    }
+
+    @objc func toggleLayout(_ sender: Any?) {
+        view.layout = view.layout == .list ? .board : .list
+        focusSelection()
+        requestRebuild()
+    }
+
+    @objc func toggleGrouping(_ sender: Any?) {
+        view.grouping = view.grouping == .status ? .priority : .status
+        focusSelection()
+        requestRebuild()
+    }
+
+    @objc private func showFilterMenu(_ sender: Any?) {
+        let menu = NSMenu()
+        menu.addItem(Self.heading("Status"))
+        for status in OmniTicketStatus.allCases {
+            let item = NSMenuItem(title: status.label, action: #selector(toggleStatusFilter(_:)), keyEquivalent: "")
+            item.target = self
+            item.representedObject = status.rawValue
+            item.image = Self.image(status.symbol, color: status.color)
+            item.state = view.statuses.contains(status) ? .on : .off
+            menu.addItem(item)
+        }
+        let backlog = NSMenuItem(title: "Backlog Only (Open and In Progress)", action: #selector(backlogOnly(_:)), keyEquivalent: "")
+        backlog.target = self
+        menu.addItem(backlog)
+        let all = NSMenuItem(title: "Every Status", action: #selector(everyStatus(_:)), keyEquivalent: "")
+        all.target = self
+        menu.addItem(all)
+        menu.addItem(.separator())
+        menu.addItem(Self.heading("Priority"))
+        for priority in OmniTicketPriority.allCases {
+            let item = NSMenuItem(title: priority.label, action: #selector(togglePriorityFilter(_:)), keyEquivalent: "")
+            item.target = self
+            item.representedObject = priority.rawValue
+            item.image = Self.image(priority.symbol, color: priority.color)
+            item.state = view.priorities.contains(priority) ? .on : .off
+            menu.addItem(item)
+        }
+        pop(menu, from: sender)
+    }
+
+    // The board's columns are the shown statuses or priorities, so Display
+    // and Filter edit the same choice; Display adds the row properties.
+    @objc private func showDisplayMenu(_ sender: Any?) {
+        let menu = NSMenu()
+        menu.addItem(Self.heading("Group By"))
+        for grouping in [OmniTicketGrouping.status, .priority] {
+            let item = NSMenuItem(title: grouping == .status ? "Status" : "Priority", action: #selector(chooseGrouping(_:)), keyEquivalent: "")
+            item.target = self
+            item.representedObject = grouping.rawValue
+            item.state = view.grouping == grouping ? .on : .off
+            menu.addItem(item)
+        }
+        menu.addItem(.separator())
+        menu.addItem(Self.heading(view.layout == .board ? "Columns" : "Groups"))
+        if view.grouping == .status {
+            for status in OmniTicketStatus.allCases {
+                let item = NSMenuItem(title: status.label, action: #selector(toggleStatusFilter(_:)), keyEquivalent: "")
+                item.target = self
+                item.representedObject = status.rawValue
+                item.state = view.statuses.contains(status) ? .on : .off
+                menu.addItem(item)
+            }
+        } else {
+            for priority in OmniTicketPriority.allCases {
+                let item = NSMenuItem(title: priority.label, action: #selector(togglePriorityFilter(_:)), keyEquivalent: "")
+                item.target = self
+                item.representedObject = priority.rawValue
+                item.state = view.priorities.contains(priority) ? .on : .off
+                menu.addItem(item)
+            }
+        }
+        menu.addItem(.separator())
+        menu.addItem(Self.heading("Properties"))
+        for field in OmniTicketField.allCases {
+            let item = NSMenuItem(title: field.label, action: #selector(toggleField(_:)), keyEquivalent: "")
+            item.target = self
+            item.representedObject = field.rawValue
+            item.state = view.fields.contains(field) ? .on : .off
+            menu.addItem(item)
+        }
+        pop(menu, from: sender)
+    }
+
+    @objc private func chooseGrouping(_ sender: NSMenuItem) {
+        guard let raw = sender.representedObject as? String, let grouping = OmniTicketGrouping(rawValue: raw) else { return }
+        view.grouping = grouping
+        requestRebuild()
+    }
+
+    @objc private func toggleStatusFilter(_ sender: NSMenuItem) {
+        guard let raw = sender.representedObject as? String, let status = OmniTicketStatus(rawValue: raw) else { return }
+        var statuses = view.statuses
+        if let index = statuses.firstIndex(of: status) {
+            statuses.remove(at: index)
+        } else {
+            statuses.append(status)
+        }
+        view.statuses = OmniTicketStatus.allCases.filter { statuses.contains($0) }
+        requestRebuild()
+    }
+
+    @objc private func togglePriorityFilter(_ sender: NSMenuItem) {
+        guard let raw = sender.representedObject as? String, let priority = OmniTicketPriority(rawValue: raw) else { return }
+        var priorities = view.priorities
+        if let index = priorities.firstIndex(of: priority) {
+            priorities.remove(at: index)
+        } else {
+            priorities.append(priority)
+        }
+        view.priorities = OmniTicketPriority.allCases.filter { priorities.contains($0) }
+        requestRebuild()
+    }
+
+    @objc private func backlogOnly(_ sender: Any?) {
+        view.statuses = [.open, .inProgress]
+        requestRebuild()
+    }
+
+    @objc private func everyStatus(_ sender: Any?) {
+        view.statuses = OmniTicketStatus.allCases
+        requestRebuild()
+    }
+
+    @objc private func toggleField(_ sender: NSMenuItem) {
+        guard let raw = sender.representedObject as? String, let field = OmniTicketField(rawValue: raw) else { return }
+        var fields = view.fields
+        if let index = fields.firstIndex(of: field) {
+            fields.remove(at: index)
+        } else {
+            fields.append(field)
+        }
+        view.fields = OmniTicketField.allCases.filter { fields.contains($0) }
+        requestRebuild()
+    }
+
+    // The status or priority menu for one ticket, with 1 to 4 picking an entry.
+    private func showValueMenu(status: Bool, for id: String, from anchor: NSView?) {
+        guard let ticket = ticket(id) else { return }
+        let menu = NSMenu()
+        if status {
+            for (index, value) in OmniTicketStatus.allCases.enumerated() {
+                let item = NSMenuItem(title: value.label, action: #selector(setStatus(_:)), keyEquivalent: "\(index + 1)")
+                item.keyEquivalentModifierMask = []
+                item.target = self
+                item.representedObject = [id, value.rawValue]
+                item.image = Self.image(value.symbol, color: value.color)
+                item.state = ticket.status == value ? .on : .off
+                menu.addItem(item)
+            }
+        } else {
+            for (index, value) in OmniTicketPriority.allCases.enumerated() {
+                let item = NSMenuItem(title: value.label, action: #selector(setPriority(_:)), keyEquivalent: "\(index + 1)")
+                item.keyEquivalentModifierMask = []
+                item.target = self
+                item.representedObject = [id, value.rawValue]
+                item.image = Self.image(value.symbol, color: value.color)
+                item.state = ticket.priority == value ? .on : .off
+                menu.addItem(item)
+            }
+        }
+        pop(menu, from: anchor)
+    }
+
+    @objc private func setStatus(_ sender: NSMenuItem) {
+        guard let pair = sender.representedObject as? [String], pair.count == 2,
+              let status = OmniTicketStatus(rawValue: pair[1]) else { return }
+        update(pair[0]) { $0.status = status }
+        save()
+        focusSelection()
+        requestRebuild()
+    }
+
+    @objc private func setPriority(_ sender: NSMenuItem) {
+        guard let pair = sender.representedObject as? [String], pair.count == 2,
+              let priority = OmniTicketPriority(rawValue: pair[1]) else { return }
+        update(pair[0]) { $0.priority = priority }
+        save()
+        focusSelection()
+        requestRebuild()
+    }
+
+    @objc private func detailStatusChanged(_ sender: NSPopUpButton) {
+        guard let openID, OmniTicketStatus.allCases.indices.contains(sender.indexOfSelectedItem) else { return }
+        update(openID) { $0.status = OmniTicketStatus.allCases[sender.indexOfSelectedItem] }
+        save()
+    }
+
+    @objc private func detailPriorityChanged(_ sender: NSPopUpButton) {
+        guard let openID, OmniTicketPriority.allCases.indices.contains(sender.indexOfSelectedItem) else { return }
+        update(openID) { $0.priority = OmniTicketPriority.allCases[sender.indexOfSelectedItem] }
+        save()
+    }
+
+    @objc private func deleteOpenTicket(_ sender: Any?) {
+        guard let openID else { return }
+        if delete(openID) {
+            self.openID = nil
+            focusSelection()
+            requestRebuild()
+        }
+    }
+
+    private func delete(_ id: String) -> Bool {
+        guard let ticket = ticket(id) else { return false }
+        let name = ticket.title.isEmpty ? "ticket #\(ticket.number)" : "“\(ticket.title)”"
+        let selection = iTermWarning.show(withTitle: "Delete \(name)? This cannot be undone. Set it to Discarded to keep it.",
+                                          actions: ["Delete", "Cancel"], actionMapping: nil, accessory: nil,
+                                          identifier: nil, silenceable: .kiTermWarningTypePersistent,
+                                          heading: "Delete Ticket", cancelLabel: "Cancel", window: window())
+        guard selection == .kiTermWarningSelection0 else { return false }
+        file.tickets.removeAll { $0.id == id }
+        save()
+        if selectedID == id {
+            selectedID = nil
+        }
+        return true
+    }
+
+    // Moves the selected card to the next column left or right.
+    private func moveSelected(_ delta: Int) {
+        guard let ticket = ticket(selectedID),
+              let key = OmniTicketsModel.neighbour(of: ticket, delta: delta, view: view) else { return }
+        let moved = OmniTicketsModel.moved(ticket, to: key, grouping: view.grouping)
+        update(ticket.id) {
+            $0.status = moved.status
+            $0.priority = moved.priority
+        }
+        save()
+        focusSelection()
+        requestRebuild()
+    }
+
+    private func pop(_ menu: NSMenu, from anchor: Any?) {
+        if let button = anchor as? NSView {
+            menu.popUp(positioning: nil, at: NSPoint(x: 0, y: button.bounds.height + 4), in: button)
+        } else if let row = rows[selectedID ?? ""] {
+            menu.popUp(positioning: nil, at: NSPoint(x: 36, y: row.bounds.height), in: row)
+        } else if let window = window(), let content = window.contentView {
+            menu.popUp(positioning: nil, at: content.convert(window.mouseLocationOutsideOfEventStream, from: nil), in: content)
+        }
+    }
+
+    // MARK: Keys
+
+    // The tab's keys while one of the page's zones has the keyboard.
+    func handleShortcut(_ event: NSEvent, focused: OmniFocusZone?) -> Bool {
+        let flags = event.modifierFlags.intersection([.command, .option, .control, .shift])
+        let key = event.charactersIgnoringModifiers?.lowercased() ?? ""
+        // The focused list's selection is the ticket the keys act on.
+        if let zone = groupZones.first(where: { $0.zone === focused })?.zone {
+            selectedID = zone.selectedKey
+        }
+        if openID != nil {
+            if event.keyCode == 53, flags.isEmpty {
+                closeTicket(nil)
+                return true
+            }
+            if flags.isEmpty, key == "s" || key == "p" {
+                (key == "s" ? statusPopup : priorityPopup).performClick(nil)
+                return true
+            }
+            return false
+        }
+        if flags == .command, key == "b" {
+            toggleLayout(nil)
+            return true
+        }
+        if flags == .command, event.keyCode == 51, let selectedID, isListFocused(focused) {
+            if delete(selectedID) {
+                focusSelection()
+                requestRebuild()
+            }
+            return true
+        }
+        let column = groupZones.firstIndex { $0.zone === focused }
+        if view.layout == .board, let column, event.keyCode == 123 || event.keyCode == 124 {
+            let delta = event.keyCode == 123 ? -1 : 1
+            if flags == .shift {
+                moveSelected(delta)
+                return true
+            }
+            if flags.isEmpty {
+                return focusColumn(from: column, delta: delta)
+            }
+        }
+        guard flags.isEmpty || flags == .shift else { return false }
+        switch key {
+        case "c":
+            newTicket(nil)
+        case "g":
+            toggleGrouping(nil)
+        case "f":
+            showFilterMenu(nil)
+        case "d":
+            showDisplayMenu(nil)
+        case "s", "p":
+            guard let selectedID, isListFocused(focused) else { return false }
+            showValueMenu(status: key == "s", for: selectedID, from: nil)
+        default:
+            return false
+        }
+        return true
+    }
+
+    private func isListFocused(_ focused: OmniFocusZone?) -> Bool {
+        return groupZones.contains { $0.zone === focused }
+    }
+
+    // Left and Right move between board columns, keeping the row's place.
+    private func focusColumn(from index: Int, delta: Int) -> Bool {
+        let target = index + delta
+        guard groupZones.indices.contains(target) else {
+            // Left of the first column goes back to the sidebar as usual.
+            return delta > 0
+        }
+        let source = groupZones[index].zone
+        let row = source.selectedKey.flatMap { source.keys.firstIndex(of: $0) } ?? 0
+        let zone = groupZones[target].zone
+        guard !zone.keys.isEmpty else {
+            // Skip an empty column if there is one beyond it.
+            return focusColumn(from: target, delta: delta) || true
+        }
+        let key = zone.keys[min(row, zone.keys.count - 1)]
+        zone.select(key)
+        selectedID = key
+        window()?.makeFirstResponder(zone.zoneFirstResponder)
+        rows[key]?.scrollToVisible(rows[key]?.bounds ?? .zero)
+        return true
+    }
+
+    // MARK: Text
+
+    func controlTextDidChange(_ obj: Notification) {
+        guard let openID else { return }
+        let title = titleField.stringValue
+        update(openID) { $0.title = title }
+        saveSoon()
+    }
+
+    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+        if commandSelector == #selector(NSResponder.cancelOperation(_:)) {
+            closeTicket(nil)
+            return true
+        }
+        if commandSelector == #selector(NSResponder.insertNewline(_:)) || commandSelector == #selector(NSResponder.insertTab(_:)) {
+            window()?.makeFirstResponder(editor.textView)
+            return true
+        }
+        return false
+    }
+
+    func textDidChange(_ notification: Notification) {
+        guard let openID else { return }
+        let content = editor.text
+        update(openID) { $0.content = content }
+        saveSoon()
+    }
+
+    func textView(_ textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+        if commandSelector == #selector(NSResponder.cancelOperation(_:)) {
+            closeTicket(nil)
+            return true
+        }
+        return false
+    }
+
+    // MARK: Helpers
+
+    static func image(_ symbol: SFSymbol, color: NSColor) -> NSImage? {
+        let configuration = NSImage.SymbolConfiguration(pointSize: 12, weight: .medium)
+            .applying(NSImage.SymbolConfiguration(paletteColors: [color]))
+        return NSImage(systemSymbolName: symbol.rawValue, accessibilityDescription: nil)?.withSymbolConfiguration(configuration)
+    }
+
+    private static func heading(_ title: String) -> NSMenuItem {
+        let item = NSMenuItem(title: title, action: nil, keyEquivalent: "")
+        item.isEnabled = false
+        return item
+    }
+}
