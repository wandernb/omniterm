+    _omniDoubleEscapeButton.state = [settings[@"double_escape_to_hide"] boolValue] ? NSControlStateValueOn : NSControlStateValueOff;
+    _omniDoubleEscapeIntervalField.integerValue = [settings[@"double_escape_interval_ms"] integerValue];
+    _omniDoubleEscapeIntervalField.enabled = (_omniDoubleEscapeButton.state == NSControlStateValueOn);
+    _omniDefaultTimeoutField.integerValue = [settings[@"default_timeout_seconds"] integerValue] / 60;
+    _omniRetainedTabsField.integerValue = [settings[@"retained_run_tabs"] integerValue];
+    _omniTimezoneComboBox.stringValue = settings[@"timezone"] ?: NSTimeZone.localTimeZone.name;
+    if (@available(macOS 13.0, *)) {
