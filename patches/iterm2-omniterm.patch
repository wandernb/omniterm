+static BOOL OmniIsKnowledgeOperation(id value) {
+    static NSSet *operations;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        operations = [[NSSet alloc] initWithArray:@[ @"list_sessions", @"get_session", @"search_transcripts",
+                                                    @"knowledge_status", @"upsert_memory", @"search_memories",
+                                                    @"delete_memory", @"send_session_message", @"get_session_message",
+                                                    @"memory_candidates", @"dismiss_memory_candidate",
+                                                    @"list_memories", @"get_memory", @"memory_events",
+                                                    @"memory_overview", @"memory_graph", @"memory_digest",
+                                                    @"update_memory", @"dismiss_memory_candidates",
+                                                    @"configure_storage", @"memory_topics", @"name_topic",
+                                                    @"merge_candidates", @"decide_merge",
+                                                    @"explain_memory", @"weekly_summary_candidates",
+                                                    @"write_weekly_summary", @"record_block", @"list_blocked",
+                                                    @"get_block", @"answer_block", @"skip_block",
+                                                    @"get_unblock", @"set_unblock", @"rename_session",
+                                                    @"get_system_prompt", @"consume_grant",
+                                                    @"record_unblock_audit", @"unblocker_audit",
+                                                    @"get_unblocker_policy", @"set_unblocker_policy",
+                                                    @"list_projects", @"get_project", @"get_project_file",
+                                                    @"list_project_folder", @"project_of", @"code_graph",
+                                                    @"list_accounts", @"add_account", @"login_account", @"remove_account", @"rename_account",
+                                                    @"set_account_email", @"refresh_accounts", @"install_routers" ]];
+    });
+    return [value isKindOfClass:[NSString class]] && [operations containsObject:value];
+}
+
+// Requests that only read. Their answer does not depend on saving the indexing
+// writes that come back with it, so they return at once and leave those writes
+// pending in the worker, unacknowledged, for the indexing tick to save. A read
+// must never wait for a backlog of indexing to be committed.
+static BOOL OmniIsKnowledgeReadOperation(id value) {
+    static NSSet *operations;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        operations = [[NSSet alloc] initWithArray:@[ @"list_sessions", @"get_session", @"search_transcripts",
+                                                    @"knowledge_status", @"search_memories", @"list_memories",
+                                                    @"get_memory", @"memory_events", @"memory_overview",
+                                                    @"memory_graph", @"memory_digest", @"memory_topics",
+                                                    @"explain_memory", @"list_blocked", @"get_block",
+                                                    @"get_unblock", @"get_system_prompt", @"unblocker_audit",
+                                                    @"get_unblocker_policy", @"list_projects", @"get_project",
+                                                    @"get_project_file", @"list_project_folder", @"project_of",
+                                                    @"code_graph",
+                                                    // Account ops never touch the index: no drain.
+                                                    @"list_accounts", @"add_account", @"login_account", @"remove_account", @"rename_account",
+                                                    @"set_account_email", @"refresh_accounts", @"install_routers" ]];
+    });
+    return [value isKindOfClass:[NSString class]] && [operations containsObject:value];
+}
+
+// How much of the worker's pending writes a request saves before it returns.
+typedef NS_ENUM(NSInteger, OmniKnowledgeDrain) {
+    OmniKnowledgeDrainAll,      // Everything: a change is saved before it is reported.
+    OmniKnowledgeDrainYielding, // Indexing: stops between batches when a request waits.
+    OmniKnowledgeDrainNone,     // A read: leaves the writes pending for indexing.
+};
