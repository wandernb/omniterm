+static os_log_t OmniTermWindowLog(void) {
+    static os_log_t log;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        log = os_log_create("com.omniterm.app", "window-frame");
+    });
+    return log;
+}
+
+// Switching to the pinned window's Space ends with macOS activating the
+// frontmost app there, which can leave OmniTerm behind; once the switch ends,
+// bring the window forward again. Only a switch within two seconds counts.
+- (void)omniBringPinnedWindowForwardAfterSpaceChange:(NSWindow *)window {
+    [self omniStopWaitingForPinnedSpaceChange];
+    const NSInteger generation = ++_omniPinnedSpaceGeneration;
+    __block iTermApplicationDelegate *weakSelf = self;
+    _omniPinnedSpaceObserver =
+        [[[NSWorkspace sharedWorkspace].notificationCenter addObserverForName:NSWorkspaceActiveSpaceDidChangeNotification
+                                                                       object:nil
+                                                                        queue:[NSOperationQueue mainQueue]
+                                                                   usingBlock:^(NSNotification *notification) {
+        [weakSelf omniStopWaitingForPinnedSpaceChange];
+        os_log(OmniTermWindowLog(), "space switched: window here %d, front %d; bringing forward",
+               window.isOnActiveSpace, NSApp.isActive);
+        if (!window.isVisible || !window.isOnActiveSpace) {
+            return;
+        }
+        [OmniDockPresence performExplicitShow:^{
+            [window makeKeyAndOrderFront:nil];
+        }];
+        [NSApp activateIgnoringOtherApps:YES];
+    }] retain];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        if (weakSelf->_omniPinnedSpaceGeneration == generation) {
+            [weakSelf omniStopWaitingForPinnedSpaceChange];
+        }
+    });
+}
+
+- (void)omniStopWaitingForPinnedSpaceChange {
+    if (_omniPinnedSpaceObserver) {
+        [[NSWorkspace sharedWorkspace].notificationCenter removeObserver:_omniPinnedSpaceObserver];
+        [_omniPinnedSpaceObserver release];
+        _omniPinnedSpaceObserver = nil;
+    }
+}
+
+// Whether the hotkey should put the window away rather than bring it up. A
+// pinned window on another Space, or wholly covered by other windows, comes
+// to the front instead.
+- (BOOL)omniTermWindowIsUp:(PseudoTerminal *)terminal {
+    NSWindow *window = terminal.window;
+    if (!window.isVisible || NSApp.isHidden) {
+        return NO;
+    }
+    if (!terminal.omniWindowPinned) {
+        // Unpinned: on another Space, the shortcut brings it here instead.
+        return window.isOnActiveSpace;
+    }
+    // Pinned: hide it only when it shows on the current Space; on another
+    // Space, or wholly covered, the shortcut switches to it instead.
+    return window.isOnActiveSpace && (window.occlusionState & NSWindowOcclusionStateVisible) != 0;
+}
+
+- (NSArray<iTermHotKey *> *)omniTermGlobalHotKeyPressed:(NSDictionary *)userData
+                                                siblings:(NSArray<iTermHotKey *> *)siblings {
+    PseudoTerminal *terminal = [iTermController sharedInstance].currentTerminal ?: self.terminals.firstObject;
+    const BOOL up = [self omniTermWindowIsUp:terminal];
+    os_log(OmniTermWindowLog(), "hotkey: %{public}s (pinned %d)", up ? "hide" : "show", terminal.omniWindowPinned);
+    if (up) {
+        [terminal omniHideWindow];
+    } else {
+        // The hotkey is for the terminal only. Activating the app would bring
+        // the Inbox forward with it, so put the Inbox away first.
+        [[OmniInboxWindowController sharedInstance].window orderOut:nil];
+        [self openOmniTerm:nil];
+    }
+    return siblings;
+}
+
+- (void)startOmniDockPresence {
+    if (_omniDockPresence) {
+        return;
+    }
+    __block iTermApplicationDelegate *weakSelf = self;
+    _omniDockPresence = [[OmniDockPresence alloc] initWithPolicy:NSApplicationActivationPolicyAccessory
+                                                anyWindowVisible:^BOOL{
+        return [weakSelf anyOmniTermWindowPresent];
+    }
+                                                     appIsActive:^BOOL{
+        return NSApp.isActive;
+    }
+                                                           apply:^(NSApplicationActivationPolicy policy) {
+        [[iTermApplication sharedApplication] omniSetShowsInDock:policy == NSApplicationActivationPolicyRegular];
+    }];
+    [_omniDockPresence startObserving];
+}
+
+// The terminal window and the Inbox decide the Dock icon; panels such as
+// Settings and About do not.
+- (BOOL)anyOmniTermWindowPresent {
+    if (NSApp.isHidden) {
+        return NO;
+    }
+    for (PseudoTerminal *terminal in self.terminals) {
+        if ([OmniDockPresence windowIsPresent:terminal.window]) {
+            return YES;
+        }
+    }
+    NSWindow *inbox = [self omniInboxWindowIfLoaded];
+    return [OmniDockPresence windowIsPresent:inbox];
+}
+
+// Without creating the Inbox, which builds its whole window.
+- (NSWindow *)omniInboxWindowIfLoaded {
+    for (NSWindow *window in NSApp.windows) {
+        if ([window.windowController isKindOfClass:[OmniInboxWindowController class]]) {
+            return window;
+        }
+    }
+    return nil;
+}
+
+// ⌘Q: put every OmniTerm window away and hand focus back to the previous app.
+// Ordering them out, rather than only hiding the app, keeps the Inbox from
+// returning when the hotkey later unhides the app.
+- (void)hideAllOmniTermWindows {
+    for (PseudoTerminal *terminal in self.terminals) {
+        // A pinned window stays on its Space, hidden with the app.
+        if (!terminal.omniWindowPinned) {
+            [terminal.window orderOut:nil];
+        }
+    }
+    [[self omniInboxWindowIfLoaded] orderOut:nil];
+    [NSApp hide:nil];
+    [_omniDockPresence reconcile];
+}
+
+- (void)terminateOmniTermCompletely:(id)sender {
+    _omniTermExplicitlyTerminating = YES;
+    [NSApp terminate:sender];
+}
