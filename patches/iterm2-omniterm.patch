+- (void)testRunReportListsCommitsAndDiffsCommittedAndUncommittedWorkSinceStart {
+    NSString *repository = [self repositoryWithFirstCommit];
+    [self startSchedulerWithAgentWorkspace:repository];
+    NSString *runID = [_scheduler startAgentNamed:@"Repo" reason:@"manual" resumeSessionID:nil][@"run_id"];
+    NSDictionary *started = [self waitForRun:runID until:^BOOL(NSDictionary *run) {
+        return [run[@"head_start"] isKindOfClass:[NSString class]];
+    }];
+    XCTAssertEqualObjects(started[@"workspace"], repository);
+    XCTAssertEqualObjects(started[@"provider"], @"codex");
+    XCTAssertEqualObjects(started[@"origin"], @"scheduled");
+    XCTAssertEqualObjects(started[@"branch"], @"main");
+
+    [@"committed\n" writeToFile:[repository stringByAppendingPathComponent:@"b.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    [self runGit:@[ @"add", @"b.txt" ] inDirectory:repository];
+    [self runGit:@[ @"commit", @"-q", @"-m", @"Add b" ] inDirectory:repository];
+    [@"uncommitted\n" writeToFile:[repository stringByAppendingPathComponent:@"a.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    [@"new\n" writeToFile:[repository stringByAppendingPathComponent:@"new.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+
+    XCTAssertEqualObjects([self finishTurnOf:runID message:@"Added b."][@"ok"], @YES);
+    NSDictionary *pending = [self runReport:runID];
+    XCTAssertEqualObjects(pending[@"summary_state"], @"pending");
+    XCTAssertEqualObjects(pending[@"final_message"], @"Added b.");
+    XCTAssertEqualObjects(pending[@"transcript_path"], @"/tmp/t.jsonl");
+
+    NSDictionary *run = [self waitForRun:runID until:^BOOL(NSDictionary *candidate) {
+        return candidate[@"diff_state"] && ![candidate[@"diff_state"] isEqual:@"pending"];
+    }];
+    XCTAssertEqualObjects(run[@"diff_state"], @"captured");
+    XCTAssertEqual([run[@"commits"] count], 1);
+    XCTAssertEqualObjects([run[@"commits"] firstObject][@"subject"], @"Add b");
+    XCTAssertNotEqualObjects(run[@"head_start"], run[@"head_end"]);
+    XCTAssertEqualObjects([run[@"commits"] firstObject][@"sha"], run[@"head_end"]);
+    NSSet *expectedFiles = [NSSet setWithArray:@[ @"a.txt", @"b.txt", @"new.txt" ]];
+    XCTAssertEqualObjects([NSSet setWithArray:run[@"diff_files"]], expectedFiles);
+    XCTAssertNil(run[@"diff_path"], @"Internal file paths are not exposed");
+    XCTAssertTrue([NSJSONSerialization isValidJSONObject:run]);
+
+    NSDictionary *diff = [_scheduler responseForRequest:@{ @"op": @"run_diff", @"id": runID }];
+    XCTAssertEqualObjects(diff[@"ok"], @YES);
+    XCTAssertTrue([diff[@"diff"] containsString:@"+committed"], @"%@", diff[@"diff"]);
+    XCTAssertTrue([diff[@"diff"] containsString:@"+uncommitted"], @"%@", diff[@"diff"]);
+    XCTAssertEqualObjects(diff[@"truncated"], @NO);
+    NSString *diffFile = [[_temporaryPath stringByAppendingPathComponent:@"run-diffs"]
+                          stringByAppendingPathComponent:[runID stringByAppendingPathExtension:@"diff"]];
+    NSDictionary *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:diffFile error:nil];
+    XCTAssertEqual([attributes[NSFilePosixPermissions] integerValue], 0600);
+
+    NSDictionary *summarized = [_scheduler responseForRequest:@{ @"op": @"run_summary", @"run_id": runID,
+                                                                 @"state": @"ready", @"summary": @"Added b." }];
+    XCTAssertEqualObjects(summarized[@"ok"], @YES);
+    XCTAssertNil(summarized[@"ignored"]);
+    XCTAssertEqualObjects([self runReport:runID][@"summary_state"], @"ready");
+    XCTAssertEqualObjects([self runReport:runID][@"summary"], @"Added b.");
+    NSDictionary *late = [_scheduler responseForRequest:@{ @"op": @"run_summary", @"run_id": runID,
+                                                           @"state": @"failed", @"error": @"late" }];
+    XCTAssertEqualObjects(late[@"ignored"], @YES, @"Only a summary that was asked for is stored");
+    XCTAssertEqualObjects([self runReport:runID][@"summary"], @"Added b.");
+}
