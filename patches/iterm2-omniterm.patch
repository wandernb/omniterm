+
+// The Settings page writes through `set_settings`. The global shortcut and
+// login launch have effects only the app can make; OmniSettingsTransaction
+// applies them, has the scheduler validate and store the rest, and undoes
+// them if anything is refused.
+- (id)omniSettingsTransaction {
+    OmniSettingsTransaction *transaction = [[[OmniSettingsTransaction alloc] init] autorelease];
+    __block iTermApplicationDelegate *blockSelf = self;
+    transaction.currentShortcut = ^id {
+        iTermShortcut *shortcut = blockSelf->_omniTermGlobalHotKey.shortcut;
+        return shortcut.isAssigned ? shortcut.dictionaryValue : NSNull.null;
+    };
+    transaction.applyShortcut = ^BOOL(id value) {
+        iTermShortcut *shortcut = nil;
+        if ([value isEqual:@"default"]) {
+            shortcut = [blockSelf omniTermDefaultShortcut];
+        } else if ([value isKindOfClass:[NSDictionary class]]) {
+            shortcut = [blockSelf omniTermShortcutFromSettings:@{ @"global_shortcut": value }];
+        }
+        return [blockSelf applyOmniTermShortcut:shortcut];
+    };
+    transaction.currentLogin = ^BOOL {
+        return [blockSelf omniTermLaunchAtLoginIsEnabled];
+    };
+    transaction.setLogin = ^NSString *(BOOL enabled) {
+        NSError *error = nil;
+        if ([blockSelf setOmniTermLaunchAtLogin:enabled error:&error]) {
+            return nil;
+        }
+        return error.localizedDescription ?: @"Could not change login startup.";
+    };
+    transaction.store = ^NSString *(NSDictionary *stored) {
+        NSError *error = nil;
+        if ([blockSelf->_omniScheduler updateSettings:stored error:&error]) {
+            return nil;
+        }
+        return error.localizedDescription ?: @"Could not save settings.";
+    };
+    transaction.forward = ^(NSDictionary *changes, void (^done)(NSDictionary *)) {
+        [blockSelf->_omniScheduler performRequest:@{ @"op": @"set_settings", @"settings": changes } completion:done];
+    };
+    return transaction;
+}
+
+// What the Settings page reads: the stored settings plus live app state.
+- (NSDictionary *)omniSettingsResponse:(NSDictionary *)response {
+    if (![response[@"ok"] isEqual:@YES] || ![response[@"settings"] isKindOfClass:[NSDictionary class]]) {
+        return response;
+    }
+    NSMutableDictionary *settings = [[response[@"settings"] mutableCopy] autorelease];
+    BOOL requiresApproval = NO;
+    settings[@"launch_at_login"] = @([self omniTermLaunchAtLoginStatus:&requiresApproval]);
+    settings[@"launch_at_login_requires_approval"] = @(requiresApproval);
+    NSMutableDictionary *result = [[response mutableCopy] autorelease];
+    result[@"settings"] = settings;
+    return result;
+}
+
+- (void)omniSchedulerRequest:(NSDictionary *)request completion:(void (^)(NSDictionary *))completion {
+    void (^callback)(NSDictionary *) = [[completion copy] autorelease];
+    if (!_omniScheduler) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            callback(@{ @"ok": @NO, @"error": @"The OmniTerm scheduler is not running" });
+        });
+        return;
+    }
+    NSString *operation = [request isKindOfClass:[NSDictionary class]] ? request[@"op"] : nil;
+    if ([operation isEqual:@"get_settings"]) {
+        [_omniScheduler performRequest:request completion:^(NSDictionary *response) {
+            // Pages read settings on every refresh; the login status asks a
+            // daemon over XPC, which must not stall the main thread.
+            dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+                NSDictionary *final = [self omniSettingsResponse:response];
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    callback(final);
+                });
+            });
+        }];
+        return;
+    }
+    if ([operation isEqual:@"set_settings"] && [request[@"settings"] isKindOfClass:[NSDictionary class]]) {
+        OmniSettingsTransaction *transaction = [self omniSettingsTransaction];
+        [transaction run:request[@"settings"] completion:^(NSDictionary *response) {
+            NSDictionary *result = [response[@"ok"] isEqual:@YES]
+                ? @{ @"ok": @YES, @"settings": [self->_omniScheduler currentSettings] } : response;
+            NSDictionary *final = [self omniSettingsResponse:result];
+            // Always answer later, like the scheduler: the page rebuilds its
+            // controls in the answer, which must not happen inside a control's action.
+            dispatch_async(dispatch_get_main_queue(), ^{
+                callback(final);
+            });
+        }];
+        return;
+    }
+    [_omniScheduler performRequest:request completion:callback];
+}
