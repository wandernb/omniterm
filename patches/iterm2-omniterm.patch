+    // MARK: - Window pin
+
+    private static let pinButtonWidth: CGFloat = 26
+
+    // Pinned, the window belongs to its Space: showing it switches to that
+    // Space rather than bringing the window to the current one. Moving or
+    // resizing it is still the person's; like an unpinned window it comes
+    // back wherever they left it.
+    @objc var windowPinned: Bool {
+        return panelLayout.layout.windowPinned
+    }
+
+    @objc func setWindowPinned(_ pinned: Bool) {
+        guard let window = view.window else { return }
+        omniWindowFrameLog.notice("pin \(pinned, privacy: .public) \(NSStringFromRect(window.frame), privacy: .public)")
+        panelLayout.update { layout in
+            layout.windowPinned = pinned
+            // A hidden window keeps the frame it was last shown with.
+            if pinned, window.isVisible || layout.windowFrame == nil {
+                layout.windowFrame = window.frame
+            }
+            layout.windowSpace = pinned ? OmniWindowSpaces.space(of: window) : nil
+        }
+        applyWindowPin()
+    }
+
+    // Where the pinned window is now, kept so a relaunch can put it back on
+    // that Space; the window itself keeps its Space while OmniTerm runs.
+    @objc func noteWindowSpace() {
+        if let window = view.window {
+            omniWindowFrameLog.notice("window on space \(OmniWindowSpaces.space(of: window).map(String.init) ?? "none", privacy: .public), active \(OmniWindowSpaces.activeSpace().map(String.init) ?? "?", privacy: .public), front \(NSApp.isActive, privacy: .public)")
+        }
+        guard windowPinned, let window = view.window, let space = OmniWindowSpaces.space(of: window),
+              space != panelLayout.layout.windowSpace else { return }
+        panelLayout.update { $0.windowSpace = space }
+    }
+
+    // Before a pinned window shows: on the Space it belongs to, when it is
+    // on none (after a relaunch) or another, and that Space still exists.
+    @objc func moveWindowToPinnedSpace() {
+        if let window = view.window {
+            omniWindowFrameLog.notice("opening pinned: window on space \(OmniWindowSpaces.space(of: window).map(String.init) ?? "none", privacy: .public), active \(OmniWindowSpaces.activeSpace().map(String.init) ?? "?", privacy: .public), stored \(self.panelLayout.layout.windowSpace.map(String.init) ?? "none", privacy: .public)")
+        }
+        guard windowPinned, let window = view.window, let space = panelLayout.layout.windowSpace,
+              OmniWindowSpaces.space(of: window) != space, OmniWindowSpaces.userSpaces().contains(space) else { return }
+        omniWindowFrameLog.notice("move to space \(space, privacy: .public)")
+        OmniWindowSpaces.move(window, to: space)
+    }
+
+    // Unpinned, showing brings the window to the person's Space. Ordering it
+    // front with move-to-active-Space does that only for a hidden window; one
+    // still shown on another Space is moved explicitly.
+    @objc func moveWindowToActiveSpace() {
+        guard !windowPinned, let window = view.window, let active = OmniWindowSpaces.activeSpace(),
+              let space = OmniWindowSpaces.space(of: window), space != active,
+              OmniWindowSpaces.userSpaces().contains(active) else { return }
+        omniWindowFrameLog.notice("move from space \(space, privacy: .public) to active \(active, privacy: .public)")
+        OmniWindowSpaces.move(window, to: active)
+    }
+
+    @objc private func togglePinButton(_ sender: Any?) {
+        setWindowPinned(!windowPinned)
+    }
+
+    var windowPinButton: NSButton {
+        return pinButton
+    }
+
+    private func applyWindowPin() {
+        updatePinButton()
+    }
+
+    private func updatePinButton() {
+        let pinned = windowPinned
+        let symbol: SFSymbol = pinned ? .pinFill : .pin
+        let label = pinned ? "Unpin the window from this Space" : "Pin the window to this Space"
+        pinButton.image = NSImage(systemSymbolName: symbol.rawValue, accessibilityDescription: label)
+        pinButton.contentTintColor = pinned ? OmniTheme.accent : OmniTheme.secondaryText
+        pinButton.toolTip = pinned
+            ? "Pinned to this Space: opening OmniTerm switches here. Click to unpin."
+            : "Pin the window to this Space: opening OmniTerm will switch here"
+        pinButton.setAccessibilityLabel(label)
+    }
+
+    // The screen holding most of the pinned frame, nil when none does.
+    private static func screen(holding frame: NSRect) -> NSScreen? {
+        var best: (screen: NSScreen, area: CGFloat)?
+        for screen in NSScreen.screens {
+            let overlap = screen.frame.intersection(frame)
+            let area = overlap.isNull ? 0 : overlap.width * overlap.height
+            if area > 0, area > (best?.area ?? 0) {
+                best = (screen, area)
+            }
+        }
+        return best?.screen
+    }
