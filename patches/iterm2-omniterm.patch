+
+    private func requestProjects() {
+        guard mode == .projects || !sessionQuery.isEmpty, !projectsRequestInFlight else { return }
+        if forgeProjects.isEmpty {
+            forgeProjects = OmniProjectsCache.load()
+        }
+        projectsRequestInFlight = true
+        OmniSchedulerClient.request(["op": "list_projects"]) { [weak self] response in
+            guard let self else { return }
+            self.projectsRequestInFlight = false
+            guard response["ok"] as? Bool == true else { return }
+            self.forgeProjects = response["projects"] as? [[String: Any]] ?? []
+            self.rebuild()
+        }
+    }
+
+    private func requestSchedulerState() {
+        requestSessions()
+        requestProjects()
+        if !agentsRequestInFlight {
+            agentsRequestInFlight = true
+            OmniSchedulerClient.request(["op": "list_agents"]) { [weak self] response in
+                guard let self else { return }
+                self.agentsRequestInFlight = false
+                guard response["ok"] as? Bool == true else { return }
+                self.agents = response["agents"] as? [[AnyHashable: Any]] ?? []
+                self.rebuild()
+            }
+        }
+        OmniSchedulerClient.request(["op": "get_settings"]) { [weak self] response in
+            guard let self, response["ok"] as? Bool == true,
+                  let settings = response["settings"] as? [AnyHashable: Any] else { return }
+            // Read once: later reads could undo a change still being saved.
+            if !self.restoredPanelLayout {
+                self.restoredPanelLayout = true
+                self.panelLayout.restore(OmniPanelLayout(stored: settings["layout"] as? [AnyHashable: Any]))
+                // Shown before the settings arrived: the stored frame now.
+                if let window = self.view.window, self.windowShownSinceLaunch, !self.appliedStoredWindowFrame {
+                    self.restoreWindowFrame(on: window.screen, centered: false)
+                }
+            }
+            let groups = settings["sidebar_groups"] as? [String] ?? []
+            self.projectLayout = OmniProjectLayout(settings["projects"])
+            self.sessionLayout = OmniProjectLayout(settings["session_folders"])
+            let order = settings["sidebar_order"] as? [String] ?? []
+            let appearanceChanged = self.readAgentFolderAppearance(settings)
+            guard groups != self.configuredGroups || order != self.sidebarOrder || appearanceChanged else { return }
+            self.configuredGroups = groups
+            self.sidebarOrder = order
+            self.rebuild()
+        }
+        OmniSchedulerClient.request(["op": "notifications", "limit": 1]) { [weak self] response in
+            guard let self, response["ok"] as? Bool == true else { return }
+            let unread = (response["unread_count"] as? NSNumber)?.intValue ?? 0
+            let attention = (response["attention_count"] as? NSNumber)?.intValue ?? 0
+            guard unread != self.inboxUnread || attention != self.inboxAttention else { return }
+            self.inboxUnread = unread
+            self.inboxAttention = attention
+            self.rebuild()
+        }
+        if !runsRequestInFlight {
+            runsRequestInFlight = true
+            // Every live run, however old, so a live tab never loses its status; the
+            // limit is for finished ones, without OmniTerm's background agents.
+            OmniSchedulerClient.request(["op": "list_runs", "limit": Self.recentRunLimit,
+                                         "include_live": true, "foreground": true, "loop_turns": 2]) { [weak self] response in
+                guard let self else { return }
+                self.runsRequestInFlight = false
+                guard response["ok"] as? Bool == true else { return }
+                let rows = response["runs"] as? [[AnyHashable: Any]] ?? []
+                self.recentRuns = rows.compactMap(OmniRun.init)
+                self.rebuild()
+            }
+        }
+    }
+
+    private static func environment(_ session: PTYSession?, _ key: String) -> String? {
+        guard let value = session?.environment?[key] as? String, !value.isEmpty else { return nil }
+        return value
+    }
+
+    // A live tab of one of OmniTerm's own background agents.
+    static func isBackgroundRunTab(_ tab: PTYTab, backgroundAgents: Set<String>) -> Bool {
+        guard !backgroundAgents.isEmpty else { return false }
+        return (tab.sessions() ?? []).contains { session in
+            environment(session, "OMNITERM_KIND") == "run" &&
+                environment(session, "OMNITERM_AGENT").map(backgroundAgents.contains) == true
+        }
+    }
+
+    private static func kinds(_ tab: PTYTab) -> [String] {
+        return (tab.sessions() ?? []).compactMap { environment($0, "OMNITERM_KIND") }
+    }
+
+    private func runTab(_ runID: String) -> PTYTab? {
+        return terminal?.tabs()?.first { tab in
+            (tab.sessions() ?? []).contains { Self.environment($0, "OMNITERM_RUN_ID") == runID }
+        }
+    }
+
+    // The agent's newest live run tab, found through its run (the tab's
+    // agent name is stale after a rename).
+    private func agentTab(_ name: String) -> PTYTab? {
+        let runsByID = Dictionary(recentRuns.map { ($0.id, $0) }, uniquingKeysWith: { first, _ in first })
+        return terminal?.tabs()?.last { tab in
+            (tab.sessions() ?? []).contains { session in
+                guard Self.environment(session, "OMNITERM_KIND") == "run" else { return false }
+                if let runID = Self.environment(session, "OMNITERM_RUN_ID"), let run = runsByID[runID] {
+                    return run.agent == name
+                }
+                return Self.environment(session, "OMNITERM_AGENT") == name
+            }
+        }
+    }
+
+    // The tab the card's terminal band shows: its previewed run's, or before
+    // the card knows its runs, the route's live tab.
+    private func cardTab() -> PTYTab? {
+        guard let card = contentHost.card else { return nil }
+        if let runID = card.previewRunID {
+            return runTab(runID)
+        }
+        return liveTab(for: card.route)
+    }
+
+    private func liveTab(for route: OmniPaneRoute?) -> PTYTab? {
+        switch route {
+        case .agent(let name): return agentTab(name)
+        case .run(let id): return runTab(id)
+        case .session(let id): return sessionTab(id)
+        case .overview, .group, .inbox, .memory, .settings, .unblocker, .projects, .project, .search, nil: return nil
+        }
+    }
