+    XCTSkipUnless(data != nil, @"%@ is not there yet", path);
+    NSDictionary *fixture = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    XCTAssertTrue([fixture isKindOfClass:[NSDictionary class]]);
+    [self startSchedulerWithAgentTimeout:@7200];
+    for (NSString *field in @[ @"group", @"icon", @"color" ]) {
+        for (id value in fixture[field][@"valid"]) {
+            NSDictionary *response = [self request:@{ @"op": @"set_agent_appearance", @"name": @"Review", field: value }];
+            XCTAssertEqualObjects(response[@"ok"], @YES, @"%@ %@ should be valid", field, value);
+        }
+        for (id value in fixture[field][@"invalid"]) {
+            NSDictionary *response = [self request:@{ @"op": @"set_agent_appearance", @"name": @"Review", field: value }];
+            XCTAssertEqualObjects(response[@"code"], @"invalid_appearance", @"%@ %@ should be invalid", field, value);
+        }
+    }
+    for (NSArray *pair in fixture[@"group_normalized"]) {
+        NSDictionary *response = [self request:@{ @"op": @"set_agent_appearance", @"name": @"Review", @"group": pair[0] }];
+        XCTAssertEqualObjects(response[@"agent"][@"group"], pair[1], @"%@ is stored as %@", pair[0], pair[1]);
+    }
+    NSString *current = @"Review";
+    for (id value in fixture[@"name"][@"valid"]) {
+        NSDictionary *response = [self request:@{ @"op": @"rename_agent", @"name": current, @"new_name": value }];
+        XCTAssertEqualObjects(response[@"ok"], @YES, @"%@ should be a valid name", value);
+        NSString *stored = response[@"agent"][@"name"];
+        XCTAssertEqualObjects(stored, [value stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet]);
+        current = stored ?: current;
+    }
+    XCTAssertEqualObjects(([self request:@{ @"op": @"rename_agent", @"name": current, @"new_name": @"Review" }][@"ok"]), @YES);
+    NSMutableDictionary *template = [[self agentFileNamed:@"Review"] mutableCopy];
