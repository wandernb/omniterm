+#pragma mark - Notification policy
+
+// Whether a notification interrupts the person: a macOS banner, its sound, and
+// whether it raises the menu-bar count. The Inbox stores every notification
+// whatever this says. Rules apply in order: level, then kind, then the
+// agent's override, then mute (which silences banners and sound only).
+static NSDictionary *OmniNotificationAlert(NSDictionary *item, NSDictionary *notificationSettings, NSTimeInterval now) {
+    NSDictionary *settings = OmniValidNotificationSettings(notificationSettings, NO, NULL);
+    NSString *severity = [OmniNotificationLevelNames() containsObject:item[@"severity"]] ? item[@"severity"] : @"attention";
+    NSDictionary *level = settings[@"levels"][severity];
+    BOOL banner = [level[@"banner"] boolValue];
+    BOOL sound = [level[@"sound"] boolValue];
+    BOOL count = [level[@"count"] boolValue];
+    NSString *kind = [item[@"kind"] isKindOfClass:[NSString class]] && [item[@"kind"] length] ? item[@"kind"] : @"agent";
+    NSString *kindRule = settings[@"kinds"][kind] ?: @"follow";
+    if ([kindRule isEqual:@"inbox"]) {
+        banner = sound = count = NO;
+    } else if ([kindRule isEqual:@"always"]) {
+        banner = count = YES;
+    }
+    NSString *agent = [item[@"agent"] isKindOfClass:[NSString class]] ? item[@"agent"] : nil;
+    NSString *agentRule = agent ? settings[@"agents"][agent] : nil;
+    if ([agentRule isEqual:@"inbox"] || ([agentRule isEqual:@"urgent"] && ![severity isEqual:@"urgent"])) {
+        banner = sound = count = NO;
+    }
+    id mutedUntil = settings[@"muted_until"];
+    const BOOL muted = [mutedUntil isEqual:@"forever"] || (OmniIsWholeNumber(mutedUntil) && [mutedUntil doubleValue] > now);
+    if (muted) {
+        banner = sound = NO;
+    }
+    const BOOL audible = banner && sound;
+    return @{ @"banner": @(banner), @"sound": @(audible), @"count": @(count), @"muted": @(muted) };
+}
+
+static BOOL OmniNotificationsMuted(NSDictionary *notificationSettings, NSTimeInterval now) {
+    id mutedUntil = notificationSettings[@"muted_until"];
+    return [mutedUntil isEqual:@"forever"] || (OmniIsWholeNumber(mutedUntil) && [mutedUntil doubleValue] > now);
+}
+
++ (NSDictionary *)notificationAlertForItem:(NSDictionary *)item settings:(NSDictionary *)settings now:(NSTimeInterval)now {
+    return OmniNotificationAlert(item, settings, now);
+}
+
++ (BOOL)notificationsMutedInSettings:(id)notificationSettings now:(NSTimeInterval)now {
+    if (![notificationSettings isKindOfClass:[NSDictionary class]]) return NO;
+    return OmniNotificationsMuted(notificationSettings, now);
+}
+
+- (BOOL)notificationsMuted {
+    return [OmniScheduler notificationsMutedInSettings:[self settings][@"notifications"]
+                                                   now:[[NSDate date] timeIntervalSince1970]];
+}
