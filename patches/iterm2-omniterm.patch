+// Selects on the first click even while the window is not key. A click
+// gives the sidebar keyboard focus, as in Finder and Mail; Tab or Return
+// hands it to the page or terminal.
+private final class OmniSidebarOutlineView: NSOutlineView {
+    // The sidebar's own keys; false sends the key on to the outline view.
+    var keyHandler: ((NSEvent) -> Bool)?
+
+    override func acceptsFirstMouse(for event: NSEvent?) -> Bool {
+        return true
+    }
+
+    override func becomeFirstResponder() -> Bool {
+        let became = super.becomeFirstResponder()
+        omniSidebarKeysLog.notice("outline becomeFirstResponder -> \(became, privacy: .public)")
+        return became
+    }
+
+    override func resignFirstResponder() -> Bool {
+        // A tab selected from here must not take the keyboard (OmniFocusHold).
+        if OmniFocusHold.isHolding {
+            omniSidebarKeysLog.notice("outline resignFirstResponder refused: tab selected from the sidebar")
+            return false
+        }
+        let resigned = super.resignFirstResponder()
+        omniSidebarKeysLog.notice("outline resignFirstResponder -> \(resigned, privacy: .public)")
+        return resigned
+    }
+
+    override func keyDown(with event: NSEvent) {
+        if keyHandler?(event) == true {
+            return
+        }
+        super.keyDown(with: event)
+    }
+
+    override func performKeyEquivalent(with event: NSEvent) -> Bool {
+        if window?.firstResponder === self, keyHandler?(event) == true {
