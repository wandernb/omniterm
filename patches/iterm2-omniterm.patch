+// A sidebar row: the rounded hover fill under the pointer, inset like the
+// selection, on every row a person can select.
+private final class OmniSidebarRowView: NSTableRowView {
+    // Its buttons get the pointing hand as they are added.
+    override func didAddSubview(_ subview: NSView) {
+        super.didAddSubview(subview)
+        OmniPointer.install(in: subview)
+    }
+
+    private var hoverArea: NSTrackingArea?
+
+    override func resetCursorRects() {
+        addCursorRect(bounds, cursor: .pointingHand)
+    }
+    var isHovered = false {
+        didSet {
+            if isHovered != oldValue {
+                needsDisplay = true
+            }
+        }
+    }
+
+    // One row is hovered at a time: AppKit misses an exit when rows reload,
+    // scroll or are reused under a still pointer, which left fills behind.
+    private static weak var hovered: OmniSidebarRowView?
+
+    override func updateTrackingAreas() {
+        super.updateTrackingAreas()
+        if let hoverArea {
+            removeTrackingArea(hoverArea)
+        }
+        let area = NSTrackingArea(rect: .zero, options: [.mouseEnteredAndExited, .activeInKeyWindow, .inVisibleRect],
+                                  owner: self, userInfo: nil)
+        addTrackingArea(area)
+        hoverArea = area
+        syncHoverWithPointer()
+    }
+
+    // Whether the pointer is really over this row now.
+    private func syncHoverWithPointer() {
+        guard let window, window.isKeyWindow, !isHidden else {
+            setHovered(false)
+            return
+        }
+        let point = convert(window.mouseLocationOutsideOfEventStream, from: nil)
+        setHovered(visibleRect.contains(point))
+    }
+
+    private func setHovered(_ hovered: Bool) {
+        if hovered {
+            if let other = Self.hovered, other !== self {
+                other.isHovered = false
+            }
+            Self.hovered = self
+        } else if Self.hovered === self {
+            Self.hovered = nil
+        }
+        isHovered = hovered
+    }
+
+    override func mouseEntered(with event: NSEvent) {
+        setHovered(true)
+    }
+
+    override func mouseExited(with event: NSEvent) {
+        setHovered(false)
+    }
+
+    override func prepareForReuse() {
+        super.prepareForReuse()
+        setHovered(false)
+    }
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        if window == nil {
+            setHovered(false)
+        }
+    }
+
+    // The top group's rows share one lighter, rounded panel; each row
+    // draws its slice of it.
+    enum PanelEdge { case top, middle, bottom }
+    var panelEdge: PanelEdge?
+    // A session row's project colour, as a short bar in the leading margin.
+    var accent: NSColor?
+
+    override func drawBackground(in dirtyRect: NSRect) {
+        super.drawBackground(in: dirtyRect)
+        if let accent {
+            accent.setFill()
+            NSBezierPath(roundedRect: NSRect(x: bounds.minX + 4, y: bounds.minY + 7, width: 3, height: max(0, bounds.height - 14)),
+                         xRadius: 1.5, yRadius: 1.5).fill()
+        }
+        if let panelEdge {
+            let sidebar = OmniTheme.Sidebar.self
+            var rect = bounds.insetBy(dx: sidebar.panelInsetX, dy: 0)
+            let radius = sidebar.panelCornerRadius
+            // Extend past the edge that joins the next row, so only the
+            // panel's outer corners show rounded.
+            switch panelEdge {
+            case .middle: rect = rect.insetBy(dx: 0, dy: -radius)
+            case .top:
+                rect.size.height += radius
+                if !isFlipped { rect.origin.y -= radius }
+            case .bottom:
+                rect.size.height += radius
+                if isFlipped { rect.origin.y -= radius }
+            }
+            sidebar.panelFill.setFill()
+            NSBezierPath(roundedRect: rect, xRadius: radius, yRadius: radius).fill()
+        }
+        guard isHovered, !isSelected else { return }
+        let sidebar = OmniTheme.Sidebar.self
+        OmniTheme.Sidebar.hover.setFill()
+        NSBezierPath(roundedRect: bounds.insetBy(dx: sidebar.rowInsetX, dy: 0), xRadius: sidebar.rowCornerRadius,
+                     yRadius: sidebar.rowCornerRadius).fill()
+    }
+}
