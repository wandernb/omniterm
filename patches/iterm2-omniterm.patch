+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+// Opens a run's tab. Called on the main thread, asynchronously. A background
+// run (OmniTerm's own housekeeping agents) opens without being selected, so it
+// never takes the window away from what the person is looking at.
+typedef void (^OmniSchedulerLaunchHandler)(NSString *command, NSString *title, NSString *runID, NSString *agent, BOOL background);
+
+// What one background indexing tick is admitted to do (OmniKnowledgeTickBudget).
+typedef struct {
+    const char *tier;       // "interactive", "idle" or "pressure"
+    NSInteger scans;        // scan passes; 0 delivers session messages only
+    NSUInteger writeBytes;  // serialized background writes saved per tick
+    double workSeconds;     // soft budget: no further maintenance starts once spent
+    BOOL embed;             // embedding admitted
+    BOOL maintenance;       // memory tick and incremental vacuum admitted
+} OmniKnowledgeBudget;
+
+// embedRequest carries idle_seconds, on_ac, low_power and thermal_state;
+// memoryPressure is 0 (normal), 1 (warning) or 2 (critical); resumed is true
+// on the first tick after a long gap, such as a wake from sleep.
+OmniKnowledgeBudget OmniKnowledgeTickBudget(NSDictionary *embedRequest, NSInteger memoryPressure, BOOL resumed);
+
+@interface OmniScheduler : NSObject
+
+- (instancetype)initWithLaunchHandler:(OmniSchedulerLaunchHandler)launchHandler;
+- (void)start;
+- (void)stop;
+- (void)checkNow;
+- (NSDictionary *)currentSettings;
+- (BOOL)updateSettings:(NSDictionary *)changes error:(NSError **)error;
+
+// Called on the main thread, asynchronously, whenever stored notifications change.
+@property(nonatomic, copy, nullable) void (^notificationsChangedHandler)(void);
+
+// Called on the main thread, asynchronously, after `set_settings` changes the
+// stored settings, so the app can apply them.
+@property(nonatomic, copy, nullable) void (^settingsChangedHandler)(void);
+
+// Whether a notification banners, plays a sound and raises the menu-bar count
+// under the given `notifications` settings. Keys: banner, sound, count, muted.
++ (NSDictionary *)notificationAlertForItem:(NSDictionary *)item settings:(NSDictionary *)settings now:(NSTimeInterval)now;
+
+// Whether `notifications.muted_until` mutes OmniTerm at `now`. Anything that is
+// not a notifications dictionary is not muted.
++ (BOOL)notificationsMutedInSettings:(nullable id)notificationSettings now:(NSTimeInterval)now;
+
+// The same, read from the stored settings now. Safe to call from any thread.
+- (BOOL)notificationsMuted;
+
+// Called on the main thread, asynchronously, to open the Inbox, optionally
+// selecting one notification.
+@property(nonatomic, copy, nullable) void (^showInboxHandler)(NSString *_Nullable notificationID);
+
+// Called on the main thread, asynchronously, when a run's agent finishes a
+// turn, so the app can snapshot the run's terminal.
+@property(nonatomic, copy, nullable) void (^runScreenRequestHandler)(NSString *runID);
+// Returns whether input was written to an untouched managed run, on the main thread.
+@property(nonatomic, copy, nullable) BOOL (^runInputHandler)(NSString *runID, NSString *text);
+
+// Stores the last screen of a run's terminal (text with SGR colour sequences),
+// replacing any earlier one. Safe to call from any thread.
+- (void)storeScreen:(NSString *)screen truncated:(BOOL)truncated forRun:(NSString *)runID;
+
+// Runs a socket-style request on the scheduler queue and calls completion on the
+// main thread. In-app clients use this so they go through the same validation.
+- (void)performRequest:(NSDictionary *)request completion:(void (^)(NSDictionary *response))completion;
+
+@end
+
+NS_ASSUME_NONNULL_END
