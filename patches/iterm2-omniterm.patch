+import AppKit
+import Foundation
+
+// Every OmniTerm shortcut, grouped, in a sheet on the terminal window. The
+// list mirrors the key handling in the sidebar, the focus zones, the content
+// host, the Inbox and the editors; change both together.
+final class OmniKeyboardMap: NSWindowController {
+    struct Shortcut: Equatable {
+        let keys: String
+        let action: String
+    }
+
+    struct Group: Equatable {
+        let title: String
+        let shortcuts: [Shortcut]
+    }
+
+    static let groups: [Group] = [
+        Group(title: "Sidebar", shortcuts: [
+            Shortcut(keys: "↑ ↓", action: "Move between rows"),
+            Shortcut(keys: "→", action: "Open a folder, or go into the page"),
+            Shortcut(keys: "←", action: "Close a folder, or go to its folder"),
+            Shortcut(keys: "Tab", action: "Go into the page"),
+            Shortcut(keys: "⌥⌘↑ ⌥⌘↓", action: "Move the agent or folder"),
+            Shortcut(keys: "⌘I", action: "Icon and colour of the agent"),
+            Shortcut(keys: "⌘N", action: "New agent"),
+            Shortcut(keys: "⇧⌘N", action: "New folder"),
+        ]),
+        // What Return does on each kind of row (the sidebar's handleSidebarKey
+        // and focusContent): a run's terminal is focused while its page shows
+        // the terminal band; a finished run has none, so its page is entered.
+        Group(title: "Return in the sidebar", shortcuts: [
+            Shortcut(keys: "Agent, folder", action: "Rename it"),
+            Shortcut(keys: "Run", action: "Focus its terminal, else go into its page"),
+            Shortcut(keys: "Terminal", action: "Focus the terminal"),
+            Shortcut(keys: "Other rows", action: "Go into the Dashboard, Inbox or Memory"),
+        ]),
+        Group(title: "Pages", shortcuts: [
+            Shortcut(keys: "↑ ↓", action: "Move through a list"),
+            Shortcut(keys: "← →", action: "Move between buttons"),
+            Shortcut(keys: "Return", action: "Open the row or press the button"),
+            Shortcut(keys: "Space", action: "Press the button"),
+            Shortcut(keys: "Tab ⇧Tab", action: "Next or previous part of the page"),
+            Shortcut(keys: "Esc", action: "Back to the sidebar"),
+        ]),
+        Group(title: "Window", shortcuts: [
+            Shortcut(keys: "⌘K", action: "Quick navigation: search and go anywhere"),
+            Shortcut(keys: "⌘F", action: "Search everything from the sidebar (Return: all results)"),
+            Shortcut(keys: "⌘,", action: "OmniTerm Settings"),
+            Shortcut(keys: "⌃⌘S", action: "Focus the sidebar"),
+            Shortcut(keys: "⇧⌘1 ⇧⌘2 ⇧⌘3", action: "Sidebar: Projects, Sessions or Agents"),
+            Shortcut(keys: "⌃⌘1", action: "Show or hide the sidebar"),
+            Shortcut(keys: "⌃⌘2", action: "Show or hide the runs and settings"),
+            Shortcut(keys: "⌃⌘3", action: "Show or hide the terminal band"),
+            Shortcut(keys: "⌃⌘4", action: "Show or hide the diff"),
+            Shortcut(keys: "⌃⌘Return", action: "Expand a page’s terminal, or restore the page"),
+            Shortcut(keys: "⌘W", action: "On a page, hide the window"),
+            Shortcut(keys: "⌘Q", action: "Hide the windows (quit from the menu-bar item)"),
+        ]),
+        Group(title: "Inbox", shortcuts: [
+            Shortcut(keys: "⇧⌘U", action: "Mark as read or unread"),
+            Shortcut(keys: "⌘O", action: "Resume the run"),
+            Shortcut(keys: "⌘⌫", action: "Delete the item"),
+            Shortcut(keys: "⌘W", action: "Close the Inbox window"),
+        ]),
+        Group(title: "Agent editor", shortcuts: [
+            Shortcut(keys: "⌘B ⌘I", action: "Bold or italic"),
+            Shortcut(keys: "⌘K", action: "Link"),
+            Shortcut(keys: "Return", action: "Continue a list, or end it on an empty item"),
+            Shortcut(keys: "Tab ⇧Tab", action: "Indent or outdent list items"),
+            Shortcut(keys: "⌘Return", action: "Save"),
+            Shortcut(keys: "Esc", action: "Cancel"),
+        ]),
+        Group(title: "This map", shortcuts: [
+            Shortcut(keys: "⌘/ ?", action: "Open, from the sidebar or a page (⌘/ anywhere in the window)"),
+            Shortcut(keys: "Esc ⌘/ ?", action: "Close"),
+        ]),
+    ]
+
+    // One map per window; showing it again closes it.
+    private static var presented: [ObjectIdentifier: OmniKeyboardMap] = [:]
+    private weak var parentWindow: NSWindow?
+
+    static func isShown(for window: NSWindow) -> Bool {
+        return presented[ObjectIdentifier(window)] != nil
+    }
+
+    // Shows the map as a sheet on `window`, or closes it if it is up.
+    static func show(for window: NSWindow) {
+        if let map = presented[ObjectIdentifier(window)] {
+            map.dismiss()
+            return
+        }
+        let map = OmniKeyboardMap(parent: window)
+        presented[ObjectIdentifier(window)] = map
+        guard let panel = map.window else { return }
+        window.beginSheet(panel) { _ in
+            presented.removeValue(forKey: ObjectIdentifier(window))
+        }
+    }
+
+    static func dismiss(for window: NSWindow) {
+        presented[ObjectIdentifier(window)]?.dismiss()
+    }
+
+    private init(parent: NSWindow) {
+        parentWindow = parent
+        let content = OmniKeyboardMapView(groups: Self.groups)
+        let size = content.preferredSize
+        let panel = OmniKeyboardMapPanel(contentRect: NSRect(origin: .zero, size: size), styleMask: [.titled],
+                                         backing: .buffered, defer: false)
+        panel.contentView = content
+        super.init(window: panel)
+        panel.dismissMap = { [weak self] in self?.dismiss() }
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    private func dismiss() {
+        guard let panel = window, let parentWindow else { return }
+        Self.presented.removeValue(forKey: ObjectIdentifier(parentWindow))
+        parentWindow.endSheet(panel)
+    }
+}
+
+// Esc, ⌘/ and ? close the map; it takes no other keys.
+private final class OmniKeyboardMapPanel: NSPanel {
+    var dismissMap: (() -> Void)?
+
+    override var canBecomeKey: Bool { true }
+
+    override func cancelOperation(_ sender: Any?) {
+        dismissMap?()
+    }
+
+    override func performKeyEquivalent(with event: NSEvent) -> Bool {
+        let modifiers = event.modifierFlags.intersection([.command, .option, .control, .shift])
+        if modifiers == .command, event.charactersIgnoringModifiers == "/" {
+            dismissMap?()
+            return true
+        }
+        return super.performKeyEquivalent(with: event)
+    }
+
+    override func keyDown(with event: NSEvent) {
+        if event.characters == "?" {
+            dismissMap?()
+            return
+        }
+        super.keyDown(with: event)
+    }
+}
+
+// The groups in two columns: keys right-aligned, then what they do.
+private final class OmniKeyboardMapView: NSView {
+    private static let keysWidth: CGFloat = 96
+    private static let actionWidth: CGFloat = 280
+    private static let columnGap: CGFloat = 32
+    private static let rowHeight: CGFloat = 19
+    private static let inset = OmniTheme.Metrics.pageInset
+
+    private let title = OmniTheme.title("Keyboard Shortcuts")
+    private var columns: [[(header: NSTextField, rows: [(keys: NSTextField, action: NSTextField)])]] = [[], []]
+
+    override var isFlipped: Bool { true }
+
+    init(groups: [OmniKeyboardMap.Group]) {
+        super.init(frame: .zero)
+        addSubview(title)
+        // Fill the left column first, then the right, keeping them about even.
+        let total = groups.reduce(0) { $0 + $1.shortcuts.count + 2 }
+        var leftCount = 0
+        for group in groups {
+            let header = OmniTheme.sectionHeader(group.title)
+            addSubview(header)
+            let rows = group.shortcuts.map { shortcut -> (keys: NSTextField, action: NSTextField) in
+                let keys = NSTextField(labelWithString: shortcut.keys)
+                keys.font = OmniTheme.Font.rowTitleEmphasized
+                keys.alignment = .right
+                let action = NSTextField(labelWithString: shortcut.action)
+                action.font = OmniTheme.Font.rowTitle
+                action.textColor = OmniTheme.secondaryText
+                action.lineBreakMode = .byTruncatingTail
+                addSubview(keys)
+                addSubview(action)
+                return (keys, action)
+            }
+            let column = leftCount * 2 < total ? 0 : 1
+            if column == 0 {
+                leftCount += group.shortcuts.count + 2
+            }
+            columns[column].append((header, rows))
+        }
+        setFrameSize(preferredSize)
+        layoutContent()
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    private static var columnWidth: CGFloat {
+        return keysWidth + 12 + actionWidth
+    }
+
+    private func columnHeight(_ column: Int) -> CGFloat {
+        return columns[column].reduce(0) { $0 + 16 + 6 + CGFloat($1.rows.count) * Self.rowHeight + OmniTheme.Metrics.sectionGap }
+    }
+
+    var preferredSize: NSSize {
+        let width = Self.inset * 2 + Self.columnWidth * 2 + Self.columnGap
+        let height = Self.inset + 30 + 16 + max(columnHeight(0), columnHeight(1)) + Self.inset - OmniTheme.Metrics.sectionGap
+        return NSSize(width: width, height: ceil(height))
+    }
+
+    private func layoutContent() {
+        title.frame = NSRect(x: Self.inset, y: Self.inset - 6, width: bounds.width - 2 * Self.inset, height: 30)
+        for (index, groups) in columns.enumerated() {
+            let x = Self.inset + CGFloat(index) * (Self.columnWidth + Self.columnGap)
+            var y = Self.inset + 30 + 16
+            for group in groups {
+                group.header.frame = NSRect(x: x + Self.keysWidth + 12, y: y, width: Self.actionWidth, height: 16)
+                y += 16 + 6
+                for row in group.rows {
+                    row.keys.frame = NSRect(x: x, y: y, width: Self.keysWidth, height: Self.rowHeight - 2)
+                    row.action.frame = NSRect(x: x + Self.keysWidth + 12, y: y, width: Self.actionWidth,
+                                              height: Self.rowHeight - 2)
+                    y += Self.rowHeight
+                }
+                y += OmniTheme.Metrics.sectionGap
+            }
+        }
+    }
+}
