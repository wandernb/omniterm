+++ b/ModernTests/OmniInboxViewControllerTests.swift
@@ -0,0 +1,549 @@
+//
+//  OmniInboxViewControllerTests.swift
+//  ModernTests
+//
+//  The Inbox's content against a fake scheduler: its read toggle, and that it
+//  loads when embedded in a plain view as well as in its own window.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniInboxViewControllerTests: XCTestCase {
+    private var requests: [[String: Any]] = []
+
+    override func setUp() {
+        super.setUp()
+        requests = []
+        let notifications: [[String: Any]] = [
+            ["id": "n1", "title": "First", "body": "One", "unread": true, "updated": 1_800_000_600,
+             "agent": "builder", "severity": "urgent"],
+            ["id": "n2", "title": "Second", "body": "Two", "unread": false, "updated": 1_800_000_000],
+        ]
+        OmniSchedulerClient.testTransport = { [unowned self] request, completion in
+            self.requests.append(request)
+            let response: [AnyHashable: Any]
+            switch request["op"] as? String {
+            case "notifications":
+                response = ["ok": true, "notifications": notifications, "unread_count": 1]
+            case "list_agents":
+                response = ["ok": true, "agents": [["name": "builder", "icon": "emoji:🔧", "color": "blue"]]]
+            default:
+                response = ["ok": true]
+            }
+            DispatchQueue.main.async {
+                completion(response)
+            }
+        }
+    }
+
+    override func tearDown() {
+        OmniSchedulerClient.testTransport = nil
+        OmniInboxWindowController.shared.window?.orderOut(nil)
+        super.tearDown()
+    }
+
+    private func wait(_ message: String, until condition: () -> Bool) {
+        let deadline = Date().addingTimeInterval(5)
+        while !condition() && Date() < deadline {
+            RunLoop.main.run(mode: .default, before: Date().addingTimeInterval(0.01))
+        }
+        XCTAssertTrue(condition(), message)
+    }
+
+    private static func find<T: NSView>(_ type: T.Type, in view: NSView, where test: (T) -> Bool = { _ in true }) -> T? {
+        if let match = view as? T, test(match) {
+            return match
+        }
+        for subview in view.subviews {
+            if let match = find(type, in: subview, where: test) {
+                return match
+            }
+        }
+        return nil
+    }
+
+    private func readRequests() -> [[String: Any]] {
+        return requests.filter { $0["op"] as? String == "notification_read" }
+    }
+
+    // A pane can host the Inbox: it loads and works outside its own window.
+    func testEmbedsInAPlainViewAndLoads() throws {
+        let window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 900, height: 600), styleMask: [.titled],
+                              backing: .buffered, defer: true)
+        window.isReleasedWhenClosed = false
+        defer { window.close() }
+        let host = NSView(frame: NSRect(x: 0, y: 0, width: 900, height: 600))
+        window.contentView = host
+        let inbox = OmniInboxViewController()
+        var summaries: [String] = []
+        inbox.summaryDidChange = { summaries.append($0) }
+        inbox.view.frame = host.bounds
+        host.addSubview(inbox.view)
+
+        inbox.select("n2")
+        let table = try XCTUnwrap(Self.find(NSTableView.self, in: host))
+        wait("the notifications load") { table.numberOfRows == 2 }
+        XCTAssertEqual(table.selectedRow, 1, "the requested notification is selected")
+        XCTAssertEqual(summaries.last, "1 unread")
+        XCTAssertNotNil(Self.find(NSTextField.self, in: host) {
+            $0.stringValue == "Second" && $0.font == OmniTheme.Font.title && !$0.isHiddenOrHasHiddenAncestor
+        }, "its detail shows the title")
+        wait("the agents load") { self.requests.contains { $0["op"] as? String == "list_agents" } }
+    }
+
+    // On a narrow window the toolbar's controls never overlap.
+    func testToolbarControlsDoNotOverlapWhenNarrow() throws {
+        for width in [560.0, 680.0, 820.0, 1200.0] {
+            let host = NSView(frame: NSRect(x: 0, y: 0, width: width, height: 500))
+            let inbox = OmniInboxViewController()
+            inbox.view.frame = host.bounds
+            host.addSubview(inbox.view)
+            inbox.view.resizeSubviews(withOldSize: .zero)
+            let barHeight = OmniTheme.Metrics.barHeight
+            let toolbar: [NSControl] = Self.findAll(in: inbox.view).compactMap { view in
+                guard let control = view as? NSControl, !control.isHiddenOrHasHiddenAncestor,
+                      control.frame.width > 0, let bar = control.superview,
+                      bar.frame.minY == 0, bar.frame.height == barHeight else { return nil }
+                return control
+            }
+            XCTAssertGreaterThanOrEqual(toolbar.count, 2)
+            for (index, first) in toolbar.enumerated() {
+                for second in toolbar.dropFirst(index + 1) {
+                    XCTAssertFalse(first.frame.intersects(second.frame), "\(first) overlaps \(second) at \(width)")
+                }
+                XCTAssertLessThanOrEqual(first.frame.maxX, width, "\(first) runs off at \(width)")
+            }
+        }
+    }
+
+    private static func findAll(in view: NSView) -> [NSView] {
+        return view.subviews + view.subviews.flatMap { findAll(in: $0) }
+    }
+
+    // The button says what it will do, and does it.
+    func testReadToggleSendsWhatTheButtonSays() throws {
+        let content = try XCTUnwrap(OmniInboxWindowController.shared.window?.contentView)
+        OmniInboxWindowController.shared.reload()
+        let table = try XCTUnwrap(Self.find(NSTableView.self, in: content))
+        wait("the notifications load") { table.numberOfRows == 2 }
+
+        table.selectRowIndexes(IndexSet(integer: 1), byExtendingSelection: false)
+        requests = []
+        let markUnread = try XCTUnwrap(Self.find(NSButton.self, in: content) { $0.title == "Mark as Unread" })
+        markUnread.performClick(nil)
+        XCTAssertEqual(readRequests().last?["id"] as? String, "n2")
+        XCTAssertEqual(readRequests().last?["read"] as? Bool, false, "Mark as Unread marks it unread")
+
+        table.selectRowIndexes(IndexSet(integer: 0), byExtendingSelection: false)
+        requests = []
+        let markRead = try XCTUnwrap(Self.find(NSButton.self, in: content) { $0.title == "Mark as Read" })
+        markRead.performClick(nil)
+        XCTAssertEqual(readRequests().last?["id"] as? String, "n1")
+        XCTAssertEqual(readRequests().last?["read"] as? Bool, true, "Mark as Read marks it read")
+    }
+
+    // The kind filter asks the scheduler for one kind only.
+    func testKindFilterAsksForOneKind() throws {
+        let content = try XCTUnwrap(OmniInboxWindowController.shared.window?.contentView)
+        OmniInboxWindowController.shared.reload()
+        let table = try XCTUnwrap(Self.find(NSTableView.self, in: content))
+        wait("the notifications load") { table.numberOfRows == 2 }
+        let kinds = try XCTUnwrap(Self.find(NSPopUpButton.self, in: content) { $0.itemTitles.first == "All kinds" })
+        XCTAssertEqual(kinds.numberOfItems, OmniSettingsModel.kinds.count + 1)
+        requests = []
+        kinds.selectItem(withTitle: OmniSettingsModel.kindTitle("wrap_up"))
+        kinds.sendAction(kinds.action, to: kinds.target)
+        wait("a filtered request is sent") { self.requests.contains { $0["op"] as? String == "notifications" } }
+        XCTAssertEqual(requests.last { $0["op"] as? String == "notifications" }?["kind"] as? String, "wrap_up")
+        kinds.selectItem(at: 0)
+        kinds.sendAction(kinds.action, to: kinds.target)
+    }
+}
+
+// The Settings page against a fake scheduler, kept here with the other Omni
+// page tests: its model's mapping, and that a change is one `set_settings`.
+final class OmniSettingsPaneTests: XCTestCase {
+    private var requests: [[String: Any]] = []
+    private var responders: [String: ([String: Any]) -> [AnyHashable: Any]] = [:]
+
+    override func setUp() {
+        super.setUp()
+        requests = []
+        responders = [:]
+        let settings: [String: Any] = [
+            "timezone": "Europe/Paris", "default_timeout_seconds": 7200, "retained_run_tabs": 10,
+            "notifications": ["muted_until": 0,
+                              "levels": ["urgent": ["banner": true, "sound": true, "count": true],
+                                         "attention": ["banner": false, "sound": false, "count": true],
+                                         "info": ["banner": false, "sound": false, "count": false]],
+                              "kinds": ["agent": "follow"], "agents": ["Gone": "inbox"]],
+            "agent_defaults": ["provider": "claude", "overlap": "replace",
+                               "models": ["claude": "", "codex": ""],
+                               "permission_modes": ["claude": "", "codex": ""]],
+        ]
+        OmniSchedulerClient.testTransport = { [unowned self] request, completion in
+            self.requests.append(request)
+            var response: [AnyHashable: Any]
+            switch request["op"] as? String {
+            case let op? where self.responders[op] != nil:
+                response = self.responders[op]!(request)
+            case "get_settings", "set_settings":
+                response = ["ok": true, "settings": settings]
+            case "list_agents":
+                response = ["ok": true, "agents": [["name": "Nightly", "provider": "codex", "model": "gpt-5"]]]
+            default:
+                response = ["ok": true]
+            }
+            DispatchQueue.main.async {
+                completion(response)
+            }
+        }
+    }
+
+    override func tearDown() {
+        OmniSchedulerClient.testTransport = nil
+        super.tearDown()
+    }
+
+    private func wait(_ message: String, until condition: () -> Bool) {
+        let deadline = Date().addingTimeInterval(5)
+        while !condition() && Date() < deadline {
