+// A row of buttons, left to right, with a status message after them.
+final class OmniButtonRow: NSView {
+    let buttons: [NSView]
+    let status = NSTextField(labelWithString: "")
+    let zone = OmniButtonZone()
+
+    override var isFlipped: Bool { true }
+
+    init(_ buttons: [NSView]) {
+        self.buttons = buttons
+        super.init(frame: NSRect(x: 0, y: 0, width: 400, height: 30))
+        for button in buttons {
+            addSubview(button)
+        }
+        status.textColor = OmniTheme.secondaryText
+        status.font = OmniTheme.Font.meta
+        status.lineBreakMode = .byTruncatingTail
+        addSubview(status)
+        zone.buttons = { [weak self] in self?.buttons.compactMap { $0 as? NSButton } ?? [] }
+        addSubview(zone)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    static let lineHeight: CGFloat = 34
+
+    // Button frames for `width`: a button that does not fit starts a new
+    // line, so a narrow pane wraps instead of cutting buttons off.
+    private func arrange(width: CGFloat) -> (frames: [NSRect], end: NSPoint) {
+        var x: CGFloat = -6
+        var line: CGFloat = 0
+        var frames: [NSRect] = []
+        for button in buttons where !button.isHidden {
+            if let control = button as? NSControl {
+                control.sizeToFit()
+            }
+            let padding: CGFloat = (button as? NSButton)?.bezelStyle == .rounded ? 8 : 0
+            let buttonWidth = button.frame.width + padding
+            if x > 0, x + buttonWidth > width {
+                x = -6
+                line += 1
+            }
+            frames.append(NSRect(x: x, y: line * Self.lineHeight + 1, width: buttonWidth, height: 28))
+            x += buttonWidth + 6
+        }
+        return (frames, NSPoint(x: x, y: line * Self.lineHeight))
+    }
+
+    // The height the row needs at `width`: one line per row of buttons.
+    func height(forWidth width: CGFloat) -> CGFloat {
+        let end = arrange(width: width).end
+        return end.y + 30
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let arranged = arrange(width: bounds.width)
+        for (button, frame) in zip(buttons.filter { !$0.isHidden }, arranged.frames) {
+            button.frame = frame
+        }
+        let x = arranged.end.x
+        status.frame = NSRect(x: x + 8, y: arranged.end.y + 7, width: max(40, bounds.width - x - 8), height: 18)
+        zone.frame = bounds
+    }
+}
