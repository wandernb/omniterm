+    // A plain tab in the session's folder running the provider's own resume,
+    // through a login shell so the person's PATH finds it. It is not an
+    // agent run: no prompt, no permission flags.
+    func paneResumeSession(_ session: [AnyHashable: Any]) -> String? {
+        guard let terminal else { return "No OmniTerm window to open it in." }
+        guard let id = session["session_id"] as? String else { return "This session has no ID." }
+        if paneShowTerminal(forSession: id) {
+            return nil
+        }
+        if OmniSessionText.isLive(session) {
+            return "This session is running in another terminal."
+        }
+        let provider = session["provider"] as? String
+        guard let resume = OmniSessionResume.command(provider: provider, rawID: OmniSessionResume.rawID(session)) else {
+            return "This session cannot be resumed from here."
+        }
+        let command = Self.resumeCommandForTesting ?? resume
+        guard var profile = ProfileModel.sharedInstance().defaultProfile() as [AnyHashable: Any]? else {
+            return "No default profile is configured."
+        }
+        let title = OmniSessionText.title(session["title"] as? String)
+        profile[KEY_NAME] = "\(OmniSessionText.providerName(provider)) · \(title)"
+        var isDirectory: ObjCBool = false
+        if let workspace = session["workspace"] as? String, !workspace.isEmpty,
+           FileManager.default.fileExists(atPath: workspace, isDirectory: &isDirectory), isDirectory.boolValue {
+            profile[KEY_CUSTOM_DIRECTORY] = kProfilePreferenceInitialDirectoryCustomValue
+            profile[KEY_WORKING_DIRECTORY] = workspace
+        }
+        // The profile's own custom command is what the login-shell wrapping
+        // applies to; a command passed to the tab call would bypass it.
+        profile[KEY_CUSTOM_COMMAND] = kProfilePreferenceCommandTypeCustomValue
+        profile[KEY_COMMAND_LINE] = command
+        profile[KEY_RUN_COMMAND_IN_LOGIN_SHELL] = true
+        let environment = ["OMNITERM_MANAGED": "1", "OMNITERM_KIND": "session", "OMNITERM_SESSION_ID": id]
+        terminal.asyncCreateTab(withProfile: profile, withCommand: nil, environment: environment, tabIndex: nil,
+                                didMakeSession: { [weak self] _ in
+            // The new tab replaces the page: its terminal takes the window.
+            DispatchQueue.main.async {
+                guard let self else { return }
+                if !self.paneShowTerminal(forSession: id) {
+                    self.tabsDidChange()
+                }
+            }
+        }, completion: nil)
+        return nil
+    }
