+    private lazy var unblockButton = OmniPaneText.button("Auto-Unblock On", target: self, action: #selector(toggleUnblock(_:)))
+    private var autoUnblock = true
+    private lazy var buttons = OmniButtonRow([renameButton, unblockButton, copyButton, memoryButton])
+    // Where a chat app puts its composer: how to continue this session.
+    private let composer = OmniFlippedView()
+    private let composerLabel = NSTextField(labelWithString: "")
+    private static let composerHeight: CGFloat = 46
+    let chat = OmniChatView(frame: NSRect(x: 0, y: 0, width: 800, height: 600))
+    // The system prompt the session ran with, collapsed above the chat.
+    let systemBar = NSButton(title: "", target: nil, action: nil)
+    private let systemPanel = NSScrollView()
+    private let systemText = NSTextView()
+    private(set) var systemPrompt = ""
+    private(set) var systemExpanded = false
+    private static let systemBarHeight: CGFloat = 32
+    private let pagingLabel = NSTextField(labelWithString: "")
+
+    private(set) var session: [AnyHashable: Any] = [:]
+    private(set) var records: [OmniTranscriptRecord] = []
+    // The shown records are [rawStart, rawEnd) of the session's index.
+    private var rawStart = 0
+    private var rawEnd = 0
+    private var hasNewer = false
+    private var loadingOlder = false
+    private var loadingNewer = false
+    private var started = false
+    private var generation = 0
+    private(set) var renaming = false
+    private static let pageSize = 80
+    private let openedAt = Date()
+    private static let headerHeight: CGFloat = 104
+
+    var loadedCount: Int {
