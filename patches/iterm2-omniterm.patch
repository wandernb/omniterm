+        (view as? OmniSidebarView)?.resizeHandle.frame = NSRect(x: max(0, size.width - 5), y: 0, width: 5,
+                                                                height: size.height)
+        // The rows start under the title bar and its hairline.
+        let titleTop = titleBarOverlap + 1
+        layoutTitlebarLine(overlap: titleTop - 1)
+        // The search bar (and the pin) sit on top; the mode switch is a row
+        // of the list, under the shared pages.
+        let headerHidden = scrollView.isHidden
+        sessionSearchField.isHidden = headerHidden
+        pinButton.isHidden = headerHidden
+        optionsButton.isHidden = headerHidden
+        sessionSearchField.frame = NSRect(x: 10, y: titleTop + 6,
+                                          width: max(60, size.width - 25 - 2 * Self.pinButtonWidth),
+                                          height: Self.searchFieldHeight)
+        optionsButton.frame = NSRect(x: sessionSearchField.frame.maxX + 2, y: titleTop + 6 + (Self.searchFieldHeight - 22) / 2,
+                                     width: Self.pinButtonWidth, height: 22)
+        pinButton.frame = NSRect(x: optionsButton.frame.maxX, y: titleTop + 6 + (Self.searchFieldHeight - 22) / 2,
+                                 width: Self.pinButtonWidth, height: 22)
+        // The rows scroll below the search bar, never under it.
+        let bars = headerHidden ? 0 : 6 + Self.searchFieldHeight + Self.searchFieldGap
+        let listTop = bars > 0 ? titleTop + bars : 0
+        scrollView.frame = NSRect(x: 0, y: listTop, width: max(0, size.width - 1), height: max(0, size.height - listTop))
+        let top = bars > 0 ? 0 : titleTop
+        if scrollView.contentInsets.top != top {
+            let atTop = scrollView.contentView.bounds.minY <= -scrollView.contentInsets.top + 0.5
+            scrollView.contentInsets = NSEdgeInsets(top: top, left: 0, bottom: 0, right: 0)
+            if atTop {
+                scrollView.contentView.scroll(to: NSPoint(x: 0, y: -top))
+                scrollView.reflectScrolledClipView(scrollView.contentView)
+            }
+        }
+        revealButton.frame = NSRect(x: 3, y: titleTop + 8, width: 22, height: 22)
+        outlineView.sizeLastColumnToFit()
+    }
+
+    // In the window's root view, beside the content, the line spans both;
+    // when the sidebar is the whole window (tests), it spans the sidebar.
+    private func layoutTitlebarLine(overlap: CGFloat) {
+        guard let window = view.window else { return }
+        let host: NSView = view.superview != nil && view.superview === window.contentView ? view.superview! : view
+        if titlebarLine.superview !== host || host.subviews.last !== titlebarLine {
+            host.addSubview(titlebarLine)
+        }
+        let y = host === view ? overlap : view.frame.maxY - overlap - 1
+        titlebarLine.frame = NSRect(x: 0, y: y, width: max(host.bounds.width, 20000), height: 1)
+    }
+
+    var titlebarSeparatorFrame: NSRect? {
+        guard titlebarLine.superview != nil else { return nil }
+        return titlebarLine.convert(titlebarLine.bounds, to: nil)
+    }
+
+    // How far the sidebar reaches up under the window's title bar. The rows
+    // start below it.
+    private var titleBarOverlap: CGFloat {
+        guard let window = view.window else { return 0 }
+        let frame = view.convert(view.bounds, to: nil)
+        return max(0, (frame.maxY - window.contentLayoutRect.maxY).rounded())
+    }
+
+    // The window's frame when the sidebar moves to it decides the overlap.
+    func relayoutForWindow() {
+        layout(view.bounds.size)
+        observeWindowFrame()
+        applyWindowPin()
+    }
