+    _omniTermGlobalHotKey = [[iTermCarbonHotKeyController sharedInstance]
+        registerShortcut:shortcut
+                  target:self
+                selector:@selector(omniTermGlobalHotKeyPressed:siblings:)
+                userData:nil];
+    if (_omniTermGlobalHotKey) {
+        return YES;
+    }
+    if (oldShortcut.isAssigned) {
+        _omniTermGlobalHotKey = [[iTermCarbonHotKeyController sharedInstance]
+            registerShortcut:oldShortcut
+                      target:self
+                    selector:@selector(omniTermGlobalHotKeyPressed:siblings:)
+                    userData:nil];
+    }
