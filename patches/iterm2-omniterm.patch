+@end
+
+// Comfortably longer than tab creation plus the runner's login-shell PATH lookup.
+static const NSTimeInterval OmniRunnerStartGracePeriod = 120;
+// The outcome of a loop turn that finished before the loop went on to its next turn.
+static NSString *const OmniLoopTurnReason = @"agent finished; the loop went on in the same session";
+// The `omni_managed` value of OmniTerm's own memory consolidator agent.
+static NSString *const OmniMemoryConsolidatorMarker = @"memory_consolidator:v1";
+// The `omni_managed` value of the opt-in session unblocker (helpers/omni_blocks.py).
+static NSString *const OmniSessionUnblockerMarker = @"session_unblocker:v1";
+// How long a session waits before the unblocker answers it: long enough for the
+// person, if present, to reply themselves (helpers/omni_blocks.py UNBLOCK_AFTER).
+static const NSInteger OmniUnblockerMinimumAge = 45;
+// How often the tick asks whether a session waits for the unblocker, and how
+// long one pass may run before it is stopped (six blocks of four minutes, plus slack).
+static const NSTimeInterval OmniUnblockerCheckInterval = 20;
+static const NSTimeInterval OmniUnblockerPassLimit = 30 * 60;
+// A run closed by retention before turns were tracked: its outcome is unknown.
+static NSString *const OmniRetentionUnknownReason = @"retention closed the session; whether the agent had finished was not recorded";
+// The outcome of a run whose agent had finished before retention closed its session.
+static NSString *const OmniRetentionCompletedReason = @"agent finished, then retention closed its session";
+
+// A client that stalls mid-request must not hold a thread indefinitely.
+static const int OmniClientTimeoutSeconds = 5;
+static const NSUInteger OmniKnowledgeFrameLimit = 16 * 1024 * 1024;
