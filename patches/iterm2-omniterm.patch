+    private func renderMemories(_ response: [AnyHashable: Any]) {
+        guard OmniPane.isOK(response) else {
+            memories = []
+            memoryTable.reloadData()
+            showPlaceholder(OmniPane.unreachableMessage(response), in: detailText)
+            return
+        }
+        let loaded = (response["memories"] as? [[AnyHashable: Any]] ?? []).compactMap(OmniMemoryItem.init)
+        let total = OmniMemoryText.number(response["total"]) ?? loaded.count
+        browseCount.stringValue = showingArchived ? (total == 1 ? "1 archived" : "\(total) archived")
+            : (total == 1 ? "1 memory" : "\(total) memories")
+        let archived = OmniMemoryText.number(response["archived_total"]) ?? 0
+        let chipTitle = showingArchived ? "Live memories" : "\(archived) archived"
+        let chipHidden = !showingArchived && archived == 0
+        archivedChip.state = showingArchived ? .on : .off
+        if archivedChip.title != chipTitle || archivedChip.isHidden != chipHidden {
+            archivedChip.title = chipTitle
+            archivedChip.isHidden = chipHidden
+            if isViewLoaded { layout(root.bounds.size) }
+        }
+        guard loaded != memories else { return }
+        memories = loaded
+        memoryTable.reloadData()
+        refreshWorkspaces()
+        if let selectedMemoryID, let row = memories.firstIndex(where: { $0.id == selectedMemoryID }) {
+            memoryTable.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+        } else if !memories.isEmpty {
+            selectMemory(memories[0].id)
+        } else {
+            selectedMemoryID = nil
+            let empty = filterField.stringValue.isEmpty && typePopUp.indexOfSelectedItem <= 0
+            showPlaceholder(showingArchived ? "No archived memories." :
+                empty ? "No memories yet. The Omni Memory agent consolidates them from your transcripts."
+                : "No memories match.", in: detailText)
+            updateDetailButtons(nil)
+        }
+    }
+
+    func selectMemory(_ id: String) {
+        selectedMemoryID = id
+        if let row = memories.firstIndex(where: { $0.id == id }), memoryTable.selectedRow != row {
+            memoryTable.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+            memoryTable.scrollRowToVisible(row)
+        }
+        detailRequest += 1
+        let request = detailRequest
+        OmniSchedulerClient.request(["op": "get_memory", "id": id]) { [weak self] response in
+            guard let self, request == self.detailRequest else { return }
+            guard OmniPane.isOK(response), let memory = response["memory"] as? [AnyHashable: Any] else {
+                self.showPlaceholder(response["error"] as? String ?? "This memory could not be loaded.", in: self.detailText)
+                self.updateDetailButtons(nil)
+                return
+            }
+            let titles = Dictionary(self.memories.map { ($0.id, $0.title) }, uniquingKeysWith: { a, _ in a })
+            self.detailText.textStorage?.setAttributedString(OmniMemoryText.memoryDetail(memory, titles: titles))
+            self.updateDetailButtons(OmniMemoryItem(memory))
+        }
+    }
