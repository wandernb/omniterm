+    // A fake session of `count` records: a prompt, then replies and tool
+    // calls. Answers tail, offset and message_id like the knowledge worker.
+    private func fakeLongSession(_ id: String, count: Int = 300) {
+        func record(_ index: Int) -> [String: Any] {
+            let base: [String: Any] = ["message_id": "r\(index)", "source_path": "/s.jsonl", "source_line": index, "part": 0]
+            switch index % 5 {
+            case 0: return base.merging(["role": "user", "kind": "message", "text": "Prompt \(index)"]) { $1 }
+            case 1: return base.merging(["role": "assistant", "kind": "tool", "text": "Bash\n{\"command\":\"ls \(index)\"}"]) { $1 }
+            case 2: return base.merging(["role": "tool", "kind": "output", "text": "file-\(index)\nsecond line"]) { $1 }
+            default: return base.merging(["role": "assistant", "kind": "message",
+                                          "text": "Reply \(index) with enough words to wrap onto a second line in a narrow column of the page."]) { $1 }
+            }
+        }
+        fake.handlers["get_session"] = { request in
+            let limit = request["limit"] as? Int ?? 80
+            var offset = request["offset"] as? Int ?? 0
+            if request["tail"] as? Bool == true {
+                offset = max(0, count - limit)
+            }
+            if let message = request["message_id"] as? String, let index = Int(message.dropFirst()) {
+                offset = max(0, index - 2)
+            }
+            let end = min(count, offset + limit)
+            return ["ok": true, "session": self.session(id, title: "Long session"),
+                    "messages": (offset..<end).map(record), "offset": offset, "end_offset": end,
+                    "total": count, "next_offset": end < count ? end : NSNull()]
+        }
+    }
