+private final class OmniSidebarSectionCell: NSTableCellView {
+    private let label = NSTextField(labelWithString: "")
+    private var accessory: NSView?
+    // A project's icon in its colour, before a Sessions-mode project header.
+    private let iconView = NSImageView()
+    private let emojiLabel = NSTextField(labelWithString: "")
+    private var hasIcon = false
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 220, height: 26))
+        label.autoresizingMask = [.width]
+        addSubview(label)
+        textField = label
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    func configure(title: String, accessory: NSView?, icon: OmniAgentIcon? = nil, iconColor: NSColor? = nil) {
+        hasIcon = icon != nil
+        iconView.removeFromSuperview()
+        emojiLabel.removeFromSuperview()
+        switch icon {
+        case .symbol(let name)?:
+            iconView.image = OmniIconImage.image(name)
+            iconView.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 11, weight: .medium)
+            iconView.contentTintColor = iconColor ?? OmniTheme.secondaryText
+            addSubview(iconView)
+        case .emoji(let emoji)?:
+            emojiLabel.stringValue = emoji
+            emojiLabel.font = NSFont.systemFont(ofSize: 11)
+            addSubview(emojiLabel)
+        case nil:
+            break
+        }
+        label.stringValue = title
+        self.accessory?.removeFromSuperview()
+        self.accessory = accessory
+        if let accessory {
+            addSubview(accessory)
+        }
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let accessoryWidth: CGFloat = accessory.map { $0 is NSButton ? 22 : $0.frame.width + 2 } ?? 0
+        let labelX: CGFloat = hasIcon ? 20 : 2
+        iconView.frame = NSRect(x: 2, y: (bounds.height - 16) / 2, width: 14, height: 16)
+        emojiLabel.frame = NSRect(x: 1, y: (bounds.height - 16) / 2, width: 18, height: 16)
+        label.frame = NSRect(x: labelX, y: (bounds.height - 16) / 2,
+                             width: max(0, bounds.width - accessoryWidth - 4 - labelX), height: 16)
+        accessory?.frame = NSRect(x: bounds.width - accessoryWidth - 2, y: (bounds.height - 20) / 2, width: accessoryWidth - 2, height: 20)
+    }
+}
