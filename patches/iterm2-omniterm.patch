@@ -0,0 +1,16 @@
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@interface OmniScheduler : NSObject
+
+- (instancetype)initWithLaunchHandler:(void (^)(NSString *command, NSString *title))launchHandler;
+- (void)start;
+- (void)stop;
+- (void)checkNow;
