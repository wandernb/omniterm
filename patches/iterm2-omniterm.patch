+    private func updateDetailButtons(_ item: OmniMemoryItem?) {
+        for button in [pinButton, reinforceButton, retypePopUp, graphButton] as [NSControl] {
+            button.isEnabled = item != nil
+        }
+        pinButton.title = item?.pinned == true ? "Unpin" : "Pin"
+        restoreButton.isHidden = item?.archived != true
+        restoreButton.isEnabled = item != nil
+        if let item, let index = Self.types.firstIndex(of: item.memoryType) {
+            retypePopUp.selectItem(at: index)
+        }
+        detailButtons.needsLayout = true
+        detailButtons.resizeSubviews(withOldSize: detailButtons.frame.size)
