+    private static func all<T: NSView>(_ type: T.Type, in view: NSView) -> [T] {
+        var found: [T] = []
+        if let match = view as? T {
+            found.append(match)
+        }
+        for subview in view.subviews {
+            found += all(type, in: subview)
+        }
+        return found
+    }
