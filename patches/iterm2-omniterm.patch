+//
+//  OmniSidebarModelTests.swift
+//  ModernTests
+//
+//  The sidebar's Agents area: group trees from agents and configured groups,
+//  icon specs, and the quick checks a rename gets before the scheduler.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniSidebarModelTests: XCTestCase {
+    func testGroupTreeKeepsConfiguredOrderAndEmptyGroups() {
+        let tree = OmniGroupTree(agents: [("Zed", "Work"), ("Alpha", "Work/Daily"), ("Beta", nil), ("Gamma", "Home"),
+                                          ("Delta", "")],
+                                 configured: ["Work", "Empty", "Work/Daily"])
+        XCTAssertEqual(tree.groups.map(\.path), ["Work", "Empty", "Home"])
+        XCTAssertEqual(tree.groups[0].agents, ["Zed"])
+        XCTAssertEqual(tree.groups[0].subgroups.map(\.path), ["Work/Daily"])
+        XCTAssertEqual(tree.groups[0].subgroups[0].agents, ["Alpha"])
+        XCTAssertEqual(tree.groups[1].agents, [])
+        XCTAssertEqual(tree.groups[2].agents, ["Gamma"])
+        XCTAssertEqual(tree.ungrouped, ["Beta", "Delta"])
+        XCTAssertEqual(tree.allPaths, ["Work", "Work/Daily", "Empty", "Home"])
+    }
+
+    func testGroupPathsAreNormalizedToTwoLevels() {
+        XCTAssertEqual(OmniGroupTree.normalizedPath(" A / B /C"), "A/B")
+        XCTAssertEqual(OmniGroupTree.normalizedPath("//A//"), "A")
+        XCTAssertEqual(OmniGroupTree.normalizedPath(nil), "")
+        XCTAssertEqual(OmniGroupTree.parent(of: "A/B"), "A")
+        XCTAssertEqual(OmniGroupTree.parent(of: "A"), "")
+        // A subgroup named only by an agent brings its parent with it.
+        let tree = OmniGroupTree(agents: [("X", "Ops/Night")], configured: [])
+        XCTAssertEqual(tree.groups.map(\.path), ["Ops"])
+        XCTAssertEqual(tree.groups[0].subgroups.map(\.path), ["Ops/Night"])
+        XCTAssertEqual(tree.groups[0].subgroups[0].agents, ["X"])
+    }
+
+    func testIconSpecParsing() {
+        XCTAssertEqual(OmniAgentIcon(spec: "sf:folder.fill"), .symbol("folder.fill"))
+        XCTAssertEqual(OmniAgentIcon(spec: "emoji:🚀"), .emoji("🚀"))
+        XCTAssertEqual(OmniAgentIcon(spec: "emoji:👨‍💻"), .emoji("👨‍💻"))
+        XCTAssertEqual(OmniAgentIcon(spec: "emoji:🇫🇷"), .emoji("🇫🇷"))
+        XCTAssertEqual(OmniAgentIcon(spec: "emoji:1️⃣"), .emoji("1️⃣"))
+        XCTAssertNil(OmniAgentIcon(spec: "emoji:ab"))
+        XCTAssertNil(OmniAgentIcon(spec: "emoji:1"))
+        XCTAssertNil(OmniAgentIcon(spec: "sf:../x"))
+        XCTAssertNil(OmniAgentIcon(spec: "sf:"))
+        XCTAssertNil(OmniAgentIcon(spec: "folder"))
+        XCTAssertNil(OmniAgentIcon(spec: nil))
+        XCTAssertEqual(OmniAgentIcon.emoji("🚀").spec, "emoji:🚀")
+        XCTAssertEqual(OmniAgentColor.color("purple"), .systemPurple)
+        XCTAssertNil(OmniAgentColor.color("beige"))
+    }
+
+    func testRenameChecks() {
+        XCTAssertNotNil(OmniRenameRules.agentNameProblem("  ", current: "A", existing: ["A", "B"]))
+        XCTAssertNotNil(OmniRenameRules.agentNameProblem("B", current: "A", existing: ["A", "B"]))
+        XCTAssertNotNil(OmniRenameRules.agentNameProblem("tab\there", current: "A", existing: []))
+        XCTAssertNotNil(OmniRenameRules.agentNameProblem(String(repeating: "x", count: 101), current: "A", existing: []))
