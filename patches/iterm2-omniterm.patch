+// The text view both the editor and the read-only view use, on a TextKit 1
+// stack it owns.
+final class OmniMarkdownTextView: NSTextView {
+    let markdownStorage: OmniMarkdownTextStorage
+    var didChangeFocus: ((Bool) -> Void)?
+
+    init(fontSize: CGFloat) {
+        markdownStorage = OmniMarkdownTextStorage(fontSize: fontSize)
+        let layoutManager = NSLayoutManager()
+        markdownStorage.addLayoutManager(layoutManager)
+        let container = NSTextContainer(size: NSSize(width: 300, height: CGFloat.greatestFiniteMagnitude))
+        layoutManager.addTextContainer(container)
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: 100), textContainer: container)
+        isRichText = false
+        importsGraphics = false
+        usesFontPanel = false
+        isAutomaticQuoteSubstitutionEnabled = false
+        isAutomaticDashSubstitutionEnabled = false
+        isAutomaticTextReplacementEnabled = false
+        isAutomaticLinkDetectionEnabled = false
+        isAutomaticDataDetectionEnabled = false
+        allowsUndo = true
+        typingAttributes = OmniMarkdownStyler.baseAttributes(fontSize: fontSize)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    var markdown: String {
+        get { markdownStorage.string }
+        set {
+            markdownStorage.replaceCharacters(in: NSRange(location: 0, length: markdownStorage.length), with: newValue)
+            setSelectedRange(NSRange(location: 0, length: 0))
+        }
+    }
+
+    // Applies an edit as typing would, so it can be undone.
+    func apply(_ edit: OmniMarkdownEdit) {
+        guard shouldChangeText(in: edit.range, replacementString: edit.replacement) else { return }
+        markdownStorage.replaceCharacters(in: edit.range, with: edit.replacement)
+        didChangeText()
+        setSelectedRange(edit.selection)
+        scrollRangeToVisible(edit.selection)
+    }
+
+    // ⌘B, ⌘I and ⌘K belong to the editor only while it has focus, so the
+    // sidebar keeps its ⌘I.
+    override func performKeyEquivalent(with event: NSEvent) -> Bool {
+        let modifiers = event.modifierFlags.intersection([.command, .shift, .option, .control])
+        guard isEditable, event.type == .keyDown, modifiers == .command, window?.firstResponder === self else {
+            return super.performKeyEquivalent(with: event)
+        }
+        let selection = selectedRange()
+        switch event.charactersIgnoringModifiers?.lowercased() {
+        case "b":
+            apply(OmniMarkdownEditing.toggle("**", in: markdown, selection: selection))
+        case "i":
+            apply(OmniMarkdownEditing.toggle("*", in: markdown, selection: selection))
+        case "k":
+            apply(OmniMarkdownEditing.link(in: markdown, selection: selection))
+        default:
+            return super.performKeyEquivalent(with: event)
+        }
+        return true
+    }
+
+    override func insertNewline(_ sender: Any?) {
+        guard isEditable, let edit = OmniMarkdownEditing.newline(in: markdown, selection: selectedRange()) else {
+            super.insertNewline(sender)
+            return
+        }
+        apply(edit)
+    }
+
+    override func insertTab(_ sender: Any?) {
+        guard isEditable, let edit = OmniMarkdownEditing.indent(in: markdown, selection: selectedRange(), outdent: false) else {
+            super.insertTab(sender)
+            return
+        }
+        apply(edit)
+    }
+
+    override func insertBacktab(_ sender: Any?) {
+        guard isEditable, let edit = OmniMarkdownEditing.indent(in: markdown, selection: selectedRange(), outdent: true) else {
+            super.insertBacktab(sender)
+            return
+        }
+        apply(edit)
+    }
+
+    override func becomeFirstResponder() -> Bool {
+        let became = super.becomeFirstResponder()
+        if became {
+            didChangeFocus?(true)
+        }
+        return became
+    }
+
+    override func resignFirstResponder() -> Bool {
+        let resigned = super.resignFirstResponder()
+        if resigned {
+            didChangeFocus?(false)
+        }
+        return resigned
+    }
+}
