+// Retention also closes idle sessions whose agent finished long ago. Those runs
+// did their work: only unfinished work is recorded as evicted.
+- (void)testRetentionClosingAFinishedRunRecordsItCompleted {
+    [self startSchedulerWithAgentTimeout:@7200];
+    const NSTimeInterval now = NSDate.date.timeIntervalSince1970;
+    [self insertRun:@"done" state:@"evicting" started:now pid:NSNull.null];
+    [self insertRun:@"busy" state:@"evicting" started:now pid:NSNull.null];
+    [_scheduler runSQL:@"UPDATE runs SET turn_finished=1 WHERE id='done'" bindings:@[]];
+    for (NSString *runID in @[ @"done", @"busy" ]) {
+        XCTAssertEqualObjects(([_scheduler responseForRequest:@{ @"op": @"runner_finished", @"run_id": runID,
+                                                                 @"state": @"stopped", @"reason": @"stopped" }][@"ok"]), @YES);
+    }
+    XCTAssertEqualObjects([self stateOfRun:@"done"], @"completed");
+    XCTAssertEqualObjects(([[_scheduler rowsForSQL:@"SELECT reason FROM runs WHERE id='done'" bindings:@[]].firstObject objectForKey:@"reason"]),
+                          @"agent finished, then retention closed its session");
+    XCTAssertEqualObjects([self stateOfRun:@"busy"], @"evicted");
+
+    // The same rule when the runner could not report (a killed app or a reboot).
+    const pid_t gone = [self exitedProcessIdentifier];
+    [self insertRun:@"lost-done" state:@"evicting" started:now pid:@(gone)];
+    [self insertRun:@"lost-busy" state:@"evicting" started:now pid:@(gone)];
+    [_scheduler runSQL:@"UPDATE runs SET turn_finished=1 WHERE id='lost-done'" bindings:@[]];
+    [_scheduler reapAbandonedRuns];
+    XCTAssertEqualObjects([self stateOfRun:@"lost-done"], @"completed");
+    XCTAssertEqualObjects([self stateOfRun:@"lost-busy"], @"evicted");
+}
