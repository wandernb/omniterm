+//
+//  OmniRunReportTests.swift
+//  ModernTests
+//
+//  Run reports show agent-written text. It must come out as plain text: no
+//  links, no hidden control characters, and Markdown reduced to a safe subset.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniRunReportTests: XCTestCase {
+    func testSanitizedRemovesControlAndBidiCharacters() {
+        let text = "safe\u{1B}[31m red\u{202E}evil\u{2066}\r\nnext\tline\u{7}"
+        XCTAssertEqual(OmniReportText.sanitized(text), "safe[31m redevil\nnext\tline")
+    }
+
+    func testAttributedMarkdownHasNoLinks() {
+        let rendered = OmniReportText.attributed("See [the PR](https://example.com/pr/1) and ![img](file:///etc/passwd) <a href=\"x\">raw</a>")
+        XCTAssertEqual(rendered.string, "See the PR (https://example.com/pr/1) and img <a href=\"x\">raw</a>")
+        var sawLink = false
+        rendered.enumerateAttribute(.link, in: NSRange(location: 0, length: rendered.length)) { value, _, _ in
+            if value != nil {
+                sawLink = true
+            }
+        }
+        XCTAssertFalse(sawLink)
+    }
+
+    func testAttributedMarkdownStripsMarkers() {
+        let rendered = OmniReportText.attributed("## Done\n- fixed **the bug** in `main.swift`\n```\n**kept**\n```")
+        XCTAssertEqual(rendered.string, "Done\n• fixed the bug in main.swift\n**kept**\n")
+        let boldRange = (rendered.string as NSString).range(of: "the bug")
+        let font = rendered.attribute(.font, at: boldRange.location, effectiveRange: nil) as? NSFont
+        XCTAssertTrue(font?.fontDescriptor.symbolicTraits.contains(.bold) ?? false)
+    }
+
+    func testUnterminatedMarkersStayLiteral() {
+        XCTAssertEqual(OmniReportText.attributed("a **b and `c and [d](e").string, "a **b and `c and [d](e")
+    }
+
+    func testFirstLineSkipsBlankAndFenceLines() {
+        XCTAssertEqual(OmniReportText.firstLine("\n```\n\n# **Fixed** the build\nmore"), "Fixed the build")
+        XCTAssertNil(OmniReportText.firstLine("  \n\n"))
+        XCTAssertEqual(OmniReportText.firstLine(String(repeating: "x", count: 300), limit: 10), "xxxxxxxxx…")
+    }
+
+    func testRunSummaryFallsBackToFinalMessageThenReason() {
+        let base: [AnyHashable: Any] = ["id": "r1", "agent": "Nightly", "state": "completed", "started": 100,
+                                        "reason": "exited", "commits": [["sha": "abc", "subject": "Fix"]],
+                                        "diff_files": ["a.swift", ""], "summary": NSNull()]
+        let reasonOnly = OmniRun(base)
+        XCTAssertEqual(reasonOnly?.oneLineSummary, "exited")
+        XCTAssertEqual(reasonOnly?.commits.first?.subject, "Fix")
+        XCTAssertEqual(reasonOnly?.diffFiles, ["a.swift"])
+
+        var withFinal = base
+        withFinal["final_message"] = "All tests pass."
+        XCTAssertEqual(OmniRun(withFinal)?.oneLineSummary, "All tests pass.")
+
+        withFinal["summary"] = "- Refactored the parser"
+        XCTAssertEqual(OmniRun(withFinal)?.oneLineSummary, "Refactored the parser")
+    }
+
+    func testRunStatesAndMissingID() {
+        XCTAssertNil(OmniRun(["agent": "x"]))
+        let live = OmniRun(["id": "r", "state": "running", "started": 1])
+        XCTAssertEqual(live?.isLive, true)
+        XCTAssertEqual(live?.canResume, false)
+        let failed = OmniRun(["id": "r", "state": "failed", "head_start": "0123456789abcdef", "head_end": "fedcba9876543210"])
+        XCTAssertEqual(failed?.isLive, false)
+        XCTAssertEqual(failed?.outcomeColor, .systemRed)
+        XCTAssertEqual(failed?.headRange, "01234567…fedcba98")
+    }
+
+    func testStatusColoursAndIdleRuns() {
+        let idle = OmniRun(["id": "r", "state": "running", "started": 1, "turn_finished": 1])
+        XCTAssertEqual(idle?.isIdle, true)
+        XCTAssertEqual(idle?.isWorking, false)
+        XCTAssertEqual(idle?.outcomeName, "Idle")
+        XCTAssertEqual(idle?.outcomeColor, .systemOrange)
+        XCTAssertEqual(idle?.statusLine, "Idle · waiting for you")
+        let working = OmniRun(["id": "r", "state": "running", "started": 1, "turn_finished": 0])
+        XCTAssertEqual(working?.isWorking, true)
+        XCTAssertEqual(working?.outcomeColor, .systemBlue)
+        XCTAssertTrue(working?.statusLine.hasPrefix("Running · ") ?? false)
+        XCTAssertEqual(OmniRun(["id": "r", "state": "completed", "turn_finished": 1])?.outcomeColor, .systemGreen)
+        for state in ["stopped", "closed", "replaced", "evicted", "interrupted"] {
+            XCTAssertEqual(OmniRun(["id": "r", "state": state])?.outcomeColor, .systemGray, state)
+        }
+    }
+
+    // Retention also closed runs from before turns were tracked; nobody knows
+    // whether their agent had finished, so they are not called evicted.
+    func testARunClosedByRetentionIsEvictedOnlyWhenItsTurnWasUnfinished() {
+        XCTAssertEqual(OmniRun(["id": "r", "state": "evicted", "turn_finished": 0])?.outcomeName, "Evicted")
+        XCTAssertEqual(OmniRun(["id": "r", "state": "evicted"])?.outcomeName, "Ended")
+        XCTAssertEqual(OmniRun(["id": "r", "state": "evicted", "turn_finished": NSNull()])?.outcomeName, "Ended")
+    }
+
+    func testAgentScheduleFallsBackToKind() {
