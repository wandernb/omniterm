+private final class OmniDisclosureHeader: NSView {
+
+    override func resetCursorRects() {
+        addCursorRect(bounds, cursor: .pointingHand)
+    }
+    private let button: NSButton
+    private let label: NSTextField
+
+    override var isFlipped: Bool { true }
+
+    init(button: NSButton, label: NSTextField) {
+        self.button = button
+        self.label = label
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: 20))
+        addSubview(button)
+        addSubview(label)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        button.frame = NSRect(x: -4, y: 0, width: 22, height: 20)
+        label.frame = NSRect(x: 18, y: 2, width: max(0, bounds.width - 18), height: 16)
+    }
+
+    // The whole header toggles, not just the triangle.
+    override func mouseUp(with event: NSEvent) {
+        button.performClick(nil)
+    }
+
+    override func mouseDown(with event: NSEvent) {
+    }
+}
