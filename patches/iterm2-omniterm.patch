+
+    // A folder listing in a bordered box with a breadcrumb header.
+    private func explorer(crumbs: [(label: String, path: String)], trailing: String, key: String,
+                          previous: [(title: String, zone: OmniListZone)], rows: [(key: String, row: OmniZoneItem)],
+                          open: @escaping (String) -> Void) {
+        let zone = previous.first { $0.title == key }?.zone ?? OmniListZone()
+        let list = OmniColumnView()
+        list.inset = 0
+        list.topPadding = 0
+        list.bottomPadding = 0
+        list.overlay = zone
+        for (_, row) in rows {
+            list.add(row, spacing: 0) { _ in OmniExplorerRow.height }
+        }
+        if rows.isEmpty {
+            list.addText(OmniTheme.meta("  This folder is empty."))
+        }
+        zone.setItems(rows.map { (key: $0.key, view: $0.row) })
+        let box = OmniExplorerBox(header: OmniBreadcrumb(crumbs: crumbs, trailing: trailing, open: open), body: list) { [weak list] width in
+            list?.layoutColumn(width: width) ?? 0
+        }
+        scroll.column.add(box, spacing: 16) { [weak box] width in
+            box?.height(forWidth: width) ?? 0
+        }
+        zones.append((title: key, zone: zone))
+    }
+
+    // A file in a bordered box: its path as a breadcrumb, its text below.
+    private func addFileBox(title: [(label: String, path: String)], trailing: String, view: OmniMarkdownView,
+                            open: @escaping (String) -> Void, spacing: CGFloat) {
+        view.drawsCard = false
+        let box = OmniExplorerBox(header: OmniBreadcrumb(crumbs: title, trailing: trailing, open: open), body: view,
+                                  bodyInset: 18) { [weak view] width in
+            view?.height(forWidth: width) ?? 0
+        }
+        scroll.column.add(box, spacing: spacing) { [weak box] width in
+            box?.height(forWidth: width) ?? 0
+        }
+    }
+
+    // The file opened from Knowledge or Files, above its folder, as on a repository host.
+    private func addOpenFile() {
+        guard let openFile else { return }
+        var crumbs: [(label: String, path: String)] = []
+        var walked = ""
+        for part in openFile.path.split(separator: "/").map(String.init) {
+            walked = walked.isEmpty ? part : walked + "/" + part
+            crumbs.append((label: part, path: walked))
+        }
+        let lines = openFile.text.split(separator: "\n", omittingEmptySubsequences: false).count
+        let inKnowledge = tab == .knowledge
+        addFileBox(title: crumbs, trailing: lines == 1 ? "1 line" : "\(lines) lines", view: fileView, open: { [weak self] path in
+            guard let self else { return }
+            if inKnowledge {
+                let inside = path.hasPrefix("knowledge/") ? String(path.dropFirst("knowledge/".count)) : (path == "knowledge" ? "" : path)
+                self.openKnowledgeFolder(inside)
+            } else {
+                self.openFile = nil
+                self.loadFolder(path)
+            }
+        }, spacing: 16)
+    }
+
+    private func buildFiles(_ previous: [(title: String, zone: OmniListZone)]) {
+        let column = scroll.column
+        addOpenFile()
+        guard let folder else {
+            column.addText(OmniTheme.meta("Loading…"))
+            return
+        }
+        if let error = folder["error"] as? String {
+            column.addText(OmniTheme.meta(error), spacing: 8)
+        }
+        let projectName = project.map { OmniProjectsModel.name($0, aliases: aliases) } ?? "project"
+        var crumbs: [(label: String, path: String)] = [(label: projectName, path: "")]
+        var walked = ""
+        for part in folderPath.split(separator: "/").map(String.init) {
+            walked = walked.isEmpty ? part : walked + "/" + part
+            crumbs.append((label: part, path: walked))
+        }
+        var rows: [(key: String, row: OmniZoneItem)] = []
+        if !folderPath.isEmpty {
+            let parent = OmniProjectsModel.parent(of: folderPath)
+            rows.append((key: "..", row: OmniExplorerRow(symbol: .folder, iconColor: OmniTheme.folderTint, name: "..",
+                                                         detail: "", age: "", separator: true) { [weak self] in
+                self?.loadFolder(parent)
+            }))
+        }
+        // Folders first, as a repository host lists them.
+        let entries = (folder["entries"] as? [[String: Any]] ?? []).sorted { left, right in
+            let leftDir = left["kind"] as? String == "dir"
+            let rightDir = right["kind"] as? String == "dir"
+            if leftDir != rightDir { return leftDir }
+            return (left["name"] as? String ?? "").localizedStandardCompare(right["name"] as? String ?? "") == .orderedAscending
+        }
+        for entry in entries {
+            guard let name = entry["name"] as? String else { continue }
+            let path = folderPath.isEmpty ? name : folderPath + "/" + name
+            let isDirectory = entry["kind"] as? String == "dir"
+            let secret = entry["secret"] as? Bool == true
+            let detail = isDirectory ? "" : secret ? "May hold secrets: not shown" :
+                OmniProjectsModel.size((entry["size"] as? NSNumber)?.intValue)
+            let modified = (entry["modified"] as? NSNumber)?.doubleValue
+            let row = OmniExplorerRow(symbol: isDirectory ? .folderFill : (secret ? .lock : .docText),
+                                      iconColor: isDirectory ? OmniTheme.folderTint : nil, name: name, detail: detail,
+                                      age: OmniSessionText.age(modified), separator: true) { [weak self] in
+                if isDirectory {
+                    self?.openFile = nil
+                    self?.loadFolder(path)
+                } else if !secret {
+                    self?.open(file: path)
+                }
+            }
+            fileMenu(row, path: path, open: secret ? nil : { [weak row] in row?.activate() })
+            rows.append((key: path, row: row))
+        }
+        let count = entries.count
+        explorer(crumbs: crumbs, trailing: count == 1 ? "1 item" : "\(count) items", key: "files", previous: previous,
+                 rows: rows) { [weak self] path in
+            self?.openFile = nil
+            self?.loadFolder(path)
+        }
+    }
