+// A list row: a type chip and a meta line under the title, and a thin bar
+// showing the memory's decayed weight out of ten. Rows without a type (journal
+// events, transcript matches) show a coloured dot instead of the chip.
+final class OmniMemoryRowView: NSTableCellView {
+    private let dot = NSView()
+    private let titleField = NSTextField(labelWithString: "")
+    private let chip = OmniBadgeView()
+    private let detailField = NSTextField(labelWithString: "")
+    private let track = NSView()
+    private let bar = NSView()
+    private var weight: Double?
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: 58))
+        for view in [dot, track, bar] {
+            view.wantsLayer = true
+        }
+        dot.layer?.cornerRadius = 4
+        track.layer?.cornerRadius = 1.5
+        bar.layer?.cornerRadius = 1.5
+        titleField.font = OmniTheme.Font.rowTitleEmphasized
+        titleField.lineBreakMode = .byTruncatingTail
+        detailField.font = OmniTheme.Font.rowDetail
+        detailField.textColor = OmniTheme.secondaryText
+        detailField.lineBreakMode = .byTruncatingTail
+        for view in [dot, titleField, chip, detailField, track, bar] {
+            addSubview(view)
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    // A detail line with its own styling, such as a search snippet with bold matches.
+    func setDetail(_ detail: NSAttributedString) {
+        detailField.attributedStringValue = detail
+        setAccessibilityLabel([titleField.stringValue, detail.string].joined(separator: ", "))
+    }
+
+    func configure(title: String, detail: String, color: NSColor, faded: Bool, chip type: String? = nil,
+                   weight: Double? = nil) {
+        titleField.stringValue = OmniReportText.sanitized(title)
+        detailField.stringValue = OmniReportText.sanitized(detail)
+        titleField.textColor = faded ? OmniTheme.secondaryText : .labelColor
+        dot.isHidden = type != nil
+        dot.layer?.backgroundColor = color.withAlphaComponent(faded ? 0.35 : 1).cgColor
+        chip.isHidden = type == nil
+        if let type {
+            chip.configure(text: type.uppercased(), color: color.withAlphaComponent(faded ? 0.5 : 1))
+        }
+        self.weight = weight
+        track.isHidden = weight == nil
+        bar.isHidden = weight == nil
+        track.layer?.backgroundColor = NSColor.quaternaryLabelColor.cgColor
+        bar.layer?.backgroundColor = color.withAlphaComponent(faded ? 0.35 : 0.85).cgColor
+        setAccessibilityLabel([title, type, detail, weight.map { String(format: "weight %.1f of 10", $0) }]
+            .compactMap { $0 }.joined(separator: ", "))
+        needsLayout = true
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let left: CGFloat = dot.isHidden ? 14 : 30
+        dot.frame = NSRect(x: 14, y: bounds.height - 22, width: 8, height: 8)
+        titleField.frame = NSRect(x: left, y: bounds.height - 26, width: max(0, bounds.width - left - 14), height: 17)
+        var detailX = left
+        if !chip.isHidden {
+            let size = chip.frame.size
+            chip.frame = NSRect(x: left, y: bounds.height - 44, width: size.width, height: size.height)
+            detailX = chip.frame.maxX + 6
+        }
+        detailField.frame = NSRect(x: detailX, y: bounds.height - 45, width: max(0, bounds.width - detailX - 14), height: 15)
+        let barWidth = max(0, bounds.width - left - 14)
+        track.frame = NSRect(x: left, y: 5, width: barWidth, height: 3)
+        bar.frame = NSRect(x: left, y: 5, width: barWidth * CGFloat(max(0, min(10, weight ?? 0)) / 10), height: 3)
+    }
+}
+
+// How memory is built, left to right: transcripts are indexed and embedded,
+// assistant messages become candidates, the consolidator cites or dismisses
+// them, memories form and fade. Each stage shows its live count.
+final class OmniMemoryPipelineView: NSView {
+    struct Stage: Equatable {
+        let title: String
+        let value: String
+        let detail: String
+    }
+
+    private(set) var stages: [Stage] = []
+
+    override var isFlipped: Bool { true }
+
+    func update(overview: [AnyHashable: Any]) {
+        let pipeline = overview["pipeline"] as? [AnyHashable: Any] ?? [:]
+        func count(_ key: String) -> Int {
+            return OmniMemoryText.number(pipeline[key]) ?? 0
+        }
+        let formatter = NumberFormatter()
+        formatter.numberStyle = .decimal
+        func text(_ value: Int) -> String {
+            return formatter.string(from: NSNumber(value: value)) ?? "\(value)"
+        }
+        let pending = count("candidates_pending")
+        let pendingCap = OmniMemoryText.number(pipeline["candidates_pending_cap"]) ?? 10000
+        let recent = overview["events_24h"] as? [String: Any] ?? [:]
+        let created = (recent["memory_created"] as? NSNumber)?.intValue ?? 0
+        let revised = (recent["memory_revised"] as? NSNumber)?.intValue ?? 0
+        let next = [
+            Stage(title: "Transcripts", value: text(count("messages")),
+                  detail: "\(text(count("sessions"))) sessions · " +
+                    (pipeline["scan_in_progress"] as? Bool == true ? "\(text(count("backlog_files"))) files waiting" : "up to date")),
+            Stage(title: "Identity", value: text(count("mirrored_sessions")),
+                  detail: "mirrored · \(text(count("stale_native_sources"))) stale · \(text(count("orphan_threads"))) orphan"),
+            Stage(title: "Embedded", value: text(count("vectors")),
+                  detail: pipeline["embedding_available"] as? Bool == false ? "model unavailable"
+                    : "\(text(count("pending_vectors"))) queued"),
+            Stage(title: "Candidates", value: pending > pendingCap ? text(pendingCap) + "+" : text(pending),
+                  detail: "\(text(count("excluded_consolidator_sessions"))) consolidator sessions excluded"),
+            Stage(title: "Considered", value: text(count("candidates_considered")),
+                  detail: "\(text(count("candidates_cited"))) cited · \(text(count("candidates_dismissed"))) dismissed"),
+            Stage(title: "Memories", value: text(count("memories")),
+                  detail: "\(created) new · \(revised) revised today"),
+            Stage(title: "Fading", value: text(count("expiry_candidates")),
+                  detail: "below \((overview["expiry_threshold"] as? NSNumber)?.doubleValue ?? 0.5) weight"),
+        ]
+        guard next != stages else { return }
+        stages = next
+        setAccessibilityLabel("Memory pipeline: " + stages.map { "\($0.title) \($0.value)" }.joined(separator: ", "))
+        needsDisplay = true
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        OmniTheme.barBackground.setFill()
+        bounds.fill()
+        NSColor.separatorColor.setFill()
+        NSRect(x: 0, y: bounds.height - 1, width: bounds.width, height: 1).fill()
+        guard !stages.isEmpty else { return }
+        let gap: CGFloat = 22, inset: CGFloat = 16
+        let width = (bounds.width - 2 * inset - gap * CGFloat(stages.count - 1)) / CGFloat(stages.count)
+        let titleAttributes: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.sectionHeader,
+                                                              .foregroundColor: OmniTheme.secondaryText]
+        let valueAttributes: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.stat, .foregroundColor: NSColor.labelColor]
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.lineBreakMode = .byTruncatingTail
+        let detailAttributes: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.rowDetail,
+                                                               .foregroundColor: OmniTheme.secondaryText,
+                                                               .paragraphStyle: paragraph]
+        for (index, stage) in stages.enumerated() {
+            let x = inset + CGFloat(index) * (width + gap)
+            let card = NSRect(x: x, y: 14, width: width, height: bounds.height - 28)
+            OmniTheme.contentBackground.setFill()
+            NSBezierPath(roundedRect: card, xRadius: OmniTheme.Metrics.cornerRadius, yRadius: OmniTheme.Metrics.cornerRadius).fill()
+            (stage.title.uppercased() as NSString).draw(in: NSRect(x: x + 10, y: 22, width: width - 20, height: 14),
+                                                        withAttributes: titleAttributes)
+            (stage.value as NSString).draw(in: NSRect(x: x + 10, y: 38, width: width - 20, height: 32),
+                                           withAttributes: valueAttributes)
+            (stage.detail as NSString).draw(in: NSRect(x: x + 10, y: 72, width: width - 20, height: 14),
+                                            withAttributes: detailAttributes)
+            if index < stages.count - 1 {
+                let arrow = NSBezierPath()
+                let y = card.midY
+                arrow.move(to: NSPoint(x: card.maxX + 5, y: y))
+                arrow.line(to: NSPoint(x: card.maxX + gap - 5, y: y))
+                arrow.move(to: NSPoint(x: card.maxX + gap - 10, y: y - 4))
+                arrow.line(to: NSPoint(x: card.maxX + gap - 5, y: y))
+                arrow.line(to: NSPoint(x: card.maxX + gap - 10, y: y + 4))
+                OmniTheme.tertiaryText.setStroke()
+                arrow.lineWidth = 1.5
+                arrow.stroke()
+            }
+        }
+    }
+}
+
+// The page that hosts the memory view in the main window.
+final class OmniMemoryPane: OmniPane {
+    let memory = OmniMemoryViewController()
+
+    override var contentViews: [NSView] {
+        return [memory.view]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return memory.focusZones
+    }
+
+    override init() {
+        super.init()
+        addSubview(memory.view)
+        memory.openRun = { [weak self] id in self?.actions?.paneOpen(.run(id)) }
+        memory.openAgent = { [weak self] name in self?.actions?.paneOpen(.agent(name)) }
+        memory.saveListWidth = { [weak self] width in
+            self?.layoutStore?.update { $0.memoryListWidth = width }
+        }
+        showContent()
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        memory.view.frame = bounds
+    }
+
+    override func reload() {
+        memory.reload()
+    }
+
+    override func applyPanelLayout(_ layout: OmniPanelLayout) {
+        memory.listWidth = layout.memoryListWidth
+    }
+}
+
+// One step of the graph's focus history. An expansion keeps the foci it
+// grew from, so the new neighbourhood merges into theirs.
+struct OmniGraphFocus {
+    let id: String
+    let label: String
+    // Every focus merged at this step, the newest last; each is fetched again
+    // on refresh.
+    let members: [String]
+}
+
+// MARK: - Search query grammar
+
+// One filter, phrase or negation the Search tab shows as a removable chip. The grammar
+// mirrors helpers/omni_query.py; bare words are free text and get no chip.
+struct OmniSearchToken: Equatable {
+    enum Kind: Equatable {
+        case filter(String)
+        case phrase
+        case negation
+    }
+
+    let kind: Kind
+    let value: String
+    let range: Range<String.Index>
+
+    var label: String {
+        switch kind {
+        case .filter(let key): return key + ": " + value
+        case .phrase: return "“" + value + "”"
+        case .negation: return "not " + value
+        }
+    }
+}
+
+enum OmniSearchQuery {
+    static let keys: Set<String> = ["type", "ws", "workspace", "provider", "role", "concept", "session", "after",
+                                    "before", "since", "archived"]
+    private static let pattern = try! NSRegularExpression(pattern: "(-?)(?:([A-Za-z_]+):)?(?:\"([^\"]*)\"?|(\\S+))")
+    private static let date = try! NSRegularExpression(pattern: "^\\d{4}-\\d{2}-\\d{2}")
+    private static let since = try! NSRegularExpression(pattern: "^\\d{1,5}[hdwHDW]$")
+
+    static func tokens(in text: String) -> [OmniSearchToken] {
+        var tokens: [OmniSearchToken] = []
+        let whole = NSRange(text.startIndex..., in: text)
+        for match in pattern.matches(in: text, range: whole) {
+            guard let range = Range(match.range, in: text) else { continue }
+            func group(_ index: Int) -> String? {
+                Range(match.range(at: index), in: text).map { String(text[$0]) }
+            }
+            let negated = group(1) == "-"
+            let key = group(2)?.lowercased()
+            let quoted = group(3)
+            let value = (quoted ?? group(4) ?? "").trimmingCharacters(in: .whitespaces)
+            if let key, !negated, keys.contains(key), valid(key: key, value: value) {
+                tokens.append(OmniSearchToken(kind: .filter(key == "workspace" ? "ws" : key), value: value, range: range))
+            } else if negated {
+                let raw = group(2).map { $0 + ":" + value } ?? value
+                if !raw.isEmpty {
+                    tokens.append(OmniSearchToken(kind: .negation, value: raw, range: range))
+                }
+            } else if group(2) == nil, let quoted, !quoted.trimmingCharacters(in: .whitespaces).isEmpty {
+                tokens.append(OmniSearchToken(kind: .phrase, value: value, range: range))
+            }
+        }
+        return tokens
+    }
+
+    private static func valid(key: String, value: String) -> Bool {
+        let range = NSRange(value.startIndex..., in: value)
+        switch key {
+        case "provider": return ["claude", "codex", "kb"].contains(value.lowercased())
+        case "after", "before": return date.firstMatch(in: value, range: range) != nil
+        case "since": return since.firstMatch(in: value, range: range) != nil
+        case "archived": return ["true", "false", "yes", "no", "1", "0"].contains(value.lowercased())
+        default: return !value.isEmpty
+        }
+    }
+
+    // The query without one token, its surrounding spaces folded.
+    static func removing(_ token: OmniSearchToken, from text: String) -> String {
+        guard token.range.upperBound <= text.endIndex else { return text }
+        var result = text
+        result.removeSubrange(token.range)
+        return result.split(whereSeparator: { $0 == " " }).joined(separator: " ")
+    }
+
+    // A snippet with its «matches» in bold and the markers removed.
+    static func snippet(_ snippet: String, font: NSFont, color: NSColor) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        let bold = NSFontManager.shared.convert(font, toHaveTrait: .boldFontMask)
+        for (index, part) in OmniReportText.sanitized(snippet).replacingOccurrences(of: "\n", with: " ")
+            .components(separatedBy: CharacterSet(charactersIn: "«»")).enumerated() {
+            let inside = index % 2 == 1
+            result.append(NSAttributedString(string: part, attributes: [.font: inside ? bold : font,
+                                                                        .foregroundColor: color]))
+        }
+        return result
+    }
+}
+
+// The last queries typed on the Search tab, newest first, kept on this Mac only.
+enum OmniRecentSearches {
+    static let key = "NoSyncOmniMemoryRecentSearches"
+    static let limit = 20
+
+    static func load(from defaults: UserDefaults) -> [String] {
+        return Array((defaults.stringArray(forKey: key) ?? []).prefix(limit))
+    }
+
+    @discardableResult
+    static func record(_ query: String, in defaults: UserDefaults) -> [String] {
+        let trimmed = query.trimmingCharacters(in: .whitespaces)
+        guard !trimmed.isEmpty else { return load(from: defaults) }
+        let recent = Array(([trimmed] + load(from: defaults).filter { $0 != trimmed }).prefix(limit))
+        defaults.set(recent, forKey: key)
+        return recent
+    }
+}
diff --git a/sources/OmniTerm/OmniPanelLayout.swift b/sources/OmniTerm/OmniPanelLayout.swift
new file mode 100644
index 0000000000000000000000000000000000000000..b04e33c36a193ddd3388a43a49c0f7bc02a314e8
--- /dev/null
+++ b/sources/OmniTerm/OmniPanelLayout.swift
@@ -0,0 +1,261 @@
+import AppKit
+import Foundation
+
+// The panels a person can resize, collapse or hide.
+enum OmniPanel {
+    case sidebar
+    // The agent page's Last Runs and Settings column.
+    case runs
+    // The terminal band under an agent or run page.
+    case band
+    // The diff under a run report.
+    case diff
+}
+
+// Sizes and collapsed states of the terminal window's panels. Stored in
+// ~/.omni/settings.json under `layout`, written only by the scheduler
+// (`set_layout`), never in iTerm2's preferences.
+struct OmniPanelLayout: Equatable {
+    static let sidebarMinWidth: CGFloat = 160
+    static let sidebarMaxWidth: CGFloat = 480
+    // A sidebar dragged narrower than this collapses.
+    static let sidebarCollapseWidth: CGFloat = 100
+    // Collapsed, the sidebar is a rail holding the toggle that brings it
+    // back. The terminal is laid out right of it, so the toggle never covers
+    // terminal text.
+    static let collapsedRailWidth: CGFloat = 28
+    // The share of the panel an agent or run page's details may take above
+    // the terminal band.
+    static let detailsShareRange: ClosedRange<CGFloat> = 0.15...0.9
+
+    var sidebarWidth: CGFloat = OmniSidebarViewController.defaultWidth
+    var sidebarCollapsed = false
+    // Nil until the person drags the divider.
+    var runsWidth: CGFloat?
+    var runsCollapsed = false
+    var detailsShare: CGFloat?
+    var bandCollapsed = false
+    var diffCollapsed = false
+    // The Memory page's list column, dragged by its edge.
+    var memoryListWidth: CGFloat?
+    // The terminal window's frame the person last gave it, in screen
+    // coordinates; nil until they move or resize it.
+    var windowFrame: NSRect?
+    // Pinned, the window keeps `windowFrame` exactly: it cannot be moved or
+    // resized, and opening it never moves it to the pointer's screen.
+    var windowPinned = false
+    // The Space a pinned window was last on, so a relaunch can put it back.
+    var windowSpace: UInt64?
+    static let windowMinSize = NSSize(width: 480, height: 320)
+
+    init() {
+    }
+
+    // The `layout` dictionary of the scheduler's settings; anything missing
+    // or malformed keeps its default.
+    init(stored: [AnyHashable: Any]?) {
+        guard let stored else { return }
+        func number(_ key: String) -> CGFloat? {
+            guard let value = stored[key] as? NSNumber, CFGetTypeID(value) != CFBooleanGetTypeID() else { return nil }
+            return CGFloat(value.doubleValue)
+        }
+        func flag(_ key: String) -> Bool {
+            guard let value = stored[key] as? NSNumber, CFGetTypeID(value) == CFBooleanGetTypeID() else { return false }
+            return value.boolValue
+        }
+        if let width = number("sidebar_width") {
+            sidebarWidth = Self.clampedSidebarWidth(width)
+        }
+        sidebarCollapsed = flag("sidebar_collapsed")
+        runsWidth = number("runs_width")
+        runsCollapsed = flag("runs_collapsed")
+        detailsShare = number("details_share").map(Self.clampedDetailsShare)
+        bandCollapsed = flag("band_collapsed")
+        diffCollapsed = flag("diff_collapsed")
+        memoryListWidth = number("memory_list_width").map(Self.clampedMemoryListWidth)
+        windowPinned = flag("window_pinned")
+        windowSpace = number("window_space").flatMap { $0 >= 1 ? UInt64($0) : nil }
+        if let x = number("window_x"), let y = number("window_y"), let width = number("window_width"),
+           let height = number("window_height"), width >= Self.windowMinSize.width, height >= Self.windowMinSize.height {
+            windowFrame = NSRect(x: x, y: y, width: width, height: height)
+        }
+    }
+
+    // What `set_layout` stores.
+    var dictionary: [String: Any] {
+        var result: [String: Any] = [
+            "sidebar_width": Double(sidebarWidth),
+            "sidebar_collapsed": sidebarCollapsed,
+            "runs_collapsed": runsCollapsed,
+            "band_collapsed": bandCollapsed,
+            "diff_collapsed": diffCollapsed,
+            "window_pinned": windowPinned,
+        ]
+        if let runsWidth {
+            result["runs_width"] = Double(runsWidth)
+        }
+        if let detailsShare {
+            result["details_share"] = Double(detailsShare)
+        }
+        if let windowSpace {
+            result["window_space"] = Double(windowSpace)
+        }
+        if let memoryListWidth {
+            result["memory_list_width"] = Double(memoryListWidth.rounded())
+        }
+        if let windowFrame {
+            result["window_x"] = Double(windowFrame.minX.rounded())
+            result["window_y"] = Double(windowFrame.minY.rounded())
+            result["window_width"] = Double(windowFrame.width.rounded())
+            result["window_height"] = Double(windowFrame.height.rounded())
+        }
+        return result
+    }
+
+    // The width the sidebar takes in the window.
+    var shownSidebarWidth: CGFloat {
+        return sidebarCollapsed ? Self.collapsedRailWidth : Self.clampedSidebarWidth(sidebarWidth)
+    }
+
+    // The stored frame on a screen's visible area: never larger than it, and
+    // wholly on it, centred when the window opens under the pointer.
+    static func restoredWindowFrame(_ stored: NSRect, in visible: NSRect, centered: Bool) -> NSRect {
+        let width = min(stored.width, visible.width)
+        let height = min(stored.height, visible.height)
+        var x = centered ? visible.midX - width / 2 : stored.minX
+        var y = centered ? visible.midY - height / 2 : stored.minY
+        x = max(visible.minX, min(x, visible.maxX - width))
+        y = max(visible.minY, min(y, visible.maxY - height))
+        return NSRect(x: x.rounded(), y: y.rounded(), width: width, height: height)
+    }
+
+    static func clampedSidebarWidth(_ width: CGFloat) -> CGFloat {
+        return min(sidebarMaxWidth, max(sidebarMinWidth, width.rounded()))
+    }
+
+    static let memoryListWidthRange: ClosedRange<CGFloat> = 220...640
+
+    static func clampedMemoryListWidth(_ width: CGFloat) -> CGFloat {
+        return min(max(width, memoryListWidthRange.lowerBound), memoryListWidthRange.upperBound)
+    }
+
+    static func clampedDetailsShare(_ share: CGFloat) -> CGFloat {
+        return min(detailsShareRange.upperBound, max(detailsShareRange.lowerBound, share))
+    }
+
+    mutating func toggle(_ panel: OmniPanel) {
+        switch panel {
+        case .sidebar: sidebarCollapsed.toggle()
+        case .runs: runsCollapsed.toggle()
+        case .band: bandCollapsed.toggle()
+        case .diff: diffCollapsed.toggle()
+        }
+    }
+}
+
+// The window's one layout. Panels read it; a change made anywhere is shown
+// everywhere and saved once it is final (a drag saves when it ends).
+final class OmniPanelLayoutStore {
+    private(set) var layout = OmniPanelLayout()
+    var didChange: ((OmniPanelLayout) -> Void)?
+    var save: ((OmniPanelLayout) -> Void)?
+
+    func update(saving: Bool = true, _ change: (inout OmniPanelLayout) -> Void) {
+        var next = layout
+        change(&next)
+        guard next != layout else {
+            if saving {
+                save?(layout)
+            }
+            return
+        }
+        layout = next
+        didChange?(layout)
+        if saving {
+            save?(layout)
+        }
+    }
+
+    // For a split view's divider, whose drag has no end event: saved once the
+    // changes stop.
+    private var pendingSave: DispatchWorkItem?
+
+    func saveSoon() {
+        pendingSave?.cancel()
+        let work = DispatchWorkItem { [weak self] in
+            guard let self else { return }
+            self.save?(self.layout)
+        }
+        pendingSave = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5, execute: work)
+    }
+
+    // The stored layout, read back from the scheduler; not saved again.
+    func restore(_ stored: OmniPanelLayout) {
+        update(saving: false) { $0 = stored }
+    }
+}
+
+// The agent page's Runs | Report split: both columns keep their minimum
+// widths, and below a threshold the report goes under the runs.
+enum OmniAgentPageGeometry {
+    static let runsMinWidth: CGFloat = 260
+    static let reportMinWidth: CGFloat = 320
+    static let stackBelowWidth: CGFloat = 640
+    static let defaultRunsWidth: CGFloat = 380
+    // Stacked: the least height either part keeps.
+    static let stackedMinHeight: CGFloat = 140
+
+    static func stacks(width: CGFloat) -> Bool {
+        return width < stackBelowWidth
+    }
+
+    // The runs column's width beside the report.
+    static func runsWidth(stored: CGFloat?, total: CGFloat, divider: CGFloat) -> CGFloat {
+        let wanted = stored ?? min(defaultRunsWidth, floor(total * 0.48))
+        let most = total - divider - reportMinWidth
+        return max(runsMinWidth, min(wanted, most)).rounded()
+    }
+
+    // Stacked: the runs get what their list needs, up to half the height.
+    static func stackedRunsHeight(wanted: CGFloat, total: CGFloat, divider: CGFloat) -> CGFloat {
+        let most = max(stackedMinHeight, total - divider - stackedMinHeight)
+        return max(stackedMinHeight, min(wanted, total * 0.5, most)).rounded()
+    }
+}
+
+// A thin strip on a panel's edge that resizes it by dragging.
+final class OmniResizeHandle: NSView {
+    // True for a strip on a vertical edge (dragged left and right).
+    let vertical: Bool
+    // The pointer's position in the window, and whether the drag ended.
+    var dragged: ((NSPoint, Bool) -> Void)?
+
+    init(vertical: Bool) {
+        self.vertical = vertical
+        super.init(frame: .zero)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resetCursorRects() {
+        addCursorRect(bounds, cursor: vertical ? .resizeLeftRight : .resizeUpDown)
+    }
+
+    override func acceptsFirstMouse(for event: NSEvent?) -> Bool {
+        return true
+    }
+
+    override func mouseDown(with event: NSEvent) {
+    }
+
+    override func mouseDragged(with event: NSEvent) {
+        dragged?(event.locationInWindow, false)
+    }
+
+    override func mouseUp(with event: NSEvent) {
+        dragged?(event.locationInWindow, true)
+    }
+}
