+- (void)saveOmniTermSettings:(id)sender {
+    if (!_omniSettingsWindow) {
+        return;
+    }
+    const NSInteger interval = MAX(150, MIN(2000, _omniDoubleEscapeIntervalField.integerValue));
+    const NSInteger timeoutMinutes = MAX(1, MIN(525600, _omniDefaultTimeoutField.integerValue));
+    const NSInteger retainedTabs = MAX(1, MIN(100, _omniRetainedTabsField.integerValue));
+    NSString *timezone = _omniTimezoneComboBox.stringValue;
+    if (![NSTimeZone timeZoneWithName:timezone]) {
+        _omniSettingsStatusLabel.textColor = NSColor.systemRedColor;
+        _omniSettingsStatusLabel.stringValue = @"Choose a valid IANA time zone.";
+        return;
+    }
+    iTermShortcut *shortcut = _omniShortcutInputView.shortcut;
+    if (![self applyOmniTermShortcut:shortcut]) {
+        [self refreshOmniTermSettingsControls];
+        _omniSettingsStatusLabel.textColor = NSColor.systemRedColor;
+        _omniSettingsStatusLabel.stringValue = @"That shortcut is already used by another application.";
+        return;
+    }
+    NSError *loginError = nil;
+    const BOOL launchAtLogin = (_omniLaunchAtLoginButton.state == NSControlStateValueOn);
+    if (![self setOmniTermLaunchAtLogin:launchAtLogin error:&loginError]) {
+        [self refreshOmniTermSettingsControls];
+        _omniSettingsStatusLabel.textColor = NSColor.systemRedColor;
+        _omniSettingsStatusLabel.stringValue = loginError.localizedDescription ?: @"Could not change login startup.";
+        return;
+    }
+    NSDictionary *changes = @{
+        @"global_shortcut": shortcut ? shortcut.dictionaryValue : NSNull.null,
+        @"launch_at_login": @(launchAtLogin),
+        @"center_window_on_open": @(_omniCenterOnOpenButton.state == NSControlStateValueOn),
+        @"double_escape_to_hide": @(_omniDoubleEscapeButton.state == NSControlStateValueOn),
+        @"double_escape_interval_ms": @(interval),
+        @"default_timeout_seconds": @(timeoutMinutes * 60),
+        @"retained_run_tabs": @(retainedTabs),
+        @"timezone": timezone,
+    };
+    NSError *settingsError = nil;
+    if (![_omniScheduler updateSettings:changes error:&settingsError]) {
+        _omniSettingsStatusLabel.textColor = NSColor.systemRedColor;
+        _omniSettingsStatusLabel.stringValue = settingsError.localizedDescription ?: @"Could not save settings.";
+        return;
+    }
+    [self applyOmniTermBehaviorSettings:[_omniScheduler currentSettings]];
+    _omniDoubleEscapeIntervalField.integerValue = interval;
+    _omniDefaultTimeoutField.integerValue = timeoutMinutes;
+    _omniRetainedTabsField.integerValue = retainedTabs;
+    _omniDoubleEscapeIntervalField.enabled = (_omniDoubleEscapeButton.state == NSControlStateValueOn);
+    _omniSettingsStatusLabel.textColor = NSColor.systemGreenColor;
+    _omniSettingsStatusLabel.stringValue = @"Saved. Changes apply immediately.";
+}
+
+- (void)resetOmniTermSettings:(id)sender {
+    _omniShortcutInputView.shortcut = [self omniTermDefaultShortcut];
+    _omniLaunchAtLoginButton.state = NSControlStateValueOff;
+    _omniCenterOnOpenButton.state = NSControlStateValueOn;
+    _omniDoubleEscapeButton.state = NSControlStateValueOn;
+    _omniDoubleEscapeIntervalField.integerValue = 350;
+    _omniDefaultTimeoutField.integerValue = 120;
+    _omniRetainedTabsField.integerValue = 10;
+    _omniTimezoneComboBox.stringValue = NSTimeZone.localTimeZone.name;
+    [self saveOmniTermSettings:sender];
+}
