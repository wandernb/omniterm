+- (void)testDissolvingAGroupPromotesItsSubgroups {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSMutableDictionary *base = [[self agentFileNamed:@"Review"] mutableCopy];
+    NSDictionary *groups = @{ @"Review": @"A", @"Nested": @"A/B", @"Elsewhere": @"B" };
+    for (NSString *name in groups) {
+        NSMutableDictionary *agent = [base mutableCopy];
+        agent[@"name"] = name;
+        agent[@"group"] = groups[name];
+        [self request:@{ @"op": @"save_agent", @"agent": agent }];
+    }
+    [self request:@{ @"op": @"set_sidebar_groups", @"groups": @[ @"B", @"A", @"A/B", @"A/C", @"Z" ] }];
+
+    NSDictionary *response = [self request:@{ @"op": @"rename_group", @"from": @"A", @"to": @"" }];
+    XCTAssertEqualObjects(response[@"count"], @2);
+    XCTAssertNil([self agentFileNamed:@"Review"][@"group"]);
+    XCTAssertEqualObjects([self agentFileNamed:@"Nested"][@"group"], @"B");
+    XCTAssertEqualObjects([self agentFileNamed:@"Elsewhere"][@"group"], @"B");
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_groups"], (@[ @"B", @"C", @"Z" ]),
+                          @"A goes, A/B merges into the existing B, A/C becomes C, order kept");
+
+    // Moving a subgroup into its parent promotes its agents there.
+    [self request:@{ @"op": @"set_agent_appearance", @"name": @"Nested", @"group": @"P/Q" }];
+    response = [self request:@{ @"op": @"rename_group", @"from": @"P/Q", @"to": @"P" }];
+    XCTAssertEqualObjects(response[@"count"], @1);
+    XCTAssertEqualObjects([self agentFileNamed:@"Nested"][@"group"], @"P");
+}
