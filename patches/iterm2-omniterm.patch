+- (void)testMuteSilencesBannersButKeepsCountsUntilItExpires {
+    NSDictionary *item = @{ @"severity": @"urgent" };
+    NSDictionary *muted = [self alertFor:item settings:@{ @"muted_until": @2000 }];
+    XCTAssertEqualObjects((muted[@"banner"]), @NO);
+    XCTAssertEqualObjects((muted[@"sound"]), @NO);
+    XCTAssertEqualObjects((muted[@"count"]), @YES);
+    XCTAssertEqualObjects((muted[@"muted"]), @YES);
+    XCTAssertEqualObjects(([self alertFor:item settings:@{ @"muted_until": @999 }][@"banner"]), @YES);
+    XCTAssertEqualObjects(([self alertFor:item settings:@{ @"muted_until": @"forever" }][@"banner"]), @NO);
+    // Mute wins over a kind that always banners.
+    NSDictionary *always = @{ @"muted_until": @"forever", @"kinds": @{ @"agent": @"always" } };
+    XCTAssertEqualObjects(([self alertFor:@{ @"severity": @"info" } settings:always][@"banner"]), @NO);
+}
