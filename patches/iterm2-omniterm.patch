+// The terminal window's panel layout: widths and fractions are numbers,
+// collapsed states booleans. Unknown keys or wrong types refuse the whole
+// layout, so a bad write never mixes into the stored one.
+static NSDictionary *OmniValidLayout(id value) {
+    if (![value isKindOfClass:[NSDictionary class]]) {
+        return nil;
+    }
+    static NSDictionary<NSString *, NSArray<NSNumber *> *> *numberRanges;
+    static NSSet<NSString *> *flags;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        numberRanges = [@{ @"sidebar_width": @[ @0, @2000 ],
+                           @"runs_width": @[ @0, @4000 ],
+                           @"details_share": @[ @0, @1 ],
+                           @"memory_list_width": @[ @0, @4000 ],
+                           @"window_x": @[ @-100000, @100000 ],
+                           @"window_y": @[ @-100000, @100000 ],
+                           @"window_width": @[ @100, @20000 ],
+                           @"window_height": @[ @100, @20000 ],
+                           @"window_space": @[ @0, @1e15 ] } retain];
+        flags = [[NSSet setWithArray:@[ @"sidebar_collapsed", @"runs_collapsed", @"band_collapsed", @"diff_collapsed", @"window_pinned" ]] retain];
+    });
+    NSMutableDictionary *result = [NSMutableDictionary dictionary];
+    for (id key in (NSDictionary *)value) {
+        id entry = ((NSDictionary *)value)[key];
+        if (![key isKindOfClass:[NSString class]] || ![entry isKindOfClass:[NSNumber class]]) {
+            return nil;
+        }
+        NSArray<NSNumber *> *range = numberRanges[key];
+        if (range) {
+            const double number = [entry doubleValue];
+            if (!isfinite(number) || number < range[0].doubleValue || number > range[1].doubleValue ||
+                CFGetTypeID((CFTypeRef)entry) == CFBooleanGetTypeID()) {
+                return nil;
+            }
+            result[key] = entry;
+        } else if ([flags containsObject:key]) {
+            if (CFGetTypeID((CFTypeRef)entry) != CFBooleanGetTypeID()) {
+                return nil;
+            }
+            result[key] = entry;
+        } else {
+            return nil;
+        }
+    }
+    return result;
+}
