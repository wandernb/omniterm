+// MARK: - Run report
+
+final class OmniRunReportPane: OmniPane, NSSplitViewDelegate {
+    let runID: String
+    private let split = NSSplitView()
+    private let scroll = OmniColumnScrollView()
+    private let changesPane = OmniResizingView()
+    private let changesLabel = NSTextField(labelWithString: "")
+    private let diffScroll = NSScrollView()
+    // TextKit 1 from the start: a TextKit 2 view switched over later leaves its
+    // TextKit 2 objects behind for every report page opened.
+    private let diffTextView = NSTextView(usingTextLayoutManager: false)
+    private var lastSignature = ""
+    private var diffSignature = ""
+    private var run: OmniRun?
+    private var buttonRow: OmniButtonRow?
+    private var statusMessage = ""
+    private var showsFinalMessage = false
+    // Once the person drags the divider, it stays where they put it.
+    private var userPlacedDivider = false
+    private var placingDivider = false
+    // Control-Command-4: the report takes the diff's room.
+    private var diffCollapsed = false
+
+    override var contentViews: [NSView] {
+        return [split]
+    }
+
+    private let compact: Bool
+    var contentHeightDidChange: (() -> Void)?
+
+    init(runID: String, compact: Bool = false) {
+        self.runID = runID
+        self.compact = compact
+        super.init()
+        split.isVertical = false
+        split.dividerStyle = .thin
+        split.delegate = self
+        addSubview(split)
+        split.addArrangedSubview(scroll)
+
+        changesPane.fillColor = OmniTheme.wellBackground
+        changesLabel.font = OmniTheme.Font.sectionHeader
+        changesLabel.textColor = OmniTheme.secondaryText
+        changesPane.addSubview(changesLabel)
+        diffScroll.hasVerticalScroller = true
+        diffScroll.hasHorizontalScroller = true
+        diffScroll.autohidesScrollers = true
+        diffScroll.borderType = .noBorder
+        diffScroll.drawsBackground = false
+        diffTextView.isEditable = false
+        diffTextView.isSelectable = true
+        diffTextView.isRichText = false
+        diffTextView.importsGraphics = false
+        diffTextView.isAutomaticLinkDetectionEnabled = false
+        diffTextView.isAutomaticDataDetectionEnabled = false
+        diffTextView.drawsBackground = false
+        diffTextView.textContainerInset = NSSize(width: 20, height: 10)
+        diffTextView.minSize = .zero
+        diffTextView.maxSize = NSSize(width: CGFloat.greatestFiniteMagnitude, height: CGFloat.greatestFiniteMagnitude)
+        diffTextView.isVerticallyResizable = true
+        diffTextView.isHorizontallyResizable = true
+        diffTextView.textContainer?.widthTracksTextView = false
+        diffTextView.textContainer?.containerSize = NSSize(width: CGFloat.greatestFiniteMagnitude,
+                                                           height: CGFloat.greatestFiniteMagnitude)
+        diffScroll.documentView = diffTextView
+        changesPane.addSubview(diffScroll)
+        changesPane.didResize = { [weak self] size in self?.layoutChanges(size) }
+        split.addArrangedSubview(changesPane)
+        changesPane.isHidden = true
+        NotificationCenter.default.addObserver(self, selector: #selector(splitDidResize(_:)),
+                                               name: NSSplitView.didResizeSubviewsNotification, object: split)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    deinit {
+        NotificationCenter.default.removeObserver(self)
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        split.frame = bounds
+        placeDivider()
+    }
+
+    // The least height the diff keeps under the report: its header and a
+    // few lines, or a third of a short pane.
+    static let diffMinHeight: CGFloat = 120
+
+    // The report's height above the diff: what its text needs, so nothing is
+    // cut mid-line, up to what leaves the diff its room; beyond that the
+    // report scrolls.
+    static func reportHeight(wanted: CGFloat, total: CGFloat) -> CGFloat {
+        guard total > 0 else { return 0 }
+        let most = max(total * 0.4, total - min(diffMinHeight, total * 0.35))
+        let least = min(160, most)
+        return max(least, min(ceil(wanted), most)).rounded(.down)
+    }
+
+    private func placeDivider() {
+        guard !changesPane.isHidden, !userPlacedDivider, split.bounds.height > 0 else { return }
+        let total = split.bounds.height - split.dividerThickness
+        scroll.relayout()
+        let position = Self.reportHeight(wanted: scroll.column.frame.height, total: total)
+        guard abs(scroll.frame.height - position) >= 1 else { return }
+        placingDivider = true
+        split.setPosition(position, ofDividerAt: 0)
+        placingDivider = false
+    }
+
+    @objc private func splitDidResize(_ notification: Notification) {
+        guard !placingDivider, notification.userInfo?["NSSplitViewDividerIndex"] != nil,
+              NSApp.currentEvent?.type == .leftMouseDragged else { return }
+        userPlacedDivider = true
+    }
+
+    // The report's visible area and its content, for tests.
+    var reportVisibleHeight: CGFloat {
+        return scroll.contentView.bounds.height
+    }
+
+    var reportContentHeight: CGFloat {
+        return scroll.column.frame.height
+    }
+
+    private func layoutChanges(_ size: NSSize) {
+        changesLabel.frame = NSRect(x: 28, y: 10, width: max(0, size.width - 56), height: 16)
+        diffScroll.frame = NSRect(x: 0, y: 30, width: size.width, height: max(0, size.height - 30))
+    }
+
+    func splitView(_ splitView: NSSplitView, constrainMinCoordinate proposedMinimumPosition: CGFloat,
+                   ofSubviewAt dividerIndex: Int) -> CGFloat {
+        return 160
+    }
+
+    func splitView(_ splitView: NSSplitView, constrainMaxCoordinate proposedMaximumPosition: CGFloat,
+                   ofSubviewAt dividerIndex: Int) -> CGFloat {
+        return splitView.bounds.height - 100
+    }
+
+    func splitView(_ splitView: NSSplitView, shouldAdjustSizeOfSubview view: NSView) -> Bool {
+        // The report keeps its height when the window grows, unless there is
+        // no diff below it to take the space.
+        return view !== scroll || changesPane.isHidden
+    }
+
+    // Whether a diff is on screen under the report.
+    var showsDiff: Bool {
+        return !changesPane.isHidden
+    }
+
+    override func applyPanelLayout(_ layout: OmniPanelLayout) {
+        guard layout.diffCollapsed != diffCollapsed else { return }
+        diffCollapsed = layout.diffCollapsed
+        if let run {
+            updateChanges(run)
+            contentHeightDidChange?()
+        }
+    }
+
+    override func reload() {
+        OmniSchedulerClient.request(["op": "get_run", "id": runID]) { [weak self] response in
+            self?.render(response)
+        }
+    }
+
+    private func render(_ response: [AnyHashable: Any]) {
+        guard Self.isOK(response) else {
+            lastSignature = ""
+            if response["code"] as? String == "run_not_found" {
+                showMessage("This run is no longer in the history.")
+            } else {
+                showMessage(Self.unreachableMessage(response))
+            }
+            return
+        }
+        guard let row = response["run"] as? [AnyHashable: Any], let run = OmniRun(row) else {
+            lastSignature = ""
+            showMessage("This run’s report could not be read.")
+            return
+        }
+        let signature = Self.signature(row, showsFinalMessage)
+        guard signature != lastSignature else { return }
+        lastSignature = signature
+        self.run = run
+        showContent()
+        scroll.rebuildKeepingScroll { rebuildReport(run) }
+        updateChanges(run)
+        contentHeightDidChange?()
+    }
+
+    private func rebuildReport(_ run: OmniRun) {
+        let column = scroll.column
+        column.removeAll()
+        if !compact {
+            addHeader(run, to: column)
+        }
+        addFacts(run, to: column)
+    }
+
+    private func addHeader(_ run: OmniRun, to column: OmniColumnView) {
+        column.add(Self.badgeRow(run.outcomeName, color: run.outcomeColor), spacing: 8) { _ in 18 }
+        column.addText(Self.title(run.agent), spacing: 4)
+        var meta = [OmniFormat.date(run.started)]
+        if let provider = run.provider {
+            meta.append(provider.capitalized)
+        }
+        if run.origin == "manual" {
+            meta.append("Started by hand")
+        }
+        column.addText(Self.meta(meta), spacing: 12)
+
+        let resumeButton = OmniPaneText.button("Resume", target: self, action: #selector(resume(_:)))
+        resumeButton.isEnabled = run.canResume
+        let terminalButton = OmniPaneText.button("Open Terminal", target: self, action: #selector(openTerminal(_:)))
+        terminalButton.isHidden = !run.isLive
+        let agentButton = OmniPaneText.button("Show Agent", target: self, action: #selector(showAgent(_:)))
+        let row = OmniButtonRow([terminalButton, resumeButton, agentButton])
+        row.status.stringValue = statusMessage
+        buttonRow = row
+        column.add(row, spacing: 12) { _ in 30 }
+    }
+
+    private func addFacts(_ run: OmniRun, to column: OmniColumnView) {
+
+        var facts: [(String, String)] = [("Started", OmniFormat.date(run.started))]
+        if let finished = run.finished {
+            facts.append(("Finished", "\(OmniFormat.date(finished)) · took \(OmniFormat.duration(from: run.started, to: finished))"))
+        } else if run.isLive {
+            facts.append(("Running for", OmniFormat.duration(from: run.started, to: Date())))
+        }
+        if let reason = run.reason, !run.isLive {
+            facts.append(("Ended because", reason))
+        }
+        facts.append(("Workspace", OmniFormat.path(run.workspace)))
+        if let branch = run.branch {
+            facts.append(("Branch", branch))
+        }
+        if let range = run.headRange {
+            facts.append(("Head", range))
+        }
+        if let pr = run.prURL {
+            facts.append(("Pull request", pr))
+        }
+        // Empty sections are left out; a reason there is no diff is a fact.
+        if run.diffFiles.isEmpty, let note = diffNote(run) {
+            facts.append(("Changes", note))
+        }
+        column.addText(Self.facts(facts))
+
+        column.addSection("Summary")
+        if let note = summaryNote(run) {
+            column.addText(OmniPaneText.label(note, size: 12, color: OmniTheme.secondaryText), spacing: 6)
+        }
+        if let text = Self.shownSummary(run) {
+            column.addMarkdownCard(OmniPaneText.report(text, markdown: true))
+        } else if summaryNote(run) == nil {
+            column.addText(OmniPaneText.label("No summary yet.", color: OmniTheme.tertiaryText))
+        }
+
+        if let finalMessage = run.finalMessage {
+            let disclosure = NSButton(title: "", target: self, action: #selector(toggleFinalMessage(_:)))
+            disclosure.bezelStyle = .disclosure
+            disclosure.setButtonType(.pushOnPushOff)
+            disclosure.state = showsFinalMessage ? .on : .off
+            let label = OmniTheme.sectionHeader("Agent’s final message")
+            let header = OmniDisclosureHeader(button: disclosure, label: label)
+            column.add(NSView(), spacing: 0) { _ in 10 }
+            column.add(header, spacing: 6) { _ in 20 }
+            if showsFinalMessage {
+                column.addMarkdownCard(OmniPaneText.report(finalMessage, markdown: true), indent: 4)
+            }
+        }
+
+        if !run.commits.isEmpty {
+            column.addSection(run.commits.count == 1 ? "1 commit" : "\(run.commits.count) commits")
+            let text = run.commits.map { "\($0.sha.prefix(8))  \($0.subject)" }.joined(separator: "\n")
+            column.addText(OmniPaneText.report(text, markdown: false, size: 13))
+        }
+        if !run.diffFiles.isEmpty {
+            column.addSection(run.diffFiles.count == 1 ? "1 changed file" : "\(run.diffFiles.count) changed files")
+            column.addText(OmniPaneText.report(run.diffFiles.joined(separator: "\n"), markdown: false, size: 13))
+        }
+    }
+
+    // The summary to show, or nil when it would render as nothing (blank, or
+    // Markdown with no text), so the section never stands empty.
+    static func shownSummary(_ run: OmniRun) -> String? {
+        guard let text = run.summary ?? (run.summaryState == "failed" ? run.finalMessage : nil) else { return nil }
+        let rendered = OmniReportText.attributed(text).string
+        return rendered.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? nil : text
+    }
+
+    // The height the report needs: all of its column, or as much as it can
+    // get when a diff is shown below it.
+    var preferredHeight: CGFloat {
+        guard let run else { return 160 }
+        return run.hasDiff && !diffCollapsed ? .greatestFiniteMagnitude : scroll.column.frame.height
+    }
+
+    private func summaryNote(_ run: OmniRun) -> String? {
+        switch run.summaryState {
+        case "pending": return "Writing a summary…"
+        case "failed": return "The summary could not be written, so this is the agent’s final message."
+        case nil where run.isLive: return "The summary is written when the agent finishes its turn."
+        default: return nil
+        }
+    }
+
+    private func diffNote(_ run: OmniRun) -> String? {
+        switch run.diffState {
+        case "pending": return "Capturing the diff…"
+        case "truncated": return "The diff was too large and is shown only in part."
+        case "failed": return "The diff could not be captured."
+        case "not_a_repository": return "The workspace is not a Git repository, so no diff was captured."
+        case "no_workspace": return "The workspace did not exist when the run ended."
+        case "no_git": return "Git is not installed, so no diff was captured."
+        case "clean": return "The run left no changes."
+        case "expired": return "The diff was removed by retention."
+        default: return nil
+        }
+    }
+
+    private func updateChanges(_ run: OmniRun) {
+        let showsChanges = run.hasDiff && !diffCollapsed
+        if changesPane.isHidden == showsChanges {
+            changesPane.isHidden = !showsChanges
+            split.adjustSubviews()
+        }
+        guard showsChanges else { return }
+        placeDivider()
+        let signature = Self.signature(run.diffState ?? "", run.headEnd ?? "", run.diffFiles)
+        guard signature != diffSignature else { return }
+        diffSignature = signature
+        changesLabel.stringValue = run.diffState == "truncated" ? "DIFF SINCE THE RUN STARTED · TRUNCATED" : "DIFF SINCE THE RUN STARTED"
+        OmniSchedulerClient.request(["op": "run_diff", "id": runID]) { [weak self] response in
+            guard let self else { return }
+            let mono = OmniTheme.Font.mono
+            guard Self.isOK(response), let diff = response["diff"] as? String,
+                  !diff.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+                // A captured diff that is empty means the run changed nothing.
+                let empty = Self.isOK(response)
+                if !empty {
+                    self.diffSignature = ""
+                }
+                self.diffTextView.textStorage?.setAttributedString(NSAttributedString(
+                    string: empty ? "No changes since the run started." : "The diff could not be loaded.",
+                    attributes: [.font: OmniTheme.Font.meta, .foregroundColor: OmniTheme.secondaryText]))
+                return
+            }
+            self.diffTextView.textStorage?.setAttributedString(
+                OmniInboxViewController.colouredDiff(OmniReportText.sanitized(diff), font: mono))
+            self.diffTextView.scroll(.zero)
+        }
+    }
+
+    private func setStatus(_ message: String) {
+        statusMessage = message
+        buttonRow?.status.stringValue = message
+    }
+
+    @objc private func toggleFinalMessage(_ sender: NSButton) {
+        showsFinalMessage = sender.state == .on
+        lastSignature = ""
+        reload()
+    }
+
+    @objc private func resume(_ sender: Any?) {
+        setStatus("Resuming…")
+        OmniSchedulerClient.request(["op": "resume_run", "run_id": runID]) { [weak self] response in
+            guard let self else { return }
+            guard Self.isOK(response), let newRunID = response["run_id"] as? String else {
+                self.setStatus(response["error"] as? String ?? "The run could not be resumed.")
+                return
+            }
+            self.setStatus("")
+            self.actions?.paneExpectTab(forRun: newRunID, showing: .run(newRunID), from: .run(self.runID))
+        }
+    }
+
+    @objc private func openTerminal(_ sender: Any?) {
+        if actions?.paneShowTerminal(forRun: runID) != true {
+            setStatus("This run’s terminal is not open.")
+        }
+    }
+
+    @objc private func showAgent(_ sender: Any?) {
+        guard let run else { return }
+        actions?.paneOpen(.agent(run.agent))
+    }
+}
