+// One ticket: a row in the list, or a card on the board.
+final class OmniTicketRow: NSView, OmniZoneItem, OmniContextRow {
+    static let listHeight: CGFloat = 34
+    static let cardHeight: CGFloat = 62
+    private let ticket: OmniTicket
+    private let fields: [OmniTicketField]
+    private let card: Bool
+    private let action: () -> Void
+    private let statusIcon = NSImageView()
+    private let number = NSTextField(labelWithString: "")
+    private let title = NSTextField(labelWithString: "")
+    private let meta = NSTextField(labelWithString: "")
+    private let priorityIcon = NSImageView()
+    private var hovering = false {
+        didSet { needsDisplay = true }
+    }
+    var isSelected = false {
+        didSet { needsDisplay = true }
+    }
+    var zoneHasFocus = false {
+        didSet { needsDisplay = true }
+    }
+
+    override var isFlipped: Bool { true }
+
+    var contextMenu: (() -> NSMenu?)?
+
+    override func menu(for event: NSEvent) -> NSMenu? {
+        return contextMenu?() ?? super.menu(for: event)
+    }
+
+    override func resetCursorRects() {
+        addCursorRect(bounds, cursor: .pointingHand)
+    }
+
+    init(ticket: OmniTicket, fields: [OmniTicketField], card: Bool, action: @escaping () -> Void) {
+        self.ticket = ticket
+        self.fields = fields
+        self.card = card
+        self.action = action
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: card ? Self.cardHeight : Self.listHeight))
+        statusIcon.image = OmniTicketsController.image(ticket.status.symbol, color: ticket.status.color)
+        statusIcon.isHidden = card && !fields.contains(.status)
+        addSubview(statusIcon)
+        priorityIcon.image = OmniTicketsController.image(ticket.priority.symbol, color: ticket.priority.color)
+        priorityIcon.isHidden = !fields.contains(.priority)
+        priorityIcon.toolTip = ticket.priority.label
+        addSubview(priorityIcon)
+        number.stringValue = "#\(ticket.number)"
+        number.font = NSFont.monospacedDigitSystemFont(ofSize: OmniTheme.Font.rowDetail.pointSize, weight: .regular)
+        number.textColor = OmniTheme.secondaryText
+        number.isHidden = !fields.contains(.number)
+        addSubview(number)
+        title.stringValue = ticket.title.isEmpty ? "Untitled" : ticket.title
+        title.font = card ? OmniTheme.Font.rowTitleEmphasized : OmniTheme.Font.rowTitle
+        title.textColor = ticket.title.isEmpty || ticket.status == .discarded ? OmniTheme.secondaryText : .labelColor
+        title.lineBreakMode = .byTruncatingTail
+        if card {
+            title.maximumNumberOfLines = 2
+            title.cell?.wraps = true
+            title.cell?.truncatesLastVisibleLine = true
+        }
+        addSubview(title)
+        var parts: [String] = []
+        if fields.contains(.status) && !card {
+            parts.append(ticket.status.label)
+        }
+        if fields.contains(.priority) {
+            parts.append(ticket.priority.label)
+        }
+        if fields.contains(.updated) {
+            parts.append(OmniTicketsModel.updatedText(ticket.updated))
+        }
+        meta.stringValue = parts.joined(separator: " · ")
+        meta.font = OmniTheme.Font.rowDetail
+        meta.textColor = OmniTheme.secondaryText
+        meta.alignment = card ? .left : .right
+        meta.lineBreakMode = .byTruncatingTail
+        addSubview(meta)
+        addTrackingArea(NSTrackingArea(rect: .zero, options: [.mouseEnteredAndExited, .activeInKeyWindow, .inVisibleRect],
+                                       owner: self, userInfo: nil))
+        setAccessibilityRole(.button)
+        setAccessibilityLabel("#\(ticket.number) \(ticket.title), \(ticket.status.label), \(ticket.priority.label)")
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        if card {
+            let left: CGFloat = 10
+            title.frame = NSRect(x: left, y: 8, width: max(0, bounds.width - left - 28), height: 34)
+            priorityIcon.frame = NSRect(x: bounds.width - 24, y: 9, width: 16, height: 16)
+            var x = left
+            if !statusIcon.isHidden {
+                statusIcon.frame = NSRect(x: x, y: bounds.height - 21, width: 14, height: 14)
+                x += 18
+            }
+            if !number.isHidden {
+                number.sizeToFit()
+                number.frame.origin = NSPoint(x: x, y: bounds.height - 21)
+                x = number.frame.maxX + 6
+            }
+            meta.frame = NSRect(x: x, y: bounds.height - 21, width: max(0, bounds.width - x - 8), height: 15)
+            return
+        }
+        var x: CGFloat = 8
+        if !priorityIcon.isHidden {
+            priorityIcon.frame = NSRect(x: x, y: 9, width: 16, height: 16)
+            x += 22
+        }
+        if !number.isHidden {
+            number.frame = NSRect(x: x, y: 10, width: 44, height: 15)
+            x += 46
+        }
+        statusIcon.frame = NSRect(x: x, y: 9, width: 16, height: 16)
+        x += 22
+        let metaWidth = min(220, ceil(meta.attributedStringValue.size().width) + 6)
+        meta.frame = NSRect(x: bounds.width - metaWidth - 10, y: 10, width: metaWidth, height: 15)
+        title.frame = NSRect(x: x, y: 8, width: max(0, meta.frame.minX - x - 8), height: 18)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        if card {
+            let path = NSBezierPath(roundedRect: bounds.insetBy(dx: 0.5, dy: 0.5), xRadius: 6, yRadius: 6)
+            OmniTheme.cardFill.setFill()
+            path.fill()
+            OmniTheme.cardBorder.setStroke()
+            path.lineWidth = 1
+            path.stroke()
+        }
+        OmniZoneItemStyle.drawBackground(in: bounds, selected: isSelected, focused: zoneHasFocus, hovering: hovering)
+    }
+
+    override func mouseEntered(with event: NSEvent) {
+        hovering = true
+    }
+
+    override func mouseExited(with event: NSEvent) {
+        hovering = false
+    }
+
+    override func mouseDown(with event: NSEvent) {
+    }
+
+    override func mouseUp(with event: NSEvent) {
+        if bounds.contains(convert(event.locationInWindow, from: nil)) {
+            activate()
+        }
+    }
+
+    func activate() {
+        action()
+    }
+
+    override func accessibilityPerformPress() -> Bool {
+        activate()
+        return true
+    }
+}
