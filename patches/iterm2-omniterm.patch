+//
+//  OmniPanelLayoutTests.swift
+//  ModernTests
+//
+//  The agent page's Runs | Report split at the widths a window gives it,
+//  the stored panel layout's round trip, and facts that never wrap a path
+//  one character per line.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniPanelLayoutTests: XCTestCase {
+    // The page's width in a window of each size, beside the default sidebar.
+    private static func pageWidth(window: CGFloat) -> CGFloat {
+        return window - OmniSidebarViewController.defaultWidth
+    }
+
+    private func details(width: CGFloat, layout: OmniPanelLayout = OmniPanelLayout()) -> OmniAgentDetailsView {
+        let view = OmniAgentDetailsView(agentName: "Alpha")
+        let store = OmniPanelLayoutStore()
+        store.restore(layout)
+        view.layoutStore = store
+        view.applyPanelLayout(layout)
+        let runs = (0..<4).compactMap { index in
+            OmniRun(["id": "run-\(index)", "agent": "Alpha", "state": "evicted",
+                     "started": 1_800_000_000 + index * 600, "finished": 1_800_000_060 + index * 600])
+        }
+        view.show(agent: ["name": "Alpha", "provider": "claude", "enabled": true,
+                          "workspace": "/Users/someone/Projects/a-very-long-workspace-name/without/any/spaces/at/all"],
+                  runs: runs, selected: "run-0")
+        view.setFrameSize(NSSize(width: width, height: 600))
+        view.resizeSubviews(withOldSize: .zero)
+        return view
+    }
+
+    private func assertSideBySide(_ view: OmniAgentDetailsView, width: CGFloat, file: StaticString = #filePath,
+                                  line: UInt = #line) {
+        XCTAssertFalse(view.isStacked, "\(width) pt is wide enough for both columns", file: file, line: line)
+        let runs = view.runsFrame ?? .zero
+        XCTAssertGreaterThanOrEqual(runs.width, OmniAgentPageGeometry.runsMinWidth, "runs at \(width)", file: file, line: line)
+        XCTAssertGreaterThanOrEqual(view.reportFrame.width, OmniAgentPageGeometry.reportMinWidth, "report at \(width)",
+                                    file: file, line: line)
+        XCTAssertLessThanOrEqual(runs.maxX, view.reportFrame.minX, file: file, line: line)
+        XCTAssertLessThanOrEqual(view.reportFrame.maxX, width + 0.5, "Nothing runs off the page", file: file, line: line)
+    }
+
+    func testTheRunsAndReportKeepTheirMinimumWidthsAt1000And1600() {
+        for window: CGFloat in [1000, 1600] {
+            let width = Self.pageWidth(window: window)
+            assertSideBySide(details(width: width), width: width)
+        }
+    }
+
+    func testAt700TheReportStacksUnderTheRuns() {
+        let width = Self.pageWidth(window: 700)
+        let view = details(width: width)
+        XCTAssertTrue(view.isStacked)
+        let runs = view.runsFrame ?? .zero
+        XCTAssertEqual(runs.width, width, accuracy: 0.5, "Stacked, the runs take the page's width")
+        XCTAssertEqual(view.reportFrame.width, width, accuracy: 0.5)
+        XCTAssertLessThanOrEqual(runs.maxY, view.reportFrame.minY, "The report is under the runs")
+        XCTAssertGreaterThanOrEqual(runs.height, OmniAgentPageGeometry.stackedMinHeight)
+        XCTAssertGreaterThanOrEqual(view.reportFrame.height, OmniAgentPageGeometry.stackedMinHeight)
+    }
+
+    func testTheThresholdIsWhereBothMinimumsNoLongerFit() {
+        XCTAssertTrue(details(width: OmniAgentPageGeometry.stackBelowWidth - 1).isStacked)
+        assertSideBySide(details(width: OmniAgentPageGeometry.stackBelowWidth), width: OmniAgentPageGeometry.stackBelowWidth)
+        XCTAssertGreaterThan(OmniAgentPageGeometry.stackBelowWidth,
+                             OmniAgentPageGeometry.runsMinWidth + OmniAgentPageGeometry.reportMinWidth)
+    }
+
+    func testAStoredRunsWidthIsKeptWithinTheMinimums() {
+        var layout = OmniPanelLayout()
+        layout.runsWidth = 500
+        XCTAssertEqual(details(width: 1360, layout: layout).runsFrame?.width ?? 0, 500, accuracy: 0.5)
+        layout.runsWidth = 900
+        let squeezed = details(width: 1000, layout: layout)
+        assertSideBySide(squeezed, width: 1000)
+        layout.runsWidth = 40
+        XCTAssertEqual(details(width: 1000, layout: layout).runsFrame?.width ?? 0, OmniAgentPageGeometry.runsMinWidth,
+                       accuracy: 0.5)
+    }
+
+    func testCollapsedRunsGiveTheReportThePage() {
+        var layout = OmniPanelLayout()
+        layout.runsCollapsed = true
+        let view = details(width: 1000, layout: layout)
+        XCTAssertNil(view.runsFrame)
+        XCTAssertGreaterThanOrEqual(view.reportFrame.width, 999, "All but the divider")
+    }
+
+    // MARK: - Stored layout
+
+    func testTheLayoutRoundTripsThroughItsStoredForm() {
+        var layout = OmniPanelLayout()
+        layout.sidebarWidth = 300
+        layout.sidebarCollapsed = true
+        layout.runsWidth = 420
+        layout.runsCollapsed = true
+        layout.detailsShare = 0.5
+        layout.bandCollapsed = true
+        layout.diffCollapsed = true
+        let stored = try? JSONSerialization.jsonObject(with: JSONSerialization.data(withJSONObject: layout.dictionary))
+        XCTAssertEqual(OmniPanelLayout(stored: stored as? [AnyHashable: Any]), layout)
+        XCTAssertEqual(OmniPanelLayout(stored: [:]), OmniPanelLayout())
+        XCTAssertEqual(OmniPanelLayout(stored: nil).shownSidebarWidth, OmniSidebarViewController.defaultWidth)
+    }
+
+    func testStoredValuesAreKeptInRange() {
+        let layout = OmniPanelLayout(stored: ["sidebar_width": 5000, "details_share": 0.01, "runs_collapsed": "yes"])
+        XCTAssertEqual(layout.sidebarWidth, OmniPanelLayout.sidebarMaxWidth)
+        XCTAssertEqual(layout.detailsShare, OmniPanelLayout.detailsShareRange.lowerBound)
+        XCTAssertFalse(layout.runsCollapsed, "A malformed flag keeps its default")
+    }
+
+    func testAStoreSavesFinalChangesOnly() {
+        let store = OmniPanelLayoutStore()
+        var saved: [OmniPanelLayout] = []
+        var shown: [OmniPanelLayout] = []
+        store.save = { saved.append($0) }
+        store.didChange = { shown.append($0) }
+        store.update(saving: false) { $0.sidebarWidth = 250 }
+        store.update(saving: false) { $0.sidebarWidth = 260 }
+        XCTAssertEqual(saved.count, 0, "A drag in progress is not saved")
+        store.update(saving: true) { $0.sidebarWidth = 260 }
+        XCTAssertEqual(saved.map(\.sidebarWidth), [260], "Its end is, even with nothing new")
+        XCTAssertEqual(shown.map(\.sidebarWidth), [250, 260])
+        var restored = OmniPanelLayout()
+        restored.bandCollapsed = true
+        store.restore(restored)
+        XCTAssertEqual(saved.count, 1, "What was read back is not written again")
+        XCTAssertTrue(store.layout.bandCollapsed)
+    }
+
+    // MARK: - Facts
+
+    func testAPathTruncatesInsteadOfWrappingByCharacter() {
+        let path = "/Users/someone/Projects/a-very-long-workspace-name/without/any/spaces/at/all"
+        let field = OmniPane.facts([("Workspace", path), ("Provider", "Claude")])
+        let narrow = field.sizeThatFits(NSSize(width: 220, height: CGFloat.greatestFiniteMagnitude)).height
+        let wide = field.sizeThatFits(NSSize(width: 1200, height: CGFloat.greatestFiniteMagnitude)).height
+        XCTAssertEqual(narrow, wide, accuracy: 1, "The path keeps to its one line")
+
+        let prose = OmniPane.facts([("Startup prompt", "Review the open pull requests and summarise what changed")])
+        let wrapped = prose.sizeThatFits(NSSize(width: 220, height: CGFloat.greatestFiniteMagnitude)).height
+        let single = prose.sizeThatFits(NSSize(width: 1200, height: CGFloat.greatestFiniteMagnitude)).height
+        XCTAssertGreaterThan(wrapped, single, "Prose still wraps, by word")
+    }
+
+    // MARK: - Window frame
+
+    func testTheWindowFrameRoundTripsAndNeedsAllFourValues() {
+        var layout = OmniPanelLayout()
+        layout.windowFrame = NSRect(x: 100, y: 80, width: 1200, height: 800)
+        let stored = try? JSONSerialization.jsonObject(with: JSONSerialization.data(withJSONObject: layout.dictionary))
+        XCTAssertEqual(OmniPanelLayout(stored: stored as? [AnyHashable: Any]).windowFrame, layout.windowFrame)
+        XCTAssertNil(OmniPanelLayout(stored: ["window_x": 1, "window_y": 2, "window_width": 900]).windowFrame)
+        XCTAssertNil(OmniPanelLayout(stored: ["window_x": 1, "window_y": 2, "window_width": 50, "window_height": 50]).windowFrame,
+                     "A frame too small to use is ignored")
+    }
+
+    func testARestoredFrameKeepsItsSizeAndStaysOnTheScreen() {
+        let visible = NSRect(x: 0, y: 40, width: 1440, height: 860)
+        let stored = NSRect(x: 200, y: 100, width: 1000, height: 700)
+        XCTAssertEqual(OmniPanelLayout.restoredWindowFrame(stored, in: visible, centered: false), stored, "It fits as it was")
+
+        let offScreen = NSRect(x: 3000, y: -500, width: 1000, height: 700)
+        XCTAssertEqual(OmniPanelLayout.restoredWindowFrame(offScreen, in: visible, centered: false),
+                       NSRect(x: 440, y: 40, width: 1000, height: 700), "Moved wholly onto the screen, same size")
+
+        let tooBig = NSRect(x: 0, y: 0, width: 1920, height: 1204)
+        XCTAssertEqual(OmniPanelLayout.restoredWindowFrame(tooBig, in: visible, centered: false), visible,
+                       "Never larger than the screen's visible area")
+
+        XCTAssertEqual(OmniPanelLayout.restoredWindowFrame(stored, in: visible, centered: true),
+                       NSRect(x: 220, y: 120, width: 1000, height: 700), "Centred under the pointer, same size")
+    }
+}
+
+
+// A run's report above its diff, on a run page whose details start small
+// (before the window gives them their height) and then grow.
+final class OmniRunReportSplitTests: XCTestCase {
+    private var diff = ""
+
+    override func setUp() {
+        super.setUp()
+        let run: [String: Any] = [
+            "id": "run-1", "agent": "Wren Daily", "state": "running", "started": 1_800_000_000,
+            "workspace": "/Users/someone/Projects/wren", "branch": "main",
+            "summary": "Reviewed the open pull requests and left comments on two of them. Nothing needed merging today.",
+            "diff_state": "captured", "diff_files": ["README.md"],
+        ]
+        OmniSchedulerClient.testTransport = { [unowned self] request, completion in
+            let response: [AnyHashable: Any]
+            switch request["op"] as? String {
+            case "get_run": response = ["ok": true, "run": run]
+            case "run_diff": response = ["ok": true, "diff": self.diff]
+            default: response = ["ok": false]
+            }
+            DispatchQueue.main.async { completion(response) }
+        }
+    }
+
+    override func tearDown() {
+        OmniSchedulerClient.testTransport = nil
+        super.tearDown()
+    }
+
+    private func wait(_ message: String, until condition: () -> Bool) {
+        let deadline = Date().addingTimeInterval(5)
+        while !condition() && Date() < deadline {
+            RunLoop.main.run(mode: .default, before: Date().addingTimeInterval(0.01))
+        }
+        XCTAssertTrue(condition(), message)
+    }
+
+    private func diffText(_ pane: NSView) -> String {
+        func find(_ view: NSView) -> [NSTextView] {
+            return (view as? NSTextView).map { [$0] } ?? view.subviews.flatMap(find)
+        }
+        return find(pane).map(\.string).joined()
+    }
+
+    func testTheReportGetsTheHeightItsTextNeedsOnceTheDetailsGrow() {
+        let pane = OmniRunReportPane(runID: "run-1", compact: true)
+        pane.setFrameSize(NSSize(width: 700, height: 160))
+        pane.reload()
+        wait("the report and the empty diff load") { diffText(pane).contains("No changes since the run started.") }
+        pane.setFrameSize(NSSize(width: 700, height: 520))
+        XCTAssertTrue(pane.showsDiff)
+        XCTAssertGreaterThanOrEqual(pane.reportVisibleHeight, pane.reportContentHeight - 0.5,
+                                    "The whole report shows: nothing is cut mid-line")
+    }
+
+    func testAShortPaneKeepsRoomForBothAndTheReportScrolls() {
+        let pane = OmniRunReportPane(runID: "run-1", compact: true)
+        pane.setFrameSize(NSSize(width: 700, height: 300))
+        pane.reload()
+        wait("the report loads") { pane.reportContentHeight > 100 && pane.showsDiff }
+        pane.setFrameSize(NSSize(width: 700, height: 300))
+        XCTAssertGreaterThanOrEqual(pane.reportVisibleHeight, 160 - 0.5, "Enough of the report to read")
+        XCTAssertLessThanOrEqual(pane.reportVisibleHeight, 300 - min(OmniRunReportPane.diffMinHeight, 300 * 0.35) + 0.5,
+                                 "and the diff keeps its room")
+    }
+
+    func testTheReportHeightRule() {
+        XCTAssertEqual(OmniRunReportPane.reportHeight(wanted: 200, total: 600), 200, "What the text needs")
+        XCTAssertEqual(OmniRunReportPane.reportHeight(wanted: 2000, total: 600), 480, "Up to the diff's room")
+        XCTAssertEqual(OmniRunReportPane.reportHeight(wanted: 40, total: 600), 160, "Never a sliver")
+        XCTAssertEqual(OmniRunReportPane.reportHeight(wanted: 2000, total: 200), 130)
+        XCTAssertEqual(OmniRunReportPane.reportHeight(wanted: 10, total: 0), 0)
+    }
+}
