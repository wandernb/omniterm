+//
+//  OmniTicketsTests.swift
+//  ModernTests
+//
+//  A project's Tickets tab: grouping and filtering, and the store, which
+//  must never lose a file it cannot read.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniTicketsTests: XCTestCase {
+    private var savedDirectory: URL!
+    private var temp: URL!
+
+    override func setUp() {
+        super.setUp()
+        savedDirectory = OmniTicketStore.directory
+        temp = FileManager.default.temporaryDirectory.appendingPathComponent("omni-tickets-\(UUID().uuidString)")
+        OmniTicketStore.directory = temp
+    }
+
+    override func tearDown() {
+        OmniTicketStore.directory = savedDirectory
+        try? FileManager.default.removeItem(at: temp)
+        super.tearDown()
+    }
+
+    private func ticket(_ number: Int, _ status: OmniTicketStatus, _ priority: OmniTicketPriority) -> OmniTicket {
+        let date = Date(timeIntervalSince1970: TimeInterval(1_800_000_000 + number))
+        return OmniTicket(id: "t\(number)", number: number, title: "T\(number)", content: "", status: status,
+                          priority: priority, created: date, updated: date)
+    }
+
+    func testGroupsFollowFilterAndOrderByPriority() {
+        let tickets = [ticket(1, .open, .longTerm), ticket(2, .open, .urgent), ticket(3, .done, .urgent),
+                       ticket(4, .discarded, .urgent), ticket(5, .inProgress, .shortTerm)]
+        var view = OmniTicketView()
+        let groups = OmniTicketsModel.groups(tickets, view: view)
+        XCTAssertEqual(groups.map(\.key), ["open", "in_progress", "done"])
+        XCTAssertEqual(groups[0].tickets.map(\.number), [2, 1])
+        view.grouping = .priority
+        view.statuses = [.open, .inProgress]
+        let byPriority = OmniTicketsModel.groups(tickets, view: view)
+        XCTAssertEqual(byPriority.map(\.key), ["urgent", "short_term", "middle_term", "long_term"])
+        XCTAssertEqual(byPriority[0].tickets.map(\.number), [2])
+        XCTAssertEqual(OmniTicketsModel.neighbour(of: tickets[1], delta: 1, view: view), "short_term")
+        XCTAssertNil(OmniTicketsModel.neighbour(of: tickets[1], delta: -1, view: view))
+    }
+
+    func testStoreRoundTripsAndKeepsAnUnreadableFile() throws {
+        var file = OmniTicketFile(root: "/projects/demo")
+        file.tickets = [ticket(1, .inProgress, .urgent)]
+        file.nextNumber = 2
+        file.view.layout = .board
+        XCTAssertTrue(OmniTicketStore.save(file))
+        XCTAssertEqual(OmniTicketStore.load(root: "/projects/demo"), file)
+
+        let url = OmniTicketStore.url(for: "/projects/broken")
+        try FileManager.default.createDirectory(at: temp, withIntermediateDirectories: true)
+        try Data("{\"tickets\": [{\"status\": \"someday\"}]}".utf8).write(to: url)
+        XCTAssertTrue(OmniTicketStore.load(root: "/projects/broken").tickets.isEmpty)
+        let kept = try FileManager.default.contentsOfDirectory(atPath: temp.path).filter { $0.contains("unreadable") }
+        XCTAssertEqual(kept.count, 1)
+    }
+
+    func testBuildsListBoardAndDetailWithoutAWindow() {
+        var file = OmniTicketFile(root: "/projects/build")
+        file.tickets = [ticket(1, .open, .urgent), ticket(2, .done, .longTerm)]
+        OmniTicketStore.save(file)
+        let controller = OmniTicketsController(root: "/projects/build")
+        let column = OmniColumnView()
+        // The list leaves out empty groups' rows; the board keeps every column.
+        XCTAssertEqual(controller.build(into: column, previous: []).count, 2)
+        controller.toggleLayout(nil)
+        column.removeAll()
+        XCTAssertEqual(controller.build(into: column, previous: []).count, 3)
+        controller.open("t1")
+        column.removeAll()
+        XCTAssertTrue(controller.build(into: column, previous: []).isEmpty)
+        XCTAssertTrue(controller.isEditingTicket)
+    }
+}
