@@ -0,0 +1,70 @@
+//
+//  OmniAgentPromptsTests.swift
+//  ModernTests
+//
+//  The agent page shows the startup and system prompts in full, as read-only
+//  Markdown. A long prompt collapses behind Show more, which the settings
+//  button zone reaches from the keyboard.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniAgentPromptsTests: XCTestCase {
+    private func details(startup: String, system: String) -> OmniAgentDetailsView {
+        let view = OmniAgentDetailsView(agentName: "Alpha")
+        view.show(agent: ["name": "Alpha", "provider": "claude", "enabled": true, "workspace": "/tmp",
+                          "startup_prompt": startup, "system_prompt": system],
+                  runs: [], selected: nil)
+        view.setFrameSize(NSSize(width: 900, height: 700))
+        view.resizeSubviews(withOldSize: .zero)
+        return view
+    }
+
+    private static let longPrompt = "# Nightly\n\n" + (1...40).map { "- step **\($0)**" }.joined(separator: "\n")
+
+    func testALongPromptCollapsesAndAnEmptyOneShowsNone() {
+        let view = details(startup: Self.longPrompt, system: "")
+        XCTAssertEqual(view.promptViews.count, 1, "An empty prompt gets no Markdown view")
+        let prompt = view.promptViews[0]
+        XCTAssertEqual(prompt.text, OmniReportText.sanitized(Self.longPrompt))
+        XCTAssertFalse(prompt.textView.isEditable)
+        let width = max(prompt.frame.width, 300)
+        XCTAssertTrue(prompt.isCollapsible(width: width))
+        let cap = OmniMarkdownView.height(lines: 8)
+        let card = 2 * OmniMarkdownView.cardPadding
+        XCTAssertLessThanOrEqual(prompt.height(forWidth: width), cap + OmniMarkdownView.toggleHeight + card)
+        XCTAssertLessThan(prompt.height(forWidth: width), prompt.contentHeight(forWidth: width))
+        XCTAssertFalse(prompt.toggleButton.isHidden)
+    }
+
+    func testShortPromptsShowInFullWithoutAToggle() {
+        let view = details(startup: "Run the **tests**.", system: "Be brief.")
+        XCTAssertEqual(view.promptViews.count, 2)
+        for prompt in view.promptViews {
+            let width = max(prompt.frame.width, 300)
+            XCTAssertFalse(prompt.isCollapsible(width: width))
+            let pad = OmniMarkdownView.cardPadding
+            XCTAssertEqual(prompt.height(forWidth: width), prompt.contentHeight(forWidth: width - 2 * pad) + 2 * pad,
+                           "Its text on the Markdown card")
+            XCTAssertTrue(prompt.toggleButton.isHidden)
+        }
+    }
+
+    func testTheToggleExpandsAndIsInTheSettingsZone() {
+        let view = details(startup: Self.longPrompt, system: "Short.")
+        let prompt = view.promptViews[0]
+        let zone = view.settingsZone
+        XCTAssertTrue(zone?.buttons().first === prompt.toggleButton, "Show more comes before Edit and Reveal")
+        let collapsedFrame = prompt.frame.height
+        prompt.toggleButton.performClick(nil)
+        XCTAssertTrue(prompt.isExpanded)
+        XCTAssertGreaterThan(prompt.frame.height, collapsedFrame, "The page relaid out the expanded prompt")
+        let pad = OmniMarkdownView.cardPadding
+        XCTAssertEqual(prompt.frame.height, prompt.contentHeight(forWidth: prompt.frame.width - 2 * pad)
+                       + OmniMarkdownView.toggleHeight + 2 * pad)
+        prompt.toggleButton.performClick(nil)
+        XCTAssertFalse(prompt.isExpanded)
+        XCTAssertEqual(prompt.frame.height, collapsedFrame)
+    }
+}
