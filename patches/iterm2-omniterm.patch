+    // MARK: - Layout
+
+    private func layoutRoot(_ size: NSSize) {
+        let barHeight = OmniTheme.Metrics.barHeight
+        toolbar.frame = NSRect(x: 0, y: 0, width: size.width, height: barHeight)
+        split.frame = NSRect(x: 0, y: barHeight, width: size.width, height: max(0, size.height - barHeight))
+
+        let inset: CGFloat = 16
+        severityControl.sizeToFit()
+        severityControl.frame.origin = NSPoint(x: inset, y: (barHeight - severityControl.frame.height) / 2)
+        markAllButton.sizeToFit()
+        let markAllWidth = markAllButton.frame.width + 8
+        markAllButton.frame = NSRect(x: size.width - markAllWidth - inset, y: (barHeight - OmniTheme.Metrics.buttonHeight) / 2,
+                                     width: markAllWidth, height: OmniTheme.Metrics.buttonHeight)
+        // Narrow windows: the pop-ups shrink, then Unread only goes, then
+        // the kind filter, so nothing runs under Mark All as Read.
+        unreadOnlyButton.sizeToFit()
+        let start = severityControl.frame.maxX + 12
+        let room = markAllButton.frame.minX - 12 - start
+        let unreadWidth = unreadOnlyButton.frame.width + 14
+        let minimumPopUp: CGFloat = 110
+        let showsUnread = room >= 2 * minimumPopUp + 8 + unreadWidth
+        let showsKind = room >= 2 * minimumPopUp + 8
+        let popUpRoom = room - (showsUnread ? unreadWidth : 0)
+        let agentWidth = showsKind ? min(180, (popUpRoom - 8) / 2) : min(180, max(0, popUpRoom))
+        agentPopUp.isHidden = agentWidth < 60
+        agentPopUp.frame = NSRect(x: start, y: (barHeight - 26) / 2, width: max(0, agentWidth), height: 26)
+        kindPopUp.isHidden = !showsKind
+        kindPopUp.frame = NSRect(x: agentPopUp.frame.maxX + 8, y: (barHeight - 26) / 2,
+                                 width: showsKind ? min(190, popUpRoom - 8 - agentWidth) : 0, height: 26)
+        unreadOnlyButton.isHidden = !showsUnread
+        unreadOnlyButton.frame.origin = NSPoint(x: kindPopUp.frame.maxX + 14,
+                                                y: (barHeight - unreadOnlyButton.frame.height) / 2)
+        if split.subviews.count == 2 && listPane.frame.width < 1 {
+            split.setPosition(Self.listWidth, ofDividerAt: 0)
+        }
+    }
+
+    private func layoutList(_ size: NSSize) {
+        let headerY = (Self.listHeaderHeight - 16) / 2 + 2
+        listSummary.sizeToFit()
+        let summaryWidth = min(ceil(listSummary.frame.width), size.width / 2)
+        listSummary.frame = NSRect(x: size.width - summaryWidth - 14, y: headerY, width: summaryWidth, height: 16)
+        listHeader.frame = NSRect(x: 14, y: headerY, width: max(0, listSummary.frame.minX - 22), height: 16)
+        listScroll.frame = NSRect(x: 0, y: Self.listHeaderHeight, width: size.width,
+                                  height: max(0, size.height - Self.listHeaderHeight))
+        tableView.sizeLastColumnToFit()
+        emptyLabel.frame = NSRect(x: 12, y: size.height / 2 - 10, width: max(0, size.width - 24), height: 20)
+    }
+
+    private func layoutDetail(_ size: NSSize) {
+        let inset = OmniTheme.Metrics.pageInset
+        let width = max(size.width - inset * 2, 100)
+        placeholderLabel.frame = NSRect(x: 0, y: size.height / 2 - 12, width: size.width, height: 24)
+
+        severityChip.sizeToFitLabel()
+        severityChip.frame.origin = NSPoint(x: inset, y: OmniTheme.Metrics.pageTop)
+        let titleHeight = titleLabel.sizeThatFits(NSSize(width: width, height: 70)).height
+        titleLabel.frame = NSRect(x: inset, y: severityChip.frame.maxY + 8, width: width,
+                                  height: min(62, max(28, ceil(titleHeight))))
+        metaLabel.frame = NSRect(x: inset, y: titleLabel.frame.maxY + 4, width: width, height: 18)
+        buttonRow.frame = NSRect(x: inset, y: metaLabel.frame.maxY + 12, width: width,
+                                 height: buttonRow.height(forWidth: width))
+
+        let top = buttonRow.frame.maxY + OmniTheme.Metrics.sectionGap
+        contentSplit.frame = NSRect(x: 0, y: top, width: size.width, height: max(0, size.height - top))
+    }
+
+    private func layoutBody(_ size: NSSize) {
+        let inset = OmniTheme.Metrics.pageInset
+        bodyHeader.frame = NSRect(x: inset, y: 8, width: max(0, size.width - inset * 2), height: 16)
+        bodyScroll.frame = NSRect(x: 0, y: 28, width: size.width, height: max(0, size.height - 28))
+    }
+
+    private func layoutChanges(_ size: NSSize) {
+        let inset = OmniTheme.Metrics.pageInset
+        changesLabel.frame = NSRect(x: inset, y: 10, width: max(0, size.width - inset * 2), height: 16)
+        diffScroll.frame = NSRect(x: 0, y: 30, width: size.width, height: max(0, size.height - 30))
+    }
