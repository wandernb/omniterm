+import AppKit
+import Foundation
+
+// An agent's sidebar icon: `sf:<symbol>` or `emoji:<emoji>` in its
+// definition; anything else shows the neutral default.
+enum OmniAgentIcon: Equatable {
+    case symbol(String)
+    case emoji(String)
+
+    init?(spec: String?) {
+        guard let spec else { return nil }
+        if spec.hasPrefix("sf:") {
+            let name = String(spec.dropFirst(3))
+            guard !name.isEmpty, name.allSatisfy({ $0.isLetter || $0.isNumber || $0 == "." }) else { return nil }
+            self = .symbol(name)
+        } else if spec.hasPrefix("emoji:") {
+            // One pictograph grapheme: ZWJ sequences, flags, skin tones and
+            // keycaps count as one; plain digits and letters do not.
+            let emoji = String(spec.dropFirst(6))
+            let scalars = emoji.unicodeScalars
+            guard emoji.count == 1, scalars.count <= 32,
+                  scalars.contains(where: { ($0.properties.isEmoji && $0.value > 0x7f) || $0.value == 0x20E3 }) else {
+                return nil
+            }
+            self = .emoji(emoji)
+        } else {
+            return nil
+        }
+    }
+
+    var spec: String {
+        switch self {
+        case .symbol(let name): return "sf:\(name)"
+        case .emoji(let emoji): return "emoji:\(emoji)"
+        }
+    }
+
+    static let defaultSymbol = "person.crop.circle"
+}
+
+// The colours an agent can wear, by the names definitions store, in hue
+// order. The same list is AGENT_COLORS in helpers/omni and OmniValidColor in
+// OmniScheduler.m.
+enum OmniAgentColor {
+    static let names = ["red", "rose", "pink", "orange", "brown", "yellow", "lime", "green",
+                        "mint", "teal", "cyan", "blue", "indigo", "purple", "slate", "gray"]
+
+    // Lime, rose and slate have no system colour; each has a light and a dark
+    // shade so it reads on both backgrounds.
+    private static let lime = dynamic(light: (0.40, 0.66, 0.05), dark: (0.66, 0.86, 0.25))
+    private static let rose = dynamic(light: (0.86, 0.20, 0.38), dark: (1.0, 0.40, 0.53))
+    private static let slate = dynamic(light: (0.38, 0.45, 0.55), dark: (0.58, 0.65, 0.74))
+
+    private static func dynamic(light: (CGFloat, CGFloat, CGFloat), dark: (CGFloat, CGFloat, CGFloat)) -> NSColor {
+        return NSColor(name: nil) { appearance in
+            let isDark = appearance.bestMatch(from: [.aqua, .darkAqua]) == .darkAqua
+            let (red, green, blue) = isDark ? dark : light
+            return NSColor(srgbRed: red, green: green, blue: blue, alpha: 1)
+        }
+    }
+
+    static func color(_ name: String?) -> NSColor? {
+        switch name {
+        case "red": return .systemRed
+        case "rose": return rose
+        case "pink": return .systemPink
+        case "orange": return .systemOrange
+        case "brown": return .systemBrown
+        case "yellow": return .systemYellow
+        case "lime": return lime
+        case "green": return .systemGreen
+        case "mint": return .systemMint
+        case "teal": return .systemTeal
+        case "cyan": return .systemCyan
+        case "blue": return .systemBlue
+        case "indigo": return .systemIndigo
+        case "purple": return .systemPurple
+        case "slate": return slate
+        case "gray": return .systemGray
+        default: return nil
