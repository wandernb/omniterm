+    // MARK: - Data
+
+    private var requestFilters: [String: Any] {
+        var request: [String: Any] = ["op": "notifications", "limit": 500]
+        switch severityControl.selectedSegment {
+        case 1: request["severity"] = "urgent"
+        case 2: request["severity"] = "attention"
+        case 3: request["severity"] = "info"
+        default: break
+        }
+        if agentPopUp.indexOfSelectedItem > 0, let agent = agentPopUp.titleOfSelectedItem {
+            request["agent"] = agent
+        }
+        if let kind = kindPopUp.selectedItem?.representedObject as? String {
+            request["kind"] = kind
+        }
+        if unreadOnlyButton.state == .on {
+            request["unread"] = true
+        }
+        return request
+    }
+
+    func reload() {
+        _ = view
+        let selectedID = pendingSelection ?? selectedItem?.id
+        OmniSchedulerClient.request(requestFilters) { [weak self] response in
+            guard let self else { return }
+            guard response["ok"] as? Bool == true else {
+                self.items = []
+                self.tableView.reloadData()
+                self.setSummary("Scheduler unavailable")
+                self.emptyLabel.stringValue = "The OmniTerm scheduler is unavailable"
+                self.emptyLabel.isHidden = false
+                self.showDetail(nil)
+                return
+            }
+            let rows = response["notifications"] as? [[AnyHashable: Any]] ?? []
+            self.items = rows.compactMap(OmniNotificationItem.init)
+            self.updateAgentMenu()
+            self.tableView.reloadData()
+            self.emptyLabel.stringValue = self.isFiltered ? "Nothing matches these filters" : "No notifications"
+            self.emptyLabel.isHidden = !self.items.isEmpty
+            let unread = (response["unread_count"] as? NSNumber)?.intValue ?? 0
+            let attention = (response["attention_count"] as? NSNumber)?.intValue ?? 0
+            self.setSummary(Self.summary(unread: unread, attention: attention))
+            self.markAllButton.isEnabled = unread > 0
+            if let selectedID, let index = self.items.firstIndex(where: { $0.id == selectedID }) {
+                self.pendingSelection = nil
+                if self.tableView.selectedRow == index {
+                    self.showDetail(self.items[index], reloadDiff: false)
+                } else {
+                    self.tableView.selectRowIndexes(IndexSet(integer: index), byExtendingSelection: false)
+                }
+                self.tableView.scrollRowToVisible(index)
+            } else {
+                self.tableView.deselectAll(nil)
+                self.showDetail(nil)
+            }
+        }
+        loadAgentLooks()
+    }
+
+    // Rows wear their agent's icon and colour, as in the sidebar.
+    private func loadAgentLooks() {
+        OmniSchedulerClient.request(["op": "list_agents"]) { [weak self] response in
+            guard let self, response["ok"] as? Bool == true else { return }
+            var looks: [String: (icon: OmniAgentIcon?, color: String?)] = [:]
+            for agent in response["agents"] as? [[AnyHashable: Any]] ?? [] {
+                guard let name = agent["name"] as? String else { continue }
+                looks[name] = (OmniAgentIcon(spec: agent["icon"] as? String), agent["color"] as? String)
+            }
+            self.agentLooks = looks
+            guard self.tableView.numberOfRows > 0 else { return }
+            self.tableView.reloadData(forRowIndexes: IndexSet(integersIn: 0..<self.tableView.numberOfRows),
+                                      columnIndexes: IndexSet(integer: 0))
+        }
+    }
+
+    private func setSummary(_ text: String) {
+        summary = text
+        listSummary.stringValue = text
+        layoutList(listPane.bounds.size)
+        summaryDidChange?(text)
+    }
+
+    private var isFiltered: Bool {
+        return severityControl.selectedSegment > 0 || agentPopUp.indexOfSelectedItem > 0 ||
+            kindPopUp.indexOfSelectedItem > 0 || unreadOnlyButton.state == .on
+    }
+
+    private static func summary(unread: Int, attention: Int) -> String {
+        if unread == 0 {
+            return "All caught up"
+        }
+        let unreadText = unread == 1 ? "1 unread" : "\(unread) unread"
+        return attention > 0 ? "\(unreadText) · \(attention) need you" : unreadText
+    }
+
+    private func updateAgentMenu() {
+        let sorted = Set(items.compactMap(\.agent)).union(allAgents).sorted()
+        guard sorted != allAgents else { return }
+        allAgents = sorted
+        let selected = agentPopUp.indexOfSelectedItem > 0 ? agentPopUp.titleOfSelectedItem : nil
+        agentPopUp.removeAllItems()
+        agentPopUp.addItem(withTitle: "All agents")
+        agentPopUp.addItems(withTitles: sorted)
+        if let selected {
+            agentPopUp.selectItem(withTitle: selected)
+        }
+    }
+
+    private var selectedItem: OmniNotificationItem? {
+        let row = tableView.selectedRow
+        return row >= 0 && row < items.count ? items[row] : nil
+    }
+
+    // MARK: - Detail
+
+    private func showDetail(_ item: OmniNotificationItem?, reloadDiff: Bool = true) {
+        let detailViews: [NSView] = [severityChip, titleLabel, metaLabel, buttonRow, contentSplit]
+        for detailView in detailViews {
+            detailView.isHidden = item == nil
+        }
+        placeholderLabel.isHidden = item != nil
+        if item == nil, view.window?.firstResponder === detailZone {
+            focusList()
+        }
+        guard let item else {
+            diffRequestID = nil
+            shownItemID = nil
+            return
+        }
+        let isNewItem = item.id != shownItemID
+        // A diff that finishes capturing while its item is shown must appear.
+        let diffChanged = isNewItem || item.diffState != shownDiffState
+        shownItemID = item.id
+        shownDiffState = item.diffState
+        if isNewItem {
+            buttonRow.status.stringValue = ""
+        }
+        severityChip.configure(text: item.severityName, color: item.severityColor)
+        titleLabel.stringValue = item.title
+        var meta = [item.source, item.age]
+        if let workspace = item.workspace {
+            meta.append((workspace as NSString).abbreviatingWithTildeInPath)
+        }
+        metaLabel.stringValue = meta.joined(separator: "  ·  ")
+        readButton.title = item.unread ? "Mark as Read" : "Mark as Unread"
+        revealButton.isEnabled = item.workspace.map { FileManager.default.fileExists(atPath: $0) } ?? false
+        resumeButton.isEnabled = item.runID != nil
+        buttonRow.needsLayout = true
+        buttonRow.resizeSubviews(withOldSize: buttonRow.bounds.size)
+        layoutDetail(detailPane.bounds.size)
+        renderBody(item)
+        guard diffChanged else { return }
+        renderChanges(item, diff: nil)
+        loadDiff(for: item)
+    }
+
+    private func renderBody(_ item: OmniNotificationItem) {
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.lineSpacing = 3
+        let empty = item.body.isEmpty
+        let text = NSAttributedString(string: empty ? "No details were sent with this notification." : item.body,
+                                      attributes: [.font: OmniTheme.Font.body,
+                                                   .foregroundColor: empty ? OmniTheme.tertiaryText : NSColor.labelColor,
+                                                   .paragraphStyle: paragraph])
+        bodyTextView.textStorage?.setAttributedString(text)
+        bodyTextView.scroll(.zero)
+    }
+
+    private func loadDiff(for item: OmniNotificationItem) {
+        guard item.hasDiff else {
+            diffRequestID = nil
+            return
+        }
+        diffRequestID = item.id
+        OmniSchedulerClient.request(["op": "notification_diff", "id": item.id]) { [weak self] response in
+            guard let self, self.diffRequestID == item.id, self.selectedItem?.id == item.id else { return }
+            self.renderChanges(item, diff: response["diff"] as? String)
+        }
+    }
+
+    private func renderChanges(_ item: OmniNotificationItem, diff: String?) {
+        let mono = OmniTheme.Font.mono
+        let text = NSMutableAttributedString()
+        let fileCount = item.diffFiles.count
+        if fileCount > 0 {
+            changesLabel.stringValue = (fileCount == 1 ? "1 CHANGED FILE" : "\(fileCount) CHANGED FILES") + " · CAPTURED WHEN SENT"
+            for line in item.diffFiles {
+                text.append(NSAttributedString(string: line + "\n",
+                                               attributes: [.font: mono, .foregroundColor: OmniTheme.secondaryText]))
+            }
+            if let diff, !diff.isEmpty {
+                text.append(Self.colouredDiff(diff, font: mono))
+            }
+        } else {
+            changesLabel.stringValue = "CHANGES"
+        }
+        if let note = diffNote(item) {
+            text.insert(NSAttributedString(string: note + "\n\n",
+                                           attributes: [.font: OmniTheme.Font.meta,
+                                                        .foregroundColor: OmniTheme.secondaryText]), at: 0)
+        }
+        diffTextView.textStorage?.setAttributedString(text)
+        diffTextView.scroll(.zero)
+        let showsChanges = text.length > 0
+        if changesPane.isHidden == showsChanges {
+            changesPane.isHidden = !showsChanges
+            contentSplit.adjustSubviews()
+        }
+        if showsChanges && diff == nil {
+            // Give the body the height its text needs, within limits, and the
+            // changes the rest. Only on a new selection, so a dragged divider stays.
+            contentSplit.setPosition(preferredBodyHeight(), ofDividerAt: 0)
+        }
+    }
+
+    private func preferredBodyHeight() -> CGFloat {
+        var textHeight: CGFloat = 60
+        if let layoutManager = bodyTextView.layoutManager, let container = bodyTextView.textContainer {
+            container.containerSize = NSSize(width: max(100, contentSplit.bounds.width - OmniTheme.Metrics.pageInset * 2),
+                                             height: CGFloat.greatestFiniteMagnitude)
+            layoutManager.ensureLayout(for: container)
+            textHeight = layoutManager.usedRect(for: container).height
+        }
+        let available = contentSplit.bounds.height
+        // The header above the text and the text view's own insets.
+        return min(max(110, textHeight + 56), max(110, available * 0.5))
+    }
+
+    private func diffNote(_ item: OmniNotificationItem) -> String? {
+        switch item.diffState {
+        case "pending": return "Capturing the diff…"
+        case "truncated": return "The diff was too large and is shown only in part."
+        case "failed": return "The diff could not be captured."
+        case "not_a_repository": return "The workspace is not a Git repository, so no diff was captured."
+        case "no_workspace": return "The workspace no longer existed when the notification was sent."
+        case "no_git": return "Git is not installed, so no diff was captured."
+        case "clean": return "The workspace had no changes when the notification was sent."
+        default: return nil
+        }
+    }
+
+    // Line colours follow the line's prefix; the text itself is never interpreted.
+    static func colouredDiff(_ diff: String, font: NSFont) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        let bold = NSFont.monospacedSystemFont(ofSize: font.pointSize, weight: .semibold)
+        diff.enumerateLines { line, _ in
+            var attributes: [NSAttributedString.Key: Any] = [.font: font, .foregroundColor: NSColor.labelColor]
+            if line.hasPrefix("diff --git") {
+                attributes[.font] = bold
+                result.append(NSAttributedString(string: "\n", attributes: attributes))
+            } else if line.hasPrefix("+++") || line.hasPrefix("---") || line.hasPrefix("index ") {
+                attributes[.foregroundColor] = NSColor.tertiaryLabelColor
+            } else if line.hasPrefix("+") {
+                attributes[.foregroundColor] = NSColor.systemGreen
+                attributes[.backgroundColor] = NSColor.systemGreen.withAlphaComponent(0.10)
+            } else if line.hasPrefix("-") {
+                attributes[.foregroundColor] = NSColor.systemRed
+                attributes[.backgroundColor] = NSColor.systemRed.withAlphaComponent(0.10)
+            } else if line.hasPrefix("@@") {
+                attributes[.foregroundColor] = NSColor.systemBlue
+            } else {
+                attributes[.foregroundColor] = NSColor.secondaryLabelColor
+            }
+            result.append(NSAttributedString(string: line + "\n", attributes: attributes))
+        }
+        return result
+    }
+
+    // MARK: - Actions
+
+    @objc private func filtersChanged(_ sender: Any?) {
+        reload()
+    }
+
+    @objc private func markAllRead(_ sender: Any?) {
+        OmniSchedulerClient.request(["op": "notifications_read_all"]) { _ in }
+    }
+
+    // The button reads “Mark as Read” while the item is unread.
+    @objc private func toggleRead(_ sender: Any?) {
+        guard let item = selectedItem else { return }
+        setRead(item.unread, for: item)
+    }
+
+    private func setRead(_ read: Bool, for item: OmniNotificationItem) {
+        OmniSchedulerClient.request(["op": "notification_read", "id": item.id, "read": read]) { _ in }
+    }
+
+    @objc private func revealWorkspace(_ sender: Any?) {
+        guard let workspace = selectedItem?.workspace, FileManager.default.fileExists(atPath: workspace) else {
+            buttonRow.status.stringValue = "The workspace no longer exists."
+            return
+        }
+        NSWorkspace.shared.activateFileViewerSelecting([URL(fileURLWithPath: workspace)])
+    }
+
+    @objc private func resumeRun(_ sender: Any?) {
+        guard let runID = selectedItem?.runID else { return }
+        buttonRow.status.stringValue = "Resuming…"
+        OmniSchedulerClient.request(["op": "resume_run", "run_id": runID]) { [weak self] response in
+            guard let self else { return }
+            if response["ok"] as? Bool == true {
+                self.buttonRow.status.stringValue = "Resumed in a new tab."
+                NSApp.sendAction(NSSelectorFromString("openOmniTerm:"), to: NSApp.delegate, from: nil)
+            } else {
+                self.buttonRow.status.stringValue = response["error"] as? String ?? "The run could not be resumed."
+            }
+        }
+    }
+
+    @objc private func deleteItem(_ sender: Any?) {
+        guard let item = selectedItem else { return }
+        OmniSchedulerClient.request(["op": "notification_delete", "id": item.id]) { _ in }
+    }
+
+    // MARK: - NSTableViewDataSource, NSTableViewDelegate
+
+    func numberOfRows(in tableView: NSTableView) -> Int {
+        return items.count
+    }
+
+    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
+        let identifier = NSUserInterfaceItemIdentifier("OmniInboxCell")
+        let cell = tableView.makeView(withIdentifier: identifier, owner: self) as? OmniInboxCell ?? OmniInboxCell()
+        cell.identifier = identifier
+        let item = items[row]
+        let look = item.agent.flatMap { agentLooks[$0] }
+        cell.configure(with: item, icon: look?.icon, iconColor: OmniAgentColor.color(look?.color))
+        return cell
+    }
+
+    func tableViewSelectionDidChange(_ notification: Notification) {
+        let item = selectedItem
+        showDetail(item)
+        if let item, item.unread {
+            setRead(true, for: item)
+        }
+    }
+}
+
+// A notification as a sidebar row: the agent's icon, the title (bold while
+// unread), a muted subline that spells out the severity, and a muted dot.
+private final class OmniInboxCell: NSTableCellView {
+    private let iconView = NSImageView()
+    private let emojiLabel = NSTextField(labelWithString: "")
+    private let title = NSTextField(labelWithString: "")
+    private let detail = NSTextField(labelWithString: "")
+    private let dot = NSView()
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: OmniTheme.Metrics.rowHeight))
+        iconView.imageScaling = .scaleProportionallyUpOrDown
+        iconView.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 13, weight: .regular)
+        addSubview(iconView)
+        emojiLabel.font = NSFont.systemFont(ofSize: 14)
+        emojiLabel.alignment = .center
+        addSubview(emojiLabel)
+        title.lineBreakMode = .byTruncatingTail
+        title.cell?.isScrollable = false
+        addSubview(title)
+        textField = title
+        detail.font = OmniTheme.Font.rowDetail
+        detail.textColor = OmniTheme.secondaryText
+        detail.lineBreakMode = .byTruncatingTail
+        addSubview(detail)
+        dot.wantsLayer = true
+        dot.layer?.cornerRadius = OmniTheme.Metrics.statusDot / 2
+        addSubview(dot)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    func configure(with item: OmniNotificationItem, icon: OmniAgentIcon?, iconColor: NSColor?) {
+        switch icon ?? .symbol(OmniAgentIcon.defaultSymbol) {
+        case .symbol(let name):
+            iconView.image = OmniIconImage.image(name) ??
+                NSImage(systemSymbolName: OmniAgentIcon.defaultSymbol, accessibilityDescription: nil)
+            iconView.contentTintColor = iconColor ?? OmniTheme.secondaryText
+            iconView.isHidden = false
+            emojiLabel.isHidden = true
+        case .emoji(let emoji):
+            emojiLabel.stringValue = emoji
+            emojiLabel.isHidden = false
+            iconView.isHidden = true
+        }
+        title.stringValue = item.title
+        title.font = item.unread ? OmniTheme.Font.rowTitleEmphasized : OmniTheme.Font.rowTitle
+        title.textColor = item.unread ? .labelColor : OmniTheme.secondaryText
+        var parts = [item.severityName, item.source, item.age]
+        if item.kind != "agent" {
+            parts.insert(OmniSettingsModel.kindTitle(item.kind), at: 1)
+        }
+        if item.suppressed > 0 {
+            parts.insert("\(item.suppressed) held back", at: 1)
+        }
+        detail.stringValue = parts.joined(separator: " · ")
+        // Info needs no dot; the subline says it.
+        dot.isHidden = item.severity != "urgent" && item.severity != "attention"
+        dot.layer?.backgroundColor = OmniTheme.mutedStatus(item.severityColor).cgColor
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let x: CGFloat = 24
+        let dotSize = OmniTheme.Metrics.statusDot
+        let dotRoom: CGFloat = dot.isHidden ? 0 : dotSize + 6
+        let width = max(0, bounds.width - x - 4)
+        // Cell views are not flipped: y grows upwards.
+        let titleY = bounds.height - 21
+        title.frame = NSRect(x: x, y: titleY, width: width, height: 17)
+        detail.frame = NSRect(x: x, y: 4, width: max(0, width - dotRoom), height: 14)
+        let iconSize = OmniTheme.Metrics.rowIconSize
+        iconView.frame = NSRect(x: 2, y: titleY + 0.5, width: iconSize, height: iconSize)
+        emojiLabel.frame = NSRect(x: 0, y: titleY - 0.5, width: 20, height: 18)
+        let textWidth = min(ceil(detail.attributedStringValue.size().width), detail.frame.width)
+        dot.frame = NSRect(x: detail.frame.minX + textWidth + 5, y: detail.frame.midY - dotSize / 2,
+                           width: dotSize, height: dotSize)
+    }
+}
+
+// The notification list as a page's zone: Up and Down choose, Right or
+// Return go into the detail, Left or Escape leave the page.
+final class OmniInboxListZone: OmniFocusZone {
+    private unowned let inbox: OmniInboxViewController
+    var zoneExit: ((OmniZoneExit) -> Void)?
+
+    fileprivate init(inbox: OmniInboxViewController) {
+        self.inbox = inbox
+    }
+
+    var zoneFirstResponder: NSView {
+        return inbox.listResponder
+    }
+
+    var zoneCanEnter: Bool {
+        return inbox.listCanEnter
+    }
+
+    func zoneEnter() {
+        inbox.enterList()
+    }
+
+    func zoneHandleKey(_ event: NSEvent) -> Bool {
+        switch OmniZoneKey(event) {
+        case .up:
+            inbox.step(by: -1)
+        case .down:
+            inbox.step(by: 1)
+        case .right, .activate:
+            inbox.enterDetail()
+        case .left, .back:
+            zoneExit?(.back)
+        case .next, .previous:
+            if let zoneExit {
+                zoneExit(OmniZoneKey(event) == .next ? .next : .previous)
+            } else {
+                inbox.enterDetail()
+            }
+        default:
+            return false
+        }
+        return true
+    }
+}
+
+// The selected notification's buttons as a page's zone. Left at the first
+// button goes back to the list, not out of the page.
+final class OmniInboxDetailZone: OmniFocusZone {
+    private unowned let inbox: OmniInboxViewController
+    var zoneExit: ((OmniZoneExit) -> Void)?
+
+    fileprivate init(inbox: OmniInboxViewController) {
+        self.inbox = inbox
+    }
+
+    var zoneFirstResponder: NSView {
+        return inbox.detailResponder
+    }
+
+    var zoneCanEnter: Bool {
+        return inbox.detailCanEnter
+    }
+
+    func zoneEnter() {
+        inbox.enterDetail()
+    }
+
+    func zoneHandleKey(_ event: NSEvent) -> Bool {
+        return inbox.detailResponder.zoneHandleKey(event)
+    }
+}
