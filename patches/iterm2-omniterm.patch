+// Hosts the native content of the right panel. Overview covers the whole tab
+// view. An agent or run card covers only its header, laid out in the inset
+// the window leaves above the tab view, so the live terminal shows below it;
+// it covers the tab view too when it has no live session or shows its
+// details. The host is a sibling of the tab view inside the window's root
+// view and follows the tab view's frame.
+final class OmniContentHost: NSView {
+    weak var actions: OmniPaneActions?
+    private(set) var route: OmniPaneRoute?
+    private(set) var pane: OmniPane?
+    private weak var tabView: NSView?
+    private var headerHeight: CGFloat = 0
+    private(set) var coversTerminal = true
+    // Per window: an expanded card hides its details so the terminal fills
+    // the panel.
+    private(set) var terminalExpanded = false
+    private var firstResponderObservation: NSKeyValueObservation?
+    private var lastTabHeight: CGFloat = 0
+    // Left or Escape out of a page's first zone hands the keyboard back.
+    var exitToSidebar: (() -> Void)?
+    // The window's panel sizes; pages read and change it.
+    var layoutStore: OmniPanelLayoutStore?
+
+    override var isFlipped: Bool { true }
+    override var acceptsFirstResponder: Bool { true }
+
+    init() {
+        super.init(frame: .zero)
+        OmniPointer.startWatching()
+        // Layer-backed like its siblings: a view that draws without a layer
+        // beside the tab view has kept the terminal's Metal view off screen.
+        wantsLayer = true
+        isHidden = true
+        autoresizesSubviews = false
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    func attach(above tabView: NSView) {
+        guard let superview = tabView.superview, self.tabView !== tabView || self.superview !== superview else { return }
+        detach()
+        self.tabView = tabView
+        superview.addSubview(self, positioned: .above, relativeTo: tabView)
+        tabView.postsFrameChangedNotifications = true
+        NotificationCenter.default.addObserver(self,
+                                               selector: #selector(tabViewFrameDidChange),
+                                               name: NSView.frameDidChangeNotification,
+                                               object: tabView)
+        tabViewFrameDidChange()
+    }
+
+    func detach() {
+        NotificationCenter.default.removeObserver(self)
+        removeFromSuperview()
+        tabView = nil
+    }
+
+    // The root view is not flipped: the header sits above the tab view's top.
+    @objc private func tabViewFrameDidChange() {
+        guard let tabView else { return }
+        let tab = tabView.frame
+        let header = NSRect(x: tab.minX, y: tab.maxY, width: tab.width, height: headerHeight)
+        frame = coversTerminal ? tab.union(header) : header
+        pane?.frame = bounds
+        if card != nil, tab.height != lastTabHeight {
+            // The details share follows the window's height.
+            lastTabHeight = tab.height
+            DispatchQueue.main.async { [weak self] in
+                self?.actions?.paneLayoutDidChange()
+            }
+        }
+    }
+
+    var isShowingPane: Bool {
+        return route != nil
+    }
+
+    var card: OmniCardPane? {
+        return pane as? OmniCardPane
+    }
+
+    func show(_ route: OmniPaneRoute) {
+        guard route != self.route else {
+            isHidden = false
+            return
+        }
+        pane?.removeFromSuperview()
+        let pane: OmniPane
+        switch route {
+        case .overview:
+            pane = OmniOverviewPane()
+        case .group(let path):
+            pane = OmniFolderPane(path: path)
+        case .inbox:
+            pane = OmniInboxPane()
+        case .memory:
+            pane = OmniMemoryPane()
+        case .settings:
+            pane = OmniSettingsPane()
+        case .unblocker:
+            pane = OmniUnblockerPane()
+        case .search(let query):
+            pane = OmniSearchPane(query: query)
+        case .projects:
+            pane = OmniProjectsPane(projectID: nil)
+        case .project(let root):
+            pane = OmniProjectsPane(projectID: root)
+        case .session(let id):
+            pane = OmniSessionPane(sessionID: id)
+        case .agent, .run:
+            let card = OmniCardPane(route: route)
+            card.expanded = terminalExpanded
+            card.toggleExpanded = { [weak self] in self?.toggleTerminalExpanded() }
+            pane = card
+        }
+        pane.actions = actions
+        pane.layoutStore = layoutStore
+        if let layoutStore {
+            pane.applyPanelLayout(layoutStore.layout)
+        }
+        pane.frame = bounds
+        pane.autoresizingMask = [.width, .height]
+        addSubview(pane)
+        OmniPointer.install(in: pane)
+        self.pane = pane
+        self.route = route
+        isHidden = false
+        pane.reload()
+    }
+
+    // Sets how much of the panel the host covers; the sidebar calls this
+    // after every change of route, tab or card state.
+    func setLayout(headerHeight: CGFloat, coversTerminal: Bool) {
+        self.headerHeight = headerHeight
+        self.coversTerminal = coversTerminal
+        isHidden = route == nil
+        tabViewFrameDidChange()
+    }
+
+    func toggleTerminalExpanded() {
+        terminalExpanded.toggle()
+        card?.expanded = terminalExpanded
+        actions?.paneLayoutDidChange()
+    }
+
+    // MARK: - Keyboard zones
+
+    // The page's zones that can take the keyboard now, in Tab order.
+    private var availableZones: [OmniFocusZone] {
+        guard !isHidden, let pane else { return [] }
+        return pane.focusZones.filter(\.zoneCanEnter)
+    }
+
+    // The zone holding the keyboard, if any.
+    var focusedZone: OmniFocusZone? {
+        guard !isHidden, let responder = window?.firstResponder, let pane else { return nil }
+        return pane.focusZones.first { $0.zoneFirstResponder === responder }
+    }
+
+    var hasZoneFocus: Bool {
+        return focusedZone != nil
+    }
+
+
+    // From the sidebar: the page's first zone. False when the page has none
+    // ready (a terminal, or a page still loading).
+    @discardableResult
+    func enterFirstZone() -> Bool {
+        guard let zone = availableZones.first else { return false }
+        enter(zone)
+        return window?.firstResponder === zone.zoneFirstResponder
+    }
+
+    // A key while one of the page's zones has the keyboard.
+    func handleZoneKey(_ event: NSEvent) -> Bool {
+        guard let zone = focusedZone else { return false }
+        if pane?.handlePaneShortcut(event) == true {
+            return true
+        }
+        wire(zone)
+        return zone.zoneHandleKey(event)
+    }
+
+    private func enter(_ zone: OmniFocusZone) {
+        wire(zone)
+        zone.zoneEnter()
+    }
+
+    private func wire(_ zone: OmniFocusZone) {
+        zone.zoneExit = { [weak self, weak zone] exit in
+            guard let self, let zone else { return }
+            self.zone(zone, didExit: exit)
+        }
+    }
+
+    private func zone(_ zone: OmniFocusZone, didExit exit: OmniZoneExit) {
+        switch exit {
+        case .back:
+            exitToSidebar?()
+        case .next, .previous:
+            // Tab order wraps around the page.
+            let zones = availableZones
+            guard let index = zones.firstIndex(where: { $0 === zone }) else {
+                if let first = zones.first {
+                    enter(first)
+                }
+                return
+            }
+            let step = exit == .next ? 1 : zones.count - 1
+            enter(zones[(index + step) % zones.count])
+        }
+    }
+
+    // Keys must not reach a terminal the host covers: a pane over the curses
+    // dashboard would otherwise pass its keystrokes to it.
+    func takeKeyFocus() {
+        guard !isHidden, coversTerminal, let window else { return }
+        guard let responder = window.firstResponder as? NSView else {
+            window.makeFirstResponder(self)
+            return
+        }
+        // Only a terminal under the host loses focus; the sidebar and the
+        // host's own fields keep it.
+        guard !responder.isDescendant(of: self), let tabView, responder.isDescendant(of: tabView) else {
+            return
+        }
+        window.makeFirstResponder(self)
+    }
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        NotificationCenter.default.removeObserver(self, name: NSWindow.didBecomeKeyNotification, object: nil)
+        firstResponderObservation = nil
+        guard let window else { return }
+        NotificationCenter.default.addObserver(self,
+                                               selector: #selector(windowDidBecomeKey),
+                                               name: NSWindow.didBecomeKeyNotification,
+                                               object: window)
+        // The window refocuses its session on its own (tab selection, relayout
+        // after the inset changes, activation), so focus is taken back
+        // whenever it lands on a terminal this host covers.
+        firstResponderObservation = window.observe(\.firstResponder) { [weak self] window, _ in
+            self?.logCoveredTerminalFocus(window)
+            DispatchQueue.main.async {
+                self?.takeKeyFocus()
+            }
+        }
+        takeKeyFocus()
+    }
+
+    // TEMP sidebar-keys: who hands focus to a terminal this host covers. The
+    // observation runs inside makeFirstResponder, so the stack names the
+    // caller. At most one stack every 10 seconds.
+    private var lastCoveredFocusLog = Date.distantPast
+
+    private func logCoveredTerminalFocus(_ window: NSWindow) {
+        guard !isHidden, coversTerminal, let tabView, let responder = window.firstResponder as? NSView,
+              responder.isDescendant(of: tabView), Date().timeIntervalSince(lastCoveredFocusLog) > 10 else { return }
+        lastCoveredFocusLog = Date()
+        let stack = Thread.callStackSymbols.prefix(24).joined(separator: " | ")
+        omniSidebarKeysLog.notice("covered terminal took focus: \(stack, privacy: .public)")
+    }
+
+    // A tab selected from the sidebar or a page must not take the keyboard
+    // from the page (see OmniFocusHold).
+    override func resignFirstResponder() -> Bool {
+        if OmniFocusHold.isHolding {
+            return false
+        }
+        return super.resignFirstResponder()
+    }
+
+    @objc private func windowDidBecomeKey() {
+        // Opening the window focuses the selected session afterwards.
+        DispatchQueue.main.async { [weak self] in
+            self?.takeKeyFocus()
+        }
+    }
+
+    // Returns whether a pane was shown.
+    @discardableResult
+    func hide() -> Bool {
+        guard route != nil else { return false }
+        pane?.removeFromSuperview()
+        pane = nil
+        route = nil
+        isHidden = true
+        return true
+    }
+
+    func refresh() {
+        pane?.reload()
+    }
+
+    func panelLayoutDidChange(_ layout: OmniPanelLayout) {
+        pane?.applyPanelLayout(layout)
+    }
+
+    override func performKeyEquivalent(with event: NSEvent) -> Bool {
+        guard !isHidden, window?.isKeyWindow == true else {
+            return super.performKeyEquivalent(with: event)
+        }
+        let modifiers = event.modifierFlags.intersection(.deviceIndependentFlagsMask)
+        // Control-Command-Return expands a card's terminal or restores its details.
+        // Shift-Command-Return stays iTerm’s Maximize Active Pane.
+        if card != nil, modifiers == [.command, .control], event.keyCode == 36 || event.keyCode == 76 {
+            toggleTerminalExpanded()
+            return true
+        }
+        // Command-W on a covering pane hides the window, as it did on the
+        // dashboard tab, rather than closing the terminal tab hidden underneath.
+        if coversTerminal, modifiers == .command || modifiers == [.command, .option],
+           event.charactersIgnoringModifiers?.lowercased() == "w" {
+            if let terminal = window?.windowController as? PseudoTerminal {
+                terminal.omniHideWindow()
+            } else {
+                window?.orderOut(nil)
+            }
+            return true
+        }
+        return super.performKeyEquivalent(with: event)
+    }
+
+    override func keyDown(with event: NSEvent) {
+        // Typing on a pane goes nowhere; no terminal is on screen.
+    }
+}
