+    func testGraphSignatureIgnoresWeightDriftAndOrder() {
+        let a = OmniMemoryGraphNode(id: "a", label: "A", weight: 7.4)
+        let b = OmniMemoryGraphNode(id: "b", label: "B", weight: 0.3)
+        let edge = OmniMemoryGraphEdge(source: "a", target: "b", kind: "tag", strength: 0.5)
+        let first = OmniMemoryGraphLayout.signature(nodes: [a, b], edges: [edge])
+        let drifted = OmniMemoryGraphLayout.signature(nodes: [OmniMemoryGraphNode(id: "b", label: "B", weight: 0.35),
+                                                              OmniMemoryGraphNode(id: "a", label: "A", weight: 7.3)],
+                                                      edges: [OmniMemoryGraphEdge(source: "a", target: "b", kind: "tag", strength: 0.4)])
+        XCTAssertEqual(first, drifted, "Order, small drift and edge strength do not count")
+        XCTAssertNotEqual(first, OmniMemoryGraphLayout.signature(nodes: [a, OmniMemoryGraphNode(id: "b", label: "B", weight: 2)],
+                                                                 edges: [edge]), "A weight change of 0.5 or more counts")
+        XCTAssertNotEqual(first, OmniMemoryGraphLayout.signature(nodes: [a, b], edges: [edge,
+            OmniMemoryGraphEdge(source: "a", target: "b", kind: "session")]), "A new edge counts")
+        XCTAssertEqual(OmniMemoryGraphLayout.stableHash("m1"), OmniMemoryGraphLayout.stableHash("m1"))
+        XCTAssertNotEqual(OmniMemoryGraphLayout.stableHash("m1"), OmniMemoryGraphLayout.stableHash("m2"))
+    }
