+- (NSDictionary *)alertFor:(NSDictionary *)item settings:(NSDictionary *)settings {
+    return [OmniScheduler notificationAlertForItem:item settings:settings now:1000];
+}
+
+- (NSDictionary *)setSettings:(NSDictionary *)settings {
+    return [_scheduler responseForRequest:@{ @"op": @"set_settings", @"settings": settings }];
+}
