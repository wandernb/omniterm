+}
+
+// MARK: - App-side settings
+
+// A `set_settings` change from inside the app, all or nothing. The global
+// shortcut and login launch have effects only the app can make; the scheduler
+// validates and stores everything else. Effects are applied first and undone
+// if a later step fails, so a refused change leaves nothing behind. The
+// effects are closures so tests can stand in for the hotkey and SMAppService.
+@objc(OmniSettingsTransaction)
+final class OmniSettingsTransaction: NSObject {
+    // The shortcut as stored: a dictionary, or NSNull when there is none.
+    @objc var currentShortcut: () -> Any = { NSNull() }
+    // Takes a dictionary, NSNull or "default"; false when it cannot register.
+    @objc var applyShortcut: (Any) -> Bool = { _ in true }
+    @objc var currentLogin: () -> Bool = { false }
+    // Returns an error message, or nil.
+    @objc var setLogin: (Bool) -> String? = { _ in nil }
+    // Stores the app's own keys; returns an error message, or nil.
+    @objc var store: ([String: Any]) -> String? = { _ in nil }
+    // Sends the scheduler's keys as `set_settings`.
+    @objc var forward: ([String: Any], @escaping ([AnyHashable: Any]) -> Void) -> Void = { _, done in done(["ok": true]) }
+
+    static let appKeys = ["global_shortcut", "launch_at_login"]
+
+    private static func failure(_ code: String, _ message: String, field: String? = nil) -> [AnyHashable: Any] {
+        var response: [AnyHashable: Any] = ["ok": false, "code": code, "error": message]
+        if let field { response["field"] = field }
+        return response
+    }
+
+    @objc func run(_ changes: [String: Any], completion: @escaping ([AnyHashable: Any]) -> Void) {
+        var rest = changes
+        let shortcut = rest.removeValue(forKey: "global_shortcut")
+        let login = rest.removeValue(forKey: "launch_at_login")
+        if let shortcut, !(shortcut is NSNull), (shortcut as? String) != "default", !(shortcut is [AnyHashable: Any]) {
+            completion(Self.failure("invalid_settings", "Invalid setting: global_shortcut", field: "global_shortcut"))
+            return
+        }
+        var loginValue: Bool?
+        if let login {
+            guard let number = login as? NSNumber, CFGetTypeID(number) == CFBooleanGetTypeID() else {
+                completion(Self.failure("invalid_settings", "Invalid setting: launch_at_login", field: "launch_at_login"))
+                return
+            }
+            loginValue = number.boolValue
+        }
+        let previousShortcut = currentShortcut()
+        let previousLogin = currentLogin()
+        var shortcutApplied = false
+        var loginApplied = false
+        let undo = { [self] in
+            if loginApplied { _ = setLogin(previousLogin) }
+            if shortcutApplied { _ = applyShortcut(previousShortcut) }
+        }
+        if let shortcut {
+            guard applyShortcut(shortcut) else {
+                completion(Self.failure("shortcut_unavailable", "That shortcut is already used by another application."))
+                return
+            }
+            shortcutApplied = true
+        }
+        if let loginValue {
+            if let error = setLogin(loginValue) {
+                undo()
+                completion(Self.failure("login_failed", error))
+                return
+            }
+            loginApplied = true
+        }
+        let finish = { [self] in
+            var stored: [String: Any] = [:]
+            if shortcutApplied { stored["global_shortcut"] = currentShortcut() }
+            if loginApplied { stored["launch_at_login"] = currentLogin() }
+            if !stored.isEmpty, let error = store(stored) {
+                undo()
+                completion(Self.failure("write_failed", error))
+                return
+            }
+            completion(["ok": true])
+        }
+        guard !rest.isEmpty else {
+            finish()
+            return
+        }
+        forward(rest) { response in
+            guard response["ok"] as? Bool == true else {
+                undo()
+                completion(response)
+                return
+            }
+            finish()
+        }
+    }
+}
