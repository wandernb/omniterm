+    // MARK: - Layout
+
+    private func layout(_ size: NSSize) {
+        let barHeight = OmniTheme.Metrics.barHeight
+        bar.frame = NSRect(x: 0, y: 0, width: size.width, height: barHeight)
+        tabControl.sizeToFit()
+        tabControl.frame.origin = NSPoint(x: 16, y: (barHeight - tabControl.frame.height) / 2)
+        let summaryX = tabControl.frame.maxX + 16
+        summaryLabel.frame = NSRect(x: summaryX, y: (barHeight - 16) / 2, width: max(0, size.width - summaryX - 16), height: 16)
+        let content = NSRect(x: 0, y: barHeight, width: size.width, height: max(0, size.height - barHeight))
+        for view in [browseView, searchView, processView, digestView, graphView, ingestView] {
+            view.frame = content
+        }
+        let width = content.width, height = content.height
+        let list = shownListWidth(contentWidth: width)
+        let rowY: CGFloat = 10, controlHeight: CGFloat = 24
+
+        // Browse: a sidebar-style list column, then the detail.
+        browseListPane.frame = NSRect(x: 0, y: 0, width: list, height: height)
+        browseHeader.sizeToFit()
+        browseHeader.frame.origin = NSPoint(x: 14, y: 12)
+        archivedChip.sizeToFit()
+        let chipWidth = archivedChip.isHidden ? 0 : archivedChip.frame.width + 6
+        archivedChip.frame.origin = NSPoint(x: max(browseHeader.frame.maxX + 8, list - 14 - archivedChip.frame.width),
+                                            y: 9)
+        browseCount.frame = NSRect(x: browseHeader.frame.maxX + 8, y: 11,
+                                   width: max(0, list - browseHeader.frame.maxX - 22 - chipWidth), height: 15)
+        filterField.frame = NSRect(x: 12, y: 34, width: list - 24, height: controlHeight)
+        typePopUp.frame = NSRect(x: 12, y: 64, width: (list - 30) * 0.55, height: controlHeight)
+        sortPopUp.frame = NSRect(x: typePopUp.frame.maxX + 6, y: 64, width: (list - 30) * 0.45, height: controlHeight)
+        memoryScroll.frame = NSRect(x: 0, y: 96, width: list, height: max(0, height - 96))
+        detailButtons.frame = NSRect(x: list + 18, y: 10, width: max(0, width - list - 30), height: 30)
+        detailScroll.frame = NSRect(x: list, y: 46, width: max(0, width - list), height: max(0, height - 46))
+
+        // Search
+        modeControl.sizeToFit()
+        corpusControl.sizeToFit()
+        corpusControl.frame.origin = NSPoint(x: width - corpusControl.frame.width - 12, y: rowY)
+        modeControl.frame.origin = NSPoint(x: corpusControl.frame.minX - modeControl.frame.width - 10, y: rowY)
+        searchField.frame = NSRect(x: 12, y: rowY, width: max(120, modeControl.frame.minX - 22), height: controlHeight)
+        searchStatus.frame = NSRect(x: 14, y: 40, width: width - 28, height: 16)
+        let searchTop = searchListTop
+        searchChips.frame = NSRect(x: 12, y: 62, width: max(0, width - 24), height: searchTokens.isEmpty ? 0 : 22)
+        layoutSearchChips()
+        searchListPane.frame = NSRect(x: 0, y: searchTop, width: list, height: max(0, height - searchTop))
+        searchScroll.frame = NSRect(x: 0, y: searchTop, width: list, height: max(0, height - searchTop))
+        searchDetailScroll.frame = NSRect(x: list, y: searchTop, width: max(0, width - list),
+                                          height: max(0, height - searchTop))
+
+        // Process
+        let pipelineHeight: CGFloat = 112
+        pipelineView.frame = NSRect(x: 0, y: 0, width: width, height: pipelineHeight)
+        eventsListPane.frame = NSRect(x: 0, y: pipelineHeight, width: list, height: max(0, height - pipelineHeight))
+        eventsHeader.sizeToFit()
+        eventsHeader.frame.origin = NSPoint(x: 14, y: pipelineHeight + 10)
+        eventsScroll.frame = NSRect(x: 0, y: pipelineHeight + 30, width: list, height: max(0, height - pipelineHeight - 30))
+        eventButtons.frame = NSRect(x: list + 18, y: pipelineHeight + 8, width: max(0, width - list - 30), height: 30)
+        eventScroll.frame = NSRect(x: list, y: pipelineHeight + 42, width: max(0, width - list),
+                                   height: max(0, height - pipelineHeight - 42))
+
+        // Ingest: the runs as a list column, the selected run's report beside it.
+        ingestListPane.frame = NSRect(x: 0, y: 0, width: list, height: height)
+        ingestHeader.sizeToFit()
+        ingestHeader.frame.origin = NSPoint(x: 14, y: 12)
+        ingestCount.frame = NSRect(x: ingestHeader.frame.maxX + 8, y: 11,
+                                   width: max(0, list - ingestHeader.frame.maxX - 22), height: 15)
+        let coverageHeight: CGFloat = ingestCoverage.stringValue.isEmpty ? 0 : 46
+        ingestCoverage.frame = NSRect(x: 14, y: 32, width: max(0, list - 28), height: coverageHeight)
+        ingestScroll.frame = NSRect(x: 0, y: 34 + coverageHeight, width: list,
+                                    height: max(0, height - 34 - coverageHeight))
+        ingestButtons.frame = NSRect(x: list + 18, y: 10, width: max(0, width - list - 30), height: 30)
+        ingestDetailScroll.frame = NSRect(x: list, y: 46, width: max(0, width - list), height: max(0, height - 46))
+
+        // The list's edge, where Browse, Search, Process and Ingest show a list.
+        let listTop = tab == .process ? pipelineHeight : (tab == .search ? searchListTop : 0)
+        listHandle.frame = NSRect(x: list - 3, y: content.minY + listTop, width: 6, height: max(0, height - listTop))
+        listHandle.isHidden = ![.browse, .search, .process, .ingest].contains(tab)
+
+        // Digest
+        workspacePopUp.frame = NSRect(x: 12, y: rowY, width: min(360, width * 0.5), height: controlHeight)
+        regenerateButton.sizeToFit()
+        regenerateButton.frame.origin = NSPoint(x: workspacePopUp.frame.maxX + 10, y: rowY - 2)
+        digestStatus.frame = NSRect(x: regenerateButton.frame.maxX + 12, y: rowY + 4,
+                                    width: max(0, width - regenerateButton.frame.maxX - 24), height: 16)
+        digestScroll.frame = NSRect(x: 0, y: 44, width: width, height: max(0, height - 44)).insetBy(dx: 12, dy: 0)
+
+        // Graph
+        graphModeControl.sizeToFit()
+        graphModeControl.frame.origin = NSPoint(x: 12, y: rowY)
+        var x = graphModeControl.frame.maxX + 14
+        for (_, button) in edgeToggles {
+            button.sizeToFit()
+            button.frame.origin = NSPoint(x: x, y: rowY + 2)
+            x = button.frame.maxX + 8
+        }
+        fitButton.sizeToFit()
+        fitButton.frame.origin = NSPoint(x: width - fitButton.frame.width - 12, y: rowY - 2)
+        graphSearch.frame = NSRect(x: max(x + 6, fitButton.frame.minX - 190), y: rowY,
+                                   width: min(180, max(80, fitButton.frame.minX - x - 16)), height: controlHeight)
+        // The filter bar, then the canvas with the breadcrumb on its top left.
+        var filterX: CGFloat = 12
+        for (popUp, popUpWidth) in [(graphTypePopUp, 140), (graphWorkspacePopUp, 200), (graphTimePopUp, 120),
+                                    (graphWeightPopUp, 110)] as [(NSPopUpButton, CGFloat)] {
+            popUp.frame = NSRect(x: filterX, y: rowY + 30, width: popUpWidth, height: 22)
+            filterX += popUpWidth + 8
+        }
+        let canvasTop: CGFloat = 72
+        canvas.frame = NSRect(x: 0, y: canvasTop, width: width, height: max(0, height - canvasTop - 24))
+        graphBackButton.sizeToFit()
+        graphOverviewButton.sizeToFit()
+        graphBackButton.frame.origin = NSPoint(x: 12, y: canvasTop + 6)
+        graphOverviewButton.frame.origin = NSPoint(x: graphBackButton.frame.maxX + 6, y: canvasTop + 6)
+        graphTrail.frame = NSRect(x: graphOverviewButton.frame.maxX + 10, y: canvasTop + 12,
+                                  width: max(0, min(520, width - graphOverviewButton.frame.maxX - 24)), height: 16)
+        graphStatus.frame = NSRect(x: 14, y: height - 20, width: width - 28, height: 16)
+    }
