+import AppKit
+import Foundation
+
+// MARK: - Model
+
+// The tabs of a project's page, as on a repository host.
+enum OmniProjectTab: Int, CaseIterable {
+    case home
+    case code
+    case sessions
+    case knowledge
+    case files
+    case tickets
+    case settings
+
+    var title: String {
+        switch self {
+        case .home: return "Home"
+        case .code: return "Worktrees & Branches"
+        case .sessions: return "Sessions & Agents"
+        case .knowledge: return "Knowledge"
+        case .files: return "Files"
+        case .tickets: return "Tickets"
+        case .settings: return "Settings"
+        }
+    }
+
+    // The tab bar's short label and icon.
+    var label: String {
+        switch self {
+        case .home: return "Home"
+        case .code: return "Branches"
+        case .sessions: return "Sessions"
+        case .knowledge: return "Knowledge"
+        case .files: return "Files"
+        case .tickets: return "Tickets"
+        case .settings: return "Settings"
+        }
+    }
+
+    var symbol: SFSymbol {
+        switch self {
+        case .home: return .house
+        case .code: return .arrowTriangleBranch
+        case .sessions: return .bubbleLeftAndBubbleRight
+        case .knowledge: return .bookClosed
+        case .files: return .folder
+        case .tickets: return .checklist
+        case .settings: return .gearshape
+        }
+    }
+}
+
+// What the Projects pages show. Pure so tests can check it without a window.
+enum OmniProjectsModel {
+    // A path with the home folder written as ~.
+    static func abbreviated(_ path: String, home: String = NSHomeDirectory()) -> String {
+        guard !home.isEmpty, path == home || path.hasPrefix(home + "/") else { return path }
+        return "~" + path.dropFirst(home.count)
+    }
+
+    // "~/Projects/acme/web · 3 checkouts · internal".
+    static func detail(_ project: [String: Any]) -> String {
+        var parts = [abbreviated(project["root"] as? String ?? "")]
+        let checkouts = (project["checkouts"] as? [Any])?.count ?? 0
+        if checkouts > 1 {
+            parts.append("\(checkouts) checkouts")
+        }
+        if let exposure = project["exposure"] as? [String: Any], exposure["listed"] as? Bool == true,
+           let tier = exposure["tier"] as? String {
+            parts.append(tier)
+        }
+        if project["forge"] as? Bool != true {
+            parts.append("no knowledge folder")
+        }
+        return parts.joined(separator: " · ")
+    }
+
+    // The person's name for a project, else forge's.
+    static func name(_ project: [String: Any], aliases: [String: String] = [:]) -> String {
+        if let root = project["root"] as? String, let alias = aliases[root], !alias.isEmpty {
+            return alias
+        }
+        return project["display_name"] as? String ?? project["name"] as? String ?? "Project"
+    }
+
+    static func size(_ bytes: Int?) -> String {
+        guard let bytes else { return "" }
+        return ByteCountFormatter.string(fromByteCount: Int64(bytes), countStyle: .file)
+    }
+
+    // "origin/main ↑2 · subject" from a branch and its upstream tracking text such as "[ahead 2]".
+    static func branchDetail(_ branch: [String: Any]) -> String {
+        var parts: [String] = []
+        if let upstream = branch["upstream"] as? String, !upstream.isEmpty {
+            var text = upstream
+            let track = branch["track"] as? String ?? ""
+            if track.contains("gone") {
+                text += " (gone)"
+            } else {
+                let ahead = Self.count(in: track, after: "ahead ")
+                let behind = Self.count(in: track, after: "behind ")
+                if ahead > 0 { text += " ↑\(ahead)" }
+                if behind > 0 { text += " ↓\(behind)" }
+            }
+            parts.append(text)
+        }
+        if let subject = branch["subject"] as? String, !subject.isEmpty {
+            parts.append(subject)
+        }
+        return parts.joined(separator: " · ")
+    }
+
+    private static func count(in text: String, after marker: String) -> Int {
+        guard let range = text.range(of: marker) else { return 0 }
+        return Int(text[range.upperBound...].prefix { $0.isNumber }) ?? 0
+    }
+
+    // The session's project for grouping: its forge project when known (with
+    // the person's name for it), otherwise the last folder of its path that is
+    // not a worktree slot such as `@head`.
+    static func sessionGroup(_ session: [AnyHashable: Any], aliases: [String: String] = [:]) -> (key: String, title: String) {
+        if let project = session["project"] as? [String: Any], let id = project["id"] as? String {
+            let alias = aliases[project["root"] as? String ?? id] ?? ""
+            let title = alias.isEmpty ? project["name"] as? String ?? (id as NSString).lastPathComponent : alias
+            return (key: "project|" + id, title: title)
+        }
+        let workspace = session["workspace"] as? String ?? ""
+        let name = workspace.split(separator: "/").map(String.init).filter { !$0.hasPrefix("@") }.last ?? ""
+        return (key: "folder|" + workspace, title: name)
+    }
+
+    // "a/b" for a folder inside the project, shown as a breadcrumb.
+    static func breadcrumb(_ path: String) -> String {
+        return path.isEmpty ? "/" : "/ " + path.split(separator: "/").joined(separator: " / ")
+    }
+
+    static func parent(of path: String) -> String {
+        return (path as NSString).deletingLastPathComponent
+    }
+
+    // The knowledge folder as folders: what sits directly in `folder`
+    // (relative to knowledge/): its subfolders with their file counts and
+    // newest change, then its files, each by name.
+    static func knowledgeListing(_ files: [[String: Any]], in folder: String)
+        -> (folders: [(name: String, count: Int, modified: Double?)], files: [[String: Any]]) {
+        var folders: [String: (count: Int, modified: Double?)] = [:]
+        var direct: [[String: Any]] = []
+        let prefix = folder.isEmpty ? "" : folder + "/"
+        for file in files {
+            guard let path = file["path"] as? String else { continue }
+            let relative = path.hasPrefix("knowledge/") ? String(path.dropFirst("knowledge/".count)) : path
+            guard relative.hasPrefix(prefix) else { continue }
+            let rest = relative.dropFirst(prefix.count)
+            let modified = (file["modified"] as? NSNumber)?.doubleValue
+            if let slash = rest.firstIndex(of: "/") {
+                let name = String(rest[..<slash])
+                let known = folders[name] ?? (0, nil)
+                folders[name] = (known.count + 1, [known.modified, modified].compactMap { $0 }.max())
+            } else {
+                direct.append(file)
+            }
+        }
+        let sortedFolders = folders.map { (name: $0.key, count: $0.value.count, modified: $0.value.modified) }
+            .sorted { $0.name.localizedStandardCompare($1.name) == .orderedAscending }
+        let sortedFiles = direct.sorted {
+            ($0["path"] as? String ?? "").localizedStandardCompare($1["path"] as? String ?? "") == .orderedAscending
+        }
+        return (sortedFolders, sortedFiles)
+    }
+}
+
+// The last project list the knowledge worker saved. Read directly so the
+// sidebar and the Projects page show at once after a launch, while the
+// worker may still be busy indexing; its answer replaces it moments later.
+enum OmniProjectsCache {
+    static var path: String {
+        return (NSHomeDirectory() as NSString).appendingPathComponent("Library/Application Support/OmniTerm/forge-projects.json")
+    }
+
+    static func load() -> [[String: Any]] {
+        guard let data = FileManager.default.contents(atPath: path),
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let projects = object["projects"] as? [[String: Any]] else { return [] }
+        return projects.filter { $0["root"] is String }.map { project in
+            project.filter { !$0.key.hasPrefix("_") }
+        }
+    }
+}
+
+// MARK: - Page
+
+// The Projects pages: every forge project on this Mac (`.projects`), and one
+// project (`.project(root)`) in tabs: Home, Worktrees & Branches, Sessions &
+// Agents, Knowledge, Files and Settings. Data comes from forge through the
+// knowledge worker (`list_projects`, `get_project`, `list_project_folder`,
+// `get_project_file`, `list_sessions` with `project`); README and file text
+// are untrusted and shown through the safe Markdown view, with no clickable
+// links. Each tab loads what it needs the first time it is shown.
+final class OmniProjectsPane: OmniPane, NSTextFieldDelegate {
+    // The tab a project page opens on: the last one used.
+    private static var lastTab = OmniProjectTab.home
+
+    private let projectID: String?
+    private let scroll = OmniColumnScrollView()
+    private let statusLabel = OmniTheme.meta()
+    private var projects: [[String: Any]] = []
+    private var forge: [String: Any] = [:]
+    private var settings: [String: Any] = [:]
+    private var project: [String: Any]?
+    private var tab = OmniProjectsPane.lastTab
+    private var sessions: [[AnyHashable: Any]]?
+    private var agents: [[AnyHashable: Any]]?
+    private var folderPath = ""
+    private var folder: [String: Any]?
+    private var openFile: (path: String, text: String)?
+    // The Knowledge tab's folder, inside the knowledge folder.
+    private var knowledgePath = ""
+    private var unknownRetries = 0
+    // The sidebar reloads the page every two seconds. A reload never overlaps
+    // the one still answering, and a page whose data came back unchanged is
+    // not rebuilt (its README is not laid out again).
+    private var reloading = false
+    private var buttonsZone: OmniButtonZone?
+    private var tabsZone: OmniButtonZone?
+    private(set) var zones: [(title: String, zone: OmniListZone)] = []
+    private let fileView = OmniMarkdownView(text: "")
+    private let readmeView = OmniMarkdownView(text: "")
+    private var tickets: OmniTicketsController?
+
+    override var contentViews: [NSView] {
+        return [scroll]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return [tabsZone, buttonsZone].compactMap { $0 } + zones.map(\.zone)
+    }
+
+    init(projectID: String?) {
+        self.projectID = projectID
+        super.init()
+        addSubview(scroll)
+        for view in [fileView, readmeView] {
+            view.didChangeHeight = { [weak self] in self?.scroll.relayout() }
+        }
+        readmeView.collapsedHeight = OmniMarkdownView.height(lines: 24)
+        // Their bordered file boxes frame them already.
+        fileView.drawsCard = false
+        readmeView.drawsCard = false
+        // Read as on a repository host: rendered, not styled in place.
+        fileView.rendersMarkdown = true
+        readmeView.rendersMarkdown = true
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        scroll.frame = bounds
+    }
+
+    override func reload() {
+        guard !reloading else { return }
+        reloading = true
+        OmniSchedulerClient.request(["op": "get_settings"]) { [weak self] response in
+            guard let self else { return }
+            let settings = response["settings"] as? [String: Any] ?? [:]
+            let changed = !NSDictionary(dictionary: settings).isEqual(to: self.settings)
+            self.settings = settings
+            if let projectID = self.projectID {
+                self.reloadProject(projectID, refresh: false, force: changed)
+            } else {
+                self.reloadList(refresh: false, force: changed)
+            }
+        }
+    }
+
+    private var layout: [String: Any] {
+        return settings["projects"] as? [String: Any] ?? [:]
+    }
+
+    private var aliases: [String: String] {
+        return layout["names"] as? [String: String] ?? [:]
+    }
+
+    private func reloadList(refresh: Bool, force: Bool = true) {
+        if projects.isEmpty {
+            projects = OmniProjectsCache.load()
+            if !projects.isEmpty {
+                forge = ["available": true]
+                rebuild()
+            }
+        }
+        var request: [String: Any] = ["op": "list_projects"]
+        if refresh {
+            request["refresh"] = true
+        }
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self else { return }
+            self.reloading = false
+            guard OmniPane.isOK(response) else {
+                self.showMessage(OmniPane.unreachableMessage(response))
+                return
+            }
+            let forge = response["forge"] as? [String: Any] ?? [:]
+            let projects = response["projects"] as? [[String: Any]] ?? []
+            let unchanged = NSDictionary(dictionary: forge).isEqual(to: self.forge) &&
+                NSArray(array: projects).isEqual(to: self.projects)
+            self.forge = forge
+            self.projects = projects
+            // A message (an earlier failure) is replaced even by unchanged data.
+            if force || !unchanged || !self.messageLabel.isHidden {
+                self.rebuild()
+            }
+        }
+    }
+
+    private func reloadProject(_ id: String, refresh: Bool, force: Bool = true) {
+        if project == nil {
+            let known = OmniProjectsCache.load().first { $0["root"] as? String == id }
+            showMessage("Loading " + (known.map { OmniProjectsModel.name($0, aliases: aliases) } ?? "the project") + "…")
+        }
+        var request: [String: Any] = ["op": "get_project", "project": id]
+        if refresh {
+            request["refresh"] = true
+        }
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self else { return }
+            self.reloading = false
+            guard OmniPane.isOK(response), let project = response["project"] as? [String: Any] else {
+                let error = response["error"] as? String
+                // Just after a launch the worker may not have listed the
+                // projects yet: ask again a few times before giving up.
+                if error == "unknown project", self.unknownRetries < 5 {
+                    self.unknownRetries += 1
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { [weak self] in
+                        self?.reloadProject(id, refresh: false)
+                    }
+                    return
+                }
+                self.showMessage("This project could not be read." + (error.map { "\n\($0)" } ?? ""))
+                return
+            }
+            let unchanged = self.project.map { NSDictionary(dictionary: $0).isEqual(to: project) } ?? false
+            self.project = project
+            if !force && !refresh && unchanged && self.messageLabel.isHidden {
+                self.loadTabData()
+                return
+            }
+            if let readme = project["readme"] as? [String: Any], let text = readme["text"] as? String {
+                self.readmeView.text = OmniReportText.sanitized(text)
+            }
+            if refresh {
+                self.sessions = nil
+                self.agents = nil
+                self.folder = nil
+            }
+            self.loadTabData()
+            self.rebuild()
+        }
+    }
+
+    // What the current tab needs beyond the project itself, loaded once.
+    private func loadTabData() {
+        guard let projectID else { return }
+        switch tab {
+        case .home, .sessions:
+            if sessions == nil {
+                OmniSchedulerClient.request(["op": "list_sessions", "order": "recent", "limit": 50,
+                                             "project": projectID]) { [weak self] response in
+                    self?.sessions = response["sessions"] as? [[AnyHashable: Any]] ?? []
+                    self?.rebuild()
+                }
+            }
+            if tab == .sessions, agents == nil {
+                loadAgents(projectID)
+            }
+        case .files:
+            if folder == nil {
+                loadFolder(folderPath)
+            }
+        case .tickets:
+            if tickets == nil {
+                let controller = OmniTicketsController(root: projectID)
+                controller.requestRebuild = { [weak self] in self?.rebuild() }
+                controller.visibleHeight = { [weak self] in self?.scroll.contentSize.height ?? 600 }
+                controller.window = { [weak self] in self?.window }
+                tickets = controller
+            }
+        case .code, .knowledge, .settings:
+            break
+        }
+    }
+
+    private func loadAgents(_ projectID: String) {
+        OmniSchedulerClient.request(["op": "list_agents"]) { [weak self] response in
+            let all = response["agents"] as? [[AnyHashable: Any]] ?? []
+            let paths = all.compactMap { $0["workspace"] as? String }
+            OmniSchedulerClient.request(["op": "project_of", "paths": paths]) { [weak self] mapped in
+                let owners = mapped["projects"] as? [String: Any] ?? [:]
+                self?.agents = all.filter { agent in
+                    guard let workspace = agent["workspace"] as? String else { return false }
+                    return owners[workspace] as? String == projectID
+                }
+                self?.rebuild()
+            }
+        }
+    }
+
+    private func loadFolder(_ path: String) {
+        guard let projectID else { return }
+        var request: [String: Any] = ["op": "list_project_folder", "project": projectID]
+        if !path.isEmpty {
+            request["path"] = path
+        }
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response), let folder = response["folder"] as? [String: Any] {
+                self.folderPath = folder["path"] as? String ?? path
+                self.folder = folder
+            } else {
+                self.folder = ["path": path, "entries": [], "error": response["error"] as? String ?? "This folder could not be read."]
+            }
+            self.rebuild()
+        }
+    }
+
+    private func rebuild() {
+        // A rebuild takes the ticket editor out of the window for a moment.
+        let editing = window?.firstResponder as? OmniMarkdownTextView
+        defer {
+            if let editing, editing.window != nil, window?.firstResponder !== editing {
+                window?.makeFirstResponder(editing)
+            }
+        }
+        preservingZoneFocus {
+            scroll.rebuildKeepingScroll {
+                let column = scroll.column
+                column.removeAll()
+                let previous = zones
+                zones = []
+                if project != nil {
+                    buildProject(previous)
+                } else {
+                    buildList(previous)
+                }
+            }
+        }
+        showContent()
+    }
+
+    // MARK: List
+
+    private func buildList(_ previous: [(title: String, zone: OmniListZone)]) {
+        let column = scroll.column
+        column.addText(OmniTheme.title("Projects"), spacing: 4)
+        let intro = OmniPaneText.label(
+            "Every Forge project on this Mac: folders found under your project roots, plus any a session opened " +
+            "in or you added with forge projects add. Worktrees and @head, @maintenance or @production " +
+            "checkouts count as their project. Arrange them in folders in the sidebar’s Projects mode.",
+            size: 12.5, color: OmniTheme.secondaryText)
+        column.add(intro, spacing: 6) { [weak intro] width in
+            intro?.sizeThatFits(NSSize(width: width, height: 400)).height ?? 40
+        }
+        let refresh = OmniPaneText.button("Refresh", target: self, action: #selector(refreshList(_:)))
+        let buttons = OmniButtonRow([refresh])
+        buttonsZone = buttons.zone
+        tabsZone = nil
+        column.add(buttons, spacing: 10) { _ in 30 }
+        if forge["available"] as? Bool != true {
+            let reason = forge["error"] as? String ?? "Forge has not answered yet."
+            setStatus("Forge is unavailable: \(reason)", error: true)
+            column.addText(statusLabel, spacing: 10)
+        }
+        let names = aliases
+        let looks = OmniProjectLayout(layout)
+        let byRoot = Dictionary(projects.compactMap { project in (project["root"] as? String).map { ($0, project) } },
+                                uniquingKeysWith: { first, _ in first })
+        func row(_ root: String) -> (key: String, row: OmniZoneItem)? {
+            guard let project = byRoot[root] else { return nil }
+            let updated = (project["updated"] as? NSNumber)?.doubleValue
+            let look = looks.appearance(root)
+            let row = OmniFolderEntryRow(icon: look.icon ?? .symbol(SFSymbol.shippingbox.rawValue),
+                                         iconColor: OmniAgentColor.color(look.color),
+                                         title: OmniProjectsModel.name(project, aliases: names),
+                                         detail: OmniProjectsModel.detail(project),
+                                         badge: OmniSessionText.age(updated), status: nil) { [weak self] in
+                self?.actions?.paneOpen(.project(root))
+            }
+            row.contextMenu = { [weak self] in OmniContextMenus.project(root, actions: self?.actions) }
+            return (key: root, row: row)
+        }
+        if byRoot.isEmpty, forge["available"] as? Bool == true {
+            column.addText(OmniTheme.meta("No forge projects found. Run forge projects add in a project to register it."))
+        }
+        // Grouped as in the sidebar: each folder and subfolder is a section,
+        // in the person's order, with its icon and colour; projects outside
+        // any folder come first.
+        column.addText(OmniTheme.meta(byRoot.count == 1 ? "1 project" : "\(byRoot.count) projects"), spacing: 4)
+        let tree = looks.tree(roots: Array(byRoot.keys))
+        let loose = tree.entries.compactMap { entry -> String? in
+            if case .agent(let root) = entry { return root }
+            return nil
+        }
+        section("Not in a folder", key: "projects", previous: previous, rows: loose.compactMap(row))
+        func walk(_ group: OmniGroupTree.Group, depth: Int) {
+            let rows = group.agents.compactMap(row)
+            let count = Self.projectCount(group)
+            guard count > 0 else { return }
+            let look = looks.appearance(OmniProjectLayout.folderKey(group.path))
+            let heading = OmniFolderHeading(icon: look.icon ?? .symbol(SFSymbol.folderFill.rawValue),
+                                            color: OmniAgentColor.color(look.color) ?? OmniTheme.folderTint,
+                                            title: group.path.replacingOccurrences(of: "/", with: "  /  "),
+                                            count: count == 1 ? "1 project" : "\(count) projects")
+            column.add(heading, spacing: 4) { _ in OmniFolderHeading.height }
+            section(group.path, key: "folder:" + group.path, previous: previous, rows: rows, header: false)
+            for subgroup in group.subgroups {
+                walk(subgroup, depth: depth + 1)
+            }
+        }
+        for entry in tree.entries {
+            if case .group(let group) = entry {
+                walk(group, depth: 0)
+            }
+        }
+    }
+
+    private static func projectCount(_ group: OmniGroupTree.Group) -> Int {
+        return group.agents.count + group.subgroups.reduce(0) { $0 + projectCount($1) }
+    }
+
+    // MARK: One project
+
+    private func buildProject(_ previous: [(title: String, zone: OmniListZone)]) {
+        guard let project else { return }
+        let column = scroll.column
+        let root = project["root"] as? String ?? ""
+        let look = OmniProjectLayout(layout).appearance(root)
+        let header = OmniProjectHeader(icon: look.icon ?? .symbol(SFSymbol.shippingbox.rawValue),
+                                       color: OmniAgentColor.color(look.color),
+                                       title: OmniProjectsModel.name(project, aliases: aliases),
+                                       detail: OmniProjectsModel.detail(project))
+        column.add(header, spacing: 12) { _ in OmniProjectHeader.height }
+        // The tabs, as on a repository host; buttons, so they join the keyboard.
+        let tabs = OmniTabBar(tabs: OmniProjectTab.allCases.map { (title: $0.label, symbol: $0.symbol) },
+                              selected: tab.rawValue, target: self, action: #selector(tabClicked(_:)))
+        tabsZone = tabs.zone
+        buttonsZone = nil
+        column.add(tabs, spacing: 16) { _ in OmniTabBar.height }
+        switch tab {
+        case .home: buildHome(project, previous)
+        case .code: buildCode(project, previous)
+        case .sessions: buildSessions(previous)
+        case .knowledge: buildKnowledge(project, previous)
+        case .files: buildFiles(previous)
+        case .tickets:
+            if let tickets {
+                zones = tickets.build(into: column, previous: previous)
+                buttonsZone = tickets.buttonsZone
+            }
+        case .settings: buildSettings(project)
+        }
+    }
+
+    private var git: [String: Any]? {
+        return project?["git"] as? [String: Any]
+    }
+
+    private func repositoryFacts(_ project: [String: Any]) -> [(String, String)] {
+        var facts: [(String, String)] = []
+        if let git {
+            if let branch = git["branch"] as? String {
+                facts.append(("Branch", branch))
+            }
+            if let changes = git["changes"] as? NSNumber {
+                facts.append(("Uncommitted", changes.intValue == 0 ? "Clean" : "\(changes.intValue) changed files"))
+            }
+            if let last = git["last_commit"] as? [String: Any] {
+                let when = Date(timeIntervalSince1970: (last["time"] as? NSNumber)?.doubleValue ?? 0)
+                let sha = String((last["sha"] as? String ?? "").prefix(9))
+                facts.append(("Last commit", "\(sha) · \(OmniFormat.relative(when)) · \(last["subject"] as? String ?? "")"))
+            }
+            for remote in git["remotes"] as? [[String: Any]] ?? [] {
+                facts.append(("Remote \(remote["name"] as? String ?? "")", remote["url"] as? String ?? ""))
+            }
+        } else {
+            facts.append(("Repository", "Not a git repository"))
+        }
+        if let exposure = project["exposure"] as? [String: Any] {
+            let tier = exposure["tier"] as? String ?? "protected"
+            let guardText = exposure["guard"] as? String ?? ""
+            let listed = exposure["listed"] as? Bool == true
+            facts.append(("Exposure", (listed ? tier : "\(tier) (not in the map)") + (guardText.isEmpty ? "" : " · \(guardText)")))
+        }
+        return facts
+    }
+
+    private func buildHome(_ project: [String: Any], _ previous: [(title: String, zone: OmniListZone)]) {
+        let column = scroll.column
+        var facts = repositoryFacts(project)
+        let worktrees = git?["worktrees"] as? [[String: Any]] ?? []
+        if !worktrees.isEmpty {
+            facts.append(("Worktrees", worktrees.map { worktree in
+                let name = worktree["name"] as? String ?? ""
+                let branch = worktree["branch"] as? String ?? ""
+                return branch.isEmpty || branch == name ? name : "\(name) (\(branch))"
+            }.joined(separator: ", ")))
+        }
+        let branches = git?["branches"] as? [[String: Any]] ?? []
+        if !branches.isEmpty {
+            let names = branches.prefix(6).compactMap { $0["name"] as? String }
+            facts.append(("Branches", names.joined(separator: ", ") + (branches.count > 6 ? " and \(branches.count - 6) more" : "")))
+        }
+        column.addText(OmniPane.facts(facts), spacing: 8)
+        if let sessions {
+            let rows = sessionRows(Array(sessions.prefix(5)))
+            if rows.isEmpty {
+                column.addSection("Recent sessions")
+                column.addText(OmniTheme.meta("No Claude or Codex session in this project yet."))
+            } else {
+                section("Recent sessions", key: "home-sessions", previous: previous, rows: rows)
+            }
+        }
+        if let readme = project["readme"] as? [String: Any] {
+            let name = readme["name"] as? String ?? readme["path"] as? String ?? "README.md"
+            addFileBox(title: [(label: name, path: "")], trailing: "", view: readmeView, open: { _ in }, spacing: 16)
+        }
+    }
+
+    private func buildCode(_ project: [String: Any], _ previous: [(title: String, zone: OmniListZone)]) {
+        let column = scroll.column
+        guard let git else {
+            column.addText(OmniTheme.meta("Not a git repository."))
+            return
+        }
+        let worktrees = git["worktrees"] as? [[String: Any]] ?? []
+        section("Worktrees", key: "worktrees", previous: previous, rows: worktrees.compactMap { worktree in
+            guard let path = worktree["path"] as? String else { return nil }
+            let branch = worktree["branch"] as? String ?? (worktree["detached"] as? Bool == true ? "detached" : "")
+            let row = OmniFolderEntryRow(icon: .symbol(SFSymbol.folder.rawValue), iconColor: nil,
+                                         title: worktree["name"] as? String ?? (path as NSString).lastPathComponent,
+                                         detail: [branch, OmniProjectsModel.abbreviated(path)].filter { !$0.isEmpty }
+                                            .joined(separator: " · "),
+                                         badge: worktree["prunable"] as? Bool == true ? "prunable" : "", status: nil) {
+                NSWorkspace.shared.selectFile(nil, inFileViewerRootedAtPath: path)
+            }
+            row.contextMenu = { OmniContextMenus.path(path, open: nil) }
+            return (key: path, row: row)
+        })
+        let current = git["branch"] as? String
+        let branches = git["branches"] as? [[String: Any]] ?? []
+        section("Branches", key: "branches", previous: previous, rows: branches.compactMap { branch in
+            guard let name = branch["name"] as? String else { return nil }
+            let updated = (branch["updated"] as? NSNumber)?.doubleValue
+            let row = OmniFolderEntryRow(icon: .symbol(SFSymbol.arrowTriangleBranch.rawValue), iconColor: nil,
+                                         title: name, detail: OmniProjectsModel.branchDetail(branch),
+                                         badge: OmniSessionText.age(updated),
+                                         status: name == current ? OmniTheme.running : nil) {}
+            row.contextMenu = {
+                let menu = NSMenu()
+                menu.addAction("Copy Branch Name", symbol: .docOnDoc) { OmniContextMenus.copy(name) }
+                return menu
+            }
+            return (key: name, row: row)
+        })
+        if branches.count >= 40 {
+            column.addText(OmniTheme.meta("The 40 most recently changed branches."))
+        }
+    }
+
+    private func sessionRows(_ sessions: [[AnyHashable: Any]]) -> [(key: String, row: OmniZoneItem)] {
+        return sessions.compactMap { session in
+            guard let sessionID = session["session_id"] as? String else { return nil }
+            let live = OmniSessionText.isLive(session)
+            let updated = (session["updated"] as? NSNumber)?.doubleValue
+            let row = OmniFolderEntryRow(icon: .symbol(OmniSessionText.providerSymbol(session["provider"] as? String)),
+                                         iconColor: live ? OmniTheme.running : nil,
+                                         title: OmniSessionText.title(session["title"] as? String),
+                                         detail: OmniSessionText.detail(session),
+                                         badge: OmniSessionText.age(updated),
+                                         status: live ? OmniTheme.running : nil) { [weak self] in
+                self?.actions?.paneOpen(.session(sessionID))
+            }
+            row.contextMenu = { [weak self] in OmniContextMenus.session(session, actions: self?.actions, window: self?.window) }
+            return (key: sessionID, row: row)
+        }
+    }
+
+    private func buildSessions(_ previous: [(title: String, zone: OmniListZone)]) {
+        let column = scroll.column
+        if let agents {
+            let rows: [(key: String, row: OmniZoneItem)] = agents.compactMap { agent in
+                guard let name = agent["name"] as? String else { return nil }
+                let row = OmniFolderEntryRow(icon: OmniAgentIcon(spec: agent["icon"] as? String) ?? .symbol(OmniAgentIcon.defaultSymbol),
+                                             iconColor: OmniAgentColor.color(agent["color"] as? String),
+                                             title: name, detail: (agent["schedule"] as? [String: Any])?["phrase"] as? String ?? "",
+                                             badge: agent["enabled"] as? Bool == false ? "paused" : "", status: nil) { [weak self] in
+                    self?.actions?.paneOpen(.agent(name))
+                }
+                let enabled = agent["enabled"] as? Bool
+                row.contextMenu = { [weak self] in
+                    OmniContextMenus.agent(name, enabled: enabled, actions: self?.actions, window: self?.window) {
+                        self?.agents = nil
+                        self?.loadTabData()
+                    }
+                }
+                return (key: name, row: row)
+            }
+            if rows.isEmpty {
+                column.addSection("Agents")
+                column.addText(OmniTheme.meta("No OmniTerm agent works in this project."))
+            } else {
+                section("Agents", key: "agents", previous: previous, rows: rows)
+            }
+        } else {
+            column.addSection("Agents")
+            column.addText(OmniTheme.meta("Loading…"))
+        }
+        guard let sessions else {
+            column.addSection("Sessions")
+            column.addText(OmniTheme.meta("Loading…"))
+            return
+        }
+        let rows = sessionRows(sessions)
+        if rows.isEmpty {
+            column.addSection("Sessions")
+            column.addText(OmniTheme.meta("No Claude or Codex session in this project yet."))
+        } else {
+            section(sessions.count >= 50 ? "50 most recent sessions" : "Sessions", key: "sessions", previous: previous, rows: rows)
+        }
+    }
