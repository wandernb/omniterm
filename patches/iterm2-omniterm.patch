+            NSString *name = session.profile[KEY_NAME];
+            isDashboard |= [name isEqualToString:@"Omni"] || [name isEqualToString:@"AGENTS"];
+            allExited &= session.exited;
+        }
+        PTYSession *onlySession = tab.sessions.count == 1 ? tab.sessions.firstObject : nil;
+        const BOOL isManaged = [onlySession.environment[@"OMNITERM_MANAGED"] isEqualToString:@"1"];
+        // Creating the first terminal window necessarily creates a temporary
+        // default shell. Its working directory may be inherited from iTerm2
+        // (for example ~/Projects), so cwd is not a reliable discriminator.
+        const BOOL isIdlePlaceholderShell = (onlySession &&
+                                             !isManaged &&
+                                             !onlySession.exited &&
+                                             !onlySession.hasNontrivialJob);
+        // A restored managed tab that has lost its agent identity presents as
+        // “Terminal (Python)”. It is an orphaned runner rather than a usable
+        // retained agent tab, even though the Python supervisor may still be
+        // waiting on a detached descendant.
+        // An adopted run whose OMNITERM_RUN_ID was read back is a live run
+        // tab, not an orphan, and closing it would end the run.
+        const BOOL isOrphanedManagedRunner = (onlySession &&
+                                              onlySession.environment[@"OMNITERM_RUN_ID"] == nil &&
+                                              [onlySession.name hasPrefix:@"Terminal"] &&
+                                              [onlySession.name containsString:@"Python"]);
+        if (isIdlePlaceholderShell && !firstPlaceholder) {
+            firstPlaceholder = tab;
+        }
+        if (isDashboard || allExited || isIdlePlaceholderShell || isOrphanedManagedRunner) {
+            [closing addObject:tab];
+        }
+    }
+    // Without a dashboard tab to keep, the window keeps one plain shell: its
+    // last tab closing would close the window.
+    if (!dashboardTab && closing.count == terminal.tabs.count) {
+        if (firstPlaceholder) {
+            [closing removeObject:firstPlaceholder];
+        } else {
+            MutableProfile *profile = [[[[ProfileModel sharedInstance] defaultBookmark] mutableCopy] autorelease];
+            [terminal asyncCreateTabWithProfile:profile
+                                    withCommand:nil
+                                    environment:@{}
+                                       tabIndex:nil
+                                 didMakeSession:^(PTYSession *session) {
+                [self cleanOmniTermStartupTabsInTerminal:terminal keepingTab:nil];
+            }
+                                     completion:nil];
+            return;
+        }
+    }
+    for (PTYTab *tab in closing) {
+        tab.pinned = NO;
+        [terminal closeTab:tab];
+    }
+    dashboardTab.pinned = NO;
+    const NSInteger dashboardIndex = [terminal.tabs indexOfObject:dashboardTab];
+    if (dashboardIndex > 0 && dashboardIndex != NSNotFound) {
+        [terminal moveTabAtIndex:dashboardIndex toIndex:0];
+    }
+}
+
+// Agent tabs never outlive their run. This is deliberately not a profile end
+// action: run tabs share the default profile's GUID, so any change to that
+// profile (including one made by iTerm2, which shares these defaults) would
+// silently reset an override.
+// The last lines of a run's terminal, with SGR colour sequences, so the run's
+// report can show what was on screen after its tab closed.
+static const int OmniRunScreenLineLimit = 2000;
+
+- (NSString *)omniScreenForSession:(PTYSession *)session truncated:(BOOL *)truncated {
+    PTYTextView *textView = session.textview;
+    id<PTYTextViewDataSource> dataSource = textView.dataSource;
+    const int lines = dataSource.numberOfLines;
+    if (!textView || !dataSource || lines <= 0) {
+        return nil;
+    }
+    const int kept = MIN(lines, OmniRunScreenLineLimit);
+    *truncated = lines > kept;
+    const long long firstLine = dataSource.totalScrollbackOverflow + lines - kept;
+    // A separate selection: the person's own selection is left alone.
+    iTermSelection *selection = [[[iTermSelection alloc] init] autorelease];
+    selection.delegate = textView;
+    [selection beginSelectionAtAbsCoord:VT100GridAbsCoordMake(0, firstLine)
+                                   mode:kiTermSelectionModeCharacter
+                                 resume:NO
+                                 append:NO];
+    [selection moveSelectionEndpointTo:VT100GridAbsCoordMake(dataSource.width, firstLine + kept - 1)];
+    [selection endLiveSelection];
+    id text = [textView selectedTextWithStyle:iTermCopyTextStyleWithControlSequences
+                                 cappedAtSize:0
+                            minimumLineNumber:0
+                                   timestamps:NO
+                                    selection:selection];
+    return [text isKindOfClass:[NSString class]] ? text : nil;
+}
+
+- (void)saveOmniScreenForSession:(PTYSession *)session {
+    NSString *runID = session.environment[@"OMNITERM_RUN_ID"];
+    if (!runID.length) {
+        return;
+    }
+    BOOL truncated = NO;
+    NSString *screen = [self omniScreenForSession:session truncated:&truncated];
+    if (screen) {
+        [_omniScheduler storeScreen:screen truncated:truncated forRun:runID];
+    }
+}
+
+- (void)saveOmniScreenForRun:(NSString *)runID {
+    for (PseudoTerminal *terminal in self.terminals) {
+        for (PTYSession *session in terminal.allSessions) {
+            if ([session.environment[@"OMNITERM_RUN_ID"] isEqualToString:runID]) {
+                [self saveOmniScreenForSession:session];
+                return;
+            }
+        }
+    }
+}
+
+- (void)omniTermSessionDidTerminate:(NSNotification *)notification {
+    PTYSession *session = notification.object;
+    if (![session.environment[@"OMNITERM_KIND"] isEqualToString:@"run"]) {
+        return;
+    }
+    [self saveOmniScreenForSession:session];
+    // Termination is announced from inside brokenPipe; let it unwind first.
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [session.delegate closeSession:session];
+    });
+}
