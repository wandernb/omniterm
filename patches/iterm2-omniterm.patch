+        if ([operation isEqual:@"runner_loop_claim"]) {
+            if (!idle || ![state isEqual:@"pending"] || ![token isEqual:request[@"token"]]) return @{ @"ok": @NO, @"error": @"Loop turn is busy or already claimed" };
