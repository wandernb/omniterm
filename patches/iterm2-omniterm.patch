+- (void)testKnowledgeTickBudgetTiers {
+    NSDictionary *interactive = OmniEmbedRequest(5, YES, NO, 0);
+    NSDictionary *idle = OmniEmbedRequest(600, YES, NO, 0);
+    OmniKnowledgeBudget budget = OmniKnowledgeTickBudget(interactive, 0, NO);
+    XCTAssertEqual(budget.scans, 1);
+    XCTAssertEqual(budget.writeBytes, 1024u * 1024u);
+    XCTAssertEqualWithAccuracy(budget.workSeconds, 0.5, 1e-9);
+    XCTAssertTrue(budget.embed && budget.maintenance);
+    budget = OmniKnowledgeTickBudget(idle, 0, NO);
+    XCTAssertEqualObjects(@(budget.tier), @"idle");
+    XCTAssertGreaterThan(budget.scans, 1);
+    XCTAssertEqualObjects(@(OmniKnowledgeTickBudget(idle, 0, YES).tier), @"interactive", @"no catch-up burst after a wake");
+    XCTAssertEqualObjects(@(OmniKnowledgeTickBudget(OmniEmbedRequest(600, NO, NO, 0), 0, NO).tier), @"interactive", @"battery");
+    XCTAssertEqualObjects(@(OmniKnowledgeTickBudget(OmniEmbedRequest(600, YES, YES, 0), 0, NO).tier), @"interactive", @"Low Power Mode");
+    XCTAssertEqualObjects(@(OmniKnowledgeTickBudget(OmniEmbedRequest(600, YES, NO, 2), 0, NO).tier), @"interactive", @"thermal");
+    for (NSInteger level = 1; level <= 2; level++) {
