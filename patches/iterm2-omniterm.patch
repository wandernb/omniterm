+++ b/ModernTests/OmniFocusZoneTests.swift
@@ -0,0 +1,283 @@
+//
+//  OmniFocusZoneTests.swift
+//  ModernTests
+//
+//  The keyboard zones on their own (a list, a row of buttons, the focus
+//  hold) and the Inbox's list and detail, driven with key events in an
+//  offscreen window against a fake scheduler.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+private final class FakeRow: NSView, OmniZoneItem {
+    var isSelected = false
+    var zoneHasFocus = false
+    var activations = 0
+
+    func activate() {
+        activations += 1
+    }
+}
+
+private final class ClickCounter: NSObject {
+    var clicks: [String] = []
+
+    @objc func clicked(_ sender: NSButton) {
+        clicks.append(sender.title)
+    }
+}
+
+private func keyEvent(_ code: UInt16, _ characters: String, _ flags: NSEvent.ModifierFlags = [],
+                      window: NSWindow?) -> NSEvent {
+    return NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: flags, timestamp: 0,
+                            windowNumber: window?.windowNumber ?? 0, context: nil, characters: characters,
+                            charactersIgnoringModifiers: characters, isARepeat: false, keyCode: code)!
+}
+
+private func arrow(_ code: UInt16, _ key: Int, window: NSWindow?) -> NSEvent {
+    return keyEvent(code, String(Character(UnicodeScalar(UInt32(key))!)), [.numericPad, .function], window: window)
+}
+
+final class OmniFocusZoneTests: XCTestCase {
+    private var window: NSWindow!
+
+    override func setUp() {
+        super.setUp()
+        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 400, height: 300), styleMask: [.titled],
+                          backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+    }
+
+    override func tearDown() {
+        OmniSchedulerClient.testTransport = nil
+        window.close()
+        window = nil
+        super.tearDown()
+    }
+
+    private var up: NSEvent { arrow(126, NSUpArrowFunctionKey, window: window) }
+    private var down: NSEvent { arrow(125, NSDownArrowFunctionKey, window: window) }
+    private var left: NSEvent { arrow(123, NSLeftArrowFunctionKey, window: window) }
+    private var right: NSEvent { arrow(124, NSRightArrowFunctionKey, window: window) }
+    private var returnKey: NSEvent { keyEvent(36, "\r", window: window) }
+    private var tab: NSEvent { keyEvent(48, "\t", window: window) }
+
+    // MARK: - List zone
+
+    private func listZone(rows: [FakeRow]) -> OmniListZone {
+        let zone = OmniListZone(frame: NSRect(x: 0, y: 0, width: 200, height: 200))
+        for row in rows {
+            window.contentView?.addSubview(row)
+        }
+        window.contentView?.addSubview(zone)
+        zone.setItems(rows.enumerated().map { ("row-\($0.offset)", $0.element as OmniZoneItem) })
+        return zone
+    }
+
+    func testListZoneEntersOnTheFirstRowAndMovesWithinItsEnds() {
+        let rows = [FakeRow(), FakeRow(), FakeRow()]
+        let zone = listZone(rows: rows)
+        var chosen: [String] = []
+        zone.selectionDidChange = { chosen.append($0) }
+        XCTAssertTrue(zone.zoneCanEnter)
+        zone.zoneEnter()
+        XCTAssertTrue(window.firstResponder === zone)
+        XCTAssertEqual(zone.selectedKey, "row-0")
+        XCTAssertTrue(rows[0].isSelected)
+        XCTAssertTrue(rows[0].zoneHasFocus, "The selection shows the zone has the keyboard")
+
+        XCTAssertTrue(zone.zoneHandleKey(down))
+        XCTAssertTrue(zone.zoneHandleKey(down))
+        XCTAssertTrue(zone.zoneHandleKey(down))
+        XCTAssertEqual(zone.selectedKey, "row-2", "Down stops at the last row")
+        XCTAssertTrue(zone.zoneHandleKey(up))
+        XCTAssertEqual(zone.selectedKey, "row-1")
+        XCTAssertEqual(rows.map(\.isSelected), [false, true, false])
+        XCTAssertEqual(chosen, ["row-0", "row-1", "row-2", "row-1"])
+
+        XCTAssertTrue(zone.zoneHandleKey(returnKey))
+        XCTAssertEqual(rows.map(\.activations), [0, 1, 0], "Return activates the selected row")
+    }
+
+    func testListZoneKeepsItsSelectionAcrossARebuild() {
+        let zone = listZone(rows: [FakeRow(), FakeRow()])
+        zone.zoneEnter()
+        XCTAssertTrue(zone.zoneHandleKey(down))
+        let rebuilt = [FakeRow(), FakeRow(), FakeRow()]
+        zone.setItems([("row-9", rebuilt[0]), ("row-1", rebuilt[1]), ("row-0", rebuilt[2])])
+        XCTAssertEqual(zone.selectedKey, "row-1")
+        XCTAssertEqual(rebuilt.map(\.isSelected), [false, true, false])
+        zone.setItems([("row-9", FakeRow())])
+        XCTAssertNil(zone.selectedKey, "A row that went away is no longer selected")
+    }
+
+    func testListZoneExitsWithLeftEscapeAndTab() {
+        let zone = listZone(rows: [FakeRow()])
+        var exits: [OmniZoneExit] = []
+        zone.zoneExit = { exits.append($0) }
+        zone.zoneEnter()
+        XCTAssertTrue(zone.zoneHandleKey(left))
+        XCTAssertTrue(zone.zoneHandleKey(keyEvent(53, "\u{1b}", window: window)))
+        XCTAssertTrue(zone.zoneHandleKey(tab))
+        XCTAssertTrue(zone.zoneHandleKey(keyEvent(48, "\u{19}", .shift, window: window)))
+        XCTAssertEqual(exits, [.back, .back, .next, .previous])
+        XCTAssertTrue(zone.zoneHandleKey(right), "Right is kept from the terminal")
+        XCTAssertFalse(zone.zoneHandleKey(keyEvent(0, "a", window: window)), "Typing is not the zone's")
+    }
+
+    func testAnEmptyListCannotBeEntered() {
+        let zone = listZone(rows: [])
+        XCTAssertFalse(zone.zoneCanEnter)
+    }
+
+    // MARK: - Button zone
+
+    func testButtonZoneMovesBetweenUsableButtonsAndPresses() {
+        let counter = ClickCounter()
+        let buttons = ["One", "Two", "Three"].map { NSButton(title: $0, target: counter, action: #selector(ClickCounter.clicked(_:))) }
+        buttons[1].isEnabled = false
+        for button in buttons {
+            window.contentView?.addSubview(button)
+        }
+        let zone = OmniButtonZone(frame: window.contentView?.bounds ?? .zero)
+        zone.buttons = { buttons }
+        window.contentView?.addSubview(zone)
+        var exits: [OmniZoneExit] = []
+        zone.zoneExit = { exits.append($0) }
+
+        zone.zoneEnter()
+        XCTAssertTrue(window.firstResponder === zone)
+        XCTAssertEqual(zone.selectedButton?.title, "One")
+        XCTAssertTrue(zone.zoneHandleKey(right))
+        XCTAssertEqual(zone.selectedButton?.title, "Three", "A disabled button is skipped")
+        XCTAssertTrue(zone.zoneHandleKey(right))
+        XCTAssertEqual(zone.selectedButton?.title, "Three")
+        XCTAssertTrue(zone.zoneHandleKey(returnKey))
+        XCTAssertTrue(zone.zoneHandleKey(keyEvent(49, " ", window: window)))
+        XCTAssertEqual(counter.clicks, ["Three", "Three"])
+        XCTAssertTrue(zone.zoneHandleKey(left))
+        XCTAssertTrue(zone.zoneHandleKey(left))
+        XCTAssertEqual(exits, [.back], "Left at the first button leaves the zone")
+    }
+
+    // MARK: - Focus hold
+
+    func testAZoneKeepsTheKeyboardDuringAHold() {
+        let zone = listZone(rows: [FakeRow()])
+        let other = NSTextView(frame: NSRect(x: 0, y: 0, width: 50, height: 50))
+        window.contentView?.addSubview(other)
+        zone.zoneEnter()
+        OmniFocusHold.during {
+            window.makeFirstResponder(other)
+        }
+        XCTAssertTrue(window.firstResponder === zone)
+        XCTAssertFalse(OmniFocusHold.isHolding)
+        XCTAssertTrue(window.makeFirstResponder(other))
+    }
+}
+
+// The Inbox: its list and its detail are the two zones.
+final class OmniInboxKeyboardTests: XCTestCase {
+    private var requests: [[String: Any]] = []
+    private let controller = OmniInboxWindowController.shared
+
+    override func setUp() {
+        super.setUp()
+        requests = []
+        let notifications: [[String: Any]] = [
+            ["id": "n1", "title": "First", "body": "One", "unread": true, "updated": 1_800_000_600, "run_id": "run-1"],
+            ["id": "n2", "title": "Second", "body": "Two", "unread": false, "updated": 1_800_000_000],
+        ]
+        OmniSchedulerClient.testTransport = { [unowned self] request, completion in
+            self.requests.append(request)
+            let response: [AnyHashable: Any]
+            switch request["op"] as? String {
+            case "notifications":
+                response = ["ok": true, "notifications": notifications, "unread_count": 1]
+            default:
+                response = ["ok": true]
+            }
+            DispatchQueue.main.async {
+                completion(response)
+            }
+        }
+    }
+
+    override func tearDown() {
+        OmniSchedulerClient.testTransport = nil
+        controller.window?.orderOut(nil)
+        super.tearDown()
+    }
+
+    private func wait(_ message: String, until condition: () -> Bool) {
+        let deadline = Date().addingTimeInterval(5)
+        while !condition() && Date() < deadline {
+            RunLoop.main.run(mode: .default, before: Date().addingTimeInterval(0.01))
+        }
+        XCTAssertTrue(condition(), message)
+    }
+
+    private static func find<T: NSView>(_ type: T.Type, in view: NSView) -> T? {
+        if let match = view as? T {
+            return match
+        }
+        for subview in view.subviews {
+            if let match = find(type, in: subview) {
+                return match
+            }
+        }
+        return nil
+    }
+
+    private func key(_ code: UInt16, _ special: Int) -> NSEvent {
+        return arrow(code, special, window: controller.window)
+    }
+
+    func testListToDetailAndBack() throws {
+        let window = try XCTUnwrap(controller.window)
+        let content = try XCTUnwrap(window.contentView)
+        controller.reload()
+        let table = try XCTUnwrap(Self.find(NSTableView.self, in: content))
+        wait("the notifications load") { table.numberOfRows == 2 }
+        window.makeFirstResponder(table)
+        table.keyDown(with: key(125, NSDownArrowFunctionKey))
+        XCTAssertEqual(table.selectedRow, 0, "Down selects a notification")
+
+        table.keyDown(with: key(124, NSRightArrowFunctionKey))
+        let detail = try XCTUnwrap(window.firstResponder as? OmniButtonZone, "Right enters the detail")
+        XCTAssertEqual(detail.selectedButton?.title, "Mark as Read")
+
+        detail.keyDown(with: key(125, NSDownArrowFunctionKey))
+        XCTAssertEqual(table.selectedRow, 1, "Down in the detail goes to the next notification")
+        XCTAssertTrue(window.firstResponder === detail, "and stays in the detail")
+
+        detail.keyDown(with: key(123, NSLeftArrowFunctionKey))
+        XCTAssertTrue(window.firstResponder === table, "Left at the first button returns to the list")
+
+        table.keyDown(with: keyEvent(36, "\r", window: window))
+        XCTAssertTrue(window.firstResponder === detail, "Return enters the detail too")
+        detail.keyDown(with: keyEvent(53, "\u{1b}", window: window))
+        XCTAssertTrue(window.firstResponder === table, "Escape in the detail returns to the list")
+    }
+
+    func testShortcutsUseTheExistingActions() throws {
+        let window = try XCTUnwrap(controller.window)
+        let content = try XCTUnwrap(window.contentView)
+        controller.reload()
+        let table = try XCTUnwrap(Self.find(NSTableView.self, in: content))
+        wait("the notifications load") { table.numberOfRows == 2 }
+        table.selectRowIndexes(IndexSet(integer: 1), byExtendingSelection: false)
+        requests = []
+
+        XCTAssertTrue(window.performKeyEquivalent(with: keyEvent(32, "u", [.command, .shift], window: window)))
+        XCTAssertEqual(requests.last?["op"] as? String, "notification_read")
+        XCTAssertEqual(requests.last?["id"] as? String, "n2", "Shift-Command-U is the Mark as Read/Unread button")
+
+        XCTAssertFalse(window.performKeyEquivalent(with: keyEvent(31, "o", .command, window: window)),
+                       "Without a run there is nothing to resume")
+        XCTAssertTrue(window.performKeyEquivalent(with: keyEvent(51, "\u{7f}", .command, window: window)))
+        XCTAssertEqual(requests.last?["op"] as? String, "notification_delete")
+        XCTAssertEqual(requests.last?["id"] as? String, "n2")
+    }
+}
