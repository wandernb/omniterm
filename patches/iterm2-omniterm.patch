+import AppKit
+import Foundation
+
+// An agent or a run as a page: a header, a native details area, and below it
+// a band of contained height for the terminal. The band is the real tab
+// (the window insets its tab view by the header and details height) when
+// the previewed run is live; otherwise the card covers it with a snapshot.
+// Expanding hides the details so the terminal fills the panel.
+final class OmniCardPane: OmniPane {
+    static let headerHeight: CGFloat = 64
+    static let stripHeight: CGFloat = 34
+    // The share of the panel the header and details take above the band.
+    static let detailsShare: CGFloat = 0.6
+
+    let route: OmniPaneRoute
+    // Set by the sidebar, which owns the tabs.
+    var terminalAvailable = false {
+        didSet {
+            guard terminalAvailable != oldValue else { return }
+            layoutPane()
+        }
+    }
+    // Control-Command-3: the details take the whole panel and the terminal
+    // band, live or snapshot, is put away.
+    private(set) var bandCollapsed = false {
+        didSet {
+            guard bandCollapsed != oldValue else { return }
+            layoutPane()
+        }
+    }
+    // The panel's height, header to bottom, for dragging the band's edge.
+    var panelHeight: CGFloat = 0
+    var expanded = false {
+        didSet {
+            guard expanded != oldValue else { return }
+            header.collapsed = expanded
+            layoutPane()
+        }
+    }
+    // Where the band starts: the window's inset above the tab view.
+    var contentInset: CGFloat = 0 {
+        didSet {
+            guard contentInset != oldValue else { return }
+            layoutPane()
+        }
+    }
+    var toggleExpanded: (() -> Void)?
+    // The run whose terminal the band shows.
+    private(set) var previewRunID: String?
+    private var previewIsChosen = false
+
+    private let header = OmniCardHeader()
+    private let details: NSView
+    private let band = OmniSnapshotBand()
+    private let bandHandle = OmniResizeHandle(vertical: false)
+    private var lastSignature = ""
+    private var agentName: String?
+    private var liveRunIDs: [String] = []
+    private var runs: [OmniRun] = []
+    private var statusMessage = ""
+
+    var coversTerminal: Bool {
+        return !terminalAvailable || bandCollapsed
+    }
+
+    // How tall the details want to be; the window gives them at most
+    // `detailsShare` of the panel and the terminal band the rest.
+    var detailsPreferredHeight: CGFloat {
+        if let agentDetails = details as? OmniAgentDetailsView {
+            return agentDetails.preferredHeight
+        }
+        if let report = details as? OmniRunReportPane {
+            return report.preferredHeight
+        }
+        return 0
+    }
+
+    var headerOnlyHeight: CGFloat {
+        return expanded ? Self.stripHeight : Self.headerHeight
+    }
+
+    // An agent page: its last runs, then the header's buttons, the settings'
+    // buttons and the band's. A run page: the header's and the band's.
+    override var focusZones: [OmniFocusZone] {
+        let agentDetails = details as? OmniAgentDetailsView
+        var zones: [OmniFocusZone] = []
+        if let agentDetails {
+            zones.append(agentDetails.runsZone)
+        }
+        zones.append(header.zone)
+        if let settings = agentDetails?.settingsZone {
+            zones.append(settings)
+        }
+        zones.append(band.zone)
