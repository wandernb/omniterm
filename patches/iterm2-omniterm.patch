+    }
+
+    init(sessionID: String) {
+        self.sessionID = sessionID
+        super.init()
+        headerBar.wantsLayer = true
+        addSubview(chat)
+        addSubview(headerBar)
+        titleField.font = NSFont.systemFont(ofSize: 19, weight: .semibold)
+        titleField.lineBreakMode = .byTruncatingTail
