+    private func showSidebar() {
+        sidebar = OmniSidebarViewController(withoutTerminal: ())
+        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 240, height: 700), styleMask: [.titled, .resizable],
+                          backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+        window.contentView = sidebar.view
+        sidebar.view.frame = window.contentView?.bounds ?? .zero
+        wait("the agents load") { row(titled: "Alpha") != nil }
+    }
+
+    private var outlineView: NSOutlineView {
+        return Self.find(NSOutlineView.self, in: sidebar.view)!
+    }
+
+    private static func find<T: NSView>(_ type: T.Type, in view: NSView, where test: (T) -> Bool = { _ in true }) -> T? {
+        if let match = view as? T, test(match) {
+            return match
+        }
+        for subview in view.subviews {
+            if let match = find(type, in: subview, where: test) {
+                return match
+            }
+        }
+        return nil
+    }
+
+    private func cell(_ row: Int) -> NSTableCellView? {
+        return outlineView.view(atColumn: 0, row: row, makeIfNecessary: true) as? NSTableCellView
+    }
+
+    private func row(titled title: String) -> Int? {
+        return (0..<outlineView.numberOfRows).first { cell($0)?.textField?.stringValue == title }
+    }
+
+    private func editor(_ row: Int) -> NSTextView? {
+        return cell(row)?.textField?.currentEditor() as? NSTextView
+    }
+
+    // Selects the row and sends the outline view's double-click action, as
+    // AppKit does after a second click.
+    private func doubleClick(_ row: Int) {
+        outlineView.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+        guard let action = outlineView.doubleAction else {
+            XCTFail("The outline view has no double-click action")
+            return
+        }
+        NSApp.sendAction(action, to: outlineView.target, from: outlineView)
+    }
