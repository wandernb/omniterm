+
+    // Recording a shortcut and toggling login on the page each send one change.
+    func testShortcutAndLoginRowsSaveTheirChange() throws {
+        let (window, pane) = loadedPane(height: 3000)
+        defer { window.close() }
+        let input = try XCTUnwrap(Self.find(iTermShortcutInputView.self, in: pane))
+        input.shortcut = iTermShortcut(keyCode: 0x60, hasKeyCode: true, modifiers: [.control, .option],
+                                       characters: "", charactersIgnoringModifiers: "")
+        requests = []
+        let event = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: [.control, .option], timestamp: 0,
+                                     windowNumber: window.windowNumber, context: nil, characters: "",
+                                     charactersIgnoringModifiers: "", isARepeat: false, keyCode: 0x60)!
+        pane.shortcutInputView(input, didReceiveKeyPress: event)
+        wait("the shortcut is sent") { self.requests.contains { $0["op"] as? String == "set_settings" } }
+        let shortcut = (requests.last?["settings"] as? [String: Any])?["global_shortcut"] as? [AnyHashable: Any]
+        XCTAssertEqual((shortcut?["keyCode"] as? NSNumber)?.intValue, 0x60)
+
+        let general = try XCTUnwrap(pane.zones.first { $0.title == "General" }?.zone)
+        general.zoneEnter()
+        let down = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: [], timestamp: 0,
+                                    windowNumber: window.windowNumber, context: nil, characters: "",
+                                    charactersIgnoringModifiers: "", isARepeat: false, keyCode: 125)!
+        let enter = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: [], timestamp: 0,
+                                     windowNumber: window.windowNumber, context: nil, characters: "",
+                                     charactersIgnoringModifiers: "", isARepeat: false, keyCode: 36)!
+        general.select("shortcut")
+        _ = general.zoneHandleKey(down)
+        XCTAssertEqual(general.selectedKey, "login")
+        requests = []
+        _ = general.zoneHandleKey(enter)
+        wait("login is sent") { self.requests.contains { $0["op"] as? String == "set_settings" } }
+        XCTAssertEqual((requests.last?["settings"] as? [String: Any])?["launch_at_login"] as? Bool, true)
+    }
+
+    private static func find<T: NSView>(_ type: T.Type, in view: NSView) -> T? {
+        if let match = view as? T { return match }
+        for subview in view.subviews {
+            if let match = find(type, in: subview) { return match }
+        }
+        return nil
+    }
+
+    // Arrows move through a section, Return acts on the row, Tab leaves it.
+    func testKeyboardWalksASectionAndTogglesASetting() throws {
+        let (window, pane) = loadedPane(height: 3000)
+        defer { window.close() }
+        let general = try XCTUnwrap(pane.zones.first { $0.title == "General" }?.zone)
+        var exits: [OmniZoneExit] = []
+        general.zoneExit = { exits.append($0) }
+        general.zoneEnter()
+        XCTAssertEqual(general.selectedKey, "shortcut")
+        func key(_ code: UInt16, _ flags: NSEvent.ModifierFlags = []) -> NSEvent {
+            return NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: flags, timestamp: 0,
+                                    windowNumber: window.windowNumber, context: nil, characters: "",
+                                    charactersIgnoringModifiers: "", isARepeat: false, keyCode: code)!
+        }
+        XCTAssertTrue(general.zoneHandleKey(key(125)))
+        XCTAssertTrue(general.zoneHandleKey(key(125)))
+        XCTAssertEqual(general.selectedKey, "escape")
+        requests = []
+        XCTAssertTrue(general.zoneHandleKey(key(36)))
+        wait("Return saves the switch") { self.requests.contains { $0["op"] as? String == "set_settings" } }
+        let sent = requests.first { $0["op"] as? String == "set_settings" }?["settings"] as? [String: Any]
+        XCTAssertEqual(sent?["double_escape_to_hide"] as? Bool, false)
+        _ = general.zoneHandleKey(key(48))
+        XCTAssertEqual(exits.last, .next, "Tab moves to the next section")
+    }
