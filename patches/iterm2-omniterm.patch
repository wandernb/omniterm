+        return;
+    }
+
+    [OmniDockPresence performExplicitShow:^{
+        for (PseudoTerminal *terminal in self.terminals) {
+            [terminal omniRestoreWindowFrameOnScreen:nil centered:NO];
+            [terminal.window makeKeyAndOrderFront:nil];
