+// MARK: - Inbox
+
+// The Inbox in the main window: the same view controller as the Inbox
+// window, its list and detail as the page's zones.
+final class OmniInboxPane: OmniPane {
+    let inbox = OmniInboxViewController()
+
+    override var contentViews: [NSView] {
+        return [inbox.view]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return inbox.focusZones
+    }
+
+    override init() {
+        super.init()
+        addSubview(inbox.view)
+        showContent()
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        inbox.view.frame = bounds
+    }
+
+    // What the list shows last loaded: unread and attention counts and the
+    // newest notification. The periodic refresh reloads the list only when
+    // this changes; a change made through the scheduler reloads it anyway.
+    private var loadedSignature: String?
+
+    override func reload() {
+        OmniSchedulerClient.request(["op": "notifications", "limit": 1]) { [weak self] response in
+            guard let self else { return }
+            let signature = Self.inboxSignature(response)
+            guard signature != self.loadedSignature else { return }
+            self.loadedSignature = signature
+            self.inbox.reload()
+        }
+    }
+
+    static func inboxSignature(_ response: [AnyHashable: Any]) -> String {
+        guard isOK(response) else { return "unavailable" }
+        let newest = (response["notifications"] as? [[AnyHashable: Any]])?.first
+        return [response["unread_count"], response["attention_count"], newest?["id"], newest?["updated"]]
+            .map { $0.map { "\($0)" } ?? "-" }
+            .joined(separator: "|")
+    }
+
+    override func handlePaneShortcut(_ event: NSEvent) -> Bool {
+        return inbox.handleShortcut(event)
+    }
+}
