+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func tile() {
+        super.tile()
+        relayout()
+    }
+
+    func relayout() {
+        column.layoutColumn(width: contentSize.width)
+    }
+
+    // Rebuilding the column must not jump back to the top.
+    func rebuildKeepingScroll(_ body: () -> Void) {
+        let origin = contentView.bounds.origin
+        body()
+        relayout()
+        contentView.scroll(to: origin)
+        reflectScrolledClipView(contentView)
+    }
+}
