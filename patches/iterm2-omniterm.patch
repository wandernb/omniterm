+    // MARK: - List column
+
+    func shownListWidth(contentWidth: CGFloat) -> CGFloat {
+        let wanted = OmniPanelLayout.clampedMemoryListWidth(listWidth ?? Self.defaultListWidth)
+        return max(OmniPanelLayout.memoryListWidthRange.lowerBound, min(wanted, contentWidth * 0.6)).rounded()
+    }
+
+    private func dragList(to point: NSPoint, ended: Bool) {
+        let width = OmniPanelLayout.clampedMemoryListWidth(root.convert(point, from: nil).x)
+        listWidth = width
+        if ended {
+            saveListWidth?(width)
+        }
+    }
