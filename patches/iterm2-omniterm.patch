+// MARK: - Dashboard (the `.overview` route)
+
+final class OmniOverviewPane: OmniPane {
+    private let scroll = OmniColumnScrollView()
+    private var lastSignature = ""
+    // Return opens the agent or the run.
+    let upcomingZone = OmniListZone()
+    let latestZone = OmniListZone()
+    // Return opens the project or the session.
+    let projectsZone = OmniListZone()
+    let sessionsZone = OmniListZone()
+    private lazy var upcomingColumn = makeListColumn(upcomingZone)
+    private lazy var latestColumn = makeListColumn(latestZone)
+    private lazy var projectsColumn = makeListColumn(projectsZone)
+    private lazy var sessionsColumn = makeListColumn(sessionsZone)
+    private var buttonsZone: OmniButtonZone?
+    private var projectLayout = OmniProjectLayout()
+
+    override var contentViews: [NSView] {
+        return [scroll]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return [projectsZone, sessionsZone, upcomingZone, latestZone] + (buttonsZone.map { [$0] } ?? [])
+    }
+
+    override init() {
+        super.init()
+        addSubview(scroll)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        scroll.frame = bounds
+    }
+
+    override func reload() {
+        var agentsResponse: [AnyHashable: Any]?
+        var runsResponse: [AnyHashable: Any]?
+        var inboxResponse: [AnyHashable: Any]?
+        var sessionsResponse: [AnyHashable: Any]?
+        var settingsResponse: [AnyHashable: Any]?
+        let finish = { [weak self] in
+            guard let self, let agentsResponse, let runsResponse, let inboxResponse, let sessionsResponse,
+                  let settingsResponse else { return }
+            // The person's names, icons and colours for projects.
+            self.projectLayout = OmniProjectLayout((settingsResponse["settings"] as? [String: Any])?["projects"])
+            self.render(agents: agentsResponse, runs: runsResponse, inbox: inboxResponse,
+                        sessions: sessionsResponse["sessions"] as? [[AnyHashable: Any]] ?? [])
+        }
+        OmniSchedulerClient.request(["op": "get_settings"]) { response in
+            settingsResponse = response
+            finish()
+        }
+        // Recent sessions, and through them the recently active projects.
+        OmniSchedulerClient.request(["op": "list_sessions", "order": "recent", "limit": 40]) { response in
+            sessionsResponse = response
+            finish()
+        }
+        OmniSchedulerClient.request(["op": "list_agents"]) { response in
+            agentsResponse = response
+            finish()
+        }
+        OmniSchedulerClient.request(["op": "list_runs", "limit": 50, "include_live": true, "foreground": true, "loop_turns": 2]) { response in
+            runsResponse = response
+            finish()
+        }
+        OmniSchedulerClient.request(["op": "notifications", "limit": 1]) { response in
+            inboxResponse = response
+            finish()
+        }
+    }
+
+    private func render(agents agentsResponse: [AnyHashable: Any], runs runsResponse: [AnyHashable: Any],
+                        inbox inboxResponse: [AnyHashable: Any], sessions: [[AnyHashable: Any]]) {
+        guard Self.isOK(agentsResponse), Self.isOK(runsResponse) else {
+            lastSignature = ""
+            showMessage(Self.unreachableMessage(Self.isOK(agentsResponse) ? runsResponse : agentsResponse))
+            return
+        }
+        let agentRows = agentsResponse["agents"] as? [[AnyHashable: Any]] ?? []
+        let runRows = runsResponse["runs"] as? [[AnyHashable: Any]] ?? []
+        let unread = (inboxResponse["unread_count"] as? NSNumber)?.intValue ?? 0
+        // Relative times move, so the minute is part of what is shown.
+        let minute = Int(Date().timeIntervalSince1970 / 60)
+        let sessionKeys = sessions.map { "\($0["session_id"] ?? "")|\($0["updated"] ?? "")|\($0["title"] ?? "")" }
+        let signature = Self.signature(agentRows, runRows, unread, minute, sessionKeys, projectLayout.dictionary)
+        guard signature != lastSignature else { return }
+        lastSignature = signature
+
+        let agents = agentRows.compactMap(OmniAgent.init)
+        // Background housekeeping (memory consolidation) has its own page.
+        let background = Set(agents.filter(\.isBackground).map(\.name))
+        let runs = runRows.compactMap(OmniRun.init).filter { !background.contains($0.agent) }
+        guard !agents.isEmpty || !runs.isEmpty || !sessions.isEmpty else {
+            showMessage("No agents yet.\n\nCreate one with “omni agent add <workspace>” in a terminal, or ask Claude or Codex to schedule one through OmniTerm’s MCP tools.")
+            return
+        }
+
+        preservingZoneFocus {
+            rebuild(agents: agents, runs: runs, unread: unread, sessions: sessions)
+        }
+    }
+
+    // The projects of the newest sessions, newest first, each once.
+    static func recentProjects(_ sessions: [[AnyHashable: Any]]) -> [(root: String, name: String, updated: Double?)] {
+        var seen = Set<String>()
+        var result: [(root: String, name: String, updated: Double?)] = []
+        for session in sessions {
+            guard let project = session["project"] as? [String: Any],
+                  let root = project["root"] as? String ?? project["id"] as? String,
+                  seen.insert(root).inserted else { continue }
+            let name = project["name"] as? String ?? (root as NSString).lastPathComponent
+            result.append((root: root, name: name, updated: (session["updated"] as? NSNumber)?.doubleValue))
+        }
+        return result
+    }
+
+    private func addRecentProjectsAndSessions(_ sessions: [[AnyHashable: Any]], to column: OmniColumnView) {
+        projectsColumn.removeAll()
+        sessionsColumn.removeAll()
+        column.addSection("Recent projects")
+        let projects = Self.recentProjects(sessions).prefix(5)
+        if projects.isEmpty {
+            column.addText(OmniPaneText.label("No recent project activity.", color: OmniTheme.secondaryText))
+        }
+        var projectItems: [(key: String, view: OmniZoneItem)] = []
+        for project in projects {
+            let look = projectLayout.appearance(project.root)
+            let row = OmniFolderEntryRow(icon: look.icon ?? .symbol(SFSymbol.shippingbox.rawValue),
+                                         iconColor: OmniAgentColor.color(look.color),
+                                         title: projectLayout.name(project.root) ?? project.name,
+                                         detail: OmniProjectsModel.abbreviated(project.root),
+                                         badge: OmniSessionText.age(project.updated), status: nil) { [weak self] in
+                self?.actions?.paneOpen(.project(project.root))
+            }
+            projectItems.append((project.root, row))
+            row.contextMenu = { [weak self] in OmniContextMenus.project(project.root, actions: self?.actions) }
+            projectsColumn.add(row, spacing: 2) { _ in OmniFolderEntryRow.height }
+        }
+        projectsZone.setItems(projectItems)
+        if !projects.isEmpty {
+            addList(projectsColumn, to: column)
+        }
+
+        column.addSection("Recent sessions")
+        if sessions.isEmpty {
+            column.addText(OmniPaneText.label("No sessions yet.", color: OmniTheme.secondaryText))
+        }
+        var sessionItems: [(key: String, view: OmniZoneItem)] = []
+        for session in sessions.prefix(6) {
+            guard let sessionID = session["session_id"] as? String else { continue }
+            let live = OmniSessionText.isLive(session)
+            let row = OmniFolderEntryRow(icon: .symbol(OmniSessionText.providerSymbol(session["provider"] as? String)),
+                                         iconColor: live ? OmniTheme.running : nil,
+                                         title: OmniSessionText.title(session["title"] as? String),
+                                         detail: OmniSessionText.detail(session),
+                                         badge: OmniSessionText.age((session["updated"] as? NSNumber)?.doubleValue),
+                                         status: live ? OmniTheme.running : nil) { [weak self] in
+                self?.actions?.paneOpen(.session(sessionID))
+            }
+            sessionItems.append((sessionID, row))
+            row.contextMenu = { [weak self] in OmniContextMenus.session(session, actions: self?.actions, window: self?.window) }
+            sessionsColumn.add(row, spacing: 2) { _ in OmniFolderEntryRow.height }
+        }
+        sessionsZone.setItems(sessionItems)
+        if !sessionItems.isEmpty {
+            addList(sessionsColumn, to: column)
+        }
+    }
+
+    private func rebuild(agents: [OmniAgent], runs: [OmniRun], unread: Int, sessions: [[AnyHashable: Any]]) {
+        let column = scroll.column
+        let origin = scroll.contentView.bounds.origin
+        column.removeAll()
+        upcomingColumn.removeAll()
+        latestColumn.removeAll()
+        column.addText(Self.title("Dashboard"), spacing: 14)
+        let active = runs.filter(\.isLive).count
+        let shown = agents.filter { !$0.isBackground }.count
+        let stats = OmniStatsView([("\(shown)", shown == 1 ? "agent" : "agents"),
+                                   ("\(active)", active == 1 ? "active run" : "active runs"),
+                                   ("\(unread)", "unread in Inbox")])
+        column.add(stats, spacing: 8) { _ in 56 }
+        let inboxButton = OmniPaneText.button("Open Inbox", target: self, action: #selector(openInbox(_:)))
+        let projectsButton = OmniPaneText.button("All Projects", target: self, action: #selector(openProjects(_:)))
+        let buttons = OmniButtonRow([inboxButton, projectsButton])
+        buttonsZone = buttons.zone
+        column.add(buttons, spacing: 8) { _ in 30 }
+
+        addRecentProjectsAndSessions(sessions, to: column)
+
+        column.addSection("Next scheduled runs")
+        let upcoming = agents.filter { $0.enabled && $0.nextRun != nil && !$0.isBackground }
+            .sorted { ($0.nextRun ?? .distantFuture) < ($1.nextRun ?? .distantFuture) }
+            .prefix(6)
+        if upcoming.isEmpty {
+            column.addText(OmniPaneText.label("Nothing is scheduled.", color: OmniTheme.secondaryText))
+        }
+        var upcomingItems: [(key: String, view: OmniZoneItem)] = []
+        for agent in upcoming {
+            let next = agent.nextRun.map { OmniFormat.relative(max($0, Date())) } ?? ""
+            let row = OmniRunRowView(title: agent.name,
+                                     detail: "\(agent.providerName) · \(agent.schedule)",
+                                     badge: next,
+                                     color: OmniTheme.secondaryText) { [weak self] in
+                self?.actions?.paneOpen(.agent(agent.name))
+            }
+            upcomingItems.append((agent.name, row))
+            row.contextMenu = { [weak self] in
+                OmniContextMenus.agent(agent.name, enabled: agent.enabled, actions: self?.actions, window: self?.window) { self?.reload() }
+            }
+            upcomingColumn.add(row, spacing: 2) { _ in OmniRunRowView.height }
+        }
+        upcomingZone.setItems(upcomingItems)
+        if !upcoming.isEmpty {
+            addList(upcomingColumn, to: column)
+        }
+
+        column.addSection("Latest runs")
+        if runs.isEmpty {
+            column.addText(OmniPaneText.label("No runs yet.", color: OmniTheme.secondaryText))
+        }
+        var latestItems: [(key: String, view: OmniZoneItem)] = []
+        for run in runs.prefix(12) {
+            let row = OmniRunRowView.forRun(run, showAgent: true) { [weak self] in
+                self?.actions?.paneOpen(.run(run.id))
+            }
+            latestItems.append((run.id, row))
+            row.contextMenu = { [weak self] in
+                OmniContextMenus.run(run.id, agent: run.agent, live: run.isLive, actions: self?.actions, window: self?.window) { self?.reload() }
+            }
+            latestColumn.add(row, spacing: 2) { _ in OmniRunRowView.height }
+        }
+        latestZone.setItems(latestItems)
+        if !runs.isEmpty {
+            addList(latestColumn, to: column)
+        }
+
+        column.addSection("Keyboard")
+        column.addText(Self.facts(OmniSidebarShortcuts.list.map { ($0.keys, $0.action) }))
+        showContent()
+        scroll.relayout()
+        scroll.contentView.scroll(to: origin)
+        scroll.reflectScrolledClipView(scroll.contentView)
+    }
+
+    // The sidebar's Inbox page; the menu bar, banners and the widget still
+    // open the Inbox window.
+    @objc private func openInbox(_ sender: Any?) {
+        actions?.paneOpen(.inbox)
+    }
+
+    @objc private func openProjects(_ sender: Any?) {
+        actions?.paneOpen(.projects)
+    }
+}
