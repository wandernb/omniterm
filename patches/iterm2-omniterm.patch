+// Pinned: the window keeps its frame and its Space. It was put away by
+// hiding the app, not ordered out, so it is still on the Space it was pinned
+// on; activating it there switches to that Space and brings it in front.
+- (void)openPinnedOmniTermWindow:(PseudoTerminal *)terminal {
+    NSWindow *window = terminal.window;
+    // Shown on another Space, ordering it front would bring it here; put it
+    // away first so it comes back on its own Space.
+    if (window.isVisible && !window.isOnActiveSpace) {
+        [window orderOut:nil];
+    }
+    [terminal omniRestoreWindowFrameOnScreen:nil centered:NO];
+    NSWindowCollectionBehavior behavior = window.collectionBehavior;
+    behavior &= ~(NSWindowCollectionBehaviorCanJoinAllSpaces | NSWindowCollectionBehaviorMoveToActiveSpace);
+    window.collectionBehavior = behavior;
+    [terminal omniMoveWindowToPinnedSpace];
