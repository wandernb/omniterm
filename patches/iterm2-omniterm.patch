+        return @{ @"ok": @(ok) };
+    }
+    if ([operation isEqualToString:@"rename_agent"]) {
+        return [self renameAgent:request[@"name"] to:request[@"new_name"]];
+    }
+    if ([operation isEqualToString:@"set_agent_appearance"]) {
+        return [self setAppearance:request forAgent:request[@"name"]];
+    }
+    if ([operation isEqualToString:@"rename_group"]) {
+        return [self renameGroup:request[@"from"] to:request[@"to"]];
+    }
+    if ([operation isEqualToString:@"set_sidebar_order"]) {
