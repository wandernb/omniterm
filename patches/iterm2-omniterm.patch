+    }
+
+    init(route: OmniPaneRoute) {
+        self.route = route
+        switch route {
+        case .agent(let name):
+            agentName = name
+            details = OmniAgentDetailsView(agentName: name)
+        case .run(let id):
+            previewRunID = id
+            details = OmniRunReportPane(runID: id, compact: true)
+        case .overview, .group, .inbox, .memory, .settings, .unblocker, .projects, .project, .session, .search:
+            details = NSView()
+        }
+        super.init()
+        messageLabel.isHidden = true
+        header.toggle.target = self
+        header.toggle.action = #selector(toggleExpanded(_:))
+        addSubview(details)
+        addSubview(band)
+        addSubview(header)
+        addSubview(bandHandle)
+        bandHandle.dragged = { [weak self] point, finished in self?.dragBandEdge(to: point, finished: finished) }
+        header.configurePanelToggles(showsRuns: agentName != nil && previewRunID == nil, target: self,
+                                     action: #selector(togglePanel(_:)))
+        if let agentDetails = details as? OmniAgentDetailsView {
+            agentDetails.didSelectRun = { [weak self] run in self?.preview(run, chosen: true) }
+            agentDetails.didChangeAgent = { [weak self] in self?.reload() }
+            agentDetails.contentHeightDidChange = { [weak self] in self?.actions?.paneLayoutDidChange() }
+        }
+        (details as? OmniRunReportPane)?.contentHeightDidChange = { [weak self] in
+            self?.actions?.paneLayoutDidChange()
+        }
+        header.configure(badge: "Loading", color: OmniTheme.tertiaryText, title: agentName ?? "Run", meta: "Loading…",
+                         buttons: [])
+        band.configure(title: "Loading…", detail: "", buttons: [])
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func showMessage(_ message: String) {
+        // The header carries loading and error states.
+    }
+
+    override func layoutPane() {
+        OmniPointer.install(in: self)
+        let width = bounds.width
+        let headerHeight = headerOnlyHeight
+        header.frame = NSRect(x: 0, y: 0, width: width, height: headerHeight)
+        details.isHidden = expanded
+        let bandShown = !expanded && !bandCollapsed
+        // Collapsed, the details reach the bottom of the panel.
+        let bandTop = bandCollapsed && !expanded ? bounds.height : max(headerHeight, contentInset)
+        details.frame = NSRect(x: 0, y: headerHeight, width: width, height: max(0, bandTop - headerHeight))
+        band.isHidden = terminalAvailable || bandCollapsed
+        band.frame = NSRect(x: 0, y: bandTop, width: width, height: max(0, bounds.height - bandTop))
+        bandHandle.isHidden = !bandShown
+        bandHandle.frame = NSRect(x: 0, y: bandTop - 3, width: width, height: 6)
+    }
+
+    override func applyPanelLayout(_ layout: OmniPanelLayout) {
+        (details as? OmniPane)?.layoutStore = layoutStore
+        (details as? OmniAgentDetailsView)?.layoutStore = layoutStore
+        (details as? OmniPane)?.applyPanelLayout(layout)
+        (details as? OmniAgentDetailsView)?.applyPanelLayout(layout)
+        bandCollapsed = layout.bandCollapsed
+        header.updatePanelToggles(layout)
+    }
+
+    // Whether a diff is on screen in this page.
+    var showsDiff: Bool {
+        return (details as? OmniRunReportPane)?.showsDiff ?? (details as? OmniAgentDetailsView)?.showsDiff ?? false
+    }
+
+    // Dragging the line between the details and the band: the details' share
+    // of the panel, saved when the drag ends.
+    private func dragBandEdge(to point: NSPoint, finished: Bool) {
+        guard panelHeight > 0, let layoutStore else { return }
+        let y = convert(point, from: nil).y
+        let share = OmniPanelLayout.clampedDetailsShare(y / panelHeight)
+        layoutStore.update(saving: finished) { $0.detailsShare = share }
+        actions?.paneLayoutDidChange()
+    }
+
+    @objc private func togglePanel(_ sender: NSButton) {
+        guard let panel = OmniCardHeader.panel(of: sender) else { return }
+        actions?.paneTogglePanel(panel)
+    }
+
+    // MARK: - Data
+
+    override func reload() {
+        (details as? OmniPane)?.actions = actions
+        (details as? OmniAgentDetailsView)?.actions = actions
+        (details as? OmniPane)?.reload()
+        (details as? OmniAgentDetailsView)?.reload()
+        switch route {
+        case .agent(let name):
+            var agentResponse: [AnyHashable: Any]?
+            var runsResponse: [AnyHashable: Any]?
+            let finish = { [weak self] in
+                guard let self, let agentResponse, let runsResponse else { return }
+                self.renderAgent(agentResponse, runs: runsResponse)
+            }
+            OmniSchedulerClient.request(["op": "show_agent", "name": name]) { response in
+                agentResponse = response
+                finish()
+            }
+            OmniSchedulerClient.request(["op": "list_runs", "agent": name, "limit": 10, "include_live": true]) { response in
+                runsResponse = response
+                finish()
+            }
+        case .run(let id):
+            OmniSchedulerClient.request(["op": "get_run", "id": id]) { [weak self] response in
+                self?.renderRun(response)
+            }
+        case .overview, .group, .inbox, .memory, .settings, .unblocker, .projects, .project, .session, .search:
+            break
+        }
+    }
+
+    private func renderFailure(_ response: [AnyHashable: Any], title: String, missing: String) {
+        lastSignature = ""
+        let notFound = response["code"] as? String == "run_not_found" || response["error"] as? String == "Agent not found"
+        header.configure(badge: "Unavailable", color: OmniTheme.tertiaryText, title: title,
+                         meta: notFound ? missing : Self.unreachableMessage(response).replacingOccurrences(of: "\n", with: " "),
+                         buttons: [])
+        band.configure(title: notFound ? missing : "The OmniTerm scheduler is unavailable.", detail: "", buttons: [])
+    }
+
+    private func renderAgent(_ agentResponse: [AnyHashable: Any], runs runsResponse: [AnyHashable: Any]) {
+        guard Self.isOK(agentResponse), let row = agentResponse["agent"] as? [AnyHashable: Any],
+              let agent = OmniAgent(row) else {
+            renderFailure(agentResponse, title: agentName ?? "Agent", missing: "This agent no longer exists.")
+            return
+        }
+        let runRows = Self.isOK(runsResponse) ? runsResponse["runs"] as? [[AnyHashable: Any]] ?? [] : []
+        runs = runRows.compactMap(OmniRun.init)
+        liveRunIDs = runs.filter(\.isLive).map(\.id)
+        (details as? OmniAgentDetailsView)?.show(agent: row, runs: runs, selected: previewRunID)
+        // Until a run is picked, the band follows the live run, else the latest.
+        if !previewIsChosen || !runs.contains(where: { $0.id == previewRunID }) {
+            previewIsChosen = false
+            let preferred = runs.first(where: \.isLive) ?? runs.first
+            if preferred?.id != previewRunID {
+                previewRunID = preferred?.id
+                (details as? OmniAgentDetailsView)?.show(agent: row, runs: runs, selected: previewRunID)
+                actions?.paneLayoutDidChange()
+            }
+        }
+        let signature = Self.signature(row, runRows, statusMessage, previewRunID ?? "")
+        guard signature != lastSignature else { return }
+        lastSignature = signature
+
+        var meta = [agent.providerName, agent.schedule]
+        if agent.enabled, let next = agent.nextRun {
+            meta.append("next \(OmniFormat.relative(max(next, Date())))")
+        }
+        if let workspace = agent.workspace {
+            meta.append(OmniFormat.path(workspace))
+        }
+        let live = !liveRunIDs.isEmpty
+        // A live run whose agent finished its turn is waiting, not running.
+        let working = runs.contains(where: \.isWorking)
+        let badge = working ? "Running" : live ? "Idle" : (agent.enabled ? "Scheduled" : "Paused")
+        let color: NSColor = working ? OmniTheme.running : live ? OmniTheme.waiting : OmniTheme.secondaryText
+
+        let enabled = NSButton(checkboxWithTitle: "On schedule", target: self, action: #selector(toggleEnabled(_:)))
+        enabled.state = agent.enabled ? .on : .off
+        var buttons: [NSButton] = [OmniPaneText.button("Run Now", target: self, action: #selector(runNow(_:)))]
+        if live {
+            buttons.append(OmniPaneText.button(liveRunIDs.count > 1 ? "Stop \(liveRunIDs.count) Runs" : "Stop",
+                                               target: self, action: #selector(stop(_:))))
+        } else if resumableRun != nil {
+            buttons.append(OmniPaneText.button("Resume", target: self, action: #selector(resume(_:))))
+        }
+        buttons.append(enabled)
+        header.configure(badge: badge, color: color, title: agent.name, meta: meta.joined(separator: " · "),
+                         buttons: buttons)
+        header.status.stringValue = statusMessage
+        configureBand()
+    }
+
+    private func renderRun(_ response: [AnyHashable: Any]) {
+        guard Self.isOK(response), let row = response["run"] as? [AnyHashable: Any], let run = OmniRun(row) else {
+            renderFailure(response, title: "Run", missing: "This run is no longer in the history.")
+            return
+        }
+        runs = [run]
+        let signature = Self.signature(row, statusMessage)
+        guard signature != lastSignature else { return }
+        lastSignature = signature
+        agentName = run.agent
+        liveRunIDs = run.isLive ? [run.id] : []
+
+        var meta = ["Started \(OmniFormat.date(run.started))"]
+        if let finished = run.finished {
+            meta.append("took \(OmniFormat.duration(from: run.started, to: finished))")
+        } else if run.isLive {
+            meta.append("running for \(OmniFormat.duration(from: run.started, to: Date()))")
+        }
+        if let workspace = run.workspace {
+            meta.append(OmniFormat.path(workspace))
+        }
+        if let branch = run.branch {
+            meta.append(branch)
+        }
+        var buttons: [NSButton] = []
+        if run.isLive {
+            buttons.append(OmniPaneText.button("Stop", target: self, action: #selector(stop(_:))))
+        } else if run.canResume {
+            buttons.append(OmniPaneText.button("Resume", target: self, action: #selector(resume(_:))))
+        }
+        buttons.append(OmniPaneText.button("Agent", target: self, action: #selector(showAgent(_:))))
+        header.configure(badge: run.outcomeName, color: run.outcomeColor, title: run.agent,
+                         meta: meta.joined(separator: " · "), buttons: buttons)
+        header.status.stringValue = statusMessage
+        configureBand()
+    }
+
+    // The run the band previews, when it is not live.
+    private var previewRun: OmniRun? {
+        return runs.first { $0.id == previewRunID }
+    }
+
+    private var resumableRun: OmniRun? {
+        if let previewRun, !previewRun.isLive, previewRun.canResume {
+            return previewRun
+        }
+        return runs.first { !$0.isLive && $0.canResume }
+    }
+
+    private func configureBand() {
+        var buttons: [NSButton] = []
+        if resumableRun != nil {
+            let resume = OmniPaneText.button("Resume Session", target: self, action: #selector(resume(_:)))
+            resume.bezelColor = .controlAccentColor
+            buttons.append(resume)
+        }
+        if case .agent = route {
+            buttons.append(OmniPaneText.button("Run Now", target: self, action: #selector(runNow(_:))))
+        }
+        let title: String
+        let detail: String
+        if let run = previewRun {
+            title = run.isLive ? "This run’s terminal is not open." : "No terminal snapshot for this run"
+            detail = "Runs record their last screen when the agent finishes a turn; runs from before that have none." +
+                (resumableRun != nil ? " Resume the session to continue it here." : "")
+        } else {
+            title = "No runs yet"
+            detail = "Start a run to see its terminal here."
+        }
+        band.configure(title: title, detail: detail, buttons: buttons)
+        let ended = previewRun?.isLive == false ? previewRun : nil
+        band.load(runID: ended?.id, stamp: ended?.outputStamp ?? "",
+                  caption: previewRun.map { "Last screen of the run from \(OmniFormat.date($0.started))" } ?? "")
+    }
+
+    private func preview(_ run: OmniRun, chosen: Bool) {
+        previewIsChosen = chosen
+        guard run.id != previewRunID else { return }
+        previewRunID = run.id
+        lastSignature = ""
+        configureBand()
+        actions?.paneLayoutDidChange()
+    }
+
+    private func setStatus(_ message: String) {
+        statusMessage = message
+        header.status.stringValue = message
+    }
+
+    // MARK: - Actions
+
+    @objc private func toggleExpanded(_ sender: Any?) {
+        toggleExpanded?()
+    }
+
+    @objc private func toggleEnabled(_ sender: NSButton) {
+        guard let agentName else { return }
+        let enabled = sender.state == .on
+        OmniSchedulerClient.request(["op": "set_enabled", "name": agentName, "enabled": enabled]) { [weak self] response in
+            guard let self else { return }
+            self.setStatus(Self.isOK(response) ? "" : (response["error"] as? String ?? "The schedule could not be changed."))
+            self.lastSignature = ""
+            self.reload()
+        }
+    }
+
+    @objc private func runNow(_ sender: Any?) {
+        guard let agentName else { return }
+        setStatus("Starting…")
+        OmniSchedulerClient.request(["op": "run_agent", "name": agentName]) { [weak self] response in
+            guard let self else { return }
+            guard Self.isOK(response), let runID = response["run_id"] as? String else {
+                self.setStatus(response["error"] as? String ?? "The agent could not be started.")
+                return
+            }
+            self.setStatus("")
+            self.openTerminalOfNewRun(runID)
+        }
+    }
+
+    @objc private func resume(_ sender: Any?) {
+        guard let run = resumableRun else { return }
+        setStatus("Resuming…")
+        OmniSchedulerClient.request(["op": "resume_run", "run_id": run.id]) { [weak self] response in
+            guard let self else { return }
+            guard Self.isOK(response), let runID = response["run_id"] as? String else {
+                self.setStatus(response["error"] as? String ?? "The session could not be resumed.")
+                return
+            }
+            self.setStatus("")
+            self.openTerminalOfNewRun(runID)
+        }
+    }
+
+    // The new run's terminal fills the band, under this agent's page, or
+    // under a page for the new run.
+    private func openTerminalOfNewRun(_ runID: String) {
+        let next: OmniPaneRoute
+        if case .agent = route {
+            next = route
+            previewRunID = runID
+            previewIsChosen = true
+        } else {
+            next = .run(runID)
+        }
+        actions?.paneExpectTab(forRun: runID, showing: next, from: route)
+    }
+
+    @objc private func stop(_ sender: Any?) {
+        setStatus("Stopping…")
+        for runID in liveRunIDs {
+            OmniSchedulerClient.request(["op": "stop_run", "run_id": runID]) { [weak self] response in
+                guard let self, !Self.isOK(response) else { return }
+                self.setStatus("The run had already ended.")
+            }
+        }
+    }
+
+    @objc private func showAgent(_ sender: Any?) {
+        guard let agentName else { return }
+        actions?.paneOpen(.agent(agentName))
+    }
+}
+
+// The agent page's details: the last runs and the settings on the left, the
+// selected run's report (summary, commits, files, diff) on the right. The
+// settings are read here and edited in a sheet.
+final class OmniAgentDetailsView: NSView, NSSplitViewDelegate {
+    weak var actions: OmniPaneActions?
+    weak var layoutStore: OmniPanelLayoutStore?
+    var didSelectRun: ((OmniRun) -> Void)?
+    var didChangeAgent: (() -> Void)?
+    var contentHeightDidChange: (() -> Void)?
+
+    private let agentName: String
+    private let split = NSSplitView()
+    private let left = OmniColumnScrollView()
+    private let runsColumn = OmniColumnView()
+    private let settingsColumn = OmniColumnView()
+    private var report: OmniRunReportPane?
+    private let reportPlaceholder = NSTextField(labelWithString: "Select a run")
+    private let right = OmniResizingView()
+    private var runsSignature = ""
+    private var settingsSignature = ""
+    // Set while the divider is placed in code, so only a drag is saved.
+    private var placingDivider = false
+    private var runsCollapsed = false
+    private var storedRunsWidth: CGFloat?
+    private var runsByID: [String: OmniRun] = [:]
+    // Up and Down choose the run the report and the band show; Return opens it.
+    let runsZone = OmniListZone()
+    private(set) var settingsZone: OmniButtonZone?
+    // The startup and system prompts that are not empty, in that order.
+    private(set) var promptViews: [OmniMarkdownView] = []
+
+    // The run whose report shows.
+    var selectedRunID: String? {
+        return runsZone.selectedKey
+    }
+
+    override var isFlipped: Bool { true }
+
+    init(agentName: String) {
+        self.agentName = agentName
+        super.init(frame: NSRect(x: 0, y: 0, width: 700, height: 400))
+        split.isVertical = true
+        split.dividerStyle = .thin
+        split.delegate = self
+        addSubview(split)
+        NotificationCenter.default.addObserver(self, selector: #selector(splitDidResize(_:)),
+                                               name: NSSplitView.didResizeSubviewsNotification, object: split)
+        split.addArrangedSubview(left)
+        split.addArrangedSubview(right)
+        reportPlaceholder.textColor = OmniTheme.tertiaryText
+        reportPlaceholder.alignment = .center
+        right.addSubview(reportPlaceholder)
+        right.didResize = { [weak self] size in self?.layoutRight(size) }
+        left.column.inset = 20
+        runsZone.selectionDidChange = { [weak self] runID in self?.choose(runID) }
+        runsZone.activateItem = { [weak self] runID in self?.actions?.paneOpen(.run(runID)) }
+        runsColumn.overlay = runsZone
+        buildColumn()
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    deinit {
+        NotificationCenter.default.removeObserver(self)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        placingDivider = true
+        split.frame = bounds
+        placingDivider = false
+        arrangeColumns()
+    }
+
+    // Whether the report sits under the runs rather than beside them.
+    var isStacked: Bool {
+        return !split.isVertical
+    }
+
+    var runsFrame: NSRect? {
+        return left.isHidden ? nil : left.frame
+    }
+
+    var reportFrame: NSRect {
+        return right.frame
+    }
+
+    var showsDiff: Bool {
+        return report?.showsDiff ?? false
+    }
+
+    func applyPanelLayout(_ layout: OmniPanelLayout) {
+        report?.layoutStore = layoutStore
+        report?.applyPanelLayout(layout)
+        guard layout.runsCollapsed != runsCollapsed || layout.runsWidth != storedRunsWidth else { return }
+        runsCollapsed = layout.runsCollapsed
+        storedRunsWidth = layout.runsWidth
+        arrangeColumns()
+        contentHeightDidChange?()
+    }
+
+    // Side by side with both minimum widths, or stacked when the panel is
+    // too narrow for both; the runs column can be put away.
+    private func arrangeColumns() {
+        guard bounds.width > 0 else { return }
+        let stacked = OmniAgentPageGeometry.stacks(width: bounds.width)
+        placingDivider = true
+        defer { placingDivider = false }
+        if split.isVertical == stacked {
+            split.isVertical = !stacked
+        }
+        left.isHidden = runsCollapsed
+        split.adjustSubviews()
+        guard !runsCollapsed else { return }
+        let divider = split.dividerThickness
+        if stacked {
+            let wanted = left.column.frame.height
+            split.setPosition(OmniAgentPageGeometry.stackedRunsHeight(wanted: wanted, total: bounds.height, divider: divider),
+                              ofDividerAt: 0)
+        } else {
+            split.setPosition(OmniAgentPageGeometry.runsWidth(stored: storedRunsWidth, total: bounds.width, divider: divider),
+                              ofDividerAt: 0)
+        }
+    }
+
+    // A dragged divider is the person's runs width.
+    @objc private func splitDidResize(_ notification: Notification) {
+        guard !placingDivider, split.isVertical, !left.isHidden,
+              notification.userInfo?["NSSplitViewDividerIndex"] != nil,
+              NSApp.currentEvent?.type == .leftMouseDragged else { return }
+        let width = left.frame.width.rounded()
+        storedRunsWidth = width
+        layoutStore?.update(saving: false) { $0.runsWidth = width }
+        layoutStore?.saveSoon()
+    }
+
+    private func layoutRight(_ size: NSSize) {
+        report?.frame = NSRect(origin: .zero, size: size)
+        reportPlaceholder.frame = NSRect(x: 0, y: size.height / 2 - 10, width: size.width, height: 20)
+    }
+
+    func splitView(_ splitView: NSSplitView, constrainMinCoordinate proposedMinimumPosition: CGFloat,
+                   ofSubviewAt dividerIndex: Int) -> CGFloat {
+        return splitView.isVertical ? OmniAgentPageGeometry.runsMinWidth : OmniAgentPageGeometry.stackedMinHeight
+    }
+
+    func splitView(_ splitView: NSSplitView, constrainMaxCoordinate proposedMaximumPosition: CGFloat,
+                   ofSubviewAt dividerIndex: Int) -> CGFloat {
+        if splitView.isVertical {
+            return max(OmniAgentPageGeometry.runsMinWidth,
+                       splitView.bounds.width - splitView.dividerThickness - OmniAgentPageGeometry.reportMinWidth)
+        }
+        return max(OmniAgentPageGeometry.stackedMinHeight,
+                   splitView.bounds.height - splitView.dividerThickness - OmniAgentPageGeometry.stackedMinHeight)
+    }
+
+    // The window keeps the report beside the runs at its width.
+    func splitView(_ splitView: NSSplitView, shouldAdjustSizeOfSubview view: NSView) -> Bool {
+        return view !== left || left.isHidden
+    }
+
+    // The runs and settings, at least enough room for a report beside them,
+    // or stacked, with a report's worth of room under them.
+    var preferredHeight: CGFloat {
+        let runs = runsCollapsed ? 0 : left.column.frame.height
+        if isStacked && !runsCollapsed {
+            return runs + OmniAgentPageGeometry.reportMinWidth
+        }
+        return max(280, runs)
+    }
+
+    func reload() {
+        report?.reload()
+    }
+
+    func show(agent: [AnyHashable: Any], runs: [OmniRun], selected: String?) {
+        let settings = OmniPane.signature(agent)
+        let runRows = OmniPane.signature(runs.map { [$0.id, $0.state, $0.statusLine, $0.commits.count] }, selected ?? "")
+        guard settings != settingsSignature || runRows != runsSignature else {
+            showReport(selected)
+            return
+        }
+        left.rebuildKeepingScroll {
+            if settings != settingsSignature {
+                settingsSignature = settings
+                rebuildSettings(agent)
+            }
+            if runRows != runsSignature {
+                runsSignature = runRows
+                rebuildRuns(runs, selected: selected)
+            }
+        }
+        showReport(selected)
+        contentHeightDidChange?()
+    }
+
+    private func buildColumn() {
+        let column = left.column
+        for nested in [runsColumn, settingsColumn] {
+            nested.inset = 0
+            nested.topPadding = 0
+            nested.bottomPadding = 0
+        }
+        let runsColumn = self.runsColumn
+        let settingsColumn = self.settingsColumn
+        column.addSection("Last runs")
+        column.add(runsColumn, spacing: 8) { [weak runsColumn] width in
+            runsColumn?.layoutColumn(width: width) ?? 0
+        }
+        column.addSection("Settings")
+        column.add(settingsColumn, spacing: 8) { [weak settingsColumn] width in
+            settingsColumn?.layoutColumn(width: width) ?? 0
+        }
+    }
+
+    private func rebuildSettings(_ row: [AnyHashable: Any]) {
+        settingsColumn.removeAll()
+        guard let agent = OmniAgent(row) else { return }
+        let timeout = OmniAgentRules.timeoutText((row["timeout_seconds"] as? NSNumber)?.intValue)
+        var facts: [(String, String)] = [
+            (String(localized: "OmniAgent.Kind", defaultValue: "Agent kind", comment: "Agent lifecycle type field"),
+             row["kind"] as? String == "loop" ?
+                String(localized: "OmniAgent.Loop", defaultValue: "Loop — one persistent session", comment: "Loop keeps one session") :
+                String(localized: "OmniAgent.Scheduled", defaultValue: "Scheduled agent", comment: "Normal agent kind")),
+            (String(localized: "OmniAgent.SessionPolicy", defaultValue: "Session reuse", comment: "Session reuse policy field"),
+             row["kind"] as? String == "loop" ? "Same persistent session" : row["session_policy"] as? String != "fresh" ?
+                String(localized: "OmniAgent.Resume", defaultValue: "Resume when available", comment: "Reuse compatible completed session") :
+                String(localized: "OmniAgent.Fresh", defaultValue: "Start fresh", comment: "Start a new session each run")),
+            ("Workspace", agent.workspace ?? "—"),
+            ("Provider", agent.providerName + (agent.model.map { " · \($0)" } ?? "")),
+            ("Permissions", agent.permissionMode.map { agent.isDangerous ? "⚠ \($0)" : $0 } ?? "Provider default"),
+            ("Run behavior", row["kind"] as? String == "loop" ? "Repeat prompt when idle" :
+                (agent.overlap == "parallel" ? "Runs in parallel" : "A new run replaces the last")),
+            ("Timeout", timeout),
+            ("Schedule", agent.schedule + (agent.enabled ? "" : " · paused")),
+        ]
+        if agent.enabled, let next = agent.nextRun {
+            facts.append(("Next run", OmniFormat.date(next)))
+        }
+        settingsColumn.addText(OmniPane.facts(facts))
+        promptViews = []
+        for (title, text) in [("Startup prompt", agent.startupPrompt), ("System prompt", agent.systemPrompt)] {
+            settingsColumn.addText(OmniPaneText.label(title, size: 12, color: OmniTheme.secondaryText), spacing: 4)
+            guard !text.isEmpty else {
+                settingsColumn.addText(OmniPaneText.label("None", color: OmniTheme.tertiaryText), spacing: 12)
+                continue
+            }
+            let prompt = OmniMarkdownView(text: OmniReportText.sanitized(text))
+            prompt.collapsedHeight = OmniMarkdownView.height(lines: 8)
+            prompt.didChangeHeight = { [weak self] in
+                self?.left.relayout()
+                self?.contentHeightDidChange?()
+            }
+            promptViews.append(prompt)
+            settingsColumn.add(prompt, spacing: 12) { [weak prompt] width in
+                prompt?.height(forWidth: width) ?? 0
+            }
+        }
+        let edit = OmniPaneText.button("Edit…", target: self, action: #selector(edit(_:)))
+        let reveal = OmniPaneText.button("Reveal Workspace", target: self, action: #selector(revealWorkspace(_:)))
+        reveal.isEnabled = agent.workspace.map { FileManager.default.fileExists(atPath: ($0 as NSString).expandingTildeInPath) } ?? false
+        let buttons = OmniButtonRow([edit, reveal])
+        settingsColumn.add(buttons, spacing: 4) { _ in 30 }
+        // One zone over the whole settings column, so the prompts' Show more
+        // toggles come before Edit and Reveal.
+        let zone = OmniButtonZone()
+        zone.buttons = { [weak self, weak buttons] in
+            (self?.promptViews.map(\.toggleButton) ?? []) + (buttons?.buttons.compactMap { $0 as? NSButton } ?? [])
+        }
+        settingsColumn.overlay = zone
+        settingsZone = zone
+    }
+
+    private func rebuildRuns(_ runs: [OmniRun], selected: String?) {
+        runsColumn.removeAll()
+        runsByID = Dictionary(runs.map { ($0.id, $0) }, uniquingKeysWith: { first, _ in first })
+        var zoneItems: [(key: String, view: OmniZoneItem)] = []
+        if runs.isEmpty {
+            runsColumn.addText(OmniPaneText.label("This agent has not run yet.", color: OmniTheme.secondaryText))
+        }
+        for run in runs {
+            var title = OmniFormat.relative(min(run.started, Date()))
+            if let finished = run.finished {
+                title += " · \(OmniFormat.duration(from: run.started, to: finished))"
+            } else if run.isLive {
+                title += " · \(run.isIdle ? "idle" : "running") \(OmniFormat.duration(from: run.started, to: Date()))"
+            }
+            if !run.commits.isEmpty {
+                title += run.commits.count == 1 ? " · 1 commit" : " · \(run.commits.count) commits"
+            }
+            let summary = run.oneLineSummary
+            let row = OmniRunRowView(title: title, detail: summary.isEmpty ? "No summary yet" : summary,
+                                     badge: run.outcomeName, color: run.outcomeColor) { [weak self] in
+                self?.choose(run.id)
+            }
+            row.contextMenu = { [weak self] in
+                OmniContextMenus.run(run.id, agent: nil, live: run.isLive, actions: self?.actions, window: self?.window) {
+                    self?.didChangeAgent?()
+                }
+            }
+            zoneItems.append((run.id, row))
+            runsColumn.add(row, spacing: 2) { _ in OmniRunRowView.height }
+        }
+        runsZone.setItems(zoneItems, selected: selected)
+    }
+
+    // A click or Up and Down: the row, its report and the card's band follow
+    // at once.
+    private func choose(_ runID: String) {
+        guard let run = runsByID[runID] else { return }
+        runsZone.select(runID)
+        showReport(runID)
+        didSelectRun?(run)
+    }
+
+    @objc private func edit(_ sender: Any?) {
+        guard let window else { return }
+        OmniAgentEditorSheet.present(agentName: agentName, on: window) { [weak self] _ in
+            self?.settingsSignature = ""
+            self?.didChangeAgent?()
+        }
+    }
+
+    @objc private func revealWorkspace(_ sender: Any?) {
+        OmniSchedulerClient.request(["op": "show_agent", "name": agentName]) { response in
+            guard let agent = (response["agent"] as? [AnyHashable: Any]).flatMap(OmniAgent.init),
+                  let workspace = agent.workspace.map({ ($0 as NSString).expandingTildeInPath }),
+                  FileManager.default.fileExists(atPath: workspace) else {
+                return
+            }
+            NSWorkspace.shared.activateFileViewerSelecting([URL(fileURLWithPath: workspace)])
+        }
+    }
+
+    private func showReport(_ runID: String?) {
+        guard let runID else {
+            report?.removeFromSuperview()
+            report = nil
+            reportPlaceholder.isHidden = false
+            return
+        }
+        reportPlaceholder.isHidden = true
+        guard report?.runID != runID else { return }
+        report?.removeFromSuperview()
+        let pane = OmniRunReportPane(runID: runID, compact: true)
+        pane.actions = actions
+        pane.layoutStore = layoutStore
+        if let layoutStore {
+            pane.applyPanelLayout(layoutStore.layout)
+        }
+        pane.frame = right.bounds
+        right.addSubview(pane)
+        report = pane
+        pane.reload()
+    }
+}
