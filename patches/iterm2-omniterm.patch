+static NSDictionary *OmniBacklogWrite(NSString *key, NSUInteger bytes) {
+    return @{ @"key": key, @"value": @{ @"text": [@"" stringByPaddingToLength:bytes withString:@"x" startingAtIndex:0] } };
+}
+
+// A worker whose pending set never empties: every reply carries one ~300 KB
+// write and more to come. A tick saves at most its allowance, acknowledges
+// only what it saved, and then produces nothing new until the rest is saved.
+- (void)testKnowledgeTickSavesAtMostItsAllowanceAndStopsProducing {
+    OmniKnowledgeTestScheduler *scheduler = [self knowledgeScheduler];
+    [scheduler setValue:@YES forKey:@"knowledgeEnabled"];
+    __block NSInteger revision = 0;
+    __block NSInteger acknowledged = 0;
+    NSMutableArray *operations = [NSMutableArray array];
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        if ([request[@"op"] isEqual:@"ack_writes"]) {
+            XCTAssertEqual([request[@"revision"] integerValue], acknowledged + 1, @"acknowledged in order, one batch at a time");
+            acknowledged = [request[@"revision"] integerValue];
+            return @{ @"ok": @YES };
+        }
+        [operations addObject:[request[@"delivery_only"] isEqual:@YES] ? @"deliver" : request[@"op"]];
+        // The head of the pending set is resent until it is acknowledged.
+        const NSInteger head = acknowledged + 1;
+        revision = MAX(revision, head);
+        return @{ @"ok": @YES, @"backlog_files": @1,
+                  @"_writes": @[ OmniBacklogWrite([NSString stringWithFormat:@"message:%ld", (long)head], 300 * 1024) ],
+                  @"_revision": @(head), @"_more_writes": @YES };
+    };
+    [scheduler tickKnowledge];
+    NSDictionary *maintenance = scheduler.knowledgeMaintenance;
+    XCTAssertLessThanOrEqual([maintenance[@"tick_write_bytes"] unsignedIntegerValue], 1024u * 1024u);
+    XCTAssertEqual(acknowledged, 3, @"three 300 KB batches fit in one megabyte");
+    XCTAssertEqualObjects(maintenance[@"writes_waiting"], @YES);
+    XCTAssertFalse([operations containsObject:@"embed"]);
+    XCTAssertFalse([operations containsObject:@"memory_tick"]);
+    XCTAssertFalse([operations containsObject:@"scan"], @"no transcript is read while writes wait");
+    XCTAssertTrue([operations containsObject:@"deliver"], @"session messages are still delivered");
+    XCTAssertNotNil([self savedKnowledgeRecord:@"message:3"]);
+    XCTAssertNil([self savedKnowledgeRecord:@"message:4"]);
+
+    // Once the worker's pending set empties, the next tick produces again.
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        if (![request[@"op"] isEqual:@"ack_writes"]) [operations addObject:request[@"op"]];
+        return @{ @"ok": @YES };
+    };
+    [operations removeAllObjects];
+    [scheduler tickKnowledge];
+    XCTAssertEqualObjects(scheduler.knowledgeMaintenance[@"writes_waiting"], @NO);
+    XCTAssertTrue([operations containsObject:@"scan"]);
+    scheduler.workerRequest = nil;
+    [scheduler stop];
+}
