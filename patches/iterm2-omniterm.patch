+    // A fake app: a hotkey slot, a login flag and a store, with a log of effects.
+    private final class FakeApp {
+        var shortcut: Any = ["keyCode": 49]
+        var login = false
+        var taken = false
+        var stored: [[String: Any]] = []
+        var forwarded: [[String: Any]] = []
+        var schedulerAccepts = true
+
+        func transaction() -> OmniSettingsTransaction {
+            let transaction = OmniSettingsTransaction()
+            transaction.currentShortcut = { self.shortcut }
+            transaction.applyShortcut = { value in
+                if self.taken, value is [AnyHashable: Any] { return false }
+                self.shortcut = value
+                return true
+            }
+            transaction.currentLogin = { self.login }
+            transaction.setLogin = { self.login = $0; return nil }
+            transaction.store = { self.stored.append($0); return nil }
+            transaction.forward = { changes, done in
+                self.forwarded.append(changes)
+                done(self.schedulerAccepts ? ["ok": true] : ["ok": false, "code": "invalid_settings"])
+            }
+            return transaction
+        }
+
+        func run(_ changes: [String: Any]) -> [AnyHashable: Any] {
+            var result: [AnyHashable: Any] = [:]
+            transaction().run(changes) { result = $0 }
+            return result
+        }
+    }
+
+    func testSettingsTransactionAppliesStoresAndForwards() {
+        let app = FakeApp()
+        let result = app.run(["global_shortcut": ["keyCode": 50], "launch_at_login": true, "retained_run_tabs": 12])
+        XCTAssertEqual(result["ok"] as? Bool, true)
+        XCTAssertEqual((app.shortcut as? [String: Int])?["keyCode"], 50)
+        XCTAssertTrue(app.login)
+        XCTAssertEqual(app.forwarded.count, 1)
+        XCTAssertEqual(app.forwarded.first?["retained_run_tabs"] as? Int, 12)
+        XCTAssertNil(app.forwarded.first?["global_shortcut"], "the scheduler never sees the app's keys")
+        XCTAssertEqual(app.stored.first?["launch_at_login"] as? Bool, true)
+    }
+
+    func testSettingsTransactionUndoesEverythingWhenTheSchedulerRefuses() {
+        let app = FakeApp()
+        app.schedulerAccepts = false
+        let result = app.run(["global_shortcut": ["keyCode": 50], "launch_at_login": true, "retained_run_tabs": 0])
+        XCTAssertEqual(result["ok"] as? Bool, false)
+        XCTAssertEqual((app.shortcut as? [String: Int])?["keyCode"], 49, "the shortcut is put back")
+        XCTAssertFalse(app.login, "login launch is put back")
+        XCTAssertTrue(app.stored.isEmpty)
+    }
+
+    func testSettingsTransactionStopsWhenTheShortcutIsTaken() {
+        let app = FakeApp()
+        app.taken = true
+        let result = app.run(["global_shortcut": ["keyCode": 50], "launch_at_login": true, "retained_run_tabs": 12])
+        XCTAssertEqual(result["code"] as? String, "shortcut_unavailable")
+        XCTAssertFalse(app.login)
+        XCTAssertTrue(app.forwarded.isEmpty, "nothing else is saved")
+        XCTAssertTrue(app.stored.isEmpty)
+    }
+
+    func testSettingsTransactionRejectsWrongTypesWithoutEffects() {
+        for changes: [String: Any] in [["global_shortcut": 5], ["launch_at_login": "yes"], ["launch_at_login": 1]] {
+            let app = FakeApp()
+            let result = app.run(changes.merging(["retained_run_tabs": 12]) { a, _ in a })
+            XCTAssertEqual(result["code"] as? String, "invalid_settings", "\(changes)")
+            XCTAssertTrue(app.forwarded.isEmpty)
+            XCTAssertFalse(app.login)
+        }
+    }
+
+    // The app's own wiring, in this running app: the transaction registers a
+    // real global hotkey and puts the old one back, and reads the real login
+    // item. Login is only "set" to its current value, which changes nothing;
+    // toggling it here would register this test build as a login item.
+    func testAppWiringRegistersARealHotkeyAndReadsTheLoginItem() throws {
+        let delegate = try XCTUnwrap(NSApp.delegate as? iTermApplicationDelegate)
+        let transaction = try XCTUnwrap(delegate.omniSettingsTransaction() as? OmniSettingsTransaction)
+        let previous = transaction.currentShortcut()
+        defer { XCTAssertTrue(transaction.applyShortcut(previous), "the earlier shortcut is restored") }
+        let unusual = try XCTUnwrap(iTermShortcut(keyCode: 0x50, hasKeyCode: true, modifiers: [.control, .option, .command],
+                                                  characters: "", charactersIgnoringModifiers: ""))
+        XCTAssertTrue(transaction.applyShortcut(unusual.dictionaryValue), "Control-Option-Command-F19 registers")
+        let current = try XCTUnwrap(transaction.currentShortcut() as? [AnyHashable: Any])
+        XCTAssertEqual((current["keyCode"] as? NSNumber)?.intValue, 0x50)
+        XCTAssertTrue(transaction.applyShortcut(NSNull()), "clearing the shortcut works")
+        XCTAssertTrue(transaction.currentShortcut() is NSNull)
+
+        let login = transaction.currentLogin()
+        XCTAssertNil(transaction.setLogin(login), "setting login launch to its current state succeeds")
+        XCTAssertEqual(transaction.currentLogin(), login)
+    }
+
+    // Muted, the icon keeps its size and template tinting and is crossed out.
+    // Both are written out at 8x for a person to look at.
+    func testMutedIconKeepsTheIconAndIsCrossedOut() throws {
+        let base = try XCTUnwrap(iTermApplication.omniTermStatusItemImage())
+        let muted = AIMenuBarStatusController.mutedImage(base)
+        XCTAssertEqual(muted.size, base.size)
+        XCTAssertEqual(muted.isTemplate, base.isTemplate)
+        for (name, image) in [("plain", base), ("muted", muted)] {
+            let scale: CGFloat = 8
+            let rep = try XCTUnwrap(NSBitmapImageRep(bitmapDataPlanes: nil,
+                                                    pixelsWide: Int(base.size.width * scale),
+                                                    pixelsHigh: Int(base.size.height * scale),
+                                                    bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
+                                                    isPlanar: false, colorSpaceName: .deviceRGB,
+                                                    bytesPerRow: 0, bitsPerPixel: 0))
+            NSGraphicsContext.saveGraphicsState()
+            NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
+            NSColor.white.setFill()
+            NSRect(x: 0, y: 0, width: base.size.width * scale, height: base.size.height * scale).fill()
+            image.draw(in: NSRect(x: 0, y: 0, width: base.size.width * scale, height: base.size.height * scale))
+            NSGraphicsContext.restoreGraphicsState()
+            let data = try XCTUnwrap(rep.representation(using: .png, properties: [:]))
+            let url = URL(fileURLWithPath: NSTemporaryDirectory()).appendingPathComponent("omni-icon-\(name).png")
+            try data.write(to: url)
+            print("OMNI_ICON_RENDER \(url.path)")
