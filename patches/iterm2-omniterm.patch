+    private func searchTranscripts() {
+        sessionSearchGeneration += 1
+        let generation = sessionSearchGeneration
+        guard sessionQuery.count >= 2 else { return }
+        var request: [String: Any] = ["op": "search_transcripts", "query": sessionQuery, "limit": 50]
+        if let provider = CFPreferencesCopyAppValue(Self.sessionsProviderKey, Self.preferencesDomain) as? String {
+            request["provider"] = provider
+        }
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self, generation == self.sessionSearchGeneration, response["ok"] as? Bool == true else { return }
+            let matches = response["matches"] as? [[AnyHashable: Any]] ?? []
+            self.sessionMatches = matches.filter { ["claude", "codex"].contains($0["provider"] as? String ?? "") }
+            self.rebuild()
+        }
+    }
+
+    private func loadMoreSessions() {
+        sessionsShown += Self.sessionsPerPage
+        requestSessions(force: true)
+    }
+
+    // A forced request (a filter or Show More) replaces one in flight.
+    private var sessionsGeneration = 0
+
+    private func requestSessions(force: Bool = false) {
+        guard mode == .sessions || !sessionQuery.isEmpty, force || !sessionsRequestInFlight,
+              force || Date().timeIntervalSince(lastSessionsRequest) >= Self.sessionsRefreshInterval else { return }
+        sessionsRequestInFlight = true
+        lastSessionsRequest = Date()
+        sessionsGeneration += 1
+        let generation = sessionsGeneration
+        var collected: [[AnyHashable: Any]] = []
+        func page(_ offset: Int) {
+            var request: [String: Any] = ["op": "list_sessions", "order": "recent", "limit": Self.sessionsPageSize,
+                                          "offset": offset]
+            if let provider = CFPreferencesCopyAppValue(Self.sessionsProviderKey, Self.preferencesDomain) as? String {
+                request["provider"] = provider
+            }
+            OmniSchedulerClient.request(request) { [weak self] response in
+                guard let self, generation == self.sessionsGeneration else { return }
+                guard response["ok"] as? Bool == true else {
+                    self.sessionsRequestInFlight = false
+                    return
+                }
+                let pageSessions = response["sessions"] as? [[AnyHashable: Any]] ?? []
+                collected += pageSessions
+                let next = pageSessions.isEmpty ? nil : (response["next_offset"] as? NSNumber)?.intValue
+                if let next, collected.count < self.sessionsShown {
+                    page(next)
+                    return
+                }
+                self.sessionsHaveMore = next != nil
+                self.sessionsRequestInFlight = false
+                self.sessions = collected
+                self.rebuild()
+            }
+        }
+        page(0)
+    }
