+// Tabs as on a repository host: icon and label, the chosen one underlined,
+// a hairline under them all. Buttons, so they join the keyboard.
+final class OmniTabBar: NSView {
+    static let height: CGFloat = 38
+    let zone = OmniButtonZone()
+    private let buttons: [NSButton]
+    private let selected: Int
+
+    override var isFlipped: Bool { true }
+
+    init(tabs: [(title: String, symbol: SFSymbol)], selected: Int, target: AnyObject, action: Selector) {
+        self.selected = selected
+        buttons = tabs.enumerated().map { index, tab in
+            let button = NSButton(title: tab.title, target: target, action: action)
+            button.isBordered = false
+            button.bezelStyle = .inline
+            button.tag = index
+            button.image = NSImage(systemSymbolName: tab.symbol.rawValue, accessibilityDescription: nil)?
+                .withSymbolConfiguration(NSImage.SymbolConfiguration(pointSize: 12, weight: index == selected ? .semibold : .regular))
+            button.imagePosition = .imageLeading
+            button.imageHugsTitle = true
+            let color = index == selected ? NSColor.labelColor : OmniTheme.secondaryText
+            button.contentTintColor = color
+            button.attributedTitle = NSAttributedString(string: tab.title, attributes: [
+                .font: index == selected ? OmniTheme.Font.rowTitleEmphasized : OmniTheme.Font.rowTitle,
+                .foregroundColor: color])
+            button.setAccessibilityValue(index == selected ? "selected" : nil)
+            return button
+        }
+        super.init(frame: NSRect(x: 0, y: 0, width: 400, height: Self.height))
+        for button in buttons {
+            addSubview(button)
+        }
+        zone.buttons = { [weak self] in self?.buttons ?? [] }
+        addSubview(zone)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        var x: CGFloat = 0
+        for button in buttons {
+            button.sizeToFit()
+            button.frame = NSRect(x: x, y: 4, width: button.frame.width + 20, height: 28)
+            x = button.frame.maxX + 2
+        }
+        zone.frame = bounds
+        needsDisplay = true
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        OmniTheme.titlebarSeparator.setFill()
+        NSRect(x: 0, y: bounds.height - 1, width: bounds.width, height: 1).fill()
+        guard buttons.indices.contains(selected) else { return }
+        let chosen = buttons[selected].frame
+        NSColor.controlAccentColor.setFill()
+        NSBezierPath(roundedRect: NSRect(x: chosen.minX + 4, y: bounds.height - 2.5, width: chosen.width - 8, height: 2.5),
+                     xRadius: 1.25, yRadius: 1.25).fill()
+    }
+}
