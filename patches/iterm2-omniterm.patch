+import AppKit
+import Foundation
+
+// What the right side of the window shows when it is not a plain terminal.
+enum OmniPaneRoute: Equatable {
+    case overview
+    case agent(String)
+    case run(String)
+    // A sidebar folder, by its group path (`A` or `A/B`).
+    case group(String)
+    // The Inbox, embedded as a page.
+    case inbox
+    // Memory: browse, search, process, digest and graph.
+    case memory
+    // Settings: notifications, app behaviour and new-agent defaults.
+    case settings
+    // The background unblocker: its switch, policy and audit trail.
+    case unblocker
+    // Every forge project on the Mac, and one project by its root path.
+    case projects
+    case project(String)
+    // A Claude or Codex session from the machine's history, by its
+    // provider-qualified ID (`claude:<id>`).
+    case session(String)
+    // Every result of a search, on one page.
+    case search(String)
+}
+
+// What a folder page asks the sidebar to do with its folder.
+enum OmniFolderAction {
+    case rename
+    case newSubfolder
+    case newAgent
+    case delete
+}
+
+// The sidebar owns the tabs, so panes ask it for anything that touches them.
+protocol OmniPaneActions: AnyObject {
+    func paneOpen(_ route: OmniPaneRoute)
+    // Selects the live tab of a run. False when the run has no open tab.
+    func paneShowTerminal(forRun runID: String) -> Bool
+    // After Run Now or Resume: when the run's tab appears, and the window
+    // still shows `from`, show `route` with that tab.
+    func paneExpectTab(forRun runID: String, showing route: OmniPaneRoute, from: OmniPaneRoute)
+    // A card's header height or its cover of the terminal changed.
+    func paneLayoutDidChange()
+    func paneFolder(_ action: OmniFolderAction, path: String)
+    // A page's panel toggle (the same as Control-Command-1 to 4).
+    func paneTogglePanel(_ panel: OmniPanel)
+    // Opens a provider session in a new tab, in its folder. Returns why it
+    // could not, or nil.
+    func paneResumeSession(_ session: [AnyHashable: Any]) -> String?
+    func paneHasTab(forSession sessionID: String) -> Bool
+    // Selects the tab a session was resumed into. False when it has none.
+    func paneShowTerminal(forSession sessionID: String) -> Bool
+    // The Memory page's search, with a query such as `session:claude:<id>`.
