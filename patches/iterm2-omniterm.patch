+- (NSDictionary *)runReport:(NSString *)runID {
+    return [_scheduler responseForRequest:@{ @"op": @"get_run", @"id": runID }][@"run"];
+}
+
+// Captures finish on another queue; poll until they land, with a generous deadline.
+- (NSDictionary *)waitForRun:(NSString *)runID until:(BOOL (^)(NSDictionary *run))condition {
+    NSDate *deadline = [NSDate dateWithTimeIntervalSinceNow:30];
+    NSDictionary *run = [self runReport:runID];
+    while (!condition(run) && deadline.timeIntervalSinceNow > 0) {
+        [[NSRunLoop currentRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.05]];
+        run = [self runReport:runID];
+    }
+    XCTAssertTrue(condition(run), @"%@", run);
+    return run;
+}
