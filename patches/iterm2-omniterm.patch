+++ b/sources/OmniTerm/OmniContextMenus.swift
@@ -0,0 +1,368 @@
+import AppKit
+import Foundation
+
+// MARK: - Menu items
+
+// A menu item that runs a closure, so a row's right-click menu is written
+// where the row is built.
+final class OmniMenuItem: NSMenuItem {
+    private let handler: () -> Void
+
+    init(_ title: String, symbol: SFSymbol? = nil, enabled: Bool = true, state: NSControl.StateValue = .off,
+         handler: @escaping () -> Void) {
+        self.handler = handler
+        super.init(title: title, action: #selector(fire(_:)), keyEquivalent: "")
+        target = self
+        isEnabled = enabled
+        self.state = state
+        if let symbol {
+            image = NSImage(systemSymbolName: symbol.rawValue, accessibilityDescription: nil)
+        }
+    }
+
+    required init(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    @objc private func fire(_ sender: Any?) {
+        handler()
+    }
+}
+
+extension NSMenu {
+    @discardableResult
+    func addAction(_ title: String, symbol: SFSymbol? = nil, enabled: Bool = true, state: NSControl.StateValue = .off,
+                   _ handler: @escaping () -> Void) -> NSMenuItem {
+        let item = OmniMenuItem(title, symbol: symbol, enabled: enabled, state: state, handler: handler)
+        autoenablesItems = false
+        addItem(item)
+        return item
+    }
+
+    func addSubmenu(_ title: String, symbol: SFSymbol? = nil, _ build: (NSMenu) -> Void) {
+        let item = NSMenuItem(title: title, action: nil, keyEquivalent: "")
+        if let symbol {
+            item.image = NSImage(systemSymbolName: symbol.rawValue, accessibilityDescription: nil)
+        }
+        let submenu = NSMenu(title: title)
+        submenu.autoenablesItems = false
+        build(submenu)
+        item.submenu = submenu
+        addItem(item)
+    }
+
+    // Drops a trailing or doubled separator left by optional items.
+    func tidySeparators() {
+        var previousWasSeparator = true
+        for item in items {
+            if item.isSeparatorItem && previousWasSeparator {
+                removeItem(item)
+            } else {
+                previousWasSeparator = item.isSeparatorItem
+            }
+        }
+        if let last = items.last, last.isSeparatorItem {
+            removeItem(last)
+        }
+    }
+}
+
+// MARK: - Pointer cursor
+
+// Everything clickable on OmniTerm's pages shows the pointing hand, never
+// the text cursor. Rows set it in their own cursor rects; plain AppKit
+// controls get a cursor-update tracking area through `install`.
+final class OmniPointer: NSObject {
+    static let shared = OmniPointer()
+
+    private final class Weak {
+        weak var view: NSView?
+        init(_ view: NSView) {
+            self.view = view
+        }
+    }
+
+    private static var monitor: Any?
+
+    // The safety net for controls built after a page was shown (editor
+    // choices, chips, detail buttons): the first time the mouse moves over
+    // one, it gets the pointer too. Runs in OmniTerm's own process only.
+    static func startWatching() {
+        guard monitor == nil else { return }
+        monitor = NSEvent.addLocalMonitorForEvents(matching: [.mouseMoved]) { event in
+            guard let content = event.window?.contentView else { return event }
+            let base = content.superview ?? content
+            var view = content.hitTest(base.convert(event.locationInWindow, from: nil))
+            var depth = 0
+            while let current = view, depth < 4, !(current is NSTextView) {
+                if isClickable(current) {
+                    if !current.trackingAreas.contains(where: { $0.owner === shared }) {
+                        shared.attach(to: current)
+                        if (current as? NSControl)?.isEnabled != false {
+                            NSCursor.pointingHand.set()
+                        }
+                    }
+                    break
+                }
+                view = current.superview
+                depth += 1
+            }
+            return event
+        }
+    }
+
+    // Adds the pointer to `view` and every clickable control inside it.
+    static func install(in view: NSView) {
+        if isClickable(view) {
+            shared.attach(to: view)
+        }
+        // Text views and terminals keep their own cursors.
+        guard !(view is NSTextView), !(view is NSTextField && (view as! NSTextField).isEditable) else { return }
+        for subview in view.subviews {
+            install(in: subview)
+        }
+    }
+
+    private static func isClickable(_ view: NSView) -> Bool {
+        switch view {
+        case is NSButton, is NSSegmentedControl, is NSSlider, is NSColorWell, is NSSwitch, is NSStepper:
+            return true
+        default:
+            return false
+        }
+    }
+
+    private func attach(to view: NSView) {
+        guard !view.trackingAreas.contains(where: { $0.owner === self }) else { return }
+        view.addTrackingArea(NSTrackingArea(rect: .zero, options: [.cursorUpdate, .mouseEnteredAndExited, .activeInKeyWindow, .inVisibleRect],
+                                            owner: self, userInfo: ["view": Weak(view)]))
+    }
+
+    private static func view(_ event: NSEvent) -> NSView? {
+        return (event.trackingArea?.userInfo?["view"] as? Weak)?.view
+    }
+
+    // OmniPointer is not a responder, so these need AppKit's selector names
+    // spelled out: plain @objc would export cursorUpdateWith:, and a tracking
+    // area sending cursorUpdate: to it would abort the app.
+    @objc(cursorUpdate:) func cursorUpdate(with event: NSEvent) {
+        let enabled = (Self.view(event) as? NSControl)?.isEnabled ?? true
+        (enabled ? NSCursor.pointingHand : NSCursor.arrow).set()
+    }
+
+    @objc(mouseEntered:) func mouseEntered(with event: NSEvent) {
+    }
+
+    @objc(mouseExited:) func mouseExited(with event: NSEvent) {
+        if NSCursor.current == NSCursor.pointingHand {
+            NSCursor.arrow.set()
+        }
+    }
+}
+
+// A row that opens something: the pointing hand over it, and its own
+// right-click menu.
+protocol OmniContextRow: NSView {
+    var contextMenu: (() -> NSMenu?)? { get set }
+}
+
+// MARK: - Shared actions
+
+// The commands OmniTerm offers wherever an agent, run, session, file or
+// project appears, so every right-click menu says and does the same thing.
+enum OmniContextMenus {
+    static func problem(_ message: String, window: NSWindow?) {
+        iTermWarning.show(withTitle: message, actions: ["OK"], actionMapping: nil, accessory: nil, identifier: nil,
+                          silenceable: .kiTermWarningTypePersistent, heading: "OmniTerm", cancelLabel: "OK", window: window)
+    }
+
+    // A one-field question; nil when cancelled or left blank.
+    static func ask(_ heading: String, value: String, window: NSWindow?) -> String? {
+        let field = NSTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 24))
+        field.stringValue = value
+        let selection = iTermWarning.show(withTitle: heading, actions: ["Rename", "Cancel"], actionMapping: nil,
+                                          accessory: field, identifier: nil, silenceable: .kiTermWarningTypePersistent,
+                                          heading: heading, cancelLabel: "Cancel", window: window)
+        let text = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        return selection == .kiTermWarningSelection0 && !text.isEmpty && text != value ? text : nil
+    }
+
+    static func copy(_ text: String) {
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(text, forType: .string)
+    }
+
+    // An agent: open, run, edit, schedule on or off, delete.
+    static func agent(_ name: String, enabled: Bool?, actions: OmniPaneActions?, window: NSWindow?, rename: Bool = true,
+                      changed: @escaping () -> Void = {}) -> NSMenu {
+        let menu = NSMenu()
+        menu.addAction("Open", symbol: .arrowRightCircle) { actions?.paneOpen(.agent(name)) }
+        menu.addAction("Run Now", symbol: .play) {
+            OmniSchedulerClient.request(["op": "run_agent", "name": name]) { response in
+                guard OmniPane.isOK(response), let runID = response["run_id"] as? String else {
+                    problem(response["error"] as? String ?? "The agent could not be started.", window: window)
+                    return
+                }
+                actions?.paneExpectTab(forRun: runID, showing: .run(runID), from: actions?.paneShownRoute ?? .agent(name))
+                changed()
+            }
+        }
+        menu.addAction("Edit…", symbol: .pencil) {
+            guard let window else { return }
+            OmniAgentEditorSheet.present(agentName: name, on: window) { _ in changed() }
+        }
+        if rename {
+            menu.addAction("Rename…", symbol: .characterCursorIbeam) {
+                guard let newName = ask("Rename Agent", value: name, window: window) else { return }
+                OmniSchedulerClient.request(["op": "rename_agent", "name": name, "new_name": newName]) { response in
+                    guard OmniPane.isOK(response) else {
+                        problem(response["error"] as? String ?? "The agent could not be renamed.", window: window)
+                        return
+                    }
+                    if actions?.paneShownRoute == .agent(name) {
+                        actions?.paneOpen(.agent(newName))
+                    }
+                    changed()
+                }
+            }
+        }
+        if let enabled {
+            menu.addAction(enabled ? "Pause Schedule" : "Resume Schedule", symbol: enabled ? .pause : .calendar) {
+                OmniSchedulerClient.request(["op": "set_enabled", "name": name, "enabled": !enabled]) { response in
+                    if !OmniPane.isOK(response) {
+                        problem(response["error"] as? String ?? "The schedule could not be changed.", window: window)
+                    }
+                    changed()
+                }
+            }
+        }
+        menu.addItem(.separator())
+        menu.addAction("Copy Name", symbol: .docOnDoc) { copy(name) }
+        menu.addAction("Delete Agent…", symbol: .trash) {
+            let choice = iTermWarning.show(withTitle: "Delete the agent “\(name)”? Its schedule stops and its file is removed. Run history is kept.",
+                                           actions: ["Delete", "Cancel"], actionMapping: nil, accessory: nil, identifier: nil,
+                                           silenceable: .kiTermWarningTypePersistent, heading: "Delete Agent",
+                                           cancelLabel: "Cancel", window: window)
+            guard choice == .kiTermWarningSelection0 else { return }
+            OmniSchedulerClient.request(["op": "delete_agent", "name": name]) { response in
+                if !OmniPane.isOK(response) {
+                    problem(response["error"] as? String ?? "The agent could not be deleted.", window: window)
+                } else if actions?.paneShownRoute == .agent(name) {
+                    actions?.paneOpen(.overview)
+                }
+                changed()
+            }
+        }
+        return menu
+    }
+
+    // A run: its report, its terminal while live, stop or resume.
+    static func run(_ runID: String, agent: String?, live: Bool, actions: OmniPaneActions?, window: NSWindow?,
+                    changed: @escaping () -> Void = {}) -> NSMenu {
+        let menu = NSMenu()
+        menu.addAction("Open Report", symbol: .docText) { actions?.paneOpen(.run(runID)) }
+        if live {
+            menu.addAction("Show Terminal", symbol: .terminal) {
+                if actions?.paneShowTerminal(forRun: runID) != true {
+                    actions?.paneOpen(.run(runID))
+                }
+            }
+            menu.addAction("Stop Run", symbol: .stopCircle) {
+                OmniSchedulerClient.request(["op": "stop_run", "run_id": runID]) { response in
+                    if !OmniPane.isOK(response) {
+                        problem(response["error"] as? String ?? "The run had already ended.", window: window)
+                    }
+                    changed()
+                }
+            }
+        } else {
+            menu.addAction("Resume", symbol: .arrowClockwise) {
+                OmniSchedulerClient.request(["op": "resume_run", "run_id": runID]) { response in
+                    guard OmniPane.isOK(response), let newID = response["run_id"] as? String else {
+                        problem(response["error"] as? String ?? "The session could not be resumed.", window: window)
+                        return
+                    }
+                    actions?.paneExpectTab(forRun: newID, showing: .run(newID), from: actions?.paneShownRoute ?? .run(runID))
+                    changed()
+                }
+            }
+        }
+        if let agent {
+            menu.addItem(.separator())
+            menu.addAction("Open Agent “\(agent)”", symbol: .personCropCircle) { actions?.paneOpen(.agent(agent)) }
+        }
+        menu.addItem(.separator())
+        menu.addAction("Copy Run ID", symbol: .docOnDoc) { copy(runID) }
+        return menu
+    }
+
+    // A Claude or Codex session: open, resume or show its terminal, find it in memory.
+    static func session(_ session: [AnyHashable: Any], actions: OmniPaneActions?, window: NSWindow?, rename: Bool = true) -> NSMenu {
+        let menu = NSMenu()
+        let id = session["session_id"] as? String ?? ""
+        let qualified = id
+        menu.addAction("Open", symbol: .arrowRightCircle) { actions?.paneOpen(.session(qualified)) }
+        if !id.isEmpty, actions?.paneHasTab(forSession: id) == true {
+            menu.addAction("Show Terminal", symbol: .terminal) { _ = actions?.paneShowTerminal(forSession: id) }
+        } else {
+            menu.addAction("Resume in a New Tab", symbol: .arrowClockwise, enabled: !OmniSessionText.isLive(session)) {
+                if let problem = actions?.paneResumeSession(session) {
+                    self.problem(problem, window: window)
+                }
+            }
+        }
+        if rename, !id.isEmpty {
+            menu.addAction("Rename…", symbol: .characterCursorIbeam) {
+                let current = session["title"] as? String ?? ""
+                guard let title = ask("Rename Session", value: current, window: window) else { return }
+                OmniSchedulerClient.request(["op": "rename_session", "session_id": id, "title": title]) { response in
+                    if OmniPane.isOK(response) {
+                        actions?.paneSessionsChanged()
+                    } else {
+                        problem(response["error"] as? String ?? "The session could not be renamed.", window: window)
+                    }
+                }
+            }
+        }
+        menu.addAction("Search Memory for This Session", symbol: .magnifyingglass) {
+            actions?.paneSearchMemory("session:" + qualified)
+        }
+        if let folder = session["cwd"] as? String ?? session["workspace"] as? String, !folder.isEmpty {
+            menu.addItem(.separator())
+            menu.addAction("Reveal Folder in Finder", symbol: .folder) { reveal(folder) }
+        }
+        menu.addItem(.separator())
+        menu.addAction("Copy Session ID", symbol: .docOnDoc, enabled: !id.isEmpty) { copy(id) }
+        return menu
+    }
+
+    // A file or folder on disk.
+    static func path(_ path: String, open: (() -> Void)?) -> NSMenu {
+        let menu = NSMenu()
+        if let open {
+            menu.addAction("Open", symbol: .arrowRightCircle, open)
+        }
+        menu.addAction("Reveal in Finder", symbol: .folder) { reveal(path) }
+        menu.addAction("Open with Default App", symbol: .arrowUpRightSquare) {
+            NSWorkspace.shared.open(URL(fileURLWithPath: path))
+        }
+        menu.addItem(.separator())
+        menu.addAction("Copy Path", symbol: .docOnDoc) { copy(path) }
+        return menu
+    }
+
+    // A forge project.
+    static func project(_ root: String, actions: OmniPaneActions?) -> NSMenu {
+        let menu = NSMenu()
+        menu.addAction("Open", symbol: .arrowRightCircle) { actions?.paneOpen(.project(root)) }
+        menu.addItem(.separator())
+        menu.addAction("Reveal in Finder", symbol: .folder) { reveal(root) }
+        menu.addAction("Copy Path", symbol: .docOnDoc) { copy(root) }
+        return menu
+    }
+
+    static func reveal(_ path: String) {
+        let expanded = (path as NSString).expandingTildeInPath
+        NSWorkspace.shared.selectFile(expanded, inFileViewerRootedAtPath: "")
+    }
+}
diff --git a/sources/OmniTerm/OmniDockPresence.swift b/sources/OmniTerm/OmniDockPresence.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d03f55313be021cde4609317a81ee4827aa52cbb
--- /dev/null
+++ b/sources/OmniTerm/OmniDockPresence.swift
@@ -0,0 +1,198 @@
+//
+//  OmniDockPresence.swift
+//  iTerm2SharedARC
+//
+//  OmniTerm is a menu-bar utility that shows in the Dock and ⌘-Tab only while
+//  one of its windows is up.
+//
+
+import AppKit
+import os.log
+
+@objc(OmniDockTerminateDecision)
+enum OmniDockTerminateDecision: Int {
+    case hide
+    case quit
+}
+
+@objc(OmniDockPresence)
+final class OmniDockPresence: NSObject {
+    // Background work orders windows in and out while OmniTerm is inactive,
+    // as at launch; only a window the user is looking at earns the Dock icon.
+    // Once earned, it stays while the user is in another app.
+    @objc(policyWhenAnyWindowVisible:appActive:current:)
+    static func policy(anyWindowVisible: Bool,
+                       appActive: Bool,
+                       current: NSApplication.ActivationPolicy) -> NSApplication.ActivationPolicy {
+        guard anyWindowVisible else {
+            return .accessory
+        }
+        return appActive ? .regular : current
+    }
+
+    // ⌘Q, AppleScript quit and the like only put the windows away. Logout,
+    // shutdown, an updater relaunch and the status menu's Terminate really quit.
+    @objc(terminateDecisionWithExplicitQuit:systemTerminating:updaterRestarting:)
+    static func terminateDecision(explicitQuit: Bool,
+                                  systemTerminating: Bool,
+                                  updaterRestarting: Bool) -> OmniDockTerminateDecision {
+        return (explicitQuit || systemTerminating || updaterRestarting) ? .quit : .hide
+    }
+
+    // A minimized window still counts: without the Dock tile it would be
+    // unreachable.
+    @objc(windowIsPresent:)
+    static func windowIsPresent(_ window: NSWindow?) -> Bool {
+        guard let window else {
+            return false
+        }
+        return window.isVisible || window.isMiniaturized
+    }
+
+    // Only an explicit open (the status menu, the shortcut, the Dock tile, an
+    // omniterm:// link) or the app being unhidden may bring a hidden terminal
+    // window on screen. Restoration, startup cleanup and background runs order
+    // windows in all the time; refusing those at the window, rather than
+    // ordering them out afterwards, keeps launch and relaunch in the menu bar.
+    // Main thread only.
+    private static var explicitShowDepth = 0
+
+    @objc(mayOrderInWindowPresent:)
+    static func mayOrderIn(windowPresent: Bool) -> Bool {
+        return windowPresent || explicitShowDepth > 0
+    }
+
+    @objc(performExplicitShow:)
+    static func performExplicitShow(_ block: () -> Void) {
+        beginExplicitShow()
+        defer { endExplicitShow() }
+        block()
+    }
+
+    @objc static func beginExplicitShow() {
+        explicitShowDepth += 1
+    }
+
+    @objc static func endExplicitShow() {
+        explicitShowDepth = max(0, explicitShowDepth - 1)
+        lastExplicitShowEnd = ProcessInfo.processInfo.systemUptime
+    }
+
+    // An explicit open activates the app right after its show block ends,
+    // and a pinned open activates again once the Space switch finishes.
+    private static let explicitActivationGrace: TimeInterval = 2.5
+    private static var lastExplicitShowEnd: TimeInterval = -.infinity
+
+    // OmniTerm never takes focus by itself: while another app is in front,
+    // runs, sessions, restoration and startup may neither activate OmniTerm
+    // nor raise its windows. Only an explicit open (shortcut, status menu,
+    // Dock tile, link) may, plus a click, which macOS handles itself.
+    private static func isHandlingUserInput() -> Bool {
+        guard let event = NSApp.currentEvent,
+              ProcessInfo.processInfo.systemUptime - event.timestamp < 1 else {
+            return false
+        }
+        switch event.type {
+        case .leftMouseDown, .leftMouseUp, .rightMouseDown, .rightMouseUp,
+             .otherMouseDown, .otherMouseUp, .keyDown:
+            return true
+        default:
+            return false
+        }
+    }
+
+    @objc(mayTakeFocusWithAppActive:)
+    static func mayTakeFocus(appActive: Bool) -> Bool {
+        if appActive || explicitShowDepth > 0 || isHandlingUserInput() {
+            return true
+        }
+        let allowed = ProcessInfo.processInfo.systemUptime - lastExplicitShowEnd < explicitActivationGrace
+        if !allowed {
+            os_log("refused to take focus by itself", log: focusLog, type: .default)
+        }
+        return allowed
+    }
+
+    private static let focusLog = OSLog(subsystem: "com.omniterm.app", category: "focus")
+
+    private let anyWindowVisible: () -> Bool
+    private let appIsActive: () -> Bool
+    private let apply: (NSApplication.ActivationPolicy) -> Void
+    @objc private(set) var policy: NSApplication.ActivationPolicy
+    // Until launch has put every window away, restoration may briefly show
+    // one; that must not bring up the Dock icon.
+    @objc private(set) var isStarted = false
+    private var observers: [NSObjectProtocol] = []
+
+    @objc init(policy: NSApplication.ActivationPolicy,
+               anyWindowVisible: @escaping () -> Bool,
+               appIsActive: @escaping () -> Bool,
+               apply: @escaping (NSApplication.ActivationPolicy) -> Void) {
+        self.policy = policy
+        self.anyWindowVisible = anyWindowVisible
+        self.appIsActive = appIsActive
+        self.apply = apply
+        super.init()
+    }
+
+    deinit {
+        observers.forEach { NotificationCenter.default.removeObserver($0) }
+    }
+
+    // Window ordering changes post no notification of their own, so reconcile
+    // after every event as well as on the window and app notifications.
+    @objc func startObserving() {
+        startWithoutObserving()
+        let center = NotificationCenter.default
+        let immediate: [Notification.Name] = [
+            NSApplication.didUpdateNotification,
+            NSApplication.didBecomeActiveNotification,
+            NSApplication.didHideNotification,
+            NSApplication.didUnhideNotification,
+            NSWindow.didMiniaturizeNotification,
+            NSWindow.didDeminiaturizeNotification,
+        ]
+        for name in immediate {
+            observers.append(center.addObserver(forName: name, object: nil, queue: nil) { [weak self] _ in
+                self?.reconcile()
+            })
+        }
+        // The window is still on screen when this posts.
+        observers.append(center.addObserver(forName: NSWindow.willCloseNotification,
+                                            object: nil,
+                                            queue: nil) { [weak self] _ in
+            DispatchQueue.main.async {
+                self?.reconcile()
+            }
+        })
+    }
+
+    @objc func startWithoutObserving() {
+        isStarted = true
+        reconcile()
+    }
+
+    @objc func reconcile() {
+        reconcile(appActive: appIsActive())
+    }
+
+    // For a show the user asked for, before the app activates, so that it
+    // activates as a regular app with its own menu bar.
+    @objc func reconcileShowingWindow() {
+        reconcile(appActive: true)
+    }
+
+    private func reconcile(appActive: Bool) {
+        guard isStarted else {
+            return
+        }
+        let wanted = Self.policy(anyWindowVisible: anyWindowVisible(),
+                                 appActive: appActive,
+                                 current: policy)
+        guard wanted != policy else {
+            return
+        }
+        policy = wanted
+        apply(wanted)
+    }
+}
diff --git a/sources/OmniTerm/OmniFocusZone.swift b/sources/OmniTerm/OmniFocusZone.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3d97b562a3f72f6f8a827b74961ba8ba6d6424be
--- /dev/null
+++ b/sources/OmniTerm/OmniFocusZone.swift
@@ -0,0 +1,351 @@
+import AppKit
+import Foundation
+
+// How a zone hands the keyboard back.
+enum OmniZoneExit {
+    // Left at the zone's left edge, or Escape: back where focus came from.
+    case back
+    // Tab and Shift-Tab: the page's next or previous zone.
+    case next
+    case previous
+}
+
+// A keyboard zone of a page: a list or a row of buttons the arrow keys move
+// through. The content host enters zones and moves between them; a zone
+// handles its own keys and calls `zoneExit` to leave.
+protocol OmniFocusZone: AnyObject {
+    // The view that holds keyboard focus while the zone is active.
+    var zoneFirstResponder: NSView { get }
+    var zoneExit: ((OmniZoneExit) -> Void)? { get set }
+    // False while the zone has nothing to focus (hidden, empty, loading).
+    var zoneCanEnter: Bool { get }
+    // Takes keyboard focus, selecting the first item if none is selected.
+    func zoneEnter()
+    // A key while the zone has focus; false leaves it to the window.
+    func zoneHandleKey(_ event: NSEvent) -> Bool
+}
+
+// The window focuses the session of every tab it selects. While the keyboard
+// is in the sidebar or on a page, a tab selected from there must not take it,
+// so the sidebar and the zones refuse to give up focus during a hold.
+enum OmniFocusHold {
+    private static var depth = 0
+
+    static var isHolding: Bool {
+        return depth > 0
+    }
+
+    static func during(_ body: () -> Void) {
+        depth += 1
+        defer { depth -= 1 }
+        body()
+    }
+}
+
+// The keys zones share. Arrows carry the numeric pad and function flags,
+// which say nothing about what was pressed.
+enum OmniZoneKey {
+    case up
+    case down
+    case left
+    case right
+    case activate
+    case space
+    case back
+    case next
+    case previous
+    case other
+
+    init(_ event: NSEvent) {
+        let flags = event.modifierFlags.intersection([.command, .option, .control, .shift])
+        let plain = flags.isEmpty
+        switch event.keyCode {
+        case 126 where plain: self = .up
+        case 125 where plain: self = .down
+        case 123 where plain: self = .left
+        case 124 where plain: self = .right
+        case 36 where plain, 76 where plain: self = .activate
+        case 49 where plain: self = .space
+        case 53 where plain: self = .back
+        case 48 where plain: self = .next
+        case 48 where flags == .shift: self = .previous
+        default: self = .other
+        }
+    }
+}
+
+// A transparent view laid over a zone's content. It takes the keyboard for
+// the zone and draws its focus ring; clicks go through to the content.
+class OmniZoneOverlay: NSView, OmniFocusZone {
+    var zoneExit: ((OmniZoneExit) -> Void)?
+    // Called when the zone gains or loses keyboard focus.
+    var focusDidChange: ((Bool) -> Void)?
+
+    override var isFlipped: Bool { true }
+    override var acceptsFirstResponder: Bool { true }
+    override var canBecomeKeyView: Bool { false }
+
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        focusRingType = .exterior
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func hitTest(_ point: NSPoint) -> NSView? {
+        return nil
+    }
+
+    var zoneFirstResponder: NSView {
+        return self
+    }
+
+    var hasKeyboardFocus: Bool {
+        return window?.firstResponder === self
+    }
+
+    var zoneCanEnter: Bool {
+        return window != nil && !isHiddenOrHasHiddenAncestor
+    }
+
+    func zoneEnter() {
+        window?.makeFirstResponder(self)
+    }
+
+    func zoneHandleKey(_ event: NSEvent) -> Bool {
+        switch OmniZoneKey(event) {
+        case .back:
+            zoneExit?(.back)
+        case .next:
+            zoneExit?(.next)
+        case .previous:
+            zoneExit?(.previous)
+        default:
+            return false
+        }
+        return true
+    }
+
+    // Where the ring goes, in this view's coordinates.
+    var ringRect: NSRect {
+        return bounds.insetBy(dx: 1, dy: 1)
+    }
+
+    override var focusRingMaskBounds: NSRect {
+        return ringRect
+    }
+
+    override func drawFocusRingMask() {
+        NSBezierPath(roundedRect: ringRect, xRadius: 6, yRadius: 6).fill()
+    }
+
+    override func becomeFirstResponder() -> Bool {
+        let became = super.becomeFirstResponder()
+        if became {
+            focusChanged()
+        }
+        return became
+    }
+
+    override func resignFirstResponder() -> Bool {
+        if OmniFocusHold.isHolding {
+            return false
+        }
+        let resigned = super.resignFirstResponder()
+        if resigned {
+            DispatchQueue.main.async { [weak self] in
+                self?.focusChanged()
+            }
+        }
+        return resigned
+    }
+
+    func focusChanged() {
+        noteFocusRingMaskChanged()
+        needsDisplay = true
+        focusDidChange?(hasKeyboardFocus)
+    }
+
+    // Keys that reach the view directly (outside the terminal window's
+    // routing, as in the Inbox).
+    override func keyDown(with event: NSEvent) {
+        if !zoneHandleKey(event) {
+            super.keyDown(with: event)
+        }
+    }
+}
+
+// A row a list zone selects: it draws its selection, stronger while the
+// zone has keyboard focus, and does its action when activated.
+protocol OmniZoneItem: NSView {
+    var isSelected: Bool { get set }
+    var zoneHasFocus: Bool { get set }
+    func activate()
+}
+
+// A list of rows the arrow keys move through. Rows are keyed so the
+// selection survives a rebuild of the list.
+final class OmniListZone: OmniZoneOverlay {
+    private var items: [(key: String, view: OmniZoneItem)] = []
+    private(set) var selectedKey: String?
+    // Up or Down moved the selection.
+    var selectionDidChange: ((String) -> Void)?
+    // Return on the selected row; without it the row activates itself.
+    var activateItem: ((String) -> Void)?
+
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        focusDidChange = { [weak self] focused in
+            self?.items.forEach { $0.view.zoneHasFocus = focused }
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    var keys: [String] {
+        return items.map(\.key)
+    }
+
+    // Replaces the rows; the selection follows its key, or `selected`.
+    func setItems(_ items: [(key: String, view: OmniZoneItem)], selected: String? = nil) {
+        self.items = items
+        let wanted = selected ?? selectedKey
+        selectedKey = items.contains { $0.key == wanted } ? wanted : nil
+        applySelection()
+    }
+
+    func select(_ key: String) {
+        guard items.contains(where: { $0.key == key }) else { return }
+        selectedKey = key
+        applySelection()
+    }
+
+    override var zoneCanEnter: Bool {
+        return super.zoneCanEnter && !items.isEmpty
+    }
+
+    override func zoneEnter() {
+        if selectedKey == nil, let first = items.first {
+            move(to: first.key)
+        }
+        super.zoneEnter()
+        scrollSelectionToVisible()
+    }
+
+    override func zoneHandleKey(_ event: NSEvent) -> Bool {
+        switch OmniZoneKey(event) {
+        case .up:
+            step(-1)
+        case .down:
+            step(1)
+        case .activate:
+            guard let key = selectedKey else { return true }
+            if let activateItem {
+                activateItem(key)
+            } else {
+                items.first { $0.key == key }?.view.activate()
+            }
+        case .left:
+            zoneExit?(.back)
+        case .right:
+            // Nothing lies right of a list; the key must not reach a terminal.
+            break
+        default:
+            return super.zoneHandleKey(event)
+        }
+        return true
+    }
+
+    private func step(_ delta: Int) {
+        guard !items.isEmpty else { return }
+        let current = items.firstIndex { $0.key == selectedKey }
+        let target = current.map { min(max(0, $0 + delta), items.count - 1) } ?? 0
+        guard items[target].key != selectedKey else { return }
+        move(to: items[target].key)
+        scrollSelectionToVisible()
+    }
+
+    private func move(to key: String) {
+        selectedKey = key
+        applySelection()
+        selectionDidChange?(key)
+    }
+
+    private func applySelection() {
+        let focused = hasKeyboardFocus
+        for item in items {
+            item.view.isSelected = item.key == selectedKey
+            item.view.zoneHasFocus = focused
+        }
+    }
+
+    private func scrollSelectionToVisible() {
+        guard let view = items.first(where: { $0.key == selectedKey })?.view else { return }
+        view.scrollToVisible(view.bounds)
+    }
+}
+
+// A row of buttons Left and Right move through; Return or Space presses the
+// selected one. The ring marks the selected button.
+final class OmniButtonZone: OmniZoneOverlay {
+    // The buttons in order; hidden and disabled ones are skipped.
+    var buttons: () -> [NSButton] = { [] }
+    private var selectedIndex = 0
+    // Up and Down; without it they are kept from the terminal and do nothing.
+    var verticalKey: ((Int) -> Void)?
+
+    private var usable: [NSButton] {
+        return buttons().filter { !$0.isHiddenOrHasHiddenAncestor && $0.isEnabled }
+    }
+
+    var selectedButton: NSButton? {
+        let usable = self.usable
+        guard !usable.isEmpty else { return nil }
+        return usable[min(selectedIndex, usable.count - 1)]
+    }
+
+    override var zoneCanEnter: Bool {
+        return super.zoneCanEnter && !usable.isEmpty
+    }
+
+    override func zoneEnter() {
+        selectedIndex = 0
+        super.zoneEnter()
+        noteFocusRingMaskChanged()
+    }
+
+    override func zoneHandleKey(_ event: NSEvent) -> Bool {
+        let count = usable.count
+        selectedIndex = min(selectedIndex, max(0, count - 1))
+        switch OmniZoneKey(event) {
+        case .left:
+            if selectedIndex == 0 {
+                zoneExit?(.back)
+            } else {
+                selectedIndex -= 1
+            }
+        case .right:
+            selectedIndex = min(selectedIndex + 1, max(0, count - 1))
+        case .activate, .space:
+            selectedButton?.performClick(nil)
+        case .up:
+            verticalKey?(-1)
+        case .down:
+            verticalKey?(1)
+        default:
+            return super.zoneHandleKey(event)
+        }
+        noteFocusRingMaskChanged()
+        needsDisplay = true
+        return true
+    }
+
+    override var ringRect: NSRect {
+        guard let button = selectedButton else { return super.ringRect }
+        return convert(button.bounds, from: button).insetBy(dx: 2, dy: 2)
+    }
+}
diff --git a/sources/OmniTerm/OmniInboxWindowController.swift b/sources/OmniTerm/OmniInboxWindowController.swift
new file mode 100644
index 0000000000000000000000000000000000000000..ab21fe8d4672b1a514aa5550d5173ffdfff99be3
--- /dev/null
+++ b/sources/OmniTerm/OmniInboxWindowController.swift
@@ -0,0 +1,1272 @@
+import AppKit
+import Foundation
+
+// One stored agent notification, as returned by the scheduler's
+// `notifications` operation. Every text field is untrusted: it is displayed as
+// plain text, links are not opened, and nothing is executed.
+struct OmniNotificationItem {
+    let id: String
+    let title: String
+    let body: String
+    let severity: String
+    let agent: String?
+    let runID: String?
+    let workspace: String?
+    let unread: Bool
+    let updated: Date
+    let diffState: String?
+    let diffFiles: [String]
+    let suppressed: Int
+    // What produced it: `agent`, or one of OmniTerm's own kinds.
+    let kind: String
+
+    init?(_ dictionary: [AnyHashable: Any]) {
+        guard let id = dictionary["id"] as? String,
+              let title = dictionary["title"] as? String else {
+            return nil
+        }
+        self.id = id
+        self.title = title
+        body = dictionary["body"] as? String ?? ""
+        severity = dictionary["severity"] as? String ?? "info"
+        kind = dictionary["kind"] as? String ?? "agent"
+        agent = dictionary["agent"] as? String
+        runID = dictionary["run_id"] as? String
+        workspace = dictionary["workspace"] as? String
+        unread = (dictionary["unread"] as? NSNumber)?.boolValue ?? false
+        updated = Date(timeIntervalSince1970: (dictionary["updated"] as? NSNumber)?.doubleValue ?? 0)
+        diffState = dictionary["diff_state"] as? String
+        diffFiles = dictionary["diff_files"] as? [String] ?? []
+        suppressed = (dictionary["suppressed"] as? NSNumber)?.intValue ?? 0
+    }
+
+    // Severity is never carried by colour alone: menus use this marker and
+    // the Inbox spells the severity out.
+    var severityMarker: String {
+        switch severity {
+        case "urgent": return "‼"
+        case "attention": return "•"
+        default: return "·"
+        }
+    }
+
+    var severityName: String {
+        switch severity {
+        case "urgent": return "Urgent"
+        case "attention": return "Needs attention"
+        default: return "Info"
+        }
+    }
+
+    // The main window's status colours: red went wrong, orange waits for you.
+    var severityColor: NSColor {
+        switch severity {
+        case "urgent": return OmniTheme.failed
+        case "attention": return OmniTheme.waiting
+        default: return OmniTheme.ended
+        }
+    }
+
+    var source: String {
+        return agent ?? "Manual"
+    }
+
+    var age: String {
+        // A notification stored a moment ago must never read as being in the future.
+        return OmniSchedulerClient.relativeFormatter.localizedString(for: min(updated, Date()), relativeTo: Date())
+    }
+
+    var hasDiff: Bool {
+        return diffState == "captured" || diffState == "truncated"
+    }
+}
+
+enum OmniSchedulerClient {
+    // Unit tests answer requests here instead of the app's scheduler.
+    static var testTransport: (([String: Any], @escaping ([AnyHashable: Any]) -> Void) -> Void)?
+
+    static func request(_ request: [String: Any], completion: @escaping ([AnyHashable: Any]) -> Void) {
+        if let testTransport {
+            testTransport(request, completion)
+            return
+        }
+        guard let delegate = NSApp.delegate as? iTermApplicationDelegate else {
+            completion(["ok": false, "error": "The OmniTerm scheduler is not running"])
+            return
+        }
+        delegate.omniSchedulerRequest(request) { response in
+            completion(response ?? [:])
+        }
+    }
+
+    static var chromeColor: NSColor { OmniTheme.accent }
+    static var charcoal: NSColor { OmniTheme.onAccent }
+
+    static let relativeFormatter: RelativeDateTimeFormatter = {
+        let formatter = RelativeDateTimeFormatter()
+        formatter.unitsStyle = .short
+        return formatter
+    }()
+}
+
+private final class OmniInboxWindow: NSWindow {
+    // The Inbox's own shortcuts; true when one was handled.
+    var shortcutHandler: ((NSEvent) -> Bool)?
+
+    // OmniTerm never comes forward by itself: while another app is in front,
+    // only an explicit open may bring the Inbox on screen or raise it.
+    private var mayRaise: Bool {
+        OmniDockPresence.mayTakeFocus(appActive: NSApp.isActive)
+    }
+
+    override func makeKeyAndOrderFront(_ sender: Any?) {
+        guard mayRaise else { return }
+        super.makeKeyAndOrderFront(sender)
+    }
+
+    override func orderFront(_ sender: Any?) {
+        guard mayRaise else { return }
+        super.orderFront(sender)
+    }
+
+    override func orderFrontRegardless() {
+        guard mayRaise else { return }
+        super.orderFrontRegardless()
+    }
+
+    override func order(_ place: NSWindow.OrderingMode, relativeTo otherWin: Int) {
+        guard place == .out || mayRaise else { return }
+        super.order(place, relativeTo: otherWin)
+    }
+
+    // Escape closes the Inbox. The terminal's double-Escape hide only applies
+    // to the terminal window.
+    override func cancelOperation(_ sender: Any?) {
+        performClose(sender)
+    }
+
+    // Command-W closes the Inbox. The main menu's Close item acts on terminal
+    // sessions only, so the window handles the shortcut itself.
+    override func performKeyEquivalent(with event: NSEvent) -> Bool {
+        let modifiers = event.modifierFlags.intersection(.deviceIndependentFlagsMask)
+        if modifiers == .command, event.charactersIgnoringModifiers?.lowercased() == "w" {
+            performClose(nil)
+            return true
+        }
+        if shortcutHandler?(event) == true {
+            return true
+        }
+        return super.performKeyEquivalent(with: event)
+    }
+}
+
+// The notification list. Right, Return and Tab move into the detail; the
+// rest of the keys are the table's own.
+private final class OmniInboxTableView: NSTableView {
+
+    // Rows open what they show: the pointing hand, not the arrow.
+    override func resetCursorRects() {
+        super.resetCursorRects()
+        addCursorRect(visibleRect, cursor: .pointingHand)
+    }
+    var keyHandler: ((NSEvent) -> Bool)?
+
+    // Right-click selects the clicked row, then asks for its menu.
+    var contextMenu: ((Int) -> NSMenu?)?
+
+    override func menu(for event: NSEvent) -> NSMenu? {
+        let row = self.row(at: convert(event.locationInWindow, from: nil))
+        guard row >= 0, let contextMenu else { return super.menu(for: event) }
+        if !selectedRowIndexes.contains(row) {
+            selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+        }
+        return contextMenu(row) ?? super.menu(for: event)
+    }
+
+    override func keyDown(with event: NSEvent) {
+        if keyHandler?(event) == true {
+            return
+        }
+        super.keyDown(with: event)
+    }
+}
+
+// A view that reports every size change, so frames can be computed from the
+// live size instead of autoresizing masks set before the first layout.
+final class OmniResizingView: NSView {
+    var didResize: ((NSSize) -> Void)? {
+        didSet { needsLayout = true }
+    }
+    var fillColor: NSColor?
+    var drawsBottomSeparator = false
+
+    override var isFlipped: Bool { true }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        didResize?(bounds.size)
+    }
+
+    // The first pass is not a resize, so lay out here too.
+    override func layout() {
+        super.layout()
+        didResize?(bounds.size)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        if let fillColor {
+            fillColor.setFill()
+            dirtyRect.fill()
+        }
+        if drawsBottomSeparator {
+            NSColor.separatorColor.setFill()
+            NSRect(x: 0, y: bounds.height - 1, width: bounds.width, height: 1).fill()
+        }
+    }
+}
+
+// A separate, non-terminal window for reading agent notifications and the
+// diffs captured with them. It stays out of the single-terminal-window logic.
+// Its content is an OmniInboxViewController, which a pane can host as well.
+@objc(OmniInboxWindowController)
+final class OmniInboxWindowController: NSWindowController, NSWindowDelegate {
+    @objc(sharedInstance) static let shared = OmniInboxWindowController()
+
+    let inbox = OmniInboxViewController()
+
+    private init() {
+        let window = OmniInboxWindow(contentRect: NSRect(x: 0, y: 0, width: 1040, height: 680),
+                                     styleMask: [.titled, .closable, .resizable, .miniaturizable],
+                                     backing: .buffered,
+                                     defer: false)
+        window.title = "OMNI · Inbox"
+        // Mouse moves reach OmniPointer's watcher, for the pointing hand.
+        window.acceptsMouseMovedEvents = true
+        // The filters bar has the title bar's colour; a hairline parts them.
+        OmniTheme.applyTitlebarSeparator(to: window)
+        window.isReleasedWhenClosed = false
+        window.isRestorable = false
+        window.isExcludedFromWindowsMenu = true
+        window.collectionBehavior = [.moveToActiveSpace]
+        window.minSize = NSSize(width: 760, height: 460)
+        super.init(window: window)
+        window.delegate = self
+        window.contentViewController = inbox
+        window.setContentSize(NSSize(width: 1040, height: 680))
+        inbox.summaryDidChange = { [weak window] summary in
+            window?.subtitle = summary
+        }
+        window.shortcutHandler = { [weak self] event in self?.inbox.handleShortcut(event) ?? false }
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    @objc(showSelecting:) func show(selecting identifier: String?) {
+        inbox.select(identifier)
+        guard let window, OmniDockPresence.mayTakeFocus(appActive: NSApp.isActive) else { return }
+        if !window.isVisible {
+            window.center()
+        }
+        // Not an explicit show by itself: an agent may ask for the Inbox, and
+        // that must not take focus. A click or the shortcut already counts.
+        NSApp.unhide(nil)
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+    }
+
+    @objc func showInbox(_ sender: Any?) {
+        show(selecting: nil)
+    }
+
+    func reload() {
+        inbox.reload()
+    }
+
+    // The run report colours its diff the same way.
+    static func colouredDiff(_ diff: String, font: NSFont) -> NSAttributedString {
+        return OmniInboxViewController.colouredDiff(diff, font: font)
+    }
+
+    func windowWillClose(_ notification: Notification) {
+        inbox.clearPendingSelection()
+    }
+}
