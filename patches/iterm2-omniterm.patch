@@ -0,0 +1,70 @@
+//
+//  OmniSidebarOrderingTests.swift
+//  ModernTests
+//
+//  `omni agents order` through the native sidebar model: agent slots move
+//  within each parent; groups, memberships and unnamed agents stay put.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniSidebarOrderingTests: XCTestCase {
+    private func order(_ agents: [(String, String?)], configured: [String] = [], saved: [String] = [],
+                       names: [String], file: StaticString = #filePath, line: UInt = #line) -> [String] {
+        let result = OmniSidebarOrdering.order(agents: agents.map { ["name": $0.0, "group": $0.1 ?? ""] },
+                                               configuredGroups: configured, savedOrder: saved, names: names)
+        // What is saved is exactly what the sidebar's own tree shows.
+        let shown = OmniGroupTree(agents: agents.map { (name: $0.0, group: $0.1) }, configured: configured,
+                                  order: result).displayKeys
+        XCTAssertEqual(shown, result, "The sidebar would show a different order", file: file, line: line)
+        return result
+    }
+
+    func testSavedOrderKeepsGroupSlotsAndMovesOnlyNamedAgents() {
+        let result = order([("Review", nil), ("Alpha", nil), ("Beta", nil), ("Grouped", "Work")],
+                           configured: ["Work"],
+                           saved: ["agent:Review", "group:Work", "agent:Grouped", "agent:Alpha", "agent:Beta"],
+                           names: ["Beta", "Review"])
+        XCTAssertEqual(result, ["agent:Beta", "group:Work", "agent:Grouped", "agent:Review", "agent:Alpha"])
+    }
+
+    func testEmptySavedOrderStartsFromTheSidebarFallback() {
+        // Fallback: groups first, then agents alphabetically.
+        let result = order([("Charlie", nil), ("Alpha", nil), ("Bravo", nil), ("Inner", "Ops")], names: ["Charlie"])
+        XCTAssertEqual(result, ["group:Ops", "agent:Inner", "agent:Charlie", "agent:Alpha", "agent:Bravo"])
+    }
+
+    func testAgentsMissingFromTheSavedOrderAreOrderedWhereTheSidebarShowsThem() {
+        let result = order([("Alpha", nil), ("Bravo", nil), ("Zulu", nil)], saved: ["agent:Bravo", "agent:Alpha"],
+                           names: ["Zulu"])
+        XCTAssertEqual(result, ["agent:Zulu", "agent:Bravo", "agent:Alpha"])
+    }
+
+    func testNestedAgentsReorderWithinTheirOwnFolder() {
+        let result = order([("A1", "Ops/Deep"), ("A2", "Ops/Deep"), ("Top", "Ops"), ("Loose", nil)],
+                           configured: ["Ops", "Ops/Deep"], names: ["A2", "Loose", "Top"])
+        XCTAssertEqual(result, ["group:Ops", "group:Ops/Deep", "agent:A2", "agent:A1", "agent:Top", "agent:Loose"])
+    }
+
+    func testDuplicateAndUnknownNamesAreIgnored() {
+        let result = order([("Alpha", nil), ("Bravo", nil)], saved: ["agent:Alpha", "agent:Bravo"],
+                           names: ["Ghost", "Bravo", "Bravo"])
+        XCTAssertEqual(result, ["agent:Bravo", "agent:Alpha"])
+        XCTAssertEqual(order([("Alpha", nil)], names: []), ["agent:Alpha"])
+    }
+
+    func testEmptyFoldersAndTheirImplicitParentsKeepTheirSlots() {
+        let result = order([("Zed", nil), ("Loose", nil)], configured: ["Empty", "Ops/Deep"],
+                           saved: ["agent:Zed", "group:Empty", "group:Ops", "group:Ops/Deep", "agent:Loose"],
+                           names: ["Loose"])
+        XCTAssertEqual(result, ["agent:Loose", "group:Empty", "group:Ops", "group:Ops/Deep", "agent:Zed"])
+    }
+
+    func testFallbackSortsNaturallyAndNamesAreTakenLiterally() {
+        XCTAssertEqual(order([("Agent10", nil), ("Agent2", nil), ("Agent1", nil)], names: []),
+                       ["agent:Agent1", "agent:Agent2", "agent:Agent10"])
+        let result = order([("Agent10", nil), ("Agent2", nil), ("agent:Odd", nil)], names: ["agent:Odd", "Odd"])
+        XCTAssertEqual(result, ["agent:agent:Odd", "agent:Agent2", "agent:Agent10"])
+    }
+}
