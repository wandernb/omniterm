+        return @{ @"ok": @YES };
+    }
+    NSDictionary *runReportResponse = [self handleRunReportRequest:request operation:operation];
+    if (runReportResponse) {
+        return runReportResponse;
+    }
+    NSDictionary *notificationResponse = [self handleNotificationRequest:request operation:operation];
+    if (notificationResponse) {
+        return notificationResponse;
+    }
+    if ([operation isEqualToString:@"stop_run"]) {
+        NSArray *rows = [self rowsForSQL:@"SELECT pgid FROM runs WHERE id=? AND state IN ('starting','running')" bindings:@[ request[@"run_id"] ?: @"" ]];
+        const pid_t processGroup = (pid_t)OmniIntegerValue([(NSDictionary *)rows.firstObject objectForKey:@"pgid"]);
+        if (processGroup > 1) kill(-processGroup, SIGTERM);
+        return @{ @"ok": @(rows.count > 0) };
+    }
+    return @{ @"ok": @NO, @"error": @"Unknown operation" };
+}
