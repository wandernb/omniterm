+        [self runSQL:update bindings:@[ @"queued", run[@"id"] ]];
+        void (^acknowledge)(BOOL) = ^(BOOL delivered) {
+            dispatch_async(_queue, ^{
+                NSString *acknowledge = [update stringByAppendingFormat:@" AND %@='queued'", column];
