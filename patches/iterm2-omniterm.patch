+- (void)testRunWhoseRunnerDiedIsInterruptedOrCompletedButLiveRunnerIsKept {
+    [self startSchedulerWithAgentTimeout:@7200];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    const pid_t exited = [self exitedProcessIdentifier];
+    [self insertRun:@"dead" state:@"running" started:now pid:@(exited)];
+    [self insertRun:@"finished" state:@"running" started:now pid:@(exited)];
+    [_scheduler runSQL:@"UPDATE runs SET turn_finished=1 WHERE id='finished'" bindings:@[]];
+    [self insertRun:@"alive" state:@"running" started:now pid:@(getpid())];
+
+    [_scheduler reapAbandonedRuns];
+
+    // A lost runner is not a failure: the agent either finished its turn or was interrupted.
+    XCTAssertEqualObjects([self stateOfRun:@"dead"], @"interrupted");
+    XCTAssertEqualObjects([self stateOfRun:@"finished"], @"completed");
+    XCTAssertEqualObjects([self stateOfRun:@"alive"], @"running");
+}
