+// One audit entry in full, over the window: what happened, the goal, the
+// session (a link to its page), and the facts. Escape, Close or a click
+// outside the card closes it.
+final class OmniAuditEntryView: NSView {
+    private let card = OmniAuditCard()
+    private let openSession: (String) -> Void
+    let sessionID: String?
+    private let text = NSTextView()
+    private let scroll = NSScrollView()
+    private let titleLabel = NSTextField(labelWithString: "")
+    private let sessionButton: NSButton
+    private let closeButton: NSButton
+
+    override var isFlipped: Bool { true }
+    override var acceptsFirstResponder: Bool { true }
+
+    init(entry: [String: Any], now: Date, openSession: @escaping (String) -> Void) {
+        self.openSession = openSession
+        sessionID = entry["session_id"] as? String
+        sessionButton = OmniTheme.button("Open Session", target: nil, action: nil)
+        closeButton = OmniTheme.button("Close", target: nil, action: nil)
+        super.init(frame: .zero)
+        wantsLayer = true
+        layer?.backgroundColor = NSColor.black.withAlphaComponent(0.3).cgColor
+        card.wantsLayer = true
+        card.layer?.cornerRadius = 12
+        card.layer?.masksToBounds = true
+        card.layer?.borderWidth = 1
+        card.layer?.borderColor = OmniTheme.cardBorder.cgColor
+        let blur = NSVisualEffectView()
+        blur.material = .popover
+        blur.blendingMode = .withinWindow
+        blur.state = .active
+        card.addSubview(blur)
+        titleLabel.stringValue = OmniUnblockerModel.title(for: entry, now: now)
+        titleLabel.font = OmniTheme.Font.subtitle
+        titleLabel.lineBreakMode = .byTruncatingTail
+        card.addSubview(titleLabel)
+        text.isEditable = false
+        text.drawsBackground = false
+        text.textContainerInset = NSSize(width: 2, height: 4)
+        text.textStorage?.setAttributedString(Self.body(entry))
+        text.isVerticallyResizable = true
+        text.autoresizingMask = [.width]
+        scroll.documentView = text
+        scroll.drawsBackground = false
+        scroll.hasVerticalScroller = true
+        scroll.autohidesScrollers = true
+        card.addSubview(scroll)
+        sessionButton.target = self
+        sessionButton.action = #selector(openSessionClicked(_:))
+        sessionButton.isEnabled = sessionID != nil
+        card.addSubview(sessionButton)
+        closeButton.target = self
+        closeButton.action = #selector(close(_:))
+        closeButton.keyEquivalent = "\u{1b}"
+        card.addSubview(closeButton)
+        addSubview(card)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    // What the person reads: the outcome's reason, the goal, then the facts.
+    static func body(_ entry: [String: Any]) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        let heading: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.sectionHeader, .foregroundColor: OmniTheme.secondaryText]
+        let body: [NSAttributedString.Key: Any] = [.font: OmniTheme.Font.body, .foregroundColor: NSColor.labelColor]
+        func add(_ title: String, _ value: String) {
+            guard !value.isEmpty else { return }
+            result.append(NSAttributedString(string: title.uppercased() + "\n", attributes: heading))
+            result.append(NSAttributedString(string: OmniReportText.sanitized(value) + "\n\n", attributes: body))
+        }
+        add("What happened", entry["detail"] as? String ?? "")
+        add("Goal", entry["goal"] as? String ?? "")
+        var facts: [String] = []
+        facts.append("Outcome: " + OmniUnblockerModel.outcomeTitle(entry["outcome"] as? String ?? ""))
+        if let session = entry["session_id"] as? String { facts.append("Session: " + session) }
+        if let cwd = entry["cwd"] as? String { facts.append("Folder: " + OmniProjectsModel.abbreviated(cwd)) }
+        if let kind = entry["kind"] as? String { facts.append("Waiting on: " + kind) }
+        if let tier = entry["tier"] as? String { facts.append("Decided by: " + OmniUnblockerModel.tierTitle(tier)) }
+        if let model = entry["model"] as? String { facts.append("Model: " + model) }
+        if let screen = entry["screen"] as? String { facts.append("Screening: " + screen) }
+        if let seconds = (entry["seconds"] as? NSNumber)?.doubleValue { facts.append(String(format: "Took: %.0f s", seconds)) }
+        add("Details", facts.joined(separator: "\n"))
+        return result
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let width = min(640, bounds.width - 40)
+        let height = min(520, bounds.height - 80)
+        card.frame = NSRect(x: (bounds.width - width) / 2, y: max(40, (bounds.height - height) / 3), width: width, height: height)
+        card.subviews.first?.frame = card.bounds
+        titleLabel.frame = NSRect(x: 20, y: 18, width: width - 40, height: 22)
+        scroll.frame = NSRect(x: 18, y: 50, width: width - 36, height: height - 50 - 56)
+        text.frame = NSRect(x: 0, y: 0, width: scroll.contentSize.width, height: max(scroll.contentSize.height, text.frame.height))
+        text.textContainer?.containerSize = NSSize(width: scroll.contentSize.width, height: .greatestFiniteMagnitude)
+        closeButton.sizeToFit()
+        sessionButton.sizeToFit()
+        closeButton.frame = NSRect(x: width - 20 - closeButton.frame.width - 8, y: height - 42, width: closeButton.frame.width + 8, height: 28)
+        sessionButton.frame = NSRect(x: closeButton.frame.minX - sessionButton.frame.width - 18, y: height - 42,
+                                     width: sessionButton.frame.width + 8, height: 28)
+    }
+
+    override func mouseDown(with event: NSEvent) {
+        if !card.frame.contains(convert(event.locationInWindow, from: nil)) {
+            removeFromSuperview()
+        }
+    }
+
+    override func cancelOperation(_ sender: Any?) {
+        removeFromSuperview()
+    }
+
+    @objc private func close(_ sender: Any?) {
+        removeFromSuperview()
+    }
+
+    @objc func openSessionClicked(_ sender: Any?) {
+        guard let sessionID else { return }
+        removeFromSuperview()
+        openSession(sessionID)
+    }
+}
+
+private final class OmniAuditCard: NSView {
+    override var isFlipped: Bool { true }
+}
