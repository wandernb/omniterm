+    // A mind-map topic leaf is `topic:<n>:<memory id>`, since the memory also
+    // appears under its type.
+    static func memoryID(forGraphNode id: String) -> String {
+        let parts = id.split(separator: ":", maxSplits: 2, omittingEmptySubsequences: false)
+        guard parts.count == 3, parts[0] == "topic", Int(parts[1]) != nil, !parts[2].isEmpty else { return id }
+        return String(parts[2])
+    }
