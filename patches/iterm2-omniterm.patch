+        NSDictionary *created = [self request:@{ @"op": @"create_agent", @"agent": template }];
+        XCTAssertEqualObjects(created[@"agent"][@"name"], trimmed, @"create accepts %@", value);
+        XCTAssertEqualObjects(([self request:@{ @"op": @"save_agent", @"agent": template }][@"ok"]), @YES, @"save accepts %@", value);
+        XCTAssertNotNil([self agentFileNamed:trimmed]);
+        [self request:@{ @"op": @"delete_agent", @"name": trimmed }];
+    }
+    for (id value in fixture[@"name"][@"invalid"]) {
+        NSDictionary *response = [self request:@{ @"op": @"rename_agent", @"name": @"Review", @"new_name": value }];
+        XCTAssertEqualObjects(response[@"code"], @"invalid_name", @"%@ should be an invalid name", value);
+        template[@"name"] = value;
+        XCTAssertEqualObjects(([self request:@{ @"op": @"create_agent", @"agent": template }][@"code"]), @"invalid_name", @"create refuses %@", value);
+        XCTAssertEqualObjects(([self request:@{ @"op": @"save_agent", @"agent": template }][@"code"]), @"invalid_name", @"save refuses %@", value);
+    }
+}
