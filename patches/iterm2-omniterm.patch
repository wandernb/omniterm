+        let fixture = TerminalWindowTestFixture()
+        defer { fixture.close() }
+        let terminalSidebar = try XCTUnwrap(fixture.terminal.omniSidebarForTesting() as? OmniSidebarViewController)
+        let resumed = session("claude:4f7e2c1a-resume", title: "Resume me", workspace: folder.path)
+        XCTAssertNil(terminalSidebar.paneResumeSession(resumed))
+        let marker = folder.appendingPathComponent("resumed").path
