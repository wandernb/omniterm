+    NSArray *initial = @[ @"agent:Review", @"agent:Alpha" ];
+    XCTAssertEqualObjects(([self request:@{ @"op": @"set_sidebar_order", @"items": initial }][@"ok"]), @YES);
+
+    for (id names in @[ @"Alpha", @[ @1 ], @[ @"" ] ]) {
+        NSDictionary *response = [self request:@{ @"op": @"set_sidebar_agent_order", @"names": names }];
+        XCTAssertEqualObjects(response[@"ok"], @NO);
+        XCTAssertEqualObjects(response[@"code"], @"invalid_name");
+    }
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"], initial, @"Invalid input writes nothing");
+
+    id legacyBefore = [_scheduler settings][@"sidebar_agent_order"];
+    NSString *directory = [[_scheduler valueForKey:@"settingsPath"] stringByDeletingLastPathComponent];
+    NSDictionary *before = [[NSFileManager defaultManager] attributesOfItemAtPath:directory error:nil];
+    XCTAssertTrue([[NSFileManager defaultManager] setAttributes:@{ NSFilePosixPermissions: @0555 } ofItemAtPath:directory error:nil]);
+    NSDictionary *failed = [self request:@{ @"op": @"set_sidebar_agent_order", @"names": @[ @"Alpha" ] }];
+    [[NSFileManager defaultManager] setAttributes:@{ NSFilePosixPermissions: before[NSFilePosixPermissions] ?: @0755 }
+                                     ofItemAtPath:directory
+                                            error:nil];
+    XCTAssertEqualObjects(failed[@"ok"], @NO);
+    XCTAssertEqualObjects(failed[@"code"], @"write_failed");
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"], initial, @"A failed save leaves the order");
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_agent_order"], legacyBefore);
+
+    NSDictionary *saved = [self request:@{ @"op": @"set_sidebar_agent_order", @"names": @[ @"Alpha" ] }];
+    XCTAssertEqualObjects(saved[@"ok"], @YES);
+    XCTAssertEqualObjects([_scheduler settings][@"sidebar_order"], (@[ @"agent:Alpha", @"agent:Review" ]));
+}
