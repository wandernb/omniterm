+    func testDraggingPansAndCommandScrollZoomsTheGraph() throws {
+        let view = OmniMemoryGraphView(frame: NSRect(x: 0, y: 0, width: 400, height: 300))
+        let window = NSWindow(contentRect: view.frame, styleMask: [.titled], backing: .buffered, defer: false)
