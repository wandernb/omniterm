+- (void)testNativeOwnedWorkerIndexesBothProvidersAndPersistsSourceLinkedMemory {
+    [self startKnowledgeIntegrationFixture];
+    NSData *original = [NSData dataWithContentsOfFile:[self integrationTranscriptPath]];
+    NSDictionary *ready = [self integrationKnowledgeRequest:@{ @"op": @"knowledge_status" }];
+    XCTAssertEqualObjects(ready[@"ok"], @YES);
+    XCTAssertEqualObjects(ready[@"status"][@"readthrough"], @YES);
+    NSSet *expectedSessionIDs = [NSSet setWithArray:@[ @"claude:5b55042e-4145-4dcc-967a-bca3c66267f9",
+                                                      @"codex:85797c81-7330-4cac-ae87-e6243ae320df" ]];
+    // This initial ingestion must come from the app-owned timer. Calling the
+    // private tick here would let a missing timer pass this regression test.
+    NSDictionary *catalog = [self integrationKnowledgeRequest:@{ @"op": @"list_sessions", @"limit": @10 }
+                                                         until:^BOOL(NSDictionary *response) {
+        NSArray *sessions = [response[@"sessions"] isKindOfClass:[NSArray class]] ? response[@"sessions"] : @[];
+        return [[NSSet setWithArray:[sessions valueForKey:@"session_id"]] isEqual:expectedSessionIDs];
+    }];
+    XCTAssertEqualObjects(catalog[@"ok"], @YES);
+    XCTAssertEqual([catalog[@"sessions"] count], 2u);
+    XCTAssertEqualObjects([NSSet setWithArray:[catalog[@"sessions"] valueForKey:@"session_id"]], expectedSessionIDs);
+    // A listed session's messages may still be indexing: reads no longer wait for it.
+    NSDictionary *matches = [self integrationKnowledgeRequest:@{ @"op": @"search_transcripts", @"query": @"concurrent readers", @"provider": @"codex" }
+                                                        until:^BOOL(NSDictionary *response) {
+        return [response[@"matches"] isKindOfClass:[NSArray class]] && [response[@"matches"] count] > 0;
+    }];
+    XCTAssertEqualObjects(matches[@"ok"], @YES);
+    XCTAssertEqual([matches[@"matches"] count], 1u);
+    XCTAssertEqualObjects([matches[@"matches"] firstObject][@"kind"], @"output");
+    XCTAssertEqualObjects([matches[@"matches"] firstObject][@"role"], @"tool");
+
+    NSDictionary *memory = [self createIntegrationMemoryFromTranscript];
+    XCTAssertEqualObjects(memory[@"id"], @"native-e2e-memory");
+    XCTAssertEqualObjects([memory[@"sources"] firstObject][@"available"], @YES);
+    NSDictionary *retrieved = [self integrationKnowledgeRequest:@{ @"op": @"search_memories", @"query": @"duplicate receipts" }];
+    XCTAssertEqualObjects([retrieved[@"memories"] firstObject][@"id"], @"native-e2e-memory");
+    XCTAssertEqualObjects([NSData dataWithContentsOfFile:[self integrationTranscriptPath]], original);
+    NSDictionary *databaseAttributes = [[NSFileManager defaultManager]
+        attributesOfItemAtPath:[[_knowledgeIntegrationScheduler valueForKey:@"supportPath"] stringByAppendingPathComponent:@"knowledge.sqlite"] error:nil];
+    XCTAssertEqual([databaseAttributes[NSFilePosixPermissions] unsignedShortValue] & 0777, 0600);
+
+    NSArray *mcpFrames = @[
+        @{ @"jsonrpc": @"2.0", @"id": @1, @"method": @"initialize", @"params": @{ @"protocolVersion": @"2025-06-18" } },
+        @{ @"jsonrpc": @"2.0", @"id": @2, @"method": @"tools/list" },
+        @{ @"jsonrpc": @"2.0", @"id": @3, @"method": @"tools/call",
+           @"params": @{ @"name": @"list_sessions", @"arguments": @{ @"limit": @10 } } },
+        @{ @"jsonrpc": @"2.0", @"id": @4, @"method": @"tools/call",
+           @"params": @{ @"name": @"get_session", @"arguments": @{ @"session_id": @"claude:5b55042e-4145-4dcc-967a-bca3c66267f9" } } }
+    ];
+    NSArray<NSDictionary *> *mcpResponses = [self integrationMCPResponsesForFrames:mcpFrames];
+    XCTAssertEqual(mcpResponses.count, 4u);
+    if (mcpResponses.count == 4) {
+        XCTAssertEqualObjects([mcpResponses valueForKey:@"id"], (@[ @1, @2, @3, @4 ]));
+        for (NSDictionary *response in mcpResponses) XCTAssertNil(response[@"error"]);
+        XCTAssertEqualObjects(mcpResponses[0][@"result"][@"protocolVersion"], @"2025-06-18");
+        NSArray *tools = mcpResponses[1][@"result"][@"tools"];
+        XCTAssertTrue([[tools valueForKey:@"name"] containsObject:@"get_session"]);
+        XCTAssertEqualObjects(mcpResponses[2][@"result"][@"isError"], @NO);
+        NSArray *sessions = mcpResponses[2][@"result"][@"structuredContent"][@"sessions"];
+        NSSet *sessionIDs = [NSSet setWithArray:[sessions valueForKey:@"session_id"]];
+        XCTAssertEqualObjects(sessionIDs, ([NSSet setWithArray:@[ @"claude:5b55042e-4145-4dcc-967a-bca3c66267f9",
+                                                                @"codex:85797c81-7330-4cac-ae87-e6243ae320df" ]]));
+        XCTAssertEqualObjects(mcpResponses[3][@"result"][@"isError"], @NO);
+        NSDictionary *transcript = mcpResponses[3][@"result"][@"structuredContent"];
+        XCTAssertEqualObjects(transcript[@"session"][@"session_id"], @"claude:5b55042e-4145-4dcc-967a-bca3c66267f9");
+        XCTAssertEqualObjects([transcript[@"messages"] firstObject][@"text"],
+                              @"Stable request identifiers prevent duplicate receipts after a transport failure.");
+        NSString *contentJSON = [mcpResponses[3][@"result"][@"content"] firstObject][@"text"];
+        NSDictionary *textContent = [NSJSONSerialization JSONObjectWithData:[contentJSON dataUsingEncoding:NSUTF8StringEncoding]
+                                                                     options:0 error:nil];
+        XCTAssertEqualObjects(textContent, transcript);
+    }
+}
