@@ -0,0 +1,1239 @@
+import AppKit
+import Foundation
+
+extension OmniPane {
+    // A stable fingerprint of scheduler data, so a periodic reload rebuilds a
+    // pane only when something it shows changed, keeping scroll and selection.
+    static func signature(_ objects: Any...) -> String {
+        guard JSONSerialization.isValidJSONObject(objects),
+              let data = try? JSONSerialization.data(withJSONObject: objects, options: [.sortedKeys]) else {
+            return UUID().uuidString
+        }
+        return String(decoding: data, as: UTF8.self)
+    }
+
+    static func title(_ text: String) -> NSTextField {
+        return OmniTheme.title(text)
+    }
+
+    static func meta(_ parts: [String]) -> NSTextField {
+        return OmniPaneText.label(parts.filter { !$0.isEmpty }.joined(separator: "  ·  "), size: 12,
+                                  color: OmniTheme.secondaryText)
+    }
+
+    // Label/value lines with the values aligned on a tab stop. Values are
+    // untrusted. Prose wraps by word; a value with no spaces (a path, a
+    // branch) stays on its line and loses its middle, never wrapping one
+    // character per line.
+    static func facts(_ rows: [(String, String)]) -> NSTextField {
+        let wrapping = NSMutableParagraphStyle()
+        wrapping.tabStops = [NSTextTab(textAlignment: .left, location: 112)]
+        wrapping.headIndent = 112
+        wrapping.lineSpacing = 4
+        wrapping.lineBreakMode = .byWordWrapping
+        let truncating = (wrapping.mutableCopy() as? NSMutableParagraphStyle) ?? NSMutableParagraphStyle()
+        truncating.lineBreakMode = .byTruncatingMiddle
+        let text = NSMutableAttributedString()
+        for (index, row) in rows.enumerated() {
+            let value = OmniReportText.sanitized(row.1)
+            let paragraph = value.rangeOfCharacter(from: .whitespacesAndNewlines) == nil ? truncating : wrapping
+            text.append(NSAttributedString(string: row.0 + "\t", attributes: [
+                .font: OmniTheme.Font.fact, .foregroundColor: OmniTheme.secondaryText,
+                .paragraphStyle: paragraph]))
+            text.append(NSAttributedString(string: value + (index < rows.count - 1 ? "\n" : ""),
+                                           attributes: [.font: OmniTheme.Font.fact,
+                                                        .foregroundColor: NSColor.labelColor,
+                                                        .paragraphStyle: paragraph]))
+        }
+        let field = NSTextField(wrappingLabelWithString: "")
+        field.isSelectable = true
+        field.allowsEditingTextAttributes = true
+        field.attributedStringValue = text
+        return field
+    }
+
+    static func badgeRow(_ text: String, color: NSColor) -> NSView {
+        let container = NSView(frame: NSRect(x: 0, y: 0, width: 200, height: 18))
+        let badge = OmniBadgeView()
+        badge.configure(text: text.uppercased(), color: color)
+        container.addSubview(badge)
+        return container
+    }
+}
+
+// A list column nested in a page's column, with its keyboard zone over it.
+private func makeListColumn(_ zone: OmniListZone) -> OmniColumnView {
+    let list = OmniColumnView()
+    list.inset = 0
+    list.topPadding = 0
+    list.bottomPadding = 0
+    list.overlay = zone
+    return list
+}
+
+private func addList(_ list: OmniColumnView, to column: OmniColumnView) {
+    column.add(list, spacing: 8) { [weak list] width in
+        list?.layoutColumn(width: width) ?? 0
+    }
+}
