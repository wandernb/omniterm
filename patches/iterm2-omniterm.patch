+import AppKit
+import Foundation
+
+// MARK: - Model
+
+// What the Unblocker page shows. Pure so tests can check it without a window.
+enum OmniUnblockerModel {
+    static func outcomeTitle(_ outcome: String) -> String {
+        switch outcome {
+        case "answered": return "Answered"
+        case "allowed": return "Allowed a dialog"
+        case "skipped": return "Left for you"
+        case "error": return "Failed"
+        case "granted_call": return "Pre-approved call ran"
+        case "retired": return "Set up"
+        case "policy": return "Policy edited"
+        default: return "No action"
+        }
+    }
+
+    // Which of the three checks made the call, cheapest first.
+    static func tierTitle(_ tier: String) -> String {
+        switch tier {
+        case "keywords": return "Keyword check (no model)"
+        case "cheap": return "Quick check (cheap model)"
+        case "smart": return "Full decision"
+        default: return tier
+        }
+    }
+
+    // The project a session works in: the last folder of its path, skipping
+    // worktree folders such as `@head`.
+    static func project(_ cwd: String?) -> String {
+        guard let cwd, !cwd.isEmpty else { return "" }
+        let parts = cwd.split(separator: "/").map(String.init).filter { !$0.hasPrefix("@") }
+        return parts.last ?? cwd
+    }
+
+    // Made once: a formatter per audit row slowed every load of the page.
+    private static let timeFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.timeStyle = .short
+        formatter.dateStyle = .none
+        return formatter
+    }()
+    private static let dateTimeFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.timeStyle = .short
+        formatter.dateStyle = .short
+        return formatter
+    }()
+
+    static func title(for entry: [String: Any], now: Date) -> String {
+        let when = Date(timeIntervalSince1970: (entry["at"] as? NSNumber)?.doubleValue ?? 0)
+        let formatter = Calendar.current.isDate(when, inSameDayAs: now) ? timeFormatter : dateTimeFormatter
+        let outcome = outcomeTitle(entry["outcome"] as? String ?? "")
+        let project = project(entry["cwd"] as? String)
+        return [formatter.string(from: when), outcome, project].filter { !$0.isEmpty }.joined(separator: " · ")
+    }
+
+    static func symbol(_ outcome: String) -> SFSymbol {
+        switch outcome {
+        case "answered": return .arrowshapeTurnUpLeft
+        case "allowed", "granted_call": return .checkmarkCircle
+        case "skipped": return .personCropCircle
+        case "error": return .exclamationmarkTriangle
+        default: return .circle
+        }
+    }
+
+    static func color(_ outcome: String) -> NSColor? {
+        switch outcome {
+        case "answered", "allowed", "granted_call": return OmniTheme.running
+        case "skipped": return OmniTheme.waiting
+        case "error": return OmniTheme.failed
+        default: return nil
+        }
+    }
+
+    static func detail(for entry: [String: Any]) -> String {
+        let detail = (entry["detail"] as? String ?? "").split(whereSeparator: \.isNewline).joined(separator: " ")
+        return detail.isEmpty ? (entry["goal"] as? String ?? "") : detail
+    }
+}
+
+// MARK: - Page
+
+// The Unblocker page (the `.unblocker` route). The unblocker is not an agent:
+// OmniTerm runs it in the background whenever a goal-driven session waits.
+// Here the person switches it on or off, picks its model, edits the policy it
+// follows and audits everything it did. Settings go through `set_settings`,
+// the policy and audit through the scheduler's knowledge operations.
+final class OmniUnblockerPane: OmniPane, NSTextFieldDelegate {
+    private let scroll = OmniColumnScrollView()
+    private let statusLabel = OmniTheme.meta()
+    private let policyEditor = OmniMarkdownEditor()
+    private var settings: [String: Any] = [:]
+    private var policy = ""
+    private var policyPath = ""
+    private var audit: [[String: Any]] = []
+    private var waiting: [[String: Any]] = []
+    private var policyLoaded = false
+    // True until the audit, policy and waiting sessions first arrive.
+    private var knowledgeLoading = true
+    private(set) var zones: [(title: String, zone: OmniListZone)] = []
+    var now: () -> Date = Date.init
+
+    override var contentViews: [NSView] {
+        return [scroll]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return zones.map(\.zone)
+    }
+
+    override init() {
+        super.init()
+        addSubview(scroll)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        scroll.frame = bounds
+    }
+
+    // Settings answer at once; the audit, policy and waiting sessions go to the
+    // knowledge worker, which can be busy with indexing for a moment. The page
+    // shows as soon as the settings arrive and fills in the rest when it comes.
+    override func reload() {
+        var responses: [String: [AnyHashable: Any]] = [:]
+        let group = DispatchGroup()
+        let requests: [(String, [String: Any])] = [
+            ("audit", ["op": "unblocker_audit", "limit": 100]),
+            ("policy", ["op": "get_unblocker_policy"]),
+            ("blocked", ["op": "list_blocked", "state": "open", "answerable_only": true, "limit": 50]),
+        ]
+        var settingsResponse: [AnyHashable: Any]?
+        group.enter()
+        OmniSchedulerClient.request(["op": "get_settings"]) { [weak self] response in
+            settingsResponse = response
+            group.leave()
+            DispatchQueue.main.async {
+                guard let self, self.knowledgeLoading else { return }
+                if OmniPane.isOK(response), let settings = response["settings"] as? [String: Any] {
+                    self.settings = settings
+                    self.rebuild()
+                }
+            }
+        }
+        for (name, request) in requests {
+            group.enter()
+            OmniSchedulerClient.request(request) { response in
+                DispatchQueue.main.async {
+                    responses[name] = response
+                    group.leave()
+                }
+            }
+        }
+        group.notify(queue: .main) { [weak self] in
+            guard let self else { return }
+            guard let settingsResponse, OmniPane.isOK(settingsResponse),
+                  let settings = settingsResponse["settings"] as? [String: Any] else {
+                self.showMessage(OmniPane.unreachableMessage(settingsResponse ?? [:]))
+                return
+            }
+            self.knowledgeLoading = false
+            self.settings = settings
+            self.audit = responses["audit"]?["entries"] as? [[String: Any]] ?? []
+            if let index = self.pendingAuditIndex {
+                self.pendingAuditIndex = nil
+                if self.audit.indices.contains(index) {
+                    DispatchQueue.main.async { self.showAuditEntry(self.audit[index]) }
+                }
+            }
+            let blocks = responses["blocked"]?["blocks"] as? [[String: Any]] ?? []
+            self.waiting = blocks.filter { $0["answerable"] as? Bool == true }
+            if let policyResponse = responses["policy"], OmniPane.isOK(policyResponse) {
+                self.policy = policyResponse["policy"] as? String ?? ""
+                self.policyPath = policyResponse["path"] as? String ?? ""
+            }
+            self.rebuild()
+        }
+    }
+
+    private var config: [String: Any] {
+        return settings["unblocker"] as? [String: Any] ?? [:]
+    }
+
+    private func rebuild() {
+        preservingZoneFocus {
+            scroll.rebuildKeepingScroll {
+                build()
+            }
+        }
+        showContent()
+    }
+
+    private func setStatus(_ text: String, error: Bool) {
+        statusLabel.stringValue = text
+        statusLabel.textColor = error ? OmniTheme.failed : OmniTheme.secondaryText
+    }
+
+    // MARK: Building
+
+    private func build() {
+        let column = scroll.column
+        column.removeAll()
+        let previous = zones
+        zones = []
+        column.addText(OmniTheme.title("Unblocker"), spacing: 4)
+        let intro = OmniPaneText.label(
+            "Keeps your goal-driven Claude and Codex sessions moving while you are away. When a session working " +
+            "on a /goal, a loop or a goal command waits 45 seconds, OmniTerm answers it for you within the policy " +
+            "below, allows its dialogs or pre-approves a command auto mode refused. It never acts on a session " +
+            "without a goal, and leaves anything the policy keeps for you.",
+            size: 12.5, color: OmniTheme.secondaryText)
+        column.add(intro, spacing: 6) { [weak intro] width in
+            intro?.sizeThatFits(NSSize(width: width, height: 400)).height ?? 40
+        }
+        if statusLabel.stringValue.isEmpty {
+            setStatus("Changes apply immediately.", error: false)
+        }
+        column.addText(statusLabel, spacing: 10)
+
+        let enabled = toggle(config["enabled"] as? Bool ?? true)
+        let model = NSTextField(string: config["model"] as? String ?? "")
+        model.placeholderString = "Claude’s default"
+        model.font = OmniTheme.Font.rowTitle
+        model.delegate = self
+        model.identifier = NSUserInterfaceItemIdentifier("unblocker-model")
+        let waitingText = knowledgeLoading ? "Checking…" : waiting.isEmpty ? "None right now" : "\(waiting.count) waiting"
+        let waitingLabel = OmniTheme.meta(waitingText)
+        section("Listener", previous: previous, rows: [
+            ("enabled", OmniSettingRow(title: "Unblock goal sessions",
+                                       detail: "Runs in the background; no agent, run or tab.", control: enabled)),
+            ("model", OmniSettingRow(title: "Model", detail: "The Claude model each decision uses.",
+                                     control: model, controlWidth: 200)),
+            ("waiting", OmniSettingRow(title: "Sessions it can answer", detail: "Goal sessions waiting now.",
+                                       control: waitingLabel, controlWidth: 140)),
+        ])
+
+        column.addSection("Policy")
+        let policyHint = OmniTheme.meta("Your standing rules: which projects are live products and what waits for you. " +
+                                        (policyPath.isEmpty ? "" : "Stored in \(policyPath)."))
+        column.addText(policyHint, spacing: 4)
+        if !knowledgeLoading && (!policyLoaded || policyEditor.text.isEmpty) {
+            policyEditor.text = policy
+            policyLoaded = true
+        }
+        column.add(policyEditor, spacing: 6) { _ in 260 }
+        let save = OmniTheme.button("Save policy", target: self, action: #selector(savePolicy))
+        let revert = OmniTheme.button("Revert", target: self, action: #selector(revertPolicy))
+        section("Policy actions", previous: previous, rows: [
+            ("save-policy", OmniSettingRow(title: "Save the policy", detail: "Used from the next decision on.",
+                                           control: save, controlWidth: 110)),
+            ("revert-policy", OmniSettingRow(title: "Discard edits", detail: "Back to the saved policy.",
+                                             control: revert, controlWidth: 110)),
+        ], header: false)
+
+        // Each decision opens in full over the page, with its session.
+        let reference = now()
+        let rows: [(key: String, row: OmniZoneItem)] = audit.enumerated().map { index, entry in
+            let outcome = entry["outcome"] as? String ?? ""
+            let row = OmniFolderEntryRow(icon: .symbol(OmniUnblockerModel.symbol(outcome).rawValue),
+                                         iconColor: OmniUnblockerModel.color(outcome),
+                                         title: OmniUnblockerModel.title(for: entry, now: reference),
+                                         detail: OmniUnblockerModel.detail(for: entry), badge: "", status: nil) { [weak self] in
+                self?.showAuditEntry(entry)
+            }
+            row.toolTip = OmniUnblockerModel.detail(for: entry)
+            row.contextMenu = { [weak self] in
+                let menu = NSMenu()
+                menu.addAction("Open Decision", symbol: .arrowRightCircle) { self?.showAuditEntry(entry) }
+                menu.addAction("Copy Details", symbol: .docOnDoc) { OmniContextMenus.copy(OmniUnblockerModel.detail(for: entry)) }
+                return menu
+            }
+            return (key: "audit-\(index)", row: row)
+        }
+        if rows.isEmpty {
+            column.addSection("Audit")
+            column.addText(OmniTheme.meta(knowledgeLoading ? "Loading…" :
+                                            "Nothing yet. Every decision, and every failure, is listed here for 14 days."),
+                           spacing: 8)
+        } else {
+            column.addSection("Audit")
+            let zone = previous.first { $0.title == "Audit" }?.zone ?? OmniListZone()
+            let list = OmniColumnView()
+            list.inset = 0
+            list.topPadding = 0
+            list.bottomPadding = 0
+            list.overlay = zone
+            for (_, row) in rows {
+                list.add(row, spacing: 2) { _ in OmniFolderEntryRow.height }
+            }
+            zone.setItems(rows.map { (key: $0.key, view: $0.row) })
+            column.add(list, spacing: 8) { [weak list] width in list?.layoutColumn(width: width) ?? 0 }
+            zones.append((title: "Audit", zone: zone))
+        }
+    }
+
+    // MARK: Audit entry
+
+    private weak var auditOverlay: OmniAuditEntryView?
+    // omniterm://unblocker?audit=N: the entry to open once the audit loads.
+    var pendingAuditIndex: Int?
+
+    func showAuditEntry(_ entry: [String: Any]) {
+        auditOverlay?.removeFromSuperview()
+        guard let content = window?.contentView else { return }
+        let overlay = OmniAuditEntryView(entry: entry, now: now()) { [weak self] sessionID in
+            self?.actions?.paneOpenSearchHit(OmniSearchHit(key: sessionID, title: "", detail: "", icon: .symbol(""),
+                                                           iconColor: nil, target: .session(sessionID, message: nil)))
+        }
+        overlay.frame = content.bounds
+        overlay.autoresizingMask = [.width, .height]
+        content.addSubview(overlay, positioned: .above, relativeTo: nil)
+        window?.makeFirstResponder(overlay)
+        auditOverlay = overlay
+    }
+
+    var shownAuditEntry: OmniAuditEntryView? {
+        return auditOverlay
+    }
+
+    private func section(_ title: String, previous: [(title: String, zone: OmniListZone)],
+                         rows: [(key: String, row: OmniSettingRow)], header: Bool = true) {
+        let column = scroll.column
+        if header {
+            column.addSection(title)
+        }
+        let zone = previous.first { $0.title == title }?.zone ?? OmniListZone()
+        let list = OmniColumnView()
+        list.inset = 0
+        list.topPadding = 0
+        list.bottomPadding = 0
+        list.overlay = zone
+        for (_, row) in rows {
+            list.add(row, spacing: 2) { _ in OmniSettingRow.height }
+        }
+        zone.setItems(rows.map { (key: $0.key, view: $0.row as OmniZoneItem) })
+        column.add(list, spacing: 8) { [weak list] width in
+            list?.layoutColumn(width: width) ?? 0
+        }
+        zones.append((title: title, zone: zone))
+    }
+
+    private func toggle(_ on: Bool) -> NSSwitch {
+        let toggle = NSSwitch()
+        toggle.state = on ? .on : .off
+        toggle.target = self
+        toggle.action = #selector(enabledChanged(_:))
+        return toggle
+    }
+
+    // MARK: Saving
+
+    private func save(_ change: [String: Any]) {
+        OmniSchedulerClient.request(["op": "set_settings", "settings": ["unblocker": change]]) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response), let settings = response["settings"] as? [String: Any] {
+                self.settings = settings
+                self.setStatus("Saved. Changes apply immediately.", error: false)
+            } else {
+                self.setStatus(response["error"] as? String ?? "Could not save the setting.", error: true)
+            }
+            self.rebuild()
+        }
+    }
+
+    @objc private func enabledChanged(_ sender: NSSwitch) {
+        save(["enabled": sender.state == .on])
+    }
+
+    func controlTextDidEndEditing(_ notification: Notification) {
+        guard let field = notification.object as? NSTextField,
+              field.identifier?.rawValue == "unblocker-model" else { return }
+        let value = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        if value != (config["model"] as? String ?? "") {
+            save(["model": value])
+        }
+    }
+
+    @objc private func savePolicy() {
+        OmniSchedulerClient.request(["op": "set_unblocker_policy", "policy": policyEditor.text]) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response) {
+                self.policy = response["policy"] as? String ?? self.policyEditor.text
+                self.setStatus("Policy saved. The previous version is kept beside it as policy.md.previous.", error: false)
+                self.reload()
+            } else {
+                self.setStatus(response["error"] as? String ?? "Could not save the policy.", error: true)
+            }
+        }
+    }
+
+    @objc private func revertPolicy() {
+        policyEditor.text = policy
+        setStatus("Edits discarded.", error: false)
+    }
+}
