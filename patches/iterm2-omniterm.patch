+// Validates one change made through `set_settings` or the Settings page and
+// returns the value to store, or nil when it is invalid.
+static id OmniValidSettingValue(NSString *key, id value, NSDictionary *current, NSString **invalid) {
+    if (invalid) *invalid = key;
+    if ([key isEqualToString:@"default_timeout_seconds"]) {
+        return OmniIsWholeNumber(value) && [value integerValue] >= 60 && [value integerValue] <= 525600 * 60 ? value : nil;
+    }
+    if ([key isEqualToString:@"retained_run_tabs"]) {
+        return OmniIsWholeNumber(value) && [value integerValue] >= 1 && [value integerValue] <= 100 ? value : nil;
+    }
+    if ([key isEqualToString:@"double_escape_interval_ms"]) {
+        return OmniIsWholeNumber(value) && [value integerValue] >= 150 && [value integerValue] <= 2000 ? value : nil;
+    }
+    if ([@[ @"double_escape_to_hide", @"summaries" ] containsObject:key]) {
+        return OmniIsBoolean(value) ? value : nil;
+    }
+    if ([key isEqualToString:@"timezone"]) {
+        return [value isKindOfClass:[NSString class]] && [NSTimeZone timeZoneWithName:value] ? value : nil;
+    }
+    if ([key isEqualToString:@"summary_model"]) {
+        NSString *word = OmniSettingWord(value, 200);
+        return word.length ? word : nil;
+    }
+    if ([key isEqualToString:@"notifications"]) {
+        if (![value isKindOfClass:[NSDictionary class]]) return nil;
+        return OmniValidNotificationSettings(OmniMergedSettingsDictionary(current[@"notifications"], value), YES, invalid);
+    }
+    if ([key isEqualToString:@"unblocker"]) {
+        if (![value isKindOfClass:[NSDictionary class]]) return nil;
+        NSMutableDictionary *merged = [NSMutableDictionary dictionary];
+        if ([current[@"unblocker"] isKindOfClass:[NSDictionary class]]) [merged addEntriesFromDictionary:current[@"unblocker"]];
+        [merged addEntriesFromDictionary:value];
+        for (NSString *field in merged) {
+            if (![@[ @"enabled", @"model" ] containsObject:field]) return nil;
+        }
+        if (merged[@"enabled"] && !OmniIsBoolean(merged[@"enabled"])) return nil;
+        id model = merged[@"model"];
+        if (model && !([model isEqual:@""] || OmniSettingWord(model, 200).length)) return nil;
+        return merged;
+    }
+    if ([key isEqualToString:@"projects"] || [key isEqualToString:@"session_folders"]) {
+        // The sidebar's arrangement of forge projects (folders, order, each
+        // project's folder, name, icon and colour), and the same shape for
+        // Sessions mode's folders, keyed by session ID. Replaced whole; plain
+        // strings only.
+        if (![value isKindOfClass:[NSDictionary class]]) return nil;
+        BOOL (^strings)(id, NSUInteger, NSUInteger) = ^BOOL(id list, NSUInteger count, NSUInteger length) {
+            if (![list isKindOfClass:[NSArray class]] || [(NSArray *)list count] > count) return NO;
+            for (id entry in list) {
+                if (![entry isKindOfClass:[NSString class]] || [entry length] > length) return NO;
+            }
+            return YES;
+        };
+        BOOL (^map)(id, NSUInteger) = ^BOOL(id dictionary, NSUInteger length) {
+            if (![dictionary isKindOfClass:[NSDictionary class]] || [(NSDictionary *)dictionary count] > 2000) return NO;
+            for (id key in dictionary) {
+                id entry = dictionary[key];
+                if (![key isKindOfClass:[NSString class]] || [key length] > 4096 ||
+                    ![entry isKindOfClass:[NSString class]] || [entry length] > length) return NO;
+            }
+            return YES;
+        };
+        for (NSString *field in value) {
+            if (![@[ @"groups", @"order", @"folders", @"names", @"icons", @"colors" ] containsObject:field]) return nil;
+        }
+        if (value[@"groups"] && !strings(value[@"groups"], 200, 200)) return nil;
+        if (value[@"order"] && !strings(value[@"order"], 4000, 4200)) return nil;
+        if (value[@"folders"] && !map(value[@"folders"], 200)) return nil;
+        if (value[@"names"] && !map(value[@"names"], 120)) return nil;
+        if (value[@"icons"] && !map(value[@"icons"], 200)) return nil;
+        if (value[@"colors"] && !map(value[@"colors"], 40)) return nil;
+        return value;
+    }
+    if ([key isEqualToString:@"agent_folders"]) {
+        // Agent folders' icons and colours, by folder path. Replaced whole.
+        if (![value isKindOfClass:[NSDictionary class]]) return nil;
+        for (NSString *field in value) {
+            if (![@[ @"icons", @"colors" ] containsObject:field]) return nil;
+            id map = value[field];
+            if (![map isKindOfClass:[NSDictionary class]] || [(NSDictionary *)map count] > 500) return nil;
+            for (id path in map) {
+                id entry = map[path];
+                if (![path isKindOfClass:[NSString class]] || [path length] > 200 ||
+                    ![entry isKindOfClass:[NSString class]] || [entry length] > 200) return nil;
+            }
+        }
+        return value;
+    }
+    if ([key isEqualToString:@"agent_defaults"]) {
+        if (![value isKindOfClass:[NSDictionary class]]) return nil;
+        return OmniValidAgentDefaults(OmniMergedSettingsDictionary(current[@"agent_defaults"], value), YES, invalid);
+    }
+    return nil;
+}
