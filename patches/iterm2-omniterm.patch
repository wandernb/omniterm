+- (BOOL)execute:(NSString *)sql {
+    char *error = NULL;
+    const int result = sqlite3_exec(_database, sql.UTF8String, NULL, NULL, &error);
+    if (result != SQLITE_OK) {
+        NSLog(@"OmniScheduler SQL error: %s", error ?: "unknown");
+        sqlite3_free(error);
+        return NO;
+    }
+    return YES;
+}
+
+- (void)start {
+    if (_database) {
+        return;
+    }
+    [[NSFileManager defaultManager] createDirectoryAtPath:_supportPath
+                              withIntermediateDirectories:YES
+                                               attributes:@{ NSFilePosixPermissions: @0700 }
+                                                    error:nil];
+    chmod(_supportPath.fileSystemRepresentation, 0700);
+    NSString *lockPath = [_supportPath stringByAppendingPathComponent:@"scheduler.lock"];
+    _lockFile = open(lockPath.fileSystemRepresentation, O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+    if (_lockFile < 0) {
+        NSString *message = [NSString stringWithFormat:@"scheduler lock creation failed: %s", strerror(errno)];
+        [message writeToFile:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"]
+                  atomically:YES
+                    encoding:NSUTF8StringEncoding
+                       error:nil];
+        return;
+    }
+    if (flock(_lockFile, LOCK_EX | LOCK_NB) != 0) {
+        // Another OmniTerm process owns the scheduler. In particular, do not
+        // unlink its socket: secondary app launches must be harmless.
+        close(_lockFile);
+        _lockFile = -1;
+        return;
+    }
+    ftruncate(_lockFile, 0);
+    dprintf(_lockFile, "%d\n", getpid());
+
+    NSString *databasePath = [_supportPath stringByAppendingPathComponent:@"scheduler.sqlite"];
+    const int openResult = sqlite3_open_v2(databasePath.fileSystemRepresentation,
+                        &_database,
+                        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX,
+                        NULL);
+    if (openResult != SQLITE_OK) {
+        NSString *message = [NSString stringWithFormat:@"sqlite open %d: %s", openResult,
+                             _database ? sqlite3_errmsg(_database) : "no handle"];
+        [message writeToFile:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"]
+                  atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        if (_database) sqlite3_close(_database);
+        _database = NULL;
+        flock(_lockFile, LOCK_UN);
+        close(_lockFile);
+        _lockFile = -1;
+        return;
+    }
+    [self execute:@"PRAGMA journal_mode=WAL"];
+    chmod(databasePath.fileSystemRepresentation, 0600);
+    chmod([[databasePath stringByAppendingString:@"-wal"] fileSystemRepresentation], 0600);
+    chmod([[databasePath stringByAppendingString:@"-shm"] fileSystemRepresentation], 0600);
+    [self execute:@"PRAGMA foreign_keys=ON"];
+    [self execute:@"CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL)"];
+    [self execute:@"CREATE TABLE IF NOT EXISTS agents (name TEXT PRIMARY KEY, definition TEXT NOT NULL, enabled INTEGER NOT NULL, next_run REAL, last_run REAL)"];
+    [self execute:@"CREATE TABLE IF NOT EXISTS runs (id TEXT PRIMARY KEY, agent TEXT NOT NULL, state TEXT NOT NULL, reason TEXT, started REAL NOT NULL, finished REAL, pid INTEGER, pgid INTEGER, session_id TEXT, resume_session_id TEXT, FOREIGN KEY(agent) REFERENCES agents(name) ON DELETE CASCADE)"];
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN session_id TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN resume_session_id TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN turn_finished INTEGER", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN agent_snapshot TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN wrap_up_input TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN compact_input TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN finish_input TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN loop_token TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN loop_state TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN loop_agent TEXT", NULL, NULL, NULL);
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN loop_ack_token TEXT", NULL, NULL, NULL);
+    // A finished turn of a loop, recorded as a run of its own: the live loop run it came from.
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN loop_parent TEXT", NULL, NULL, NULL);
+    // Run reports. workspace and provider are snapshots taken at start.
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN origin TEXT NOT NULL DEFAULT 'scheduled'", NULL, NULL, NULL);
+    for (NSString *column in @[ @"workspace", @"provider", @"transcript_path", @"branch", @"head_start", @"head_end",
+                                @"commits", @"final_message", @"summary", @"summary_state", @"diff_state",
+                                @"diff_path", @"diff_files", @"pr_url" ]) {
+        NSString *sql = [NSString stringWithFormat:@"ALTER TABLE runs ADD COLUMN %@ TEXT", column];
+        sqlite3_exec(_database, sql.UTF8String, NULL, NULL, NULL);
+    }
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN report_updated REAL", NULL, NULL, NULL);
+    // When the runner saw the latest finished turn; summaries name the turn they describe.
+    sqlite3_exec(_database, "ALTER TABLE runs ADD COLUMN turn_at REAL", NULL, NULL, NULL);
+    [self execute:@"CREATE INDEX IF NOT EXISTS runs_started ON runs(started)"];
+    // Every tick and every page asks for the live runs.
+    [self execute:@"CREATE INDEX IF NOT EXISTS runs_state ON runs(state)"];
+    [self execute:@"CREATE INDEX IF NOT EXISTS runs_loop_parent ON runs(loop_parent)"];
+    // Runs that finished their turn and were then closed by retention were
+    // once recorded as evicted. Their work was done: record them as completed, once.
+    if (![self rowsForSQL:@"SELECT value FROM metadata WHERE key='finished_evictions_completed'" bindings:@[]].count) {
+        [self runSQL:@"UPDATE runs SET state='completed',reason=? WHERE state='evicted' AND turn_finished=1"
+            bindings:@[ OmniRetentionCompletedReason ]];
+        [self execute:@"INSERT OR REPLACE INTO metadata(key,value) VALUES('finished_evictions_completed','1')"];
+    }
+    // Runs from before turns were tracked recorded no turn, so whether their
+    // agent had finished is unknown: say so rather than call them evicted.
+    [self runSQL:@"UPDATE runs SET reason=? WHERE state='evicted' AND turn_finished IS NULL AND reason='retention age'"
+        bindings:@[ OmniRetentionUnknownReason ]];
+    // Names and workspace are copied in, with no foreign key, so deleting an
+    // agent or pruning its runs keeps the notifications it sent.
+    [self execute:@"CREATE TABLE IF NOT EXISTS notifications (id TEXT PRIMARY KEY, created REAL NOT NULL, updated REAL NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL, severity TEXT NOT NULL, agent TEXT, run_id TEXT, workspace TEXT, read REAL, dedupe_key TEXT, suppressed INTEGER NOT NULL DEFAULT 0, diff_state TEXT, diff_path TEXT, diff_files TEXT)"];
+    // What produced a notification (`agent`, or one of OmniTerm's own kinds);
+    // NULL rows predate the column and are read as `agent` unless their
+    // dedupe key names a built-in producer.
+    if (sqlite3_exec(_database, "ALTER TABLE notifications ADD COLUMN kind TEXT", NULL, NULL, NULL) == SQLITE_OK) {
+        [self execute:@"UPDATE notifications SET kind=CASE "
+                       "WHEN dedupe_key LIKE 'omni:run-limit:%' THEN 'run_limit' "
+                       "WHEN dedupe_key LIKE 'compact-%' THEN 'compaction' "
+                       "WHEN dedupe_key LIKE 'wrap-up-%' THEN 'wrap_up' "
+                       "WHEN dedupe_key LIKE 'loop-continuation-%' THEN 'loop_continuation' "
+                       "WHEN dedupe_key='knowledge-storage-budget' THEN 'storage' "
+                       "ELSE 'agent' END WHERE kind IS NULL"];
+    }
+    [self execute:@"CREATE INDEX IF NOT EXISTS notifications_updated ON notifications(updated)"];
+    [self execute:@"CREATE INDEX IF NOT EXISTS notifications_dedupe ON notifications(dedupe_key)"];
+    [self execute:@"INSERT OR REPLACE INTO metadata(key,value) VALUES('schema_version','2')"];
+
+    [[NSFileManager defaultManager] createDirectoryAtPath:_agentsPath
+                              withIntermediateDirectories:YES
+                                               attributes:@{ NSFilePosixPermissions: @0700 }
+                                                    error:nil];
+    chmod(_configPath.fileSystemRepresentation, 0700);
+    chmod(_agentsPath.fileSystemRepresentation, 0700);
+    NSDictionary *normalizedSettings = [self settings];
+    NSData *settingsData = [NSJSONSerialization dataWithJSONObject:normalizedSettings
+                                                            options:(NSJSONWritingPrettyPrinted | NSJSONWritingSortedKeys)
+                                                              error:nil];
+    [settingsData writeToFile:_settingsPath options:NSDataWritingAtomic error:nil];
+    chmod(_settingsPath.fileSystemRepresentation, 0600);
+    // One-time migration from database-only definitions to file-backed agents.
+    for (NSDictionary *row in [self rowsForSQL:@"SELECT * FROM agents" bindings:@[]]) {
+        NSDictionary *agent = [self decodedAgentRow:row];
+        if (![[NSFileManager defaultManager] fileExistsAtPath:[self agentPathForName:agent[@"name"]]]) {
+            [self writeAgentFile:agent];
+        }
+    }
+    @try {
+        [self reloadAgentFilesIfNeeded:YES];
+    } @catch (NSException *exception) {
+        NSLog(@"OmniScheduler could not load agent files: %@", exception);
+    }
+
+    unlink(_socketPath.fileSystemRepresentation);
+    _listener = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (_listener < 0) {
+        [@"socket creation failed" writeToFile:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        return;
+    }
+    struct sockaddr_un address = { 0 };
+    address.sun_family = AF_UNIX;
+    strlcpy(address.sun_path, _socketPath.fileSystemRepresentation, sizeof(address.sun_path));
+    if (bind(_listener, (struct sockaddr *)&address, sizeof(address)) != 0 || listen(_listener, 16) != 0) {
+        NSString *message = [NSString stringWithFormat:@"socket bind/listen failed: %s", strerror(errno)];
+        [message writeToFile:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        close(_listener);
+        _listener = -1;
+        return;
+    }
+    chmod(_socketPath.fileSystemRepresentation, 0600);
+    [[NSFileManager defaultManager] removeItemAtPath:[_supportPath stringByAppendingPathComponent:@"startup-error.txt"] error:nil];
+    _listenerSource = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, _listener, 0, _queue);
+    __block OmniScheduler *weakSelf = self;
+    dispatch_source_set_event_handler(_listenerSource, ^{
+        [weakSelf acceptClient];
+    });
+    dispatch_resume(_listenerSource);
+
+    _timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, _queue);
+    dispatch_source_set_timer(_timer, dispatch_time(DISPATCH_TIME_NOW, 0), 2 * NSEC_PER_SEC,
+                              250 * NSEC_PER_MSEC);
+    dispatch_source_set_event_handler(_timer, ^{
+        [weakSelf checkNowGuarded];
+    });
+    dispatch_resume(_timer);
+    [self startKnowledge];
+}
+
+- (void)stop {
+    const BOOL ownsSchedulerLock = (_lockFile >= 0);
+    if (_timer) {
+        dispatch_source_cancel(_timer);
+        dispatch_release(_timer);
+        _timer = nil;
+    }
+    if (_listenerSource) {
+        dispatch_source_cancel(_listenerSource);
+        dispatch_release(_listenerSource);
+        _listenerSource = nil;
+    }
+    [self stopKnowledge];
+    // Let in-flight scheduler work finish before its database closes. Report
+    // captures go first: each one ends by queueing its write-back.
+    dispatch_sync(_captureQueue, ^{});
+    dispatch_sync(_queue, ^{});
+    if (_listener >= 0) {
+        close(_listener);
+        _listener = -1;
+    }
+    if (ownsSchedulerLock) {
+        unlink(_socketPath.fileSystemRepresentation);
+    }
+    if (_database) {
+        sqlite3_close(_database);
+        _database = NULL;
+    }
+    if (_lockFile >= 0) {
+        flock(_lockFile, LOCK_UN);
+        close(_lockFile);
+        _lockFile = -1;
+    }
+}
+
+- (void)acceptClient {
+    const int client = accept(_listener, NULL, NULL);
+    if (client < 0) {
+        return;
+    }
+    uid_t peerUID = (uid_t)-1;
+    gid_t peerGID = (gid_t)-1;
+    if (getpeereid(client, &peerUID, &peerGID) != 0 || peerUID != geteuid()) {
+        close(client);
+        return;
+    }
+    const struct timeval timeout = { .tv_sec = OmniClientTimeoutSeconds, .tv_usec = 0 };
+    setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(client, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        NSMutableData *data = [NSMutableData data];
+        char buffer[8192];
+        while (data.length < 1024 * 1024) {
+            const ssize_t count = read(client, buffer, sizeof(buffer));
+            if (count <= 0) break;
+            [data appendBytes:buffer length:(NSUInteger)count];
+            if (memchr(buffer, '\n', (size_t)count)) break;
+        }
+        id request = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+        __block NSDictionary *response = nil;
+        NSDictionary *read = nil;
+        if ([request isKindOfClass:[NSDictionary class]] && (read = [self knowledgeReadResponse:request])) {
+            response = [read retain];
+        } else if ([request isKindOfClass:[NSDictionary class]] && OmniIsKnowledgeOperation(request[@"op"])) {
+            atomic_fetch_add(&_knowledgeWaiters, 1);
+            dispatch_sync(_knowledgeQueue, ^{
+                atomic_fetch_sub(&self->_knowledgeWaiters, 1);
+                response = [[self responseForKnowledgeRequest:request] retain];
+            });
+        } else {
+            dispatch_sync(_queue, ^{
+                response = [[self responseForRequest:request] retain];
+            });
+        }
+        NSData *encoded = nil;
+        @try {
+            encoded = [NSJSONSerialization dataWithJSONObject:response options:0 error:nil];
+        } @catch (NSException *exception) {
+            NSLog(@"OmniScheduler could not encode a response: %@", exception);
+        }
+        encoded = encoded ?: [@"{\"ok\":false,\"error\":\"Malformed response\"}" dataUsingEncoding:NSUTF8StringEncoding];
+        const int noSignal = 1;
+        setsockopt(client, SOL_SOCKET, SO_NOSIGPIPE, &noSignal, sizeof(noSignal));
+        NSMutableData *frame = [[encoded mutableCopy] autorelease];
+        [frame appendBytes:"\n" length:1];
+        NSUInteger offset = 0;
+        while (offset < frame.length) {
+            const ssize_t count = write(client, (const char *)frame.bytes + offset, frame.length - offset);
+            if (count <= 0) break;
+            offset += (NSUInteger)count;
+        }
+        [response release];
+        close(client);
+    });
+}
+
+- (NSString *)knowledgeSocketPath {
+    return [_supportPath stringByAppendingPathComponent:@"knowledge.sock"];
+}
+
+- (NSString *)knowledgeHelperPath {
+    return [[NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"Helpers"]
+        stringByAppendingPathComponent:@"omni-knowledge"];
+}
+
+- (NSString *)knowledgeWorkerHomePath {
+    return NSHomeDirectory();
+}
+
+- (void)startKnowledge {
+    self.knowledgeEnabled = YES;
+    _knowledgeTimer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, _knowledgeQueue);
+    dispatch_source_set_timer(_knowledgeTimer, DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC, NSEC_PER_SEC);
+    __block OmniScheduler *weakSelf = self;
+    dispatch_source_set_event_handler(_knowledgeTimer, ^{
+        @autoreleasepool {
+            @try {
+                [weakSelf tickKnowledge];
+            } @catch (NSException *exception) {
+                NSLog(@"OmniScheduler knowledge maintenance failed: %@", exception.name);
+            }
+        }
+    });
+    dispatch_resume(_knowledgeTimer);
+    _knowledgePressureSource = dispatch_source_create(DISPATCH_SOURCE_TYPE_MEMORYPRESSURE, 0,
+                                                      DISPATCH_MEMORYPRESSURE_NORMAL | DISPATCH_MEMORYPRESSURE_WARN |
+                                                          DISPATCH_MEMORYPRESSURE_CRITICAL,
+                                                      _knowledgeQueue);
+    dispatch_source_t pressureSource = _knowledgePressureSource;
+    atomic_int *pressure = &_knowledgePressure;
+    dispatch_source_set_event_handler(pressureSource, ^{
+        const unsigned long level = dispatch_source_get_data(pressureSource);
+        atomic_store(pressure, (level & DISPATCH_MEMORYPRESSURE_CRITICAL) ? 2 : (level & DISPATCH_MEMORYPRESSURE_WARN) ? 1 : 0);
+    });
+    dispatch_resume(pressureSource);
+}
+
+// Monotonic seconds that keep counting through sleep, so a wake shows as a gap.
+- (double)knowledgeClock {
+    return (double)clock_gettime_nsec_np(CLOCK_MONOTONIC) / 1e9;
+}
+
+- (NSInteger)knowledgeMemoryPressure {
+    return atomic_load(&_knowledgePressure);
+}
+
+- (NSDictionary *)knowledgeEmbedRequest {
+    return OmniCurrentEmbedRequest();
+}
+
+- (void)stopKnowledge {
+    self.knowledgeEnabled = NO;
+    if (_knowledgeTimer) {
+        dispatch_source_cancel(_knowledgeTimer);
+        dispatch_release(_knowledgeTimer);
+        _knowledgeTimer = nil;
+    }
+    if (_knowledgePressureSource) {
+        dispatch_source_cancel(_knowledgePressureSource);
+        dispatch_release(_knowledgePressureSource);
+        _knowledgePressureSource = nil;
+    }
+    dispatch_sync(_knowledgeQueue, ^{
+        if (self->_knowledgeTask.running) {
+            [self->_knowledgeTask terminate];
+        }
+        self.knowledgeTask = nil;
+        self.knowledgeRestored = NO;
+        if (self->_knowledgeDatabase) {
+            sqlite3_close(self->_knowledgeDatabase);
+            self->_knowledgeDatabase = NULL;
+        }
+        // A secondary launch never owns this socket.
+        if (self->_lockFile >= 0) {
+            unlink([self knowledgeSocketPath].fileSystemRepresentation);
+        }
+    });
+}
+
+- (NSDictionary *)sendKnowledgeWorkerRequest:(NSDictionary *)request {
+    NSError *error = nil;
+    NSData *encoded = [NSJSONSerialization dataWithJSONObject:request options:0 error:&error];
+    if (!encoded || encoded.length >= 1024 * 1024) {
+        return OmniKnowledgeError(@"knowledge_frame_too_large", @"Knowledge request exceeds its size limit");
+    }
+    NSString *path = [self knowledgeSocketPath];
+    struct sockaddr_un address = { 0 };
+    address.sun_family = AF_UNIX;
+    if (strlen(path.fileSystemRepresentation) >= sizeof(address.sun_path)) {
+        return OmniKnowledgeError(@"knowledge_socket_path", @"Knowledge socket path is too long");
+    }
+    strlcpy(address.sun_path, path.fileSystemRepresentation, sizeof(address.sun_path));
+    const int client = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (client < 0) return OmniKnowledgeError(@"knowledge_unavailable", @"Knowledge socket is unavailable");
+    fcntl(client, F_SETFD, FD_CLOEXEC);
+    const int noSignal = 1;
+    setsockopt(client, SOL_SOCKET, SO_NOSIGPIPE, &noSignal, sizeof(noSignal));
+    const struct timeval timeout = { .tv_sec = 30, .tv_usec = 0 };
+    setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(client, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+    if (connect(client, (struct sockaddr *)&address, sizeof(address)) != 0) {
+        close(client);
+        return OmniKnowledgeError(@"knowledge_starting", @"The knowledge worker is starting; retry shortly");
+    }
+    uid_t peerUID = (uid_t)-1;
+    gid_t peerGID = (gid_t)-1;
+    if (getpeereid(client, &peerUID, &peerGID) != 0 || peerUID != geteuid()) {
+        close(client);
+        return OmniKnowledgeError(@"knowledge_peer", @"Knowledge socket ownership could not be verified");
+    }
+    NSMutableData *frame = [[encoded mutableCopy] autorelease];
+    [frame appendBytes:"\n" length:1];
+    NSUInteger offset = 0;
+    while (offset < frame.length) {
+        const ssize_t count = write(client, (const char *)frame.bytes + offset, frame.length - offset);
+        if (count <= 0) {
+            close(client);
+            return OmniKnowledgeError(@"knowledge_transport", @"Could not send the knowledge request");
+        }
+        offset += (NSUInteger)count;
+    }
+    shutdown(client, SHUT_WR);
+    NSMutableData *responseData = [NSMutableData data];
+    char buffer[16384];
+    BOOL complete = NO;
+    while (responseData.length < OmniKnowledgeFrameLimit) {
+        const ssize_t count = read(client, buffer, sizeof(buffer));
+        if (count <= 0) break;
+        const char *newline = memchr(buffer, '\n', (size_t)count);
+        const NSUInteger length = newline ? (NSUInteger)(newline - buffer) : (NSUInteger)count;
+        [responseData appendBytes:buffer length:length];
+        if (newline) {
+            complete = YES;
+            break;
+        }
+    }
+    close(client);
+    if (!complete || responseData.length >= OmniKnowledgeFrameLimit) {
+        return OmniKnowledgeError(@"knowledge_transport", @"Knowledge worker returned an incomplete or oversized response");
+    }
+    id response = [NSJSONSerialization JSONObjectWithData:responseData options:0 error:nil];
+    if (![response isKindOfClass:[NSDictionary class]] || ![response[@"ok"] isKindOfClass:[NSNumber class]]) {
+        return OmniKnowledgeError(@"knowledge_protocol", @"Knowledge worker returned an invalid response");
+    }
+    return response;
+}
+
+- (BOOL)openKnowledgeDatabase {
+    if (_knowledgeDatabase) return YES;
+    NSString *path = [_supportPath stringByAppendingPathComponent:@"knowledge.sqlite"];
+    if (sqlite3_open_v2(path.fileSystemRepresentation, &_knowledgeDatabase,
+                        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX, NULL) != SQLITE_OK) {
+        if (_knowledgeDatabase) sqlite3_close(_knowledgeDatabase);
+        _knowledgeDatabase = NULL;
+        return NO;
+    }
+    chmod(path.fileSystemRepresentation, 0600);
+    sqlite3_busy_timeout(_knowledgeDatabase, 1000);
+    // The index is tens of gigabytes and every save looks up several of its
+    // indexes: keep their upper levels in memory (64 MB) rather than re-reading
+    // them from disk for every write (SQLite's default is 2 MB).
+    const char *schema = "PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA cache_size=-65536; CREATE TABLE IF NOT EXISTS records (key TEXT PRIMARY KEY, value TEXT NOT NULL);";
+    if (sqlite3_exec(_knowledgeDatabase, schema, NULL, NULL, NULL) != SQLITE_OK) {
+        sqlite3_close(_knowledgeDatabase);
+        _knowledgeDatabase = NULL;
+        return NO;
+    }
+    NSString *projectionSchema = [self knowledgeSchemaSQL];
+    if (!projectionSchema.length || sqlite3_exec(_knowledgeDatabase, projectionSchema.UTF8String,
+                                                 NULL, NULL, NULL) != SQLITE_OK) {
+        sqlite3_close(_knowledgeDatabase);
+        _knowledgeDatabase = NULL;
+        return NO;
+    }
+    chmod([[path stringByAppendingString:@"-wal"] fileSystemRepresentation], 0600);
+    chmod([[path stringByAppendingString:@"-shm"] fileSystemRepresentation], 0600);
+    return YES;
+}
+
+- (NSString *)knowledgeSchemaSQL {
+    NSString *path = [[NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"Helpers"]
+        stringByAppendingPathComponent:@"omni_knowledge_schema.sql"];
+    NSDictionary *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:path error:nil];
+    if (!attributes || [attributes[NSFileSize] unsignedLongLongValue] > 128 * 1024) return nil;
+    return [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
+}
+
+- (BOOL)ensureKnowledgeWorker {
+    if (!self.knowledgeEnabled || _lockFile < 0 || ![self openKnowledgeDatabase]) return NO;
+    if (!_knowledgeTask.running) {
+        self.knowledgeTask = nil;
+        self.knowledgeRestored = NO;
+        NSString *helper = [self knowledgeHelperPath];
+        if (![[NSFileManager defaultManager] fileExistsAtPath:helper]) return NO;
+        // Only this app instance can launch or replace its private worker.
+        unlink([self knowledgeSocketPath].fileSystemRepresentation);
+        NSTask *task = [[[NSTask alloc] init] autorelease];
+        task.launchPath = @"/usr/bin/python3";
+        task.arguments = @[ helper, @"--serve", @"--socket", [self knowledgeSocketPath],
+                            @"--owner-pid", [NSString stringWithFormat:@"%d", getpid()],
+                            @"--read-index", [_supportPath stringByAppendingPathComponent:@"knowledge.sqlite"] ];
+        task.environment = @{ @"HOME": [self knowledgeWorkerHomePath], @"PATH": @"/usr/bin:/bin:/usr/sbin:/sbin",
+                              @"LANG": @"en_US.UTF-8", @"PYTHONDONTWRITEBYTECODE": @"1" };
+        task.standardInput = [NSFileHandle fileHandleWithNullDevice];
+        task.standardOutput = [NSFileHandle fileHandleWithNullDevice];
+        task.standardError = [NSFileHandle fileHandleWithNullDevice];
+        NSError *launchError = nil;
+        if (![task launchAndReturnError:&launchError]) return NO;
+        self.knowledgeTask = task;
+    }
+    if (_knowledgeRestored) return YES;
+    // A no-op probe: knowledge_status counts the whole corpus, which takes
+    // seconds on a cold index and held every request after a launch.
+    NSDictionary *probe = [self sendKnowledgeWorkerRequest:@{ @"op": @"drain_writes" }];
+    if (![probe[@"ok"] isEqual:@YES]) return NO;
+    // The worker reads native projections in place, with a bounded pending
+    // overlay. Startup never copies the entire transcript history into RAM.
+    NSDictionary *restored = [self performKnowledgeWorkerRequest:@{ @"op": @"restore", @"records": @[], @"final": @YES }];
+    self.knowledgeRestored = [restored[@"ok"] isEqual:@YES];
+    return _knowledgeRestored;
+}
+
+- (BOOL)commitKnowledgeResponse:(NSDictionary *)response {
+    return [self commitKnowledgeResponse:response allowance:NSUIntegerMax savedBytes:NULL] == OmniKnowledgeCommitSaved;
+}
+
+// Saves one response's writes in one transaction, or none of them. A batch
+// larger than `allowance` (serialized key and value bytes) is deferred whole:
+// the worker keeps it pending, so a drain only ever saves a prefix of its
+// writes in revision order. A value byte-identical to the saved row is not
+// rewritten: REPLACE would delete and reinsert its projections for nothing.
+- (OmniKnowledgeCommit)commitKnowledgeResponse:(NSDictionary *)response
+                                     allowance:(NSUInteger)allowance
+                                    savedBytes:(NSUInteger *)savedBytes {
+    if (savedBytes) *savedBytes = 0;
+    id writes = response[@"_writes"];
+    if (!writes) return OmniKnowledgeCommitSaved;
+    if (![writes isKindOfClass:[NSArray class]] || [(NSArray *)writes count] > 10000 || !_knowledgeDatabase) return OmniKnowledgeCommitFailed;
+    NSMutableArray *encoded = [NSMutableArray arrayWithCapacity:[(NSArray *)writes count]];
+    NSUInteger total = 0;
+    for (id write in writes) {
+        if (![write isKindOfClass:[NSDictionary class]]) return OmniKnowledgeCommitFailed;
+        id key = write[@"key"];
+        id value = write[@"value"];
+        if (![key isKindOfClass:[NSString class]] || ![key length] || [key length] > 512 ||
+            (![value isKindOfClass:[NSDictionary class]] && value != [NSNull null])) return OmniKnowledgeCommitFailed;
+        BOOL validNamespace = NO;
+        for (NSString *prefix in @[ @"source:", @"message:", @"memory:", @"memory_revision:", @"receipt:", @"vector:", @"metadata:", @"block:",
+                                     @"unblock-audit:" ]) {
+            if ([key hasPrefix:prefix]) validNamespace = YES;
+        }
+        if (!validNamespace) return OmniKnowledgeCommitFailed;
+        if (value == [NSNull null]) {
+            [encoded addObject:[NSNull null]];
+            total += [key lengthOfBytesUsingEncoding:NSUTF8StringEncoding];
+            continue;
+        }
+        NSData *data = [NSJSONSerialization dataWithJSONObject:value options:0 error:nil];
+        if (!data || data.length > 800 * 1024) return OmniKnowledgeCommitFailed;
+        [encoded addObject:data];
+        total += [key lengthOfBytesUsingEncoding:NSUTF8StringEncoding] + data.length;
+    }
+    if (!encoded.count) return OmniKnowledgeCommitSaved;
+    if (total > allowance) return OmniKnowledgeCommitDeferred;
+    if (sqlite3_exec(_knowledgeDatabase, "BEGIN IMMEDIATE", NULL, NULL, NULL) != SQLITE_OK) return OmniKnowledgeCommitFailed;
+    sqlite3_stmt *insert = NULL, *removal = NULL, *existing = NULL;
+    BOOL committed = sqlite3_prepare_v2(_knowledgeDatabase, "INSERT OR REPLACE INTO records(key,value) VALUES(?,?)", -1, &insert, NULL) == SQLITE_OK &&
+                     sqlite3_prepare_v2(_knowledgeDatabase, "DELETE FROM records WHERE key=?", -1, &removal, NULL) == SQLITE_OK &&
+                     sqlite3_prepare_v2(_knowledgeDatabase, "SELECT value FROM records WHERE key=?", -1, &existing, NULL) == SQLITE_OK;
+    unsigned long long skipped = 0;
+    for (NSUInteger index = 0; committed && index < encoded.count; index++) {
+        const char *key = [((NSDictionary *)((NSArray *)writes)[index])[@"key"] UTF8String];
+        NSData *data = encoded[index] == [NSNull null] ? nil : encoded[index];
+        if (!data) {
+            sqlite3_bind_text(removal, 1, key, -1, SQLITE_TRANSIENT);
+            committed = sqlite3_step(removal) == SQLITE_DONE;
+            sqlite3_reset(removal);
+            sqlite3_clear_bindings(removal);
+            continue;
+        }
+        // A delete marker (version-3 messages) always goes through its trigger.
+        const BOOL marker = [((NSDictionary *)((NSArray *)writes)[index])[@"value"][@"_deleted"] isEqual:@YES];
+        BOOL same = NO;
+        if (!marker) {
+            sqlite3_bind_text(existing, 1, key, -1, SQLITE_TRANSIENT);
+            if (sqlite3_step(existing) == SQLITE_ROW) {
+                const void *saved = sqlite3_column_blob(existing, 0);
+                const int length = sqlite3_column_bytes(existing, 0);
+                same = saved && (NSUInteger)length == data.length && memcmp(saved, data.bytes, data.length) == 0;
+            }
+            sqlite3_reset(existing);
+            sqlite3_clear_bindings(existing);
+        }
+        if (same) {
+            skipped++;
+            continue;
+        }
+        sqlite3_bind_text(insert, 1, key, -1, SQLITE_TRANSIENT);
+        sqlite3_bind_text(insert, 2, data.bytes, (int)data.length, SQLITE_TRANSIENT);
+        committed = sqlite3_step(insert) == SQLITE_DONE;
+        sqlite3_reset(insert);
+        sqlite3_clear_bindings(insert);
+    }
+    sqlite3_finalize(insert);
+    sqlite3_finalize(removal);
+    sqlite3_finalize(existing);
+    if (committed) committed = sqlite3_exec(_knowledgeDatabase, "COMMIT", NULL, NULL, NULL) == SQLITE_OK;
+    if (!committed) {
+        sqlite3_exec(_knowledgeDatabase, "ROLLBACK", NULL, NULL, NULL);
+        return OmniKnowledgeCommitFailed;
+    }
+    _knowledgeSkippedWrites += skipped;
+    if (savedBytes) *savedBytes = total;
+    return OmniKnowledgeCommitSaved;
+}
+
+- (NSDictionary *)performKnowledgeWorkerRequest:(NSDictionary *)request {
+    return [self performKnowledgeWorkerRequest:request drain:OmniKnowledgeDrainAll];
+}
+
+- (NSDictionary *)performKnowledgeWorkerRequest:(NSDictionary *)request drain:(OmniKnowledgeDrain)drain {
+    NSDictionary *response = [self sendKnowledgeWorkerRequest:request];
+    NSDictionary *result = response;
+    NSMutableDictionary *publicResult = [[result mutableCopy] autorelease];
+    [publicResult removeObjectsForKeys:@[ @"_writes", @"_revision", @"_more_writes" ]];
+    if (drain == OmniKnowledgeDrainNone) return publicResult;
+    // Inside an indexing tick, saves count against the tick's write allowance.
+    // The first batch of a tick is always admitted, so one record larger than
+    // the allowance still gets through; a later one that does not fit waits.
+    const BOOL budgeted = drain == OmniKnowledgeDrainYielding && _tickBudgeted;
+    for (NSUInteger batch = 0; batch < 64; batch++) {
+        NSUInteger allowance = NSUIntegerMax;
+        if (budgeted && _tickWriteBytes > 0) {
+            allowance = _tickWriteBytes >= _tickBudget.writeBytes ? 0 : _tickBudget.writeBytes - _tickWriteBytes;
+        }
+        NSUInteger saved = 0;
+        const OmniKnowledgeCommit commit = [self commitKnowledgeResponse:response allowance:allowance savedBytes:&saved];
+        if (commit == OmniKnowledgeCommitFailed) {
+            // The worker keeps what could not be saved; produce nothing more until it is.
+            if (drain == OmniKnowledgeDrainYielding) _knowledgeBackpressure = YES;
+            return OmniKnowledgeError(@"knowledge_persistence", @"Knowledge changes could not be saved; retry without changing the request ID");
+        }
+        if (commit == OmniKnowledgeCommitDeferred) {
+            _knowledgeBackpressure = YES;
+            _tickYield = @"write_budget";
+            return publicResult;
+        }
+        _knowledgeSavedBytes += saved;
+        if (budgeted) _tickWriteBytes += saved;
+        if (response[@"_revision"]) {
+            if (![response[@"_revision"] isKindOfClass:[NSNumber class]]) {
+                return OmniKnowledgeError(@"knowledge_protocol", @"Knowledge worker returned an invalid revision");
+            }
+            NSDictionary *ack = [self sendKnowledgeWorkerRequest:@{ @"op": @"ack_writes", @"revision": response[@"_revision"] }];
+            if (![ack[@"ok"] isEqual:@YES]) {
+                return OmniKnowledgeError(@"knowledge_transport", @"Knowledge changes were saved but acknowledgement is pending; retry the same request ID");
+            }
+        }
+        // Indexing writes stay pending in the worker; the next tick saves the rest.
+        const BOOL more = [response[@"_more_writes"] isEqual:@YES];
+        NSString *yield = nil;
+        if (drain == OmniKnowledgeDrainYielding && [self knowledgeRequestsWaiting]) {
+            yield = @"request_waiting";
+        } else if (budgeted && _tickWriteBytes >= _tickBudget.writeBytes) {
+            yield = @"write_budget";
+        } else if (budgeted && [self knowledgeClock] - _tickStarted >= _tickBudget.workSeconds) {
+            yield = @"work_budget";
+        }
+        if (!more || yield) {
+            _knowledgeBackpressure = more;
+            if (more) _tickYield = yield;
+            return publicResult;
+        }
+        response = [self sendKnowledgeWorkerRequest:@{ @"op": @"drain_writes" }];
+        if (![response[@"ok"] isEqual:@YES]) return response;
+    }
+    _knowledgeBackpressure = YES;
+    return OmniKnowledgeError(@"knowledge_backlog", @"Knowledge changes remain pending; retry shortly");
+}
+
+// A read goes straight to a running worker from the caller's thread. It never
+// touches the index database, so it need not wait on the knowledge queue while
+// indexing saves a batch (which can take seconds on a large index); the worker
+// itself is idle then. Returns nil when the queued path must answer instead:
+// not a read, private arguments, a worker that is not up, or a transport error.
+- (NSDictionary *)knowledgeReadResponse:(NSDictionary *)request {
+    if (!OmniIsKnowledgeReadOperation(request[@"op"]) || !self.knowledgeEnabled || !self.knowledgeRestored) return nil;
+    NSMutableDictionary *arguments = [[request mutableCopy] autorelease];
+    [arguments removeObjectsForKeys:[arguments allKeysForObject:[NSNull null]]];
+    for (id key in arguments) {
+        if (![key isKindOfClass:[NSString class]] || [key hasPrefix:@"_"]) return nil;
+    }
+    // Counted as waiting, so indexing sends the worker nothing new until the
+    // read is answered: the read then waits for at most the one call in progress.
+    atomic_fetch_add(&_knowledgeWaiters, 1);
+    @try {
+        NSDictionary *response = [self performKnowledgeWorkerRequest:arguments drain:OmniKnowledgeDrainNone];
+        NSString *code = [response[@"code"] isKindOfClass:[NSString class]] ? response[@"code"] : nil;
+        return [code hasPrefix:@"knowledge_"] ? nil : [self knowledgeResponse:response withMaintenanceFor:arguments];
+    } @catch (NSException *exception) {
+        return nil;
+    } @finally {
+        atomic_fetch_sub(&_knowledgeWaiters, 1);
+    }
+}
+
+- (NSDictionary *)responseForKnowledgeRequest:(id)request {
+    if (![request isKindOfClass:[NSDictionary class]] || !OmniIsKnowledgeOperation(request[@"op"])) {
+        return OmniKnowledgeError(@"invalid_operation", @"Unknown knowledge operation");
+    }
+    @try {
+        NSMutableDictionary *arguments = [[request mutableCopy] autorelease];
+        [arguments removeObjectsForKeys:[arguments allKeysForObject:[NSNull null]]];
+        for (id key in arguments) {
+            if (![key isKindOfClass:[NSString class]] || [key hasPrefix:@"_"]) {
+                return OmniKnowledgeError(@"invalid_argument", @"Private knowledge arguments are not accepted");
+            }
+        }
+        if (![self ensureKnowledgeWorker]) {
+            return OmniKnowledgeError(@"knowledge_unavailable", @"OmniTerm knowledge is starting or unavailable; retry shortly");
+        }
+        NSDictionary *response = [self performKnowledgeWorkerRequest:arguments
+                                                               drain:OmniIsKnowledgeReadOperation(arguments[@"op"]) ? OmniKnowledgeDrainNone : OmniKnowledgeDrainAll];
+        return [self knowledgeResponse:response withMaintenanceFor:arguments];
+    } @catch (NSException *exception) {
+        NSLog(@"OmniScheduler rejected knowledge request: %@", exception.name);
+        return OmniKnowledgeError(@"invalid_request", @"Malformed knowledge request");
+    }
+}
+
+// knowledge_status also reports the indexing tick's admission and progress.
+- (NSDictionary *)knowledgeResponse:(NSDictionary *)response withMaintenanceFor:(NSDictionary *)request {
+    NSDictionary *maintenance = self.knowledgeMaintenance;
+    if (![request[@"op"] isEqual:@"knowledge_status"] || !maintenance ||
+        ![response[@"status"] isKindOfClass:[NSDictionary class]]) return response;
+    NSMutableDictionary *status = [[response[@"status"] mutableCopy] autorelease];
+    status[@"maintenance"] = maintenance;
+    NSMutableDictionary *decorated = [[response mutableCopy] autorelease];
+    decorated[@"status"] = status;
+    return decorated;
+}
+
+// True while a knowledge request is queued behind the indexing tick.
+- (BOOL)knowledgeRequestsWaiting {
+    return atomic_load(&_knowledgeWaiters) > 0;
+}
+
+- (void)tickKnowledge {
+    if (!self.knowledgeEnabled || [self knowledgeRequestsWaiting] || ![self ensureKnowledgeWorker]) return;
+    const double now = [self knowledgeClock];
+    // After a wake (or any long stall) the tick does its normal share, never a
+    // catch-up burst for the time that passed.
+    const BOOL resumed = _lastKnowledgeTick > 0 && now - _lastKnowledgeTick > 60;
+    _lastKnowledgeTick = now;
+    NSDictionary *embedRequest = [self knowledgeEmbedRequest];
+    const NSInteger pressure = [self knowledgeMemoryPressure];
+    _tickBudget = OmniKnowledgeTickBudget(embedRequest, pressure, resumed);
+    _tickBudgeted = YES;
+    _tickStarted = now;
+    _tickWriteBytes = 0;
+    _tickYield = nil;
+    _knowledgeTicks++;
+    @try {
+        [self runKnowledgeTickWithEmbedRequest:embedRequest pressure:pressure];
+    } @finally {
+        _tickBudgeted = NO;
+        self.knowledgeMaintenance = @{ @"tier": @(_tickBudget.tier), @"memory_pressure": @(pressure),
+                                       @"work_seconds": @(round(([self knowledgeClock] - _tickStarted) * 1000) / 1000),
+                                       @"work_budget_seconds": @(_tickBudget.workSeconds),
+                                       @"tick_write_bytes": @(_tickWriteBytes), @"write_budget_bytes": @(_tickBudget.writeBytes),
+                                       @"saved_bytes": @(_knowledgeSavedBytes), @"unchanged_writes_skipped": @(_knowledgeSkippedWrites),
+                                       @"writes_waiting": @(_knowledgeBackpressure), @"last_yield": _tickYield ?: @"complete",
+                                       @"next_phase": OmniKnowledgePhaseName(_knowledgePhase), @"ticks": @(_knowledgeTicks) };
+    }
+}
+
+// True while this tick may start more maintenance.
+- (BOOL)knowledgeTickMayContinue {
+    NSString *reason = nil;
+    if ([self knowledgeRequestsWaiting]) {
+        reason = @"request_waiting";
+    } else if (_knowledgeBackpressure) {
+        reason = @"writes_waiting";
+    } else if (_tickWriteBytes >= _tickBudget.writeBytes) {
+        reason = @"write_budget";
+    } else if ([self knowledgeClock] - _tickStarted >= _tickBudget.workSeconds) {
+        reason = @"work_budget";
+    }
+    if (reason) _tickYield = reason;
+    return reason == nil;
+}
+
+- (void)runKnowledgeTickWithEmbedRequest:(NSDictionary *)embedRequest pressure:(NSInteger)pressure {
+    __block NSArray *sessions = nil;
+    __block NSArray *memorySessions = nil;
+    dispatch_sync(_queue, ^{
+        NSMutableArray *live = [NSMutableArray array];
+        for (NSDictionary *run in [self rowsForSQL:@"SELECT id,provider,session_id,pid,pgid,state,transcript_path FROM runs WHERE state IN ('starting','running')" bindings:@[]]) {
+            NSString *provider = [run[@"provider"] isKindOfClass:[NSString class]] ? run[@"provider"] : nil;
+            NSString *sessionID = [run[@"session_id"] isKindOfClass:[NSString class]] ? run[@"session_id"] : nil;
+            const pid_t group = (pid_t)OmniIntegerValue(run[@"pgid"]);
+            if (!sessionID.length || ![@[ @"claude", @"codex" ] containsObject:provider ?: @""] ||
+                group <= 1 || kill(-group, 0) != 0) continue;
+            NSMutableDictionary *session = [@{ @"session_id": [NSString stringWithFormat:@"%@:%@", provider, sessionID],
+                               @"provider": provider, @"run_id": run[@"id"], @"state": @"running",
+                               @"live_verified": @YES, @"live_evidence": @"native_process_group",
+                               @"pid": @(OmniIntegerValue(run[@"pid"])), @"pgid": @(group) } mutableCopy];
+            NSString *transcriptPath = [run[@"transcript_path"] isKindOfClass:NSString.class] ? run[@"transcript_path"] : nil;
+            if (transcriptPath.length) session[@"transcript_path"] = transcriptPath;
+            [live addObject:session];
+        }
+        sessions = [live copy];
+        NSMutableSet *knownMemorySessions = [NSMutableSet set];
+        for (NSDictionary *run in [self rowsForSQL:@"SELECT provider,session_id,agent_snapshot FROM runs WHERE session_id IS NOT NULL AND agent_snapshot LIKE '%memory_consolidator:v1%'" bindings:@[]]) {
+            NSString *snapshotJSON = [run[@"agent_snapshot"] isKindOfClass:[NSString class]] ? run[@"agent_snapshot"] : nil;
+            NSDictionary *snapshot = snapshotJSON ? [NSJSONSerialization JSONObjectWithData:[snapshotJSON dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil] : nil;
+            NSString *provider = [run[@"provider"] isKindOfClass:[NSString class]] ? run[@"provider"] : nil;
+            NSString *sessionID = [run[@"session_id"] isKindOfClass:[NSString class]] ? run[@"session_id"] : nil;
+            if (OmniIsMemoryConsolidatorDefinition(snapshot) && sessionID.length &&
+                [@[ @"claude", @"codex" ] containsObject:provider ?: @""]) {
+                [knownMemorySessions addObject:[NSString stringWithFormat:@"%@:%@", provider, sessionID]];
+            }
+        }
+        memorySessions = [knownMemorySessions.allObjects copy];
+    });
+    // Exclusions and live sessions are always applied, so no request sees a
+    // consolidator's own messages; indexing then yields to waiting requests.
+    [self performKnowledgeWorkerRequest:@{ @"op": @"update_memory_sessions", @"session_ids": memorySessions ?: @[] } drain:OmniKnowledgeDrainYielding];
+    [memorySessions release];
+    [self performKnowledgeWorkerRequest:@{ @"op": @"update_live_sessions", @"sessions": sessions ?: @[] } drain:OmniKnowledgeDrainYielding];
+    [sessions release];
+    if ([self knowledgeRequestsWaiting]) {
+        _tickYield = @"request_waiting";
+        return;
+    }
+    // Rising pressure releases the worker's rebuildable caches once per level.
+    if (pressure > _relievedPressure) {
+        [self performKnowledgeWorkerRequest:@{ @"op": @"relieve_pressure", @"level": @(MIN(pressure, 2)) } drain:OmniKnowledgeDrainYielding];
+    }
+    _relievedPressure = pressure;
+    // Writes the worker already holds are saved before anything new is made.
+    if (_knowledgeBackpressure) {
+        [self performKnowledgeWorkerRequest:@{ @"op": @"drain_writes" } drain:OmniKnowledgeDrainYielding];
+    }
+    if (_tickBudget.scans <= 0 || _knowledgeBackpressure) {
+        // Session messages are still delivered; no transcript is read.
+        [self performKnowledgeWorkerRequest:@{ @"op": @"scan", @"delivery_only": @YES } drain:OmniKnowledgeDrainYielding];
+        if (!_tickYield) _tickYield = _knowledgeBackpressure ? @"writes_waiting" : @"memory_pressure";
+        return;
+    }
+    [self scanKnowledge];
+    // One maintenance stage always follows the scan, so a scan that spends the
+    // budget cannot starve them; more run while the budget lasts.
+    BOOL worked = NO;
+    for (NSInteger step = 0; step < OmniKnowledgePhaseCount; step++) {
+        const NSInteger phase = (_knowledgePhase + step) % OmniKnowledgePhaseCount;
+        const BOOL admitted = phase == OmniKnowledgePhaseEmbed ? _tickBudget.embed : _tickBudget.maintenance;
+        if (!admitted) continue;
+        if (_knowledgeBackpressure || [self knowledgeRequestsWaiting] || (worked && ![self knowledgeTickMayContinue])) {
+            if ([self knowledgeRequestsWaiting]) {
+                _tickYield = @"request_waiting";
+            } else if (_knowledgeBackpressure) {
+                _tickYield = @"writes_waiting";
+            }
+            _knowledgePhase = phase;
+            return;
+        }
+        worked = YES;
+        [self runKnowledgePhase:phase embedRequest:embedRequest];
+    }
+    _knowledgePhase = (_knowledgePhase + 1) % OmniKnowledgePhaseCount;
+}
+
+// A request waits for at most the one scan in progress, so scans are kept
+// short: 25 files and one megabyte each. More run only within an idle tick's
+// budget.
+- (void)scanKnowledge {
+    for (NSInteger pass = 0; pass < _tickBudget.scans; pass++) {
+        if (pass > 0 && ![self knowledgeTickMayContinue]) return;
+        NSDictionary *scanned = [self performKnowledgeWorkerRequest:@{ @"op": @"scan", @"max_files": @25,
+                                                                        @"byte_budget": @1048576, @"embed": @NO }
+                                                               drain:OmniKnowledgeDrainYielding];
+        if (OmniIntegerValue(scanned[@"backlog_files"]) <= 0) return;
+    }
+}
+
+- (void)runKnowledgePhase:(NSInteger)phase embedRequest:(NSDictionary *)embedRequest {
+    switch (phase) {
+        case OmniKnowledgePhaseEmbed: {
+            // An idle burst runs as short slices with a check between them, so a
+            // search waits for at most one slice rather than the whole burst.
+            NSDictionary *embedded = [self performKnowledgeWorkerRequest:embedRequest drain:OmniKnowledgeDrainYielding];
+            NSInteger slices = MIN(MAX(OmniIntegerValue(embedded[@"slices"]), 1), 16);
+            if (slices > 1) {
+                NSMutableDictionary *followup = [[embedRequest mutableCopy] autorelease];
+                followup[@"followup"] = @YES;
+                for (NSInteger slice = 1; slice < slices; slice++) {
+                    if (![self knowledgeTickMayContinue]) return;
+                    embedded = [self performKnowledgeWorkerRequest:followup drain:OmniKnowledgeDrainYielding];
+                    if (OmniIntegerValue(embedded[@"slices"]) <= 1) return;
+                }
+            }
+            return;
+        }
+        case OmniKnowledgePhaseMemoryTick: {
+            // The hippocampus keeps the Memory page's corpus counts warm and
+            // journals an ingestion snapshot at most every ten minutes.
+            NSDictionary *ticked = [self performKnowledgeWorkerRequest:@{ @"op": @"memory_tick" } drain:OmniKnowledgeDrainYielding];
+            [self raiseKnowledgeNotification:ticked[@"notify"]];
+            return;
+        }
+        default:
+            [self incrementalVacuumKnowledge];
+            return;
+    }
+}
+
+// The helper asks for an Inbox item (the storage budget) in its tick result; it
+// carries a dedupe key, so a repeat within a day replaces the earlier item.
+- (void)raiseKnowledgeNotification:(id)notify {
+    if (![notify isKindOfClass:[NSDictionary class]]) return;
+    NSMutableDictionary *request = [NSMutableDictionary dictionary];
+    for (NSString *key in @[ @"title", @"body", @"severity", @"dedupe_key" ]) {
+        id value = ((NSDictionary *)notify)[key];
+        if ([value isKindOfClass:[NSString class]]) request[key] = value;
+    }
+    if (![request[@"title"] length] || ![request[@"dedupe_key"] length]) return;
+    request[@"include_diff"] = @NO;
+    request[@"kind"] = @"storage";
+    dispatch_sync(_queue, ^{
+        [self createNotification:request];
+    });
+}
+
+// A compacted index (helpers/omni_compact.py) uses incremental auto-vacuum: each
+// tick returns at most this many free pages (16 MB) to the file system, so space
+// freed by deletions or trimmed tool output never piles up (gigabytes come back
+// within an hour) and no step holds the writer for long. Any other index
+// (auto_vacuum none) is left untouched.
+static const int OmniKnowledgeVacuumPages = 4096;
+
+- (BOOL)incrementalVacuumKnowledge {
+    if (!_knowledgeDatabase) return NO;
+    sqlite3_stmt *statement = NULL;
+    sqlite3_int64 mode = 0, freePages = 0;
+    if (sqlite3_prepare_v2(_knowledgeDatabase, "PRAGMA auto_vacuum", -1, &statement, NULL) == SQLITE_OK &&
+        sqlite3_step(statement) == SQLITE_ROW) {
+        mode = sqlite3_column_int64(statement, 0);
+    }
+    sqlite3_finalize(statement);
+    if (mode != 2) return NO;
+    statement = NULL;
+    if (sqlite3_prepare_v2(_knowledgeDatabase, "PRAGMA freelist_count", -1, &statement, NULL) == SQLITE_OK &&
+        sqlite3_step(statement) == SQLITE_ROW) {
+        freePages = sqlite3_column_int64(statement, 0);
+    }
+    sqlite3_finalize(statement);
+    if (freePages <= 0) return NO;
+    NSString *sql = [NSString stringWithFormat:@"PRAGMA incremental_vacuum(%d)", OmniKnowledgeVacuumPages];
+    return sqlite3_exec(_knowledgeDatabase, sql.UTF8String, NULL, NULL, NULL) == SQLITE_OK;
+}
+
+- (NSArray *)rowsForSQL:(NSString *)sql bindings:(NSArray *)bindings {
+    sqlite3_stmt *statement = NULL;
+    NSMutableArray *rows = [NSMutableArray array];
+    if (sqlite3_prepare_v2(_database, sql.UTF8String, -1, &statement, NULL) != SQLITE_OK) {
+        return rows;
+    }
+    [bindings enumerateObjectsUsingBlock:^(id value, NSUInteger index, BOOL *stop) {
+        if ([value isKindOfClass:[NSNumber class]]) {
+            sqlite3_bind_double(statement, (int)index + 1, [value doubleValue]);
+        } else if (value == [NSNull null]) {
+            sqlite3_bind_null(statement, (int)index + 1);
+        } else {
+            sqlite3_bind_text(statement, (int)index + 1, [value UTF8String], -1, SQLITE_TRANSIENT);
+        }
+    }];
+    while (sqlite3_step(statement) == SQLITE_ROW) {
+        NSMutableDictionary *row = [NSMutableDictionary dictionary];
+        for (int column = 0; column < sqlite3_column_count(statement); column++) {
+            NSString *key = [NSString stringWithUTF8String:sqlite3_column_name(statement, column)];
+            const int type = sqlite3_column_type(statement, column);
+            if (type == SQLITE_INTEGER) row[key] = @(sqlite3_column_int64(statement, column));
+            else if (type == SQLITE_FLOAT) row[key] = @(sqlite3_column_double(statement, column));
+            else if (type == SQLITE_TEXT) row[key] = [NSString stringWithUTF8String:(const char *)sqlite3_column_text(statement, column)];
+            else row[key] = [NSNull null];
+        }
+        [rows addObject:row];
+    }
+    sqlite3_finalize(statement);
+    return rows;
+}
+
+- (BOOL)runSQL:(NSString *)sql bindings:(NSArray *)bindings {
+    sqlite3_stmt *statement = NULL;
+    if (sqlite3_prepare_v2(_database, sql.UTF8String, -1, &statement, NULL) != SQLITE_OK) return NO;
+    [bindings enumerateObjectsUsingBlock:^(id value, NSUInteger index, BOOL *stop) {
+        if ([value isKindOfClass:[NSNumber class]]) sqlite3_bind_double(statement, (int)index + 1, [value doubleValue]);
+        else if (value == [NSNull null]) sqlite3_bind_null(statement, (int)index + 1);
+        else sqlite3_bind_text(statement, (int)index + 1, [value UTF8String], -1, SQLITE_TRANSIENT);
+    }];
+    const BOOL ok = sqlite3_step(statement) == SQLITE_DONE;
+    sqlite3_finalize(statement);
+    return ok;
+}
+
+#pragma mark - Agent names and appearance
+
+// Rules shared with helpers/omni (tests/fixtures/agent_appearance.json).
+static NSString *const OmniAppearanceError = @"invalid_appearance";
+static const NSUInteger OmniAgentNameLimit = 100;
+static const NSUInteger OmniGroupSegmentLimit = 40;
+static const NSUInteger OmniGroupDepthLimit = 2;
+static const NSUInteger OmniIconSymbolLimit = 64;
+
+// C0, DEL and C1 only. NSCharacterSet's control set also holds format
+// characters, which emoji sequences need (zero-width joiner, tags).
+// Lengths are counted in code points, as helpers/omni counts them.
+static NSUInteger OmniCodePointLength(NSString *string) {
+    return [string lengthOfBytesUsingEncoding:NSUTF32LittleEndianStringEncoding] / 4;
+}
+
+static BOOL OmniHasControlCharacters(NSString *string) {
+    static NSCharacterSet *controls;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        NSMutableCharacterSet *set = [[NSMutableCharacterSet alloc] init];
+        [set addCharactersInRange:NSMakeRange(0x00, 0x20)];
+        [set addCharactersInRange:NSMakeRange(0x7F, 0x21)];
+        controls = [set copy];
+        [set release];
+    });
+    return [string rangeOfCharacterFromSet:controls].location != NSNotFound;
+}
+
+// A valid agent name, trimmed, or nil.
+static NSString *OmniValidAgentName(id value) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    NSString *name = [value stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    if (!name.length || OmniCodePointLength(name) > OmniAgentNameLimit || OmniHasControlCharacters(name)) {
+        return nil;
+    }
+    return name;
+}
+
+// "Section" or "Section/Subsection" with trimmed segments, or nil.
+static NSString *OmniValidGroupPath(id value) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    NSArray<NSString *> *parts = [value componentsSeparatedByString:@"/"];
+    if (parts.count == 0 || parts.count > OmniGroupDepthLimit) {
+        return nil;
+    }
+    NSMutableArray<NSString *> *segments = [NSMutableArray array];
+    for (NSString *part in parts) {
+        NSString *segment = [part stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+        if (!segment.length || OmniCodePointLength(segment) > OmniGroupSegmentLimit || OmniHasControlCharacters(segment)) {
+            return nil;
+        }
+        [segments addObject:segment];
+    }
+    return [segments componentsJoinedByString:@"/"];
+}
+
+// ICU's \\X is an extended grapheme cluster, so ZWJ and tag sequences count as one.
+static BOOL OmniIsSingleGrapheme(NSString *string) {
+    static NSRegularExpression *expression;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        expression = [[NSRegularExpression alloc] initWithPattern:@"^\\X$" options:0 error:nil];
+    });
+    return [expression numberOfMatchesInString:string options:0 range:NSMakeRange(0, string.length)] == 1;
+}
+
+// "sf:<symbol>" (the allow-list is the clients') or "emoji:<one emoji>".
+static NSString *OmniValidIcon(id value) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    NSString *icon = value;
+    if ([icon hasPrefix:@"sf:"]) {
+        NSString *symbol = [icon substringFromIndex:3];
+        NSCharacterSet *allowed = [NSCharacterSet characterSetWithCharactersInString:@"abcdefghijklmnopqrstuvwxyz0123456789."];
+        if (!symbol.length || symbol.length > OmniIconSymbolLimit ||
+            [symbol rangeOfCharacterFromSet:allowed.invertedSet].location != NSNotFound) {
+            return nil;
+        }
+        return icon;
+    }
+    if ([icon hasPrefix:@"emoji:"]) {
+        NSString *emoji = [icon substringFromIndex:6];
+        if (!emoji.length || emoji.length > 32 || OmniHasControlCharacters(emoji) ||
+            !OmniIsSingleGrapheme(emoji)) {
+            return nil;
+        }
+        // One grapheme that is pictographic: outside ASCII and Latin-1 text,
+        // or a keycap / emoji-presentation sequence.
+        const unichar first = [emoji characterAtIndex:0];
+        const BOOL presentation = [emoji rangeOfString:@"️"].location != NSNotFound ||
+                                  [emoji rangeOfString:@"⃣"].location != NSNotFound;
+        if (first < 0x2000 && !presentation) {
+            return nil;
+        }
+        if ([emoji rangeOfCharacterFromSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].location != NSNotFound) {
+            return nil;
+        }
+        return icon;
+    }
+    return nil;
+}
+
+static NSString *OmniValidColor(id value) {
+    // The same names as AGENT_COLORS in helpers/omni and OmniAgentColor.
+    NSArray *colors = @[ @"red", @"rose", @"pink", @"orange", @"brown", @"yellow", @"lime", @"green",
+                         @"mint", @"teal", @"cyan", @"blue", @"indigo", @"purple", @"slate", @"gray" ];
+    return [colors containsObject:value ?: @""] ? value : nil;
+}
+
+// Normalizes group, icon and color in place. An empty string or null clears a
+// field. Returns the name of the first invalid field, or nil.
+static NSString *OmniNormalizeAppearance(NSMutableDictionary *agent) {
+    NSDictionary *validators = @{ @"group": @"group", @"icon": @"icon", @"color": @"color" };
+    for (NSString *key in validators) {
+        id value = agent[key];
+        if (!value) {
+            continue;
+        }
+        // "" clears a field; a group of only spaces does too.
+        const BOOL blank = [value isKindOfClass:[NSString class]] &&
+            ![([key isEqualToString:@"group"] ? [value stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet] : value) length];
+        if (value == [NSNull null] || blank) {
+            [agent removeObjectForKey:key];
+            continue;
+        }
+        NSString *normalized = nil;
+        if ([key isEqualToString:@"group"]) {
+            normalized = OmniValidGroupPath(value);
+        } else if ([key isEqualToString:@"icon"]) {
+            normalized = OmniValidIcon(value);
+        } else {
+            normalized = OmniValidColor(value);
+        }
+        if (!normalized) {
+            return key;
+        }
+        agent[key] = normalized;
+    }
+    return nil;
+}
+
+// `field` tells a client which control the message belongs to.
+static NSDictionary *OmniAppearanceFailure(NSString *field, NSString *message) {
+    return @{ @"ok": @NO, @"code": OmniAppearanceError, @"field": field,
+              @"error": message ?: [NSString stringWithFormat:@"Invalid %@", field] };
+}
+
+static NSDictionary *OmniInvalidName(void) {
+    return @{ @"ok": @NO, @"code": @"invalid_name",
+              @"error": @"Names must be 1 to 100 characters with no control characters" };
+}
+
+// The group path of `group` after moving everything under `from` to `to`
+// ("" ungroups), or nil if it is not under `from`. Sets *tooDeep when the
+// result would exceed two levels.
+static NSString *OmniRenamedGroup(NSString *group, NSString *from, NSString *to, BOOL *tooDeep) {
+    NSString *rest = nil;
+    if ([group isEqualToString:from]) {
+        rest = @"";
+    } else if ([group hasPrefix:[from stringByAppendingString:@"/"]]) {
+        rest = [group substringFromIndex:from.length + 1];
+    } else {
+        return nil;
+    }
+    NSString *result = to.length ? (rest.length ? [NSString stringWithFormat:@"%@/%@", to, rest] : to) : rest;
+    if (result.length && !OmniValidGroupPath(result)) {
+        *tooDeep = YES;
+    }
+    return result;
+}
+
+// A sidebar item key, "agent:<name>" or "group:<path>", normalized, or nil.
+static NSString *OmniValidSidebarKey(id value) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    if ([value hasPrefix:@"agent:"]) {
+        NSString *name = OmniValidAgentName([value substringFromIndex:6]);
+        return name ? [@"agent:" stringByAppendingString:name] : nil;
+    }
+    if ([value hasPrefix:@"group:"]) {
+        NSString *group = OmniValidGroupPath([value substringFromIndex:6]);
+        return group ? [@"group:" stringByAppendingString:group] : nil;
+    }
+    return nil;
+}
+
+// Valid, normalized, deduplicated sidebar keys in order, or nil if any is invalid.
+static NSArray<NSString *> *OmniValidSidebarKeyList(id value) {
+    if (![value isKindOfClass:[NSArray class]]) {
+        return nil;
+    }
+    NSMutableOrderedSet<NSString *> *keys = [NSMutableOrderedSet orderedSet];
+    for (id entry in value) {
+        NSString *key = OmniValidSidebarKey(entry);
+        if (!key) {
+            return nil;
+        }
+        [keys addObject:key];
+    }
+    return keys.array;
+}
+
+// Valid, trimmed, deduplicated agent names in order, or nil if any is invalid.
+static NSArray<NSString *> *OmniValidNameList(id value) {
+    if (![value isKindOfClass:[NSArray class]]) {
+        return nil;
+    }
+    NSMutableOrderedSet<NSString *> *names = [NSMutableOrderedSet orderedSet];
+    for (id entry in value) {
+        NSString *name = OmniValidAgentName(entry);
+        if (!name) {
+            return nil;
+        }
+        [names addObject:name];
+    }
+    return names.array;
+}
+
+// Valid, deduplicated group paths in order, or nil if any is invalid.
+static NSArray<NSString *> *OmniValidGroupList(id value) {
+    if (![value isKindOfClass:[NSArray class]]) {
+        return nil;
+    }
+    NSMutableOrderedSet<NSString *> *groups = [NSMutableOrderedSet orderedSet];
+    for (id entry in value) {
+        NSString *group = OmniValidGroupPath(entry);
+        if (!group) {
+            return nil;
+        }
+        [groups addObject:group];
+    }
+    return groups.array;
+}
+
+- (NSString *)definitionJSONForAgent:(NSDictionary *)agent {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:[self configurationForAgent:agent]
+                                                   options:NSJSONWritingSortedKeys
+                                                     error:nil];
+    return [[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease];
+}
+
+- (NSDictionary *)agentNotFound {
+    return @{ @"ok": @NO, @"code": @"agent_not_found", @"error": @"Agent not found" };
+}
+
+// Writes the agent's file, then its row's definition. Schedule state is kept.
+- (BOOL)storeAgentDefinition:(NSDictionary *)agent {
+    if (![self writeAgentFile:agent]) {
+        return NO;
+    }
+    self.agentFilesFingerprint = nil;
+    return [self runSQL:@"UPDATE agents SET definition=? WHERE name=?"
+               bindings:@[ [self definitionJSONForAgent:agent], agent[@"name"] ]];
+}
+
+// Rewrites the sidebar's mixed order: `transform` returns a key's new value,
+// or "" to drop it. Duplicates created by the rewrite keep the first place.
+- (void)rewriteSidebarOrder:(NSString *(^)(NSString *key))transform {
+    NSArray<NSString *> *items = [self settings][@"sidebar_order"];
+    NSMutableOrderedSet<NSString *> *rewritten = [NSMutableOrderedSet orderedSet];
+    for (NSString *key in items) {
+        NSString *value = transform(key) ?: key;
+        if (value.length) {
+            [rewritten addObject:value];
+        }
+    }
+    if (![rewritten.array isEqualToArray:items]) {
+        [self updateSettings:@{ @"sidebar_order": rewritten.array } error:nil];
+    }
+}
+
+// Group keys in the mixed order follow a renamed group. A dissolved group's
+// slot is taken by what it held: its promoted subgroups and its agents, those
+// already in the order keeping their relative order, then the rest (groups,
+// then agents, alphabetically).
+- (void)rewriteSidebarOrderForGroup:(NSString *)from to:(NSString *)to children:(NSSet<NSString *> *)childKeys {
+    NSString *fromKey = [@"group:" stringByAppendingString:from];
+    NSArray<NSString *> *items = [self settings][@"sidebar_order"];
+    NSString *(^promote)(NSString *) = ^NSString *(NSString *key) {
+        if (![key hasPrefix:@"group:"]) {
+            return key;
+        }
+        BOOL ignored = NO;
+        NSString *renamed = OmniRenamedGroup([key substringFromIndex:6], from, to, &ignored);
+        return renamed ? (renamed.length ? [@"group:" stringByAppendingString:renamed] : @"") : key;
+    };
+    if (to.length || ![items containsObject:fromKey]) {
+        [self rewriteSidebarOrder:^NSString *(NSString *key) {
+            return promote(key);
+        }];
+        return;
+    }
+    NSMutableArray<NSString *> *listed = [NSMutableArray array];
+    for (NSString *key in items) {
+        NSString *value = promote(key);
+        if (![key isEqualToString:fromKey] && [childKeys containsObject:value] && ![listed containsObject:value]) {
+            [listed addObject:value];
+        }
+    }
+    NSMutableArray<NSString *> *unlisted = [[[childKeys allObjects] mutableCopy] autorelease];
+    [unlisted removeObjectsInArray:listed];
+    [unlisted sortUsingComparator:^NSComparisonResult(NSString *a, NSString *b) {
+        const BOOL aGroup = [a hasPrefix:@"group:"];
+        const BOOL bGroup = [b hasPrefix:@"group:"];
+        if (aGroup != bGroup) {
+            return aGroup ? NSOrderedAscending : NSOrderedDescending;
+        }
+        return [[a substringFromIndex:6] localizedStandardCompare:[b substringFromIndex:6]];
+    }];
+    NSMutableOrderedSet<NSString *> *result = [NSMutableOrderedSet orderedSet];
+    for (NSString *key in items) {
+        if ([key isEqualToString:fromKey]) {
+            [result addObjectsFromArray:listed];
+            [result addObjectsFromArray:unlisted];
+            continue;
+        }
+        NSString *value = promote(key);
+        if (value.length && ![listed containsObject:value]) {
+            [result addObject:value];
+        }
+    }
+    if (![result.array isEqualToArray:items]) {
+        [self updateSettings:@{ @"sidebar_order": result.array } error:nil];
+    }
+}
+
+// Renames an agent everywhere: its file, its row (keeping enabled, next and
+// last run), its runs and its notifications. A live run's tab keeps the old
+// OMNITERM_AGENT in its environment; the run row carries the new name.
+- (NSDictionary *)renameAgent:(id)oldValue to:(id)newValue {
+    NSString *oldName = [oldValue isKindOfClass:[NSString class]] ? oldValue : nil;
+    NSString *newName = OmniValidAgentName(newValue);
+    if (!oldName.length || !newName) {
+        return OmniInvalidName();
+    }
+    NSDictionary *row = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ oldName ]].firstObject;
+    if (!row) {
+        return [self agentNotFound];
+    }
+    if ([newName isEqualToString:oldName]) {
+        return @{ @"ok": @YES, @"agent": [self decodedAgentRow:row] };
+    }
+    if ([self rowsForSQL:@"SELECT name FROM agents WHERE name=?" bindings:@[ newName ]].count ||
+        [[NSFileManager defaultManager] fileExistsAtPath:[self agentPathForName:newName]]) {
+        return @{ @"ok": @NO, @"code": @"agent_exists", @"error": @"An agent with that name already exists" };
+    }
+    NSMutableDictionary *agent = [[[self decodedAgentRow:row] mutableCopy] autorelease];
+    agent[@"name"] = newName;
+    NSString *newPath = [self agentPathForName:newName];
+    if (![self writeAgentFile:agent]) {
+        return @{ @"ok": @NO, @"code": @"write_failed", @"error": @"Could not write agent configuration" };
+    }
+    // Runs reference agents with ON DELETE CASCADE: the new row must exist and
+    // the runs must move before the old row goes.
+    id null = [NSNull null];
+    [self execute:@"BEGIN IMMEDIATE"];
+    BOOL ok = [self runSQL:@"INSERT INTO agents(name,definition,enabled,next_run,last_run) VALUES(?,?,?,?,?)"
+                  bindings:@[ newName, [self definitionJSONForAgent:agent], row[@"enabled"] ?: @YES,
+                              row[@"next_run"] ?: null, row[@"last_run"] ?: null ]];
+    ok = ok && [self runSQL:@"UPDATE runs SET agent=? WHERE agent=?" bindings:@[ newName, oldName ]];
+    ok = ok && [self runSQL:@"UPDATE notifications SET agent=? WHERE agent=?" bindings:@[ newName, oldName ]];
+    ok = ok && [self runSQL:@"DELETE FROM agents WHERE name=?" bindings:@[ oldName ]];
+    if (!ok) {
+        [self execute:@"ROLLBACK"];
+        [[NSFileManager defaultManager] removeItemAtPath:newPath error:nil];
+        return @{ @"ok": @NO, @"code": @"write_failed", @"error": @"Could not rename the agent" };
+    }
+    [self execute:@"COMMIT"];
+    [[NSFileManager defaultManager] removeItemAtPath:[self agentPathForName:oldName] error:nil];
+    self.agentFilesFingerprint = nil;
+    NSMutableArray *order = [[[self settings][@"sidebar_agent_order"] mutableCopy] autorelease];
+    const NSUInteger position = [order indexOfObject:oldName];
+    if (position != NSNotFound) {
+        [order removeObject:newName];
+        [order replaceObjectAtIndex:[order indexOfObject:oldName] withObject:newName];
+        [self updateSettings:@{ @"sidebar_agent_order": order } error:nil];
+    }
+    NSString *oldKey = [@"agent:" stringByAppendingString:oldName];
+    NSString *newKey = [@"agent:" stringByAppendingString:newName];
+    [self rewriteSidebarOrder:^NSString *(NSString *key) {
+        return [key isEqualToString:oldKey] ? newKey : nil;
+    }];
+    [self notificationsDidChange];
+    return @{ @"ok": @YES,
+              @"agent": [self decodedAgentRow:[self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ newName ]].firstObject] };
+}
+
+// Absent fields are unchanged; "" clears one.
+- (NSDictionary *)setAppearance:(NSDictionary *)request forAgent:(id)nameValue {
+    NSString *name = [nameValue isKindOfClass:[NSString class]] ? nameValue : nil;
+    NSDictionary *row = name ? [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ name ]].firstObject : nil;
+    if (!row) {
+        return [self agentNotFound];
+    }
+    NSMutableDictionary *agent = [[[self decodedAgentRow:row] mutableCopy] autorelease];
+    for (NSString *key in @[ @"group", @"icon", @"color" ]) {
+        if (request[key]) {
+            agent[key] = request[key];
+        }
+    }
+    NSString *invalidField = OmniNormalizeAppearance(agent);
+    if (invalidField) {
+        return OmniAppearanceFailure(invalidField, nil);
+    }
+    if (![self storeAgentDefinition:agent]) {
+        return @{ @"ok": @NO, @"code": @"write_failed", @"error": @"Could not write agent configuration" };
+    }
+    [self notificationsDidChange];
+    return @{ @"ok": @YES,
+              @"agent": [self decodedAgentRow:[self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ name ]].firstObject] };
+}
+
+// Moves every agent in `from` or below it to `to` ("" ungroups), and renames
+// the matching entries of the sidebar's group list.
+- (NSDictionary *)renameGroup:(id)fromValue to:(id)toValue {
+    NSString *from = OmniValidGroupPath(fromValue);
+    NSString *to = ([toValue isKindOfClass:[NSString class]] && ![toValue length]) ? @"" : OmniValidGroupPath(toValue);
+    if (!from || !to) {
+        return OmniAppearanceFailure(@"group", @"from and to must be group paths (to may be empty)");
+    }
+    NSMutableArray<NSMutableDictionary *> *moved = [NSMutableArray array];
+    // What a dissolved group leaves behind at its level, for the mixed order.
+    NSMutableSet<NSString *> *childKeys = [NSMutableSet set];
+    for (NSDictionary *row in [self rowsForSQL:@"SELECT * FROM agents" bindings:@[]]) {
+        NSMutableDictionary *agent = [[[self decodedAgentRow:row] mutableCopy] autorelease];
+        NSString *group = [agent[@"group"] isKindOfClass:[NSString class]] ? agent[@"group"] : nil;
+        BOOL tooDeep = NO;
+        NSString *renamed = group ? OmniRenamedGroup(group, from, to, &tooDeep) : nil;
+        if (tooDeep) {
+            return OmniAppearanceFailure(@"group", @"Groups can be at most two levels deep");
+        }
+        if (!renamed) {
+            continue;
+        }
+        if (!to.length) {
+            [childKeys addObject:renamed.length ? [@"group:" stringByAppendingString:renamed]
+                                                : [@"agent:" stringByAppendingString:agent[@"name"]]];
+        }
+        if (renamed.length) {
+            agent[@"group"] = renamed;
+        } else {
+            [agent removeObjectForKey:@"group"];
+        }
+        [moved addObject:agent];
+    }
+    NSMutableArray<NSString *> *groups = [NSMutableArray array];
+    for (NSString *group in [self settings][@"sidebar_groups"]) {
+        BOOL tooDeep = NO;
+        NSString *renamed = OmniRenamedGroup(group, from, to, &tooDeep);
+        if (tooDeep) {
+            return OmniAppearanceFailure(@"group", @"Groups can be at most two levels deep");
+        }
+        NSString *entry = renamed ?: group;
+        if (entry.length && ![groups containsObject:entry]) {
+            [groups addObject:entry];
+        }
+        if (!to.length && renamed.length) {
+            [childKeys addObject:[@"group:" stringByAppendingString:renamed]];
+        }
+    }
+    for (NSMutableDictionary *agent in moved) {
+        if (![self storeAgentDefinition:agent]) {
+            return @{ @"ok": @NO, @"code": @"write_failed", @"error": @"Could not write agent configuration" };
+        }
+    }
+    if (![groups isEqualToArray:[self settings][@"sidebar_groups"]]) {
+        [self updateSettings:@{ @"sidebar_groups": groups } error:nil];
+    }
+    [self rewriteSidebarOrderForGroup:from to:to children:childKeys];
+    [self notificationsDidChange];
+    return @{ @"ok": @YES, @"count": @(moved.count) };
+}
+
+// Validate lifecycle controls at every persistence boundary, including direct files.
+static NSString *OmniNormalizeLifecycle(NSMutableDictionary *agent) {
+    if (agent[@"kind"] && ![@[ @"scheduled", @"loop" ] containsObject:agent[@"kind"]]) return @"kind";
+    if (agent[@"session_policy"] && ![@[ @"fresh", @"resume" ] containsObject:agent[@"session_policy"]]) return @"session_policy";
+    if (agent[@"compact_on_end"] && CFGetTypeID((CFTypeRef)agent[@"compact_on_end"]) != CFBooleanGetTypeID()) return @"compact_on_end";
+    for (NSString *key in @[ @"run_budget_seconds", @"wrap_up_seconds" ]) {
+        id value = agent[key];
+        if (value && (![value isKindOfClass:[NSNumber class]] || CFGetTypeID((CFTypeRef)value) == CFBooleanGetTypeID() ||
+                      !isfinite([value doubleValue]) || [value doubleValue] < 0 || [value doubleValue] > 604800 ||
+                      floor([value doubleValue]) != [value doubleValue])) return key;
+    }
+    // Successive occurrences continue one provider session unless an agent
+    // explicitly asks for a fresh one each time.
+    if (!agent[@"session_policy"]) agent[@"session_policy"] = @"resume";
+    if ([agent[@"kind"] isEqual:@"loop"]) {
+        agent[@"overlap"] = @"parallel";
+        agent[@"session_policy"] = @"resume";
+        if (!agent[@"timeout_seconds"]) agent[@"timeout_seconds"] = @86400;
+        if (!agent[@"run_budget_seconds"]) agent[@"run_budget_seconds"] = @600;
+        if (!agent[@"wrap_up_seconds"]) agent[@"wrap_up_seconds"] = @120;
+    }
+    // The runner uses a two-minute warning even when a scheduled agent omits
+    // the field. Validate that effective default, not Objective-C's nil -> 0.
+    NSNumber *warning = agent[@"wrap_up_seconds"] ?: @120;
+    if ([agent[@"run_budget_seconds"] doubleValue] > 0 && warning.doubleValue > [agent[@"run_budget_seconds"] doubleValue]) return @"wrap_up_seconds";
+    return nil;
+}
+
+- (NSDictionary *)decodedAgentRow:(NSDictionary *)row {
+    NSData *data = [row[@"definition"] dataUsingEncoding:NSUTF8StringEncoding];
+    NSMutableDictionary *agent = [[NSJSONSerialization JSONObjectWithData:data options:NSJSONReadingMutableContainers error:nil] mutableCopy];
+    OmniNormalizeLifecycle(agent);
+    agent[@"enabled"] = @([row[@"enabled"] boolValue]);
+    agent[@"next_run"] = row[@"next_run"];
+    agent[@"last_run"] = row[@"last_run"];
+    return [agent autorelease];
+}
+
+- (NSDictionary *)configurationForAgent:(NSDictionary *)agent {
+    NSMutableDictionary *configuration = [[agent mutableCopy] autorelease];
+    [configuration removeObjectForKey:@"next_run"];
+    [configuration removeObjectForKey:@"last_run"];
+    [configuration removeObjectForKey:@"timezone"];
+    return configuration;
+}
+
+- (NSString *)agentPathForName:(NSString *)name {
+    NSMutableCharacterSet *allowed = [[[NSCharacterSet alphanumericCharacterSet] mutableCopy] autorelease];
+    [allowed addCharactersInString:@"-_"];
+    // Everything but letters, digits, "-" and "_" is percent-encoded, so "/"
+    // and "." never reach the file name and no name can leave the directory.
+    NSString *filename = [name stringByAddingPercentEncodingWithAllowedCharacters:allowed];
+    return [_agentsPath stringByAppendingPathComponent:[filename stringByAppendingPathExtension:@"json"]];
+}
+
+- (BOOL)writeAgentFile:(NSDictionary *)agent {
+    NSMutableDictionary *configuration = [[[self configurationForAgent:agent] mutableCopy] autorelease];
+    if (OmniNormalizeLifecycle(configuration)) return NO;
+    NSData *data = [NSJSONSerialization dataWithJSONObject:configuration
+                                                   options:(NSJSONWritingPrettyPrinted | NSJSONWritingSortedKeys)
+                                                     error:nil];
+    NSString *path = [self agentPathForName:agent[@"name"]];
+    const BOOL ok = [data writeToFile:path options:NSDataWritingAtomic error:nil];
+    if (ok) chmod(path.fileSystemRepresentation, 0600);
+    return ok;
+}
+
+#pragma mark - Settings validation
+
+// Keys a person changes through Settings, the CLI or `set_settings`. The
+// sidebar keys and the layout have their own operations; the global shortcut
+// and login launch have app side effects, so only the app writes them.
+static NSArray<NSString *> *OmniSettableSettingKeys(void) {
+    return @[ @"default_timeout_seconds", @"retained_run_tabs", @"timezone",
+              @"double_escape_to_hide", @"double_escape_interval_ms", @"summaries", @"summary_model",
+              @"notifications", @"agent_defaults", @"unblocker", @"projects", @"agent_folders",
+              @"session_folders" ];
+}
+
+static BOOL OmniIsBoolean(id value) {
+    return [value isKindOfClass:[NSNumber class]] && CFGetTypeID((CFTypeRef)value) == CFBooleanGetTypeID();
+}
+
+static BOOL OmniIsWholeNumber(id value) {
+    return [value isKindOfClass:[NSNumber class]] && !OmniIsBoolean(value) && isfinite([value doubleValue]) &&
+           floor([value doubleValue]) == [value doubleValue];
+}
+
+// A model or permission value is passed to a provider CLI; it must not read as a flag.
+static NSString *OmniSettingWord(id value, NSUInteger limit) {
+    if (![value isKindOfClass:[NSString class]]) return nil;
+    NSString *trimmed = [value stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    if (trimmed.length > limit || [trimmed hasPrefix:@"-"]) return nil;
+    if ([trimmed rangeOfCharacterFromSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].location != NSNotFound) return nil;
+    return trimmed;
+}
+
+static NSArray<NSString *> *OmniNotificationLevelNames(void) {
+    return @[ @"urgent", @"attention", @"info" ];
+}
+
+static NSArray<NSString *> *OmniNotificationKindNames(void) {
+    return @[ @"agent", @"compaction", @"wrap_up", @"loop_continuation", @"storage", @"run_limit" ];
+}
+
+static NSDictionary *OmniDefaultNotificationSettings(void) {
+    NSMutableDictionary *kinds = [NSMutableDictionary dictionary];
+    for (NSString *kind in OmniNotificationKindNames()) kinds[kind] = @"follow";
+    return @{ @"muted_until": @0,
+              @"levels": @{ @"urgent": @{ @"banner": @YES, @"sound": @YES, @"count": @YES },
+                            @"attention": @{ @"banner": @NO, @"sound": @NO, @"count": @YES },
+                            @"info": @{ @"banner": @NO, @"sound": @NO, @"count": @NO } },
+              @"kinds": kinds,
+              @"agents": @{} };
+}
+
+static NSDictionary *OmniDefaultAgentDefaults(void) {
+    return @{ @"provider": @"claude",
+              @"models": @{ @"claude": @"", @"codex": @"" },
+              @"permission_modes": @{ @"claude": @"", @"codex": @"" },
+              @"overlap": @"replace" };
+}
+
+// Permission modes a default may hold. The dangerous modes are left out: only a
+// person sets them, per agent, in the editor or the agent file.
+static NSDictionary<NSString *, NSArray<NSString *> *> *OmniDefaultPermissionModes(void) {
+    return @{ @"claude": @[ @"", @"auto", @"acceptEdits", @"manual", @"dontAsk", @"plan" ],
+              @"codex": @[ @"", @"untrusted", @"on-request", @"never" ] };
+}
+
+// Values in `changes` replace those in `base`; nested dictionaries merge.
+static NSDictionary *OmniMergedSettingsDictionary(NSDictionary *base, NSDictionary *changes) {
+    NSMutableDictionary *merged = [NSMutableDictionary dictionaryWithDictionary:base ?: @{}];
+    for (id key in changes) {
+        id value = changes[key];
+        if ([value isKindOfClass:[NSDictionary class]] && [merged[key] isKindOfClass:[NSDictionary class]]) {
+            merged[key] = OmniMergedSettingsDictionary(merged[key], value);
+        } else {
+            merged[key] = value;
+        }
+    }
+    return merged;
+}
+
+// Returns the notification settings with every field present. Strict: any
+// invalid field fails (nil, with its name in `invalid`). Lenient: an invalid
+// field falls back to its default, so a hand-edited file still loads.
+static NSDictionary *OmniValidNotificationSettings(id value, BOOL strict, NSString **invalid) {
+    NSDictionary *defaults = OmniDefaultNotificationSettings();
+    NSDictionary *input = [value isKindOfClass:[NSDictionary class]] ? value : @{};
+    if (strict && ![value isKindOfClass:[NSDictionary class]]) {
+        if (invalid) *invalid = @"notifications";
+        return nil;
+    }
+    NSString *failure = nil;
+    NSMutableDictionary *result = [NSMutableDictionary dictionary];
+    id muted = input[@"muted_until"];
+    if (!muted) {
+        result[@"muted_until"] = defaults[@"muted_until"];
+    } else if ([muted isEqual:@"forever"] || (OmniIsWholeNumber(muted) && [muted doubleValue] >= 0)) {
+        result[@"muted_until"] = muted;
+    } else {
+        failure = @"notifications.muted_until";
+        result[@"muted_until"] = @0;
+    }
+    NSDictionary *levelsInput = [input[@"levels"] isKindOfClass:[NSDictionary class]] ? input[@"levels"] : @{};
+    if (input[@"levels"] && ![input[@"levels"] isKindOfClass:[NSDictionary class]]) failure = @"notifications.levels";
+    NSMutableDictionary *levels = [NSMutableDictionary dictionary];
+    for (NSString *level in OmniNotificationLevelNames()) {
+        NSMutableDictionary *rule = [NSMutableDictionary dictionaryWithDictionary:defaults[@"levels"][level]];
+        id given = levelsInput[level];
+        if (given && ![given isKindOfClass:[NSDictionary class]]) failure = [@"notifications.levels." stringByAppendingString:level];
+        if ([given isKindOfClass:[NSDictionary class]]) {
+            for (NSString *channel in @[ @"banner", @"sound", @"count" ]) {
+                id flag = ((NSDictionary *)given)[channel];
+                if (!flag) continue;
+                if (OmniIsBoolean(flag)) {
+                    rule[channel] = flag;
+                } else {
+                    failure = [NSString stringWithFormat:@"notifications.levels.%@.%@", level, channel];
+                }
+            }
+        }
+        levels[level] = rule;
+    }
+    for (id level in levelsInput) {
+        if (![OmniNotificationLevelNames() containsObject:level]) failure = @"notifications.levels";
+    }
+    result[@"levels"] = levels;
+    NSMutableDictionary *kinds = [NSMutableDictionary dictionaryWithDictionary:defaults[@"kinds"]];
+    if (input[@"kinds"] && ![input[@"kinds"] isKindOfClass:[NSDictionary class]]) failure = @"notifications.kinds";
+    NSDictionary *kindsInput = [input[@"kinds"] isKindOfClass:[NSDictionary class]] ? input[@"kinds"] : @{};
+    // Plain loops, not block enumeration: a failure string made inside an
+    // enumeration block's autorelease pool would be freed before it is read.
+    for (id kind in kindsInput) {
+        id rule = kindsInput[kind];
+        if (![OmniNotificationKindNames() containsObject:kind] || ![@[ @"follow", @"inbox", @"always" ] containsObject:rule]) {
+            failure = [NSString stringWithFormat:@"notifications.kinds.%@", kind];
+            continue;
+        }
+        kinds[kind] = rule;
+    }
+    result[@"kinds"] = kinds;
+    NSMutableDictionary *agents = [NSMutableDictionary dictionary];
+    if (input[@"agents"] && ![input[@"agents"] isKindOfClass:[NSDictionary class]]) failure = @"notifications.agents";
+    NSDictionary *agentsInput = [input[@"agents"] isKindOfClass:[NSDictionary class]] ? input[@"agents"] : @{};
+    for (id name in agentsInput) {
+        id rule = agentsInput[name];
+        if (![name isKindOfClass:[NSString class]] || ![name length] || [name length] > 200 ||
+            ![@[ @"follow", @"urgent", @"inbox" ] containsObject:rule]) {
+            failure = @"notifications.agents";
+            continue;
+        }
+        // "follow" is the absence of an override.
+        if (![rule isEqual:@"follow"]) agents[name] = rule;
+    }
+    result[@"agents"] = agents;
+    for (id key in input) {
+        if (![@[ @"muted_until", @"levels", @"kinds", @"agents" ] containsObject:key]) failure = [@"notifications." stringByAppendingString:[key description]];
+    }
+    if (strict && failure) {
+        if (invalid) *invalid = failure;
+        return nil;
+    }
+    return result;
+}
+
+static NSDictionary *OmniValidAgentDefaults(id value, BOOL strict, NSString **invalid) {
+    NSDictionary *defaults = OmniDefaultAgentDefaults();
+    if (strict && ![value isKindOfClass:[NSDictionary class]]) {
+        if (invalid) *invalid = @"agent_defaults";
+        return nil;
+    }
+    NSDictionary *input = [value isKindOfClass:[NSDictionary class]] ? value : @{};
+    NSString *failure = nil;
+    NSMutableDictionary *result = [NSMutableDictionary dictionaryWithDictionary:defaults];
+    if (input[@"provider"]) {
+        if ([@[ @"claude", @"codex" ] containsObject:input[@"provider"]]) result[@"provider"] = input[@"provider"];
+        else failure = @"agent_defaults.provider";
+    }
+    if (input[@"overlap"]) {
+        if ([@[ @"replace", @"parallel" ] containsObject:input[@"overlap"]]) result[@"overlap"] = input[@"overlap"];
+        else failure = @"agent_defaults.overlap";
+    }
+    for (NSString *field in @[ @"models", @"permission_modes" ]) {
+        id given = input[field];
+        if (!given) continue;
+        if (![given isKindOfClass:[NSDictionary class]]) {
+            failure = [@"agent_defaults." stringByAppendingString:field];
+            continue;
+        }
+        NSMutableDictionary *perProvider = [NSMutableDictionary dictionaryWithDictionary:defaults[field]];
+        for (id provider in (NSDictionary *)given) {
+            NSString *word = OmniSettingWord(((NSDictionary *)given)[provider], 200);
+            const BOOL known = [@[ @"claude", @"codex" ] containsObject:provider];
+            const BOOL allowed = word && (![field isEqual:@"permission_modes"] ||
+                                          [OmniDefaultPermissionModes()[provider] containsObject:word]);
+            if (!known || !allowed) {
+                failure = [NSString stringWithFormat:@"agent_defaults.%@.%@", field, provider];
+                continue;
+            }
+            perProvider[provider] = word;
+        }
+        result[field] = perProvider;
+    }
+    for (id key in input) {
+        if (![defaults objectForKey:key]) failure = [@"agent_defaults." stringByAppendingString:[key description]];
+    }
+    if (strict && failure) {
+        if (invalid) *invalid = failure;
+        return nil;
+    }
+    return result;
+}
