+    // The tab a session was resumed into, while it is open.
+    private func sessionTab(_ sessionID: String) -> PTYTab? {
+        return terminal?.tabs()?.first { tab in
+            (tab.sessions() ?? []).contains { Self.environment($0, "OMNITERM_SESSION_ID") == sessionID }
+        }
+    }
+
+    // Returns the row for a key, reusing the existing one so the outline view
+    // keeps its identity, and updates what it shows.
+    private func item(_ kind: OmniSidebarItem.Kind, key: String, title: String, detail: String = "",
+                      route: OmniPaneRoute? = nil, color: NSColor? = nil, pulses: Bool = false,
+                      tab: PTYTab? = nil) -> OmniSidebarItem {
+        let fullKey = "\(kind)|\(key)"
+        let row = itemCache[fullKey] ?? OmniSidebarItem(kind: kind, key: fullKey, title: title)
+        itemCache[fullKey] = row
+        row.title = title
+        row.detail = detail
+        row.route = route
+        row.color = color
+        row.pulses = pulses
+        row.tab = tab
+        return row
+    }
+
+    // Agents mode's sections: agents in their folders, runs, terminals.
+    @discardableResult
+    private func buildAgentSections() -> (tabs: [PTYTab], dashboardTabIDs: Set<Int32>, background: Set<String>) {
+        var runs: [OmniSidebarItem] = []
+        var terminals: [OmniSidebarItem] = []
+        var liveRunsByAgent: [String: [OmniRun]] = [:]
+        var dashboardTabIDs: Set<Int32> = []
+        let tabs = terminal?.tabs() ?? []
+        let runsByID = Dictionary(recentRuns.map { ($0.id, $0) }, uniquingKeysWith: { first, _ in first })
+        // Run rows wear their agent's icon and colour.
+        var appearance: [String: (icon: OmniAgentIcon?, color: String?)] = [:]
+        for agent in agents {
+            if let name = agent["name"] as? String {
+                appearance[name] = (OmniAgentIcon(spec: agent["icon"] as? String), agent["color"] as? String)
+            }
+        }
+        let background = OmniBackgroundAgents.names(agents)
+        func dress(_ row: OmniSidebarItem, agent: String?) -> OmniSidebarItem {
+            let look = agent.flatMap { appearance[$0] }
+            row.icon = look?.icon
+            row.iconColor = look?.color
+            return row
+        }
+        for tab in tabs {
+            let sessions = tab.sessions() ?? []
+            let kinds = Self.kinds(tab)
+            let title = tab.title ?? ""
+            if kinds.contains("dashboard") {
+                // A curses dashboard tab (an older build's, or one opened by
+                // hand) never shows in the sidebar: Overview replaces it.
+                dashboardTabIDs.insert(tab.uniqueId)
+            } else if kinds.contains("run") {
+                let session = sessions.first { Self.environment($0, "OMNITERM_KIND") == "run" }
+                // A run tab opens its page; one without a run ID (restored
+                // from an older build) only shows its terminal.
+                let runID = Self.environment(session, "OMNITERM_RUN_ID")
+                let run = runID.flatMap { runsByID[$0] }
+                // A renamed agent's live tab keeps the old name in its
+                // environment, so the run row names the agent.
+                let agent = run?.agent ?? Self.environment(session, "OMNITERM_AGENT")
+                if let agent, let run {
+                    liveRunsByAgent[agent, default: []].append(run)
+                }
+                // Memory consolidation runs are listed on the Memory page, not here.
+                if let agent, background.contains(agent) {
+                    continue
+                }
+                let detail = session?.exited == true ? "Ended" : (run?.statusLine ?? "Running")
+                runs.append(dress(item(.run, key: runID ?? "tab-\(tab.uniqueId)",
+                                       title: agent ?? title,
+                                       detail: detail,
+                                       route: runID.map { .run($0) },
+                                       color: run?.outcomeColor ?? OmniTheme.running,
+                                       pulses: run?.isWorking ?? true,
+                                       tab: tab), agent: agent))
+            } else {
+                terminals.append(item(.terminal, key: "tab-\(tab.uniqueId)",
+                                      title: title.isEmpty ? "Terminal" : title, tab: tab))
+            }
+        }
+
+        var agentRows: [String: OmniSidebarItem] = [:]
+        var groupsByAgent: [(name: String, group: String?)] = []
+        for agent in agents {
+            guard let name = agent["name"] as? String else { continue }
+            let provider = (agent["provider"] as? String).map { $0.capitalized } ?? ""
+            let live = liveRunsByAgent[name] ?? []
+            let state: String
+            var color: NSColor?
+            if live.contains(where: \.isWorking) {
+                state = live.count == 1 ? "Running" : "\(live.count) running"
+                color = OmniTheme.running
+            } else if !live.isEmpty {
+                state = "Idle · waiting for you"
+                color = OmniTheme.waiting
+            } else {
+                state = (agent["enabled"] as? NSNumber)?.boolValue == true ? "Scheduled" : "Paused"
+            }
+            let detail = provider.isEmpty ? state : "\(provider) · \(state)"
+            let row = item(.agent, key: name, title: name, detail: detail, route: .agent(name), color: color,
+                           pulses: live.contains(where: \.isWorking))
+            let group = agent["group"] as? String
+            row.groupPath = OmniGroupTree.normalizedPath(group)
+            row.icon = OmniAgentIcon(spec: agent["icon"] as? String)
+            row.iconColor = agent["color"] as? String
+            // Background agents (memory consolidation) live on the Memory
+            // page: they get no row, but stay in the tree so a reorder here
+            // keeps their saved place.
+            if !background.contains(name) {
+                agentRows[name] = row
+            }
+            groupsByAgent.append((name, group))
+        }
+        groupTree = OmniGroupTree(agents: groupsByAgent, configured: configuredGroups, order: sidebarOrder)
+        let configuredPaths = Set(configuredGroups.map(OmniGroupTree.normalizedPath))
+        func rows(_ entries: [OmniGroupTree.Entry]) -> [OmniSidebarItem] {
+            return entries.compactMap { entry in
+                switch entry {
+                case .agent(let name):
+                    return agentRows[name]
+                case .group(let group):
+                    let children = rows(group.children)
+                    // A folder that exists only because of hidden agents is
+                    // not shown; a configured empty folder still is.
+                    if children.isEmpty, !group.children.isEmpty, !configuredPaths.contains(group.path) {
+                        return nil
+                    }
+                    let row = item(.group, key: group.path, title: group.name, route: .group(group.path))
+                    row.groupPath = group.path
+                    row.icon = OmniAgentIcon(spec: agentFolderIcons[group.path])
+                    row.iconColor = agentFolderColors[group.path]
+                    row.children = children
+                    return row
+                }
+            }
+        }
+        agentsSection.children = rows(groupTree.entries)
+        // Live runs first, then finished ones; a live run whose tab is open is
+        // listed once, from its tab.
+        let shownRunIDs = Set(runs.compactMap { row -> String? in
+            if case .run(let id) = row.route { return id }
+            return nil
+        })
+        let finished = recentRuns.filter { !shownRunIDs.contains($0.id) && !background.contains($0.agent) }.map { run in
+            dress(item(.recentRun, key: run.id, title: run.agent, detail: run.statusLine, route: .run(run.id),
+                       color: run.outcomeColor, pulses: run.isWorking), agent: run.agent)
+        }
+        runsSection.children = runs + finished
+        terminalsSection.children = terminals
+
+        return (tabs, dashboardTabIDs, background)
+    }
+
+    private func rebuild() {
+        // A search looks through everything, whatever the mode.
+        if !sessionQuery.isEmpty {
+            rebuildSearch()
+            return
+        }
+        if mode == .sessions {
+            rebuildSessions()
+            return
+        }
+        if mode == .projects {
+            rebuildProjects()
+            return
+        }
+        let built = buildAgentSections()
+        // By project, a project holds its agents and their runs, live or
+        // not; in folders, runs keep their own section.
+        if Self.agentsView == .projects {
+            arrangeAgentsByProject(runs: runsSection.children)
+            runsSection.children = []
+        } else {
+            arrangeRuns()
+        }
+        inboxItem.count = inboxUnread > 0 ? "\(inboxUnread)" : ""
+        inboxItem.countNeedsAttention = inboxUnread > 0 && inboxAttention > 0
+        let items = sharedItems + [agentsSection] + (runsSection.children.isEmpty && Self.agentsView == .projects ? [] : [runsSection])
+            + [terminalsSection]
+        let structure = items.map(Self.structure).joined(separator: ";")
+        applyUpdate(items: items, structure: structure)
+        followCurrentTab(tabs: built.tabs, dashboardTabIDs: built.dashboardTabIDs, backgroundAgents: built.background)
+        layoutContent()
+        syncSelection()
+    }
+
+    // Sessions mode: the shared rows, then live sessions, then the most
+    // recently active ones.
+    private func rebuildSessions() {
+        let query = sessionQuery.lowercased()
+        let hideAgentRuns = CFPreferencesGetAppBooleanValue(Self.sessionsHideAgentRunsKey, Self.preferencesDomain, nil)
+        let runAgents = Dictionary(recentRuns.compactMap { run in run.sessionID.map { ($0, run.agent) } },
+                                   uniquingKeysWith: { first, _ in first })
+        func sessionRow(_ session: [AnyHashable: Any], key: String, detail: String? = nil) -> OmniSidebarItem? {
+            guard let id = session["session_id"] as? String else { return nil }
+            let isLive = OmniSessionText.isLive(session)
+            let raw = OmniSessionResume.rawID(session) ?? ""
+            let project = sessionProject(session)
+            var text = detail ?? OmniSessionText.detail(session, project: project.name)
+            if detail == nil, let agent = runAgents[raw] ?? runAgents[id] {
+                text = "Agent \(agent) · " + text
+            }
+            let row = item(.session, key: key, title: OmniSessionText.title(session["title"] as? String),
+                           detail: text, route: .session(id), color: isLive ? OmniTheme.running : nil, pulses: false)
+            row.icon = .symbol(OmniSessionText.providerSymbol(session["provider"] as? String))
+            row.accent = project.color
+            row.children = []
+            return row
+        }
+        var live: [(row: OmniSidebarItem, session: [AnyHashable: Any])] = []
+        var rest: [(row: OmniSidebarItem, session: [AnyHashable: Any])] = []
+        let pinnedOrder = Self.pinnedSessions
+        let pinnedIDs = Set(pinnedOrder)
+        var pinned: [String: OmniSidebarItem] = [:]
+        var seen = Set<String>()
+        let loaded = Set(sessions.compactMap { $0["session_id"] as? String })
+        requestPinnedSessions(pinnedOrder.filter { !loaded.contains($0) })
+        let extras = pinnedOrder.compactMap { loaded.contains($0) ? nil : pinnedExtras[$0] }
+        for session in sessions + extras {
+            guard let id = session["session_id"] as? String, seen.insert(id).inserted else { continue }
+            let raw = OmniSessionResume.rawID(session) ?? ""
+            if hideAgentRuns, runAgents[raw] != nil || runAgents[id] != nil {
+                continue
+            }
+            if !query.isEmpty {
+                let haystack = ((session["title"] as? String ?? "") + " " + (session["workspace"] as? String ?? "")).lowercased()
+                guard haystack.contains(query) else { continue }
+            }
+            guard let row = sessionRow(session, key: id) else { continue }
+            if let tab = sessionTab(id) {
+                row.children = [item(.terminal, key: "session-tab-\(tab.uniqueId)", title: tab.title ?? "Terminal", tab: tab)]
+            }
+            if pinnedIDs.contains(id) {
+                pinned[id] = row
+            } else if OmniSessionText.isLive(session) {
+                live.append((row, session))
+            } else {
+                rest.append((row, session))
+            }
+        }
+        pinnedSessionsSection.children = pinnedOrder.compactMap { pinned[$0] }
+        // Only the timeline keeps Live apart; by project or in folders, a
+        // live session sits in its place, first among its neighbours.
+        let separatesLive = Self.sessionsView == .timeline
+        liveSessionsSection.children = separatesLive ? live.map(\.row) : []
+        var items = sharedItems
+        if !pinnedSessionsSection.children.isEmpty {
+            items.append(pinnedSessionsSection)
+        }
+        if separatesLive, !live.isEmpty {
+            items.append(liveSessionsSection)
+        }
+        if !query.isEmpty {
+            var matchRows: [OmniSidebarItem] = []
+            var matched = Set<String>()
+            for match in sessionMatches {
+                guard let id = match["session_id"] as? String, matched.insert(id).inserted else { continue }
+                let known = sessions.first { $0["session_id"] as? String == id } ?? match
+                let snippet = OmniSessionText.title(match["snippet"] as? String ?? match["text"] as? String)
+                if let row = sessionRow(known, key: "match|\(id)", detail: snippet) {
+                    row.matchMessageID = match["message_id"] as? String
+                    matchRows.append(row)
+                }
+            }
+            matchesSection.children = matchRows
+            if !matchRows.isEmpty {
+                items.append(matchesSection)
+            }
+        }
+        switch Self.sessionsView {
+        case .projects:
+            items += sessionsByProject(live + rest)
+        case .folders:
+            items += sessionsInFolders(live + rest)
+        case .timeline:
+            // Live above; the last two days; then everything else loaded.
+            let cutoff = Date().timeIntervalSince1970 - 2 * 86400
+            let recent = rest.filter { (($0.session["updated"] as? NSNumber)?.doubleValue ?? 0) >= cutoff }
+            let older = rest.filter { (($0.session["updated"] as? NSNumber)?.doubleValue ?? 0) < cutoff }
+            recentSessionsSection.children = recent.map(\.row)
+            allSessionsSection.children = older.map(\.row)
+            items += [recentSessionsSection, allSessionsSection].filter { !$0.children.isEmpty }
+        }
+        if sessionsHaveMore {
+            items.append(moreSessionsItem)
+        }
+        // The view picker rides on the first list section under Pinned.
+        let picker = items.first { $0.kind == .section && $0 !== pinnedSessionsSection && $0 !== matchesSection }
+        if picker !== sessionsViewSection {
+            sessionsViewSection = picker
+        }
+        inboxItem.count = inboxUnread > 0 ? "\(inboxUnread)" : ""
+        inboxItem.countNeedsAttention = inboxUnread > 0 && inboxAttention > 0
+        let structure = "sessions;\(sessionsViewSection?.key ?? "");" + items.map(Self.structure).joined(separator: ";")
+        applyUpdate(items: items, structure: structure)
+        // A tab selected some other way (Resume, the keyboard, a run) takes
+        // the window from the page, as in Agents mode.
+        followCurrentTab(tabs: terminal?.tabs() ?? [], dashboardTabIDs: [],
+                         backgroundAgents: OmniBackgroundAgents.names(agents))
+        // The start page: the newest session.
+        if startPagePending, let first = (live.first?.row ?? rest.first?.row)?.route {
+            startPagePending = false
+            if !contentHost.isShowingPane {
+                contentHost.show(first)
+            }
+        }
+        layoutContent()
+        syncSelection()
+    }
