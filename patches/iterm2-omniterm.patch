+    private static func graphAnswer(_ nodes: [[String: Any]], _ edges: [[String: Any]]) -> [AnyHashable: Any] {
+        return ["ok": true, "total_memories": nodes.count, "truncated": false, "similarity_available": true,
+                "nodes": nodes, "edges": edges]
+    }
+
+    private static func memoryNode(_ id: String, weight: Double, extra: [String: Any] = [:]) -> [String: Any] {
+        var node: [String: Any] = ["id": id, "kind": "memory", "label": id.uppercased(), "memory_type": "declarative",
+                                   "effective_weight": weight]
+        node.merge(extra) { _, new in new }
+        return node
+    }
