+- (NSDictionary *)savedKnowledgeRecord:(NSString *)key {
+    sqlite3 *database = NULL;
+    NSString *path = [_temporaryPath stringByAppendingPathComponent:@"knowledge.sqlite"];
+    XCTAssertEqual(sqlite3_open_v2(path.fileSystemRepresentation, &database, SQLITE_OPEN_READONLY, NULL), SQLITE_OK);
+    sqlite3_stmt *statement = NULL;
+    XCTAssertEqual(sqlite3_prepare_v2(database, "SELECT value FROM records WHERE key=?", -1, &statement, NULL), SQLITE_OK);
+    sqlite3_bind_text(statement, 1, key.UTF8String, -1, SQLITE_TRANSIENT);
+    NSDictionary *record = nil;
+    if (sqlite3_step(statement) == SQLITE_ROW) {
+        const char *text = (const char *)sqlite3_column_text(statement, 0);
+        NSData *data = [[NSString stringWithUTF8String:text] dataUsingEncoding:NSUTF8StringEncoding];
+        record = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    }
+    sqlite3_finalize(statement);
+    sqlite3_close(database);
+    return record;
+}
