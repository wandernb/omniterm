+    // A double-click on a neighbour (or Option-Return) merges its
+    // neighbourhood into the focused graph. In the overview it focuses only
+    // when forced (Option held); a plain double-click there opens the memory.
+    @discardableResult
+    func expandGraph(_ id: String, force: Bool = false) -> Bool {
+        guard !isMindMap, force || !graphFocusStack.isEmpty, graphFocus != id,
+              let node = canvas.nodes.first(where: { $0.id == id }), node.kind == "memory" else { return false }
+        let merged = graphFocusStack.last?.members ?? []
+        graphFocusStack.append(OmniGraphFocus(id: id, label: node.label, members: merged + [id]))
+        updateGraphBreadcrumb()
+        loadGraph(fit: merged.isEmpty)
+        return true
+    }
+
+    private func updateGraphBreadcrumb() {
+        let focused = !graphFocusStack.isEmpty && !isMindMap
+        for view in [graphBackButton, graphOverviewButton, graphTrail] as [NSView] {
+            view.isHidden = !focused
+        }
+        let trail = ["Overview"] + graphFocusStack.map { OmniReportText.sanitized($0.label) }
+        graphTrail.stringValue = trail.joined(separator: " › ")
+    }
+
+    // The request for the shown graph: mode, edge kinds, filters and focus
+    // (`focus` overrides the current one, for each member of an expansion).
+    func graphArguments(now: Date = Date(), focus: String? = nil) -> [String: Any] {
+        let mindMap = isMindMap
+        var arguments: [String: Any] = ["op": "memory_graph", "limit": 300, "mindmap": mindMap]
+        arguments["edges"] = mindMap ? [String]() : edgeKinds
+        if graphTypePopUp.indexOfSelectedItem > 0 {
+            arguments["memory_type"] = Self.types[graphTypePopUp.indexOfSelectedItem - 1]
+        }
+        if graphWorkspacePopUp.indexOfSelectedItem > 0, graphWorkspacePopUp.indexOfSelectedItem - 1 < graphWorkspaces.count {
+            arguments["workspace"] = graphWorkspaces[graphWorkspacePopUp.indexOfSelectedItem - 1]
+        }
+        if let days = Self.graphTimeRanges[max(0, graphTimePopUp.indexOfSelectedItem)].days {
+            // Rounded to the hour, so the request (and the graph) is stable between refreshes.
+            let after = now.timeIntervalSince1970 - days * 86400
+            arguments["after"] = (after / 3600).rounded(.down) * 3600
+        }
+        if let weight = Self.graphMinimumWeights[max(0, graphWeightPopUp.indexOfSelectedItem)].weight {
+            arguments["min_weight"] = weight
+        }
+        if !mindMap, let focus = focus ?? graphFocus {
+            arguments["focus"] = focus
+            arguments["hops"] = 2
+        }
+        return arguments
+    }
+
+    func loadGraph(fit: Bool) {
+        graphRequest += 1
+        let request = graphRequest
+        let mindMap = isMindMap
+        updateGraphBreadcrumb()
+        // An expanded view is every merged focus's neighbourhood, each asked
+        // for again on every refresh, so none of it goes stale.
+        let members = mindMap ? [] : (graphFocusStack.last?.members ?? [])
+        let foci: [String?] = members.isEmpty ? [nil] : members
+        var answers = [[AnyHashable: Any]?](repeating: nil, count: foci.count)
+        var failed = false
+        for (index, focus) in foci.enumerated() {
+            OmniSchedulerClient.request(graphArguments(focus: focus)) { [weak self] response in
+                guard let self, request == self.graphRequest, !failed else { return }
+                guard OmniPane.isOK(response) else {
+                    failed = true
+                    self.graphStatus.stringValue = response["error"] as? String ?? "The graph is unavailable."
+                    return
+                }
+                answers[index] = response
+                guard answers.allSatisfy({ $0 != nil }) else { return }
+                let complete = answers.compactMap { $0 }
+                self.renderGraph(complete.count == 1 ? complete[0] : Self.mergeGraphResponses(complete),
+                                 mindMap: mindMap, fit: fit)
+            }
+        }
+    }
+
+    // Several neighbourhoods as one answer: nodes by id and edges by triple,
+    // the first answer's copy kept; truncated when any part was.
+    static func mergeGraphResponses(_ responses: [[AnyHashable: Any]]) -> [AnyHashable: Any] {
+        var merged = responses.last ?? [:]
+        var nodes: [[AnyHashable: Any]] = []
+        var ids = Set<String>()
+        var edges: [[AnyHashable: Any]] = []
+        var triples = Set<[String]>()
+        for response in responses {
+            for node in response["nodes"] as? [[AnyHashable: Any]] ?? [] {
+                guard let id = node["id"] as? String, ids.insert(id).inserted else { continue }
+                nodes.append(node)
+            }
+            for edge in response["edges"] as? [[AnyHashable: Any]] ?? [] {
+                let triple = [edge["kind"] as? String ?? "", edge["source"] as? String ?? "", edge["target"] as? String ?? ""]
+                guard triples.insert(triple).inserted else { continue }
+                edges.append(edge)
+            }
+        }
+        merged["nodes"] = nodes
+        merged["edges"] = edges
+        merged["truncated"] = responses.contains { $0["truncated"] as? Bool == true }
+        return merged
+    }
+
+    // Workspaces seen in graph answers fill the filter's menu; none is removed
+    // while the page is open, so a filtered answer keeps the others offered.
+    private func updateGraphWorkspaces(_ nodes: [[AnyHashable: Any]]) {
+        var found = Set(graphWorkspaces)
+        for node in nodes {
+            if let path = node["path"] as? String, node["kind"] as? String == "workspace" {
+                found.insert(path)
+            }
+            for workspace in node["workspaces"] as? [String] ?? [] {
+                found.insert(workspace)
+            }
+        }
+        let sorted = found.sorted()
+        guard sorted != graphWorkspaces else { return }
+        let selected = graphWorkspacePopUp.indexOfSelectedItem > 0 ? graphWorkspaces[graphWorkspacePopUp.indexOfSelectedItem - 1] : nil
+        graphWorkspaces = sorted
+        graphWorkspacePopUp.removeAllItems()
+        graphWorkspacePopUp.addItem(withTitle: "All workspaces")
+        for workspace in sorted {
+            graphWorkspacePopUp.addItem(withTitle: OmniReportText.sanitized((workspace as NSString).lastPathComponent))
+            graphWorkspacePopUp.lastItem?.toolTip = workspace
+        }
+        if let selected, let index = sorted.firstIndex(of: selected) {
+            graphWorkspacePopUp.selectItem(at: index + 1)
+        }
+    }
+
+    private func renderGraph(_ response: [AnyHashable: Any], mindMap: Bool, fit: Bool) {
+        let total = OmniMemoryText.number(response["total_memories"]) ?? 0
+        let modeChanged = graphShowsMindMap != mindMap
+        graphShowsMindMap = mindMap
+        let rawNodes = response["nodes"] as? [[AnyHashable: Any]] ?? []
+        updateGraphWorkspaces(rawNodes)
+        canvas.focusID = mindMap ? nil : graphFocus
+        canvas.showsCommunityRegions = !mindMap && graphFocusStack.isEmpty
+        if mindMap {
+            guard let tree = (response["mindmap"] as? [AnyHashable: Any]).flatMap(OmniMindMapNode.init) else { return }
+            lastMindMapTree = tree
+            // A node a link names is shown: its branches open.
+            if let pending = pendingNode, let path = tree.ancestors(of: pending.id) {
+                mindMapExpanded.formUnion(path)
+            }
+            let signature = mindMapSignature(tree)
+            guard signature != graphSignature || fit || modeChanged else { return }
+            graphSignature = signature
+            layoutMindMap(fit: fit || modeChanged)
+            graphStatus.stringValue = graphStatusText(["Mind map: click a branch to open or close it"], response: response,
+                                                      total: total)
+            applyPendingNode()
+            return
+        }
+        let nodes = rawNodes.compactMap(OmniMemoryGraphNode.init)
+        let edges = (response["edges"] as? [[AnyHashable: Any]] ?? []).compactMap(OmniMemoryGraphEdge.init)
+        let focusKey = graphFocusStack.map(\.id).joined(separator: ">")
+        let signature = OmniMemoryGraphLayout.signature(nodes: nodes, edges: edges, extra: "network " + focusKey)
+        guard signature != graphSignature || fit || modeChanged else {
+            // Unchanged: a community first seen last time is now seen twice.
+            canvas.refreshRegions()
+            return
+        }
+        graphSignature = signature
+        var status = [graphFocus == nil ? "\(nodes.count) nodes, \(edges.count) links"
+                                        : "Focus: \(nodes.count) nodes, \(edges.count) links"]
+        if graphFocus != nil, nodes.count <= 1 {
+            status = ["No neighbours — widen filters"]
+        }
+        let key = edgeKinds.joined(separator: ",")
+        let previous = graphPositions[key]
+        let topology = OmniMemoryGraphLayout.topology(nodes: nodes, edges: edges)
+        if topology == graphTopology, let previous, nodes.allSatisfy({ previous[$0.id] != nil }) {
+            // Only weights or labels moved: redraw in place, no layout.
+            canvas.setGraph(nodes: nodes, edges: edges, positions: previous.filter { id, _ in nodes.contains { $0.id == id } },
+                            fit: fit || modeChanged)
+            graphStatus.stringValue = graphStatusText(status, response: response, total: total)
+            applyPendingNode()
+            return
+        }
+        graphTopology = topology
+        let warm = OmniMemoryGraphLayout.isWarm(nodes, previous: previous)
+        if !warm {
+            graphStatus.stringValue = "Laying out…"
+        }
+        graphLayoutRuns += 1
+        let request = graphRequest
+        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+            let positions = OmniMemoryGraphLayout.network(nodes: nodes, edges: edges, previous: warm ? previous : nil)
+            DispatchQueue.main.async {
+                guard let self, request == self.graphRequest else { return }
+                var stored = self.graphPositions[key] ?? [:]
+                if stored.count > 5000 {
+                    stored = [:]
+                }
+                stored.merge(positions) { _, new in new }
+                self.graphPositions[key] = stored
+                // A warm update keeps the viewport; a cold one is fitted.
+                self.canvas.setGraph(nodes: nodes, edges: edges, positions: positions, fit: fit || modeChanged || !warm)
+                // A new focus (an expansion) is centred once; a refresh keeps the viewport.
+                if let focus = self.graphFocus, !fit, focus != self.graphCenteredFocus {
+                    self.canvas.center(on: focus)
+                }
+                self.graphCenteredFocus = self.graphFocus
+                self.graphStatus.stringValue = self.graphStatusText(status, response: response, total: total)
+                self.applyPendingNode()
+            }
+        }
+    }
+
+    private func mindMapSignature(_ tree: OmniMindMapNode) -> String {
+        return OmniMemoryGraphLayout.signature(nodes: tree.allNodes, edges: [],
+                                               extra: "mindmap " + mindMapExpanded.sorted().joined(separator: ","))
+    }
+
+    private func layoutMindMap(fit: Bool) {
+        guard let tree = lastMindMapTree else { return }
+        let layout = OmniMemoryGraphLayout.mindMap(tree, expanded: mindMapExpanded)
+        canvas.setGraph(nodes: layout.nodes, edges: layout.edges, positions: layout.positions, fit: fit)
+    }
+
+    // A click on a mind-map branch opens or closes it; the choice is kept by id.
+    func toggleMindMapBranch(_ id: String) {
+        guard isMindMap, let tree = lastMindMapTree, id != tree.node.id else { return }
+        if mindMapExpanded.contains(id) {
+            mindMapExpanded.remove(id)
+        } else {
+            mindMapExpanded.insert(id)
+        }
+        graphSignature = mindMapSignature(tree)
+        layoutMindMap(fit: false)
+    }
+
+    private func graphStatusText(_ parts: [String], response: [AnyHashable: Any], total: Int) -> String {
+        var parts = parts
+        if response["truncated"] as? Bool == true, response["focus"] == nil {
+            parts.append("the strongest 300 of \(total) memories")
+        }
+        if response["similarity_available"] as? Bool == false, edgeKinds.contains("similarity"), !isMindMap {
+            parts.append("similarity links need the local embedding model")
+        }
+        if graphFocus != nil {
+            parts.append("double-click a neighbour to expand, double-click the selection to open")
+        } else {
+            parts.append("Drag to pan, ⌘-scroll or pinch to zoom, double-click to open, ⌥-double-click to focus")
+        }
+        return parts.joined(separator: "  ·  ")
+    }
+
+    private func graphSelectionChanged(_ id: String?) {
+        guard let id, let node = canvas.nodes.first(where: { $0.id == id }) else { return }
+        let memoryID = Self.memoryID(forGraphNode: id)
+        let detail = memories.first { $0.id == memoryID }?.detailLine ?? node.kind
+        graphStatus.stringValue = OmniReportText.sanitized(node.label) + " — " + detail
+    }
