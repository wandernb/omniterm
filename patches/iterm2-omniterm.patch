+        ("Travel & Places", "🚀✈️🚗🚕🚌🚲🛸⛵️🚂🏠🏢🏭🏰🗽🗻🏝️🌋🗺️🧭⛺️"),
+        ("Objects", "💻🖥️⌨️🖱️📱⌚️💾💿📷🎥📺📡🔋🔌💡🔦🧰🔧🔨⚙️🧪🔬🔭💊🩺📦📫📮📝📚📖📌📎✂️🔒🔑🗝️🛡️💰💳💎🧲⏰⏳🛒🎓"),
+        ("Symbols", "❤️🧡💛💚💙💜🖤🤍💯✅❌⚠️🚫❓❗️💬💭🗯️🔔🔕♻️🔁🔄➕➖✳️❇️🆕🆗🆘🔴🟠🟡🟢🔵🟣⚫️⚪️🟥🟦🏁🚩"),
+    ]
+
+    // Every emoji with its category, in order.
+    static let all: [(emoji: String, category: String)] = categories.flatMap { entry in
+        entry.1.map { (emoji: String($0), category: entry.0) }
+    }
+
+    // The Unicode name of each scalar, lowercased, without joiners and
+    // variation selectors: "🚀" is "rocket".
+    static func name(_ emoji: String) -> String {
+        let mutable = NSMutableString(string: emoji)
+        CFStringTransform(mutable, nil, kCFStringTransformToUnicodeName, false)
+        let ignored: Set<String> = ["VARIATION SELECTOR-16", "ZERO WIDTH JOINER"]
+        return (mutable as String).components(separatedBy: "\\N{").compactMap { part -> String? in
+            guard let end = part.firstIndex(of: "}") else { return nil }
+            let name = String(part[..<end])
+            return ignored.contains(name) ? nil : name.lowercased()
+        }.joined(separator: " ")
+    }
+}
+
+// Every word of the query must appear in the name or one of the keywords.
+enum OmniAppearanceSearch {
+    static func matches(_ query: String, name: String, keywords: [String]) -> Bool {
+        let words = query.lowercased().split(whereSeparator: \.isWhitespace)
+        guard !words.isEmpty else { return true }
+        let haystack = ([name] + keywords).map { $0.lowercased() }
+        return words.allSatisfy { word in haystack.contains { $0.contains(word) } }
+    }
+}
+
+// A popover for an agent's icon and colour, saved as soon as one is picked:
+// Icons (allow-listed SF Symbols) or Emoji, both by category and searchable as
+// you type, and the named colours.
+final class OmniAppearancePicker: NSViewController, NSSearchFieldDelegate, NSTextFieldDelegate {
+    private static let cell: CGFloat = 36
+    private static let columns = 8
+    private static let width: CGFloat = CGFloat(columns) * cell + 32
+    private static let swatchesPerRow = 8
+    private static let headerHeight: CGFloat = 20
+
+    private struct Item {
+        // The button's identifier: a symbol name, or `emoji:<emoji>`.
+        let identifier: String
+        let icon: OmniAgentIcon
+        let category: String
+    }
+
+    private var icon: OmniAgentIcon?
+    private var color: String?
+    private let didChange: (_ icon: String, _ color: String) -> Void
+    private lazy var emojiNames: [String: String] = Dictionary(
+        OmniEmojiCatalog.all.map { ($0.emoji, OmniEmojiCatalog.name($0.emoji)) }, uniquingKeysWith: { first, _ in first })
+
+    private let tabs = NSSegmentedControl(labels: ["Icons", "Emoji"], trackingMode: .selectOne, target: nil, action: nil)
+    private let search = NSSearchField()
+    private let swatches = OmniResizingView()
+    private let gridScroll = NSScrollView()
+    private let grid = OmniResizingView()
+    private let noMatches = NSTextField(labelWithString: "No matches")
+    private let emojiField = NSTextField()
+    private let paletteButton = NSButton(title: "Emoji & Symbols…", target: nil, action: nil)
+    private let clearButton = NSButton(title: "No Icon", target: nil, action: nil)
+    private let message = NSTextField(labelWithString: "")
+    private var items: [Item] = []
+    private var iconButtons: [NSButton] = []
+    private var headers: [(category: String, label: NSTextField)] = []
+    private var swatchButtons: [NSButton] = []
+    // The icon the arrow keys are on, from the search field; Return picks it.
+    private(set) var cursor: Int?
+    // Closes the popover; Escape calls it.
+    var close: (() -> Void)?
+
+    init(icon: OmniAgentIcon?, color: String?, didChange: @escaping (_ icon: String, _ color: String) -> Void) {
+        self.icon = icon
+        self.color = color
+        self.didChange = didChange
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    @discardableResult
+    static func show(icon: OmniAgentIcon?, color: String?, relativeTo rect: NSRect, of view: NSView,
+                     didChange: @escaping (_ icon: String, _ color: String) -> Void) -> NSPopover {
+        let picker = OmniAppearancePicker(icon: icon, color: color, didChange: didChange)
+        let popover = NSPopover()
+        popover.behavior = .transient
+        popover.contentViewController = picker
+        picker.close = { [weak popover] in popover?.performClose(nil) }
+        // A window off screen (as in tests) cannot anchor a popover.
+        if view.window?.isVisible == true {
+            popover.show(relativeTo: rect, of: view, preferredEdge: .maxX)
+        }
+        return popover
+    }
+
+    override func loadView() {
+        let root = OmniResizingView(frame: NSRect(x: 0, y: 0, width: Self.width, height: 440))
+        view = root
+        if case .emoji = icon {
+            tabs.selectedSegment = 1
+        } else {
+            tabs.selectedSegment = 0
+        }
+        tabs.target = self
+        tabs.action = #selector(tabChanged(_:))
+        root.addSubview(tabs)
+        search.delegate = self
+        root.addSubview(search)
+        root.addSubview(swatches)
+        gridScroll.hasVerticalScroller = true
+        gridScroll.autohidesScrollers = true
+        gridScroll.drawsBackground = false
+        gridScroll.borderType = .noBorder
+        gridScroll.documentView = grid
+        root.addSubview(gridScroll)
+        noMatches.textColor = OmniTheme.secondaryText
+        noMatches.alignment = .center
+        noMatches.isHidden = true
+        grid.addSubview(noMatches)
+        emojiField.placeholderString = "One emoji"
+        emojiField.font = NSFont.systemFont(ofSize: 18)
+        emojiField.alignment = .center
+        emojiField.delegate = self
+        if case .emoji(let emoji) = icon {
+            emojiField.stringValue = emoji
+        }
+        root.addSubview(emojiField)
+        paletteButton.bezelStyle = .rounded
+        paletteButton.target = self
+        paletteButton.action = #selector(showPalette(_:))
+        root.addSubview(paletteButton)
+        clearButton.bezelStyle = .rounded
+        clearButton.target = self
+        clearButton.action = #selector(clearIcon(_:))
+        root.addSubview(clearButton)
+        message.textColor = .secondaryLabelColor
+        message.font = NSFont.systemFont(ofSize: 11.5)
+        message.lineBreakMode = .byTruncatingTail
+        root.addSubview(message)
+        root.didResize = { [weak self] size in self?.layout(size) }
+        buildSwatches()
+        message.stringValue = "Loading icons…"
+        OmniAppearanceCatalog.load { [weak self] in
+            guard let self else { return }
+            self.message.stringValue = OmniAppearanceCatalog.icons.isEmpty ? "The icon list could not be loaded." : ""
+            self.buildSwatches()
+            self.buildGrid()
+        }
+        updateTab()
+    }
+
+    // The keyboard starts in the search field.
+    override func viewDidAppear() {
+        super.viewDidAppear()
+        view.window?.makeFirstResponder(search)
+    }
+
+    private var swatchRows: Int {
+        return max(1, (swatchButtons.count + Self.swatchesPerRow - 1) / Self.swatchesPerRow)
+    }
+
+    private func layout(_ size: NSSize) {
+        tabs.sizeToFit()
+        tabs.frame.origin = NSPoint(x: 16, y: 12)
+        search.frame = NSRect(x: 16, y: 44, width: size.width - 32, height: 24)
+        let swatchesHeight = CGFloat(swatchRows) * 28 + 2
+        swatches.frame = NSRect(x: 16, y: 76, width: size.width - 32, height: swatchesHeight)
+        layoutSwatches()
+        let gridTop = swatches.frame.maxY + 8
+        let bottom: CGFloat = 44
+        gridScroll.frame = NSRect(x: 16, y: gridTop, width: size.width - 32, height: max(0, size.height - gridTop - bottom))
+        layoutGrid()
+        clearButton.sizeToFit()
+        clearButton.frame = NSRect(x: 12, y: size.height - 36, width: clearButton.frame.width + 10, height: 28)
+        var x = clearButton.frame.maxX + 8
+        if !emojiField.isHidden {
+            emojiField.frame = NSRect(x: x, y: size.height - 35, width: 40, height: 26)
+            paletteButton.sizeToFit()
+            paletteButton.frame = NSRect(x: emojiField.frame.maxX + 6, y: size.height - 36,
+                                         width: paletteButton.frame.width + 10, height: 28)
+            x = paletteButton.frame.maxX + 8
+        }
+        message.frame = NSRect(x: x, y: size.height - 30, width: max(0, size.width - x - 12), height: 16)
+    }
+
+    // MARK: - Colours
+
+    private func buildSwatches() {
+        swatchButtons.forEach { $0.removeFromSuperview() }
+        swatchButtons = OmniAppearanceCatalog.colors.map { name in
+            let button = OmniKeyButton(title: "", target: self, action: #selector(pickColor(_:)))
+            button.escape = { [weak self] in self?.close?() }
+            button.focusRingType = .exterior
+            button.isBordered = false
+            button.wantsLayer = true
+            button.layer?.cornerRadius = 11
+            button.identifier = NSUserInterfaceItemIdentifier(name)
+            button.toolTip = name.capitalized
+            button.setAccessibilityLabel(name.capitalized)
+            swatches.addSubview(button)
+            return button
+        }
+        updateSwatches()
+        layoutSwatches()
+        linkKeyViews()
+        view.needsLayout = true
+    }
+
+    // Tab: search → colours → No Icon (→ emoji field) → Icons/Emoji → back.
+    private func linkKeyViews() {
+        var previous: NSView = search
+        for button in swatchButtons {
+            previous.nextKeyView = button
+            previous = button
+        }
+        previous.nextKeyView = clearButton
+        if tabs.selectedSegment == 1 {
+            clearButton.nextKeyView = emojiField
+            emojiField.nextKeyView = tabs
+        } else {
+            clearButton.nextKeyView = tabs
+        }
+        tabs.nextKeyView = search
+    }
+
+    // Rows of eight, spread across the width.
+    private func layoutSwatches() {
+        let perRow = min(Self.swatchesPerRow, max(1, swatchButtons.count))
+        let spacing = perRow > 1 ? (swatches.bounds.width - 22) / CGFloat(perRow - 1) : 0
+        for (index, button) in swatchButtons.enumerated() {
+            button.frame = NSRect(x: CGFloat(index % perRow) * spacing, y: CGFloat(index / perRow) * 28 + 4,
+                                  width: 22, height: 22)
+        }
+    }
+
+    private func updateSwatches() {
+        for button in swatchButtons {
+            let selected = button.identifier?.rawValue == color
+            button.effectiveAppearance.performAsCurrentDrawingAppearance {
+                button.layer?.backgroundColor = OmniAgentColor.color(button.identifier?.rawValue)?.cgColor
+                button.layer?.borderColor = NSColor.labelColor.cgColor
+            }
+            button.layer?.borderWidth = selected ? 2.5 : 0
+        }
+    }
+
+    override func viewDidLayout() {
+        super.viewDidLayout()
+        // Layer colours are resolved once; follow light and dark.
+        updateSwatches()
+    }
+
+    @objc private func pickColor(_ sender: NSButton) {
+        let name = sender.identifier?.rawValue
+        color = name == color ? nil : name
+        updateSwatches()
+        updateGridSelection()
+        save()
+    }
+
+    // MARK: - Icons and emoji
+
+    // What the current tab offers that matches the search, by category.
+    private var matchingItems: [Item] {
+        let query = search.stringValue.trimmingCharacters(in: .whitespaces)
+        if tabs.selectedSegment == 1 {
+            return OmniEmojiCatalog.all.compactMap { entry in
+                guard OmniAppearanceSearch.matches(query, name: emojiNames[entry.emoji] ?? "", keywords: [entry.category]),
+                      let icon = OmniAgentIcon(spec: "emoji:\(entry.emoji)") else { return nil }
+                return Item(identifier: "emoji:\(entry.emoji)", icon: icon, category: entry.category)
+            }
+        }
+        return OmniAppearanceCatalog.icons.compactMap { entry in
+            guard OmniAppearanceSearch.matches(query, name: entry.name, keywords: entry.keywords) else { return nil }
+            return Item(identifier: entry.name, icon: .symbol(entry.name), category: entry.category)
+        }
+    }
+
+    private func buildGrid() {
+        iconButtons.forEach { $0.removeFromSuperview() }
+        headers.forEach { $0.label.removeFromSuperview() }
+        items = matchingItems
+        cursor = nil
+        iconButtons = items.compactMap { item in
+            let button: NSButton
+            switch item.icon {
+            case .symbol(let name):
+                guard let image = NSImage(systemSymbolName: name, accessibilityDescription: name) else { return nil }
+                button = NSButton(image: image, target: self, action: #selector(pickIcon(_:)))
+                button.imageScaling = .scaleProportionallyUpOrDown
+                button.symbolConfiguration = NSImage.SymbolConfiguration(pointSize: 17, weight: .regular)
+                button.toolTip = name
+            case .emoji(let emoji):
+                button = NSButton(title: emoji, target: self, action: #selector(pickIcon(_:)))
+                button.font = NSFont.systemFont(ofSize: 20)
+                button.toolTip = emojiNames[emoji]
+            }
+            button.isBordered = false
+            button.wantsLayer = true
+            button.layer?.cornerRadius = 8
+            button.identifier = NSUserInterfaceItemIdentifier(item.identifier)
+            grid.addSubview(button)
+            return button
+        }
+        var categories: [String] = []
+        for item in items where !item.category.isEmpty && categories.last != item.category {
+            categories.append(item.category)
+        }
+        headers = categories.map { category in
+            let label = OmniTheme.sectionHeader(category)
+            grid.addSubview(label)
+            return (category, label)
+        }
+        noMatches.isHidden = !items.isEmpty || OmniAppearanceCatalog.icons.isEmpty && tabs.selectedSegment == 0
+        updateGridSelection()
+        layoutGrid()
+    }
+
+    // Each category starts a new row under its header.
+    private func layoutGrid() {
+        let width = gridScroll.contentSize.width
+        let cell = width / CGFloat(Self.columns)
+        var y: CGFloat = 0
+        var column = 0
+        var category: String?
+        for (index, button) in iconButtons.enumerated() {
+            let itemCategory = items[index].category
+            if itemCategory != category {
+                if column > 0 {
+                    y += Self.cell
+                    column = 0
+                }
+                category = itemCategory
+                if let header = headers.first(where: { $0.category == itemCategory })?.label {
+                    header.frame = NSRect(x: 4, y: y + 4, width: width - 8, height: 14)
+                    y += Self.headerHeight
+                }
+            }
+            button.frame = NSRect(x: CGFloat(column) * cell + 2, y: y + 2, width: cell - 4, height: Self.cell - 4)
+            column += 1
+            if column == Self.columns {
+                column = 0
+                y += Self.cell
+            }
+        }
+        if column > 0 {
+            y += Self.cell
+        }
+        grid.frame = NSRect(x: 0, y: 0, width: width, height: max(gridScroll.contentSize.height, y))
+        noMatches.frame = NSRect(x: 0, y: 24, width: width, height: 18)
+    }
+
+    private func updateGridSelection() {
+        let tint = OmniAgentColor.color(color) ?? .labelColor
+        for (index, button) in iconButtons.enumerated() {
+            let selected = icon == items[index].icon
+            button.contentTintColor = selected ? tint : .secondaryLabelColor
+            button.effectiveAppearance.performAsCurrentDrawingAppearance {
+                button.layer?.backgroundColor = selected ? NSColor.quaternaryLabelColor.cgColor : nil
+                button.layer?.borderColor = NSColor.keyboardFocusIndicatorColor.cgColor
+            }
+            button.layer?.borderWidth = index == cursor ? 2 : 0
+        }
+    }
+
+    @objc private func pickIcon(_ sender: NSButton) {
+        guard let index = iconButtons.firstIndex(where: { $0 === sender }) else { return }
+        icon = items[index].icon
+        if case .emoji(let emoji) = icon {
+            emojiField.stringValue = emoji
+            message.stringValue = ""
+        }
+        updateGridSelection()
+        save()
+    }
+
+    // In the search field: Down enters the grid, the arrows move through it,
+    // Up from its first row returns to the field, Return picks the icon (or
+    // the only match) and Escape on an empty search closes the picker.
+    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+        if control === emojiField, commandSelector == #selector(NSResponder.cancelOperation(_:)) {
+            close?()
+            return true
+        }
+        guard control === search else { return false }
+        switch commandSelector {
+        case #selector(NSResponder.moveDown(_:)):
+            moveCursor(to: cursor.map { verticalNeighbour(of: $0, down: true) ?? $0 } ?? 0)
+        case #selector(NSResponder.moveUp(_:)):
+            guard let cursor else { return false }
+            moveCursor(to: verticalNeighbour(of: cursor, down: false) ?? -1)
+        case #selector(NSResponder.moveLeft(_:)):
+            guard let cursor else { return false }
+            moveCursor(to: max(0, cursor - 1))
+        case #selector(NSResponder.moveRight(_:)):
+            guard let cursor else { return false }
+            moveCursor(to: cursor + 1)
+        case #selector(NSResponder.insertNewline(_:)):
+            let index = cursor ?? (iconButtons.count == 1 ? 0 : nil)
+            guard let index, index < iconButtons.count else { return true }
+            pickIcon(iconButtons[index])
+        case #selector(NSResponder.cancelOperation(_:)):
+            guard search.stringValue.isEmpty else { return false }
+            close?()
+        default:
+            return false
+        }
+        return true
+    }
+
+    // The button in the row above or below, nearest in column; nil past the
+    // first or last row. Rows are uneven because each category starts one.
+    private func verticalNeighbour(of index: Int, down: Bool) -> Int? {
+        let current = iconButtons[index].frame
+        let candidates = iconButtons.indices.filter {
+            down ? iconButtons[$0].frame.minY > current.minY : iconButtons[$0].frame.minY < current.minY
+        }
+        guard let rowY = (down ? candidates.map { iconButtons[$0].frame.minY }.min() :
+                                candidates.map { iconButtons[$0].frame.minY }.max()) else { return nil }
+        return candidates.filter { iconButtons[$0].frame.minY == rowY }
+            .min { abs(iconButtons[$0].frame.midX - current.midX) < abs(iconButtons[$1].frame.midX - current.midX) }
+    }
+
+    private func moveCursor(to index: Int) {
+        guard !iconButtons.isEmpty else { return }
+        if index < 0 {
+            cursor = nil
+        } else {
+            cursor = min(index, iconButtons.count - 1)
+        }
+        updateGridSelection()
+        if let cursor {
+            grid.scrollToVisible(iconButtons[cursor].frame.insetBy(dx: 0, dy: cursor < Self.columns ? -Self.headerHeight : 0))
+        }
+    }
+
+    func controlTextDidChange(_ notification: Notification) {
+        if (notification.object as? NSSearchField) === search {
+            buildGrid()
+            return
+        }
+        guard (notification.object as? NSTextField) === emojiField else { return }
+        // Keep the last character typed or picked from the palette.
+        guard let last = emojiField.stringValue.last else { return }
+        if let parsed = OmniAgentIcon(spec: "emoji:\(last)") {
+            emojiField.stringValue = String(last)
+            icon = parsed
+            message.stringValue = ""
+            updateGridSelection()
+            save()
+        } else {
+            message.stringValue = "Pick one emoji."
+        }
+    }
+
+    // MARK: - Tabs and saving
+
+    @objc private func tabChanged(_ sender: Any?) {
+        updateTab()
+        buildGrid()
+    }
+
+    private func updateTab() {
+        let emoji = tabs.selectedSegment == 1
+        search.placeholderString = emoji ? "Search emoji" : "Search icons"
+        emojiField.isHidden = !emoji
+        paletteButton.isHidden = !emoji
+        view.window?.makeFirstResponder(search)
+        linkKeyViews()
+        view.needsLayout = true
+    }
+
+    @objc private func showPalette(_ sender: Any?) {
+        view.window?.makeFirstResponder(emojiField)
+        NSApp.orderFrontCharacterPalette(sender)
+    }
+
+    @objc private func clearIcon(_ sender: Any?) {
+        icon = nil
+        emojiField.stringValue = ""
+        updateGridSelection()
+        save()
+    }
+
+    private func save() {
+        didChange(icon?.spec ?? "", color ?? "")
+    }
+
+    // MARK: - Testing
+
+    // Identifiers of the grid's buttons, in order.
+    var gridIdentifiers: [String] {
+        return iconButtons.compactMap { $0.identifier?.rawValue }
+    }
+
+    var showsNoMatches: Bool {
+        return !noMatches.isHidden
+    }
+
+    func selectTab(emoji: Bool) {
+        tabs.selectedSegment = emoji ? 1 : 0
+        tabChanged(nil)
+    }
+}
+
+// A colour swatch the keyboard can reach: Tab lands on it, Left and Right
+// move between swatches, Return or Space picks it, Escape closes the picker.
+private final class OmniKeyButton: NSButton {
+    var escape: (() -> Void)?
+
+    override var canBecomeKeyView: Bool { true }
+    override var acceptsFirstResponder: Bool { true }
+
+    override func keyDown(with event: NSEvent) {
+        switch event.keyCode {
+        case 36, 76, 49:
+            performClick(nil)
+        case 123:
+            window?.selectPreviousKeyView(nil)
+        case 124:
+            window?.selectNextKeyView(nil)
+        case 53:
+            escape?()
+        default:
+            super.keyDown(with: event)
+        }
+    }
+}
