+// The agent form as a sheet on the terminal window, with Cancel and Save.
+final class OmniAgentEditorSheet: NSWindowController {
+    private let editor: OmniAgentEditorView
+    private let scroll = NSScrollView()
+    private let saveButton = NSButton(title: "Save", target: nil, action: nil)
+    private let cancelButton = NSButton(title: "Cancel", target: nil, action: nil)
+    private let titleLabel = NSTextField(labelWithString: "")
+    private var didSave: ((String) -> Void)?
+    private weak var parentWindow: NSWindow?
+    // A sheet must outlive the call that showed it.
+    private static var presented: [OmniAgentEditorSheet] = []
+
+    private init(agentName: String?) {
+        editor = OmniAgentEditorView(agentName: agentName)
+        let window = NSPanel(contentRect: NSRect(x: 0, y: 0, width: 600, height: 640),
+                             styleMask: [.titled, .resizable], backing: .buffered, defer: false)
+        window.minSize = NSSize(width: 480, height: 400)
+        window.acceptsMouseMovedEvents = true
+        super.init(window: window)
+        let root = OmniResizingView()
+        root.frame = NSRect(x: 0, y: 0, width: 600, height: 640)
+        window.contentView = root
+        titleLabel.stringValue = agentName.map { "Edit \($0)" } ?? "New Agent"
+        titleLabel.font = NSFont.systemFont(ofSize: 15, weight: .semibold)
+        root.addSubview(titleLabel)
+        scroll.hasVerticalScroller = true
+        scroll.autohidesScrollers = true
+        scroll.drawsBackground = false
+        scroll.borderType = .noBorder
+        let document = OmniResizingView()
+        document.addSubview(editor)
+        scroll.documentView = document
+        root.addSubview(scroll)
+        saveButton.bezelStyle = .rounded
+        // Return belongs to the prompt fields; Command-Return saves.
+        saveButton.keyEquivalent = "\r"
+        saveButton.keyEquivalentModifierMask = [.command]
+        saveButton.target = self
+        saveButton.action = #selector(save(_:))
+        cancelButton.bezelStyle = .rounded
+        cancelButton.keyEquivalent = "\u{1b}"
+        cancelButton.target = self
+        cancelButton.action = #selector(cancel(_:))
+        root.addSubview(saveButton)
+        root.addSubview(cancelButton)
+        root.didResize = { [weak self] size in self?.layout(size) }
+        editor.didChangeHeight = { [weak self, weak root] in
+            guard let self, let root else { return }
+            self.layout(root.bounds.size)
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    private func layout(_ size: NSSize) {
+        titleLabel.frame = NSRect(x: 24, y: 18, width: size.width - 48, height: 20)
+        let bottom: CGFloat = 56
+        scroll.frame = NSRect(x: 0, y: 50, width: size.width, height: max(0, size.height - 50 - bottom))
+        let width = max(200, scroll.contentSize.width - 48)
+        let height = editor.preferredHeight(width: width)
+        scroll.documentView?.frame = NSRect(x: 0, y: 0, width: scroll.contentSize.width, height: height + 16)
+        editor.frame = NSRect(x: 24, y: 8, width: width, height: height)
+        saveButton.sizeToFit()
+        cancelButton.sizeToFit()
+        let buttonWidth = max(84, max(saveButton.frame.width, cancelButton.frame.width) + 12)
+        saveButton.frame = NSRect(x: size.width - 20 - buttonWidth, y: size.height - 44, width: buttonWidth, height: 28)
+        cancelButton.frame = NSRect(x: saveButton.frame.minX - 10 - buttonWidth, y: size.height - 44,
+                                    width: buttonWidth, height: 28)
+    }
+
+    // Edits an existing agent (name) or creates one (nil), in a sheet on
+    // `window`. `didSave` gets the saved agent's name.
+    static func present(agentName: String?, on window: NSWindow, didSave: @escaping (String) -> Void) {
+        let sheet = OmniAgentEditorSheet(agentName: agentName)
+        sheet.didSave = didSave
+        sheet.parentWindow = window
+        presented.append(sheet)
+        sheet.load { [weak sheet] in
+            guard let sheet, let panel = sheet.window else { return }
+            sheet.layout(panel.contentView?.bounds.size ?? panel.frame.size)
+            window.beginSheet(panel) { _ in
+                presented.removeAll { $0 === sheet }
+            }
+        }
+    }
+
+    private func load(then show: @escaping () -> Void) {
+        if let name = editor.agentName {
+            OmniSchedulerClient.request(["op": "show_agent", "name": name]) { [weak self] response in
+                guard let self, OmniPane.isOK(response), let agent = response["agent"] as? [AnyHashable: Any] else {
+                    Self.presented.removeAll { $0 === self }
+                    return
+                }
+                self.editor.load(agent)
+                show()
+            }
+            return
+        }
+        OmniSchedulerClient.request(["op": "get_settings"]) { [weak self] response in
+            guard let self else { return }
+            let settings = response["settings"] as? [AnyHashable: Any]
+            // New agents start from the defaults on the Settings page.
+            let defaults = settings?["agent_defaults"] as? [AnyHashable: Any]
+            let provider = defaults?["provider"] as? String ?? "claude"
+            let model = (defaults?["models"] as? [AnyHashable: Any])?[provider] as? String ?? ""
+            let permission = (defaults?["permission_modes"] as? [AnyHashable: Any])?[provider] as? String ?? ""
+            self.editor.load([
+                "provider": provider,
+                "model": model,
+                "permission_mode": permission,
+                "workspace": NSHomeDirectory(),
+                "schedule_phrase": "daily at 09:00",
+                "overlap": defaults?["overlap"] as? String ?? "replace",
+                "timeout_seconds": settings?["default_timeout_seconds"] as? NSNumber ?? NSNumber(value: 7200),
+                "enabled": true,
+                "advanced_args": [String](),
+            ])
+            show()
+        }
+    }
+
+    @objc private func save(_ sender: Any?) {
+        saveButton.isEnabled = false
+        editor.save { [weak self] name in
+            guard let self else { return }
+            self.saveButton.isEnabled = true
+            guard let name else { return }
+            self.close(saved: name)
+        }
+    }
+
+    @objc private func cancel(_ sender: Any?) {
+        close(saved: nil)
+    }
+
+    private func close(saved name: String?) {
+        guard let panel = window else { return }
+        parentWindow?.endSheet(panel)
+        if let name {
+            didSave?(name)
+        }
+    }
+}
