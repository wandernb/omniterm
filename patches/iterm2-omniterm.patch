index 0000000000000000000000000000000000000000..00938bd13b4feadaa66dab946c75a1c391d0d22b
--- /dev/null
+++ b/sources/OmniTerm/OmniSettingsPane.swift
@@ -0,0 +1,1035 @@
+import AppKit
+import Foundation
+
+// MARK: - Model
+
+// What the Settings page shows and writes: `~/.omni/settings.json`, through
+// the scheduler. Pure so tests can check the mapping without a window.
+enum OmniSettingsModel {
+    static let levels = ["urgent", "attention", "info"]
+    static let kinds = ["agent", "compaction", "wrap_up", "loop_continuation", "storage", "run_limit"]
+
+    // A level's three channels, offered as one choice each.
+    struct LevelPreset: Equatable {
+        let title: String
+        let banner: Bool
+        let sound: Bool
+        let count: Bool
+    }
+
+    static let levelPresets = [
+        LevelPreset(title: "Banner and sound", banner: true, sound: true, count: true),
+        LevelPreset(title: "Silent banner", banner: true, sound: false, count: true),
+        LevelPreset(title: "Menu-bar count only", banner: false, sound: false, count: true),
+        LevelPreset(title: "Inbox only", banner: false, sound: false, count: false),
+    ]
+
+    static let kindRules = [("follow", "Follow its level"), ("inbox", "Inbox only"), ("always", "Always banner")]
+    static let agentRules = [("follow", "Follow the rules above"), ("urgent", "Urgent only"), ("inbox", "Inbox only")]
+
+    static func levelTitle(_ level: String) -> String {
+        switch level {
+        case "urgent": return "Urgent"
+        case "attention": return "Attention"
+        default: return "Info"
+        }
+    }
+
+    static func kindTitle(_ kind: String) -> String {
+        switch kind {
+        case "agent": return "Agent messages"
+        case "compaction": return "Compaction problems"
+        case "wrap_up": return "Wrap-up reminders"
+        case "loop_continuation": return "Loop continuation problems"
+        case "storage": return "Memory storage budget"
+        default: return "Held-back notifications"
+        }
+    }
+
+    static func kindDetail(_ kind: String) -> String {
+        switch kind {
+        case "agent": return "What agents send with notify_user."
+        case "compaction": return "A session OmniTerm could not compact."
+        case "wrap_up": return "A wrap-up reminder OmniTerm could not deliver."
+        case "loop_continuation": return "A loop instruction that was not confirmed."
+        case "storage": return "The memory index is over its storage budget."
+        default: return "A run sent more than 20 notifications."
+        }
+    }
+
+    // The preset matching a level's stored channels; a combination no preset
+    // offers shows as the nearest one with a banner, then count.
+    static func presetIndex(for rule: [String: Any]) -> Int {
+        let banner = rule["banner"] as? Bool ?? false
+        let sound = rule["sound"] as? Bool ?? false
+        let count = rule["count"] as? Bool ?? false
+        if let exact = levelPresets.firstIndex(where: { $0.banner == banner && $0.sound == sound && $0.count == count }) {
+            return exact
+        }
+        if banner { return sound ? 0 : 1 }
+        return count ? 2 : 3
+    }
+
+    static func levelRule(_ preset: LevelPreset) -> [String: Any] {
+        return ["banner": preset.banner, "sound": preset.sound, "count": preset.count]
+    }
+
+    enum Mute: Equatable {
+        case off
+        case until(Date)
+        case forever
+    }
+
+    static func mute(_ value: Any?, now: Date) -> Mute {
+        if let text = value as? String, text == "forever" {
+            return .forever
+        }
+        if let number = value as? NSNumber, number.doubleValue > now.timeIntervalSince1970 {
+            return .until(Date(timeIntervalSince1970: number.doubleValue))
+        }
+        return .off
+    }
+
+    // The next 08:00 after now, the end of "Until tomorrow".
+    static func tomorrowMorning(after now: Date, calendar: Calendar = .current) -> Date {
+        let start = calendar.startOfDay(for: now)
+        let morning = calendar.date(byAdding: DateComponents(day: 1, hour: 8), to: start) ?? now.addingTimeInterval(86400)
+        return morning
+    }
+
+    static func mutedUntilValue(_ mute: Mute) -> Any {
+        switch mute {
+        case .off: return 0
+        case .forever: return "forever"
+        case .until(let date): return Int(date.timeIntervalSince1970.rounded(.up))
+        }
+    }
+
+    static func muteDescription(_ mute: Mute, now: Date) -> String {
+        switch mute {
+        case .off: return "Not muted"
+        case .forever: return "Muted until you unmute"
+        case .until(let date):
+            let formatter = DateFormatter()
+            formatter.timeStyle = .short
+            formatter.dateStyle = Calendar.current.isDate(date, inSameDayAs: now) ? .none : .short
+            return "Muted until \(formatter.string(from: date))"
+        }
+    }
+
+    static let providers = [("claude", "Claude"), ("codex", "Codex")]
+    // Stored values with the editor's names; the dangerous modes are left out
+    // on purpose, since only the per-agent editor sets them.
+    static let permissionModes: [String: [(String, String)]] = [
+        "claude": [("", "Provider default"), ("auto", "auto-mode"), ("acceptEdits", "acceptEdits"),
+                   ("manual", "manual"), ("dontAsk", "dontAsk"), ("plan", "plan")],
+        "codex": [("", "Provider default"), ("untrusted", "untrusted"), ("on-request", "on-request"),
+                  ("never", "never")],
+    ]
+    static let overlaps = [("replace", "Replace the running one"), ("parallel", "Run in parallel")]
+}
+
+// MARK: - Rows
+
+// One row of the Settings page: a title and explanation on the left, its
+// control on the right. Return or Space acts on the control: a switch flips,
+// a menu opens, a field takes the keyboard.
+final class OmniSettingRow: NSView, OmniZoneItem {
+    private let titleLabel = NSTextField(labelWithString: "")
+    private let detailLabel = NSTextField(labelWithString: "")
+    let control: NSView
+    private let controlWidth: CGFloat
+    var isSelected = false {
+        didSet { needsDisplay = true }
+    }
+    var zoneHasFocus = false {
+        didSet {
+            if zoneHasFocus != oldValue && isSelected {
+                needsDisplay = true
+            }
+        }
+    }
+
+    static let height: CGFloat = 46
+
+    override var isFlipped: Bool { true }
+
+    init(title: String, detail: String, control: NSView, controlWidth: CGFloat = 220) {
+        self.control = control
+        self.controlWidth = controlWidth
+        super.init(frame: NSRect(x: 0, y: 0, width: 500, height: Self.height))
+        wantsLayer = true
+        titleLabel.stringValue = title
+        titleLabel.font = OmniTheme.Font.rowTitleEmphasized
+        titleLabel.lineBreakMode = .byTruncatingTail
+        addSubview(titleLabel)
+        detailLabel.stringValue = detail
+        detailLabel.font = OmniTheme.Font.rowDetail
+        detailLabel.textColor = OmniTheme.secondaryText
+        detailLabel.lineBreakMode = .byTruncatingTail
+        addSubview(detailLabel)
+        addSubview(control)
+        setAccessibilityElement(true)
+        setAccessibilityRole(.group)
+        setAccessibilityLabel(title)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    var detail: String {
+        get { detailLabel.stringValue }
+        set { detailLabel.stringValue = newValue }
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let width = min(controlWidth, max(120, bounds.width * 0.45))
+        let controlHeight = min(max(control.fittingSize.height, 22), 30)
+        control.frame = NSRect(x: bounds.width - width - 10, y: (bounds.height - controlHeight) / 2,
+                               width: width, height: controlHeight)
+        if control is NSSwitch {
+            let size = control.fittingSize
+            control.frame = NSRect(x: bounds.width - size.width - 10, y: (bounds.height - size.height) / 2,
+                                   width: size.width, height: size.height)
+        }
+        let textWidth = max(0, control.frame.minX - 24)
+        titleLabel.frame = NSRect(x: 12, y: 6, width: textWidth, height: 18)
+        detailLabel.frame = NSRect(x: 12, y: 25, width: textWidth, height: 16)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        OmniZoneItemStyle.drawBackground(in: bounds, selected: isSelected, focused: zoneHasFocus, hovering: false)
+    }
+
+    func activate() {
+        switch control {
+        case let toggle as NSSwitch:
+            toggle.state = toggle.state == .on ? .off : .on
+            toggle.sendAction(toggle.action, to: toggle.target)
+        case let popUp as NSPopUpButton:
+            popUp.performClick(nil)
+        case let button as NSButton:
+            button.performClick(nil)
+        default:
+            window?.makeFirstResponder(control)
+        }
+    }
+}
+
+// MARK: - Page
+
+// The Settings page (the `.settings` route): notifications, the app's own
+// behaviour and the defaults for new agents. Every change saves at once
+// through `set_settings`; the app applies the shortcut and login launch.
+// The Settings page's tabs, as on a project page.
+enum OmniSettingsTab: Int, CaseIterable {
+    case general
+    case notifications
+    case agents
+    case memory
+    case accounts
+
+    var label: String {
+        switch self {
+        case .general: return "General"
+        case .notifications: return "Notifications"
+        case .agents: return "Agents"
+        case .memory: return "Memory"
+        case .accounts: return "Accounts"
+        }
+    }
+
+    var symbol: SFSymbol {
+        switch self {
+        case .general: return .gearshape
+        case .notifications: return .bell
+        case .agents: return .sparkles
+        case .memory: return .brain
+        case .accounts: return .person2
+        }
+    }
+}
+
+final class OmniSettingsPane: OmniPane, NSTextFieldDelegate, NSComboBoxDelegate, iTermShortcutInputViewDelegate {
+    private let scroll = OmniColumnScrollView()
+    private let statusLabel = OmniTheme.meta()
+    private(set) var settings: [String: Any] = [:]
+    private var agentNames: [String] = []
+    private var modelSuggestions: [String: [String]] = [:]
+    private var built = false
+    // One zone per section, so Tab moves between sections.
+    private(set) var zones: [(title: String, zone: OmniListZone)] = []
+    // Fields commit when editing ends; each knows how to turn its text into a change.
+    private var fieldCommits: [ObjectIdentifier: (String) -> [String: Any]?] = [:]
+    var now: () -> Date = Date.init
+    private(set) var tab = OmniSettingsTab(rawValue: UserDefaults.standard.integer(forKey: "NoSyncOmniSettingsTab")) ?? .general
+    private var tabsZone: OmniButtonZone?
+    // Accounts tab: the routers' accounts per provider, from `list_accounts`.
+    private(set) var accounts: [String: [String: Any]] = [:]
+    private var accountsError: String?
+
+    override var contentViews: [NSView] {
+        return [scroll]
+    }
+
+    override var focusZones: [OmniFocusZone] {
+        return [tabsZone].compactMap { $0 } + zones.map(\.zone)
+    }
+
+    override init() {
+        super.init()
+        addSubview(scroll)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func layoutPane() {
+        super.layoutPane()
+        scroll.frame = bounds
+    }
+
+    override func reload() {
+        if tab == .accounts {
+            loadAccounts(refresh: false)
+        }
+        var settingsResponse: [AnyHashable: Any]?
+        var agentsResponse: [AnyHashable: Any]?
+        let group = DispatchGroup()
+        group.enter()
+        OmniSchedulerClient.request(["op": "get_settings"]) { response in
+            settingsResponse = response
+            group.leave()
+        }
+        group.enter()
+        OmniSchedulerClient.request(["op": "list_agents"]) { response in
+            agentsResponse = response
+            group.leave()
+        }
+        group.notify(queue: .main) { [weak self] in
+            guard let self, let settingsResponse else { return }
+            guard OmniPane.isOK(settingsResponse), let settings = settingsResponse["settings"] as? [String: Any] else {
+                self.showMessage(OmniPane.unreachableMessage(settingsResponse))
+                return
+            }
+            let agents = (agentsResponse?["agents"] as? [[String: Any]]) ?? []
+            self.agentNames = agents.compactMap { $0["name"] as? String }
+            var suggestions: [String: Set<String>] = [:]
+            for agent in agents {
+                guard let provider = agent["provider"] as? String,
+                      let model = agent["model"] as? String, !model.isEmpty else { continue }
+                suggestions[provider, default: []].insert(model)
+            }
+            self.modelSuggestions = suggestions.mapValues { $0.sorted() }
+            self.apply(settings)
+        }
+    }
+
+    // Rebuilds the page from settings, keeping the scroll position and the zone
+    // that had the keyboard.
+    func apply(_ settings: [String: Any]) {
+        self.settings = settings
+        preservingZoneFocus {
+            scroll.rebuildKeepingScroll {
+                build()
+            }
+        }
+        showContent()
+    }
+
+    // MARK: Saving
+
+    func save(_ changes: [String: Any]) {
+        OmniSchedulerClient.request(["op": "set_settings", "settings": changes]) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response), let settings = response["settings"] as? [String: Any] {
+                self.setStatus("Saved. Changes apply immediately.", error: false)
+                self.apply(settings)
+            } else {
+                self.setStatus(response["error"] as? String ?? "Could not save the setting.", error: true)
+                // Put the controls back to what is stored.
+                self.apply(self.settings)
+            }
+        }
+    }
+
+    private func setStatus(_ text: String, error: Bool) {
+        statusLabel.stringValue = text
+        statusLabel.textColor = error ? OmniTheme.failed : OmniTheme.secondaryText
+    }
+
+    private var notificationSettings: [String: Any] {
+        return settings["notifications"] as? [String: Any] ?? [:]
+    }
+
+    private var agentDefaults: [String: Any] {
+        return settings["agent_defaults"] as? [String: Any] ?? [:]
+    }
+
+    // MARK: Building
+
+    private func build() {
+        let column = scroll.column
+        column.removeAll()
+        fieldCommits = [:]
+        let previousZones = zones
+        zones = []
+        column.addText(OmniTheme.title("Settings"), spacing: 4)
+        if !built {
+            setStatus("Changes apply immediately.", error: false)
+            built = true
+        }
+        column.addText(statusLabel, spacing: 10)
+        let tabs = OmniTabBar(tabs: OmniSettingsTab.allCases.map { (title: $0.label, symbol: $0.symbol) },
+                              selected: tab.rawValue, target: self, action: #selector(tabClicked(_:)))
+        tabsZone = tabs.zone
+        column.add(tabs, spacing: 16) { _ in OmniTabBar.height }
+
+        switch tab {
+        case .general:
+            section("General", previous: previousZones, rows: generalRows())
+            section("New agents", previous: previousZones, rows: newAgentRows())
+        case .notifications:
+            section("Notifications", previous: previousZones, rows: notificationRows())
+            section("Notification kinds", previous: previousZones, rows: kindRows())
+        case .agents:
+            section("Per agent", previous: previousZones, rows: agentRows())
+        case .memory:
+            section("Memory", previous: previousZones, rows: memoryRows())
+        case .accounts:
+            buildAccounts(previousZones)
+            return
+        }
+
+        let hint = OmniTheme.meta("Stored in ~/.omni/settings.json. Notifications you mute or quiet still reach the Inbox.")
+        column.addText(hint, spacing: 8)
+    }
+
+    @objc private func tabClicked(_ sender: NSButton) {
+        show(tab: OmniSettingsTab(rawValue: sender.tag) ?? .general)
+    }
+
+    func show(tab chosen: OmniSettingsTab) {
+        tab = chosen
+        UserDefaults.standard.set(chosen.rawValue, forKey: "NoSyncOmniSettingsTab")
+        if chosen == .accounts {
+            loadAccounts(refresh: false)
+        }
+        apply(settings)
+    }
+
+    // MARK: Accounts
+
+    private static let providers = [("claude", "Claude"), ("codex", "Codex")]
+
+    func loadAccounts(refresh: Bool) {
+        OmniSchedulerClient.request(["op": refresh ? "refresh_accounts" : "list_accounts"]) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response) {
+                self.accounts = response["providers"] as? [String: [String: Any]] ?? [:]
+                self.accountsError = nil
+            } else {
+                self.accountsError = response["error"] as? String ?? "The accounts could not be read."
+            }
+            if self.tab == .accounts {
+                self.apply(self.settings)
+            }
+        }
+    }
+
+    private func buildAccounts(_ previous: [(title: String, zone: OmniListZone)]) {
+        let column = scroll.column
+        if let accountsError {
+            column.addText(OmniTheme.meta(accountsError), spacing: 8)
+        }
+        for (provider, title) in Self.providers {
+            let info = accounts[provider] ?? [:]
+            let list = info["accounts"] as? [[String: Any]] ?? []
+            var rows: [(key: String, row: OmniSettingRow)] = list.map { account in
+                let name = account["name"] as? String ?? ""
+                return (key: "\(provider)|\(name)", row: accountRow(provider, account))
+            }
+            let add = NSButton(title: "Add Account…", target: self, action: #selector(addAccount(_:)))
+            add.bezelStyle = .rounded
+            add.identifier = NSUserInterfaceItemIdentifier(provider)
+            let router = info["router"] as? Bool ?? false
+            rows.append((key: "\(provider)|add", row: OmniSettingRow(
+                title: "Add a \(title) account",
+                detail: router ? "Signs in in your browser; new sessions then pick the account with the most room."
+                    : "The \(title) router is not installed: Install Routers below.",
+                control: add, controlWidth: 150)))
+            section("\(title) accounts", previous: previous, rows: rows)
+        }
+        let refresh = NSButton(title: "Refresh Usage", target: self, action: #selector(refreshAccounts(_:)))
+        refresh.bezelStyle = .rounded
+        let install = NSButton(title: "Install Routers", target: self, action: #selector(installRouters(_:)))
+        install.bezelStyle = .rounded
+        section("Routers", previous: previous, rows: [
+            (key: "refresh", row: OmniSettingRow(title: "Usage", detail: "Asks each account for its current limits.",
+                                                 control: refresh, controlWidth: 150)),
+            (key: "install", row: OmniSettingRow(
+                title: "claude and codex commands",
+                detail: "Puts OmniTerm’s routers first on your PATH, so every session picks an account with room.",
+                control: install, controlWidth: 150))])
+        column.addText(OmniTheme.meta("claude --usage and codex --usage show the same in a terminal."), spacing: 8)
+    }
+
+    static func usageLine(_ account: [String: Any]) -> String {
+        var parts: [String] = []
+        if let plan = account["plan"] as? String, !plan.isEmpty {
+            parts.append(plan)
+        }
+        let usage = account["usage"] as? [String: Any] ?? [:]
+        for (key, label) in [("five_hour", "5h"), ("seven_day", "7d")] {
+            guard let window = usage[key] as? [String: Any],
+                  let percent = (window["percent"] as? NSNumber)?.doubleValue else { continue }
+            var text = "\(label) \(Int(percent.rounded()))%"
+            if let reset = (window["resets_at"] as? NSNumber)?.doubleValue, reset > Date().timeIntervalSince1970 {
+                text += " (resets in \(OmniSessionText.age(2 * Date().timeIntervalSince1970 - reset)))"
+            }
+            parts.append(text)
+        }
+        if let sessions = (account["sessions"] as? NSNumber)?.intValue, sessions > 0 {
+            parts.append(sessions == 1 ? "1 session" : "\(sessions) sessions")
+        }
+        if let error = account["error"] as? String, !error.isEmpty {
+            parts.append(error)
+        }
+        return parts.isEmpty ? "No usage yet" : parts.joined(separator: " · ")
+    }
+
+    private func accountRow(_ provider: String, _ account: [String: Any]) -> OmniSettingRow {
+        let name = account["name"] as? String ?? ""
+        let email = account["email"] as? String ?? ""
+        let manage = NSPopUpButton(frame: .zero, pullsDown: true)
+        manage.addItem(withTitle: "Manage")
+        for (title, action) in [("Log In Again", #selector(loginAccount(_:))), ("Rename…", #selector(renameAccount(_:))),
+                                ("Edit Email…", #selector(editAccountEmail(_:))), ("Remove…", #selector(removeAccount(_:)))] {
+            let item = NSMenuItem(title: title, action: action, keyEquivalent: "")
+            item.target = self
+            item.representedObject = [provider, name, email]
+            manage.menu?.addItem(item)
+        }
+        var title = name
+        if !email.isEmpty {
+            title += " · " + email
+        }
+        if account["active"] as? Bool == true {
+            title += " · active"
+        }
+        return OmniSettingRow(title: title, detail: Self.usageLine(account), control: manage, controlWidth: 130)
+    }
+
+    private func accountRequest(_ request: [String: Any], done: String) {
+        setStatus("Working…", error: false)
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response) {
+                self.setStatus(done, error: false)
+            } else {
+                self.setStatus(response["error"] as? String ?? "That did not work.", error: true)
+            }
+            self.loadAccounts(refresh: false)
+        }
+    }
+
+    // A one-field question; nil when cancelled.
+    static var ask: (String, String, String, NSWindow?) -> String? = { heading, prompt, value, window in
+        let field = NSTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 24))
+        field.stringValue = value
+        field.placeholderString = prompt
+        let selection = iTermWarning.show(withTitle: prompt, actions: ["OK", "Cancel"], actionMapping: nil,
+                                          accessory: field, identifier: nil, silenceable: .kiTermWarningTypePersistent,
+                                          heading: heading, cancelLabel: "Cancel", window: window)
+        let text = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        return selection == .kiTermWarningSelection0 && !text.isEmpty ? text : nil
+    }
+
+    static var confirm: (String, String, NSWindow?) -> Bool = { heading, detail, window in
+        return iTermWarning.show(withTitle: detail, actions: ["Remove", "Cancel"], actionMapping: nil, accessory: nil,
+                                 identifier: nil, silenceable: .kiTermWarningTypePersistent, heading: heading,
+                                 cancelLabel: "Cancel", window: window) == .kiTermWarningSelection0
+    }
+
+    private static func target(_ sender: NSMenuItem) -> (provider: String, name: String, email: String)? {
+        guard let parts = sender.representedObject as? [String], parts.count == 3 else { return nil }
+        return (parts[0], parts[1], parts[2])
+    }
+
+    @objc private func addAccount(_ sender: NSButton) {
+        let provider = sender.identifier?.rawValue ?? "claude"
+        guard let name = Self.ask("Add a \(provider == "codex" ? "Codex" : "Claude") account",
+                                  "A short name for the account, such as work or personal", "", window) else { return }
+        let email = Self.ask("Email for “\(name)”", "The email to sign in with (optional)", "", window) ?? ""
+        var request: [String: Any] = ["op": "add_account", "provider": provider, "name": name]
+        if !email.isEmpty {
+            request["email"] = email
+        }
+        accountRequest(request, done: "Finish signing in in your browser; the account appears here once it is done.")
+    }
+
+    @objc private func loginAccount(_ sender: NSMenuItem) {
+        guard let target = Self.target(sender) else { return }
+        accountRequest(["op": "login_account", "provider": target.provider, "name": target.name],
+                       done: "Finish signing in in your browser.")
+    }
+
+    @objc private func renameAccount(_ sender: NSMenuItem) {
+        guard let target = Self.target(sender),
+              let newName = Self.ask("Rename “\(target.name)”", "New name", target.name, window),
+              newName != target.name else { return }
+        accountRequest(["op": "rename_account", "provider": target.provider, "name": target.name, "new_name": newName],
+                       done: "Renamed.")
+    }
+
+    @objc private func editAccountEmail(_ sender: NSMenuItem) {
+        guard let target = Self.target(sender),
+              let email = Self.ask("Email for “\(target.name)”", "Email", target.email, window) else { return }
+        accountRequest(["op": "set_account_email", "provider": target.provider, "name": target.name, "email": email],
+                       done: "Saved.")
+    }
+
+    @objc private func removeAccount(_ sender: NSMenuItem) {
+        guard let target = Self.target(sender),
+              Self.confirm("Remove the account “\(target.name)”?",
+                           "Its saved sign-in is deleted from OmniTerm’s router. Running sessions keep going.", window)
+        else { return }
+        accountRequest(["op": "remove_account", "provider": target.provider, "name": target.name], done: "Removed.")
+    }
+
+    @objc private func refreshAccounts(_ sender: Any?) {
+        setStatus("Checking usage…", error: false)
+        loadAccounts(refresh: true)
+    }
+
+    @objc private func installRouters(_ sender: Any?) {
+        accountRequest(["op": "install_routers"], done: "Routers installed. New terminals use them.")
+    }
+
+    private func section(_ title: String, previous: [(title: String, zone: OmniListZone)],
+                         rows: [(key: String, row: OmniSettingRow)]) {
+        guard !rows.isEmpty else { return }
+        let column = scroll.column
+        column.addSection(title)
+        // The zone object survives a rebuild so it keeps the keyboard.
+        let zone = previous.first { $0.title == title }?.zone ?? OmniListZone()
+        let list = OmniColumnView()
+        list.inset = 0
+        list.topPadding = 0
+        list.bottomPadding = 0
+        list.overlay = zone
+        for (_, row) in rows {
+            list.add(row, spacing: 2) { _ in OmniSettingRow.height }
+        }
+        zone.setItems(rows.map { (key: $0.key, view: $0.row as OmniZoneItem) })
+        column.add(list, spacing: 8) { [weak list] width in
+            list?.layoutColumn(width: width) ?? 0
+        }
+        zones.append((title: title, zone: zone))
+    }
+
+    // MARK: Controls
+
+    private func popUp(_ items: [(String, String)], selected: String, change: @escaping (String) -> Void) -> NSPopUpButton {
+        let button = NSPopUpButton(frame: .zero, pullsDown: false)
+        button.font = OmniTheme.Font.rowTitle
+        for (value, title) in items {
+            button.addItem(withTitle: title)
+            button.lastItem?.representedObject = value
+        }
+        if let index = items.firstIndex(where: { $0.0 == selected }) {
+            button.selectItem(at: index)
+        }
+        button.target = self
+        button.action = #selector(popUpChanged(_:))
+        popUpChanges[ObjectIdentifier(button)] = change
+        return button
+    }
+
+    private var popUpChanges: [ObjectIdentifier: (String) -> Void] = [:]
+    private var toggleChanges: [ObjectIdentifier: (Bool) -> Void] = [:]
+
+    @objc private func popUpChanged(_ sender: NSPopUpButton) {
+        guard let value = sender.selectedItem?.representedObject as? String else { return }
+        popUpChanges[ObjectIdentifier(sender)]?(value)
+    }
+
+    private func toggle(_ on: Bool, change: @escaping (Bool) -> Void) -> NSSwitch {
+        let toggle = NSSwitch()
+        toggle.state = on ? .on : .off
+        toggle.target = self
+        toggle.action = #selector(toggleChanged(_:))
+        toggleChanges[ObjectIdentifier(toggle)] = change
+        return toggle
+    }
+
+    @objc private func toggleChanged(_ sender: NSSwitch) {
+        toggleChanges[ObjectIdentifier(sender)]?(sender.state == .on)
+    }
+
+    private func field(_ value: String, placeholder: String = "", suggestions: [String]? = nil,
+                       commit: @escaping (String) -> [String: Any]?) -> NSTextField {
+        let field: NSTextField
+        if let suggestions {
+            let combo = NSComboBox()
+            combo.completes = true
+            combo.addItems(withObjectValues: suggestions)
+            combo.delegate = self
+            field = combo
+        } else {
+            field = NSTextField()
+            field.delegate = self
+        }
+        field.stringValue = value
+        field.placeholderString = placeholder
+        field.font = OmniTheme.Font.rowTitle
+        fieldCommits[ObjectIdentifier(field)] = commit
+        return field
+    }
+
+    func controlTextDidEndEditing(_ notification: Notification) {
+        guard let field = notification.object as? NSTextField,
+              let commit = fieldCommits[ObjectIdentifier(field)] else { return }
+        let text = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        if let changes = commit(text) {
+            save(changes)
+        } else {
+            setStatus("That value is not valid here.", error: true)
+            apply(settings)
+        }
+        // The keyboard goes back to the row's zone.
+        if let zone = zones.first(where: { $0.zone.keys.contains { key in rowKey(for: field) == key } })?.zone {
+            zone.zoneEnter()
+        }
+    }
+
+    func comboBoxSelectionDidChange(_ notification: Notification) {
+        guard let combo = notification.object as? NSComboBox, combo.indexOfSelectedItem >= 0,
+              let commit = fieldCommits[ObjectIdentifier(combo)],
+              let value = combo.itemObjectValue(at: combo.indexOfSelectedItem) as? String,
+              let changes = commit(value) else { return }
+        save(changes)
+    }
+
+    private var rowKeysByControl: [ObjectIdentifier: String] = [:]
+
+    private func rowKey(for control: NSView) -> String? {
+        return rowKeysByControl[ObjectIdentifier(control)]
+    }
+
+    private func row(_ key: String, _ title: String, _ detail: String, _ control: NSView,
+                     width: CGFloat = 220) -> (key: String, row: OmniSettingRow) {
+        rowKeysByControl[ObjectIdentifier(control)] = key
+        return (key: key, row: OmniSettingRow(title: title, detail: detail, control: control, controlWidth: width))
+    }
+
+    // MARK: Sections
+
+    private func notificationRows() -> [(key: String, row: OmniSettingRow)] {
+        let current = OmniSettingsModel.mute(notificationSettings["muted_until"], now: now())
+        let description = OmniSettingsModel.muteDescription(current, now: now())
+        var items: [(String, String)] = []
+        if current != .off {
+            items.append(("current", description))
+        }
+        items += [("off", current == .off ? "Not muted" : "Unmute"), ("hour", "For 1 hour"),
+                  ("tomorrow", "Until tomorrow morning"), ("forever", "Until I unmute")]
