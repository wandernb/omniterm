+    // Hiding posts an occlusion change from inside orderOut; the window then
+    // still has the frame the person last saw, never resized by them.
+    // Shows or hides the window as the window server reports it.
+    private func occlusion(onScreen: Bool) {
+        OmniSidebarViewController.windowIsOnScreen = { _ in onScreen }
+        NotificationCenter.default.post(name: NSWindow.didChangeOcclusionStateNotification, object: window)
+    }
