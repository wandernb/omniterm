+- (void)cleanOmniTermStartupTabsInTerminal:(PseudoTerminal *)terminal
+                                keepingTab:(PTYTab *)dashboardTab {
+    for (PTYTab *tab in [[terminal.tabs copy] autorelease]) {
+        if (tab == dashboardTab) {
+            continue;
+        }
+        BOOL isDashboard = NO;
+        BOOL allExited = tab.sessions.count > 0;
+        for (PTYSession *session in tab.sessions) {
+            NSString *name = session.profile[KEY_NAME];
+            isDashboard |= [name isEqualToString:@"Omni"] || [name isEqualToString:@"AGENTS"];
+            allExited &= session.exited;
+        }
+        PTYSession *onlySession = tab.sessions.count == 1 ? tab.sessions.firstObject : nil;
+        const BOOL isManaged = [onlySession.environment[@"OMNITERM_MANAGED"] isEqualToString:@"1"];
+        // Creating the first terminal window necessarily creates a temporary
+        // default shell. Its working directory may be inherited from iTerm2
+        // (for example ~/Projects), so cwd is not a reliable discriminator.
+        const BOOL isIdlePlaceholderShell = (onlySession &&
+                                             !isManaged &&
+                                             !onlySession.exited &&
+                                             !onlySession.hasNontrivialJob);
+        // A restored managed tab that has lost its agent identity presents as
+        // “Terminal (Python)”. It is an orphaned runner rather than a usable
+        // retained agent tab, even though the Python supervisor may still be
+        // waiting on a detached descendant.
+        const BOOL isOrphanedManagedRunner = (onlySession &&
+                                              [onlySession.name hasPrefix:@"Terminal"] &&
+                                              [onlySession.name containsString:@"Python"]);
+        if (isDashboard || allExited || isIdlePlaceholderShell || isOrphanedManagedRunner) {
+            tab.pinned = NO;
+            [terminal closeTab:tab];
+        }
+    }
+    dashboardTab.pinned = NO;
+    const NSInteger dashboardIndex = [terminal.tabs indexOfObject:dashboardTab];
+    if (dashboardIndex > 0 && dashboardIndex != NSNotFound) {
+        [terminal moveTabAtIndex:dashboardIndex toIndex:0];
+    }
+}
+
+// Agent tabs never outlive their run. This is deliberately not a profile end
+// action: run tabs share the default profile's GUID, so any change to that
+// profile (including one made by iTerm2, which shares these defaults) would
+// silently reset an override.
+- (void)omniTermSessionDidTerminate:(NSNotification *)notification {
+    PTYSession *session = notification.object;
+    if (![session.environment[@"OMNITERM_KIND"] isEqualToString:@"run"]) {
+        return;
+    }
+    // Termination is announced from inside brokenPipe; let it unwind first.
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [session.delegate closeSession:session];
+    });
+}
+
+- (void)launchOmniSchedulerCommand:(NSString *)command title:(NSString *)title {
+    PseudoTerminal *terminal = [iTermController sharedInstance].currentTerminal ?: self.terminals.firstObject;
+    if (!terminal) {
+        [[iTermController sharedInstance] newWindow:nil];
+        for (PseudoTerminal *newTerminal in self.terminals) {
+            [newTerminal.window orderOut:nil];
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [self launchOmniSchedulerCommand:command title:title];
+        });
+        return;
+    }
+    const BOOL wasVisible = terminal.window.isVisible;
+    const BOOL previouslyOrderedNewTabs = terminal.automaticallyOrderFrontNewTabs;
+    terminal.automaticallyOrderFrontNewTabs = NO;
+    MutableProfile *profile = [[[[ProfileModel sharedInstance] defaultBookmark] mutableCopy] autorelease];
+    profile[KEY_NAME] = title;
+    [terminal asyncCreateTabWithProfile:profile
+                            withCommand:command
+                            environment:@{ @"OMNITERM_MANAGED": @"1",
+                                           @"OMNITERM_KIND": [title isEqualToString:@"Omni"] ? @"dashboard" : @"run",
+                                           @"OMNITERM_DASHBOARD_KEYS": [title isEqualToString:@"Omni"] ? @"1" : @"0" }
+                               tabIndex:[title isEqualToString:@"Omni"] ? @0 : nil
+                         didMakeSession:^(PTYSession *session) {
+        [session.nameController setNeedsUpdate];
+        if ([title isEqualToString:@"Omni"]) {
+            PTYTab *dashboardTab = [terminal tabForSession:session];
+            [self cleanOmniTermStartupTabsInTerminal:terminal keepingTab:dashboardTab];
+            // Restored helpers can take a moment to notice that their owning
+            // app process changed and exit. Sweep again while launch settles
+            // so they cannot remain as dead “Terminal Python” tabs.
+            for (NSNumber *delay in @[ @1, @3 ]) {
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+                                             delay.longLongValue * NSEC_PER_SEC),
+                               dispatch_get_main_queue(), ^{
+                    if ([terminal.tabs containsObject:dashboardTab]) {
+                        [self cleanOmniTermStartupTabsInTerminal:terminal keepingTab:dashboardTab];
+                    }
+                });
+            }
+        }
+        terminal.automaticallyOrderFrontNewTabs = previouslyOrderedNewTabs;
+        if (!wasVisible) {
+            [terminal.window orderOut:nil];
+        }
+    }
+                             completion:nil];
+}
