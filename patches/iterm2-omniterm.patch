+// A vertical column of views, each as wide as the column, laid out top to
+// bottom. Heights come from each entry, so wrapped text grows the column.
+final class OmniColumnView: NSView {
+    struct Entry {
+        let view: NSView
+        let height: (CGFloat) -> CGFloat
+        let spacing: CGFloat
+        let indent: CGFloat
+    }
+
+    private var entries: [Entry] = []
+    // Kept above the entries and over the whole column, such as a list zone.
+    var overlay: NSView? {
+        didSet {
+            oldValue?.removeFromSuperview()
+            if let overlay {
+                addSubview(overlay)
+            }
+        }
+    }
+    var inset: CGFloat = 28
+    var topPadding: CGFloat = 22
+    var bottomPadding: CGFloat = 20
+
+    override var isFlipped: Bool { true }
+
+    func removeAll() {
+        for entry in entries {
+            entry.view.removeFromSuperview()
+        }
+        entries = []
+    }
+
+    func add(_ view: NSView, spacing: CGFloat = 8, indent: CGFloat = 0, height: @escaping (CGFloat) -> CGFloat) {
+        if let overlay {
+            addSubview(view, positioned: .below, relativeTo: overlay)
+        } else {
+            addSubview(view)
+        }
+        entries.append(Entry(view: view, height: height, spacing: spacing, indent: indent))
+        OmniPointer.install(in: view)
+    }
+
+    func addText(_ field: NSTextField, spacing: CGFloat = 8, indent: CGFloat = 0) {
+        add(field, spacing: spacing, indent: indent) { width in
+            ceil(field.sizeThatFits(NSSize(width: width, height: CGFloat.greatestFiniteMagnitude)).height)
+        }
+    }
+
+    // Parsed Markdown in a text field, on the Markdown card.
+    func addMarkdownCard(_ field: NSTextField, spacing: CGFloat = 8, indent: CGFloat = 0) {
+        let card = OmniMarkdownCardView(field)
+        let padding = card.padding
+        add(card, spacing: spacing, indent: indent) { width in
+            ceil(field.sizeThatFits(NSSize(width: max(1, width - 2 * padding), height: CGFloat.greatestFiniteMagnitude)).height)
+                + 2 * padding
+        }
+    }
+
+    func addSection(_ title: String) {
+        let label = OmniTheme.sectionHeader(title)
+        if !entries.isEmpty {
+            add(NSView(), spacing: 0) { _ in 14 }
+        }
+        add(label, spacing: 6) { _ in 16 }
+    }
+
+    // Lays the column out at a width and returns its height.
+    @discardableResult
+    func layoutColumn(width: CGFloat) -> CGFloat {
+        var y = topPadding
+        let available = max(120, width - inset * 2)
+        for entry in entries where !entry.view.isHidden {
+            let entryWidth = available - entry.indent
+            let height = entry.height(entryWidth)
+            entry.view.frame = NSRect(x: inset + entry.indent, y: y, width: entryWidth, height: height)
+            y += height + entry.spacing
+        }
+        let total = y + bottomPadding
+        setFrameSize(NSSize(width: width, height: total))
+        overlay?.frame = bounds
+        return total
+    }
+}
