+    // MARK: - Ingest
+
+    // The background consolidation agent is found by its managed marker, so a
+    // rename keeps working; its runs are then listed newest first.
+    private func loadIngestRuns() {
+        request("ingest", ["op": "list_agents"]) { [weak self] response in
+            guard let self else { return }
+            guard OmniPane.isOK(response) else {
+                self.showPlaceholder(response["error"] as? String ?? "Runs are unavailable.", in: self.ingestDetailText)
+                return
+            }
+            let agents = response["agents"] as? [[AnyHashable: Any]] ?? []
+            self.ingestAgent = agents.compactMap(OmniAgent.init).first(where: \.isBackground)
+            guard let agent = self.ingestAgent else {
+                self.renderIngestRuns([])
+                return
+            }
+            self.request("ingest-runs", ["op": "list_runs", "agent": agent.name, "limit": 100]) { [weak self] response in
+                guard let self, OmniPane.isOK(response) else { return }
+                self.renderIngestRuns((response["runs"] as? [[AnyHashable: Any]] ?? []).compactMap(OmniRun.init))
+            }
+        }
+    }
+
+    func renderIngestRuns(_ runs: [OmniRun]) {
+        let signature = runs.map { "\($0.id)|\($0.state)|\($0.finalMessage ?? "")|\($0.summary ?? "")" }
+        let previous = ingestRuns.map { "\($0.id)|\($0.state)|\($0.finalMessage ?? "")|\($0.summary ?? "")" }
+        updateIngestButtons()
+        guard signature != previous || ingestTable.numberOfRows != runs.count else { return }
+        let selected = ingestTable.selectedRow >= 0 && ingestTable.selectedRow < ingestRuns.count
+            ? ingestRuns[ingestTable.selectedRow].id : nil
+        ingestRuns = runs
+        ingestCount.stringValue = runs.isEmpty ? "" : "\(runs.count)"
+        ingestTable.reloadData()
+        if let selected, let row = runs.firstIndex(where: { $0.id == selected }) {
+            ingestTable.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+            showIngestRun(runs[row])
+        } else if !runs.isEmpty {
+            ingestTable.selectRowIndexes(IndexSet(integer: 0), byExtendingSelection: false)
+            showIngestRun(runs[0])
+        } else {
+            let agent = ingestAgent.map { "“\($0.name)” has not run yet." } ??
+                "No memory agent is set up. Ask Claude or Codex to call configure_memory through OmniTerm’s MCP tools."
+            showPlaceholder(agent + " Each consolidation run turns transcript candidates into durable memories; " +
+                            "its runs appear here instead of the sidebar’s Runs.", in: ingestDetailText)
+        }
+        updateIngestButtons()
+    }
+
+    private func showIngestRun(_ run: OmniRun) {
+        ingestDetailText.textStorage?.setAttributedString(OmniMemoryText.ingestRunDetail(run, agent: ingestAgent))
+        updateIngestButtons()
+    }
+
+    private var selectedIngestRun: OmniRun? {
+        let row = ingestTable.selectedRow
+        return row >= 0 && row < ingestRuns.count ? ingestRuns[row] : nil
+    }
+
+    private func updateIngestButtons() {
+        openIngestRunButton.isEnabled = selectedIngestRun != nil
+        runIngestButton.isEnabled = ingestAgent != nil && !ingestRuns.contains(where: \.isWorking)
+        openIngestAgentButton.isEnabled = ingestAgent != nil
+        ingestButtons.resizeSubviews(withOldSize: ingestButtons.frame.size)
+    }
+
+    @objc private func openIngestRun(_ sender: Any?) {
+        guard let run = selectedIngestRun else { return }
+        openRun?(run.id)
+    }
