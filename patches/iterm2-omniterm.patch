new file mode 100644
index 0000000000000000000000000000000000000000..0114a95f97bad9bd37b795fcab055a99e21ce0e5
--- /dev/null
+++ b/ModernTests/OmniSidebarLayoutTests.swift
@@ -0,0 +1,132 @@
+//
+//  OmniSidebarLayoutTests.swift
+//  ModernTests
+//
+//  OmniTerm's sidebar sits left of the tab view. A zero width must leave
+//  every upstream layout exactly as it was.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniSidebarLayoutTests: XCTestCase {
+    private func inputs(tabBarVisible: Bool, toolbelt: Bool, statusBar: Bool) -> iTermLayoutInputs {
+        var inputs = iTermLayoutInputs()
+        inputs.contentViewWidth = 1000
+        inputs.contentViewHeight = 600
+        inputs.tabBarHeight = 28
+        inputs.leftTabBarWidth = 150
+        inputs.toolbeltWidth = 200
+        inputs.shouldShowToolbelt = ObjCBool(toolbelt)
+        inputs.statusBarHeight = 21
+        inputs.hasStatusBar = ObjCBool(statusBar)
+        inputs.statusBarOnTop = false
+        inputs.tabBarVisible = ObjCBool(tabBarVisible)
+        inputs.tabPosition = kLayoutTabPositionTop
+        inputs.divisionViewVisible = true
+        inputs.divisionViewHeight = 1
+        inputs.drawWindowTitleInPlaceOfTabBar = ObjCBool(!tabBarVisible)
+        return inputs
+    }
+
+    private func assertEqual(_ lhs: iTermLayoutOutputs, _ rhs: iTermLayoutOutputs,
+                             file: StaticString = #filePath, line: UInt = #line) {
+        XCTAssertEqual(lhs.tabViewFrame, rhs.tabViewFrame, file: file, line: line)
+        XCTAssertEqual(lhs.statusBarFrame, rhs.statusBarFrame, file: file, line: line)
+        XCTAssertEqual(lhs.toolbeltFrame, rhs.toolbeltFrame, file: file, line: line)
+        XCTAssertEqual(lhs.tabBarFrame, rhs.tabBarFrame, file: file, line: line)
+        XCTAssertEqual(lhs.decorationHeightTop, rhs.decorationHeightTop, file: file, line: line)
+        XCTAssertEqual(lhs.decorationHeightBottom, rhs.decorationHeightBottom, file: file, line: line)
+    }
+
+    func testZeroWidthReproducesTodaysFrames() {
+        // The per-position entry points are upstream's own layouts, untouched
+        // by the sidebar; the main entry point must match them at zero width.
+        for tabBarVisible in [false, true] {
+            for position in [kLayoutTabPositionTop, kLayoutTabPositionBottom,
+                             kLayoutTabPositionLeft, kLayoutTabPositionRight] {
+                var zero = inputs(tabBarVisible: tabBarVisible, toolbelt: true, statusBar: true)
+                zero.tabPosition = position
+                zero.omniSidebarWidth = 0
+                let upstream: iTermLayoutOutputs
+                if !tabBarVisible {
+                    upstream = iTermLayoutCalculator.calculateLayout(withHiddenTabBarInputs: zero)
+                } else if position == kLayoutTabPositionTop {
+                    upstream = iTermLayoutCalculator.calculateLayout(withVisibleTopTabBarInputs: zero)
+                } else if position == kLayoutTabPositionBottom {
+                    upstream = iTermLayoutCalculator.calculateLayout(withVisibleBottomTabBarInputs: zero)
+                } else if position == kLayoutTabPositionLeft {
+                    upstream = iTermLayoutCalculator.calculateLayout(withVisibleLeftTabBarInputs: zero)
+                } else {
+                    upstream = iTermLayoutCalculator.calculateLayout(withVisibleRightTabBarInputs: zero)
+                }
+                assertEqual(iTermLayoutCalculator.calculateLayout(with: zero), upstream)
+            }
+        }
+        let hidden = iTermLayoutCalculator.calculateLayout(with: inputs(tabBarVisible: false, toolbelt: true, statusBar: true))
+        XCTAssertEqual(hidden.tabViewFrame, CGRect(x: 0, y: 21, width: 800, height: 600 - 1 - 28 - 21))
+    }
+
+    func testSidebarOffsetsTheTabViewAndKeepsTheToolbeltAtTheRightEdge() {
+        var withSidebar = inputs(tabBarVisible: false, toolbelt: true, statusBar: true)
+        withSidebar.omniSidebarWidth = 240
+        let outputs = iTermLayoutCalculator.calculateLayout(with: withSidebar)
+
+        XCTAssertEqual(outputs.tabViewFrame.minX, 240)
+        XCTAssertEqual(outputs.tabViewFrame.width, 1000 - 240 - 200)
+        XCTAssertEqual(outputs.statusBarFrame.minX, 240)
+        XCTAssertEqual(outputs.statusBarFrame.width, outputs.tabViewFrame.width)
+        XCTAssertEqual(outputs.toolbeltFrame.maxX, 1000)
+        XCTAssertEqual(outputs.toolbeltFrame.width, 200)
+
+        let without = iTermLayoutCalculator.calculateLayout(with: inputs(tabBarVisible: false, toolbelt: true, statusBar: true))
+        XCTAssertEqual(outputs.tabViewFrame.height, without.tabViewFrame.height,
+                       "The sidebar never changes the terminal's height")
+        XCTAssertEqual(outputs.decorationHeightTop, without.decorationHeightTop)
+    }
+
+    func testTopInsetShortensTheTerminalFromTheTopOnly() {
+        var base = inputs(tabBarVisible: false, toolbelt: true, statusBar: true)
+        base.omniSidebarWidth = 240
+        let without = iTermLayoutCalculator.calculateLayout(with: base)
+
+        var withInset = base
+        withInset.omniContentTopInset = 120
+        let outputs = iTermLayoutCalculator.calculateLayout(with: withInset)
+
+        XCTAssertEqual(outputs.tabViewFrame.height, without.tabViewFrame.height - 120)
+        XCTAssertEqual(outputs.tabViewFrame.minY, without.tabViewFrame.minY, "The bottom edge stays put")
+        XCTAssertEqual(outputs.tabViewFrame.minX, without.tabViewFrame.minX)
+        XCTAssertEqual(outputs.tabViewFrame.width, without.tabViewFrame.width)
+        XCTAssertEqual(outputs.statusBarFrame, without.statusBarFrame, "A bottom status bar does not move")
+        XCTAssertEqual(outputs.decorationHeightTop, without.decorationHeightTop + 120)
+    }
+
+    func testZeroTopInsetReproducesTheSidebarLayout() {
+        var base = inputs(tabBarVisible: false, toolbelt: true, statusBar: true)
+        base.omniSidebarWidth = 240
+        var zero = base
+        zero.omniContentTopInset = 0
+        assertEqual(iTermLayoutCalculator.calculateLayout(with: zero),
+                     iTermLayoutCalculator.calculateLayout(with: base))
+        XCTAssertEqual(iTermLayoutCalculator.calculateLayout(with: zero).tabViewFrame,
+                       CGRect(x: 240, y: 21, width: 1000 - 240 - 200, height: 600 - 1 - 28 - 21))
+    }
+
+    func testTopInsetWithoutSidebarStartsAtTheLeftEdge() {
+        var withInset = inputs(tabBarVisible: false, toolbelt: false, statusBar: false)
+        withInset.omniContentTopInset = 100
+        let outputs = iTermLayoutCalculator.calculateLayout(with: withInset)
+        XCTAssertEqual(outputs.tabViewFrame, CGRect(x: 0, y: 0, width: 1000, height: 600 - 1 - 28 - 100))
+    }
+
+    func testEmptyFramesStayEmpty() {
+        var withSidebar = inputs(tabBarVisible: false, toolbelt: false, statusBar: false)
+        withSidebar.omniSidebarWidth = 240
+        let outputs = iTermLayoutCalculator.calculateLayout(with: withSidebar)
+        XCTAssertEqual(outputs.toolbeltFrame, .zero)
+        XCTAssertEqual(outputs.statusBarFrame, .zero)
+        XCTAssertEqual(outputs.tabBarFrame, .zero)
+        XCTAssertEqual(outputs.tabViewFrame, CGRect(x: 240, y: 0, width: 760, height: 600 - 1 - 28))
+    }
+}
