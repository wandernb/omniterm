+        NSMutableSet<NSString *> *groups = [NSMutableSet setWithArray:[self settings][@"sidebar_groups"]];
+        for (NSDictionary *row in [self rowsForSQL:@"SELECT * FROM agents" bindings:@[]]) {
+            NSDictionary *agent = [self decodedAgentRow:row];
+            [agentNames addObject:agent[@"name"]];
+            NSString *group = [agent[@"group"] isKindOfClass:[NSString class]] ? agent[@"group"] : nil;
