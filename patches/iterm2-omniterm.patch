+//
+//  OmniSchedulerTests.m
+//  ModernTests
+//
+//  Deterministic coverage for scheduler configuration and calendar behavior.
+//
+
+#import <XCTest/XCTest.h>
+
+#import "OmniScheduler.h"
+
+#import <sys/socket.h>
+#import <sys/un.h>
+
+@interface OmniScheduler (Tests)
+- (NSDictionary *)defaultSettings;
+- (NSDictionary *)settings;
+- (NSDictionary *)configurationForAgent:(NSDictionary *)agent;
+- (NSString *)agentPathForName:(NSString *)name;
+- (BOOL)writeAgentFile:(NSDictionary *)agent;
+- (BOOL)runSQL:(NSString *)sql bindings:(NSArray *)bindings;
+- (NSArray *)rowsForSQL:(NSString *)sql bindings:(NSArray *)bindings;
+- (void)reapAbandonedRuns;
+- (void)enforceRunRetention;
+- (NSDictionary *)responseForRequest:(id)request;
+- (id)nextRunForAgent:(NSDictionary *)agent after:(NSTimeInterval)timestamp;
+- (NSDictionary *)startAgentNamed:(NSString *)name
+                           reason:(NSString *)reason
+                  resumeSessionID:(nullable NSString *)resumeSessionID;
+@end
+
+@interface OmniSchedulerTests : XCTestCase
+@end
+
+@implementation OmniSchedulerTests {
+    OmniScheduler *_scheduler;
+    NSString *_temporaryPath;
+    NSCalendar *_calendar;
+}
+
+- (void)setUp {
+    [super setUp];
+    _temporaryPath = [NSTemporaryDirectory()
+        stringByAppendingPathComponent:[NSString stringWithFormat:@"omni-scheduler-tests-%@",
+                                                                  NSUUID.UUID.UUIDString]];
+    XCTAssertTrue([[NSFileManager defaultManager] createDirectoryAtPath:_temporaryPath
+                                            withIntermediateDirectories:YES
+                                                             attributes:nil
+                                                                  error:nil]);
+    NSString *agentsPath = [_temporaryPath stringByAppendingPathComponent:@"agents"];
+    XCTAssertTrue([[NSFileManager defaultManager] createDirectoryAtPath:agentsPath
+                                            withIntermediateDirectories:YES
+                                                             attributes:nil
+                                                                  error:nil]);
+    _scheduler = [[OmniScheduler alloc] initWithLaunchHandler:^(NSString *command,
+                                                                NSString *title) {}];
+    [_scheduler setValue:_temporaryPath forKey:@"supportPath"];
+    [_scheduler setValue:[_temporaryPath stringByAppendingPathComponent:@"scheduler.sock"]
+                  forKey:@"socketPath"];
+    [_scheduler setValue:_temporaryPath forKey:@"configPath"];
+    [_scheduler setValue:agentsPath forKey:@"agentsPath"];
+    [_scheduler setValue:[_temporaryPath stringByAppendingPathComponent:@"settings.json"]
+                  forKey:@"settingsPath"];
+
+    _calendar = [[NSCalendar alloc] initWithCalendarIdentifier:NSCalendarIdentifierGregorian];
+    _calendar.timeZone = [NSTimeZone timeZoneWithName:@"Europe/Paris"];
+    [self writeSettings:@{ @"timezone": @"Europe/Paris" }];
+}
+
+- (void)tearDown {
+    [_scheduler stop];
+    _scheduler = nil;
+    _calendar = nil;
+    [[NSFileManager defaultManager] removeItemAtPath:_temporaryPath error:nil];
+    _temporaryPath = nil;
+    [super tearDown];
+}
+
+- (void)writeSettings:(NSDictionary *)settings {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:settings options:0 error:nil];
+    XCTAssertTrue([data writeToFile:[_scheduler valueForKey:@"settingsPath"]
+                            options:NSDataWritingAtomic
+                              error:nil]);
+}
+
+- (NSTimeInterval)timestampForYear:(NSInteger)year
+                             month:(NSInteger)month
+                               day:(NSInteger)day
+                              hour:(NSInteger)hour
+                            minute:(NSInteger)minute {
+    NSDateComponents *components = [[NSDateComponents alloc] init];
+    components.year = year;
+    components.month = month;
+    components.day = day;
+    components.hour = hour;
+    components.minute = minute;
+    return [_calendar dateFromComponents:components].timeIntervalSince1970;
+}
+
+- (NSDateComponents *)componentsForTimestamp:(NSTimeInterval)timestamp {
+    return [_calendar components:(NSCalendarUnitYear |
+                                  NSCalendarUnitMonth |
+                                  NSCalendarUnitDay |
+                                  NSCalendarUnitHour |
+                                  NSCalendarUnitMinute |
+                                  NSCalendarUnitWeekday)
+                        fromDate:[NSDate dateWithTimeIntervalSince1970:timestamp]];
+}
+
+- (void)testDefaultSettingsPreserveProductInvariants {
+    NSDictionary *settings = [_scheduler defaultSettings];
+    XCTAssertEqualObjects(settings[@"schema_version"], @2);
+    XCTAssertEqualObjects(settings[@"default_timeout_seconds"], @7200);
+    XCTAssertEqualObjects(settings[@"retained_run_tabs"], @10);
+    XCTAssertEqualObjects(settings[@"double_escape_interval_ms"], @350);
+}
+
+- (void)testStoredSettingsMergeWithDefaultsAndForceCurrentSchema {
+    [self writeSettings:@{ @"schema_version": @1,
+                           @"timezone": @"UTC",
+                           @"retained_run_tabs": @25 }];
+    NSDictionary *settings = [_scheduler settings];
+    XCTAssertEqualObjects(settings[@"schema_version"], @2);
+    XCTAssertEqualObjects(settings[@"timezone"], @"UTC");
+    XCTAssertEqualObjects(settings[@"retained_run_tabs"], @25);
+    XCTAssertEqualObjects(settings[@"default_timeout_seconds"], @7200);
+}
+
+- (void)testCorruptSettingsFallBackToDefaults {
+    [@"not json" writeToFile:[_scheduler valueForKey:@"settingsPath"]
+                   atomically:YES
+                     encoding:NSUTF8StringEncoding
+                        error:nil];
+    NSDictionary *settings = [_scheduler settings];
+    XCTAssertEqualObjects(settings[@"schema_version"], @2);
+    XCTAssertEqualObjects(settings[@"default_timeout_seconds"], @7200);
+}
+
+- (void)testPersistedConfigurationOmitsComputedAndLegacyTimezoneFields {
+    NSDictionary *configuration = [_scheduler configurationForAgent:@{
+        @"name": @"Review",
+        @"next_run": @123,
+        @"last_run": @100,
+        @"timezone": @"UTC",
+        @"enabled": @YES,
+    }];
+    NSDictionary *expected = @{ @"name": @"Review", @"enabled": @YES };
+    XCTAssertEqualObjects(configuration, expected);
+}
+
+- (void)testAgentFilenameEscapesUnsafeCharacters {
+    NSString *path = [_scheduler agentPathForName:@"Review / docs"];
+    XCTAssertEqualObjects(path.lastPathComponent, @"Review%20%2F%20docs.json");
+    XCTAssertEqualObjects(path.stringByDeletingLastPathComponent,
+                          [_scheduler valueForKey:@"agentsPath"]);
+}
+
+- (void)testAgentFileWriteIsPrivateAndOmitsComputedFields {
+    NSDictionary *agent = @{
+        @"name": @"Review",
+        @"provider": @"codex",
+        @"next_run": @123,
+        @"last_run": @100,
+        @"timezone": @"UTC",
+    };
+    XCTAssertTrue([_scheduler writeAgentFile:agent]);
+    NSString *path = [_scheduler agentPathForName:@"Review"];
+    NSData *data = [NSData dataWithContentsOfFile:path];
+    NSDictionary *stored = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    XCTAssertEqualObjects(stored[@"name"], @"Review");
+    XCTAssertNil(stored[@"next_run"]);
+    XCTAssertNil(stored[@"last_run"]);
+    XCTAssertNil(stored[@"timezone"]);
+    NSDictionary *attributes = [[NSFileManager defaultManager]
+        attributesOfItemAtPath:path
+                         error:nil];
+    NSNumber *permissions = attributes[NSFilePosixPermissions];
+    XCTAssertEqual(permissions.unsignedShortValue & 0777, 0600);
+}
+
+- (void)testSecondarySchedulerCannotReplaceOwnersSocket {
+    NSString *socketPath = [@"/private/tmp"
+        stringByAppendingPathComponent:[NSString stringWithFormat:@"omni-scheduler-%@.sock",
+                                                                   NSUUID.UUID.UUIDString]];
+    [_scheduler setValue:socketPath forKey:@"socketPath"];
+    [_scheduler start];
+    NSDictionary *originalAttributes = [[NSFileManager defaultManager]
+        attributesOfItemAtPath:socketPath
+                         error:nil];
+    XCTAssertNotNil(originalAttributes);
+    XCTAssertGreaterThan([[_scheduler valueForKey:@"listener"] intValue], -1);
+
+    OmniScheduler *secondary = [[OmniScheduler alloc]
+        initWithLaunchHandler:^(NSString *command, NSString *title) {}];
+    [secondary setValue:_temporaryPath forKey:@"supportPath"];
+    [secondary setValue:socketPath forKey:@"socketPath"];
+    [secondary setValue:_temporaryPath forKey:@"configPath"];
+    [secondary setValue:[_temporaryPath stringByAppendingPathComponent:@"agents"]
+                 forKey:@"agentsPath"];
+    [secondary setValue:[_temporaryPath stringByAppendingPathComponent:@"settings.json"]
+                 forKey:@"settingsPath"];
+    [secondary start];
+
+    XCTAssertEqual([[secondary valueForKey:@"listener"] intValue], -1);
+    [secondary stop];
+    NSDictionary *remainingAttributes = [[NSFileManager defaultManager]
+        attributesOfItemAtPath:socketPath
+                         error:nil];
+    XCTAssertEqualObjects(remainingAttributes[NSFileSystemFileNumber],
+                          originalAttributes[NSFileSystemFileNumber]);
+}
+
+- (void)testReplacingRunToleratesNullProcessIdentifiers {
+    NSDictionary *agent = @{
+        @"name": @"Review",
+        @"provider": @"claude",
+        @"workspace": _temporaryPath,
+        @"overlap": @"replace",
+        @"enabled": @NO,
+        @"timeout_seconds": @7200,
+        @"schedule": @{ @"kind": @"daily", @"phrase": @"daily at 09:00",
+                         @"hour": @9, @"minute": @0 },
+    };
+    XCTAssertTrue([_scheduler writeAgentFile:agent]);
+    [_scheduler start];
+    XCTAssertTrue([_scheduler runSQL:
+        @"INSERT INTO runs(id,agent,state,reason,started,pid,pgid) "
+         @"VALUES('old','Review','starting','test',1,NULL,NULL)"
+                              bindings:@[]]);
+
+    NSDictionary *result = nil;
+    XCTAssertNoThrow(result = [_scheduler startAgentNamed:@"Review"
+                                                   reason:@"manual"
+                                          resumeSessionID:nil]);
+    XCTAssertEqualObjects(result[@"ok"], @YES);
+}
+
+- (void)startSchedulerWithAgentTimeout:(NSNumber *)timeout {
+    NSDictionary *agent = @{
+        @"name": @"Review",
+        @"provider": @"claude",
+        @"workspace": _temporaryPath,
+        @"overlap": @"parallel",
+        @"enabled": @NO,
+        @"timeout_seconds": timeout,
+        @"schedule": @{ @"kind": @"daily", @"phrase": @"daily at 09:00",
+                         @"hour": @9, @"minute": @0 },
+    };
+    XCTAssertTrue([_scheduler writeAgentFile:agent]);
+    [_scheduler start];
+}
+
+- (void)insertRun:(NSString *)runID
+            state:(NSString *)state
+          started:(NSTimeInterval)started
+              pid:(id)pid {
+    NSArray *bindings = @[ runID, state, @(started), pid ];
+    const BOOL inserted = [_scheduler runSQL:@"INSERT INTO runs(id,agent,state,reason,started,pid,pgid) "
+                                              @"VALUES(?,'Review',?,'test',?,?,NULL)"
+                                    bindings:bindings];
+    XCTAssertTrue(inserted);
+}
+
+- (NSString *)stateOfRun:(NSString *)runID {
+    return [[_scheduler rowsForSQL:@"SELECT state FROM runs WHERE id=?"
+                          bindings:@[ runID ]].firstObject objectForKey:@"state"];
+}
+
+- (pid_t)exitedProcessIdentifier {
+    NSTask *task = [[NSTask alloc] init];
+    task.launchPath = @"/usr/bin/true";
+    [task launch];
+    [task waitUntilExit];
+    return task.processIdentifier;
+}
+
+- (void)useShortSocketPath {
+    // sockaddr_un paths are too short for the temporary directory.
+    [_scheduler setValue:[@"/private/tmp"
+        stringByAppendingPathComponent:[NSString stringWithFormat:@"omni-%@.sock",
+                                                                  NSUUID.UUID.UUIDString]]
+                  forKey:@"socketPath"];
+}
+
+- (void)testClientsAreServedWhileTheMainThreadIsBlocked {
+    [self useShortSocketPath];
+    [_scheduler start];
+    NSString *socketPath = [_scheduler valueForKey:@"socketPath"];
+    __block ssize_t received = 0;
+    dispatch_semaphore_t finished = dispatch_semaphore_create(0);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        const int client = socket(AF_UNIX, SOCK_STREAM, 0);
+        struct sockaddr_un address = { 0 };
+        address.sun_family = AF_UNIX;
+        strlcpy(address.sun_path, socketPath.fileSystemRepresentation, sizeof(address.sun_path));
+        if (connect(client, (struct sockaddr *)&address, sizeof(address)) == 0) {
+            const char request[] = "{\"op\":\"ping\"}\n";
+            write(client, request, strlen(request));
+            char buffer[256];
+            received = read(client, buffer, sizeof(buffer));
+        }
+        close(client);
+        dispatch_semaphore_signal(finished);
+    });
+    // This test thread is the main thread, so nothing can run on it until the wait ends.
+    const long timedOut = dispatch_semaphore_wait(finished,
+                                                  dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC));
+    XCTAssertEqual(timedOut, 0);
+    XCTAssertGreaterThan(received, 0);
+}
+
+- (void)testAgentFileWithInvalidScheduleCannotBreakStartup {
+    NSString *path = [_scheduler agentPathForName:@"Broken"];
+    XCTAssertTrue([@"{\"name\":\"Broken\",\"schedule\":\"daily\"}" writeToFile:path
+                                                                     atomically:YES
+                                                                       encoding:NSUTF8StringEncoding
+                                                                          error:nil]);
+    [self useShortSocketPath];
+    XCTAssertNoThrow([_scheduler start]);
+    XCTAssertNoThrow([_scheduler checkNow]);
+    NSDictionary *response = [_scheduler responseForRequest:@{ @"op": @"list_agents" }];
+    XCTAssertEqualObjects(response[@"ok"], @YES);
+    XCTAssertEqual([response[@"agents"] count], 0);
+}
+
+- (void)testListRunsTreatsNullAgentFilterAsAllRuns {
+    [self startSchedulerWithAgentTimeout:@7200];
+    [self insertRun:@"run" state:@"completed" started:1 pid:NSNull.null];
+
+    NSDictionary *response = [_scheduler responseForRequest:@{ @"op": @"list_runs",
+                                                               @"name": NSNull.null }];
+
+    XCTAssertEqualObjects(response[@"ok"], @YES);
+    XCTAssertEqual([response[@"runs"] count], 1);
+}
+
+- (void)testMalformedRequestsFailWithoutThrowing {
+    [self startSchedulerWithAgentTimeout:@7200];
+    NSArray *requests = @[ @[ @"not", @"an", @"object" ],
+                           @"text",
+                           NSNull.null,
+                           @{ @"op": @[] },
+                           @{ @"op": @"create_agent", @"agent": @"not an object" },
+                           @{ @"op": @"set_enabled" },
+                           @{ @"op": @"runner_session" } ];
+    for (id request in requests) {
+        NSDictionary *response = nil;
+        XCTAssertNoThrow(response = [_scheduler responseForRequest:request], @"%@", request);
+        XCTAssertEqualObjects(response[@"ok"], @NO, @"%@", request);
+    }
+}
+
+- (void)testRunWhoseRunnerNeverStartedFailsAfterGracePeriod {
+    [self startSchedulerWithAgentTimeout:@7200];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    [self insertRun:@"stuck" state:@"starting" started:now - 3600 pid:NSNull.null];
+    [self insertRun:@"launching" state:@"starting" started:now pid:NSNull.null];
+
+    [_scheduler reapAbandonedRuns];
+
+    XCTAssertEqualObjects([self stateOfRun:@"stuck"], @"failed");
+    XCTAssertEqualObjects([self stateOfRun:@"launching"], @"starting");
+}
+
+- (void)testRunWhoseRunnerDiedFailsButLiveRunnerIsKept {
+    [self startSchedulerWithAgentTimeout:@7200];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    [self insertRun:@"dead" state:@"running" started:now pid:@([self exitedProcessIdentifier])];
+    [self insertRun:@"alive" state:@"running" started:now pid:@(getpid())];
+
+    [_scheduler reapAbandonedRuns];
+
+    XCTAssertEqualObjects([self stateOfRun:@"dead"], @"failed");
+    XCTAssertEqualObjects([self stateOfRun:@"alive"], @"running");
+}
+
+- (void)testRetentionNeverSignalsOrRewritesFinishedRuns {
+    [self startSchedulerWithAgentTimeout:@1];
+    // Stale runner PIDs may have been reused. If retention signalled this one,
+    // SIGUSR1 would terminate the test process itself.
+    for (NSInteger index = 0; index < 12; index++) {
+        [self insertRun:[NSString stringWithFormat:@"finished-%ld", (long)index]
+                  state:@"completed"
+                started:index + 1
+                    pid:@(getpid())];
+    }
+
+    [_scheduler enforceRunRetention];
+
+    XCTAssertEqualObjects([self stateOfRun:@"finished-0"], @"completed");
+}
+
+- (void)testOnceAndIntervalRecurrence {
+    const NSTimeInterval after = 1000;
+    XCTAssertEqualObjects([_scheduler nextRunForAgent:@{ @"schedule": @{ @"kind": @"once" } }
+                                                after:after],
+                          NSNull.null);
+    NSNumber *next = [_scheduler nextRunForAgent:@{
+        @"schedule": @{ @"kind": @"interval", @"interval_seconds": @90 }
+    } after:after];
+    XCTAssertEqualObjects(next, @1090);
+}
+
+- (void)testDailyRecurrenceKeepsWallClockTimeAcrossSpringDST {
+    const NSTimeInterval after = [self timestampForYear:2026 month:3 day:28 hour:9 minute:0];
+    NSNumber *next = [_scheduler nextRunForAgent:@{
+        @"schedule": @{ @"kind": @"daily", @"hour": @9, @"minute": @0 }
+    } after:after];
+    NSDateComponents *components = [self componentsForTimestamp:next.doubleValue];
+    XCTAssertEqual(components.year, 2026);
+    XCTAssertEqual(components.month, 3);
+    XCTAssertEqual(components.day, 29);
+    XCTAssertEqual(components.hour, 9);
+    XCTAssertEqual(components.minute, 0);
+}
+
+- (void)testDailyRecurrenceCanRunLaterTheSameDay {
+    const NSTimeInterval after = [self timestampForYear:2026 month:8 day:2 hour:8 minute:30];
+    NSNumber *next = [_scheduler nextRunForAgent:@{
+        @"schedule": @{ @"kind": @"daily", @"hour": @9, @"minute": @0 }
+    } after:after];
+    NSDateComponents *components = [self componentsForTimestamp:next.doubleValue];
+    XCTAssertEqual(components.year, 2026);
+    XCTAssertEqual(components.month, 8);
+    XCTAssertEqual(components.day, 2);
+    XCTAssertEqual(components.hour, 9);
+    XCTAssertEqual(components.minute, 0);
+}
+
+- (void)testWeekdaysSkipTheWeekend {
+    const NSTimeInterval friday = [self timestampForYear:2026 month:7 day:31 hour:18 minute:0];
+    NSNumber *next = [_scheduler nextRunForAgent:@{
+        @"schedule": @{ @"kind": @"weekdays", @"hour": @9, @"minute": @0 }
+    } after:friday];
+    NSDateComponents *components = [self componentsForTimestamp:next.doubleValue];
+    XCTAssertEqual(components.year, 2026);
+    XCTAssertEqual(components.month, 8);
+    XCTAssertEqual(components.day, 3);
+    XCTAssertEqual(components.weekday, 2);
+    XCTAssertEqual(components.hour, 9);
+}
+
+- (void)testWeeklyRecurrenceUsesPythonWeekdayNumbering {
+    const NSTimeInterval wednesday = [self timestampForYear:2026 month:7 day:29 hour:12 minute:0];
+    NSNumber *next = [_scheduler nextRunForAgent:@{
+        @"schedule": @{ @"kind": @"weekly", @"weekday": @0, @"hour": @10, @"minute": @15 }
+    } after:wednesday];
+    NSDateComponents *components = [self componentsForTimestamp:next.doubleValue];
+    XCTAssertEqual(components.year, 2026);
+    XCTAssertEqual(components.month, 8);
+    XCTAssertEqual(components.day, 3);
+    XCTAssertEqual(components.weekday, 2);
+    XCTAssertEqual(components.hour, 10);
+    XCTAssertEqual(components.minute, 15);
+}
+
+- (void)testCalendarIntervalsKeepWeeklyAlignment {
+    const NSTimeInterval anchor = [self timestampForYear:2026 month:8 day:3 hour:10 minute:0];
+    NSNumber *next = [_scheduler nextRunForAgent:@{
+        @"schedule": @{ @"kind": @"calendar_interval", @"unit": @"week",
+                         @"interval": @2, @"anchor": @(anchor),
+                         @"weekday": @0, @"hour": @10, @"minute": @0 }
+    } after:anchor];
+    NSDateComponents *components = [self componentsForTimestamp:next.doubleValue];
+    XCTAssertEqual(components.year, 2026);
+    XCTAssertEqual(components.month, 8);
+    XCTAssertEqual(components.day, 17);
+    XCTAssertEqual(components.hour, 10);
+}
+
+- (void)testMonthlyIntervalsClampShortMonthsAndRestoreRequestedDay {
+    const NSTimeInterval july = [self timestampForYear:2026 month:7 day:31 hour:9 minute:0];
+    NSDictionary *agent = @{
+        @"schedule": @{ @"kind": @"calendar_interval", @"unit": @"month",
+                         @"interval": @1, @"anchor": @(july),
+                         @"day": @31, @"hour": @9, @"minute": @0 }
+    };
+    NSNumber *august = [_scheduler nextRunForAgent:agent after:july];
+    NSNumber *september = [_scheduler nextRunForAgent:agent after:august.doubleValue];
+    NSDateComponents *augustComponents = [self componentsForTimestamp:august.doubleValue];
+    NSDateComponents *septemberComponents = [self componentsForTimestamp:september.doubleValue];
+    XCTAssertEqual(augustComponents.month, 8);
+    XCTAssertEqual(augustComponents.day, 31);
+    XCTAssertEqual(septemberComponents.month, 9);
+    XCTAssertEqual(septemberComponents.day, 30);
+}
+
+@end
