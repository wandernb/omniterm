+    // A session's forge project as the person named and coloured it.
+    private func sessionProject(_ session: [AnyHashable: Any]) -> (name: String?, color: NSColor?) {
+        guard let project = session["project"] as? [String: Any],
+              let root = project["root"] as? String ?? project["id"] as? String else { return (nil, nil) }
+        let name = projectLayout.name(root) ?? project["name"] as? String
+        return (name, OmniAgentColor.color(projectLayout.appearance(root).color))
+    }
+
+    // Whether the agent folders' look changed.
+    @discardableResult
+    private func readAgentFolderAppearance(_ settings: [AnyHashable: Any]) -> Bool {
+        let folders = settings["agent_folders"] as? [String: Any] ?? [:]
+        let icons = folders["icons"] as? [String: String] ?? [:]
+        let colors = folders["colors"] as? [String: String] ?? [:]
+        guard icons != agentFolderIcons || colors != agentFolderColors else { return false }
+        agentFolderIcons = icons
+        agentFolderColors = colors
+        return true
+    }
+
+    // Saves the agent folders' look; shown at once, put back if refused.
+    private func saveAgentFolderAppearance(icons: [String: String], colors: [String: String]) {
+        let saved = (agentFolderIcons, agentFolderColors)
+        agentFolderIcons = icons.filter { !$0.value.isEmpty }
+        agentFolderColors = colors.filter { !$0.value.isEmpty }
+        rebuild()
+        OmniSchedulerClient.request(["op": "set_settings",
+                                     "settings": ["agent_folders": ["icons": agentFolderIcons, "colors": agentFolderColors]]]) { [weak self] response in
+            guard let self, response["ok"] as? Bool != true else { return }
+            (self.agentFolderIcons, self.agentFolderColors) = saved
+            self.rebuild()
+        }
+    }
+
+    // An agent folder's look follows it to a new path; a dissolved one loses it.
+    private func moveAgentFolderAppearance(from path: String, to newPath: String) {
+        func moved(_ map: [String: String]) -> [String: String] {
+            var result: [String: String] = [:]
+            for (key, value) in map {
+                if key == path || key.hasPrefix(path + "/") {
+                    let parent = OmniGroupTree.parent(of: path)
+                    // Dissolving moves the contents to the parent: the look goes.
+                    guard newPath != parent, !newPath.isEmpty else { continue }
+                    result[newPath + key.dropFirst(path.count)] = value
+                } else {
+                    result[key] = value
+                }
+            }
+            return result
+        }
+        let icons = moved(agentFolderIcons)
+        let colors = moved(agentFolderColors)
+        guard icons != agentFolderIcons || colors != agentFolderColors else { return }
+        saveAgentFolderAppearance(icons: icons, colors: colors)
+    }
