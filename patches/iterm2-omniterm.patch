+enum OmniPaneText {
+    static func label(_ text: String, size: CGFloat = 13, weight: NSFont.Weight = .regular,
+                      color: NSColor = .labelColor) -> NSTextField {
+        let field = NSTextField(wrappingLabelWithString: text)
+        field.font = NSFont.systemFont(ofSize: size, weight: weight)
+        field.textColor = color
+        field.isSelectable = true
+        return field
+    }
+
+    // Untrusted text, shown through the safe Markdown subset or as plain text.
+    static func report(_ text: String, markdown: Bool, size: CGFloat = 13.5, color: NSColor = .labelColor) -> NSTextField {
+        let field = NSTextField(wrappingLabelWithString: "")
+        field.isSelectable = true
+        field.allowsEditingTextAttributes = true
+        if markdown {
+            field.attributedStringValue = OmniReportText.attributed(text, fontSize: size, color: color)
+        } else {
+            field.attributedStringValue = NSAttributedString(string: OmniReportText.sanitized(text), attributes: [
+                .font: NSFont.monospacedSystemFont(ofSize: size - 1.5, weight: .regular),
+                .foregroundColor: color])
+        }
+        return field
+    }
+
+    static func button(_ title: String, target: AnyObject, action: Selector) -> NSButton {
+        let button = NSButton(title: title, target: target, action: action)
+        button.bezelStyle = .rounded
+        return button
+    }
+}
