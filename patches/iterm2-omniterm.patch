+// A batch that does not fit the rest of a tick's allowance waits, whole and
+// unacknowledged, and is the first thing saved by the next tick.
+- (void)testKnowledgeBatchOverTheRemainingAllowanceWaitsForTheNextTick {
+    OmniKnowledgeTestScheduler *scheduler = [self knowledgeScheduler];
+    [scheduler setValue:@YES forKey:@"knowledgeEnabled"];
+    __block NSInteger acknowledged = 0;
+    NSMutableArray *acks = [NSMutableArray array];
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        if ([request[@"op"] isEqual:@"ack_writes"]) {
+            acknowledged = [request[@"revision"] integerValue];
+            [acks addObject:request[@"revision"]];
+            return @{ @"ok": @YES };
+        }
+        if (acknowledged >= 2) return @{ @"ok": @YES };
+        const NSInteger head = acknowledged + 1;
+        return @{ @"ok": @YES,
+                  @"_writes": @[ OmniBacklogWrite([NSString stringWithFormat:@"message:big%ld", (long)head], 700 * 1024) ],
+                  @"_revision": @(head), @"_more_writes": @(head < 2) };
+    };
+    [scheduler tickKnowledge];
+    XCTAssertEqualObjects(acks, (@[ @1 ]));
+    XCTAssertEqualObjects(scheduler.knowledgeMaintenance[@"last_yield"], @"write_budget");
+    XCTAssertNil([self savedKnowledgeRecord:@"message:big2"]);
+    [scheduler tickKnowledge];
+    XCTAssertEqualObjects(acks, (@[ @1, @2 ]));
+    XCTAssertNotNil([self savedKnowledgeRecord:@"message:big2"]);
+    scheduler.workerRequest = nil;
+    [scheduler stop];
+}
