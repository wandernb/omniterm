+    // MARK: - Keyboard
+
+    // Up and Down choose a notification, from the list or the detail. Right,
+    // Return or Tab go from the list to the detail's buttons; Left at the
+    // first button, Escape or Tab come back. Shift-Command-U marks read or
+    // unread, Command-O resumes the run, Command-Delete deletes.
+    private func buildKeyboard() {
+        tableView.contextMenu = { [weak self] row in
+            guard let self, row < self.items.count else { return nil }
+            let item = self.items[row]
+            let menu = NSMenu()
+            menu.addAction(item.unread ? "Mark as Read" : "Mark as Unread", symbol: item.unread ? .envelopeOpen : .envelopeBadge) { [weak self] in
+                self?.setRead(item.unread, for: item)
+            }
+            if item.runID != nil {
+                menu.addAction("Resume Run", symbol: .arrowClockwise) { [weak self] in self?.resumeRun(nil) }
+            }
+            if item.workspace != nil {
+                menu.addAction("Reveal Workspace in Finder", symbol: .folder) { [weak self] in self?.revealWorkspace(nil) }
+            }
+            menu.addItem(.separator())
+            menu.addAction("Copy Text", symbol: .docOnDoc) { OmniContextMenus.copy(item.title + "\n\n" + item.body) }
+            menu.addAction("Mark All as Read", symbol: .checkmarkCircle) { [weak self] in self?.markAllRead(nil) }
+            menu.addItem(.separator())
+            menu.addAction("Delete", symbol: .trash) { [weak self] in self?.deleteItem(nil) }
+            return menu
+        }
+        tableView.keyHandler = { [weak self] event in
+            guard let self else { return false }
+            switch OmniZoneKey(event) {
+            case .right, .activate, .next, .previous:
+                self.focusDetail()
+                return true
+            default:
+                return false
+            }
+        }
+        detailZone.zoneExit = { [weak self] exit in self?.detailDidExit(exit) }
+        detailZone.verticalKey = { [weak self] step in self?.moveSelection(by: step) }
+    }
+
+    private func focusDetail() {
+        guard selectedItem != nil, detailZone.zoneCanEnter else { return }
+        detailZone.zoneEnter()
+    }
+
+    private func focusList() {
+        view.window?.makeFirstResponder(tableView)
+    }
+
+    private func moveSelection(by step: Int) {
+        guard !items.isEmpty else { return }
+        let row = tableView.selectedRow < 0 ? 0 : min(max(0, tableView.selectedRow + step), items.count - 1)
+        tableView.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+        tableView.scrollRowToVisible(row)
+    }
+
+    // Left at the first button or Escape: back to the list. Tab: the host's
+    // next zone in a pane; in the window, the list is the only other zone.
+    private func detailDidExit(_ exit: OmniZoneExit) {
+        if exit != .back, let hostExit = detailFocusZone.zoneExit {
+            hostExit(exit)
+        } else {
+            focusList()
+        }
+    }
+
+    // MARK: - Zones, for a pane hosting the Inbox
+
+    // The list, then the detail's buttons.
+    private(set) lazy var listZone = OmniInboxListZone(inbox: self)
+    private(set) lazy var detailFocusZone = OmniInboxDetailZone(inbox: self)
+
+    var focusZones: [OmniFocusZone] {
+        return [listZone, detailFocusZone]
+    }
+
+    fileprivate var listResponder: NSView {
+        return tableView
+    }
+
+    fileprivate var detailResponder: OmniButtonZone {
+        return detailZone
+    }
+
+    fileprivate var listCanEnter: Bool {
+        return isViewLoaded && view.window != nil && !tableView.isHiddenOrHasHiddenAncestor && !items.isEmpty
+    }
+
+    fileprivate var detailCanEnter: Bool {
+        return selectedItem != nil && detailZone.zoneCanEnter
+    }
+
+    fileprivate func enterList() {
+        if tableView.selectedRow < 0, !items.isEmpty {
+            moveSelection(by: 0)
+        }
+        focusList()
+    }
+
+    fileprivate func enterDetail() {
+        focusDetail()
+    }
+
+    fileprivate func step(by delta: Int) {
+        moveSelection(by: delta)
+    }
+
+    // The Inbox's shortcuts, for the window or pane hosting it; true when handled.
+    func handleShortcut(_ event: NSEvent) -> Bool {
+        guard selectedItem != nil else { return false }
+        let modifiers = event.modifierFlags.intersection([.command, .option, .control, .shift])
+        let key = event.charactersIgnoringModifiers?.lowercased()
+        if modifiers == [.command, .shift], key == "u" {
+            toggleRead(nil)
+        } else if modifiers == .command, key == "o", resumeButton.isEnabled {
+            resumeRun(nil)
+        } else if modifiers == .command, event.keyCode == 51 || event.keyCode == 117 {
+            deleteItem(nil)
+        } else {
+            return false
+        }
+        return true
+    }
