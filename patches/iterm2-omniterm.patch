+        NSDictionary *stored = OmniValidLayout([self settings][@"layout"]);
+        if (stored) {
+            [layout addEntriesFromDictionary:stored];
+        }
+        [layout addEntriesFromDictionary:validated];
+        NSError *error = nil;
+        if (![self updateSettings:@{ @"layout": layout } error:&error]) {
+            return @{ @"ok": @NO, @"code": @"write_failed", @"error": error.localizedDescription ?: @"Could not write settings" };
+        }
+        return @{ @"ok": @YES, @"layout": layout };
+    }
+    if ([operation isEqualToString:@"set_sidebar_groups"]) {
+        NSArray *groups = OmniValidGroupList(request[@"groups"]);
+        if (!groups) {
+            return OmniAppearanceFailure(@"sidebar_groups", @"groups must be a list of group paths");
+        }
+        NSError *error = nil;
+        if (![self updateSettings:@{ @"sidebar_groups": groups } error:&error]) {
+            return @{ @"ok": @NO, @"code": @"write_failed", @"error": error.localizedDescription ?: @"Could not write settings" };
+        }
+        [self notificationsDidChange];
+        return @{ @"ok": @YES, @"groups": groups };
+    }
