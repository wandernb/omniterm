+// Codex's TUI treats a carriage return arriving in the same burst as typed
+// text as a pasted newline, so a single "/compact\r" write never submits.
+// Live Codex 0.167 evidence: tmp/loop-compaction/.
+- (NSString *)compactInputOfRun:(NSString *)runID {
+    NSDictionary *request = @{ @"op": @"runner_input_status", @"run_id": runID, @"action": @"compact" };
+    return [_scheduler responseForRequest:request][@"state"];
+}
+
+// Lifecycle input is written from the main queue, so let it run until the
+// scheduler records an outcome other than queued.
+- (NSString *)settledCompactInputOfRun:(NSString *)runID {
+    NSDate *deadline = [NSDate dateWithTimeIntervalSinceNow:10];
+    while ([[self compactInputOfRun:runID] isEqual:@"queued"] && deadline.timeIntervalSinceNow > 0) {
+        [[NSRunLoop currentRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.05]];
+    }
+    return [self compactInputOfRun:runID];
+}
