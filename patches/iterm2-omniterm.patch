+
+    private func loadDigest(regenerate: Bool) {
+        if memories.isEmpty {
+            loadMemories()
+        }
+        var request: [String: Any] = ["op": "memory_digest", "regenerate": regenerate]
+        if let workspace = selectedWorkspace {
+            request["workspace"] = workspace
+        }
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self else { return }
+            guard OmniPane.isOK(response), let digest = response["digest"] as? [AnyHashable: Any] else {
+                self.digestStatus.stringValue = response["error"] as? String ?? "The digest is unavailable."
+                return
+            }
+            let markdown = digest["markdown"] as? String ?? ""
+            if self.digestText.markdown != markdown {
+                self.digestText.markdown = markdown
+            }
+            var status = "Generated \(OmniMemoryText.time(digest["generated_at"])) · \(OmniMemoryText.number(digest["bytes"]) ?? 0) bytes"
+            if digest["stale"] as? Bool == true {
+                status += " · memories changed since; regenerate to refresh"
+            }
+            self.digestStatus.stringValue = status
+        }
+    }
