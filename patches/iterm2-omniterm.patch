+        for (NSDictionary *row in [self rowsForSQL:@"SELECT * FROM agents" bindings:@[]]) {
+            NSDictionary *agent = [self decodedAgentRow:row];
+            NSString *group = [agent[@"group"] isKindOfClass:[NSString class]] ? agent[@"group"] : @"";
+            [agentRows addObject:@{ @"name": agent[@"name"], @"group": group }];
+        }
