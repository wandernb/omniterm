+        SMAppService *service = SMAppService.mainAppService;
+        const BOOL registered = (service.status == SMAppServiceStatusEnabled ||
+                                 service.status == SMAppServiceStatusRequiresApproval);
+        if (enabled == registered) {
+            return YES;
+        }
+        return enabled ? [service registerAndReturnError:error] : [service unregisterAndReturnError:error];
+    }
+    NSString *directory = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/LaunchAgents"];
+    NSString *path = [directory stringByAppendingPathComponent:@"com.omniterm.app.plist"];
+    if (!enabled) {
+        return [[NSFileManager defaultManager] removeItemAtPath:path error:error] ||
+               ![[NSFileManager defaultManager] fileExistsAtPath:path];
+    }
+    if (![[NSFileManager defaultManager] createDirectoryAtPath:directory
+                                   withIntermediateDirectories:YES
+                                                    attributes:nil
+                                                         error:error]) {
+        return NO;
+    }
+    NSDictionary *plist = @{ @"Label": @"com.omniterm.app",
+                             @"ProgramArguments": @[ NSBundle.mainBundle.executablePath ],
+                             @"RunAtLoad": @YES };
+    return [plist writeToFile:path atomically:YES];
+}
