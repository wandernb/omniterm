+// Seconds since the last keyboard or mouse input (IOHIDSystem HIDIdleTime, in
+// nanoseconds), or -1 when the registry does not say.
+static double OmniHIDIdleSeconds(void) {
+    double seconds = -1;
+    io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("IOHIDSystem"));
+    if (service == IO_OBJECT_NULL) return seconds;
+    CFTypeRef value = IORegistryEntryCreateCFProperty(service, CFSTR("HIDIdleTime"), kCFAllocatorDefault, 0);
+    if (value) {
+        int64_t nanoseconds = -1;
+        if (CFGetTypeID(value) == CFNumberGetTypeID()) {
+            CFNumberGetValue((CFNumberRef)value, kCFNumberSInt64Type, &nanoseconds);
+        } else if (CFGetTypeID(value) == CFDataGetTypeID() &&
+                   CFDataGetLength((CFDataRef)value) >= (CFIndex)sizeof(int64_t)) {
+            CFDataGetBytes((CFDataRef)value, CFRangeMake(0, sizeof(int64_t)), (UInt8 *)&nanoseconds);
+        }
+        if (nanoseconds >= 0) seconds = (double)nanoseconds / 1e9;
+        CFRelease(value);
+    }
+    IOObjectRelease(service);
+    return seconds;
+}
+
+static BOOL OmniOnACPower(void) {
+    CFTypeRef info = IOPSCopyPowerSourcesInfo();
+    if (!info) return NO;
+    CFStringRef source = IOPSGetProvidingPowerSourceType(info);
+    const BOOL onAC = source && CFStringCompare(source, CFSTR(kIOPMACPowerKey), 0) == kCFCompareEqualTo;
+    CFRelease(info);
+    return onAC;
+}
+
+// The embed request: the helper embeds for longer while the Mac is idle on
+// power, and never in Low Power Mode or above a fair thermal state. It is
+// sliced: each call stays short and says how many slices the budget allows.
+NSDictionary *OmniEmbedRequest(double idleSeconds, BOOL onAC, BOOL lowPower, NSInteger thermalState);
+NSDictionary *OmniEmbedRequest(double idleSeconds, BOOL onAC, BOOL lowPower, NSInteger thermalState) {
+    return @{ @"op": @"embed", @"idle_seconds": @(idleSeconds < 0 ? 0 : floor(idleSeconds)), @"on_ac": @(onAC),
+              @"low_power": @(lowPower), @"thermal_state": @(thermalState), @"slice": @YES };
+}
+
+static NSDictionary *OmniCurrentEmbedRequest(void) {
+    NSProcessInfo *process = NSProcessInfo.processInfo;
+    return OmniEmbedRequest(OmniHIDIdleSeconds(), OmniOnACPower(), process.isLowPowerModeEnabled,
+                            (NSInteger)process.thermalState);
+}
+
+// What one five-second indexing tick may do. Interactive use, battery and Low
+// Power Mode get one scan and one megabyte of saved writes; once half a second
+// of work is spent no further maintenance starts (a call or a save already
+// running finishes). Only an idle Mac on power, not just woken, gets a burst.
+// Memory pressure stops scans, embedding and maintenance but keeps saving and
+// delivering, so nothing already produced waits in the worker's memory.
+OmniKnowledgeBudget OmniKnowledgeTickBudget(NSDictionary *embedRequest, NSInteger memoryPressure, BOOL resumed) {
+    if (memoryPressure > 0) {
+        return (OmniKnowledgeBudget){ .tier = "pressure", .scans = 0, .writeBytes = 1024 * 1024, .workSeconds = 0.5,
+                                      .embed = NO, .maintenance = NO };
+    }
+    const double idle = [embedRequest[@"idle_seconds"] doubleValue];
+    const BOOL burst = !resumed && idle >= 120 && [embedRequest[@"on_ac"] isEqual:@YES] &&
+                       ![embedRequest[@"low_power"] isEqual:@YES] && [embedRequest[@"thermal_state"] integerValue] <= 1;
+    if (burst) {
+        return (OmniKnowledgeBudget){ .tier = "idle", .scans = 8, .writeBytes = 8 * 1024 * 1024, .workSeconds = 2.5,
+                                      .embed = YES, .maintenance = YES };
+    }
+    return (OmniKnowledgeBudget){ .tier = "interactive", .scans = 1, .writeBytes = 1024 * 1024, .workSeconds = 0.5,
+                                  .embed = YES, .maintenance = YES };
+}
+
+// The maintenance after each tick's scan, taken in turn from where the last
+// tick stopped, so a backlog of scans can never starve embedding, trimming or
+// vacuum. The scan itself (which also delivers session messages) runs every tick.
+typedef NS_ENUM(NSInteger, OmniKnowledgePhase) {
+    OmniKnowledgePhaseEmbed,
+    OmniKnowledgePhaseMemoryTick,
+    OmniKnowledgePhaseVacuum,
+    OmniKnowledgePhaseCount,
+};
+
+static NSString *OmniKnowledgePhaseName(NSInteger phase) {
+    switch (phase) {
+        case OmniKnowledgePhaseEmbed: return @"embed";
+        case OmniKnowledgePhaseMemoryTick: return @"memory_tick";
+        default: return @"vacuum";
+    }
+}
+
+typedef NS_ENUM(NSInteger, OmniKnowledgeCommit) {
+    OmniKnowledgeCommitFailed,
+    OmniKnowledgeCommitSaved,
+    OmniKnowledgeCommitDeferred, // Over this tick's write allowance: left pending, unacknowledged.
+};
