+// Restyles the whole text after every change of characters. Prompts are
+// short, and a fence opened on one line restyles every line after it.
+final class OmniMarkdownTextStorage: NSTextStorage {
+    private let backing = NSMutableAttributedString()
+    private var styling = false
+    let fontSize: CGFloat
+
+    init(fontSize: CGFloat) {
+        self.fontSize = fontSize
+        super.init()
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    required init?(pasteboardPropertyList propertyList: Any, ofType type: NSPasteboard.PasteboardType) {
+        it_fatalError("init(pasteboardPropertyList:ofType:) is not supported")
+    }
+
+    // Layout asks for the string once per line or glyph run; bridging
+    // `backing.string` copies the whole text each time, which made long
+    // documents lay out in quadratic time. The copy is kept until an edit.
+    private var cachedString: String?
+    // Counts every change of text or attributes, so a measurement of the text
+    // knows whether it is still current.
+    private(set) var editCount = 0
+
+    override var string: String {
+        if let cachedString {
+            return cachedString
+        }
+        let string = backing.string
+        cachedString = string
+        return string
+    }
+
+    override func attributes(at location: Int, effectiveRange range: NSRangePointer?) -> [NSAttributedString.Key: Any] {
+        return backing.attributes(at: location, effectiveRange: range)
+    }
+
+    override func replaceCharacters(in range: NSRange, with str: String) {
+        beginEditing()
+        cachedString = nil
+        editCount += 1
+        backing.replaceCharacters(in: range, with: str)
+        edited(.editedCharacters, range: range, changeInLength: (str as NSString).length - range.length)
+        endEditing()
+    }
+
+    override func setAttributes(_ attrs: [NSAttributedString.Key: Any]?, range: NSRange) {
+        beginEditing()
+        editCount += 1
+        backing.setAttributes(attrs, range: range)
+        edited(.editedAttributes, range: range, changeInLength: 0)
+        endEditing()
+    }
+
+    // Replaces the text with already rendered Markdown, unstyled: the
+    // read-only view's reading mode.
+    func setRendered(_ rendered: NSAttributedString) {
+        styling = true
+        beginEditing()
+        let oldLength = backing.length
+        cachedString = nil
+        editCount += 1
+        backing.setAttributedString(rendered)
+        edited([.editedCharacters, .editedAttributes], range: NSRange(location: 0, length: oldLength),
+               changeInLength: rendered.length - oldLength)
+        endEditing()
+        styling = false
+    }
+
+    override func processEditing() {
+        if !styling, editedMask.contains(.editedCharacters) {
+            styling = true
+            OmniMarkdownStyler.apply(to: backing, fontSize: fontSize)
+            edited(.editedAttributes, range: NSRange(location: 0, length: backing.length), changeInLength: 0)
+            styling = false
+        }
+        super.processEditing()
+    }
+}
