+// While indexing holds the knowledge queue saving a batch, a read is answered
+// by the worker directly instead of waiting its turn.
+- (void)testKnowledgeReadsDoNotWaitForIndexingToFinishSaving {
+    OmniKnowledgeTestScheduler *scheduler = [self knowledgeScheduler];
+    [scheduler setValue:@YES forKey:@"knowledgeEnabled"];
+    [scheduler setValue:@YES forKey:@"knowledgeRestored"];
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        return @{ @"ok": @YES, @"op": request[@"op"] };
+    };
+    dispatch_semaphore_t saving = dispatch_semaphore_create(0);
+    dispatch_queue_t knowledgeQueue = [scheduler valueForKey:@"knowledgeQueue"];
+    dispatch_async(knowledgeQueue, ^{
+        dispatch_semaphore_wait(saving, dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC));
+    });
+    XCTestExpectation *answered = [self expectationWithDescription:@"read answered"];
+    [scheduler performRequest:@{ @"op": @"memory_overview" } completion:^(NSDictionary *response) {
+        XCTAssertEqualObjects(response[@"op"], @"memory_overview");
+        [answered fulfill];
+    }];
+    [self waitForExpectations:@[ answered ] timeout:10];
+    // A change still waits its turn on the knowledge queue.
+    XCTestExpectation *changed = [self expectationWithDescription:@"change answered"];
+    __block BOOL changeAnswered = NO;
+    [scheduler performRequest:@{ @"op": @"upsert_memory" } completion:^(NSDictionary *response) {
+        changeAnswered = YES;
+        [changed fulfill];
+    }];
+    [[NSRunLoop currentRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.2]];
+    XCTAssertFalse(changeAnswered);
+    dispatch_semaphore_signal(saving);
+    [self waitForExpectations:@[ changed ] timeout:10];
+    scheduler.workerRequest = nil;
+    [scheduler stop];
+}
