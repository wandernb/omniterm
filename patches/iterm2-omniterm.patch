+    // A deep link's file: on Knowledge when it lives there, else on Files.
+    func openFile(_ path: String) {
+        tab = path.hasPrefix("knowledge/") ? .knowledge : .files
+        loadTabData()
+        open(file: path)
+    }
+
+    private func open(file path: String) {
+        guard let projectID else { return }
+        OmniSchedulerClient.request(["op": "get_project_file", "project": projectID, "path": path]) { [weak self] response in
+            guard let self else { return }
+            let file = response["file"] as? [String: Any]
+            let text = OmniPane.isOK(response) ? (file?["text"] as? String ?? "") :
+                (response["error"] as? String ?? "This file could not be read.")
+            self.openFile = (path: path, text: text)
+            let lower = path.lowercased()
+            self.fileView.text = lower.hasSuffix(".md") || lower.hasSuffix(".markdown") ? OmniReportText.sanitized(text) :
+                OmniMarkdownRenderer.codeBlock(OmniReportText.sanitized(text), language: (path as NSString).pathExtension)
+            self.rebuild()
+            self.scroll.contentView.scroll(to: .zero)
+            self.scroll.reflectScrolledClipView(self.scroll.contentView)
+        }
+    }
+
+    @objc private func tabClicked(_ sender: NSButton) {
+        guard let chosen = OmniProjectTab(rawValue: sender.tag) else { return }
+        tab = chosen
+        Self.lastTab = chosen
+        openFile = nil
+        setStatus("", error: false)
+        loadTabData()
+        rebuild()
+        scroll.contentView.scroll(to: .zero)
+        scroll.reflectScrolledClipView(scroll.contentView)
+    }
