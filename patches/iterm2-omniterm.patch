+- (void)toggleOmniTermWindows:(id)sender {
+    const BOOL hasVisibleTerminal = [self.terminals anyWithBlock:^BOOL(PseudoTerminal *terminal) {
+        return terminal.window.isVisible;
+    }];
+    if (hasVisibleTerminal) {
+        for (PseudoTerminal *terminal in self.terminals) {
+            [terminal.window orderOut:nil];
+        }
+        return;
+    }
+
+    for (PseudoTerminal *terminal in self.terminals) {
+        [terminal.window makeKeyAndOrderFront:nil];
+    }
+    [NSApp activateIgnoringOtherApps:YES];
+}
+
+- (NSScreen *)omniTermScreenAtMouseLocation {
+    const NSPoint mouseLocation = NSEvent.mouseLocation;
+    for (NSScreen *screen in NSScreen.screens) {
+        if (NSPointInRect(mouseLocation, screen.frame)) {
+            return screen;
+        }
+    }
+    return NSScreen.mainScreen;
+}
+
+- (void)openOmniTerm:(id)sender {
+    PseudoTerminal *terminal = [iTermController sharedInstance].currentTerminal ?: self.terminals.firstObject;
+    if (!terminal) {
+        [[iTermController sharedInstance] newWindow:nil];
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [self openOmniTerm:nil];
+        });
+        return;
+    }
+
+    NSWindow *window = terminal.window;
+    NSScreen *screen = [self omniTermScreenAtMouseLocation];
+    if (_omniTermCenterOnOpen) {
+        NSRect frame = window.frame;
+        const NSRect visibleFrame = screen.visibleFrame;
+        frame.origin.x = NSMidX(visibleFrame) - NSWidth(frame) / 2;
+        frame.origin.y = NSMidY(visibleFrame) - NSHeight(frame) / 2;
+        frame.origin.x = MAX(NSMinX(visibleFrame), MIN(frame.origin.x, NSMaxX(visibleFrame) - NSWidth(frame)));
+        frame.origin.y = MAX(NSMinY(visibleFrame), MIN(frame.origin.y, NSMaxY(visibleFrame) - NSHeight(frame)));
+        [window setFrame:frame display:YES];
+    }
+
+    NSWindowCollectionBehavior behavior = window.collectionBehavior;
+    behavior &= ~NSWindowCollectionBehaviorCanJoinAllSpaces;
+    behavior |= NSWindowCollectionBehaviorMoveToActiveSpace;
+    window.collectionBehavior = behavior;
+    [NSApp unhide:nil];
+    [window makeKeyAndOrderFront:nil];
+    [NSApp activateIgnoringOtherApps:YES];
+}
+
+- (NSArray<iTermHotKey *> *)omniTermGlobalHotKeyPressed:(NSDictionary *)userData
+                                                siblings:(NSArray<iTermHotKey *> *)siblings {
+    PseudoTerminal *terminal = [iTermController sharedInstance].currentTerminal ?: self.terminals.firstObject;
+    if (terminal.window.isVisible) {
+        [terminal.window orderOut:nil];
+    } else {
+        [self openOmniTerm:nil];
+    }
+    return siblings;
+}
