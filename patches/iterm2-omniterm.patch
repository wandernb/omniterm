@@ -0,0 +1,141 @@
+//
+//  OmniAppearancePickerTests.swift
+//  ModernTests
+//
+//  The icon and colour picker: sixteen named colours, the helper's icon
+//  catalog, and search that filters icons and emoji as you type.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniAppearancePickerTests: XCTestCase {
+    private static let repository = URL(fileURLWithPath: #filePath)
+        .deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+
+    private static let entries = [
+        OmniAppearanceIcon(name: "terminal", category: "Development", keywords: ["shell"]),
+        OmniAppearanceIcon(name: "ant", category: "Development", keywords: ["bug", "insect"]),
+        OmniAppearanceIcon(name: "ladybug", category: "Development", keywords: ["debug"]),
+        OmniAppearanceIcon(name: "ladybug.fill", category: "Development", keywords: []),
+        OmniAppearanceIcon(name: "folder", category: "Files", keywords: []),
+        OmniAppearanceIcon(name: "book", category: "Files", keywords: ["docs"]),
+    ]
+
+    private func makePicker(changes: @escaping (String, String) -> Void = { _, _ in }) -> OmniAppearancePicker {
+        OmniAppearanceCatalog.setForTesting(entries: Self.entries, colors: OmniAgentColor.names)
+        let picker = OmniAppearancePicker(icon: nil, color: nil, didChange: changes)
+        picker.view.frame = NSRect(x: 0, y: 0, width: 320, height: 440)
+        picker.view.layoutSubtreeIfNeeded()
+        return picker
+    }
+
+    private func searchField(_ picker: OmniAppearancePicker) -> NSSearchField {
+        return picker.view.subviews.compactMap { $0 as? NSSearchField }.first!
+    }
+
+    private func type(_ text: String, in picker: OmniAppearancePicker) {
+        let search = searchField(picker)
+        search.stringValue = text
+        picker.controlTextDidChange(Notification(name: NSControl.textDidChangeNotification, object: search))
+    }
+
+    // MARK: - Colours
+
+    func testSixteenNamedColoursMatchTheSharedFixture() throws {
+        XCTAssertEqual(OmniAgentColor.names.count, 16)
+        XCTAssertEqual(Set(OmniAgentColor.names).count, 16)
+        for name in OmniAgentColor.names {
+            XCTAssertNotNil(OmniAgentColor.color(name), name)
+        }
+        let data = try Data(contentsOf: Self.repository.appendingPathComponent("tests/fixtures/agent_appearance.json"))
+        let fixture = try XCTUnwrap(try JSONSerialization.jsonObject(with: data) as? [String: Any])
+        let colors = try XCTUnwrap(fixture["color"] as? [String: [String]])
+        XCTAssertEqual(Set(colors["valid"] ?? []).subtracting([""]), Set(OmniAgentColor.names))
+        for name in colors["invalid"] ?? [] {
+            XCTAssertNil(OmniAgentColor.color(name), name)
+        }
+    }
+
+    // MARK: - Catalog
+
+    func testTheHelpersCatalogHasNoDuplicatesAndEveryIconResolves() throws {
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/usr/bin/python3")
+        process.arguments = [Self.repository.appendingPathComponent("helpers/omni").path, "agents", "appearance", "--json"]
+        let output = Pipe()
+        process.standardOutput = output
+        process.standardError = FileHandle.nullDevice
+        try process.run()
+        let data = output.fileHandleForReading.readDataToEndOfFile()
+        process.waitUntilExit()
+        let response = try XCTUnwrap(try JSONSerialization.jsonObject(with: data) as? [AnyHashable: Any])
+        let listed = (response["icons"] as? [[String: Any]] ?? []).compactMap { $0["name"] as? String }
+        XCTAssertGreaterThanOrEqual(listed.count, 300)
+        XCTAssertEqual(Set(listed).count, listed.count, "No icon is listed twice")
+        let icons = OmniAppearanceCatalog.icons(from: response)
+        XCTAssertEqual(icons.map(\.name), listed, "Every listed symbol exists")
+        XCTAssertFalse(icons.contains { $0.category.isEmpty })
+        XCTAssertEqual(response["colors"] as? [String], OmniAgentColor.names)
+    }
+
+    // MARK: - Search
+
+    func testSearchMatchesNamesAndKeywords() {
+        XCTAssertTrue(OmniAppearanceSearch.matches("bug", name: "ant", keywords: ["bug"]))
+        XCTAssertTrue(OmniAppearanceSearch.matches("BUG", name: "ladybug.fill", keywords: []))
+        XCTAssertTrue(OmniAppearanceSearch.matches("lady fill", name: "ladybug.fill", keywords: []))
+        XCTAssertFalse(OmniAppearanceSearch.matches("bug", name: "folder", keywords: ["files"]))
+        XCTAssertTrue(OmniAppearanceSearch.matches("  ", name: "folder", keywords: []))
+        XCTAssertEqual(OmniEmojiCatalog.name("🚀"), "rocket")
+        XCTAssertEqual(OmniEmojiCatalog.name("❤️"), "heavy black heart")
+    }
+
+    func testTypingFiltersIconsAndShowsNoMatches() {
+        let picker = makePicker()
+        XCTAssertEqual(picker.gridIdentifiers.count, Self.entries.count)
+        type("bug", in: picker)
+        XCTAssertEqual(picker.gridIdentifiers, ["ant", "ladybug", "ladybug.fill"])
+        XCTAssertFalse(picker.showsNoMatches)
+        type("zzz", in: picker)
+        XCTAssertEqual(picker.gridIdentifiers, [])
+        XCTAssertTrue(picker.showsNoMatches)
+        type("", in: picker)
+        XCTAssertEqual(picker.gridIdentifiers.count, Self.entries.count)
+    }
+
+    func testTheEmojiTabSearchesByName() {
+        var saved: [String] = []
+        let picker = makePicker { icon, _ in saved.append(icon) }
+        picker.selectTab(emoji: true)
+        XCTAssertGreaterThan(picker.gridIdentifiers.count, 100)
+        type("rocket", in: picker)
+        XCTAssertTrue(picker.gridIdentifiers.contains("emoji:🚀"))
+        XCTAssertFalse(picker.gridIdentifiers.contains("emoji:🐞"))
+        type("lady beetle", in: picker)
+        XCTAssertEqual(picker.gridIdentifiers, ["emoji:🐞"])
+        let field = NSTextView()
+        XCTAssertTrue(picker.control(searchField(picker), textView: field, doCommandBy: #selector(NSResponder.insertNewline(_:))))
+        XCTAssertEqual(saved.last, "emoji:🐞", "Return picks the only match")
+    }
+
+    // MARK: - Keyboard
+
+    func testDownMovesByRowAcrossCategories() {
+        var saved: [String] = []
+        let picker = makePicker { icon, _ in saved.append(icon) }
+        let search = searchField(picker)
+        let field = NSTextView()
+        XCTAssertTrue(picker.control(search, textView: field, doCommandBy: #selector(NSResponder.moveDown(_:))))
+        XCTAssertEqual(picker.cursor, 0)
+        XCTAssertTrue(picker.control(search, textView: field, doCommandBy: #selector(NSResponder.moveDown(_:))))
+        XCTAssertEqual(picker.cursor, 4, "Down goes to the next category's row")
+        XCTAssertTrue(picker.control(search, textView: field, doCommandBy: #selector(NSResponder.moveRight(_:))))
+        XCTAssertTrue(picker.control(search, textView: field, doCommandBy: #selector(NSResponder.insertNewline(_:))))
+        XCTAssertEqual(saved.last, "sf:book")
+        XCTAssertTrue(picker.control(search, textView: field, doCommandBy: #selector(NSResponder.moveUp(_:))))
+        XCTAssertEqual(picker.cursor, 1, "Up goes to the nearest icon in the row above")
+        XCTAssertTrue(picker.control(search, textView: field, doCommandBy: #selector(NSResponder.moveUp(_:))))
+        XCTAssertNil(picker.cursor, "Up from the first row returns to the search field")
+    }
+}
diff --git a/ModernTests/OmniContextMenusTests.swift b/ModernTests/OmniContextMenusTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e4350833a1c709f5c40fd2465a02ff9f6ab786a6
