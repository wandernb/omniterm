+    // The graph search's return: focus the best lexical match.
+    func focusGraph(onQuery query: String) {
+        let query = query.trimmingCharacters(in: .whitespaces)
+        guard !query.isEmpty, !isMindMap else { return }
+        OmniSchedulerClient.request(["op": "search_memories", "query": query, "mode": "lexical", "limit": 1]) { [weak self] response in
+            guard let self else { return }
+            guard OmniPane.isOK(response),
+                  let best = (response["memories"] as? [[AnyHashable: Any]])?.first,
+                  let id = best["id"] as? String else {
+                self.graphStatus.stringValue = "No memory matches “" + OmniReportText.sanitized(query) + "”."
+                return
+            }
+            self.pushGraphFocus(id, label: best["title"] as? String ?? id)
+        }
+    }
