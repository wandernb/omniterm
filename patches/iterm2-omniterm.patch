@@ -0,0 +1,1963 @@
+import AppKit
+import Foundation
+
+// Markdown styled in place, as in Bear or Obsidian's live preview: the
+// syntax stays in the text, dimmed and smaller, and only attributes change,
+// so the string is always exactly the Markdown that was typed.
+enum OmniMarkdownStyle: Equatable {
+    case heading(Int)
+    case bold
+    case italic
+    case strikethrough
+    case code
+    // A fenced block's lines, its fences included.
+    case codeBlock
+    case quote
+    case listItem
+    case link
+    case linkTarget
+    case marker
+}
+
+struct OmniMarkdownSpan: Equatable {
+    let range: NSRange
+    let style: OmniMarkdownStyle
+}
+
+// Text to styled ranges, without a view. Ranges are UTF-16, as NSString and
+// NSTextStorage count.
+enum OmniMarkdownStyler {
+    private static let space = unichar(0x20)
+    private static let tab = unichar(0x09)
+    private static let hash = unichar(0x23)
+    private static let greaterThan = unichar(0x3E)
+    private static let backtick = unichar(0x60)
+    private static let tilde = unichar(0x7E)
+    private static let star = unichar(0x2A)
+    private static let underscore = unichar(0x5F)
+    private static let dash = unichar(0x2D)
+    private static let plus = unichar(0x2B)
+    private static let period = unichar(0x2E)
+    private static let closeParen = unichar(0x29)
+    private static let openParen = unichar(0x28)
+    private static let openBracket = unichar(0x5B)
+    private static let closeBracket = unichar(0x5D)
+    private static let backslash = unichar(0x5C)
+
+    static func spans(_ text: String) -> [OmniMarkdownSpan] {
+        let string = text as NSString
+        var spans: [OmniMarkdownSpan] = []
+        var fence: (character: unichar, count: Int)?
+        string.enumerateSubstrings(in: NSRange(location: 0, length: string.length),
+                                   options: [.byLines, .substringNotRequired]) { _, line, _, _ in
+            let start = line.location
+            let end = NSMaxRange(line)
+            let indent = leadingSpaces(string, from: start, to: end)
+            if let open = fence {
+                spans.append(OmniMarkdownSpan(range: line, style: .codeBlock))
+                if indent <= 3, let close = fenceRun(string, at: start + indent, end: end),
+                   close.character == open.character, close.count >= open.count,
+                   isBlank(string, from: start + indent + close.count, to: end) {
+                    spans.append(OmniMarkdownSpan(range: line, style: .marker))
+                    fence = nil
+                }
+                return
+            }
+            if indent <= 3, let open = fenceRun(string, at: start + indent, end: end) {
+                fence = open
+                spans.append(OmniMarkdownSpan(range: line, style: .codeBlock))
+                spans.append(OmniMarkdownSpan(range: line, style: .marker))
+                return
+            }
+            var contentStart = start
+            if indent <= 3, let heading = headingMarker(string, at: start + indent, end: end) {
+                spans.append(OmniMarkdownSpan(range: line, style: .heading(heading.level)))
+                spans.append(OmniMarkdownSpan(range: NSRange(location: start + indent, length: heading.length), style: .marker))
+                contentStart = start + indent + heading.length
+            } else if indent <= 3, start + indent < end, string.character(at: start + indent) == greaterThan {
+                var markerEnd = start + indent
+                while markerEnd < end, string.character(at: markerEnd) == greaterThan {
+                    markerEnd += 1
+                    if markerEnd < end, string.character(at: markerEnd) == space {
+                        markerEnd += 1
+                    }
+                }
+                spans.append(OmniMarkdownSpan(range: line, style: .quote))
+                spans.append(OmniMarkdownSpan(range: NSRange(location: start + indent, length: markerEnd - start - indent),
+                                              style: .marker))
+                contentStart = markerEnd
+            } else if let item = OmniMarkdownEditing.listItem(string, line: line) {
+                spans.append(OmniMarkdownSpan(range: line, style: .listItem))
+                spans.append(OmniMarkdownSpan(range: item.marker, style: .marker))
+                contentStart = NSMaxRange(item.marker)
+            }
+            inline(string, NSRange(location: contentStart, length: end - contentStart), into: &spans)
+        }
+        return spans
+    }
+
+    private static func leadingSpaces(_ string: NSString, from start: Int, to end: Int) -> Int {
+        var index = start
+        while index < end, string.character(at: index) == space {
+            index += 1
+        }
+        return index - start
+    }
+
+    private static func isBlank(_ string: NSString, from start: Int, to end: Int) -> Bool {
+        var index = start
+        while index < end {
+            let character = string.character(at: index)
+            guard character == space || character == tab else { return false }
+            index += 1
+        }
+        return true
+    }
+
+    private static func run(_ string: NSString, of character: unichar, at start: Int, end: Int) -> Int {
+        var index = start
+        while index < end, string.character(at: index) == character {
+            index += 1
+        }
+        return index - start
+    }
+
+    private static func fenceRun(_ string: NSString, at index: Int, end: Int) -> (character: unichar, count: Int)? {
+        guard index < end else { return nil }
+        let character = string.character(at: index)
+        guard character == backtick || character == tilde else { return nil }
+        let count = run(string, of: character, at: index, end: end)
+        return count >= 3 ? (character, count) : nil
+    }
+
+    // `#` to `######` and the spaces after them. A lone `#` is an empty
+    // heading; `#tag` is not a heading.
+    private static func headingMarker(_ string: NSString, at index: Int, end: Int) -> (level: Int, length: Int)? {
+        let level = run(string, of: hash, at: index, end: end)
+        guard level >= 1, level <= 6 else { return nil }
+        let after = index + level
+        guard after == end || string.character(at: after) == space else { return nil }
+        return (level, level + run(string, of: space, at: after, end: end))
+    }
+
+    private static func isAlphanumeric(_ character: unichar) -> Bool {
+        guard let scalar = Unicode.Scalar(character) else { return false }
+        return CharacterSet.alphanumerics.contains(scalar)
+    }
+
+    private static func isASCIIPunctuation(_ character: unichar) -> Bool {
+        return (0x21...0x2F).contains(character) || (0x3A...0x40).contains(character) ||
+            (0x5B...0x60).contains(character) || (0x7B...0x7E).contains(character)
+    }
+
+    // Code spans, escapes, links, bold and italic within one line.
+    private static func inline(_ string: NSString, _ range: NSRange, into spans: inout [OmniMarkdownSpan]) {
+        let end = NSMaxRange(range)
+        var index = range.location
+        while index < end {
+            let character = string.character(at: index)
+            if character == backslash {
+                if index + 1 < end, isASCIIPunctuation(string.character(at: index + 1)) {
+                    spans.append(OmniMarkdownSpan(range: NSRange(location: index, length: 1), style: .marker))
+                    index += 2
+                } else {
+                    index += 1
+                }
+                continue
+            }
+            if character == backtick {
+                let count = run(string, of: backtick, at: index, end: end)
+                if let close = closingBackticks(string, count: count, from: index + count, end: end) {
+                    spans.append(OmniMarkdownSpan(range: NSRange(location: index, length: count), style: .marker))
+                    if close > index + count {
+                        spans.append(OmniMarkdownSpan(range: NSRange(location: index + count, length: close - index - count),
+                                                      style: .code))
+                    }
+                    spans.append(OmniMarkdownSpan(range: NSRange(location: close, length: count), style: .marker))
+                    index = close + count
+                } else {
+                    index += count
+                }
+                continue
+            }
+            if character == openBracket, let link = link(string, at: index, end: end) {
+                spans.append(OmniMarkdownSpan(range: NSRange(location: index, length: 1), style: .marker))
+                spans.append(OmniMarkdownSpan(range: link.label, style: .link))
+                inline(string, link.label, into: &spans)
+                spans.append(OmniMarkdownSpan(range: NSRange(location: NSMaxRange(link.label), length: 2), style: .marker))
+                spans.append(OmniMarkdownSpan(range: link.target, style: .linkTarget))
+                spans.append(OmniMarkdownSpan(range: NSRange(location: NSMaxRange(link.target), length: 1), style: .marker))
+                index = NSMaxRange(link.target) + 1
+                continue
+            }
+            if character == tilde {
+                let count = run(string, of: tilde, at: index, end: end)
+                if count == 2, index + 2 < end, string.character(at: index + 2) != space,
+                   let close = closingTildes(string, from: index + 3, end: end) {
+                    let inner = NSRange(location: index + 2, length: close - index - 2)
+                    spans.append(OmniMarkdownSpan(range: NSRange(location: index, length: 2), style: .marker))
+                    spans.append(OmniMarkdownSpan(range: inner, style: .strikethrough))
+                    inline(string, inner, into: &spans)
+                    spans.append(OmniMarkdownSpan(range: NSRange(location: close, length: 2), style: .marker))
+                    index = close + 2
+                } else {
+                    index += count
+                }
+                continue
+            }
+            if character == star || character == underscore {
+                let count = run(string, of: character, at: index, end: end)
+                let opens = index + count < end && string.character(at: index + count) != space &&
+                    (character == star || index == range.location || !isAlphanumeric(string.character(at: index - 1)))
+                var matched = false
+                for width in [2, 1] where opens && !matched && count >= width {
+                    guard let close = closingEmphasis(string, character, width: width, from: index + width,
+                                                      end: end) else {
+                        continue
+                    }
+                    let inner = NSRange(location: index + width, length: close - index - width)
+                    spans.append(OmniMarkdownSpan(range: NSRange(location: index, length: width), style: .marker))
+                    spans.append(OmniMarkdownSpan(range: inner, style: width == 2 ? .bold : .italic))
+                    inline(string, inner, into: &spans)
+                    spans.append(OmniMarkdownSpan(range: NSRange(location: close, length: width), style: .marker))
+                    index = close + width
+                    matched = true
+                }
+                if !matched {
+                    index += count
+                }
+                continue
+            }
+            index += 1
+        }
+    }
+
+    // Code spans, escapes, links and emphasis in one line of text, for the
+    // rendered view.
+    static func inlineSpans(_ text: String) -> [OmniMarkdownSpan] {
+        let string = text as NSString
+        var spans: [OmniMarkdownSpan] = []
+        inline(string, NSRange(location: 0, length: string.length), into: &spans)
+        return spans
+    }
+
+    // The start of a closing `~~` run after a non-space.
+    private static func closingTildes(_ string: NSString, from start: Int, end: Int) -> Int? {
+        var index = start
+        while index < end {
+            let length = run(string, of: tilde, at: index, end: end)
+            if length == 2, string.character(at: index - 1) != space {
+                return index
+            }
+            index += max(1, length)
+        }
+        return nil
+    }
+
+    private static func closingBackticks(_ string: NSString, count: Int, from start: Int, end: Int) -> Int? {
+        var index = start
+        while index < end {
+            let length = run(string, of: backtick, at: index, end: end)
+            if length == count {
+                return index
+            }
+            index += max(1, length)
+        }
+        return nil
+    }
+
+    // The start of the closing delimiter. A run closes bold when it is at
+    // least two long and italic when it is odd, so `***x***` is both.
+    private static func closingEmphasis(_ string: NSString, _ character: unichar, width: Int, from start: Int,
+                                        end: Int) -> Int? {
+        var index = start
+        while index < end {
+            let current = string.character(at: index)
+            if current == backtick {
+                let count = run(string, of: backtick, at: index, end: end)
+                index = closingBackticks(string, count: count, from: index + count, end: end).map { $0 + count } ?? index + count
+                continue
+            }
+            guard current == character else {
+                index += 1
+                continue
+            }
+            let length = run(string, of: character, at: index, end: end)
+            let fits = width == 2 ? length >= 2 : length % 2 == 1
+            let after = index + length
+            let closes = index > start && string.character(at: index - 1) != space &&
+                (character == star || after == end || !isAlphanumeric(string.character(at: after)))
+            if fits, closes {
+                return index + length - width
+            }
+            index += length
+        }
+        return nil
+    }
+
+    private static func link(_ string: NSString, at index: Int, end: Int) -> (label: NSRange, target: NSRange)? {
+        var close = index + 1
+        while close < end, string.character(at: close) != closeBracket {
+            close += 1
+        }
+        guard close > index + 1, close + 1 < end, string.character(at: close + 1) == openParen else { return nil }
+        var paren = close + 2
+        while paren < end, string.character(at: paren) != closeParen {
+            paren += 1
+        }
+        guard paren < end else { return nil }
+        return (NSRange(location: index + 1, length: close - index - 1),
+                NSRange(location: close + 2, length: paren - close - 2))
+    }
+
+    // MARK: - Attributes
+
+    static func baseAttributes(fontSize: CGFloat) -> [NSAttributedString.Key: Any] {
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.lineSpacing = 2
+        return [.font: NSFont.systemFont(ofSize: fontSize), .foregroundColor: NSColor.labelColor, .paragraphStyle: paragraph]
+    }
+
+    static func headingFont(level: Int, fontSize: CGFloat) -> NSFont {
+        let scale: [CGFloat] = [1.45, 1.25, 1.1]
+        return NSFont.systemFont(ofSize: round(fontSize * scale[min(level, 3) - 1]), weight: .bold)
+    }
+
+    // Styles all of `text`. Only attributes change.
+    static func apply(to text: NSMutableAttributedString, fontSize: CGFloat) {
+        let all = NSRange(location: 0, length: text.length)
+        text.setAttributes(baseAttributes(fontSize: fontSize), range: all)
+        // Blocks first, then inline styles, then markers, so a marker inside
+        // a bold heading is still dimmed and smaller.
+        func order(_ style: OmniMarkdownStyle) -> Int {
+            switch style {
+            case .heading, .quote, .listItem, .codeBlock: return 0
+            case .bold, .italic, .strikethrough: return 1
+            case .code, .link, .linkTarget: return 2
+            case .marker: return 3
+            }
+        }
+        let sorted = spans(text.string).enumerated().sorted {
+            (order($0.element.style), $0.offset) < (order($1.element.style), $1.offset)
+        }
+        let fonts = NSFontManager.shared
+        for span in sorted.map(\.element) where span.range.length > 0 {
+            switch span.style {
+            case .heading(let level):
+                text.addAttribute(.font, value: headingFont(level: level, fontSize: fontSize), range: span.range)
+            case .bold:
+                changeFonts(text, span.range) { fonts.convert($0, toHaveTrait: .boldFontMask) }
+            case .italic:
+                changeFonts(text, span.range) { fonts.convert($0, toHaveTrait: .italicFontMask) }
+            case .strikethrough:
+                text.addAttribute(.strikethroughStyle, value: NSUnderlineStyle.single.rawValue, range: span.range)
+            case .code, .codeBlock:
+                changeFonts(text, span.range) { NSFont.monospacedSystemFont(ofSize: round($0.pointSize * 0.9), weight: .regular) }
+                text.addAttribute(.backgroundColor, value: NSColor.quaternaryLabelColor, range: span.range)
+            case .quote:
+                text.addAttribute(.foregroundColor, value: NSColor.secondaryLabelColor, range: span.range)
+            case .listItem:
+                break
+            case .link:
+                text.addAttributes([.foregroundColor: NSColor.linkColor,
+                                    .underlineStyle: NSUnderlineStyle.single.rawValue], range: span.range)
+            case .linkTarget, .marker:
+                text.addAttribute(.foregroundColor, value: NSColor.tertiaryLabelColor, range: span.range)
+                changeFonts(text, span.range) { NSFont(descriptor: $0.fontDescriptor, size: round($0.pointSize * 0.85)) ?? $0 }
+            }
+        }
+    }
+
+    static func changeFonts(_ text: NSMutableAttributedString, _ range: NSRange, _ change: (NSFont) -> NSFont) {
+        text.enumerateAttribute(.font, in: range) { value, subrange, _ in
+            guard let font = value as? NSFont else { return }
+            text.addAttribute(.font, value: change(font), range: subrange)
+        }
+    }
+}
+
+// MARK: - Rendered Markdown
+
+// YAML front matter: a leading `---` line, closed by `---` or `...`. Only
+// the shape Obsidian shows as properties is read: `key: value`, inline
+// `[a, b]` lists and indented `- item` lists.
+struct OmniMarkdownFrontMatter: Equatable {
+    struct Entry: Equatable {
+        let key: String
+        let value: String
+    }
+
+    let entries: [Entry]
+    // The text after the closing line.
+    let body: String
+
+    static func parse(_ text: String) -> OmniMarkdownFrontMatter? {
+        let lines = text.components(separatedBy: "\n")
+        guard let first = lines.first, first.trimmingCharacters(in: .whitespaces) == "---" else { return nil }
+        guard let close = lines.indices.dropFirst().first(where: {
+            let line = lines[$0].trimmingCharacters(in: .whitespaces)
+            return line == "---" || line == "..."
+        }) else {
+            return nil
+        }
+        var entries: [(key: String, values: [String])] = []
+        for line in lines[1..<close] {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            if trimmed.isEmpty || trimmed.hasPrefix("#") {
+                continue
+            }
+            let indented = line.hasPrefix(" ") || line.hasPrefix("\t")
+            if (indented || trimmed.hasPrefix("- ")), !entries.isEmpty {
+                let item = trimmed.hasPrefix("- ") ? String(trimmed.dropFirst(2)) : trimmed
+                entries[entries.count - 1].values.append(unquoted(item))
+                continue
+            }
+            guard let colon = trimmed.firstIndex(of: ":") else {
+                entries.append((key: trimmed, values: []))
+                continue
+            }
+            let key = unquoted(String(trimmed[..<colon]))
+            let value = String(trimmed[trimmed.index(after: colon)...]).trimmingCharacters(in: .whitespaces)
+            var values: [String] = []
+            if value.hasPrefix("["), value.hasSuffix("]") {
+                values = value.dropFirst().dropLast().split(separator: ",").map { unquoted(String($0)) }.filter { !$0.isEmpty }
+            } else if !value.isEmpty, !["|", ">", "|-", ">-", "|+", ">+"].contains(value) {
+                values = [unquoted(value)]
+            }
+            entries.append((key: key, values: values))
+        }
+        return OmniMarkdownFrontMatter(entries: entries.map { Entry(key: $0.key, value: $0.values.joined(separator: ", ")) },
+                                       body: lines[(close + 1)...].joined(separator: "\n"))
+    }
+
+    private static func unquoted(_ value: String) -> String {
+        let trimmed = value.trimmingCharacters(in: .whitespaces)
+        for quote in ["\"", "'"] where trimmed.count >= 2 && trimmed.hasPrefix(quote) && trimmed.hasSuffix(quote) {
+            return String(trimmed.dropFirst().dropLast())
+        }
+        return trimmed
+    }
+}
+
+// A text block drawn as a rounded fill and, optionally, a bar down its left
+// edge: fenced code, quotes, callouts and front matter. Paragraphs of one
+// block share one instance, so copying returns it.
+final class OmniMarkdownBlock: NSTextBlock {
+    var fill: NSColor?
+    var bar: NSColor?
+    var cornerRadius: CGFloat = 6
+
+    override func copy(with zone: NSZone? = nil) -> Any {
+        return self
+    }
+
+    override func drawBackground(withFrame frameRect: NSRect, in controlView: NSView?,
+                                 characterRange charRange: NSRange, layoutManager: NSLayoutManager) {
+        var rect = frameRect
+        rect.origin.x += width(for: .margin, edge: .minX)
+        rect.size.width -= width(for: .margin, edge: .minX) + width(for: .margin, edge: .maxX)
+        rect.origin.y += width(for: .margin, edge: .minY)
+        rect.size.height -= width(for: .margin, edge: .minY) + width(for: .margin, edge: .maxY)
+        guard rect.width > 0, rect.height > 0 else { return }
+        if let fill {
+            fill.setFill()
+            NSBezierPath(roundedRect: rect, xRadius: cornerRadius, yRadius: cornerRadius).fill()
+        }
+        if let bar {
+            bar.setFill()
+            NSBezierPath(roundedRect: NSRect(x: rect.minX, y: rect.minY, width: 3, height: rect.height),
+                         xRadius: 1.5, yRadius: 1.5).fill()
+        }
+    }
+}
+
+// Markdown to an attributed string, as GitHub or Obsidian's reading view
+// show it: the syntax is gone, code sits on shaded blocks, tables are text
+// tables. Links are colored only, never clickable, as the text is untrusted.
+enum OmniMarkdownRenderer {
+    static func render(_ markdown: String, fontSize: CGFloat = 13,
+                       properties: [OmniMarkdownFrontMatter.Entry] = []) -> NSAttributedString {
+        let builder = Builder(fontSize: fontSize)
+        if !properties.isEmpty {
+            builder.properties(properties)
+        }
+        // Native lines: walking the characters of bridged ones is slow.
+        let lines = webSimplified(markdown.split(separator: "\n", omittingEmptySubsequences: false).map(String.init))
+        builder.blocks(lines, context: [], color: nil)
+        let out = builder.out
+        if out.length > 0, out.string.hasSuffix("\n") {
+            out.deleteCharacters(in: NSRange(location: out.length - 1, length: 1))
+        }
+        return out
+    }
+
+    // What GitHub shows of images and raw HTML, outside code fences: an
+    // image becomes its alt text (a linked badge, a link with that text),
+    // a tag goes and its text stays; a line of tags only is dropped.
+    private static let linkedImage = webPattern("\\[!\\[([^\\]]*)\\]\\([^)]*\\)\\]\\(([^)]*)\\)")
+    private static let image = webPattern("!\\[([^\\]]*)\\]\\([^)]*\\)")
+    private static let imageTag = webPattern("<img\\b[^>]*?\\balt=\"([^\"]*)\"[^>]*>", caseInsensitive: true)
+    private static let lineBreakTag = webPattern("<br\\s*/?>", caseInsensitive: true)
+    private static let tag = webPattern("</?[A-Za-z][A-Za-z0-9-]*(\\s[^<>]*)?/?>|<!--.*?-->")
+
+    private static func webPattern(_ pattern: String, caseInsensitive: Bool = false) -> NSRegularExpression {
+        do {
+            return try NSRegularExpression(pattern: pattern, options: caseInsensitive ? [.caseInsensitive] : [])
+        } catch {
+            it_fatalError("bad pattern \(pattern): \(error)")
+        }
+    }
+
+    static func webSimplified(_ lines: [String]) -> [String] {
+        var fence: String?
+        var result: [String] = []
+        result.reserveCapacity(lines.count)
+        for line in lines {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            if let open = fence {
+                if trimmed.hasPrefix(open) {
+                    fence = nil
+                }
+                result.append(line)
+                continue
+            }
+            if trimmed.hasPrefix("```") || trimmed.hasPrefix("~~~") {
+                fence = String(trimmed.prefix(3))
+                result.append(line)
+                continue
+            }
+            guard line.contains("<") || line.contains("![") else {
+                result.append(line)
+                continue
+            }
+            var text = line
+            func replace(_ pattern: NSRegularExpression, _ template: String) {
+                text = pattern.stringByReplacingMatches(in: text, range: NSRange(text.startIndex..., in: text), withTemplate: template)
+            }
+            replace(linkedImage, "[$1]($2)")
+            replace(image, "$1")
+            replace(imageTag, "$1")
+            replace(lineBreakTag, "  ")
+            let hadTags = text.contains("<")
+            replace(tag, "")
+            if hadTags, text.trimmingCharacters(in: .whitespaces).isEmpty, !trimmed.isEmpty {
+                continue
+            }
+            result.append(text)
+        }
+        return result
+    }
+
+    // `text` as a fenced block no line of it can close.
+    static func codeBlock(_ text: String, language: String = "") -> String {
+        var longest = 0
+        var current = 0
+        for character in text {
+            current = character == "`" ? current + 1 : 0
+            longest = max(longest, current)
+        }
+        let fence = String(repeating: "`", count: max(3, longest + 1))
+        return fence + language + "\n" + text + "\n" + fence
+    }
+
+    // MARK: Line shapes
+
+    struct ListMarker {
+        let indent: Int
+        let ordered: Bool
+        let number: Int
+        let delimiter: String
+        let content: String
+    }
+
+    static func indentation(_ line: String) -> Int {
+        var width = 0
+        for character in line {
+            if character == " " {
+                width += 1
+            } else if character == "\t" {
+                width += 4
+            } else {
+                break
+            }
+        }
+        return width
+    }
+
+    static func isBlank(_ line: String) -> Bool {
+        return line.trimmingCharacters(in: .whitespaces).isEmpty
+    }
+
+    static func listMarker(_ line: String) -> ListMarker? {
+        guard let lead = line.first(where: { $0 != " " && $0 != "\t" }), lead.isASCII,
+              "-*+".contains(lead) || lead.isNumber else {
+            return nil
+        }
+        let characters = Array(line)
+        var index = 0
+        while index < characters.count, characters[index] == " " || characters[index] == "\t" {
+            index += 1
+        }
+        let start = index
+        guard index < characters.count else { return nil }
+        var ordered = false
+        var number = 0
+        var delimiter = ""
+        if "-*+".contains(characters[index]) {
+            index += 1
+        } else {
+            while index < characters.count, index - start < 9, let digit = characters[index].wholeNumberValue,
+                  characters[index].isASCII {
+                number = number * 10 + digit
+                index += 1
+            }
+            guard index > start, index < characters.count, characters[index] == "." || characters[index] == ")" else {
+                return nil
+            }
+            delimiter = String(characters[index])
+            ordered = true
+            index += 1
+        }
+        guard index == characters.count || characters[index] == " " || characters[index] == "\t" else { return nil }
+        while index < characters.count, characters[index] == " " || characters[index] == "\t" {
+            index += 1
+        }
+        return ListMarker(indent: indentation(line), ordered: ordered, number: number, delimiter: delimiter,
+                          content: String(characters[index...]))
+    }
+
+    static func fence(_ line: String) -> (character: Character, count: Int, info: String, indent: Int)? {
+        let indent = indentation(line)
+        guard indent <= 3 else { return nil }
+        let rest = line.drop { $0 == " " || $0 == "\t" }
+        guard let character = rest.first, character == "`" || character == "~" else { return nil }
+        let count = rest.prefix { $0 == character }.count
+        guard count >= 3 else { return nil }
+        let info = rest.dropFirst(count).trimmingCharacters(in: .whitespaces)
+        if character == "`", info.contains("`") {
+            return nil
+        }
+        return (character, count, info, indent)
+    }
+
+    static func heading(_ line: String) -> (level: Int, text: String)? {
+        guard indentation(line) <= 3 else { return nil }
+        let rest = line.drop { $0 == " " || $0 == "\t" }
+        let level = rest.prefix { $0 == "#" }.count
+        guard level >= 1, level <= 6 else { return nil }
+        let after = rest.dropFirst(level)
+        guard after.isEmpty || after.first == " " || after.first == "\t" else { return nil }
+        var text = after.trimmingCharacters(in: .whitespaces)
+        // An optional closing run of #s after a space.
+        let closing = text.reversed().prefix { $0 == "#" }.count
+        if closing > 0 {
+            let kept = text.dropLast(closing)
+            if kept.isEmpty || kept.hasSuffix(" ") {
+                text = kept.trimmingCharacters(in: .whitespaces)
+            }
+        }
+        return (level, text)
+    }
+
+    static func isRule(_ line: String) -> Bool {
+        guard let lead = line.first(where: { $0 != " " && $0 != "\t" }), "-*_".contains(lead),
+              indentation(line) <= 3 else {
+            return false
+        }
+        let characters = line.filter { $0 != " " && $0 != "\t" }
+        guard let first = characters.first, "-*_".contains(first), characters.count >= 3 else { return false }
+        return characters.allSatisfy { $0 == first }
+    }
+
+    static func isQuote(_ line: String) -> Bool {
+        return indentation(line) <= 3 && line.drop { $0 == " " || $0 == "\t" }.first == ">"
+    }
+
+    private static func unquoted(_ line: String) -> String {
+        var rest = line.drop { $0 == " " || $0 == "\t" }
+        if rest.first == ">" {
+            rest = rest.dropFirst()
+            if rest.first == " " {
+                rest = rest.dropFirst()
+            }
+        }
+        return String(rest)
+    }
+
+    // The cells of a table row, split at unescaped pipes outside code.
+    static func cells(_ line: String) -> [String] {
+        var text = line.trimmingCharacters(in: .whitespaces)
+        if text.hasPrefix("|") {
+            text.removeFirst()
+        }
+        if text.hasSuffix("|"), !text.hasSuffix("\\|") {
+            text.removeLast()
+        }
+        var cells: [String] = []
+        var current = ""
+        var inCode = false
+        var escaped = false
+        for character in text {
+            if escaped {
+                current.append(character == "|" ? "|" : "\\" + String(character))
+                escaped = false
+                continue
+            }
+            if character == "\\" {
+                escaped = true
+                continue
+            }
+            if character == "`" {
+                inCode.toggle()
+            }
+            if character == "|", !inCode {
+                cells.append(current.trimmingCharacters(in: .whitespaces))
+                current = ""
+                continue
+            }
+            current.append(character)
+        }
+        if escaped {
+            current.append("\\")
+        }
+        cells.append(current.trimmingCharacters(in: .whitespaces))
+        return cells
+    }
+
+    // The column alignments a delimiter row like `| :-- | :-: |` sets.
+    static func tableAlignments(_ line: String) -> [NSTextAlignment]? {
+        guard line.contains("-"), line.allSatisfy({ "|:- \t".contains($0) }) else { return nil }
+        let cells = Self.cells(line)
+        guard !cells.isEmpty, cells.allSatisfy({ $0.contains("-") }) else { return nil }
+        guard line.contains("|") || cells.count > 1 else { return nil }
+        return cells.map { cell in
+            switch (cell.hasPrefix(":"), cell.hasSuffix(":")) {
+            case (true, true): return .center
+            case (false, true): return .right
+            default: return .natural
+            }
+        }
+    }
+
+    // Checked on every line, so only the shapes its first character allows.
+    static func startsBlock(_ line: String) -> Bool {
+        guard let lead = line.first(where: { $0 != " " && $0 != "\t" }) else { return false }
+        switch lead {
+        case "`", "~": return fence(line) != nil
+        case "#": return heading(line) != nil
+        case ">": return isQuote(line)
+        case "-", "*", "_", "+": return isRule(line) || listMarker(line) != nil
+        default: return lead.isASCII && lead.isNumber && listMarker(line) != nil
+        }
+    }
+
+    // MARK: Building
+
+    fileprivate final class Builder {
+        let out = NSMutableAttributedString()
+        let fontSize: CGFloat
+        private var listIndents: [Int] = []
+        private var listNumbers: [Int] = []
+        private var listOrdered: [Bool] = []
+
+        init(fontSize: CGFloat) {
+            self.fontSize = fontSize
+        }
+
+        private var bodyFont: NSFont {
+            return NSFont.systemFont(ofSize: fontSize)
+        }
+
+        private var codeFill: NSColor {
+            return NSColor.labelColor.withAlphaComponent(0.06)
+        }
+
+        // A block as wide as its container; one without a width shrinks
+        // to a sliver.
+        private func fullWidth<Block: NSTextBlock>(_ block: Block) -> Block {
+            block.setValue(100, type: .percentageValueType, for: .width)
+            return block
+        }
+
+        private func style(_ blocks: [NSTextBlock], spacing: CGFloat = 8,
+                           _ configure: (NSMutableParagraphStyle) -> Void = { _ in }) -> NSParagraphStyle {
+            let paragraph = NSMutableParagraphStyle()
+            paragraph.lineSpacing = 2
+            paragraph.paragraphSpacing = spacing
+            paragraph.textBlocks = blocks
+            configure(paragraph)
+            return paragraph
+        }
+
+        // One paragraph: `content`, its newline, and `style` over both.
+        private func append(_ content: NSAttributedString, _ style: NSParagraphStyle) {
+            let paragraph = NSMutableAttributedString(attributedString: content)
+            var attributes = content.length > 0 ? content.attributes(at: content.length - 1, effectiveRange: nil) :
+                [.font: bodyFont, .foregroundColor: NSColor.labelColor]
+            // A code span's shading would run to the end of the line.
+            for key in [NSAttributedString.Key.backgroundColor, .strikethroughStyle, .underlineStyle] {
+                attributes.removeValue(forKey: key)
+            }
+            paragraph.append(NSAttributedString(string: "\n", attributes: attributes))
+            paragraph.addAttribute(.paragraphStyle, value: style, range: NSRange(location: 0, length: paragraph.length))
+            out.append(paragraph)
+        }
+
+        private func plain(_ text: String, font: NSFont, color: NSColor = .labelColor) -> NSMutableAttributedString {
+            return NSMutableAttributedString(string: text, attributes: [.font: font, .foregroundColor: color])
+        }
+
+        // Inline Markdown with its markers removed.
+        func inline(_ text: String, font: NSFont? = nil, color: NSColor? = nil) -> NSMutableAttributedString {
+            let result = plain(text, font: font ?? bodyFont, color: color ?? .labelColor)
+            let spans = OmniMarkdownStyler.inlineSpans(text)
+            let fonts = NSFontManager.shared
+            var removed = IndexSet()
+            for span in spans where span.range.length > 0 {
+                switch span.style {
+                case .bold:
+                    OmniMarkdownStyler.changeFonts(result, span.range) { fonts.convert($0, toHaveTrait: .boldFontMask) }
+                case .italic:
+                    OmniMarkdownStyler.changeFonts(result, span.range) { fonts.convert($0, toHaveTrait: .italicFontMask) }
+                case .strikethrough:
+                    result.addAttribute(.strikethroughStyle, value: NSUnderlineStyle.single.rawValue, range: span.range)
+                case .link:
+                    result.addAttributes([.foregroundColor: NSColor.linkColor,
+                                          .underlineStyle: NSUnderlineStyle.single.rawValue], range: span.range)
+                case .linkTarget, .marker:
+                    removed.insert(integersIn: span.range.location..<NSMaxRange(span.range))
+                case .code, .codeBlock, .heading, .quote, .listItem:
+                    break
+                }
+            }
+            // Code last, so emphasis markers inside it stay as typed.
+            for span in spans where span.style == .code && span.range.length > 0 {
+                OmniMarkdownStyler.changeFonts(result, span.range) {
+                    NSFont.monospacedSystemFont(ofSize: round($0.pointSize * 0.9), weight: .regular)
+                }
+                result.addAttribute(.backgroundColor, value: NSColor.quaternaryLabelColor, range: span.range)
+            }
+            for range in removed.rangeView.reversed() {
+                result.deleteCharacters(in: NSRange(location: range.lowerBound, length: range.count))
+            }
+            return result
+        }
+
+        func blocks(_ lines: [String], context: [NSTextBlock], color: NSColor?) {
+            var index = 0
+            while index < lines.count {
+                let line = lines[index]
+                if OmniMarkdownRenderer.isBlank(line) {
+                    index += 1
+                    continue
+                }
+                let marker = OmniMarkdownRenderer.isRule(line) ? nil : OmniMarkdownRenderer.listMarker(line)
+                if marker == nil {
+                    listIndents.removeAll()
+                    listNumbers.removeAll()
+                    listOrdered.removeAll()
+                }
+                if let open = OmniMarkdownRenderer.fence(line) {
+                    var code: [String] = []
+                    var next = index + 1
+                    while next < lines.count {
+                        if let close = OmniMarkdownRenderer.fence(lines[next]), close.character == open.character,
+                           close.count >= open.count, close.info.isEmpty {
+                            break
+                        }
+                        var codeLine = lines[next]
+                        var strip = open.indent
+                        while strip > 0, codeLine.hasPrefix(" ") {
+                            codeLine.removeFirst()
+                            strip -= 1
+                        }
+                        code.append(codeLine)
+                        next += 1
+                    }
+                    codeBlock(code, language: open.info.split(separator: " ").first.map(String.init) ?? "", context: context)
+                    index = next + 1
+                    continue
+                }
+                if let heading = OmniMarkdownRenderer.heading(line) {
+                    self.heading(heading.text, level: heading.level, context: context)
+                    index += 1
+                    continue
+                }
+                if OmniMarkdownRenderer.isRule(line) {
+                    rule(context: context)
+                    index += 1
+                    continue
+                }
+                if OmniMarkdownRenderer.isQuote(line) {
+                    var inner: [String] = []
+                    while index < lines.count, OmniMarkdownRenderer.isQuote(lines[index]) {
+                        inner.append(OmniMarkdownRenderer.unquoted(lines[index]))
+                        index += 1
+                    }
+                    quote(inner, context: context)
+                    continue
+                }
+                if index + 1 < lines.count, line.contains("|"),
+                   let alignments = OmniMarkdownRenderer.tableAlignments(lines[index + 1]) {
+                    var rows = [OmniMarkdownRenderer.cells(line)]
+                    var next = index + 2
+                    while next < lines.count, lines[next].contains("|"), !OmniMarkdownRenderer.isBlank(lines[next]) {
+                        rows.append(OmniMarkdownRenderer.cells(lines[next]))
+                        next += 1
+                    }
+                    table(rows, alignments: alignments, context: context, color: color)
+                    index = next
+                    continue
+                }
+                if let marker {
+                    var text = [marker.content]
+                    var next = index + 1
+                    while next < lines.count, !OmniMarkdownRenderer.isBlank(lines[next]),
+                          !OmniMarkdownRenderer.startsBlock(lines[next]) {
+                        text.append(lines[next].trimmingCharacters(in: .whitespaces))
+                        next += 1
+                    }
+                    var following = next
+                    while following < lines.count, OmniMarkdownRenderer.isBlank(lines[following]) {
+                        following += 1
+                    }
+                    let last = following >= lines.count || OmniMarkdownRenderer.isRule(lines[following]) ||
+                        OmniMarkdownRenderer.listMarker(lines[following]) == nil
+                    listItem(marker, text: joined(text), last: last, context: context, color: color)
+                    index = next
+                    continue
+                }
+                var text = [line]
+                var next = index + 1
+                var setext = 0
+                while next < lines.count {
+                    let candidate = lines[next]
+                    let trimmed = candidate.trimmingCharacters(in: .whitespaces)
+                    if trimmed.isEmpty {
+                        break
+                    }
+                    if OmniMarkdownRenderer.indentation(candidate) <= 3, trimmed.allSatisfy({ $0 == "=" }) {
+                        setext = 1
+                        next += 1
+                        break
+                    }
+                    if OmniMarkdownRenderer.indentation(candidate) <= 3, trimmed.allSatisfy({ $0 == "-" }) {
+                        setext = 2
+                        next += 1
+                        break
+                    }
+                    if OmniMarkdownRenderer.startsBlock(candidate) {
+                        break
+                    }
+                    if candidate.contains("|"), next + 1 < lines.count,
+                       OmniMarkdownRenderer.tableAlignments(lines[next + 1]) != nil {
+                        break
+                    }
+                    text.append(candidate)
+                    next += 1
+                }
+                if setext > 0 {
+                    self.heading(joined(text), level: setext, context: context)
+                } else {
+                    append(inline(joined(text), color: color), style(context))
+                }
+                index = next
+            }
+        }
+
+        // Soft breaks become spaces; two trailing spaces or a backslash
+        // break the line.
+        private func joined(_ lines: [String]) -> String {
+            var result = ""
+            for (offset, line) in lines.enumerated() {
+                var text = offset == 0 ? line.trimmingCharacters(in: .whitespaces) :
+                    String(line.drop { $0 == " " || $0 == "\t" })
+                let last = offset == lines.count - 1
+                if !last, text.hasSuffix("\\") {
+                    text.removeLast()
+                    result += text + "\u{2028}"
+                } else if !last, line.hasSuffix("  ") {
+                    result += text.trimmingCharacters(in: .whitespaces) + "\u{2028}"
+                } else {
+                    while let end = text.last, end == " " || end == "\t" {
+                        text.removeLast()
+                    }
+                    result += text + (last ? "" : " ")
+                }
+            }
+            return result
+        }
+
+        func properties(_ entries: [OmniMarkdownFrontMatter.Entry]) {
+            let block = fullWidth(OmniMarkdownBlock())
+            block.fill = codeFill
+            block.setWidth(12, type: .absoluteValueType, for: .padding)
+            block.setWidth(8, type: .absoluteValueType, for: .padding, edge: .minY)
+            block.setWidth(8, type: .absoluteValueType, for: .padding, edge: .maxY)
+            block.setWidth(12, type: .absoluteValueType, for: .margin, edge: .maxY)
+            let keyFont = NSFont.systemFont(ofSize: round(fontSize * 0.92))
+            let widest = entries.map { ($0.key as NSString).size(withAttributes: [.font: keyFont]).width }.max() ?? 0
+            let column = ceil(min(170, max(80, widest + 16)))
+            for entry in entries {
+                let row = plain(entry.key, font: keyFont, color: .secondaryLabelColor)
+                row.append(plain("\t", font: keyFont))
+                row.append(plain(entry.value.isEmpty ? "—" : entry.value, font: bodyFont,
+                                 color: entry.value.isEmpty ? .tertiaryLabelColor : .labelColor))
+                append(row, style([block], spacing: 3) { paragraph in
+                    paragraph.tabStops = [NSTextTab(textAlignment: .left, location: column, options: [:])]
+                    paragraph.headIndent = column
+                    paragraph.lineBreakMode = .byWordWrapping
+                })
+            }
+        }
+
+        private func heading(_ text: String, level: Int, context: [NSTextBlock]) {
+            let scale: [CGFloat] = [1.75, 1.45, 1.2, 1.05, 1.0, 0.95]
+            let font = NSFont.systemFont(ofSize: round(fontSize * scale[level - 1]), weight: level <= 2 ? .bold : .semibold)
+            let content = inline(text, font: font, color: level >= 6 ? .secondaryLabelColor : .labelColor)
+            var blocks = context
+            if level <= 2 {
+                // GitHub's rule under the two top levels.
+                let underline = fullWidth(NSTextBlock())
+                underline.setWidth(1, type: .absoluteValueType, for: .border, edge: .maxY)
+                underline.setBorderColor(.separatorColor, for: .maxY)
+                underline.setWidth(5, type: .absoluteValueType, for: .padding, edge: .maxY)
+                underline.setWidth(10, type: .absoluteValueType, for: .margin, edge: .maxY)
+                blocks.append(underline)
+            }
+            let first = out.length == 0
+            append(content, style(blocks, spacing: level <= 2 ? 0 : 6) { paragraph in
+                paragraph.paragraphSpacingBefore = first ? 0 : (level <= 2 ? 14 : 10)
+            })
+        }
+
+        private func rule(context: [NSTextBlock]) {
+            let block = fullWidth(NSTextBlock())
+            block.setWidth(1, type: .absoluteValueType, for: .border, edge: .maxY)
+            block.setBorderColor(.separatorColor, for: .maxY)
+            block.setWidth(6, type: .absoluteValueType, for: .margin, edge: .minY)
+            block.setWidth(14, type: .absoluteValueType, for: .margin, edge: .maxY)
+            append(plain("", font: NSFont.systemFont(ofSize: 2)), style(context + [block], spacing: 0) { paragraph in
+                paragraph.lineSpacing = 0
+            })
+        }
+
+        private func codeBlock(_ lines: [String], language: String, context: [NSTextBlock]) {
+            let block = fullWidth(OmniMarkdownBlock())
+            block.fill = codeFill
+            block.setWidth(12, type: .absoluteValueType, for: .padding)
+            block.setWidth(9, type: .absoluteValueType, for: .padding, edge: .minY)
+            block.setWidth(9, type: .absoluteValueType, for: .padding, edge: .maxY)
+            block.setWidth(10, type: .absoluteValueType, for: .margin, edge: .maxY)
+            if !language.isEmpty {
+                append(plain(language, font: NSFont.systemFont(ofSize: round(fontSize * 0.8), weight: .medium),
+                             color: .secondaryLabelColor),
+                       style(context + [block], spacing: 5))
+            }
+            let font = NSFont.monospacedSystemFont(ofSize: round(fontSize * 0.9), weight: .regular)
+            let code = style(context + [block], spacing: 0) { paragraph in
+                paragraph.lineSpacing = 1
+            }
+            for line in lines.isEmpty ? [""] : lines {
+                append(plain(line, font: font), code)
+            }
+        }
+
+        private func quote(_ lines: [String], context: [NSTextBlock]) {
+            let block = fullWidth(OmniMarkdownBlock())
+            block.setWidth(14, type: .absoluteValueType, for: .padding, edge: .minX)
+            block.setWidth(4, type: .absoluteValueType, for: .padding, edge: .maxX)
+            block.setWidth(2, type: .absoluteValueType, for: .padding, edge: .minY)
+            block.setWidth(10, type: .absoluteValueType, for: .margin, edge: .maxY)
+            var body = lines
+            // Obsidian's callout: `> [!type] Title`, foldable with + or -.
+            if let first = body.first, first.hasPrefix("[!"), let close = first.firstIndex(of: "]") {
+                let kind = first[first.index(first.startIndex, offsetBy: 2)..<close].lowercased()
+                var title = first[first.index(after: close)...].trimmingCharacters(in: .whitespaces)
+                if title.hasPrefix("+") || title.hasPrefix("-") {
+                    title = String(title.dropFirst()).trimmingCharacters(in: .whitespaces)
+                }
+                let tint = Self.calloutColor(kind)
+                block.fill = tint.withAlphaComponent(0.1)
+                block.bar = tint
+                block.setWidth(14, type: .absoluteValueType, for: .padding, edge: .maxX)
+                block.setWidth(9, type: .absoluteValueType, for: .padding, edge: .minY)
+                block.setWidth(1, type: .absoluteValueType, for: .padding, edge: .maxY)
+                let heading = title.isEmpty ? kind.prefix(1).uppercased() + kind.dropFirst() : title
+                let titleFont = NSFont.systemFont(ofSize: fontSize, weight: .semibold)
+                let paragraphs = body.dropFirst().contains { !OmniMarkdownRenderer.isBlank($0) }
+                append(inline(heading, font: titleFont, color: tint), style(context + [block], spacing: paragraphs ? 6 : 8))
+                body.removeFirst()
+                blocks(body, context: context + [block], color: nil)
+                return
+            }
+            block.bar = NSColor.secondaryLabelColor.withAlphaComponent(0.35)
+            blocks(body, context: context + [block], color: .secondaryLabelColor)
+        }
+
+        private static func calloutColor(_ kind: String) -> NSColor {
+            switch kind {
+            case "tip", "hint", "important", "success", "check", "done":
+                return .systemGreen
+            case "warning", "caution", "attention":
+                return .systemOrange
+            case "danger", "error", "failure", "fail", "missing", "bug":
+                return .systemRed
+            case "question", "help", "faq":
+                return .systemYellow
+            case "example":
+                return .systemPurple
+            case "quote", "cite":
+                return .systemGray
+            default:
+                return .systemBlue
+            }
+        }
+
+        private func table(_ rows: [[String]], alignments: [NSTextAlignment], context: [NSTextBlock], color: NSColor?) {
+            let columns = rows[0].count
+            let table = NSTextTable()
+            table.numberOfColumns = columns
+            table.collapsesBorders = true
+            table.layoutAlgorithm = .automatic
+            table.setWidth(10, type: .absoluteValueType, for: .margin, edge: .maxY)
+            let headerFill = NSColor.labelColor.withAlphaComponent(0.05)
+            for (rowIndex, row) in rows.enumerated() {
+                for column in 0..<columns {
+                    let cell = NSTextTableBlock(table: table, startingRow: rowIndex, rowSpan: 1,
+                                                startingColumn: column, columnSpan: 1)
+                    cell.setWidth(1, type: .absoluteValueType, for: .border)
+                    cell.setBorderColor(.separatorColor)
+                    cell.setWidth(5, type: .absoluteValueType, for: .padding)
+                    cell.setWidth(10, type: .absoluteValueType, for: .padding, edge: .minX)
+                    cell.setWidth(10, type: .absoluteValueType, for: .padding, edge: .maxX)
+                    if rowIndex == 0 {
+                        cell.backgroundColor = headerFill
+                    }
+                    let text = column < row.count ? row[column] : ""
+                    let content = inline(text, color: color)
+                    if rowIndex == 0 {
+                        OmniMarkdownStyler.changeFonts(content, NSRange(location: 0, length: content.length)) {
+                            NSFontManager.shared.convert($0, toHaveTrait: .boldFontMask)
+                        }
+                    }
+                    let alignment = column < alignments.count ? alignments[column] : .natural
+                    append(content, style(context + [cell], spacing: 0) { paragraph in
+                        paragraph.alignment = alignment
+                    })
+                }
+            }
+        }
+
+        private func listItem(_ marker: ListMarker, text: String, last: Bool, context: [NSTextBlock], color: NSColor?) {
+            while let deepest = listIndents.last, deepest > marker.indent {
+                listIndents.removeLast()
+                listNumbers.removeLast()
+                listOrdered.removeLast()
+            }
+            if let deepest = listIndents.last, deepest == marker.indent {
+                // A list of the other kind starts its count again.
+                let same = listOrdered[listOrdered.count - 1] == marker.ordered
+                listNumbers[listNumbers.count - 1] = same ? listNumbers[listNumbers.count - 1] + 1 : marker.number
+                listOrdered[listOrdered.count - 1] = marker.ordered
+            } else {
+                listIndents.append(marker.indent)
+                listNumbers.append(marker.number)
+                listOrdered.append(marker.ordered)
+            }
+            let level = listIndents.count - 1
+            var content = text
+            var task: Bool?
+            if content.hasPrefix("[ ] ") || content == "[ ]" {
+                task = false
+            } else if content.hasPrefix("[x] ") || content.hasPrefix("[X] ") || content == "[x]" || content == "[X]" {
+                task = true
+            }
+            if task != nil {
+                content = String(content.dropFirst(3)).trimmingCharacters(in: .whitespaces)
+            }
+            let step = round(fontSize * 1.7)
+            let head = CGFloat(level + 1) * step
+            let row: NSMutableAttributedString
+            if let task {
+                row = plain(task ? "☑" : "☐", font: NSFont.systemFont(ofSize: round(fontSize * 1.1)),
+                            color: task ? .controlAccentColor : .secondaryLabelColor)
+            } else if marker.ordered {
+                row = plain("\(listNumbers[level])\(marker.delimiter)", font: bodyFont.withMonospacedDigits(),
+                            color: color ?? .secondaryLabelColor)
+            } else {
+                row = plain(["•", "◦", "▪"][level % 3], font: bodyFont, color: color ?? .secondaryLabelColor)
+            }
+            row.append(plain("\t", font: bodyFont))
+            let body = inline(content, color: task == true ? .secondaryLabelColor : color)
+            if task == true {
+                body.addAttribute(.strikethroughStyle, value: NSUnderlineStyle.single.rawValue,
+                                  range: NSRange(location: 0, length: body.length))
+            }
+            row.append(body)
+            append(row, style(context, spacing: last ? 8 : 3) { paragraph in
+                paragraph.firstLineHeadIndent = CGFloat(level) * step
+                paragraph.headIndent = head
+                paragraph.tabStops = [NSTextTab(textAlignment: .left, location: head, options: [:])]
+            })
+        }
+    }
+}
+
+private extension NSFont {
+    func withMonospacedDigits() -> NSFont {
+        return NSFont.monospacedDigitSystemFont(ofSize: pointSize, weight: .regular)
+    }
+}
