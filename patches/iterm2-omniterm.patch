+// The card's header: state badge, name, facts and actions, or a thin strip
+// with the name when the terminal is expanded.
+private final class OmniCardHeader: NSView {
+    // Its buttons get the pointing hand as they are added.
+    override func didAddSubview(_ subview: NSView) {
+        super.didAddSubview(subview)
+        OmniPointer.install(in: subview)
+    }
+
+    private let badge = OmniBadgeView()
+    private let title = NSTextField(labelWithString: "")
+    private let meta = NSTextField(labelWithString: "")
+    let status = NSTextField(labelWithString: "")
+    let toggle = NSButton()
+    private let separator = NSBox()
+    private var buttons: [NSButton] = []
+    // Sidebar, run list and terminal band, left of the expand toggle.
+    private var panelToggles: [NSButton] = []
+    let zone = OmniButtonZone()
+    var collapsed = false {
+        didSet { updateCollapsed() }
+    }
+
+    override var isFlipped: Bool { true }
+
+    init() {
+        super.init(frame: NSRect(x: 0, y: 0, width: 600, height: OmniCardPane.headerHeight))
+        zone.buttons = { [weak self] in
+            guard let self else { return [] }
+            return self.buttons + self.panelToggles + [self.toggle]
+        }
+        wantsLayer = true
+        separator.boxType = .separator
+        addSubview(separator)
+        addSubview(badge)
+        title.lineBreakMode = .byTruncatingTail
+        addSubview(title)
+        for field in [meta, status] {
+            field.lineBreakMode = .byTruncatingTail
+            field.isSelectable = true
+            addSubview(field)
+        }
+        meta.font = OmniTheme.Font.meta
+        meta.textColor = OmniTheme.secondaryText
+        status.font = OmniTheme.Font.rowDetail
+        status.textColor = OmniTheme.secondaryText
+        status.alignment = .right
+        toggle.bezelStyle = .inline
+        toggle.isBordered = false
+        addSubview(toggle)
+        addSubview(zone)
+        updateCollapsed()
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    func configure(badge text: String, color: NSColor, title: String, meta: String, buttons: [NSButton]) {
+        badge.configure(text: text.uppercased(), color: color)
+        self.title.stringValue = title
+        self.meta.stringValue = OmniReportText.sanitized(meta)
+        for button in self.buttons {
+            button.removeFromSuperview()
+        }
+        self.buttons = buttons
+        for button in buttons {
+            button.isHidden = collapsed
+            addSubview(button, positioned: .below, relativeTo: zone)
+        }
+        resizeSubviews(withOldSize: bounds.size)
+    }
+
+    private static let panelIdentifiers: [(OmniPanel, String)] = [
+        (.sidebar, "omni.toggle.sidebar"), (.runs, "omni.toggle.runs"), (.band, "omni.toggle.band"),
+    ]
+
+    static func panel(of button: NSButton) -> OmniPanel? {
+        return panelIdentifiers.first { $0.1 == button.identifier?.rawValue }?.0
+    }
+
+    func configurePanelToggles(showsRuns: Bool, target: AnyObject, action: Selector) {
+        let symbols: [OmniPanel: SFSymbol] = [.sidebar: .sidebarLeft, .runs: .rectangleLefthalfInsetFilled,
+                                              .band: .rectangleBottomthirdInsetFilled]
+        panelToggles = Self.panelIdentifiers.compactMap { panel, identifier in
+            guard panel != .runs || showsRuns, let symbol = symbols[panel] else { return nil }
+            let button = NSButton()
+            button.bezelStyle = .inline
+            button.isBordered = false
+            button.setButtonType(.pushOnPushOff)
+            button.image = NSImage(systemSymbolName: symbol.rawValue, accessibilityDescription: nil)
+            button.identifier = NSUserInterfaceItemIdentifier(identifier)
+            button.target = target
+            button.action = action
+            addSubview(button, positioned: .below, relativeTo: zone)
+            return button
+        }
+        updatePanelToggles(OmniPanelLayout())
+    }
+
+    // A toggle is on while its panel shows.
+    func updatePanelToggles(_ layout: OmniPanelLayout) {
+        for button in panelToggles {
+            let shown: Bool
+            let name: String
+            let keys: String
+            switch Self.panel(of: button) {
+            case .sidebar?: (shown, name, keys) = (!layout.sidebarCollapsed, "sidebar", "⌃⌘1")
+            case .runs?: (shown, name, keys) = (!layout.runsCollapsed, "run list", "⌃⌘2")
+            case .band?: (shown, name, keys) = (!layout.bandCollapsed, "terminal", "⌃⌘3")
+            default: continue
+            }
+            button.state = shown ? .on : .off
+            button.contentTintColor = shown ? .controlAccentColor : OmniTheme.secondaryText
+            let label = (shown ? "Hide the " : "Show the ") + name
+            button.toolTip = "\(label) (\(keys))"
+            button.setAccessibilityLabel(label)
+        }
+    }
+
+    private func updateCollapsed() {
+        let symbol = collapsed ? SFSymbol.arrowDownRightAndArrowUpLeft : SFSymbol.arrowUpLeftAndArrowDownRight
+        toggle.image = NSImage(systemSymbolName: symbol.rawValue,
+                               accessibilityDescription: collapsed ? "Show details" : "Expand terminal")
+        toggle.toolTip = collapsed ? "Show the details (⌃⌘↩)" : "Fill the panel with the terminal (⌃⌘↩)"
+        title.font = collapsed ? OmniTheme.Font.stripTitle : OmniTheme.Font.subtitle
+        for view in [meta, status] + (buttons + panelToggles).map({ $0 as NSView }) {
+            view.isHidden = collapsed
+        }
+        resizeSubviews(withOldSize: bounds.size)
+        needsDisplay = true
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        let inset: CGFloat = 20
+        let width = bounds.width
+        separator.frame = NSRect(x: 0, y: bounds.height - 1, width: width, height: 1)
+        let rowY: CGFloat = collapsed ? 0 : 8
+        let rowHeight: CGFloat = collapsed ? bounds.height : 28
+        toggle.frame = NSRect(x: width - inset - 22, y: rowY + (rowHeight - 22) / 2, width: 22, height: 22)
+        badge.sizeToFitLabel()
+        badge.frame.origin = NSPoint(x: inset, y: rowY + (rowHeight - badge.frame.height) / 2)
+        var right = toggle.frame.minX - 4
+        if !collapsed {
+            for button in panelToggles.reversed() {
+                right -= 24
+                button.frame = NSRect(x: right, y: rowY + (rowHeight - 22) / 2, width: 22, height: 22)
+            }
+            right -= 6
+            for button in buttons.reversed() {
+                button.sizeToFit()
+                let buttonWidth = button.frame.width + (button.bezelStyle == .rounded ? 8 : 0)
+                right -= buttonWidth
+                button.frame = NSRect(x: right, y: rowY, width: buttonWidth, height: 28)
+                right -= 6
+            }
+        }
+        let titleX = badge.frame.maxX + 10
+        let titleHeight: CGFloat = collapsed ? 17 : 22
+        title.frame = NSRect(x: titleX, y: rowY + (rowHeight - titleHeight) / 2, width: max(0, right - titleX - 8),
+                             height: titleHeight)
+        let textWidth = max(0, toggle.frame.maxX - inset)
+        meta.frame = NSRect(x: inset, y: 40, width: max(0, textWidth - 230), height: 16)
+        status.frame = NSRect(x: meta.frame.maxX + 8, y: 40, width: max(0, toggle.frame.maxX - meta.frame.maxX - 8),
+                              height: 16)
+        zone.frame = bounds
+    }
+
+    override func updateLayer() {
+        layer?.backgroundColor = OmniTheme.barBackground.cgColor
+    }
+
+    override var wantsUpdateLayer: Bool { true }
+}
