+// A bordered, scrollable Markdown editor for a prompt field.
+final class OmniMarkdownEditor: NSScrollView {
+    let textView: OmniMarkdownTextView
+    private var focused = false
+
+    var text: String {
+        get { textView.markdown }
+        set { textView.markdown = newValue }
+    }
+
+    init(fontSize: CGFloat = 13) {
+        textView = OmniMarkdownTextView(fontSize: fontSize)
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: 96))
+        hasVerticalScroller = true
+        autohidesScrollers = true
+        borderType = .noBorder
+        // Markdown sits on the lighter Markdown card, editable or not.
+        drawsBackground = true
+        backgroundColor = OmniTheme.cardFill
+        wantsLayer = true
+        layer?.cornerRadius = OmniMarkdownCard.cornerRadius
+        layer?.masksToBounds = true
+        layer?.borderWidth = 1
+        textView.drawsBackground = false
+        textView.textContainerInset = NSSize(width: 10, height: 10)
+        textView.minSize = .zero
+        textView.maxSize = NSSize(width: CGFloat.greatestFiniteMagnitude, height: CGFloat.greatestFiniteMagnitude)
+        textView.isVerticallyResizable = true
+        textView.isHorizontallyResizable = false
+        textView.autoresizingMask = [.width]
+        textView.textContainer?.widthTracksTextView = true
+        textView.didChangeFocus = { [weak self] focused in
+            self?.focused = focused
+            self?.updateBorder()
+        }
+        documentView = textView
+        updateBorder()
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func viewDidChangeEffectiveAppearance() {
+        super.viewDidChangeEffectiveAppearance()
+        updateBorder()
+    }
+
+    private func updateBorder() {
+        effectiveAppearance.performAsCurrentDrawingAppearance {
+            layer?.borderColor = (focused ? NSColor.controlAccentColor : OmniTheme.cardBorder).cgColor
+        }
+    }
+}
+
+// Markdown shown read-only with the editor's styling: selectable, as tall as
+// its text, and optionally collapsed behind a Show more toggle.
+//
+// Embed it in a frame-laid-out parent: ask `height(forWidth:)`, set the
+// frame, and relayout when `didChangeHeight` fires (text set, or the toggle
+// pressed).
+final class OmniMarkdownView: NSView {
+    static let toggleHeight: CGFloat = 22
+    private static let inset = NSSize(width: 0, height: 2)
+
+    static let propertiesHeight: CGFloat = 30
+
+    let textView: OmniMarkdownTextView
+    private let clip = OmniMarkdownFlippedView()
+    private let toggle = NSButton(title: "Show more", target: nil, action: nil)
+    // The Markdown as given; in reading mode the text view holds its
+    // rendering instead.
+    private var source = ""
+    // The last measured text height, so the several height queries of one
+    // page layout (and every unchanged relayout) measure the text once.
+    private var measured: (width: CGFloat, edits: Int, generation: Int, height: CGFloat)?
+    private var textGeneration = 0
+    // Reading mode: the Markdown rendered as GitHub or Obsidian show it,
+    // syntax hidden, instead of styled in place.
+    var rendersMarkdown = false {
+        didSet {
+            guard rendersMarkdown != oldValue else { return }
+            textGeneration += 1
+            if rendersMarkdown {
+                render()
+            } else {
+                textView.markdown = source
+                propertiesButton.isHidden = true
+            }
+            needsLayout = true
+            didChangeHeight?()
+        }
+    }
+    private var frontMatter: OmniMarkdownFrontMatter?
+    // Front matter shows as a Properties disclosure, closed until pressed.
+    private(set) var propertiesExpanded = false
+    let propertiesButton = NSButton(title: "Properties", target: nil, action: nil)
+    private var headerHeight: CGFloat {
+        return propertiesButton.isHidden ? 0 : Self.propertiesHeight
+    }
+    // Collapse when the text is taller than this; nil always shows it all.
+    var collapsedHeight: CGFloat? {
+        didSet { didChangeHeight?() }
+    }
+    private(set) var isExpanded = false
+    var didChangeHeight: (() -> Void)?
+    // Parsed Markdown sits on a lighter rounded card so it reads as a
+    // document; off where a box already frames it.
+    var drawsCard = true {
+        didSet {
+            if drawsCard != oldValue {
+                needsLayout = true
+                needsDisplay = true
+                didChangeHeight?()
+            }
+        }
+    }
+    static let cardPadding: CGFloat = 16
+    private var padding: CGFloat {
+        return drawsCard ? Self.cardPadding : 0
+    }
+
+    // Shown only when the text is collapsible; it toggles isExpanded.
+    var toggleButton: NSButton {
+        return toggle
+    }
+
+    // The height of `lines` lines of body text, for choosing collapsedHeight.
+    static func height(lines: Int, fontSize: CGFloat = 13) -> CGFloat {
+        let font = NSFont.systemFont(ofSize: fontSize)
+        let spacing = (OmniMarkdownStyler.baseAttributes(fontSize: fontSize)[.paragraphStyle] as? NSParagraphStyle)?.lineSpacing ?? 0
+        return ceil(CGFloat(lines) * (NSLayoutManager().defaultLineHeight(for: font) + spacing)) + 2 * inset.height
+    }
+
+    override var isFlipped: Bool { true }
+
+    var text: String {
+        get { source }
+        set {
+            // A page reload sets the same text again; restyling and laying
+            // out a long README for nothing blocks the main thread.
+            guard newValue != source else { return }
+            source = newValue
+            textGeneration += 1
+            if rendersMarkdown {
+                propertiesExpanded = false
+                render()
+            } else {
+                textView.markdown = newValue
+            }
+            needsLayout = true
+            didChangeHeight?()
+        }
+    }
+
+    private func render() {
+        textGeneration += 1
+        frontMatter = OmniMarkdownFrontMatter.parse(source)
+        let entries = frontMatter?.entries ?? []
+        let rendered = OmniMarkdownRenderer.render(frontMatter?.body ?? source, fontSize: textView.markdownStorage.fontSize,
+                                                   properties: propertiesExpanded ? entries : [])
+        textView.markdownStorage.setRendered(rendered)
+        textView.setSelectedRange(NSRange(location: 0, length: 0))
+        propertiesButton.isHidden = entries.isEmpty
+        let symbol = propertiesExpanded ? SFSymbol.chevronDown : SFSymbol.chevronRight
+        propertiesButton.image = NSImage(systemSymbolName: symbol.rawValue, accessibilityDescription: nil)?
+            .withSymbolConfiguration(NSImage.SymbolConfiguration(pointSize: 10, weight: .semibold))
+        propertiesButton.title = entries.count == 1 ? "Properties · 1" : "Properties · \(entries.count)"
+    }
+
+    func setPropertiesExpanded(_ expanded: Bool) {
+        guard expanded != propertiesExpanded else { return }
+        propertiesExpanded = expanded
+        if rendersMarkdown {
+            render()
+        }
+        needsLayout = true
+        didChangeHeight?()
+    }
+
+    @objc func toggleProperties(_ sender: Any?) {
+        setPropertiesExpanded(!propertiesExpanded)
+    }
+
+    init(text: String = "", fontSize: CGFloat = 13) {
+        textView = OmniMarkdownTextView(fontSize: fontSize)
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: 40))
+        textView.isEditable = false
+        textView.isSelectable = true
+        textView.drawsBackground = false
+        textView.textContainerInset = Self.inset
+        textView.isVerticallyResizable = false
+        textView.isHorizontallyResizable = false
+        textView.textContainer?.widthTracksTextView = false
+        textView.textContainer?.lineFragmentPadding = 0
+        if #available(macOS 14, *) {
+            clip.clipsToBounds = true
+        }
+        clip.addSubview(textView)
+        addSubview(clip)
+        toggle.isBordered = false
+        toggle.font = NSFont.systemFont(ofSize: 12)
+        toggle.contentTintColor = .linkColor
+        toggle.alignment = .left
+        toggle.target = self
+        toggle.action = #selector(toggleExpanded(_:))
+        toggle.isHidden = true
+        addSubview(toggle)
+        propertiesButton.isBordered = false
+        propertiesButton.font = NSFont.systemFont(ofSize: 12, weight: .medium)
+        propertiesButton.contentTintColor = .secondaryLabelColor
+        propertiesButton.imagePosition = .imageLeading
+        propertiesButton.alignment = .left
+        propertiesButton.target = self
+        propertiesButton.action = #selector(toggleProperties(_:))
+        propertiesButton.isHidden = true
+        addSubview(propertiesButton)
+        source = text
+        textView.markdown = text
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    // The text's full height at a width.
+    func contentHeight(forWidth width: CGFloat) -> CGFloat {
+        guard let layoutManager = textView.layoutManager, let container = textView.textContainer else { return 0 }
+        let textWidth = max(1, width - 2 * Self.inset.width)
+        let edits = textView.markdownStorage.editCount
+        if let measured, measured.width == textWidth, measured.edits == edits, measured.generation == textGeneration,
+           container.size.width == textWidth {
+            return measured.height
+        }
+        if container.size.width != textWidth {
+            container.size = NSSize(width: textWidth, height: CGFloat.greatestFiniteMagnitude)
+        }
+        layoutManager.ensureLayout(for: container)
+        let height = ceil(layoutManager.usedRect(for: container).height) + 2 * Self.inset.height
+        measured = (textWidth, edits, textGeneration, height)
+        return height
+    }
+
+    // Whether the text is long enough to collapse at a width.
+    func isCollapsible(width: CGFloat) -> Bool {
+        guard let collapsedHeight else { return false }
+        return contentHeight(forWidth: width) > collapsedHeight + Self.toggleHeight
+    }
+
+    // The height to give the view at a width, its card included.
+    func height(forWidth width: CGFloat) -> CGFloat {
+        return textHeight(forWidth: width - 2 * padding) + 2 * padding + headerHeight
+    }
+
+    private func textHeight(forWidth width: CGFloat) -> CGFloat {
+        guard isCollapsible(width: width) else { return contentHeight(forWidth: width) }
+        let text = isExpanded ? contentHeight(forWidth: width) : visibleCollapsedHeight(width: width)
+        return text + Self.toggleHeight
+    }
+
+    // The collapsed height, cut at the last whole line.
+    private func visibleCollapsedHeight(width: CGFloat) -> CGFloat {
+        let limit = collapsedHeight ?? 0
+        guard let layoutManager = textView.layoutManager, let container = textView.textContainer else { return limit }
+        _ = contentHeight(forWidth: width)
+        let point = NSPoint(x: 0, y: max(0, limit - Self.inset.height))
+        let glyph = layoutManager.glyphIndex(for: point, in: container)
+        let fragment = layoutManager.lineFragmentRect(forGlyphAt: glyph, effectiveRange: nil)
+        let bottom = fragment.maxY + Self.inset.height
+        if bottom <= limit {
+            return bottom
+        }
+        return fragment.minY > 0 ? fragment.minY + Self.inset.height : limit
+    }
+
+    func setExpanded(_ expanded: Bool) {
+        guard expanded != isExpanded else { return }
+        isExpanded = expanded
+        needsLayout = true
+        didChangeHeight?()
+    }
+
+    @objc func toggleExpanded(_ sender: Any?) {
+        setExpanded(!isExpanded)
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        layoutContent()
+    }
+
+    override func layout() {
+        super.layout()
+        layoutContent()
+    }
+
+    private func layoutContent() {
+        let pad = padding
+        let width = max(1, bounds.width - 2 * pad)
+        let full = contentHeight(forWidth: width)
+        let collapsible = isCollapsible(width: width)
+        let visible = collapsible && !isExpanded ? visibleCollapsedHeight(width: width) : full
+        let header = headerHeight
+        propertiesButton.frame = NSRect(x: pad, y: pad, width: min(width, 220), height: max(0, header - 4))
+        clip.frame = NSRect(x: pad, y: pad + header, width: width, height: visible)
+        textView.frame = NSRect(x: 0, y: 0, width: width, height: full)
+        toggle.isHidden = !collapsible
+        toggle.title = isExpanded ? "Show less" : "Show more"
+        toggle.frame = NSRect(x: pad, y: pad + header + visible, width: min(width, 120), height: Self.toggleHeight)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        guard drawsCard else { return }
+        OmniMarkdownCard.draw(in: bounds)
+    }
+}
+
+// The card behind parsed Markdown: a shade lighter than the page, rounded,
+// with a hairline border.
+enum OmniMarkdownCard {
+    static let cornerRadius: CGFloat = 8
+
+    static func draw(in rect: NSRect) {
+        let path = NSBezierPath(roundedRect: rect.insetBy(dx: 0.5, dy: 0.5), xRadius: cornerRadius, yRadius: cornerRadius)
+        OmniTheme.cardFill.setFill()
+        path.fill()
+        path.lineWidth = 1
+        OmniTheme.cardBorder.setStroke()
+        path.stroke()
+    }
+}
+
+// Any view drawn as a Markdown card, holding one subview inset by the
+// card's padding (a report's text field, for one).
+final class OmniMarkdownCardView: NSView {
+    let content: NSView
+    let padding: CGFloat
+
+    override var isFlipped: Bool { true }
+
+    init(_ content: NSView, padding: CGFloat = OmniMarkdownView.cardPadding) {
+        self.content = content
+        self.padding = padding
+        super.init(frame: NSRect(x: 0, y: 0, width: 300, height: 60))
+        addSubview(content)
+    }
+
+    required init?(coder: NSCoder) {
+        it_fatalError("init(coder:) is not supported")
+    }
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+        super.resizeSubviews(withOldSize: oldSize)
+        content.frame = bounds.insetBy(dx: padding, dy: padding)
+    }
+
+    override func draw(_ dirtyRect: NSRect) {
+        OmniMarkdownCard.draw(in: bounds)
+    }
+}
+
+private final class OmniMarkdownFlippedView: NSView {
+    override var isFlipped: Bool { true }
+}
diff --git a/sources/OmniTerm/OmniMemoryGraphView.swift b/sources/OmniTerm/OmniMemoryGraphView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..0061ebd4552b5172570a4f23967b7c7b98246720
--- /dev/null
+++ b/sources/OmniTerm/OmniMemoryGraphView.swift
@@ -0,0 +1,1200 @@
+import AppKit
+import Foundation
+import os.signpost
+
+// The memory graph: nodes are memories (and optional workspace hubs), edges
+// say why two memories belong together. Two layouts share one canvas:
+// a force-directed network and a radial mind map (type → tag → memory).
+
+struct OmniMemoryGraphNode: Equatable {
+    let id: String
+    let kind: String  // "memory", "workspace", "concept", or a mind-map "root" / "type" / "tag" / "topics" / "topic"
+    let label: String
+    let memoryType: String?
+    let weight: Double
+    let expiring: Bool
+    let pinned: Bool
+    // A mind-map branch's number of children, and whether it is shown closed.
+    let childrenCount: Int
+    let collapsed: Bool
+    // The server's concept community, drawn as a region in the overview.
+    let communityID: String?
+    let communityLabel: String?
+
+    init(id: String, kind: String = "memory", label: String, memoryType: String? = nil, weight: Double = 5,
+         expiring: Bool = false, pinned: Bool = false, childrenCount: Int = 0, collapsed: Bool = false,
+         communityID: String? = nil, communityLabel: String? = nil) {
+        self.id = id
+        self.kind = kind
+        self.label = label
+        self.memoryType = memoryType
+        self.weight = weight
+        self.expiring = expiring
+        self.pinned = pinned
+        self.childrenCount = childrenCount
+        self.collapsed = collapsed
+        self.communityID = communityID
+        self.communityLabel = communityLabel
+    }
+
+    init?(_ value: [AnyHashable: Any]) {
+        guard let id = value["id"] as? String else { return nil }
+        let community = value["community"] as? [AnyHashable: Any]
+        self.init(id: id, kind: value["kind"] as? String ?? "memory",
+                  label: value["label"] as? String ?? "",
+                  memoryType: value["memory_type"] as? String,
+                  weight: (value["effective_weight"] as? NSNumber)?.doubleValue ?? 5,
+                  expiring: value["expiry_candidate"] as? Bool ?? false,
+                  pinned: value["pinned"] as? Bool ?? false,
+                  childrenCount: (value["children_count"] as? NSNumber)?.intValue ?? 0,
+                  communityID: community?["id"] as? String,
+                  communityLabel: community?["label"] as? String)
+    }
+
+    func with(childrenCount: Int? = nil, collapsed: Bool? = nil) -> OmniMemoryGraphNode {
+        return OmniMemoryGraphNode(id: id, kind: kind, label: label, memoryType: memoryType, weight: weight,
+                                   expiring: expiring, pinned: pinned, childrenCount: childrenCount ?? self.childrenCount,
+                                   collapsed: collapsed ?? self.collapsed, communityID: communityID,
+                                   communityLabel: communityLabel)
+    }
+}
+
+struct OmniMemoryGraphEdge: Equatable {
+    let source: String
+    let target: String
+    let kind: String
+    let strength: Double
+    let label: String?
+
+    init(source: String, target: String, kind: String, strength: Double = 1, label: String? = nil) {
+        self.source = source
+        self.target = target
+        self.kind = kind
+        self.strength = strength
+        self.label = label
+    }
+
+    init?(_ value: [AnyHashable: Any]) {
+        guard let source = value["source"] as? String, let target = value["target"] as? String else { return nil }
+        self.init(source: source, target: target, kind: value["kind"] as? String ?? "",
+                  strength: (value["strength"] as? NSNumber)?.doubleValue ?? 1, label: value["label"] as? String)
+    }
+}
+
+// A mind-map branch from the scheduler's `mindmap` tree.
+final class OmniMindMapNode {
+    let node: OmniMemoryGraphNode
+    let children: [OmniMindMapNode]
+    let count: Int
+
+    init(node: OmniMemoryGraphNode, children: [OmniMindMapNode] = [], count: Int = 0) {
+        // A branch always knows how many children it has, for its closed badge.
+        self.node = node.childrenCount == 0 && !children.isEmpty ? node.with(childrenCount: children.count) : node
+        self.children = children
+        self.count = count
+    }
+
+    convenience init?(_ value: [AnyHashable: Any]) {
+        guard let node = OmniMemoryGraphNode(value) else { return nil }
+        let children = (value["children"] as? [[AnyHashable: Any]] ?? []).compactMap(OmniMindMapNode.init)
+        self.init(node: node, children: children, count: (value["count"] as? NSNumber)?.intValue ?? children.count)
+    }
+
+    var leafCount: Int {
+        return children.isEmpty ? 1 : children.reduce(0) { $0 + $1.leafCount }
+    }
+
+    // Every node of the tree, depth first.
+    var allNodes: [OmniMemoryGraphNode] {
+        return [node] + children.flatMap(\.allNodes)
+    }
+
+    // The branch ids from this node down to `id` (excluding `id`), or nil.
+    func ancestors(of id: String) -> [String]? {
+        if node.id == id {
+            return []
+        }
+        for child in children {
+            if let path = child.ancestors(of: id) {
+                return [node.id] + path
+            }
+        }
+        return nil
+    }
+}
+
+enum OmniMemoryGraphLayout {
+    static let signpostLog = OSLog(subsystem: "com.googlecode.iterm2.OmniTerm", category: "MemoryGraph")
+
+    // What a refresh must change before the graph is drawn again: node ids,
+    // kinds, labels and weights to the nearest 0.5, and the edge triples.
+    // Decaying weights, update times and payload order do not count.
+    static func signature(nodes: [OmniMemoryGraphNode], edges: [OmniMemoryGraphEdge], extra: String = "") -> String {
+        let nodePart = nodes.map { node in
+            [node.id, node.kind, node.label, String((node.weight * 2).rounded() / 2), node.communityID ?? "",
+             String(node.childrenCount), node.pinned ? "p" : "", node.expiring ? "x" : ""].joined(separator: "\u{1f}")
+        }.sorted()
+        return (nodePart + ["\u{1e}"] + topologyParts(edges) + ["\u{1e}", extra]).joined(separator: "\n")
+    }
+
+    // Node ids plus edge triples: the same topology needs no new layout.
+    static func topology(nodes: [OmniMemoryGraphNode], edges: [OmniMemoryGraphEdge]) -> String {
+        return (nodes.map(\.id).sorted() + ["\u{1e}"] + topologyParts(edges)).joined(separator: "\n")
+    }
+
+    private static func topologyParts(_ edges: [OmniMemoryGraphEdge]) -> [String] {
+        return edges.map { [$0.kind, $0.source, $0.target].joined(separator: "\u{1f}") }.sorted()
+    }
+
+    // FNV-1a: a hash that is the same on every run, unlike `hashValue`.
+    static func stableHash(_ text: String) -> UInt64 {
+        var hash: UInt64 = 0xcbf29ce484222325
+        for byte in text.utf8 {
+            hash ^= UInt64(byte)
+            hash = hash &* 0x100000001b3
+        }
+        return hash
+    }
+
+    // A layout is warm when at least half its nodes already have a place.
+    static func isWarm(_ nodes: [OmniMemoryGraphNode], previous: [String: CGPoint]?) -> Bool {
+        guard let previous, !previous.isEmpty, !nodes.isEmpty else { return false }
+        return nodes.filter { previous[$0.id] != nil }.count * 2 >= nodes.count
+    }
+
+    // A deterministic Fruchterman–Reingold layout centred on the origin.
+    // The same nodes and edges always give the same positions. With
+    // `previous` covering at least half the nodes the layout is warm: known
+    // nodes start (and nearly stay) where they were, a new node starts next
+    // to its linked neighbours, and 25 cool rounds settle the newcomers.
+    static func network(nodes: [OmniMemoryGraphNode], edges: [OmniMemoryGraphEdge],
+                        iterations: Int? = nil, previous: [String: CGPoint]? = nil) -> [String: CGPoint] {
+        let signpostID = OSSignpostID(log: signpostLog)
+        os_signpost(.begin, log: signpostLog, name: "layout", signpostID: signpostID, "%d nodes", nodes.count)
+        defer { os_signpost(.end, log: signpostLog, name: "layout", signpostID: signpostID) }
+        let count = nodes.count
+        guard count > 0 else { return [:] }
+        let warm = isWarm(nodes, previous: previous)
+        if count == 1 { return [nodes[0].id: warm ? (previous?[nodes[0].id] ?? .zero) : .zero] }
+        let index = Dictionary(nodes.enumerated().map { ($1.id, $0) }, uniquingKeysWith: { first, _ in first })
+        let area = Double(max(count, 4)) * 9000
+        let k = (area / Double(count)).squareRoot()
+        var x = [Double](repeating: 0, count: count)
+        var y = [Double](repeating: 0, count: count)
+        let links: [(Int, Int, Double)] = edges.compactMap { edge in
+            guard let a = index[edge.source], let b = index[edge.target], a != b else { return nil }
+            return (a, b, max(0.1, min(1, edge.strength)))
+        }
+        // Seeded start: a golden-angle spiral, ordered as given.
+        for i in 0..<count {
+            let radius = k * 0.6 * Double(i).squareRoot()
+            let angle = Double(i) * 2.399963229728653
+            x[i] = radius * cos(angle)
+            y[i] = radius * sin(angle)
+        }
+        var known = [Bool](repeating: false, count: count)
+        if warm, let previous {
+            for (i, node) in nodes.enumerated() {
+                if let point = previous[node.id] {
+                    x[i] = Double(point.x)
+                    y[i] = Double(point.y)
+                    known[i] = true
+                }
+            }
+            var neighbours = [[Int]](repeating: [], count: count)
+            for (a, b, _) in links {
+                neighbours[a].append(b)
+                neighbours[b].append(a)
+            }
+            for i in 0..<count where !known[i] {
+                let anchors = neighbours[i].filter { known[$0] }
+                if !anchors.isEmpty {
+                    x[i] = anchors.map { x[$0] }.reduce(0, +) / Double(anchors.count)
+                    y[i] = anchors.map { y[$0] }.reduce(0, +) / Double(anchors.count)
+                }
+                let hash = stableHash(nodes[i].id)
+                let angle = Double(hash % 3600) / 3600 * 2 * .pi
+                let length = k * (0.4 + Double((hash >> 16) % 100) / 250)
+                x[i] += length * cos(angle)
+                y[i] += length * sin(angle)
+            }
+        }
+        let rounds = iterations ?? (warm ? 25 : count > 200 ? 90 : count > 80 ? 160 : 260)
+        var temperature = warm ? k * 2 : k * Double(count).squareRoot()
+        let cooling = (temperature - k * 0.05) / Double(rounds + 1)
+        // A known node barely moves on a warm update; only newcomers settle.
+        let knownStep = k * 0.01
+        var dx = [Double](repeating: 0, count: count)
+        var dy = [Double](repeating: 0, count: count)
+        for _ in 0..<rounds {
+            if count > barnesHutThreshold {
+                barnesHutRepulsion(x: x, y: y, k: k, dx: &dx, dy: &dy)
+            } else {
+                exactRepulsion(x: x, y: y, k: k, dx: &dx, dy: &dy)
+            }
+            for (a, b, strength) in links {
+                let ddx = x[a] - x[b]
+                let ddy = y[a] - y[b]
+                let distance = max(0.01, (ddx * ddx + ddy * ddy).squareRoot())
+                let force = distance * distance / k * strength
+                dx[a] -= ddx / distance * force
+                dy[a] -= ddy / distance * force
+                dx[b] += ddx / distance * force
+                dy[b] += ddy / distance * force
+            }
+            for i in 0..<count {
+                // A weak pull to the centre keeps unconnected nodes in view.
+                dx[i] -= x[i] * 0.02 * k / 10
+                dy[i] -= y[i] * 0.02 * k / 10
+                let length = max(0.01, (dx[i] * dx[i] + dy[i] * dy[i]).squareRoot())
+                let step = min(length, known[i] ? min(temperature, knownStep) : temperature)
+                x[i] += dx[i] / length * step
+                y[i] += dy[i] / length * step
+            }
+            temperature = max(k * 0.01, temperature - cooling)
+        }
+        var positions: [String: CGPoint] = [:]
+        for (i, node) in nodes.enumerated() {
+            positions[node.id] = CGPoint(x: x[i], y: y[i])
+        }
+        return positions
+    }
+
+    // Below this many nodes all pairs are cheap enough, and exact.
+    static let barnesHutThreshold = 64
+    static let barnesHutTheta = 0.8
+
+    // The all-pairs repulsion: each pair pushes apart by k²/d.
+    static func exactRepulsion(x: [Double], y: [Double], k: Double, dx: inout [Double], dy: inout [Double]) {
+        let count = x.count
+        for i in 0..<count {
+            dx[i] = 0
+            dy[i] = 0
+        }
+        for i in 0..<count {
+            for j in (i + 1)..<count {
+                var ddx = x[i] - x[j]
+                var ddy = y[i] - y[j]
+                var distance = (ddx * ddx + ddy * ddy).squareRoot()
+                if distance < 0.01 {
+                    ddx = 0.01 * Double((i * 7 + j * 13) % 5 - 2)
+                    ddy = 0.01
+                    distance = 0.02
+                }
+                let force = k * k / distance
+                dx[i] += ddx / distance * force
+                dy[i] += ddy / distance * force
+                dx[j] -= ddx / distance * force
+                dy[j] -= ddy / distance * force
+            }
+        }
+    }
+
+    // Barnes–Hut: a quadtree whose distant cells push as one body at their
+    // centre of mass. Built in node order and walked in a fixed order, so the
+    // result is as deterministic as the all-pairs version.
+    static func barnesHutRepulsion(x: [Double], y: [Double], k: Double, theta: Double = barnesHutTheta,
+                                   dx: inout [Double], dy: inout [Double]) {
+        let tree = OmniQuadTree(x: x, y: y)
+        let kk = k * k
+        var stack: [Int] = []
+        stack.reserveCapacity(64)
+        for i in 0..<x.count {
+            var fx = 0.0, fy = 0.0
+            stack.removeAll(keepingCapacity: true)
+            stack.append(0)
+            while let cell = stack.popLast() {
+                var mass = tree.mass[cell]
+                guard mass > 0 else { continue }
+                let leaf = tree.firstChild[cell] < 0
+                if leaf && tree.body[cell] == i {
+                    // Coincident nodes share a leaf at the depth limit.
+                    mass -= 1
+                    if mass <= 0 { continue }
+                }
+                let cx = tree.sumX[cell] / tree.mass[cell], cy = tree.sumY[cell] / tree.mass[cell]
+                var ddx = x[i] - cx
+                var ddy = y[i] - cy
+                var distance = (ddx * ddx + ddy * ddy).squareRoot()
+                if !leaf && tree.size[cell] >= theta * distance {
+                    let first = tree.firstChild[cell]
+                    stack.append(first + 3)
+                    stack.append(first + 2)
+                    stack.append(first + 1)
+                    stack.append(first)
+                    continue
+                }
+                if distance < 0.01 {
+                    ddx = 0.01 * Double((i * 7 + cell * 13) % 5 - 2)
+                    ddy = 0.01
+                    distance = 0.02
+                }
+                let force = kk * mass / distance
+                fx += ddx / distance * force
+                fy += ddy / distance * force
+            }
+            dx[i] = fx
+            dy[i] = fy
+        }
+    }
+
+    // Radial tree: the root at the centre, each ring one level deeper, every
+    // subtree an angular wedge proportional to its shown leaves. With
+    // `expanded`, only the root and the listed branches show their children;
+    // a closed branch is one leaf with its count badge. nil opens everything.
+    static func mindMap(_ root: OmniMindMapNode, ring: CGFloat = 150,
+                        expanded: Set<String>? = nil) -> (nodes: [OmniMemoryGraphNode],
+                                                          edges: [OmniMemoryGraphEdge],
+                                                          positions: [String: CGPoint]) {
+        var nodes: [OmniMemoryGraphNode] = []
+        var edges: [OmniMemoryGraphEdge] = []
+        var positions: [String: CGPoint] = [:]
+        func isOpen(_ branch: OmniMindMapNode) -> Bool {
+            return branch === root || expanded?.contains(branch.node.id) ?? true
+        }
+        func leaves(_ branch: OmniMindMapNode) -> Int {
+            guard isOpen(branch), !branch.children.isEmpty else { return 1 }
+            return branch.children.reduce(0) { $0 + leaves($1) }
+        }
+        func place(_ branch: OmniMindMapNode, depth: Int, start: CGFloat, end: CGFloat, parent: String?) {
+            let angle = (start + end) / 2
+            let radius = CGFloat(depth) * ring
+            positions[branch.node.id] = depth == 0 ? .zero : CGPoint(x: radius * cos(angle), y: radius * sin(angle))
+            let open = isOpen(branch)
+            nodes.append(open || branch.children.isEmpty ? branch.node : branch.node.with(collapsed: true))
+            if let parent {
+                edges.append(OmniMemoryGraphEdge(source: parent, target: branch.node.id, kind: "tree"))
+            }
+            guard open else { return }
+            let total = CGFloat(max(1, leaves(branch)))
+            var cursor = start
+            for child in branch.children {
+                let span = (end - start) * CGFloat(leaves(child)) / total
+                place(child, depth: depth + 1, start: cursor, end: cursor + span, parent: branch.node.id)
+                cursor += span
+            }
+        }
+        place(root, depth: 0, start: -.pi, end: .pi, parent: nil)
+        return (nodes, edges, positions)
+    }
+
+    // Andrew's monotone chain, counter-clockwise, no repeated first point.
+    static func convexHull(_ points: [CGPoint]) -> [CGPoint] {
+        let sorted = Array(Set(points.map { [$0.x, $0.y] })).map { CGPoint(x: $0[0], y: $0[1]) }
+            .sorted { ($0.x, $0.y) < ($1.x, $1.y) }
+        guard sorted.count > 2 else { return sorted }
+        func cross(_ o: CGPoint, _ a: CGPoint, _ b: CGPoint) -> CGFloat {
+            return (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x)
+        }
+        var lower: [CGPoint] = []
+        for point in sorted {
+            while lower.count >= 2 && cross(lower[lower.count - 2], lower[lower.count - 1], point) <= 0 {
+                lower.removeLast()
+            }
+            lower.append(point)
+        }
+        var upper: [CGPoint] = []
+        for point in sorted.reversed() {
+            while upper.count >= 2 && cross(upper[upper.count - 2], upper[upper.count - 1], point) <= 0 {
+                upper.removeLast()
+            }
+            upper.append(point)
+        }
+        return Array(lower.dropLast() + upper.dropLast())
+    }
+
+    // Communities drawn as regions: at least `minimum` members, and, once a
+    // render has been seen, membership overlapping the previous render's by
+    // at least 70% (Jaccard), so a topic that keeps regrouping is not drawn.
+    // A community new since the previous render is drawn once it is seen in
+    // two renders in a row; with no previous render everything qualifies.
+    static func stableCommunities(_ current: [String: Set<String>], previous: [String: Set<String>]?,
+                                  minimum: Int = 4, overlap: Double = 0.7) -> Set<String> {
+        var shown = Set<String>()
+        for (id, members) in current where members.count >= minimum {
+            guard let previous else {
+                shown.insert(id)
+                continue
+            }
+            guard let before = previous[id] else { continue }
+            let union = members.union(before).count
+            if union > 0 && Double(members.intersection(before).count) / Double(union) >= overlap {
+                shown.insert(id)
+            }
+        }
+        return shown
+    }
+
+    // Greedy label placement: in the order given (most important first), a
+    // label is drawn only when its rectangle overlaps none already placed.
+    static func placeLabels(_ candidates: [(id: String, rect: CGRect)]) -> [String] {
+        let cell: CGFloat = 64
+        var grid: [Int: [CGRect]] = [:]
+        var placed: [String] = []
+        func keys(_ rect: CGRect) -> [Int] {
+            let x0 = Int((rect.minX / cell).rounded(.down)), x1 = Int((rect.maxX / cell).rounded(.down))
+            let y0 = Int((rect.minY / cell).rounded(.down)), y1 = Int((rect.maxY / cell).rounded(.down))
+            var result: [Int] = []
+            for gx in x0...max(x0, x1) {
+                for gy in y0...max(y0, y1) {
+                    result.append(gx &* 73856093 ^ gy &* 19349663)
+                }
+            }
+            return result
+        }
+        for (id, rect) in candidates {
+            let cells = keys(rect)
+            if cells.contains(where: { grid[$0]?.contains(where: { $0.intersects(rect) }) == true }) {
+                continue
+            }
+            for key in cells {
+                grid[key, default: []].append(rect)
+            }
+            placed.append(id)
+        }
+        return placed
+    }
+
+    // A hub's label is its last path segment, at most 24 characters; a
+    // memory's is its title, at most 42.
+    static func shortLabel(_ node: OmniMemoryGraphNode) -> String {
+        let hub = node.kind == "workspace" || node.kind == "concept"
+        var text = node.label
+        if hub, let last = text.split(separator: "/", omittingEmptySubsequences: true).last {
+            text = String(last)
+        }
+        let limit = hub ? 24 : 42
+        return text.count > limit ? String(text.prefix(limit - 1)) + "…" : text
+    }
+
+    // Edge level of detail: zoomed out below 0.6, only strong similarity
+    // links (≥ 0.9), tag links of small tag groups (≤ 8 members), lineage and
+    // the mind map's tree are drawn. Session links and the workspace and
+    // concept hub links are hidden there on purpose: they are the bulk of the
+    // edges, and the hubs stay visible as nodes. The selected or hovered
+    // node's edges are always drawn.
+    static let lowZoom: CGFloat = 0.6
+
+    static func edgeVisible(_ edge: OmniMemoryGraphEdge, scale: CGFloat, tagGroupSize: Int,
+                            emphasised: Set<String>) -> Bool {
+        if emphasised.contains(edge.source) || emphasised.contains(edge.target) {
+            return true
+        }
+        guard scale < lowZoom else { return true }
+        switch edge.kind {
+        case "similarity": return edge.strength >= 0.9
+        case "tag": return tagGroupSize <= 8
+        case "tree", "lineage": return true
+        default: return false
+        }
+    }
+
+    // How many memories each tag-edge label groups, for the level of detail.
+    static func tagGroupSizes(_ edges: [OmniMemoryGraphEdge]) -> [String: Int] {
+        var members: [String: Set<String>] = [:]
+        for edge in edges where edge.kind == "tag" {
+            let key = edge.label ?? ""
+            members[key, default: []].insert(edge.source)
+            members[key, default: []].insert(edge.target)
+        }
+        return members.mapValues(\.count)
+    }
+}
+
+// A flat quadtree for Barnes–Hut. Cells are stored in arrays; a cell's four
+// children are consecutive, starting at `firstChild` (-1 for a leaf).
+struct OmniQuadTree {
+    private(set) var minX: [Double] = []
+    private(set) var minY: [Double] = []
+    private(set) var size: [Double] = []
+    private(set) var mass: [Double] = []
+    private(set) var sumX: [Double] = []
+    private(set) var sumY: [Double] = []
+    private(set) var firstChild: [Int] = []
+    private(set) var body: [Int] = []
+    private static let maximumDepth = 40
+
+    init(x: [Double], y: [Double]) {
+        guard !x.isEmpty else { return }
+        let lowX = x.min() ?? 0, highX = x.max() ?? 0, lowY = y.min() ?? 0, highY = y.max() ?? 0
+        let side = max(highX - lowX, highY - lowY, 1) * 1.0001
+        addCell(minX: lowX, minY: lowY, size: side)
+        for i in 0..<x.count {
+            insert(i, x: x[i], y: y[i])
+        }
+    }
+
+    private mutating func addCell(minX: Double, minY: Double, size: Double) {
+        self.minX.append(minX)
+        self.minY.append(minY)
+        self.size.append(size)
+        mass.append(0)
+        sumX.append(0)
+        sumY.append(0)
+        firstChild.append(-1)
+        body.append(-1)
+    }
+
+    private func quadrant(_ cell: Int, x: Double, y: Double) -> Int {
+        let half = size[cell] / 2
+        return (x >= minX[cell] + half ? 1 : 0) + (y >= minY[cell] + half ? 2 : 0)
+    }
+
+    private mutating func split(_ cell: Int) {
+        let half = size[cell] / 2
+        firstChild[cell] = mass.count
+        for q in 0..<4 {
+            addCell(minX: minX[cell] + (q & 1 == 1 ? half : 0), minY: minY[cell] + (q & 2 == 2 ? half : 0), size: half)
+        }
+    }
+
+    private mutating func insert(_ i: Int, x: Double, y: Double) {
+        var cell = 0
+        var depth = 0
+        // The body a split leaf held, with its position, waiting to move down.
+        var pending: (Int, Double, Double)?
+        while true {
+            mass[cell] += 1
+            sumX[cell] += x
+            sumY[cell] += y
+            if firstChild[cell] < 0 {
+                if mass[cell] == 1 {
+                    body[cell] = i
+                    return
+                }
+                if depth >= Self.maximumDepth {
+                    return  // Coincident points share this leaf.
+                }
+                let held = body[cell]
+                body[cell] = -1
+                split(cell)
+                if held >= 0 {
+                    let heldX = (sumX[cell] - x) / (mass[cell] - 1), heldY = (sumY[cell] - y) / (mass[cell] - 1)
+                    pending = (held, heldX, heldY)
+                }
+            }
+            if let held = pending {
+                let child = firstChild[cell] + quadrant(cell, x: held.1, y: held.2)
+                mass[child] = 1
+                sumX[child] = held.1
+                sumY[child] = held.2
+                body[child] = held.0
+                pending = nil
+            }
+            cell = firstChild[cell] + quadrant(cell, x: x, y: y)
+            depth += 1
+        }
+    }
+}
