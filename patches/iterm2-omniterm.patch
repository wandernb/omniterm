@@ -0,0 +1,2131 @@
+//
+//  OmniSidebarUITests.swift
+//  ModernTests
+//
+//  Drives the real sidebar and appearance picker views in an offscreen
+//  window, with a fake scheduler answering their requests, so rename, the
+//  icon picker and group creation are proven without touching a running app.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+// Answers the scheduler requests the sidebar makes and records them.
+private final class FakeScheduler {
+    var agents: [[String: Any]]
+    var groups: [String] = []
+    var order: [String] = []
+    var runs: [[String: Any]] = []
+    var layout: [String: Any] = [:]
+    var notifications: [[String: Any]] = []
+    var attention = 0
+    var requests: [[String: Any]] = []
+    // Overrides the answer to one operation.
+    var answers: [String: [AnyHashable: Any]] = [:]
+    // Answers one operation from its request.
+    var handlers: [String: ([String: Any]) -> [AnyHashable: Any]] = [:]
+
+    init(agents: [String]) {
+        self.agents = agents.map { ["name": $0, "provider": "claude", "enabled": true] }
+    }
+
+    func handle(_ request: [String: Any], completion: @escaping ([AnyHashable: Any]) -> Void) {
+        requests.append(request)
+        let op = request["op"] as? String ?? ""
+        var response: [AnyHashable: Any]
+        if let handler = handlers[op] {
+            response = handler(request)
+        } else if let answer = answers[op] {
+            response = answer
+        } else {
+            switch op {
+            case "list_agents":
+                response = ["ok": true, "agents": agents]
+            case "list_runs":
+                let agent = request["agent"] as? String
+                response = ["ok": true, "runs": runs.filter { agent == nil || $0["agent"] as? String == agent }]
+            case "show_agent":
+                let agent = agents.first { $0["name"] as? String == request["name"] as? String }
+                response = agent.map { ["ok": true, "agent": $0] } ?? ["ok": false, "error": "Agent not found"]
+            case "get_run":
+                let run = runs.first { $0["id"] as? String == request["id"] as? String }
+                response = run.map { ["ok": true, "run": $0] } ?? ["ok": false, "code": "run_not_found"]
+            case "run_screen":
+                // A recorded screen keeps the band from asking the omni helper.
+                response = ["ok": true, "screen": "$ done"]
+            case "notifications":
+                let unread = notifications.filter { $0["unread"] as? Bool == true }.count
+                response = ["ok": true, "notifications": notifications, "unread_count": unread, "attention_count": attention]
+            case "get_settings":
+                response = ["ok": true, "settings": ["sidebar_groups": groups, "sidebar_order": order, "layout": layout]]
+            case "set_layout":
+                layout.merge(request["layout"] as? [String: Any] ?? [:]) { _, new in new }
+                response = ["ok": true, "layout": layout]
+            case "rename_agent":
+                let old = request["name"] as? String
+                let new = request["new_name"] as? String ?? ""
+                agents = agents.map { agent in
+                    guard agent["name"] as? String == old else { return agent }
+                    var renamed = agent
+                    renamed["name"] = new
+                    return renamed
+                }
+                response = ["ok": true]
+            case "set_sidebar_groups":
+                groups = request["groups"] as? [String] ?? []
+                response = ["ok": true]
+            case "set_sidebar_order":
+                order = request["items"] as? [String] ?? []
+                response = ["ok": true]
+            case "rename_group":
+                let from = request["from"] as? String ?? ""
+                let to = request["to"] as? String ?? ""
+                agents = agents.map { agent in
+                    guard agent["group"] as? String == from else { return agent }
+                    var moved = agent
+                    moved["group"] = to
+                    return moved
+                }
+                groups = groups.map { $0 == from ? to : $0 }
+                response = ["ok": true]
+            default:
+                response = ["ok": false, "error": "Not faked"]
+            }
+        }
+        // Like the real client: answers arrive later, on the main thread.
+        DispatchQueue.main.async {
+            completion(response)
+        }
+    }
+
+    func requests(_ op: String) -> [[String: Any]] {
+        return requests.filter { $0["op"] as? String == op }
+    }
+}
