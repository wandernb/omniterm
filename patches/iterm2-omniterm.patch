+- (void)launchOmniSchedulerCommand:(NSString *)command title:(NSString *)title {
+    [self launchOmniSchedulerCommand:command title:title runID:nil agent:nil background:NO];
+}
+
+// A background run's tab is inserted without being selected: the sidebar
+// follows the selected run tab to its page, so selecting it would pull the
+// window away from what the person is doing every time the agent fires.
+// Launches overlap (tab creation waits for a working directory), so only
+// background launches touch the flag, and the last one to finish restores it.
+static NSInteger OmniPendingBackgroundLaunches;
+static BOOL OmniSelectedNewTabsBeforeBackgroundLaunch;
+
+- (void)launchOmniSchedulerCommand:(NSString *)command
+                             title:(NSString *)title
+                             runID:(NSString *)runID
+                             agent:(NSString *)agent
+                        background:(BOOL)background {
+    PseudoTerminal *terminal = [iTermController sharedInstance].currentTerminal ?: self.terminals.firstObject;
+    if (!terminal) {
+        [[iTermController sharedInstance] newWindow:nil];
+        for (PseudoTerminal *newTerminal in self.terminals) {
+            [newTerminal.window orderOut:nil];
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [self launchOmniSchedulerCommand:command title:title runID:runID agent:agent background:background];
+        });
+        return;
+    }
+    const BOOL wasVisible = terminal.window.isVisible;
+    const BOOL previouslyOrderedNewTabs = terminal.automaticallyOrderFrontNewTabs;
+    terminal.automaticallyOrderFrontNewTabs = NO;
+    if (background) {
+        if (OmniPendingBackgroundLaunches++ == 0) {
+            OmniSelectedNewTabsBeforeBackgroundLaunch = terminal.automaticallySelectNewTabs;
+        }
+        terminal.automaticallySelectNewTabs = NO;
+    }
+    MutableProfile *profile = [[[[ProfileModel sharedInstance] defaultBookmark] mutableCopy] autorelease];
+    profile[KEY_NAME] = title;
+    NSMutableDictionary *environment = [NSMutableDictionary dictionaryWithDictionary:@{
+        @"OMNITERM_MANAGED": @"1",
+        @"OMNITERM_KIND": [title isEqualToString:@"Omni"] ? @"dashboard" : @"run",
+        @"OMNITERM_DASHBOARD_KEYS": [title isEqualToString:@"Omni"] ? @"1" : @"0" }];
+    // Saved with the arrangement, so a restored tab still knows its run.
+    if (runID.length) {
+        environment[@"OMNITERM_RUN_ID"] = runID;
+    }
+    if (agent.length) {
+        environment[@"OMNITERM_AGENT"] = agent;
+    }
+    [terminal asyncCreateTabWithProfile:profile
+                            withCommand:command
+                            environment:environment
+                               tabIndex:[title isEqualToString:@"Omni"] ? @0 : nil
+                         didMakeSession:^(PTYSession *session) {
+        [session.nameController setNeedsUpdate];
+        if ([title isEqualToString:@"Omni"]) {
+            PTYTab *dashboardTab = [terminal tabForSession:session];
+            [self cleanOmniTermStartupTabsInTerminal:terminal keepingTab:dashboardTab];
+            // Restored helpers can take a moment to notice that their owning
+            // app process changed and exit. Sweep again while launch settles
+            // so they cannot remain as dead “Terminal Python” tabs.
+            for (NSNumber *delay in @[ @1, @3 ]) {
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+                                             delay.longLongValue * NSEC_PER_SEC),
+                               dispatch_get_main_queue(), ^{
+                    if ([terminal.tabs containsObject:dashboardTab]) {
+                        [self cleanOmniTermStartupTabsInTerminal:terminal keepingTab:dashboardTab];
+                    }
+                });
+            }
+        }
+        terminal.automaticallyOrderFrontNewTabs = previouslyOrderedNewTabs;
+        if (background && --OmniPendingBackgroundLaunches == 0) {
+            terminal.automaticallySelectNewTabs = OmniSelectedNewTabsBeforeBackgroundLaunch;
+        }
+        if (!wasVisible) {
+            [terminal.window orderOut:nil];
+        }
+    }
+                             completion:nil];
+}
