+#pragma mark - Notifications
+
+// Agents and scripts raise notifications explicitly; nothing here infers them
+// from run state. Every field is untrusted text: it is stored and displayed,
+// never executed or opened.
+
+static const NSUInteger OmniNotificationTitleLimit = 120;
+static const NSUInteger OmniNotificationBodyLimit = 8000;
+static const NSUInteger OmniNotificationFieldLimit = 1024;
+static const NSInteger OmniNotificationsPerRun = 20;
+static const NSTimeInterval OmniNotificationDedupeWindow = 24 * 60 * 60;
+static const NSInteger OmniNotificationRetainedCount = 1000;
+static const NSTimeInterval OmniNotificationReadRetention = 30 * 24 * 60 * 60;
+static const NSUInteger OmniNotificationDiffLimit = 2 * 1024 * 1024;
+static const NSUInteger OmniNotificationFileListLimit = 64 * 1024;
+static const NSTimeInterval OmniNotificationDiffTimeout = 10;
+static NSString *const OmniNotificationRunLimitPrefix = @"omni:run-limit:";
+// With attributes read from the empty tree, no repository-configured filter,
+// textconv or diff driver can run while a diff is captured.
+static NSString *const OmniEmptyTreeObjectID = @"4b825dc642cb6eb9a060e54bf8d69288fbee4904";
+
+static NSString *OmniTruncatedString(NSString *value, NSUInteger limit, BOOL *truncated) {
+    if (value.length <= limit) {
+        return value;
+    }
+    *truncated = YES;
+    const NSRange range = [value rangeOfComposedCharacterSequencesForRange:NSMakeRange(0, limit - 1)];
+    return [[value substringWithRange:range] stringByAppendingString:@"…"];
+}
+
+static NSString *OmniOptionalString(id value, NSUInteger limit) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    NSString *trimmed = [value stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    if (!trimmed.length) {
+        return nil;
+    }
+    BOOL ignored = NO;
+    return OmniTruncatedString(trimmed, limit, &ignored);
+}
+
+static NSString *OmniLossyString(NSData *data) {
+    if (!data.length) {
+        return @"";
+    }
+    NSString *string = [[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease];
+    return string ?: [[[NSString alloc] initWithData:data encoding:NSISOLatin1StringEncoding] autorelease];
+}
+
+- (NSString *)notificationDiffsPath {
+    return [_supportPath stringByAppendingPathComponent:@"notification-diffs"];
+}
+
+- (void)notificationsDidChange {
+    void (^handler)(void) = self.notificationsChangedHandler;
+    if (handler) {
+        dispatch_async(dispatch_get_main_queue(), handler);
+    }
+}
+
+- (void)performRequest:(NSDictionary *)request completion:(void (^)(NSDictionary *))completion {
+    void (^callback)(NSDictionary *) = [[completion copy] autorelease];
+    NSDictionary *requestCopy = [[request copy] autorelease];
+    const BOOL knowledge = [requestCopy isKindOfClass:[NSDictionary class]] && OmniIsKnowledgeOperation(requestCopy[@"op"]);
+    if (knowledge && OmniIsKnowledgeReadOperation(requestCopy[@"op"])) {
+        dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+            NSDictionary *read = [self knowledgeReadResponse:requestCopy];
+            if (read) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    callback(read);
+                });
+                return;
+            }
+            [self performQueuedRequest:requestCopy knowledge:YES completion:callback];
+        });
+        return;
+    }
+    [self performQueuedRequest:requestCopy knowledge:knowledge completion:callback];
+}
+
+- (void)performQueuedRequest:(NSDictionary *)requestCopy knowledge:(BOOL)knowledge completion:(void (^)(NSDictionary *))callback {
+    if (knowledge) {
+        atomic_fetch_add(&_knowledgeWaiters, 1);
+    }
+    dispatch_async(knowledge ? _knowledgeQueue : _queue, ^{
+        if (knowledge) {
+            atomic_fetch_sub(&self->_knowledgeWaiters, 1);
+        }
+        NSDictionary *response = knowledge ? [self responseForKnowledgeRequest:requestCopy]
+            : (self->_database ? [self responseForRequest:requestCopy]
+                               : @{ @"ok": @NO, @"error": @"The OmniTerm scheduler is not running" });
+        dispatch_async(dispatch_get_main_queue(), ^{
+            callback(response);
+        });
+    });
+}
+
+// `attention_count` is what the menu bar, widget and sidebar show: unread
+// items the notification settings count (by default attention and urgent).
+- (NSDictionary *)notificationCounts {
+    NSDictionary *notificationSettings = [self settings][@"notifications"];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    NSInteger unread = 0, counted = 0, urgent = 0;
+    NSDictionary *latest = [self rowsForSQL:@"SELECT MAX(updated) AS latest FROM notifications" bindings:@[]].firstObject;
+    for (NSDictionary *row in [self rowsForSQL:@"SELECT severity, agent, kind FROM notifications WHERE read IS NULL" bindings:@[]]) {
+        unread++;
+        if ([row[@"severity"] isEqual:@"urgent"]) urgent++;
+        if ([OmniNotificationAlert(row, notificationSettings, now)[@"count"] boolValue]) counted++;
+    }
+    return @{ @"unread_count": @(unread),
+              @"attention_count": @(counted),
+              @"urgent_count": @(urgent),
+              @"muted": @(OmniNotificationsMuted(notificationSettings, now)),
+              @"muted_until": notificationSettings[@"muted_until"] ?: @0,
+              @"latest_updated": @(OmniDoubleValue(latest[@"latest"])) };
+}
+
+- (NSDictionary *)publicNotification:(NSDictionary *)row alertSettings:(NSDictionary *)notificationSettings now:(NSTimeInterval)now {
+    NSMutableDictionary *notification = [[row mutableCopy] autorelease];
+    [notification removeObjectForKey:@"diff_path"];
+    if (![notification[@"kind"] isKindOfClass:[NSString class]]) notification[@"kind"] = @"agent";
+    notification[@"alert"] = OmniNotificationAlert(notification, notificationSettings, now);
+    notification[@"unread"] = @(row[@"read"] == [NSNull null]);
+    NSString *files = [row[@"diff_files"] isKindOfClass:[NSString class]] ? row[@"diff_files"] : nil;
+    notification[@"diff_files"] = files.length ? [files componentsSeparatedByString:@"\n"] : @[];
+    return notification;
+}
+
+- (NSDictionary *)handleNotificationRequest:(NSDictionary *)request operation:(id)operation {
+    if (![operation isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    if ([operation isEqualToString:@"notify"]) {
+        return [self createNotification:request];
+    }
+    if ([operation isEqualToString:@"show_inbox"]) {
+        void (^handler)(NSString *) = self.showInboxHandler;
+        NSString *identifier = [request[@"id"] isKindOfClass:[NSString class]] ? [[request[@"id"] copy] autorelease] : nil;
+        if (!handler) {
+            return @{ @"ok": @NO, @"error": @"The Inbox is unavailable" };
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            handler(identifier);
+        });
+        return @{ @"ok": @YES };
+    }
+    if ([operation isEqualToString:@"notifications"]) {
+        NSInteger limit = request[@"limit"] ? OmniIntegerValue(request[@"limit"]) : 100;
+        limit = MAX(1, MIN(500, limit));
+        NSMutableArray *clauses = [NSMutableArray array];
+        NSMutableArray *bindings = [NSMutableArray array];
+        if ([request[@"unread"] isEqual:@YES]) {
+            [clauses addObject:@"read IS NULL"];
+        }
+        if ([request[@"important"] isEqual:@YES]) {
+            [clauses addObject:@"severity IN ('attention','urgent')"];
+        }
+        NSString *severity = OmniOptionalString(request[@"severity"], 32);
+        if (severity) {
+            [clauses addObject:@"severity=?"];
+            [bindings addObject:severity];
+        }
+        NSString *agent = OmniOptionalString(request[@"agent"], OmniNotificationFieldLimit);
+        if (agent) {
+            [clauses addObject:@"agent=?"];
+            [bindings addObject:agent];
+        }
+        NSString *kind = OmniOptionalString(request[@"kind"], 32);
+        if (kind) {
+            [clauses addObject:[kind isEqualToString:@"agent"] ? @"(kind=? OR kind IS NULL)" : @"kind=?"];
+            [bindings addObject:kind];
+        }
+        // `counted` and `bannerable` filter on the notification settings, which
+        // SQL cannot evaluate, so the limit applies after them.
+        const BOOL counted = [request[@"counted"] isEqual:@YES];
+        const BOOL bannerable = [request[@"bannerable"] isEqual:@YES];
+        NSString *where = clauses.count ? [@" WHERE " stringByAppendingString:[clauses componentsJoinedByString:@" AND "]] : @"";
+        NSString *sql = (counted || bannerable)
+            ? [NSString stringWithFormat:@"SELECT * FROM notifications%@ ORDER BY updated DESC", where]
+            : [NSString stringWithFormat:@"SELECT * FROM notifications%@ ORDER BY updated DESC LIMIT %ld", where, (long)limit];
+        NSDictionary *notificationSettings = [self settings][@"notifications"];
+        const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+        NSMutableArray *notifications = [NSMutableArray array];
+        for (NSDictionary *row in [self rowsForSQL:sql bindings:bindings]) {
+            NSDictionary *notification = [self publicNotification:row alertSettings:notificationSettings now:now];
+            if (counted && ![notification[@"alert"][@"count"] boolValue]) continue;
+            if (bannerable && ![notification[@"alert"][@"banner"] boolValue]) continue;
+            [notifications addObject:notification];
+            if ((NSInteger)notifications.count >= limit) break;
+        }
+        NSMutableDictionary *response = [NSMutableDictionary dictionaryWithDictionary:[self notificationCounts]];
+        response[@"ok"] = @YES;
+        response[@"notifications"] = notifications;
+        return response;
+    }
+    if ([operation isEqualToString:@"notification_read"]) {
+        NSString *identifier = [request[@"id"] isKindOfClass:[NSString class]] ? request[@"id"] : nil;
+        id readValue = request[@"read"];
+        if (!identifier.length || (readValue && ![readValue isKindOfClass:[NSNumber class]])) {
+            return @{ @"ok": @NO, @"code": @"invalid_notification", @"error": @"A notification id is required, and read must be a boolean" };
+        }
+        const BOOL read = readValue ? [readValue boolValue] : YES;
+        [self runSQL:@"UPDATE notifications SET read=? WHERE id=?"
+            bindings:@[ read ? @([NSDate date].timeIntervalSince1970) : [NSNull null], identifier ]];
+        if (sqlite3_changes(_database) == 0) {
+            return @{ @"ok": @NO, @"code": @"notification_not_found", @"error": @"Notification not found" };
+        }
+        [self notificationsDidChange];
+        NSMutableDictionary *response = [NSMutableDictionary dictionaryWithDictionary:[self notificationCounts]];
+        response[@"ok"] = @YES;
+        return response;
+    }
+    if ([operation isEqualToString:@"notifications_read_all"]) {
+        [self runSQL:@"UPDATE notifications SET read=? WHERE read IS NULL"
+            bindings:@[ @([NSDate date].timeIntervalSince1970) ]];
+        const int changed = sqlite3_changes(_database);
+        [self notificationsDidChange];
+        NSMutableDictionary *response = [NSMutableDictionary dictionaryWithDictionary:[self notificationCounts]];
+        response[@"ok"] = @YES;
+        response[@"marked"] = @(changed);
+        return response;
+    }
+    if ([operation isEqualToString:@"notification_delete"]) {
+        NSString *identifier = [request[@"id"] isKindOfClass:[NSString class]] ? request[@"id"] : @"";
+        NSDictionary *row = [self rowsForSQL:@"SELECT id,diff_path FROM notifications WHERE id=?" bindings:@[ identifier ]].firstObject;
+        if (!row) {
+            return @{ @"ok": @NO, @"code": @"notification_not_found", @"error": @"Notification not found" };
+        }
+        [self deleteNotificationRow:row];
+        [self notificationsDidChange];
+        return @{ @"ok": @YES };
+    }
+    if ([operation isEqualToString:@"notification_diff"]) {
+        NSString *identifier = [request[@"id"] isKindOfClass:[NSString class]] ? request[@"id"] : @"";
+        NSDictionary *row = [self rowsForSQL:@"SELECT * FROM notifications WHERE id=?" bindings:@[ identifier ]].firstObject;
+        if (!row) {
+            return @{ @"ok": @NO, @"code": @"notification_not_found", @"error": @"Notification not found" };
+        }
+        NSString *path = [self ownedDiffPath:row[@"diff_path"]];
+        NSData *data = path ? [NSData dataWithContentsOfFile:path] : nil;
+        NSMutableDictionary *response = [NSMutableDictionary dictionary];
+        response[@"ok"] = @YES;
+        response[@"diff"] = OmniLossyString(data);
+        response[@"diff_state"] = row[@"diff_state"] ?: [NSNull null];
+        response[@"diff_files"] = [self publicNotification:row alertSettings:@{} now:0][@"diff_files"];
+        return response;
+    }
+    return nil;
+}
+
+// Only files under the scheduler's own diff directory are read or deleted,
+// whatever the database says.
+static NSString *OmniOwnedPath(id value, NSString *directory) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    NSString *prefix = [directory stringByAppendingString:@"/"];
+    NSString *path = [value stringByStandardizingPath];
+    return [path hasPrefix:prefix] ? path : nil;
+}
+
+// The last screen of a run's terminal, kept like run diffs. The file name is
+// the run id, which is checked against a strict charset, so no stored path is
+// ever trusted.
+static NSString *const OmniRunScreenHeader = @"omni-screen 1";
+static const NSUInteger OmniRunScreenByteLimit = 2 * 1024 * 1024;
+
+static BOOL OmniIsRunID(id value) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return NO;
+    }
+    NSString *string = value;
+    if (string.length == 0 || string.length > 64) {
+        return NO;
+    }
+    NSCharacterSet *allowed = [NSCharacterSet characterSetWithCharactersInString:@"0123456789abcdef-"];
+    return [string rangeOfCharacterFromSet:allowed.invertedSet].location == NSNotFound;
+}
+
+- (NSString *)ownedDiffPath:(id)value {
+    return OmniOwnedPath(value, [self notificationDiffsPath]);
+}
+
+- (void)deleteNotificationRow:(NSDictionary *)row {
+    NSString *path = [self ownedDiffPath:row[@"diff_path"]];
+    if (path) {
+        [[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+    }
+    [self runSQL:@"DELETE FROM notifications WHERE id=?" bindings:@[ row[@"id"] ]];
+}
+
+- (void)pruneNotifications {
+    const NSTimeInterval cutoff = [NSDate date].timeIntervalSince1970 - OmniNotificationReadRetention;
+    NSString *sql = [NSString stringWithFormat:@"SELECT id,diff_path FROM notifications WHERE (read IS NOT NULL AND updated < ?) "
+                     "OR id NOT IN (SELECT id FROM notifications ORDER BY updated DESC LIMIT %ld)",
+                     (long)OmniNotificationRetainedCount];
+    for (NSDictionary *row in [self rowsForSQL:sql bindings:@[ @(cutoff) ]]) {
+        [self deleteNotificationRow:row];
+    }
+}
+
+- (NSDictionary *)invalidNotification:(NSString *)message {
+    return @{ @"ok": @NO, @"code": @"invalid_notification", @"error": message };
+}
+
+- (NSDictionary *)createNotification:(NSDictionary *)request {
+    for (NSString *key in @[ @"title", @"body", @"severity", @"agent", @"run_id", @"workspace", @"dedupe_key", @"kind" ]) {
+        id value = request[key];
+        if (value && ![value isKindOfClass:[NSString class]]) {
+            return [self invalidNotification:[NSString stringWithFormat:@"%@ must be a string", key]];
+        }
+    }
+    id includeDiff = request[@"include_diff"];
+    if (includeDiff && ![includeDiff isKindOfClass:[NSNumber class]]) {
+        return [self invalidNotification:@"include_diff must be a boolean"];
+    }
+    // Titles are one line in menus and lists.
+    NSString *title = [[(request[@"title"] ?: @"") componentsSeparatedByCharactersInSet:NSCharacterSet.newlineCharacterSet]
+                       componentsJoinedByString:@" "];
+    title = [title stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+    if (!title.length) {
+        return [self invalidNotification:@"Notification title must not be empty"];
+    }
+    BOOL truncated = NO;
+    title = OmniTruncatedString(title, OmniNotificationTitleLimit, &truncated);
+    NSString *body = OmniTruncatedString(request[@"body"] ?: @"", OmniNotificationBodyLimit, &truncated);
+    NSString *severity = request[@"severity"] ?: @"attention";
+    if (![@[ @"info", @"attention", @"urgent" ] containsObject:severity]) {
+        return [self invalidNotification:@"severity must be info, attention or urgent"];
+    }
+    NSString *runID = OmniOptionalString(request[@"run_id"], 64);
+    NSString *agent = OmniOptionalString(request[@"agent"], 200);
+    NSString *workspace = OmniOptionalString(request[@"workspace"], OmniNotificationFieldLimit);
+    NSString *dedupeKey = OmniOptionalString(request[@"dedupe_key"], 200);
+    if ([dedupeKey hasPrefix:@"omni:"]) {
+        return [self invalidNotification:@"dedupe_key must not start with omni:"];
+    }
+    // OmniTerm's own producers name their kind; the MCP tool never passes one,
+    // so an agent's notification is always `agent`. `run_limit` is set here only.
+    NSString *kind = request[@"kind"] ?: @"agent";
+    if (![OmniNotificationKindNames() containsObject:kind] || [kind isEqualToString:@"run_limit"]) {
+        return [self invalidNotification:@"kind must be agent, compaction, wrap_up, loop_continuation or storage"];
+    }
+    if (runID && !agent) {
+        NSDictionary *run = [self rowsForSQL:@"SELECT agent FROM runs WHERE id=?" bindings:@[ runID ]].firstObject;
+        if ([run[@"agent"] isKindOfClass:[NSString class]]) {
+            agent = run[@"agent"];
+        }
+    }
+    if (!workspace && agent) {
+        NSDictionary *row = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ agent ]].firstObject;
+        NSDictionary *definition = row ? [self decodedAgentRow:row] : nil;
+        if ([definition[@"workspace"] isKindOfClass:[NSString class]]) {
+            workspace = definition[@"workspace"];
+        }
+    }
+    workspace = [workspace stringByExpandingTildeInPath];
+    const BOOL wantsDiff = workspace.length && (includeDiff ? [includeDiff boolValue] : YES);
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    id null = [NSNull null];
+
+    NSMutableDictionary *response = [NSMutableDictionary dictionary];
+    response[@"ok"] = @YES;
+    response[@"truncated"] = @(truncated);
+    response[@"severity"] = severity;
+    if (agent) response[@"agent"] = agent;
+    if (runID) response[@"run_id"] = runID;
+
+    if (dedupeKey) {
+        NSDictionary *existing = [self rowsForSQL:@"SELECT id FROM notifications WHERE dedupe_key=? AND updated>=? ORDER BY updated DESC LIMIT 1"
+                                         bindings:@[ dedupeKey, @(now - OmniNotificationDedupeWindow) ]].firstObject;
+        if (existing) {
+            [self runSQL:@"UPDATE notifications SET updated=?,title=?,body=?,severity=?,kind=?,read=NULL,"
+                          "agent=COALESCE(?,agent),run_id=COALESCE(?,run_id),workspace=COALESCE(?,workspace),diff_state=COALESCE(?,diff_state) WHERE id=?"
+                bindings:@[ @(now), title, body, severity, kind, agent ?: null, runID ?: null, workspace ?: null,
+                            wantsDiff ? @"pending" : null, existing[@"id"] ]];
+            if (wantsDiff) {
+                [self captureDiffForNotification:existing[@"id"] workspace:workspace];
+            }
+            [self notificationsDidChange];
+            response[@"id"] = existing[@"id"];
+            response[@"deduplicated"] = @YES;
+            return response;
+        }
+    }
+    if (runID) {
+        NSString *summaryKey = [OmniNotificationRunLimitPrefix stringByAppendingString:runID];
+        NSDictionary *countRow = [self rowsForSQL:@"SELECT COUNT(*) AS count FROM notifications WHERE run_id=? AND (dedupe_key IS NULL OR dedupe_key<>?)"
+                                         bindings:@[ runID, summaryKey ]].firstObject;
+        if (OmniIntegerValue(countRow[@"count"]) >= OmniNotificationsPerRun) {
+            // A looping agent gets one summary item, not a flood.
+            NSDictionary *summary = [self rowsForSQL:@"SELECT id FROM notifications WHERE dedupe_key=?" bindings:@[ summaryKey ]].firstObject;
+            NSString *summaryID = summary[@"id"] ?: NSUUID.UUID.UUIDString.lowercaseString;
+            if (summary) {
+                [self runSQL:@"UPDATE notifications SET suppressed=suppressed+1,updated=?,read=NULL WHERE id=?"
+                    bindings:@[ @(now), summaryID ]];
+            } else {
+                [self runSQL:@"INSERT INTO notifications(id,created,updated,title,body,severity,agent,run_id,workspace,dedupe_key,suppressed,kind) VALUES(?,?,?,?,?,'attention',?,?,?,?,1,'run_limit')"
+                    bindings:@[ summaryID, @(now), @(now), @"Further notifications were held back", @"", agent ?: null,
+                                runID, workspace ?: null, summaryKey ]];
+            }
+            NSDictionary *counted = [self rowsForSQL:@"SELECT suppressed FROM notifications WHERE id=?" bindings:@[ summaryID ]].firstObject;
+            NSString *summaryBody = [NSString stringWithFormat:@"This run sent more than %ld notifications. %ld later ones were not stored. The newest was: %@",
+                                     (long)OmniNotificationsPerRun, (long)OmniIntegerValue(counted[@"suppressed"]), title];
+            [self runSQL:@"UPDATE notifications SET body=? WHERE id=?" bindings:@[ summaryBody, summaryID ]];
+            [self notificationsDidChange];
+            response[@"id"] = summaryID;
+            response[@"suppressed"] = @YES;
+            return response;
+        }
+    }
+    NSString *identifier = NSUUID.UUID.UUIDString.lowercaseString;
+    const BOOL inserted = [self runSQL:@"INSERT INTO notifications(id,created,updated,title,body,severity,agent,run_id,workspace,dedupe_key,diff_state,kind) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)"
+                              bindings:@[ identifier, @(now), @(now), title, body, severity, agent ?: null, runID ?: null,
+                                          workspace ?: null, dedupeKey ?: null, wantsDiff ? @"pending" : null, kind ]];
+    if (!inserted) {
+        return @{ @"ok": @NO, @"code": @"write_failed", @"error": @"Could not store the notification" };
+    }
+    if (wantsDiff) {
+        [self captureDiffForNotification:identifier workspace:workspace];
+    }
+    [self pruneNotifications];
+    [self notificationsDidChange];
+    response[@"id"] = identifier;
+    return response;
+}
+
+// Capture runs off the scheduler queue with a timeout, so a huge repository
+// cannot stall scheduling. The diff is frozen: later work never changes it.
+- (void)captureDiffForNotification:(NSString *)identifier workspace:(NSString *)workspace {
+    NSString *directory = [self notificationDiffsPath];
+    NSString *path = [directory stringByAppendingPathComponent:[identifier stringByAppendingPathExtension:@"diff"]];
+    NSString *notificationID = [[identifier copy] autorelease];
+    NSString *workspacePath = [[workspace copy] autorelease];
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        NSDictionary *result = [OmniScheduler capturedDiffForWorkspace:workspacePath path:path directory:directory];
+        dispatch_async(self->_queue, ^{
+            if (!self->_database) {
+                return;
+            }
+            id null = [NSNull null];
+            [self runSQL:@"UPDATE notifications SET diff_state=?,diff_path=?,diff_files=? WHERE id=?"
+                bindings:@[ result[@"state"], result[@"path"] ?: null, result[@"files"] ?: null, notificationID ]];
+            if (sqlite3_changes(self->_database) == 0 && result[@"path"]) {
+                [[NSFileManager defaultManager] removeItemAtPath:result[@"path"] error:nil];
+            }
+            [self notificationsDidChange];
+        });
+    });
+}
+
++ (NSString *)gitExecutable {
+    // /usr/bin/git is a shim that offers to install the developer tools when
+    // they are missing, so it is never used directly.
+    for (NSString *candidate in @[ @"/opt/homebrew/bin/git",
+                                   @"/usr/local/bin/git",
+                                   @"/Library/Developer/CommandLineTools/usr/bin/git",
+                                   @"/Applications/Xcode.app/Contents/Developer/usr/bin/git" ]) {
+        if ([[NSFileManager defaultManager] isExecutableFileAtPath:candidate]) {
+            return candidate;
+        }
+    }
+    return nil;
+}
+
++ (NSData *)outputOfGit:(NSString *)git
+              arguments:(NSArray *)arguments
+              workspace:(NSString *)workspace
+                  limit:(NSUInteger)limit
+              truncated:(BOOL *)truncated {
+    NSTask *task = [[[NSTask alloc] init] autorelease];
+    task.executableURL = [NSURL fileURLWithPath:git];
+    NSArray *safety = @[ @"-C", workspace,
+                         @"-c", @"core.fsmonitor=false",
+                         @"-c", @"core.untrackedCache=false",
+                         [@"--attr-source=" stringByAppendingString:OmniEmptyTreeObjectID],
+                         @"--no-pager" ];
+    task.arguments = [safety arrayByAddingObjectsFromArray:arguments];
+    task.environment = @{ @"HOME": NSHomeDirectory(),
+                          @"PATH": @"/usr/bin:/bin",
+                          @"GIT_OPTIONAL_LOCKS": @"0",
+                          @"GIT_TERMINAL_PROMPT": @"0",
+                          @"LC_ALL": @"C" };
+    NSPipe *pipe = [NSPipe pipe];
+    task.standardOutput = pipe;
+    task.standardError = [NSFileHandle fileHandleWithNullDevice];
+    task.standardInput = [NSFileHandle fileHandleWithNullDevice];
+    if (![task launchAndReturnError:nil]) {
+        return nil;
+    }
+    __block BOOL timedOut = NO;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(OmniNotificationDiffTimeout * NSEC_PER_SEC)),
+                   dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        if (task.isRunning) {
+            timedOut = YES;
+            [task terminate];
+        }
+    });
+    NSMutableData *data = [NSMutableData data];
+    NSFileHandle *reader = pipe.fileHandleForReading;
+    @try {
+        while (YES) {
+            NSData *chunk = [reader availableData];
+            if (!chunk.length) {
+                break;
+            }
+            if (data.length < limit) {
+                [data appendData:chunk];
+            } else if (!*truncated) {
+                *truncated = YES;
+                [task terminate];
+            }
+        }
+    } @catch (NSException *exception) {
+        NSLog(@"OmniScheduler could not read git output: %@", exception);
+    }
+    [task waitUntilExit];
+    if (data.length > limit) {
+        data.length = limit;
+        *truncated = YES;
+    }
+    if (timedOut || (!*truncated && task.terminationStatus != 0)) {
+        return nil;
+    }
+    return data;
+}
+
++ (NSDictionary *)capturedDiffForWorkspace:(NSString *)workspace path:(NSString *)path directory:(NSString *)directory {
+    BOOL isDirectory = NO;
+    if (![[NSFileManager defaultManager] fileExistsAtPath:workspace isDirectory:&isDirectory] || !isDirectory) {
+        return @{ @"state": @"no_workspace" };
+    }
+    NSString *git = [self gitExecutable];
+    if (!git) {
+        return @{ @"state": @"no_git" };
+    }
+    BOOL filesTruncated = NO;
+    NSData *status = [self outputOfGit:git
+                             arguments:@[ @"status", @"--porcelain=v1", @"--untracked-files=normal" ]
+                             workspace:workspace
+                                 limit:OmniNotificationFileListLimit
+                             truncated:&filesTruncated];
+    if (!status) {
+        return @{ @"state": @"not_a_repository" };
+    }
+    NSString *files = [OmniLossyString(status) stringByTrimmingCharactersInSet:NSCharacterSet.newlineCharacterSet];
+    if (!files.length) {
+        return @{ @"state": @"clean" };
+    }
+    BOOL diffTruncated = NO;
+    NSData *diff = [self outputOfGit:git
+                           arguments:@[ @"diff", @"HEAD", @"--no-ext-diff", @"--no-textconv", @"--no-color", @"--find-renames" ]
+                           workspace:workspace
+                               limit:OmniNotificationDiffLimit
+                           truncated:&diffTruncated];
+    if (!diff) {
+        return @{ @"state": @"failed", @"files": files };
+    }
+    [[NSFileManager defaultManager] createDirectoryAtPath:directory
+                              withIntermediateDirectories:YES
+                                               attributes:@{ NSFilePosixPermissions: @0700 }
+                                                    error:nil];
+    // Diffs may contain secrets.
+    if (![[NSFileManager defaultManager] createFileAtPath:path
+                                                 contents:diff
+                                               attributes:@{ NSFilePosixPermissions: @0600 }]) {
+        return @{ @"state": @"failed", @"files": files };
+    }
+    return @{ @"state": (diffTruncated || filesTruncated) ? @"truncated" : @"captured", @"path": path, @"files": files };
+}
+
+#pragma mark - Run reports
+
+// The scheduler is the only writer of a run's report. Runners send the final
+// message and summary; the repository facts are captured here, off the queue.
+
+static const NSUInteger OmniRunFinalMessageLimit = 4000;
+static const NSUInteger OmniRunSummaryLimit = 4000;
+static const NSUInteger OmniRunErrorLimit = 500;
+static const NSUInteger OmniRunCommitLimit = 50;
+static const NSInteger OmniRunListLimit = 500;
+static const NSInteger OmniRunDiffRetainedCount = 200;
+static const NSTimeInterval OmniRunDiffRetention = 30 * 24 * 60 * 60;
+
+static BOOL OmniIsObjectID(id value) {
+    if (![value isKindOfClass:[NSString class]]) {
+        return NO;
+    }
+    NSString *string = value;
+    if (string.length != 40 && string.length != 64) {
+        return NO;
+    }
+    NSCharacterSet *hex = [NSCharacterSet characterSetWithCharactersInString:@"0123456789abcdef"];
+    return [string rangeOfCharacterFromSet:hex.invertedSet].location == NSNotFound;
+}
+
+static NSString *OmniFirstLine(NSData *data) {
+    NSString *line = [[OmniLossyString(data) componentsSeparatedByString:@"\n"] firstObject];
+    line = [line stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    return line.length ? line : nil;
+}
+
+- (NSString *)runDiffsPath {
+    return [_supportPath stringByAppendingPathComponent:@"run-diffs"];
+}
+
+- (NSString *)ownedRunDiffPath:(id)value {
+    return OmniOwnedPath(value, [self runDiffsPath]);
+}
+
+- (NSDictionary *)publicRun:(NSDictionary *)row {
+    NSMutableDictionary *run = [[row mutableCopy] autorelease];
+    [run removeObjectForKey:@"diff_path"];
+    [run removeObjectForKey:@"agent_snapshot"];
+    [run removeObjectForKey:@"loop_agent"];
+    NSString *files = [row[@"diff_files"] isKindOfClass:[NSString class]] ? row[@"diff_files"] : nil;
+    run[@"diff_files"] = files.length ? [files componentsSeparatedByString:@"\n"] : @[];
+    NSData *commitData = [row[@"commits"] isKindOfClass:[NSString class]] ? [row[@"commits"] dataUsingEncoding:NSUTF8StringEncoding] : nil;
+    id commits = commitData ? [NSJSONSerialization JSONObjectWithData:commitData options:0 error:nil] : nil;
+    run[@"commits"] = [commits isKindOfClass:[NSArray class]] ? commits : @[];
+    return run;
+}
+
+- (NSDictionary *)invalidRunRequest:(NSString *)message {
+    return @{ @"ok": @NO, @"code": @"invalid_request", @"error": message };
+}
+
+- (NSDictionary *)runNotFound {
+    return @{ @"ok": @NO, @"code": @"run_not_found", @"error": @"Run not found" };
+}
+
+- (NSDictionary *)handleRunReportRequest:(NSDictionary *)request operation:(id)operation {
+    if (![operation isKindOfClass:[NSString class]]) {
+        return nil;
+    }
+    if ([operation isEqualToString:@"list_runs"]) {
+        // `name` is the older spelling of `agent`.
+        NSString *agent = OmniOptionalString(request[@"agent"], OmniNotificationFieldLimit) ?:
+                          OmniOptionalString(request[@"name"], OmniNotificationFieldLimit);
+        NSString *origin = OmniOptionalString(request[@"origin"], 32);
+        id limitValue = request[@"limit"];
+        id before = request[@"before"];
+        if ((limitValue && ![limitValue isKindOfClass:[NSNumber class]]) ||
+            (before && ![before isKindOfClass:[NSNumber class]])) {
+            return [self invalidRunRequest:@"limit and before must be numbers"];
+        }
+        const NSInteger limit = limitValue ? MAX(1, MIN(OmniRunListLimit, OmniIntegerValue(limitValue))) : 100;
+        NSMutableArray *clauses = [NSMutableArray array];
+        NSMutableArray *bindings = [NSMutableArray array];
+        if (agent) {
+            [clauses addObject:@"agent=?"];
+            [bindings addObject:agent];
+        }
+        if (origin) {
+            [clauses addObject:@"origin=?"];
+            [bindings addObject:origin];
+        }
+        // `foreground` leaves out OmniTerm's own background agents (the memory
+        // consolidator runs every 15 minutes and would crowd out everything else).
+        if ([request[@"foreground"] isEqual:@YES]) {
+            [clauses addObject:@"agent NOT IN (SELECT name FROM agents WHERE json_extract(definition,'$.omni_managed')=?)"];
+            [bindings addObject:OmniMemoryConsolidatorMarker];
+        }
+        // `loop_turns` keeps only each loop's newest recorded turns: a loop that
+        // ticks every few minutes would otherwise fill a page meant for every agent.
+        id loopTurns = request[@"loop_turns"];
+        if (loopTurns && (![loopTurns isKindOfClass:[NSNumber class]] || OmniIntegerValue(loopTurns) < 0)) {
+            return [self invalidRunRequest:@"loop_turns must be a non-negative number"];
+        }
+        if (loopTurns) {
+            [clauses addObject:[NSString stringWithFormat:@"(loop_parent IS NULL OR id IN (SELECT turn.id FROM runs turn WHERE turn.loop_parent=runs.loop_parent ORDER BY turn.started DESC LIMIT %ld))",
+                                (long)MIN(100, OmniIntegerValue(loopTurns))]];
+        }
+        if (before) {
+            [clauses addObject:@"started<?"];
+            [bindings addObject:before];
+        }
+        NSString *where = clauses.count ? [@" WHERE " stringByAppendingString:[clauses componentsJoinedByString:@" AND "]] : @"";
+        NSString *sql = [NSString stringWithFormat:@"SELECT * FROM runs%@ ORDER BY started DESC LIMIT %ld", where, (long)limit];
+        NSArray *rows = [self rowsForSQL:sql bindings:bindings];
+        // `include_live` adds every live run however old, so a page can always
+        // show what a live tab is doing; the limit applies to the rest.
+        if ([request[@"include_live"] isEqual:@YES]) {
+            NSString *liveWhere = [@" WHERE " stringByAppendingString:[[clauses arrayByAddingObject:@"state IN ('starting','running','evicting')"]
+                                                                        componentsJoinedByString:@" AND "]];
+            NSArray *live = [self rowsForSQL:[NSString stringWithFormat:@"SELECT * FROM runs%@", liveWhere] bindings:bindings];
+            NSMutableDictionary *byID = [NSMutableDictionary dictionary];
+            for (NSDictionary *row in [rows arrayByAddingObjectsFromArray:live]) byID[row[@"id"]] = row;
+            rows = [byID.allValues sortedArrayUsingDescriptors:@[ [NSSortDescriptor sortDescriptorWithKey:@"started" ascending:NO] ]];
+        }
+        NSMutableArray *runs = [NSMutableArray array];
+        for (NSDictionary *row in rows) {
+            [runs addObject:[self publicRun:row]];
+        }
+        return @{ @"ok": @YES, @"runs": runs };
+    }
+    if ([operation isEqualToString:@"run_screen"]) {
+        NSString *identifier = OmniOptionalString(request[@"id"], 64);
+        if (!OmniIsRunID(identifier)) {
+            return [self invalidRunRequest:@"A run id is required"];
+        }
+        if (![self rowsForSQL:@"SELECT id FROM runs WHERE id=?" bindings:@[ identifier ]].count) {
+            return [self runNotFound];
+        }
+        NSData *data = [NSData dataWithContentsOfFile:[self runScreenPathForRun:identifier]];
+        if (!data) {
+            return @{ @"ok": @NO, @"code": @"screen_not_found", @"error": @"No screen was saved for this run" };
+        }
+        NSString *contents = OmniLossyString(data);
+        const NSRange newline = [contents rangeOfString:@"\n"];
+        NSString *header = newline.location == NSNotFound ? @"" : [contents substringToIndex:newline.location];
+        if (![header hasPrefix:OmniRunScreenHeader]) {
+            return @{ @"ok": @NO, @"code": @"screen_not_found", @"error": @"No screen was saved for this run" };
+        }
+        return @{ @"ok": @YES,
+                  @"screen": [contents substringFromIndex:NSMaxRange(newline)],
+                  @"truncated": @([header hasSuffix:@"truncated=1"]) };
+    }
+    if ([operation isEqualToString:@"get_run"] || [operation isEqualToString:@"run_diff"]) {
+        NSString *identifier = OmniOptionalString(request[@"id"], 64);
+        if (!identifier) {
+            return [self invalidRunRequest:@"A run id is required"];
+        }
+        // With `turn_at`, the run as it was for that finished turn, even after
+        // a loop recorded the turn as a run of its own and went on.
+        identifier = [self reportRowForRun:identifier turnAt:request[@"turn_at"]];
+        NSDictionary *row = [self rowsForSQL:@"SELECT * FROM runs WHERE id=?" bindings:@[ identifier ]].firstObject;
+        if (!row) {
+            return [self runNotFound];
+        }
+        NSDictionary *run = [self publicRun:row];
+        if ([operation isEqualToString:@"get_run"]) {
+            return @{ @"ok": @YES, @"run": run };
+        }
+        NSString *path = [self ownedRunDiffPath:row[@"diff_path"]];
+        NSData *data = path ? [NSData dataWithContentsOfFile:path] : nil;
+        return @{ @"ok": @YES,
+                  @"diff": OmniLossyString(data),
+                  @"diff_state": row[@"diff_state"] ?: [NSNull null],
+                  @"diff_files": run[@"diff_files"],
+                  @"truncated": @([row[@"diff_state"] isEqual:@"truncated"]) };
+    }
+    if ([operation isEqualToString:@"runner_turn"]) {
+        id runID = request[@"run_id"];
+        if (![runID isKindOfClass:[NSString class]]) {
+            return [self invalidRunRequest:@"run_id must be a string"];
+        }
+        if (![request[@"finished"] isEqual:@YES]) {
+            [self runSQL:@"UPDATE runs SET turn_finished=0 WHERE id=?" bindings:@[ runID ]];
+            return @{ @"ok": @YES };
+        }
+        id turnAt = request[@"turn_at"];
+        if (turnAt && ![turnAt isKindOfClass:[NSNumber class]]) {
+            return [self invalidRunRequest:@"turn_at must be a number"];
+        }
+        NSString *finalMessage = OmniOptionalString(request[@"final_message"], OmniRunFinalMessageLimit);
+        NSString *transcriptPath = OmniOptionalString(request[@"transcript_path"], OmniNotificationFieldLimit);
+        const BOOL summaries = ![[self settings][@"summaries"] isEqual:@NO];
+        id null = [NSNull null];
+        // Each finished turn gets a fresh report: an earlier summary describes earlier work.
+        [self runSQL:@"UPDATE runs SET turn_finished=1,final_message=?,transcript_path=COALESCE(?,transcript_path),"
+                      "summary=NULL,summary_state=?,turn_at=?,report_updated=? WHERE id=?"
+            bindings:@[ finalMessage ?: null, transcriptPath ?: null, summaries ? @"pending" : @"off",
+                        turnAt ?: null, @([NSDate date].timeIntervalSince1970), runID ]];
+        if (sqlite3_changes(_database) > 0) {
+            [self captureEndOfRun:runID];
+            void (^screenHandler)(NSString *) = self.runScreenRequestHandler;
+            if (screenHandler && OmniIsRunID(runID)) {
+                NSString *identifier = [[runID copy] autorelease];
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    screenHandler(identifier);
+                });
+            }
+        }
+        return @{ @"ok": @YES };
+    }
+    if ([operation isEqualToString:@"run_summary"]) {
+        NSString *runID = OmniOptionalString(request[@"run_id"], 64);
+        id state = request[@"state"];
+        if (!runID || ![@[ @"ready", @"failed" ] containsObject:state ?: @""]) {
+            return [self invalidRunRequest:@"run_summary needs a run_id and a state of ready or failed"];
+        }
+        if ((request[@"summary"] && ![request[@"summary"] isKindOfClass:[NSString class]]) ||
+            (request[@"error"] && ![request[@"error"] isKindOfClass:[NSString class]])) {
+            return [self invalidRunRequest:@"summary and error must be strings"];
+        }
+        id turnAt = request[@"turn_at"];
+        if (turnAt && ![turnAt isKindOfClass:[NSNumber class]]) {
+            return [self invalidRunRequest:@"turn_at must be a number"];
+        }
+        NSString *summary = OmniOptionalString(request[@"summary"], OmniRunSummaryLimit);
+        if ([state isEqual:@"ready"] && !summary) {
+            return [self invalidRunRequest:@"A ready summary must not be empty"];
+        }
+        runID = [self reportRowForRun:runID turnAt:turnAt];
+        NSDictionary *row = [self rowsForSQL:@"SELECT summary_state,turn_at FROM runs WHERE id=?" bindings:@[ runID ]].firstObject;
+        if (!row) {
+            return [self runNotFound];
+        }
+        // Only the summary the latest finished turn asked for is accepted; a
+        // late one from an earlier turn, or one nobody asked for, is dropped.
+        const BOOL earlierTurn = turnAt && [row[@"turn_at"] isKindOfClass:[NSNumber class]] &&
+                                 [turnAt doubleValue] < [row[@"turn_at"] doubleValue];
+        if (earlierTurn || ![row[@"summary_state"] isEqual:@"pending"]) {
+            return @{ @"ok": @YES, @"ignored": @YES };
+        }
+        if ([state isEqual:@"failed"]) {
+            NSLog(@"OmniScheduler: no summary for run %@: %@", runID,
+                  OmniOptionalString(request[@"error"], OmniRunErrorLimit) ?: @"no reason given");
+        }
+        [self runSQL:@"UPDATE runs SET summary_state=?,summary=?,report_updated=? WHERE id=? AND summary_state='pending'"
+            bindings:@[ state, [state isEqual:@"ready"] ? summary : [NSNull null], @([NSDate date].timeIntervalSince1970), runID ]];
+        return @{ @"ok": @YES };
+    }
+    return nil;
+}
+
+- (NSString *)workspaceOfRun:(NSDictionary *)run {
+    NSString *workspace = [run[@"workspace"] isKindOfClass:[NSString class]] ? run[@"workspace"] : nil;
+    if (!workspace.length && [run[@"agent"] isKindOfClass:[NSString class]]) {
+        // Runs started before reports existed have no snapshot.
+        NSDictionary *row = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ run[@"agent"] ]].firstObject;
+        NSDictionary *agent = row ? [self decodedAgentRow:row] : nil;
+        workspace = [agent[@"workspace"] isKindOfClass:[NSString class]] ? agent[@"workspace"] : nil;
+    }
+    return workspace.length ? [workspace stringByExpandingTildeInPath] : nil;
+}
+
+- (void)captureStartOfRun:(NSString *)runID workspace:(NSString *)workspace {
+    if (!workspace.length) {
+        return;
+    }
+    NSString *identifier = [[runID copy] autorelease];
+    NSString *workspacePath = [[workspace copy] autorelease];
+    dispatch_async(_captureQueue, ^{
+        NSString *git = [OmniScheduler gitExecutable];
+        NSDictionary *head = git ? [OmniScheduler headOfWorkspace:workspacePath git:git] : nil;
+        if (!head.count) {
+            return;
+        }
+        dispatch_async(self->_queue, ^{
+            if (!self->_database) {
+                return;
+            }
+            [self runSQL:@"UPDATE runs SET head_start=COALESCE(head_start,?),branch=COALESCE(?,branch),report_updated=? WHERE id=?"
+                bindings:@[ head[@"head"] ?: [NSNull null], head[@"branch"] ?: [NSNull null],
+                            @([NSDate date].timeIntervalSince1970), identifier ]];
+        });
+    });
+}
+
+// Captures where the run left the repository: its head, the commits it made and
+// everything that changed since it started, committed or not.
+- (void)captureEndOfRun:(NSString *)runID {
+    NSDictionary *run = [self rowsForSQL:@"SELECT * FROM runs WHERE id=?" bindings:@[ runID ?: @"" ]].firstObject;
+    if (!run) {
+        return;
+    }
+    NSString *workspace = [self workspaceOfRun:run];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    if (!workspace) {
+        [self runSQL:@"UPDATE runs SET diff_state='none',report_updated=? WHERE id=?" bindings:@[ @(now), runID ]];
+        return;
+    }
+    [self runSQL:@"UPDATE runs SET diff_state='pending',report_updated=? WHERE id=?" bindings:@[ @(now), runID ]];
+    NSString *directory = [self runDiffsPath];
+    NSCharacterSet *unsafe = [[NSCharacterSet characterSetWithCharactersInString:
+                               @"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-"] invertedSet];
+    NSString *candidate = [directory stringByAppendingPathComponent:[runID stringByAppendingPathExtension:@"diff"]];
+    NSString *path = ([runID rangeOfCharacterFromSet:unsafe].location == NSNotFound) ? [self ownedRunDiffPath:candidate] : nil;
+    NSString *identifier = [[runID copy] autorelease];
+    // A loop may go on to its next turn while this runs; the capture then
+    // belongs to the row the finished turn was recorded in.
+    NSNumber *turnAt = [run[@"turn_at"] isKindOfClass:[NSNumber class]] ? [[run[@"turn_at"] retain] autorelease] : nil;
+    dispatch_async(_captureQueue, ^{
+        // Read here rather than earlier, so a start capture that was still
+        // running when the run ended has written its head first.
+        __block NSString *headStart = nil;
+        dispatch_sync(self->_queue, ^{
+            if (self->_database) {
+                NSString *row = [self reportRowForRun:identifier turnAt:turnAt];
+                id value = [(NSDictionary *)[self rowsForSQL:@"SELECT head_start FROM runs WHERE id=?" bindings:@[ row ]].firstObject
+                            objectForKey:@"head_start"];
+                headStart = OmniIsObjectID(value) ? [value copy] : nil;
+            }
+        });
+        [headStart autorelease];
+        NSDictionary *result = [OmniScheduler capturedEndOfWorkspace:workspace
+                                                           headStart:headStart
+                                                                path:path
+                                                           directory:directory];
+        dispatch_async(self->_queue, ^{
+            if (!self->_database) {
+                return;
+            }
+            id null = [NSNull null];
+            NSString *target = [self reportRowForRun:identifier turnAt:turnAt];
+            NSString *capturedPath = result[@"path"];
+            if (![target isEqualToString:identifier] && capturedPath) {
+                NSString *moved = [self ownedRunDiffPath:[[self runDiffsPath] stringByAppendingPathComponent:[target stringByAppendingPathExtension:@"diff"]]];
+                [[NSFileManager defaultManager] removeItemAtPath:moved error:nil];
+                capturedPath = moved && [[NSFileManager defaultManager] moveItemAtPath:capturedPath toPath:moved error:nil] ? moved : nil;
+            }
+            NSString *commits = nil;
+            if (result[@"commits"]) {
+                NSData *data = [NSJSONSerialization dataWithJSONObject:result[@"commits"] options:0 error:nil];
+                commits = [[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease];
+            }
+            [self runSQL:@"UPDATE runs SET head_end=COALESCE(?,head_end),branch=COALESCE(?,branch),commits=?,"
+                          "diff_state=?,diff_path=?,diff_files=?,report_updated=? WHERE id=?"
+                bindings:@[ result[@"head"] ?: null, result[@"branch"] ?: null, commits ?: null, result[@"state"],
+                            capturedPath ?: null, result[@"files"] ?: null, @([NSDate date].timeIntervalSince1970),
+                            target ]];
+            if ([target isEqualToString:identifier] && path && (!result[@"path"] || sqlite3_changes(self->_database) == 0)) {
+                // Nothing references an earlier capture of this run any more.
+                [[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+            }
+            [self pruneRunDiffs];
+        });
+    });
+}
+
++ (NSDictionary *)headOfWorkspace:(NSString *)workspace git:(NSString *)git {
+    BOOL ignored = NO;
+    NSMutableDictionary *head = [NSMutableDictionary dictionary];
+    NSString *sha = OmniFirstLine([self outputOfGit:git
+                                          arguments:@[ @"rev-parse", @"--verify", @"-q", @"HEAD" ]
+                                          workspace:workspace
+                                              limit:1024
+                                          truncated:&ignored]);
+    if (OmniIsObjectID(sha)) {
+        head[@"head"] = sha;
+    }
+    // Fails on a detached head, which has no branch to name.
+    NSString *branch = OmniFirstLine([self outputOfGit:git
+                                             arguments:@[ @"symbolic-ref", @"--short", @"-q", @"HEAD" ]
+                                             workspace:workspace
+                                                 limit:1024
+                                             truncated:&ignored]);
+    if (branch) {
+        head[@"branch"] = branch;
+    }
+    return head;
+}
+
++ (NSDictionary *)capturedEndOfWorkspace:(NSString *)workspace
+                               headStart:(NSString *)headStart
+                                    path:(NSString *)path
+                               directory:(NSString *)directory {
+    BOOL isDirectory = NO;
+    NSString *git = [self gitExecutable];
+    if (![[NSFileManager defaultManager] fileExistsAtPath:workspace isDirectory:&isDirectory] || !isDirectory || !git) {
+        return @{ @"state": @"none" };
+    }
+    BOOL ignored = NO;
+    if (![self outputOfGit:git arguments:@[ @"rev-parse", @"--git-dir" ] workspace:workspace limit:4096 truncated:&ignored]) {
+        return @{ @"state": @"none" };
+    }
+    NSMutableDictionary *result = [NSMutableDictionary dictionaryWithDictionary:[self headOfWorkspace:workspace git:git]];
+    NSString *headEnd = result[@"head"];
+    if (headStart && headEnd) {
+        NSData *log = [self outputOfGit:git
+                              arguments:@[ @"log", @"--no-show-signature", @"--no-color", @"--format=%H%x09%s",
+                                           [NSString stringWithFormat:@"-n%lu", (unsigned long)OmniRunCommitLimit],
+                                           [NSString stringWithFormat:@"%@..%@", headStart, headEnd], @"--" ]
+                              workspace:workspace
+                                  limit:OmniNotificationFileListLimit
+                              truncated:&ignored];
+        if (log) {
+            NSMutableArray *commits = [NSMutableArray array];
+            for (NSString *line in [OmniLossyString(log) componentsSeparatedByString:@"\n"]) {
+                const NSRange tab = [line rangeOfString:@"\t"];
+                if (tab.location == NSNotFound || !OmniIsObjectID([line substringToIndex:tab.location])) {
+                    continue;
+                }
+                [commits addObject:@{ @"sha": [line substringToIndex:tab.location],
+                                      @"subject": [line substringFromIndex:NSMaxRange(tab)] }];
+            }
+            result[@"commits"] = commits;
+        }
+    }
+    // Without a start head, show what is uncommitted, as a notification does.
+    NSString *base = headStart ?: (headEnd ?: OmniEmptyTreeObjectID);
+    BOOL filesTruncated = NO;
+    NSData *changed = [self outputOfGit:git
+                              arguments:@[ @"diff", @"--name-only", @"--no-ext-diff", @"--no-textconv", @"--find-renames", base, @"--" ]
+                              workspace:workspace
+                                  limit:OmniNotificationFileListLimit
+                              truncated:&filesTruncated];
+    NSData *untracked = [self outputOfGit:git
+                                arguments:@[ @"ls-files", @"--others", @"--exclude-standard", @"--full-name" ]
+                                workspace:workspace
+                                    limit:OmniNotificationFileListLimit
+                                truncated:&filesTruncated];
+    if (!changed) {
+        result[@"state"] = @"failed";
+        return result;
+    }
+    NSMutableOrderedSet *files = [NSMutableOrderedSet orderedSet];
+    for (NSData *data in @[ changed, untracked ?: [NSData data] ]) {
+        for (NSString *line in [OmniLossyString(data) componentsSeparatedByString:@"\n"]) {
+            if (line.length) {
+                [files addObject:line];
+            }
+        }
+    }
+    if (!files.count) {
+        result[@"state"] = @"clean";
+        return result;
+    }
+    result[@"files"] = [files.array componentsJoinedByString:@"\n"];
+    BOOL diffTruncated = NO;
+    NSData *diff = [self outputOfGit:git
+                           arguments:@[ @"diff", @"--no-ext-diff", @"--no-textconv", @"--no-color", @"--find-renames", base, @"--" ]
+                           workspace:workspace
+                               limit:OmniNotificationDiffLimit
+                           truncated:&diffTruncated];
+    if (!diff || !path) {
+        result[@"state"] = @"failed";
+        return result;
+    }
+    [[NSFileManager defaultManager] createDirectoryAtPath:directory
+                              withIntermediateDirectories:YES
+                                               attributes:@{ NSFilePosixPermissions: @0700 }
+                                                    error:nil];
+    // Diffs may contain secrets.
+    if (![[NSFileManager defaultManager] createFileAtPath:path
+                                                 contents:diff
+                                               attributes:@{ NSFilePosixPermissions: @0600 }]) {
+        result[@"state"] = @"failed";
+        return result;
+    }
+    chmod(path.fileSystemRepresentation, 0600);
+    result[@"path"] = path;
+    result[@"state"] = (diffTruncated || filesTruncated) ? @"truncated" : @"captured";
+    return result;
+}
+
+#pragma mark - Run screens
+
+- (NSString *)runScreensPath {
+    return [_supportPath stringByAppendingPathComponent:@"run-screens"];
+}
+
+- (NSString *)runScreenPathForRun:(NSString *)runID {
+    NSString *path = [[self runScreensPath] stringByAppendingPathComponent:[runID stringByAppendingPathExtension:@"ansi"]];
+    return OmniOwnedPath(path, [self runScreensPath]);
+}
+
+- (void)storeScreen:(NSString *)screen truncated:(BOOL)truncated forRun:(NSString *)runID {
+    if (!OmniIsRunID(runID) || ![screen isKindOfClass:[NSString class]]) {
+        return;
+    }
+    NSString *identifier = [[runID copy] autorelease];
+    NSString *text = [[screen copy] autorelease];
+    dispatch_async(_queue, ^{
+        [self writeScreen:text truncated:truncated forRun:identifier];
+    });
+}
+
+- (BOOL)writeScreen:(NSString *)screen truncated:(BOOL)truncated forRun:(NSString *)runID {
+    if (!OmniIsRunID(runID) ||
+        ![self rowsForSQL:@"SELECT id FROM runs WHERE id=?" bindings:@[ runID ]].count) {
+        return NO;
+    }
+    NSString *path = [self runScreenPathForRun:runID];
+    if (!path) {
+        return NO;
+    }
+    NSData *body = [screen dataUsingEncoding:NSUTF8StringEncoding] ?: [NSData data];
+    if (body.length > OmniRunScreenByteLimit) {
+        // Keep the end: the last lines matter most. Cut at a line start so no
+        // escape sequence or character is split.
+        NSData *tail = [body subdataWithRange:NSMakeRange(body.length - OmniRunScreenByteLimit, OmniRunScreenByteLimit)];
+        const NSRange newline = [tail rangeOfData:[NSData dataWithBytes:"\n" length:1] options:0 range:NSMakeRange(0, tail.length)];
+        body = newline.location == NSNotFound ? [NSData data] : [tail subdataWithRange:NSMakeRange(NSMaxRange(newline), tail.length - NSMaxRange(newline))];
+        truncated = YES;
+    }
+    NSMutableData *data = [NSMutableData data];
+    NSString *header = [NSString stringWithFormat:@"%@ truncated=%d\n", OmniRunScreenHeader, truncated ? 1 : 0];
+    [data appendData:[header dataUsingEncoding:NSUTF8StringEncoding]];
+    [data appendData:body];
+    [[NSFileManager defaultManager] createDirectoryAtPath:[self runScreensPath]
+                              withIntermediateDirectories:YES
+                                               attributes:@{ NSFilePosixPermissions: @0700 }
+                                                    error:nil];
+    // Terminal contents may include secrets.
+    if (![data writeToFile:path options:NSDataWritingAtomic error:nil]) {
+        return NO;
+    }
+    chmod(path.fileSystemRepresentation, 0600);
+    [self pruneRunScreens];
+    return YES;
+}
+
+// Same retention as run diffs: 30 days, and only the newest 200.
+- (void)pruneRunScreens {
+    NSString *directory = [self runScreensPath];
+    NSFileManager *fileManager = [NSFileManager defaultManager];
+    NSMutableArray<NSDictionary *> *screens = [NSMutableArray array];
+    for (NSString *name in [fileManager contentsOfDirectoryAtPath:directory error:nil]) {
+        if (![name.pathExtension isEqualToString:@"ansi"] || !OmniIsRunID(name.stringByDeletingPathExtension)) {
+            continue;
+        }
+        NSString *path = OmniOwnedPath([directory stringByAppendingPathComponent:name], directory);
+        NSDate *modified = [fileManager attributesOfItemAtPath:path error:nil].fileModificationDate;
+        if (path && modified) {
+            [screens addObject:@{ @"path": path, @"modified": modified }];
+        }
+    }
+    [screens sortUsingDescriptors:@[ [NSSortDescriptor sortDescriptorWithKey:@"modified" ascending:NO] ]];
+    NSDate *cutoff = [NSDate dateWithTimeIntervalSinceNow:-OmniRunDiffRetention];
+    [screens enumerateObjectsUsingBlock:^(NSDictionary *screen, NSUInteger index, BOOL *stop) {
+        if (index >= (NSUInteger)OmniRunDiffRetainedCount || [screen[@"modified"] compare:cutoff] == NSOrderedAscending) {
+            [fileManager removeItemAtPath:screen[@"path"] error:nil];
+        }
+    }];
+}
+
+// Run rows are kept; only their stored diffs expire, like notification diffs.
+- (void)pruneRunDiffs {
+    const NSTimeInterval cutoff = [NSDate date].timeIntervalSince1970 - OmniRunDiffRetention;
+    NSString *sql = [NSString stringWithFormat:@"SELECT id,diff_path FROM runs WHERE diff_path IS NOT NULL AND (started < ? "
+                     "OR id NOT IN (SELECT id FROM runs WHERE diff_path IS NOT NULL ORDER BY started DESC LIMIT %ld))",
+                     (long)OmniRunDiffRetainedCount];
+    for (NSDictionary *row in [self rowsForSQL:sql bindings:@[ @(cutoff) ]]) {
+        NSString *path = [self ownedRunDiffPath:row[@"diff_path"]];
+        if (path) {
+            [[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+        }
+        [self runSQL:@"UPDATE runs SET diff_path=NULL,diff_state='expired' WHERE id=?" bindings:@[ row[@"id"] ]];
+    }
+}
+
+- (BOOL)providerSessionHasNoLiveProcess:(NSString *)sessionID {
+    // A replaced run becomes terminal before its supervisor's grace period
+    // ends. Database state alone cannot establish exclusive session ownership.
+    for (NSDictionary *run in [self rowsForSQL:@"SELECT pgid FROM runs WHERE session_id=? OR resume_session_id=?" bindings:@[ sessionID, sessionID ]]) {
+        pid_t processGroup = (pid_t)OmniIntegerValue(run[@"pgid"]);
+        if (processGroup > 1 && (kill(-processGroup, 0) == 0 || errno != ESRCH)) return NO;
+    }
+    return YES;
+}
+
+- (NSDictionary *)startAgentNamed:(NSString *)name reason:(NSString *)reason resumeSessionID:(NSString *)resumeSessionID {
+    NSArray *rows = [self rowsForSQL:@"SELECT * FROM agents WHERE name=?" bindings:@[ name ?: @"" ]];
+    if (!rows.count) return @{ @"ok": @NO, @"error": @"Agent not found" };
+    NSDictionary *agent = [self decodedAgentRow:rows.firstObject];
+    NSString *workspace = [agent[@"workspace"] isKindOfClass:[NSString class]] ? [agent[@"workspace"] stringByExpandingTildeInPath] : nil;
+    NSString *provider = [agent[@"provider"] isKindOfClass:[NSString class]] ? agent[@"provider"] : nil;
+    const BOOL loop = [agent[@"kind"] isEqual:@"loop"];
+    if (loop) {
+        // A cadence is another turn in the same run, never another terminal.
+        // Busy ticks collapse into one durable request for the runner to claim
+        // when its provider becomes idle. Manual Run Now follows this rule too.
+        NSDictionary *current = [self rowsForSQL:@"SELECT * FROM runs WHERE agent=? AND state IN ('starting','running','evicting') ORDER BY CASE WHEN turn_finished=1 THEN 1 ELSE 0 END,started ASC LIMIT 1" bindings:@[ name ]].firstObject;
+        if (current) {
+            if (![current[@"workspace"] isEqual:workspace] || ![current[@"provider"] isEqual:provider]) return @{ @"ok": @NO, @"error": @"Stop the existing loop before changing its workspace or provider" };
+            NSString *snapshotJSON = [current[@"agent_snapshot"] isKindOfClass:NSString.class] ? current[@"agent_snapshot"] : nil;
+            NSDictionary *snapshot = snapshotJSON ? [NSJSONSerialization JSONObjectWithData:[snapshotJSON dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil] : nil;
+            if ([snapshot isKindOfClass:NSDictionary.class] &&
+                (![(snapshot[@"system_prompt"] ?: @"") isEqual:(agent[@"system_prompt"] ?: @"")] ||
+                 ![(snapshot[@"model"] ?: @"") isEqual:(agent[@"model"] ?: @"")])) return @{ @"ok": @NO, @"error": @"Stop the existing loop before changing its system prompt or model" };
+            if (![current[@"loop_token"] isKindOfClass:NSString.class]) {
+                [self runSQL:@"UPDATE runs SET loop_token=?,loop_state='pending',loop_agent=? WHERE id=?"
+                    bindings:@[ NSUUID.UUID.UUIDString.lowercaseString, [self definitionJSONForAgent:agent], current[@"id"] ]];
+            }
+            return @{ @"ok": @YES, @"run_id": current[@"id"], @"coalesced": @YES };
+        }
+    }
+    if (resumeSessionID && [self rowsForSQL:@"SELECT id FROM runs WHERE state IN ('starting','running','evicting') AND (session_id=? OR resume_session_id=?) LIMIT 1" bindings:@[ resumeSessionID, resumeSessionID ]].count) {
+        return @{ @"ok": @NO, @"error": @"This provider session is still in use" };
+    }
+    if (resumeSessionID && ![self providerSessionHasNoLiveProcess:resumeSessionID]) {
+        return @{ @"ok": @NO, @"error": @"This provider session still has a live process" };
+    }
+    if (loop && resumeSessionID) {
+        NSDictionary *prior = [self rowsForSQL:@"SELECT turn_finished FROM runs WHERE session_id=? ORDER BY started DESC LIMIT 1" bindings:@[ resumeSessionID ]].firstObject;
+        if (OmniIntegerValue(prior[@"turn_finished"]) != 1) return @{ @"ok": @NO, @"error": @"Only an idle loop session can be resumed" };
+    }
+    if (!resumeSessionID && ![agent[@"session_policy"] isEqual:@"fresh"] && workspace && provider) {
+        // A session is exclusively owned by its live run. Parallel occurrences
+        // may reuse another completed session, or start fresh when all are busy.
+        NSArray *candidates = [self rowsForSQL:@"SELECT r.session_id,r.agent_snapshot,r.turn_finished FROM runs r WHERE r.agent=? AND r.workspace=? AND r.provider=? AND r.finished IS NOT NULL AND r.session_id IS NOT NULL AND r.session_id!='' AND r.state NOT IN ('starting','running','evicting') AND r.loop_parent IS NULL AND NOT EXISTS (SELECT 1 FROM runs active WHERE active.state IN ('starting','running','evicting') AND (active.session_id=r.session_id OR active.resume_session_id=r.session_id)) ORDER BY r.finished DESC"
+                                     bindings:@[ name, workspace, provider ]];
+        // A loop whose turn was cut short (relaunch, provider crash) still
+        // continues its one session: a new row resumes it and resends the task.
+        for (NSDictionary *previous in candidates) {
+            NSString *candidate = previous[@"session_id"];
+            NSString *snapshotJSON = [previous[@"agent_snapshot"] isKindOfClass:[NSString class]] ? previous[@"agent_snapshot"] : nil;
+            NSDictionary *snapshot = snapshotJSON ? [NSJSONSerialization JSONObjectWithData:[snapshotJSON dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil] : nil;
+            // Resuming may retain provider-side instructions. Without a matching
+            // snapshot, start fresh rather than silently keeping an old policy.
+            if (![snapshot isKindOfClass:[NSDictionary class]] ||
+                ![(snapshot[@"system_prompt"] ?: @"") isEqual:(agent[@"system_prompt"] ?: @"")] ||
+                ![(snapshot[@"model"] ?: @"") isEqual:(agent[@"model"] ?: @"")]) continue;
+            if ([candidate isKindOfClass:[NSString class]] && [self providerSessionHasNoLiveProcess:candidate]) {
+                resumeSessionID = candidate;
+                break;
+            }
+        }
+    }
+    NSArray *active = [self rowsForSQL:@"SELECT id,pgid FROM runs WHERE agent=? AND state IN ('starting','running')" bindings:@[ name ]];
+    if (![agent[@"kind"] isEqual:@"loop"] && [agent[@"overlap"] isEqualToString:@"replace"]) {
+        for (NSDictionary *run in active) {
+            const pid_t processGroup = (pid_t)OmniIntegerValue(run[@"pgid"]);
+            if (processGroup > 1) {
+                kill(-processGroup, SIGTERM);
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC), _queue, ^{
+                    if (kill(-processGroup, 0) == 0) kill(-processGroup, SIGKILL);
+                });
+            }
+            [self runSQL:@"UPDATE runs SET state='replaced',reason='replaced',finished=? WHERE id=?"
+                bindings:@[ @([NSDate date].timeIntervalSince1970), run[@"id"] ]];
+        }
+    }
+    // An idle loop whose supervisor has exited resumes in its original row.
+    // Interrupted work is never silently resumed as an idle turn.
+    NSDictionary *idleLoop = nil;
+    if (loop && resumeSessionID) {
+        for (NSDictionary *candidate in [self rowsForSQL:@"SELECT * FROM runs WHERE agent=? AND session_id=? AND turn_finished=1 AND finished IS NOT NULL AND loop_parent IS NULL ORDER BY finished DESC" bindings:@[ name, resumeSessionID ]]) {
+            NSString *json = [candidate[@"agent_snapshot"] isKindOfClass:NSString.class] ? candidate[@"agent_snapshot"] : nil;
+            NSDictionary *snapshot = json ? [NSJSONSerialization JSONObjectWithData:[json dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil] : nil;
+            if ([snapshot[@"kind"] isEqual:@"loop"]) { idleLoop = candidate; break; }
+        }
+    }
+    NSString *runID = idleLoop[@"id"] ?: NSUUID.UUID.UUIDString.lowercaseString;
+    NSString *sessionID = resumeSessionID ?: ([agent[@"provider"] isEqualToString:@"claude"] ? runID : nil);
+    if (idleLoop) {
+        [self runSQL:@"UPDATE runs SET state='starting',reason=?,started=?,finished=NULL,pid=NULL,pgid=NULL,turn_finished=0,resume_session_id=?,loop_token=NULL,loop_state=NULL,loop_agent=NULL,wrap_up_input=NULL,compact_input=NULL,finish_input=NULL WHERE id=?"
+            bindings:@[ reason, @([NSDate date].timeIntervalSince1970), resumeSessionID, runID ]];
+    } else {
+        [self runSQL:@"INSERT INTO runs(id,agent,state,reason,started,session_id,resume_session_id,workspace,provider) VALUES(?,?,'starting',?,?,?,?,?,?)"
+        bindings:@[ runID, name, reason, @([NSDate date].timeIntervalSince1970), sessionID ?: [NSNull null], resumeSessionID ?: [NSNull null],
+                    workspace ?: [NSNull null], provider ?: [NSNull null] ]];
+    }
+    [self runSQL:@"UPDATE runs SET agent_snapshot=? WHERE id=?" bindings:@[ [self definitionJSONForAgent:agent], runID ]];
+    [self captureStartOfRun:runID workspace:workspace];
+    NSString *runner = [NSBundle.mainBundle pathForResource:@"omni-runner" ofType:nil inDirectory:@"Helpers"];
+    NSString *escapedRunner = [runner stringByReplacingOccurrencesOfString:@"'" withString:@"'\\''"];
+    NSString *command = [NSString stringWithFormat:@"'%@' %@", escapedRunner, runID];
+    NSString *title = [NSString stringWithFormat:@"AGENT · %@%@", name, resumeSessionID ? @" ↻" : @""];
+    // Same test as the app's OmniBackgroundAgents: its runs are housekeeping.
+    const BOOL background = [agent[@"omni_managed"] isEqual:OmniMemoryConsolidatorMarker] ||
+        [agent[@"omni_managed"] isEqual:OmniSessionUnblockerMarker];
+    OmniSchedulerLaunchHandler launchHandler = self.launchHandler;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        launchHandler(command, title, runID, name, background);
+    });
+    [self enforceRunRetention];
+    return @{ @"ok": @YES, @"run_id": runID };
+}
+
+// A loop keeps one live run, tab and provider session, but each turn it finishes
+// is recorded as a run of its own, so history shows every turn. Called inside
+// the transaction that acknowledges the next turn: the finished turn's report
+// moves to a new completed row and the live run starts afresh.
+- (BOOL)recordFinishedLoopTurnOfRun:(NSDictionary *)run {
+    // `turn_at` marks a turn that finished since the last acknowledgement. The
+    // runner may already have reported the next turn starting (turn_finished=0)
+    // by the time it acknowledges it, so that flag cannot decide.
+    if (![run[@"turn_at"] isKindOfClass:[NSNumber class]]) return YES;
+    NSString *runID = run[@"id"];
+    NSString *turnID = NSUUID.UUID.UUIDString.lowercaseString;
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    id null = [NSNull null];
+    NSNumber *turnAt = [run[@"turn_at"] isKindOfClass:[NSNumber class]] ? run[@"turn_at"] : nil;
+    NSFileManager *files = [NSFileManager defaultManager];
+    // Files are named by run: the turn takes its diff and keeps a copy of its last screen.
+    NSString *diffPath = [self ownedRunDiffPath:run[@"diff_path"]];
+    NSString *turnDiffPath = nil;
+    if (diffPath) {
+        NSString *candidate = [self ownedRunDiffPath:[[self runDiffsPath] stringByAppendingPathComponent:[turnID stringByAppendingPathExtension:@"diff"]]];
+        if (candidate && [files moveItemAtPath:diffPath toPath:candidate error:nil]) turnDiffPath = candidate;
+    }
+    id diffState = diffPath && !turnDiffPath ? @"expired" : (run[@"diff_state"] ?: null);
+    if (![self runSQL:@"INSERT INTO runs(id,agent,state,reason,started,finished,session_id,turn_finished,origin,workspace,provider,"
+                       "transcript_path,branch,head_start,head_end,commits,final_message,summary,summary_state,diff_state,diff_path,"
+                       "diff_files,pr_url,report_updated,turn_at,agent_snapshot,loop_parent) "
+                       "SELECT ?,agent,'completed',?,started,?,session_id,1,origin,workspace,provider,transcript_path,branch,head_start,"
+                       "head_end,commits,final_message,summary,summary_state,?,?,diff_files,pr_url,?,turn_at,agent_snapshot,id "
+                       "FROM runs WHERE id=?"
+             bindings:@[ turnID, OmniLoopTurnReason, turnAt ?: @(now), diffState, turnDiffPath ?: null, @(now), runID ]]) {
+        if (turnDiffPath) [files moveItemAtPath:turnDiffPath toPath:diffPath error:nil];
+        return NO;
+    }
+    NSString *screen = [self runScreenPathForRun:runID];
+    NSString *turnScreen = [self runScreenPathForRun:turnID];
+    if (screen && turnScreen && [files fileExistsAtPath:screen]) [files copyItemAtPath:screen toPath:turnScreen error:nil];
+    // What the agent reported during that turn belongs to it.
+    [self runSQL:@"UPDATE notifications SET run_id=? WHERE run_id=? AND created>=?"
+        bindings:@[ turnID, runID, run[@"started"] ?: @0 ]];
+    return [self runSQL:@"UPDATE runs SET started=?,head_start=NULL,head_end=NULL,commits=NULL,final_message=NULL,summary=NULL,"
+                         "summary_state=NULL,diff_state=NULL,diff_path=NULL,diff_files=NULL,pr_url=NULL,turn_at=NULL,report_updated=? WHERE id=?"
+               bindings:@[ @(now), @(now), runID ]];
+}
+
+// A report for a loop turn can arrive after the loop went on to its next turn:
+// it belongs to the row that turn was recorded in.
+- (NSString *)reportRowForRun:(NSString *)runID turnAt:(id)turnAt {
+    if (![turnAt isKindOfClass:[NSNumber class]] || !runID) return runID;
+    NSDictionary *turn = [self rowsForSQL:@"SELECT id FROM runs WHERE loop_parent=? AND turn_at=?" bindings:@[ runID, turnAt ]].firstObject;
+    return [turn[@"id"] isKindOfClass:[NSString class]] ? turn[@"id"] : runID;
+}
+
+// Retention closes idle sessions too. A run whose agent had finished its turn
+// is completed whatever ends its session afterwards; only unfinished work was evicted.
+static NSArray<NSString *> *OmniEvictionOutcome(NSDictionary *run) {
+    if (OmniIntegerValue(run[@"turn_finished"]) == 1) {
+        return @[ @"completed", OmniRetentionCompletedReason ];
+    }
+    return @[ @"evicted", @"retention age" ];
+}
+
+- (void)enforceRunRetention {
+    // Only live runs have tabs. A finished run's tab closed when its runner
+    // exited, so its recorded PID may already belong to another process.
+    NSArray *rows = [self rowsForSQL:@"SELECT runs.id,runs.pgid,runs.started,runs.turn_finished,runs.compact_input,COALESCE(runs.agent_snapshot,agents.definition) AS definition FROM runs JOIN agents ON agents.name=runs.agent WHERE runs.state IN ('starting','running') ORDER BY runs.started DESC"
+                             bindings:@[]];
+    const NSInteger configuredRetention = OmniIntegerValue([self settings][@"retained_run_tabs"]);
+    const NSUInteger retainedCount = MAX(1, MIN(100, configuredRetention > 0 ? configuredRetention : 10));
+    if (rows.count <= retainedCount) return;
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    for (NSUInteger index = retainedCount; index < rows.count; index++) {
+        NSDictionary *run = rows[index];
+        NSDictionary *agent = [NSJSONSerialization JSONObjectWithData:[run[@"definition"] dataUsingEncoding:NSUTF8StringEncoding]
+                                                               options:0
+                                                                 error:nil];
+        NSNumber *timeout = agent[@"timeout_seconds"];
+        // A persistent loop is one long-lived run, including its idle gaps.
+        // Retention must not tear it down and create a new row every day.
+        if ([agent[@"kind"] isEqual:@"loop"]) continue;
+        if (![timeout isKindOfClass:[NSNumber class]] ||
+            now - OmniDoubleValue(run[@"started"]) < timeout.doubleValue) {
+            continue;
+        }
+        const pid_t processGroup = (pid_t)OmniIntegerValue(run[@"pgid"]);
+        if (processGroup <= 1) continue;
+        kill(-processGroup, SIGTERM);
+        [self runSQL:@"UPDATE runs SET state='evicting',reason='retention age' WHERE id=?"
+            bindings:@[ run[@"id"] ]];
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC), _queue, ^{
+            if (kill(-processGroup, 0) == 0) kill(-processGroup, SIGKILL);
+        });
+    }
+}
+
+- (void)reapAbandonedRuns {
+    NSArray *rows = [self rowsForSQL:@"SELECT id,pid,started,state,turn_finished FROM runs WHERE state IN ('starting','running','evicting')"
+                             bindings:@[]];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    for (NSDictionary *run in rows) {
+        const pid_t runnerPID = (pid_t)OmniIntegerValue(run[@"pid"]);
+        NSString *state = nil;
+        NSString *reason = nil;
+        if (runnerPID > 1) {
+            if (kill(runnerPID, 0) == 0 || errno != ESRCH) continue;
+            // The runner cannot report through a reboot or a killed app, and an
+            // interactive provider idles after finishing. Losing it is not a failure.
+            if ([run[@"state"] isEqualToString:@"evicting"]) {
+                NSArray *outcome = OmniEvictionOutcome(run);
+                state = outcome[0];
+                reason = outcome[1];
+            } else if (OmniIntegerValue(run[@"turn_finished"]) == 1) {
+                state = @"completed";
+                reason = @"agent finished, then its session was lost";
+            } else {
+                state = @"interrupted";
+                reason = @"runner exited without reporting";
+            }
+        } else if (now - OmniDoubleValue(run[@"started"]) > OmniRunnerStartGracePeriod) {
+            state = @"failed";
+            reason = @"runner never started";
+        }
+        if (state) {
+            [self runSQL:@"UPDATE runs SET state=?,reason=?,finished=? WHERE id=?"
+                bindings:@[ state, reason, @(now), run[@"id"] ]];
+            // A runner that never started left nothing to report.
+            if (runnerPID > 1) {
+                [self captureEndOfRun:run[@"id"]];
+            }
+        }
+    }
+}
+
+// A timer callback has no caller to report to, so one bad agent definition must
+// not take the app down on every tick.
+- (void)checkNowGuarded {
+    @try {
+        [self checkNow];
+    } @catch (NSException *exception) {
+        NSLog(@"OmniScheduler tick failed: %@", exception);
+    }
+}
+
+- (void)checkNow {
+    [self reloadAgentFilesIfNeeded:NO];
+    [self reapAbandonedRuns];
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    NSArray *due = [self rowsForSQL:@"SELECT name,definition FROM agents WHERE enabled=1 AND next_run IS NOT NULL AND next_run<=?" bindings:@[ @(now) ]];
+    for (NSDictionary *row in due) {
+        NSDictionary *agent = [NSJSONSerialization JSONObjectWithData:[row[@"definition"] dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];
+        id next = [self nextRunForAgent:agent after:now];
+        [self runSQL:@"UPDATE agents SET last_run=?,next_run=? WHERE name=?" bindings:@[ @(now), next, row[@"name"] ]];
+        // The old scheduled unblocker agent never runs; the first pass removes it.
+        if ([agent[@"omni_managed"] isEqual:OmniSessionUnblockerMarker]) {
+            continue;
+        }
+        [self startAgentNamed:row[@"name"] reason:@"scheduled" resumeSessionID:nil];
+    }
+    [self maybeStartUnblockerPass];
+    [self enforceRunRetention];
+}
+
+// The unblocker is not an agent: it listens in the background. Each tick, at
+// most every few seconds, it asks whether a goal-driven session has waited
+// long enough and, if so and no pass is live, starts one `omni unblocker pass`
+// with no tab, no run row and no schedule. A pass that hangs is stopped.
+- (void)maybeStartUnblockerPass {
+    const NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+    if (self.unblockerTask) {
+        if (self.unblockerTask.isRunning) {
+            if (now - self.unblockerStarted > OmniUnblockerPassLimit) {
+                NSLog(@"OmniScheduler: stopping an unblocker pass that ran for %.0f s", now - self.unblockerStarted);
+                [self.unblockerTask terminate];
+            }
+            return;
+        }
+        self.unblockerTask = nil;
+        // The next pass waits its interval from the end of this one.
+        self.unblockerChecked = now;
+    }
+    if (now - self.unblockerChecked < OmniUnblockerCheckInterval) return;
+    self.unblockerChecked = now;
+    NSDictionary *config = [[self settings][@"unblocker"] isKindOfClass:[NSDictionary class]] ? [self settings][@"unblocker"] : @{};
+    if ([config[@"enabled"] isEqual:@NO]) return;
+    const BOOL legacy = [self rowsForSQL:@"SELECT name FROM agents WHERE definition LIKE ? LIMIT 1"
+                                bindings:@[ [NSString stringWithFormat:@"%%%@%%", OmniSessionUnblockerMarker] ]].count > 0;
+    if (!legacy && ![self unblockerHasWork]) return;
+    NSString *omni = [NSBundle.mainBundle pathForResource:@"omni" ofType:nil inDirectory:@"Helpers"];
+    if (!omni) return;
+    NSTask *task = [[[NSTask alloc] init] autorelease];
+    task.executableURL = [NSURL fileURLWithPath:omni];
+    task.arguments = @[ @"unblocker", @"pass", @"--json" ];
+    task.currentDirectoryURL = [NSURL fileURLWithPath:NSHomeDirectory()];
+    NSMutableDictionary *environment = [[NSProcessInfo.processInfo.environment mutableCopy] autorelease];
+    environment[@"OMNITERM_AGENT"] = @"Omni Unblocker";
+    [environment removeObjectForKey:@"OMNITERM_RUN_ID"];
+    task.environment = environment;
+    task.standardInput = [NSFileHandle fileHandleWithNullDevice];
+    task.standardOutput = [NSFileHandle fileHandleWithNullDevice];
+    task.standardError = [NSFileHandle fileHandleWithNullDevice];
+    NSError *error = nil;
+    if (![task launchAndReturnError:&error]) {
+        NSLog(@"OmniScheduler: could not start the unblocker: %@", error);
+        return;
+    }
+    self.unblockerTask = task;
+    self.unblockerStarted = now;
+}
+
+- (BOOL)unblockerHasWork {
+    NSDictionary *response = [self knowledgeReadResponse:@{ @"op": @"list_blocked", @"answerable_only": @YES,
+                                                            @"min_age_seconds": @(OmniUnblockerMinimumAge), @"limit": @1 }];
+    NSArray *blocks = [response[@"blocks"] isKindOfClass:[NSArray class]] ? response[@"blocks"] : nil;
+    return blocks.count > 0;
+}
+
+- (id)nextRunForAgent:(NSDictionary *)agent after:(NSTimeInterval)timestamp {
+    NSDictionary *schedule = agent[@"schedule"];
+    NSString *kind = schedule[@"kind"];
+    if ([kind isEqualToString:@"once"]) return (id)[NSNull null];
+    if ([kind isEqualToString:@"interval"]) return @(timestamp + OmniDoubleValue(schedule[@"interval_seconds"]));
+    NSTimeZone *zone = [NSTimeZone timeZoneWithName:[self settings][@"timezone"]] ?: NSTimeZone.localTimeZone;
+    NSCalendar *calendar = [[[NSCalendar alloc] initWithCalendarIdentifier:NSCalendarIdentifierGregorian] autorelease];
+    calendar.timeZone = zone;
+    NSDate *date = [NSDate dateWithTimeIntervalSince1970:timestamp];
+    if ([kind isEqualToString:@"calendar_interval"]) {
+        const NSTimeInterval anchorTimestamp = OmniDoubleValue(schedule[@"anchor"]);
+        if (timestamp < anchorTimestamp) return @(anchorTimestamp);
+        const NSInteger interval = MAX(1, OmniIntegerValue(schedule[@"interval"]));
+        NSString *unit = schedule[@"unit"];
+        if ([unit isEqualToString:@"hour"]) {
+            const NSTimeInterval step = interval * 3600;
+            const NSInteger multiples = (NSInteger)((timestamp - anchorTimestamp) / step) + 1;
+            return @(anchorTimestamp + multiples * step);
+        }
+        NSDate *anchor = [NSDate dateWithTimeIntervalSince1970:anchorTimestamp];
+        if ([unit isEqualToString:@"day"] || [unit isEqualToString:@"week"]) {
+            const NSInteger stepDays = interval * ([unit isEqualToString:@"week"] ? 7 : 1);
+            NSDateComponents *difference = [calendar components:NSCalendarUnitDay
+                                                        fromDate:anchor
+                                                          toDate:date
+                                                         options:0];
+            NSInteger multiples = MAX(0, difference.day / stepDays);
+            NSDate *candidate = [calendar dateByAddingUnit:NSCalendarUnitDay
+                                                     value:multiples * stepDays
+                                                    toDate:anchor
+                                                   options:0];
+            if (candidate.timeIntervalSince1970 <= timestamp) {
+                candidate = [calendar dateByAddingUnit:NSCalendarUnitDay
+                                                 value:stepDays
+                                                toDate:candidate
+                                               options:0];
+            }
+            return @(candidate.timeIntervalSince1970);
+        }
+        NSDateComponents *difference = [calendar components:NSCalendarUnitMonth
+                                                    fromDate:anchor
+                                                      toDate:date
+                                                     options:0];
+        NSInteger multiples = MAX(0, difference.month / interval);
+        NSDate *candidate = OmniMonthlyOccurrence(calendar,
+                                                  anchor,
+                                                  multiples * interval,
+                                                  OmniIntegerValue(schedule[@"day"]),
+                                                  OmniIntegerValue(schedule[@"hour"]),
+                                                  OmniIntegerValue(schedule[@"minute"]));
+        if (candidate.timeIntervalSince1970 <= timestamp) {
+            candidate = OmniMonthlyOccurrence(calendar,
+                                              anchor,
+                                              (multiples + 1) * interval,
+                                              OmniIntegerValue(schedule[@"day"]),
+                                              OmniIntegerValue(schedule[@"hour"]),
+                                              OmniIntegerValue(schedule[@"minute"]));
+        }
+        return @(candidate.timeIntervalSince1970);
+    }
+    NSDateComponents *components = [[[NSDateComponents alloc] init] autorelease];
+    components.hour = OmniIntegerValue(schedule[@"hour"]);
+    components.minute = OmniIntegerValue(schedule[@"minute"]);
+    if ([kind isEqualToString:@"weekly"]) {
+        // Python uses Monday=0; NSCalendar uses Sunday=1.
+        components.weekday = ((OmniIntegerValue(schedule[@"weekday"]) + 1) % 7) + 1;
+    }
+    NSDate *next = [calendar nextDateAfterDate:date
+                               matchingComponents:components
+                                          options:NSCalendarMatchNextTimePreservingSmallerUnits];
+    if ([kind isEqualToString:@"weekdays"]) {
+        while ([calendar isDateInWeekend:next]) {
+            next = [calendar nextDateAfterDate:next
+                            matchingComponents:components
+                                       options:NSCalendarMatchNextTimePreservingSmallerUnits];
+        }
+    }
+    return @(next.timeIntervalSince1970);
+}
+
+@end
