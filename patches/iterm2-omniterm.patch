+    private func setAppearance(of name: String, _ changes: [String: String], then: (() -> Void)? = nil) {
+        var request: [String: Any] = ["op": "set_agent_appearance", "name": name]
+        for (key, value) in changes {
+            request[key] = value
+        }
+        OmniSchedulerClient.request(request) { [weak self] response in
+            guard let self else { return }
+            if response["ok"] as? Bool != true, let row = self.itemCache["agent|\(name)"] {
+                self.showRenameProblem(Self.problem(response, fallback: "The agent could not be changed."), on: row)
+            }
+            self.requestSchedulerState()
+            then?()
+        }
+    }
