+// MARK: - Right-click menus and the pointer, in the real window
+
+extension OmniSidebarUITests {
+    private func rightClick(at point: NSPoint, in view: NSView) -> NSEvent {
+        return NSEvent.mouseEvent(with: .rightMouseDown, location: view.convert(point, to: nil), modifierFlags: [],
+                                  timestamp: 0, windowNumber: window.windowNumber, context: nil, eventNumber: 0,
+                                  clickCount: 1, pressure: 1)!
+    }
+
+    private static func titles(_ menu: NSMenu?) -> [String] {
+        return (menu?.items ?? []).filter { !$0.isSeparatorItem }.map(\.title)
+    }
+
+    // The sidebar's own menu, built as AppKit builds it for a right-click on `row`.
+    private func sidebarMenu(forRow row: Int) -> [String] {
+        let rect = outlineView.rect(ofRow: row)
+        let menu = outlineView.menu(for: rightClick(at: NSPoint(x: rect.midX, y: rect.midY), in: outlineView))
+        if let menu {
+            sidebar.menuNeedsUpdate(menu)
+        }
+        return Self.titles(menu)
+    }
+
+    private static func descendants(of view: NSView) -> [NSView] {
+        return view.subviews + view.subviews.flatMap { descendants(of: $0) }
+    }
+
+    private func settle() {
+        RunLoop.main.run(until: Date().addingTimeInterval(0.4))
+    }
+
+    func testRightClickingSidebarRowsOffersTheirCommands() throws {
+        showFolderSidebar()
+        let agent = sidebarMenu(forRow: try XCTUnwrap(row(titled: "Beta")))
+        for title in ["Open", "Run Now", "Edit…", "Pause Schedule", "Delete Agent…", "Rename…", "Move to"] {
+            XCTAssertTrue(agent.contains(title), "Agent menu lacks \(title): \(agent)")
+        }
+        XCTAssertEqual(agent.filter { $0 == "Rename…" }.count, 1, "Rename appears once")
+        let alphaRows = (0..<outlineView.numberOfRows).filter { cell($0)?.textField?.stringValue == "Alpha" }
+        let run = sidebarMenu(forRow: try XCTUnwrap(alphaRows.last))
+        XCTAssertTrue(run.contains("Open Report") && run.contains("Resume"), "Run menu: \(run)")
+        let folder = sidebarMenu(forRow: try XCTUnwrap(row(titled: "Ops")))
+        XCTAssertTrue(folder.contains("Rename Folder") && folder.contains("Delete Folder…"), "Folder menu: \(folder)")
+    }
+
+    func testRightClickingPageRowsOffersTheirCommands() throws {
+        fake.agents[1]["group"] = "Ops"
+        fake.groups = ["Ops"]
+        fake.runs = [["id": "run-1", "agent": "Alpha", "state": "completed", "started": 1_800_000_000,
+                      "finished": 1_800_000_060, "summary": "Fixed the build"]]
+        showSidebarWithPages()
+        sidebar.paneOpen(.group("Ops"))
+        wait("the folder page lists Beta") {
+            Self.descendants(of: window.contentView!).contains { ($0 as? OmniFolderEntryRow)?.titleText == "Beta" }
+        }
+        let beta = try XCTUnwrap(Self.descendants(of: window.contentView!).compactMap { $0 as? OmniFolderEntryRow }
+            .first { $0.titleText == "Beta" })
+        let agent = Self.titles(beta.menu(for: rightClick(at: .zero, in: beta)))
+        for title in ["Open", "Run Now", "Edit…", "Rename…", "Pause Schedule", "Delete Agent…"] {
+            XCTAssertTrue(agent.contains(title), "Folder-page agent menu lacks \(title): \(agent)")
+        }
+        sidebar.paneOpen(.overview)
+        wait("the dashboard lists the run") {
+            Self.descendants(of: window.contentView!).contains { $0 is OmniRunRowView }
+        }
+        let runRow = try XCTUnwrap(Self.descendants(of: window.contentView!).compactMap { $0 as? OmniRunRowView }.first)
+        let run = Self.titles(runRow.menu(for: rightClick(at: .zero, in: runRow)))
+        XCTAssertTrue(run.contains("Open Report") && (run.contains("Resume") || run.contains("Stop Run")), "Dashboard row menu: \(run)")
+    }
+
+    // Every page the sidebar opens: each visible button, pop-up, switch or
+    // segmented control has the pointer, and every clickable row sets it.
+    func testEveryClickableThingOnEveryPageShowsThePointer() {
+        fake.agents[1]["group"] = "Ops"
+        fake.groups = ["Ops"]
+        fake.runs = [["id": "run-1", "agent": "Alpha", "state": "completed", "started": 1_800_000_000,
+                      "finished": 1_800_000_060, "summary": "Fixed the build"]]
+        showSidebarWithPages()
+        var missing: [String] = []
+        var checked = 0
+        let routes: [OmniPaneRoute] = [.overview, .agent("Alpha"), .run("run-1"), .group("Ops"), .inbox, .memory,
+                                       .settings, .unblocker, .projects, .search("build")]
+        for route in routes {
+            sidebar.paneOpen(route)
+            settle()
+            window.layoutIfNeeded()
+            for view in Self.descendants(of: window.contentView!) where !view.isHiddenOrHasHiddenAncestor {
+                switch view {
+                case is NSButton, is NSSegmentedControl, is NSSwitch, is NSSlider:
+                    checked += 1
+                    // A search field's own magnifier and clear buttons belong to the field.
+                    var inField = false
+                    var chain: [String] = []
+                    var parent = view.superview
+                    while let current = parent {
+                        if current is NSTextField { inField = true }
+                        chain.append(String(describing: type(of: current)))
+                        parent = current.superview
+                    }
+                    if inField {
+                        checked -= 1
+                    } else if !view.trackingAreas.contains(where: { $0.owner === OmniPointer.shared }) {
+                        missing.append("\(route): \(type(of: view)) “\((view as? NSButton)?.title ?? "")” in \(chain.prefix(4).joined(separator: " < "))")
+                    }
+                default:
+                    break
+                }
+            }
+        }
+        XCTAssertGreaterThan(checked, 20, "The sweep found the pages’ controls")
+        XCTAssertEqual(missing, [], "Controls without the pointing hand")
+    }
+}
