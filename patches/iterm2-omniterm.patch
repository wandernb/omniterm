+// A table that offers its keys to a handler first, as the page's zone.
+final class OmniMemoryTableView: NSTableView {
+
+    // Rows open what they show: the pointing hand, not the arrow.
+    override func resetCursorRects() {
+        super.resetCursorRects()
+        addCursorRect(visibleRect, cursor: .pointingHand)
+    }
+    var keyHandler: ((NSEvent) -> Bool)?
+
+    // Right-click selects the clicked row, then asks for its menu.
+    var contextMenu: ((Int) -> NSMenu?)?
+
+    override func menu(for event: NSEvent) -> NSMenu? {
+        let row = self.row(at: convert(event.locationInWindow, from: nil))
+        guard row >= 0, let contextMenu else { return super.menu(for: event) }
+        if !selectedRowIndexes.contains(row) {
+            selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+        }
+        return contextMenu(row) ?? super.menu(for: event)
+    }
+
+    override func keyDown(with event: NSEvent) {
+        if keyHandler?(event) == true {
+            return
+        }
+        super.keyDown(with: event)
+    }
+}
+
+// A table, or the graph canvas, as a page's keyboard zone.
+final class OmniMemoryZone: OmniFocusZone {
+    var zoneExit: ((OmniZoneExit) -> Void)?
+    private let responder: () -> NSView
+    private let canEnter: () -> Bool
+    private let step: (Int) -> Void
+    private let activate: () -> Void
+
+    init(responder: @escaping () -> NSView, canEnter: @escaping () -> Bool, step: @escaping (Int) -> Void,
+         activate: @escaping () -> Void) {
+        self.responder = responder
+        self.canEnter = canEnter
+        self.step = step
+        self.activate = activate
+    }
+
+    var zoneFirstResponder: NSView {
+        return responder()
+    }
+
+    var zoneCanEnter: Bool {
+        return canEnter()
+    }
+
+    func zoneEnter() {
+        zoneFirstResponder.window?.makeFirstResponder(zoneFirstResponder)
+    }
+
+    func zoneHandleKey(_ event: NSEvent) -> Bool {
+        switch OmniZoneKey(event) {
+        case .up: step(-1)
+        case .down: step(1)
+        case .activate, .right: activate()
+        case .left, .back: zoneExit?(.back)
+        case .next: zoneExit?(.next)
+        case .previous: zoneExit?(.previous)
+        default: return false
+        }
+        return true
+    }
+}
