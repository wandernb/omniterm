+++ b/ModernTests/OmniContextMenusTests.swift
@@ -0,0 +1,135 @@
+//
+//  OmniContextMenusTests.swift
+//  ModernTests
+//
+//  Right-click menus offer the same commands wherever a thing appears, and
+//  everything clickable on a page gets the pointing hand.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniContextMenusTests: XCTestCase {
+    private func titles(_ menu: NSMenu) -> [String] {
+        return menu.items.filter { !$0.isSeparatorItem }.map(\.title)
+    }
+
+    // A tracking area sends these exact selectors to its owner; OmniPointer is
+    // not a responder, so a missing one is an unrecognized selector and aborts
+    // the app the first time the mouse enters a control (2026-11-27 crash).
+    func testPointerAnswersTheSelectorsTrackingAreasSend() throws {
+        func deliver(_ name: String, _ type: NSEvent.EventType) throws {
+            let selector = NSSelectorFromString(name)
+            XCTAssertTrue(OmniPointer.shared.responds(to: selector), name)
+            let event = try XCTUnwrap(NSEvent.enterExitEvent(with: type, location: .zero, modifierFlags: [], timestamp: 0,
+                                                             windowNumber: 0, context: nil, eventNumber: 0,
+                                                             trackingNumber: 0, userData: nil))
+            // Delivered exactly as NSTrackingArea delivers it; an unknown selector would raise.
+            _ = OmniPointer.shared.perform(selector, with: event)
+        }
+        try deliver("mouseEntered:", .mouseEntered)
+        try deliver("cursorUpdate:", .cursorUpdate)
+        XCTAssertEqual(NSCursor.current, NSCursor.pointingHand, "over a control")
+        try deliver("mouseExited:", .mouseExited)
+        XCTAssertEqual(NSCursor.current, NSCursor.arrow, "leaving it restores the arrow")
+    }
+
+    func testAgentMenuOffersTheAgentCommands() {
+        let menu = OmniContextMenus.agent("nightly", enabled: true, actions: nil, window: nil)
+        XCTAssertEqual(titles(menu), ["Open", "Run Now", "Edit…", "Rename…", "Pause Schedule", "Copy Name", "Delete Agent…"])
+        let paused = OmniContextMenus.agent("nightly", enabled: false, actions: nil, window: nil, rename: false)
+        XCTAssertTrue(titles(paused).contains("Resume Schedule"))
+        XCTAssertFalse(titles(paused).contains("Rename…"))
+    }
+
+    func testRunMenuFollowsWhetherTheRunIsLive() {
+        let live = titles(OmniContextMenus.run("r1", agent: "nightly", live: true, actions: nil, window: nil))
+        XCTAssertTrue(live.contains("Stop Run") && live.contains("Show Terminal"))
+        XCTAssertFalse(live.contains("Resume"))
+        let ended = titles(OmniContextMenus.run("r1", agent: nil, live: false, actions: nil, window: nil))
+        XCTAssertTrue(ended.contains("Resume"))
+        XCTAssertFalse(ended.contains("Stop Run"))
+    }
+
+    func testSessionMenuCannotResumeALiveSession() {
+        let menu = OmniContextMenus.session(["session_id": "claude:abc", "state": "running", "title": "T"],
+                                            actions: nil, window: nil)
+        XCTAssertTrue(titles(menu).contains("Rename…"))
+        XCTAssertEqual(menu.items.first { $0.title == "Resume in a New Tab" }?.isEnabled, false)
+    }
+
+    func testMenuItemsRunTheirAction() {
+        var ran = false
+        let menu = NSMenu()
+        let item = menu.addAction("Go") { ran = true }
+        menu.performActionForItem(at: menu.index(of: item))
+        XCTAssertTrue(ran)
+    }
+
+    func testRowsShowTheirMenuOnRightClick() throws {
+        let row = OmniFolderEntryRow(icon: .symbol(SFSymbol.folder.rawValue), iconColor: nil, title: "A", detail: "",
+                                     badge: "", status: nil) {}
+        row.contextMenu = { OmniContextMenus.path("/tmp", open: nil) }
+        let event = try XCTUnwrap(NSEvent.mouseEvent(with: .rightMouseDown, location: .zero, modifierFlags: [],
+                                                     timestamp: 0, windowNumber: 0, context: nil, eventNumber: 0,
+                                                     clickCount: 1, pressure: 1))
+        XCTAssertEqual(row.menu(for: event).map(titles), ["Reveal in Finder", "Open with Default App", "Copy Path"])
+    }
+
+    func testTicketRowsMenuSetsStatusAndPriority() throws {
+        let saved = OmniTicketStore.directory
+        OmniTicketStore.directory = FileManager.default.temporaryDirectory.appendingPathComponent("omni-ctx-\(UUID().uuidString)")
+        defer {
+            try? FileManager.default.removeItem(at: OmniTicketStore.directory)
+            OmniTicketStore.directory = saved
+        }
+        var file = OmniTicketFile(root: "/projects/menu")
+        let now = Date()
+        file.tickets = [OmniTicket(id: "t1", number: 1, title: "One", content: "", status: .open, priority: .longTerm,
+                                   created: now, updated: now)]
+        OmniTicketStore.save(file)
+        let controller = OmniTicketsController(root: "/projects/menu")
+        _ = controller.build(into: OmniColumnView(), previous: [])
+        let column = OmniColumnView()
+        _ = controller.build(into: column, previous: [])
+        let row = try XCTUnwrap(Self.descendants(of: column).compactMap { $0 as? OmniTicketRow }.first)
+        let menu = try XCTUnwrap(row.contextMenu?())
+        XCTAssertEqual(titles(menu), ["Open", "Status", "Priority", "Copy Title", "Copy as Markdown", "Delete Ticket…"])
+        let done = try XCTUnwrap(menu.items.first { $0.title == "Status" }?.submenu?.items.first { $0.title == "Done" })
+        done.menu?.performActionForItem(at: done.menu!.index(of: done))
+        XCTAssertEqual(controller.file.tickets.first?.status, .done)
+    }
+
+    // The sweep: every button, pop-up and segmented control a page puts in
+    // its column gets the pointer, and rows set it themselves.
+    func testEveryControlInAColumnGetsThePointer() {
+        let column = OmniColumnView()
+        let row = OmniButtonRow([NSButton(title: "A", target: nil, action: nil), NSPopUpButton(frame: .zero, pullsDown: false)])
+        column.add(row) { _ in 30 }
+        let segmented = NSSegmentedControl(labels: ["X", "Y"], trackingMode: .selectOne, target: nil, action: nil)
+        let holder = NSView()
+        holder.addSubview(segmented)
+        column.add(holder) { _ in 30 }
+        let controls = Self.descendants(of: column).filter { $0 is NSButton || $0 is NSSegmentedControl }
+        XCTAssertEqual(controls.count, 3)
+        for control in controls {
+            XCTAssertTrue(control.trackingAreas.contains { $0.owner === OmniPointer.shared }, "\(control) has no pointer")
+        }
+    }
+
+    func testTicketsTabControlsAllGetThePointer() {
+        let saved = OmniTicketStore.directory
+        OmniTicketStore.directory = FileManager.default.temporaryDirectory.appendingPathComponent("omni-ctx-\(UUID().uuidString)")
+        defer { OmniTicketStore.directory = saved }
+        let controller = OmniTicketsController(root: "/projects/pointer")
+        let column = OmniColumnView()
+        _ = controller.build(into: column, previous: [])
+        let buttons = Self.descendants(of: column).compactMap { $0 as? NSButton }
+        XCTAssertFalse(buttons.isEmpty)
+        XCTAssertTrue(buttons.allSatisfy { button in button.trackingAreas.contains { $0.owner === OmniPointer.shared } })
+    }
+
+    private static func descendants(of view: NSView) -> [NSView] {
+        return view.subviews + view.subviews.flatMap { descendants(of: $0) }
+    }
+}
diff --git a/ModernTests/OmniDockPresenceTests.swift b/ModernTests/OmniDockPresenceTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..097f7f6e19ac2420a3f032e630bb54db04b06ee3
--- /dev/null
+++ b/ModernTests/OmniDockPresenceTests.swift
@@ -0,0 +1,116 @@
+//
+//  OmniDockPresenceTests.swift
+//  ModernTests
+//
+//  OmniTerm shows in the Dock only while one of its windows is up, and ⌘Q
+//  hides rather than quits.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniDockPresenceTests: XCTestCase {
+    private var windowVisible = false
+    private var appActive = true
+    private var applied: [NSApplication.ActivationPolicy] = []
+
+    private func makePresence() -> OmniDockPresence {
+        return OmniDockPresence(policy: .accessory,
+                                anyWindowVisible: { [unowned self] in windowVisible },
+                                appIsActive: { [unowned self] in appActive },
+                                apply: { [unowned self] in applied.append($0) })
+    }
+
+    func testVisibleWindowShowsInTheDock() {
+        let presence = makePresence()
+        presence.startWithoutObserving()
+        windowVisible = true
+        presence.reconcile()
+        XCTAssertEqual(presence.policy, .regular)
+        XCTAssertEqual(applied, [.regular])
+    }
+
+    func testHidingEveryWindowLeavesTheDock() {
+        let presence = makePresence()
+        presence.startWithoutObserving()
+        windowVisible = true
+        presence.reconcile()
+        windowVisible = false
+        presence.reconcile()
+        XCTAssertEqual(presence.policy, .accessory)
+        XCTAssertEqual(applied, [.regular, .accessory])
+    }
+
+    func testUnchangedVisibilityAppliesNothing() {
+        let presence = makePresence()
+        presence.startWithoutObserving()
+        presence.reconcile()
+        XCTAssertEqual(applied, [])
+    }
+
+    func testBackgroundLaunchStaysOutOfTheDock() {
+        // Before launch has put its windows away, nothing changes.
+        windowVisible = true
+        let presence = makePresence()
+        presence.reconcile()
+        XCTAssertEqual(applied, [])
+
+        // A window ordered in by background work while the app is inactive
+        // does not bring up the Dock icon either.
+        appActive = false
+        presence.startWithoutObserving()
+        XCTAssertEqual(presence.policy, .accessory)
+        XCTAssertEqual(applied, [])
+    }
+
+    func testUserShowPromotesBeforeActivation() {
+        let presence = makePresence()
+        appActive = false
+        presence.startWithoutObserving()
+        windowVisible = true
+        presence.reconcileShowingWindow()
+        XCTAssertEqual(presence.policy, .regular)
+    }
+
+    func testSwitchingToAnotherAppKeepsTheDockIcon() {
+        XCTAssertEqual(OmniDockPresence.policy(anyWindowVisible: true, appActive: false, current: .regular),
+                       .regular)
