+        if (![self updateSettings:@{ @"sidebar_agent_order": known, @"sidebar_order": order } error:&error]) {
+            return @{ @"ok": @NO, @"code": @"write_failed", @"error": error.localizedDescription ?: @"Could not write settings" };
+        }
+        [self notificationsDidChange];
+        return @{ @"ok": @YES, @"names": known };
+    }
+    if ([operation isEqualToString:@"set_layout"]) {
