+import AppKit
+import Foundation
+
+// One run as returned by the scheduler's `get_run` and `list_runs`. Every text
+// field comes from an agent or a repository and is untrusted: it is shown as
+// plain text through OmniReportText, never opened or executed.
+struct OmniRun {
+    struct Commit {
+        let sha: String
+        let subject: String
+    }
+
+    let id: String
+    let agent: String
+    let state: String
+    let reason: String?
+    let started: Date
+    let finished: Date?
+    let workspace: String?
+    let provider: String?
+    let origin: String?
+    let branch: String?
+    let headStart: String?
+    let headEnd: String?
+    let commits: [Commit]
+    let finalMessage: String?
+    let summary: String?
+    let summaryState: String?
+    let diffState: String?
+    let diffFiles: [String]
+    let prURL: String?
+    let sessionID: String?
+    // The agent finished its turn; a live session is then waiting for input.
+    let turnFinished: Bool
+    // Whether the run recorded its turn at all. Runs from before turns were
+    // tracked did not, so how they ended is unknown.
+    let turnRecorded: Bool
+    let reportUpdated: Date?
+
+    init?(_ dictionary: [AnyHashable: Any]) {
+        guard let id = dictionary["id"] as? String, !id.isEmpty else {
+            return nil
+        }
+        func text(_ key: String) -> String? {
+            guard let value = dictionary[key] as? String, !value.isEmpty else { return nil }
+            return value
+        }
+        func date(_ key: String) -> Date? {
+            guard let value = dictionary[key] as? NSNumber else { return nil }
+            return Date(timeIntervalSince1970: value.doubleValue)
+        }
+        self.id = id
+        agent = text("agent") ?? "Unknown agent"
+        state = text("state") ?? "unknown"
+        reason = text("reason")
+        started = date("started") ?? Date(timeIntervalSince1970: 0)
+        finished = date("finished")
+        workspace = text("workspace")
+        provider = text("provider")
+        origin = text("origin")
+        branch = text("branch")
+        headStart = text("head_start")
+        headEnd = text("head_end")
+        commits = (dictionary["commits"] as? [[AnyHashable: Any]] ?? []).compactMap { commit in
+            guard let sha = commit["sha"] as? String else { return nil }
+            return Commit(sha: sha, subject: commit["subject"] as? String ?? "")
+        }
+        finalMessage = text("final_message")
+        summary = text("summary")
+        summaryState = text("summary_state")
+        diffState = text("diff_state")
+        diffFiles = (dictionary["diff_files"] as? [String] ?? []).filter { !$0.isEmpty }
+        prURL = text("pr_url")
+        sessionID = text("session_id")
+        turnFinished = (dictionary["turn_finished"] as? NSNumber)?.intValue == 1
+        turnRecorded = dictionary["turn_finished"] is NSNumber
+        reportUpdated = date("report_updated")
+    }
+
+    static let liveStates: Set<String> = ["starting", "running", "evicting"]
+
+    var isLive: Bool {
+        return Self.liveStates.contains(state)
+    }
+
+    var canResume: Bool {
+        return sessionID != nil
+    }
+
+    // Live, but the agent has finished its turn and waits for the person.
+    var isIdle: Bool {
+        return isLive && state != "evicting" && turnFinished
+    }
+
+    // Live and the agent is working.
+    var isWorking: Bool {
+        return isLive && !isIdle
+    }
+
+    var outcomeName: String {
+        if isIdle {
+            return "Idle"
+        }
+        switch state {
+        case "starting": return "Starting"
+        case "running": return "Running"
+        case "evicting": return "Stopping"
+        case "completed": return "Completed"
+        case "failed": return "Failed"
+        case "interrupted": return "Interrupted"
+        case "closed": return "Closed"
+        case "stopped": return "Stopped"
+        case "replaced": return "Replaced"
+        // Retention closed it. Evicted only when the agent was known to be mid-turn.
+        case "evicted": return turnRecorded ? "Evicted" : "Ended"
+        default: return state.capitalized
+        }
+    }
+
+    // Green done, blue working, orange waiting for the person, red only for
+    // things that actually went wrong, grey for everything that just ended.
+    var outcomeColor: NSColor {
+        if isIdle {
+            return OmniTheme.waiting
+        }
+        switch state {
+        case "starting", "running", "evicting": return OmniTheme.running
+        case "completed": return OmniTheme.completed
+        case "failed": return OmniTheme.failed
+        default: return OmniTheme.ended
+        }
+    }
+
+    // The sidebar's line under the agent's name.
+    var statusLine: String {
+        if isIdle {
+            return "Idle · waiting for you"
+        }
+        if isWorking {
+            return "Running · \(OmniFormat.duration(from: started, to: Date()))"
+        }
+        let summary = oneLineSummary
+        return summary.isEmpty ? outcomeName : "\(outcomeName) · \(summary)"
+    }
+
+    // The AI summary when there is one, else the agent's final message, else
+    // why the run ended. Always one line of plain text.
+    var oneLineSummary: String {
+        for candidate in [summary, finalMessage, reason] {
+            if let candidate, let line = OmniReportText.firstLine(candidate) {
+                return line
+            }
+        }
+        return ""
+    }
+
+    var headRange: String? {
+        guard let headStart else { return nil }
+        let start = String(headStart.prefix(8))
+        guard let headEnd, headEnd != headStart else { return start }
+        return "\(start)…\(headEnd.prefix(8))"
+    }
+
+    // Changes whenever what the run left behind may have changed.
+    var outputStamp: String {
+        return "\(state)|\(finished?.timeIntervalSince1970 ?? 0)|\(reportUpdated?.timeIntervalSince1970 ?? 0)"
+    }
+
+    var hasDiff: Bool {
+        return diffState == "captured" || diffState == "truncated"
+    }
+}
+
+// Agents OmniTerm runs for itself. They and their runs are housekeeping: the
+// sidebar (agents, folders and runs), folder pages and the Dashboard leave them
+// out, and the Memory page's Ingest tab lists their runs and opens the agent's
+// page, where it can still be paused or edited. CLI and MCP listings keep them.
+enum OmniBackgroundAgents {
+    static let memoryConsolidator = "memory_consolidator:v1"
+    static let sessionUnblocker = "session_unblocker:v1"
+
+    static func isBackground(_ agent: [AnyHashable: Any]) -> Bool {
+        let marker = agent["omni_managed"] as? String
+        return marker == memoryConsolidator || marker == sessionUnblocker
+    }
+
+    static func names(_ agents: [[AnyHashable: Any]]) -> Set<String> {
+        return Set(agents.filter(isBackground).compactMap { $0["name"] as? String })
+    }
+}
+
+// One agent as returned by `list_agents` and `show_agent`.
+struct OmniAgent {
+    let name: String
+    let isBackground: Bool
+    let provider: String
+    let enabled: Bool
+    let nextRun: Date?
+    let lastRun: Date?
+    let schedule: String
+    let workspace: String?
+    let permissionMode: String?
+    let model: String?
+    let overlap: String?
+    let systemPrompt: String
+    let startupPrompt: String
+
+    init?(_ dictionary: [AnyHashable: Any]) {
+        guard let name = dictionary["name"] as? String, !name.isEmpty else {
+            return nil
+        }
+        func text(_ key: String) -> String? {
+            guard let value = dictionary[key] as? String, !value.isEmpty else { return nil }
+            return value
+        }
+        func date(_ key: String) -> Date? {
+            guard let value = dictionary[key] as? NSNumber else { return nil }
+            return Date(timeIntervalSince1970: value.doubleValue)
+        }
+        self.name = name
+        isBackground = OmniBackgroundAgents.isBackground(dictionary)
+        provider = text("provider") ?? "unknown"
+        enabled = (dictionary["enabled"] as? NSNumber)?.boolValue ?? false
+        nextRun = date("next_run")
+        lastRun = date("last_run")
+        let schedule = dictionary["schedule"] as? [AnyHashable: Any]
+        self.schedule = (schedule?["phrase"] as? String).flatMap { $0.isEmpty ? nil : $0 } ??
+            (schedule?["kind"] as? String) ?? "No schedule"
+        workspace = text("workspace")
+        permissionMode = text("permission_mode")
+        model = text("model")
+        overlap = text("overlap")
+        systemPrompt = text("system_prompt") ?? ""
+        startupPrompt = text("startup_prompt") ?? ""
+    }
+
+    var providerName: String {
+        return provider.capitalized
+    }
+
+    var isDangerous: Bool {
+        return permissionMode == "bypassPermissions" || permissionMode == "dangerous"
+    }
+}
+
+enum OmniFormat {
+    static let dateFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateStyle = .medium
+        formatter.timeStyle = .short
+        formatter.doesRelativeDateFormatting = true
+        return formatter
+    }()
+
+    static func date(_ date: Date?) -> String {
+        guard let date else { return "—" }
+        return dateFormatter.string(from: date)
+    }
+
+    static func relative(_ date: Date) -> String {
+        return OmniSchedulerClient.relativeFormatter.localizedString(for: date, relativeTo: Date())
+    }
+
+    static func duration(from start: Date, to end: Date) -> String {
+        let seconds = max(0, Int(end.timeIntervalSince(start)))
+        if seconds < 60 {
+            return "\(seconds)s"
+        }
+        if seconds < 3600 {
+            return "\(seconds / 60)m"
+        }
+        return "\(seconds / 3600)h \(seconds % 3600 / 60)m"
+    }
+
+    static func path(_ path: String?) -> String {
+        guard let path else { return "—" }
+        return (path as NSString).abbreviatingWithTildeInPath
+    }
+}
+
+// Agent-written text rendered as plain text with a minimal, safe subset of
+// Markdown: headings, bullets, code fences, bold and inline code. Nothing is
+// ever a link, HTML is shown literally, and control and bidirectional
+// override characters, which could disguise the text, are removed.
+enum OmniReportText {
+    static func sanitized(_ text: String) -> String {
+        let normalized = text.replacingOccurrences(of: "\r\n", with: "\n").replacingOccurrences(of: "\r", with: "\n")
+        var scalars = String.UnicodeScalarView()
+        for scalar in normalized.unicodeScalars {
+            switch scalar.value {
+            case 0x0A, 0x09:
+                scalars.append(scalar)
+            case 0x00...0x1F, 0x7F...0x9F, 0x200E, 0x200F, 0x202A...0x202E, 0x2066...0x2069:
+                continue
+            default:
+                scalars.append(scalar)
+            }
+        }
+        return String(scalars)
+    }
+
+    // The first line with words in it, with Markdown markers removed.
+    static func firstLine(_ text: String, limit: Int = 160) -> String? {
+        for rawLine in sanitized(text).components(separatedBy: "\n") {
+            var line = rawLine.trimmingCharacters(in: .whitespaces)
+            if line.hasPrefix("```") {
+                continue
+            }
+            line = strippedBlockMarker(line).text
+            line = plainInline(line).trimmingCharacters(in: .whitespaces)
+            guard !line.isEmpty else { continue }
+            if line.count > limit {
+                return String(line.prefix(limit - 1)) + "…"
+            }
+            return line
+        }
+        return nil
+    }
+
+    static func attributed(_ text: String, fontSize: CGFloat = 13.5, color: NSColor = .labelColor) -> NSAttributedString {
+        let body = NSFont.systemFont(ofSize: fontSize)
+        let mono = NSFont.monospacedSystemFont(ofSize: fontSize - 1.5, weight: .regular)
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.lineSpacing = 3
+        paragraph.paragraphSpacing = 4
+        let base: [NSAttributedString.Key: Any] = [.font: body, .foregroundColor: color, .paragraphStyle: paragraph]
+        let result = NSMutableAttributedString()
+        var inFence = false
+        let lines = sanitized(text).components(separatedBy: "\n")
+        for (index, rawLine) in lines.enumerated() {
+            let newline = index < lines.count - 1 ? "\n" : ""
+            if rawLine.trimmingCharacters(in: .whitespaces).hasPrefix("```") {
+                inFence.toggle()
+                continue
+            }
+            if inFence {
+                var attributes = base
+                attributes[.font] = mono
+                attributes[.foregroundColor] = OmniTheme.secondaryText
+                result.append(NSAttributedString(string: rawLine + newline, attributes: attributes))
+                continue
+            }
+            let block = strippedBlockMarker(rawLine)
+            var attributes = base
+            if block.heading {
+                attributes[.font] = NSFont.systemFont(ofSize: fontSize + 1, weight: .semibold)
+            }
+            result.append(NSAttributedString(string: block.prefix, attributes: attributes))
+            result.append(inline(block.text, attributes: attributes, mono: mono))
+            result.append(NSAttributedString(string: newline, attributes: attributes))
+        }
+        return result
+    }
+
+    private static func strippedBlockMarker(_ line: String) -> (text: String, prefix: String, heading: Bool) {
+        let trimmed = line.drop { $0 == " " }
+        let indent = String(repeating: " ", count: line.count - trimmed.count)
+        var hashes = 0
+        for character in trimmed {
+            guard character == "#" else { break }
+            hashes += 1
+        }
+        if hashes > 0, hashes <= 6, trimmed.dropFirst(hashes).first == " " {
+            return (String(trimmed.dropFirst(hashes + 1)), "", true)
+        }
+        for marker in ["- ", "* ", "+ "] where trimmed.hasPrefix(marker) {
+            return (String(trimmed.dropFirst(2)), indent + "• ", false)
+        }
+        if trimmed.hasPrefix("> ") {
+            return (String(trimmed.dropFirst(2)), indent + "│ ", false)
+        }
+        return (line, "", false)
+    }
+
+    private static func plainInline(_ text: String) -> String {
+        return inline(text, attributes: [:], mono: NSFont.systemFont(ofSize: 1)).string
+    }
+
+    // Bold, inline code and links. A link keeps its text and shows its target
+    // as plain text, so nothing in the report can be clicked.
+    private static func inline(_ text: String, attributes: [NSAttributedString.Key: Any], mono: NSFont) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        let characters = Array(text)
+        var plain = ""
+        var index = 0
+
+        func flush() {
+            guard !plain.isEmpty else { return }
+            result.append(NSAttributedString(string: plain, attributes: attributes))
+            plain = ""
+        }
+
+        func find(_ needle: [Character], from start: Int) -> Int? {
+            guard needle.count <= characters.count else { return nil }
+            var position = start
+            while position + needle.count <= characters.count {
+                if Array(characters[position..<position + needle.count]) == needle {
+                    return position
+                }
+                position += 1
+            }
+            return nil
+        }
+
+        while index < characters.count {
+            let character = characters[index]
+            if character == "`", let end = find(["`"], from: index + 1), end > index + 1 {
+                flush()
+                var code = attributes
+                code[.font] = mono
+                result.append(NSAttributedString(string: String(characters[index + 1..<end]), attributes: code))
+                index = end + 1
+                continue
+            }
+            if (character == "*" || character == "_"), index + 1 < characters.count, characters[index + 1] == character,
+               let end = find([character, character], from: index + 2), end > index + 2 {
+                flush()
+                var bold = attributes
+                if let font = attributes[.font] as? NSFont {
+                    bold[.font] = NSFont.boldSystemFont(ofSize: font.pointSize)
+                }
+                result.append(NSAttributedString(string: String(characters[index + 2..<end]), attributes: bold))
+                index = end + 2
+                continue
+            }
+            let isImage = character == "!" && index + 1 < characters.count && characters[index + 1] == "["
+            if character == "[" || isImage {
+                let open = isImage ? index + 1 : index
+                if let close = find(["]", "("], from: open + 1), let end = find([")"], from: close + 2) {
+                    let label = String(characters[open + 1..<close])
+                    let target = String(characters[close + 2..<end])
+                    if isImage || target.isEmpty || target == label {
+                        plain += label.isEmpty ? target : label
+                    } else {
+                        plain += "\(label) (\(target))"
+                    }
+                    index = end + 1
+                    continue
+                }
+            }
+            plain.append(character)
+            index += 1
+        }
+        flush()
+        return result
+    }
+}
