+- (BOOL)updateSettings:(NSDictionary *)changes error:(NSError **)error {
+    NSString *invalidKey = nil;
+    if (changes[@"sidebar_groups"] && !OmniValidGroupList(changes[@"sidebar_groups"])) {
+        invalidKey = @"sidebar_groups";
+    } else if (changes[@"sidebar_agent_order"] && !OmniValidNameList(changes[@"sidebar_agent_order"])) {
+        invalidKey = @"sidebar_agent_order";
+    } else if (changes[@"sidebar_order"] && !OmniValidSidebarKeyList(changes[@"sidebar_order"])) {
+        invalidKey = @"sidebar_order";
+    } else if (changes[@"launch_at_login"] && !OmniIsBoolean(changes[@"launch_at_login"])) {
+        invalidKey = @"launch_at_login";
+    } else if (changes[@"global_shortcut"] && changes[@"global_shortcut"] != NSNull.null &&
+               ![changes[@"global_shortcut"] isKindOfClass:[NSDictionary class]]) {
+        invalidKey = @"global_shortcut";
+    }
+    // Every person-facing setting is validated here too, so the app's own
+    // writes follow the same rules as `set_settings`.
+    NSMutableDictionary *validatedChanges = [NSMutableDictionary dictionaryWithDictionary:changes ?: @{}];
+    if (!invalidKey) {
+        NSDictionary *current = [self settings];
+        for (NSString *key in OmniSettableSettingKeys()) {
+            if (!changes[key]) continue;
+            id value = OmniValidSettingValue(key, changes[key], current, &invalidKey);
+            if (!value) break;
+            invalidKey = nil;
+            validatedChanges[key] = value;
+        }
+    }
+    changes = validatedChanges;
+    if (invalidKey) {
+        if (error) {
+            *error = [NSError errorWithDomain:@"com.omniterm.scheduler"
+                                         code:1
+                                     userInfo:@{ NSLocalizedDescriptionKey: [@"Invalid " stringByAppendingString:invalidKey] }];
+        }
+        return NO;
+    }
+    NSMutableDictionary *settings = [NSMutableDictionary dictionaryWithDictionary:[self settings]];
+    [settings addEntriesFromDictionary:changes ?: @{}];
+    if (changes[@"sidebar_groups"]) {
+        settings[@"sidebar_groups"] = OmniValidGroupList(changes[@"sidebar_groups"]);
+    }
+    if (changes[@"sidebar_agent_order"]) {
+        settings[@"sidebar_agent_order"] = OmniValidNameList(changes[@"sidebar_agent_order"]);
+    }
+    if (changes[@"sidebar_order"]) {
+        settings[@"sidebar_order"] = OmniValidSidebarKeyList(changes[@"sidebar_order"]);
+    }
+    settings[@"schema_version"] = @2;
+    NSData *data = [NSJSONSerialization dataWithJSONObject:settings
+                                                   options:(NSJSONWritingPrettyPrinted | NSJSONWritingSortedKeys)
+                                                     error:error];
+    if (!data || ![data writeToFile:_settingsPath options:NSDataWritingAtomic error:error]) {
+        return NO;
+    }
+    chmod(_settingsPath.fileSystemRepresentation, 0600);
+    dispatch_async(_queue, ^{
+        [self checkNowGuarded];
+    });
+    return YES;
+}
