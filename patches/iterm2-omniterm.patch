+// A read that arrives during a tick stops it after the call in progress: no
+// further batches are drained and no embedding or memory tick starts.
+- (void)testKnowledgeTickYieldsToAWaitingRead {
+    OmniKnowledgeTestScheduler *scheduler = [self knowledgeScheduler];
+    [scheduler setValue:@YES forKey:@"knowledgeEnabled"];
+    NSMutableArray *operations = [NSMutableArray array];
+    __block OmniKnowledgeTestScheduler *weakScheduler = scheduler;
+    __block NSInteger revision = 0;
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        [operations addObject:request[@"op"]];
+        if ([request[@"op"] isEqual:@"ack_writes"]) return @{ @"ok": @YES };
+        if ([request[@"op"] isEqual:@"scan"]) weakScheduler.readWaiting = YES;
+        if (![request[@"op"] isEqual:@"scan"]) return @{ @"ok": @YES, @"backlog_files": @10 };
+        revision++;
+        return @{ @"ok": @YES, @"backlog_files": @10,
+                  @"_writes": @[ @{ @"key": [NSString stringWithFormat:@"message:%ld", (long)revision], @"value": @{ @"text": @"t" } } ],
+                  @"_revision": @(revision), @"_more_writes": @YES };
+    };
+    [scheduler tickKnowledge];
+    XCTAssertEqualObjects(scheduler.knowledgeMaintenance[@"last_yield"], @"request_waiting");
+    XCTAssertFalse([operations containsObject:@"drain_writes"], @"the read is not kept waiting behind more batches");
+    XCTAssertFalse([operations containsObject:@"embed"]);
+    XCTAssertFalse([operations containsObject:@"memory_tick"]);
+    XCTAssertEqualObjects(scheduler.knowledgeMaintenance[@"writes_waiting"], @YES);
+    // Once the read is answered, the next tick saves what was left.
+    scheduler.readWaiting = NO;
+    scheduler.workerRequest = ^NSDictionary *(NSDictionary *request) {
+        return @{ @"ok": @YES };
+    };
+    [scheduler tickKnowledge];
+    XCTAssertEqualObjects(scheduler.knowledgeMaintenance[@"writes_waiting"], @NO);
+    scheduler.workerRequest = nil;
+    [scheduler stop];
+}
