+import AppKit
+import Foundation
+import os
+
+// How long a session page takes to show its first page (`log show
+// --predicate 'category == "session-page"'`).
+let omniSessionPageLog = Logger(subsystem: "com.omniterm.app", category: "session-page")
+
+// One Claude or Codex session from the machine's history, read from the
+// knowledge index and shown as a chat. It opens at the newest message;
+// scrolling up pages in older ones, and a live session's new messages are
+// followed while the end is shown. Transcript text is untrusted: it is shown,
+// never run.
+final class OmniSessionPane: OmniPane, NSTextFieldDelegate {
+    let sessionID: String
+    private let headerBar = OmniFlippedView()
+    private let titleField = NSTextField(labelWithString: "")
+    private let metaLabel = NSTextField(labelWithString: "")
+    private let separatorLine = NSBox()
+    private lazy var resumeButton = OmniPaneText.button("Resume", target: self, action: #selector(resume(_:)))
+    private lazy var showTabButton = OmniPaneText.button("Show Tab", target: self, action: #selector(showTab(_:)))
+    private lazy var renameButton = OmniPaneText.button("Rename", target: self, action: #selector(rename(_:)))
+    private lazy var copyButton = OmniPaneText.button("Copy ID", target: self, action: #selector(copyID(_:)))
+    private lazy var memoryButton = OmniPaneText.button("Search in Memory", target: self, action: #selector(searchMemory(_:)))
+    // Auto-unblock: OmniTerm may answer this session's questions while it waits
