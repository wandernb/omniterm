+    // A file row's menu: open it here, or in the Finder or its app. Paths
+    // are relative to the main checkout.
+    private func fileMenu(_ row: OmniZoneItem?, path: String, open: (() -> Void)?) {
+        guard let row = row as? OmniContextRow else { return }
+        let base = project?["main"] as? String ?? project?["root"] as? String ?? ""
+        let absolute = (base as NSString).appendingPathComponent(path)
+        row.contextMenu = { OmniContextMenus.path(absolute, open: open) }
+    }
