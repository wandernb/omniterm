+    // Command-1 to 7 pick a tab while the page has the keyboard.
+    override func handlePaneShortcut(_ event: NSEvent) -> Bool {
+        if project != nil, tab == .tickets, let tickets,
+           tickets.handleShortcut(event, focused: focusZones.first { window?.firstResponder === $0.zoneFirstResponder }) {
+            return true
+        }
+        guard project != nil, event.modifierFlags.intersection(.deviceIndependentFlagsMask) == .command,
+              let digit = event.charactersIgnoringModifiers.flatMap(Int.init), digit >= 1,
+              let chosen = OmniProjectTab(rawValue: digit - 1) else { return false }
+        let button = NSButton()
+        button.tag = chosen.rawValue
+        tabClicked(button)
+        return true
+    }
+
+    func controlTextDidEndEditing(_ notification: Notification) {
+        guard let field = notification.object as? NSTextField, field.identifier?.rawValue == "project-name",
+              let root = project?["root"] as? String else { return }
+        let value = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard value != (aliases[root] ?? "") else { return }
+        var names = aliases
+        names[root] = value.isEmpty ? nil : value
+        var updated = layout
+        updated["names"] = names
+        OmniSchedulerClient.request(["op": "set_settings", "settings": ["projects": updated]]) { [weak self] response in
+            guard let self else { return }
+            if OmniPane.isOK(response), let settings = response["settings"] as? [String: Any] {
+                self.settings = settings
+                self.setStatus("Saved.", error: false)
+                self.actions?.paneProjectsChanged()
+            } else {
+                self.setStatus(response["error"] as? String ?? "The name could not be saved.", error: true)
+            }
+            self.rebuild()
+        }
+    }
