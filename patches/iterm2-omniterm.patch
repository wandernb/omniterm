+            state = @"claimed";
+        }
+        return @{ @"ok": @YES, @"pending": @(idle && [state isEqual:@"pending"]), @"state": state,
+                  @"token": token, @"startup_prompt": agent[@"startup_prompt"] ?: @"", @"agent": agent };
+    }
+    if ([operation isEqual:@"runner_compacted"]) {
