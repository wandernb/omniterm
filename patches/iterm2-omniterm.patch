@@ -0,0 +1,47 @@
+//
+//  OmniAgentRulesTests.swift
+//  ModernTests
+//
+//  The native agent editor offers helpers/omni's choices and reads the
+//  results of its JSON commands; validation itself stays in the helper.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniAgentRulesTests: XCTestCase {
+    func testTimeoutTextRoundTripsParseDurationUnits() {
+        XCTAssertEqual(OmniAgentRules.timeoutText(7200), "2h")
+        XCTAssertEqual(OmniAgentRules.timeoutText(1800), "30m")
+        XCTAssertEqual(OmniAgentRules.timeoutText(86400), "1d")
+        XCTAssertEqual(OmniAgentRules.timeoutText(90), "90s")
+        XCTAssertEqual(OmniAgentRules.timeoutText(nil), "off")
+    }
+
+    func testDangerousModesAreOfferedAndMarked() {
+        XCTAssertTrue(OmniAgentRules.permissionModes["claude"]?.contains("bypassPermissions") ?? false)
+        XCTAssertTrue(OmniAgentRules.isDangerous(provider: "codex", mode: "dangerous"))
+        XCTAssertFalse(OmniAgentRules.isDangerous(provider: "claude", mode: "auto"))
+        XCTAssertFalse(OmniAgentRules.isDangerous(provider: "codex", mode: "bypassPermissions"))
+    }
+
+    func testHelperOutputDecoding() {
+        let ok = OmniHelper.decode(Data(#"{"ok": true, "phrase": "daily at 09:00"}"#.utf8), status: 0, reason: .exit)
+        XCTAssertEqual(ok["phrase"] as? String, "daily at 09:00")
+        let garbage = OmniHelper.decode(Data("Traceback".utf8), status: 1, reason: .exit)
+        XCTAssertEqual(garbage["ok"] as? Bool, false)
+        XCTAssertEqual(garbage["error"] as? String, "The omni helper failed (exit 1).")
+        let killed = OmniHelper.decode(Data(), status: 15, reason: .uncaughtSignal)
+        XCTAssertEqual(killed["error"] as? String, "The omni helper took too long.")
+    }
+
+    func testSchedulePreviewText() {
+        XCTAssertEqual(OmniAgentEditorView.schedulePreviewText(["ok": false, "error": "Unknown schedule"]),
+                       "Unknown schedule")
+        XCTAssertEqual(OmniAgentEditorView.schedulePreviewText(["ok": true, "phrase": "once", "occurrences": []]),
+                       "once · never runs again")
+        let preview = OmniAgentEditorView.schedulePreviewText(["ok": true, "phrase": "daily at 09:00",
+                                                               "occurrences": [1_800_000_000]])
+        XCTAssertTrue(preview.hasPrefix("daily at 09:00 · next: "))
+    }
+}
