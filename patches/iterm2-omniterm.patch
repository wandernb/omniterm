@@ -0,0 +1,124 @@
+//
+//  OmniRunTabRestoreTests.swift
+//  ModernTests
+//
+//  A run's job that iTerm2 adopts after a relaunch is recognised as a run
+//  tab again by the OMNITERM_* variables in its own process environment.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniRunTabRestoreTests: XCTestCase {
+    // KERN_PROCARGS2's layout: argc, the executable path, padding, argv, env.
+    private func procArgs(argv: [String], environment: [String]) -> Data {
+        var data = Data()
+        var argc = Int32(argv.count)
+        data.append(Data(bytes: &argc, count: MemoryLayout<Int32>.size))
+        data.append(contentsOf: Array("/usr/bin/python3".utf8) + [0, 0, 0, 0])
+        for string in argv + environment {
+            data.append(contentsOf: Array(string.utf8) + [0])
+        }
+        return data
+    }
+
+    func testOnlyTheEnvironmentsOmniTermVariablesAreRead() {
+        let data = procArgs(argv: ["python3", "omni-runner", "OMNITERM_RUN_ID=not-the-environment"],
+                            environment: ["HOME=/Users/someone", "OMNITERM_KIND=run", "OMNITERM_RUN_ID=run-42",
+                                          "OMNITERM_AGENT=Kit=Advance"])
+        XCTAssertEqual(OmniProcessEnvironment.omniTermVariables(fromProcessArguments: data),
+                       ["OMNITERM_KIND": "run", "OMNITERM_RUN_ID": "run-42", "OMNITERM_AGENT": "Kit=Advance"])
+    }
+
+    func testMalformedArgumentsGiveNothing() {
+        XCTAssertEqual(OmniProcessEnvironment.omniTermVariables(fromProcessArguments: Data()), [:])
+        var tooMany = Int32(5)
+        var data = Data(bytes: &tooMany, count: 4)
+        data.append(contentsOf: Array("/bin/x".utf8) + [0, 0] + Array("x".utf8) + [0])
+        XCTAssertEqual(OmniProcessEnvironment.omniTermVariables(fromProcessArguments: data), [:])
+    }
+
+    // macOS hides the environment of its own platform binaries such as
+    // /bin/cat, so the job is a Python process like the run's omni-runner.
+    // /usr/bin/python3 hands over to the developer tools' Python, so the
+    // variables appear once that has started.
+    func testARunningProcessesRunIdentityIsReadBack() throws {
+        let python = "/usr/bin/python3"
+        guard FileManager.default.isExecutableFile(atPath: python) else {
+            throw XCTSkip("No python3 on this machine")
+        }
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: python)
+        process.arguments = ["-c", "import sys; sys.stdin.read()"]
+        process.environment = ["OMNITERM_KIND": "run", "OMNITERM_RUN_ID": "run-7", "PATH": "/usr/bin:/bin"]
+        let input = Pipe()
+        process.standardInput = input
+        try process.run()
+        defer {
+            input.fileHandleForWriting.closeFile()
+            process.waitUntilExit()
+        }
+        var variables: [String: String] = [:]
+        let deadline = Date().addingTimeInterval(10)
+        while variables["OMNITERM_RUN_ID"] == nil && Date() < deadline {
+            RunLoop.main.run(mode: .default, before: Date().addingTimeInterval(0.01))
+            variables = OmniProcessEnvironment.omniTermVariables(forProcess: process.processIdentifier)
+        }
+        XCTAssertEqual(variables["OMNITERM_RUN_ID"], "run-7")
+        XCTAssertEqual(variables["OMNITERM_KIND"], "run")
+        XCTAssertNil(variables["PATH"], "Only OmniTerm's own variables")
+    }
+
+    func testNoProcessGivesNothing() {
+        XCTAssertEqual(OmniProcessEnvironment.omniTermVariables(forProcess: 0), [:])
+        XCTAssertEqual(OmniProcessEnvironment.omniTermVariables(forProcess: -1), [:])
+    }
+
+    // MARK: - The selected tab's page
+
+    func testARunTabShowsItsRunsPage() {
+        let restored: [AnyHashable: Any] = ["OMNITERM_KIND": "run", "OMNITERM_RUN_ID": "run-9", "OMNITERM_AGENT": "Kit Retire"]
+        XCTAssertEqual(OmniSidebarViewController.runRoute(forSessionEnvironments: [restored]), .run("run-9"))
+        XCTAssertEqual(OmniSidebarViewController.runRoute(forSessionEnvironments: [nil, ["TERM": "xterm"], restored]),
+                       .run("run-9"), "Any of the tab's sessions can be the run's")
+    }
+
+    func testOtherTabsShowTheirTerminal() {
+        XCTAssertNil(OmniSidebarViewController.runRoute(forSessionEnvironments: [nil]),
+                     "An adopted job that is not a run, or whose identity could not be read")
+        XCTAssertNil(OmniSidebarViewController.runRoute(forSessionEnvironments: [["OMNITERM_KIND": "dashboard"]]))
+        XCTAssertNil(OmniSidebarViewController.runRoute(forSessionEnvironments: [["OMNITERM_KIND": "run"]]),
+                     "A run tab from before run IDs were saved")
+        XCTAssertNil(OmniSidebarViewController.runRoute(forSessionEnvironments: [["OMNITERM_KIND": "run", "OMNITERM_RUN_ID": ""]]))
+        XCTAssertNil(OmniSidebarViewController.runRoute(forSessionEnvironments: []))
+    }
+
+    // Open Terminal asks for the run's full terminal; following the tab must
+    // not put its page back over it.
+    func testAnExplicitlyOpenedTerminalIsNotCoveredByItsPage() {
+        let run: [[AnyHashable: Any]?] = [["OMNITERM_KIND": "run", "OMNITERM_RUN_ID": "run-9"]]
+        var following = OmniTabFollowing()
+        XCTAssertEqual(following.route(forTab: 4, environments: run), .run("run-9"), "Selected some other way: its page")
+
+        following.terminalShownExplicitly(4)
+        XCTAssertNil(following.route(forTab: 4, environments: run), "Open Terminal: the full terminal stays")
+        XCTAssertEqual(following.route(forTab: 5, environments: run), .run("run-9"), "Another run tab still follows")
+
+        following.pageShown()
+        XCTAssertEqual(following.route(forTab: 4, environments: run), .run("run-9"),
+                       "Once a page is chosen again, the tab follows its run again")
+    }
+}
+
+
+// What OmniTerm changes about iTerm2's restoration of its window.
+final class OmniRestorationTests: XCTestCase {
+    func testOnlySessionsThatAreNotRunTabsAreToldTheirContentsWereNotSaved() {
+        XCTAssertFalse(OmniRestoration.announcesRestoredOrphan(environment: ["OMNITERM_KIND": "run", "OMNITERM_RUN_ID": "run-9"]),
+                       "A run tab, its identity read back on adoption")
+        XCTAssertTrue(OmniRestoration.announcesRestoredOrphan(environment: nil), "A plain terminal")
+        XCTAssertTrue(OmniRestoration.announcesRestoredOrphan(environment: ["TERM": "xterm-256color"]))
+        XCTAssertTrue(OmniRestoration.announcesRestoredOrphan(environment: ["OMNITERM_KIND": "run", "OMNITERM_RUN_ID": ""]),
+                      "A run tab whose run is unknown")
+    }
+}
