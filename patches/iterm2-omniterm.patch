+//
+//  OmniKeyboardMapTests.swift
+//  ModernTests
+//
+//  The keyboard map lists the shortcuts OmniTerm handles, and showing it a
+//  second time closes it.
+//
+
+import XCTest
+@testable import iTerm2SharedARC
+
+final class OmniKeyboardMapTests: XCTestCase {
+    private func keys(in title: String) -> [String] {
+        return OmniKeyboardMap.groups.first { $0.title == title }?.shortcuts.map(\.keys) ?? []
+    }
+
+    func testTheMapListsEachAreasShortcuts() {
+        XCTAssertEqual(OmniKeyboardMap.groups.map(\.title),
+                       ["Sidebar", "Return in the sidebar", "Pages", "Window", "Inbox", "Agent editor", "This map"])
+        XCTAssertTrue(Set(["⌘I", "⌘N", "⇧⌘N", "Tab", "⌥⌘↑ ⌥⌘↓"]).isSubset(of: Set(keys(in: "Sidebar"))))
+        XCTAssertTrue(Set(["⌃⌘S", "⌃⌘1", "⌃⌘2", "⌃⌘3", "⌃⌘4", "⌘W", "⌘Q"]).isSubset(of: Set(keys(in: "Window"))))
+        XCTAssertEqual(keys(in: "Inbox"), ["⇧⌘U", "⌘O", "⌘⌫", "⌘W"])
+        XCTAssertTrue(Set(["⌘B ⌘I", "⌘K", "⌘Return"]).isSubset(of: Set(keys(in: "Agent editor"))))
+        for group in OmniKeyboardMap.groups {
+            XCTAssertEqual(Set(group.shortcuts.map(\.keys)).count, group.shortcuts.count, "\(group.title) repeats a key")
+            XCTAssertFalse(group.shortcuts.contains { $0.action.isEmpty })
+        }
+    }
+
+    // Return does something different on each kind of sidebar row; the map
+    // names every kind and what Return does there.
+    func testTheMapSaysWhatReturnDoesOnEachKindOfRow() {
+        let rows = OmniKeyboardMap.groups.first { $0.title == "Return in the sidebar" }?.shortcuts ?? []
+        XCTAssertEqual(rows, [
+            .init(keys: "Agent, folder", action: "Rename it"),
+            .init(keys: "Run", action: "Focus its terminal, else go into its page"),
+            .init(keys: "Terminal", action: "Focus the terminal"),
+            .init(keys: "Other rows", action: "Go into the Dashboard, Inbox or Memory"),
+        ])
+        XCTAssertFalse(keys(in: "Sidebar").contains("Return"), "Return is listed once, by row")
+    }
+
+    func testShowingTheMapAgainClosesIt() {
+        let window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 900, height: 700), styleMask: [.titled],
+                              backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+        defer { window.close() }
+        XCTAssertFalse(OmniKeyboardMap.isShown(for: window))
+        OmniKeyboardMap.show(for: window)
+        XCTAssertTrue(OmniKeyboardMap.isShown(for: window))
+        OmniKeyboardMap.show(for: window)
+        XCTAssertFalse(OmniKeyboardMap.isShown(for: window))
+        OmniKeyboardMap.show(for: window)
+        OmniKeyboardMap.dismiss(for: window)
+        XCTAssertFalse(OmniKeyboardMap.isShown(for: window))
+    }
+}
