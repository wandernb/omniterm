def request(payload):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.connect(str(SOCKET))
        client.sendall(json.dumps(payload).encode() + b"\n")
        try:
            client.shutdown(socket.SHUT_WR)
        except OSError:
            pass  # The scheduler may already have answered and closed.
        data = b""
        while True:
            chunk = client.recv(65536)
            if not chunk: break
            data += chunk
        return json.loads(data)
    finally:
        client.close()


def lifecycle_note(agent):
    budget = agent.get("run_budget_seconds", 600 if agent.get("kind") == "loop" else 0)
    if not budget:
        return ""
    warning = agent.get("wrap_up_seconds", 120)
    return (f"OmniTerm gives this occurrence a soft work budget of {budget} seconds. "
            f"OmniTerm will attempt a safe wrap-up reminder {warning} seconds before that budget ends. "
            "Finish your current safe unit, verify it, and record remaining work for the next occurrence. "
            "The work budget is not a kill deadline. A loop's next instruction waits for this turn "
            "to finish and uses this same session. Preserve other sessions' work. "
            "Retention is a separate, generous cleanup limit. "
            "When finished, return a final answer and let OmniTerm manage session continuation.")


def provider_argv(agent, run_id=None, resume_session_id=None, automatic_resume=False, session_id=None):
    permissions = agent.get("permission_mode")
    # Tells the agent it is an OmniTerm run and how to reach the person.
    note = OMNI.run_context_note(agent.get("name", "agent"), run_id) if run_id else ""
    note = "\n\n".join(part for part in (note, lifecycle_note(agent)) if part)
    if agent["provider"] == "claude":
        argv = ["claude"]
        if resume_session_id:
            argv += ["--resume", resume_session_id]
        else:
            argv += ["--system-prompt", agent.get("system_prompt", "")]
            if session_id or run_id:
                argv += ["--session-id", session_id or run_id]
        if note:
            argv += ["--append-system-prompt", note]
        if agent.get("model"): argv += ["--model", agent["model"]]
        if permissions: argv += ["--permission-mode", permissions]
    else:
        instructions = "\n\n".join(part for part in (agent.get("system_prompt", ""), note) if part)
        argv = ["codex", "-C", agent["workspace"], "-c", f"developer_instructions={json.dumps(instructions)}",
                "-c", codex_trust_override(agent["workspace"]),
                # The update prompt would take the Enter OmniTerm types to submit
                # /compact or a loop tick, and install an update nobody asked for.
                "-c", "check_for_update_on_startup=false"]
        if agent.get("model"): argv += ["--model", agent["model"]]
        if permissions == CODEX_DANGEROUS_MODE:
            argv.append("--dangerously-bypass-approvals-and-sandbox")
        elif permissions:
            argv += ["--ask-for-approval", permissions]
        if resume_session_id:
            argv += ["resume", resume_session_id]
    argv += agent.get("advanced_args", [])
    if (not resume_session_id or automatic_resume) and agent.get("startup_prompt"):
        # Claude can snapshot its system prompt across resumes. Put the new
        # occurrence's budget in its user prompt too so it cannot be stale.
        prompt = agent["startup_prompt"]
        if automatic_resume and lifecycle_note(agent):
            prompt += "\n\n" + lifecycle_note(agent)
        # `--` ends the options: Claude's variadic flags in advanced args
        # (`--add-dir a b…`) would otherwise take the prompt as one more value
        # and start the session with nothing to do, and a prompt starting with
        # `-` would be read as a flag.
        argv += ["--", prompt]
    return argv


# Equivalent models across harnesses, by capability tier. Codex slugs are matched
# by family name, so a new version needs no change here.
MODEL_TIERS = {"fable": "top", "opus": "top", "astra": "top",
               "sonnet": "mid", "sol": "mid", "terra": "mid",
               "haiku": "small", "luna": "small"}
CLAUDE_TIER_MODELS = {"top": ["fable", "opus"], "mid": ["sonnet"], "small": ["haiku"]}
MEMORY_MANAGED_ID = "memory_consolidator:v1"
MEMORY_FALLBACK_MODEL = "haiku"
CLAUDE_MODEL_LIMIT = re.compile(r"hit your (fable|opus|sonnet|haiku) limit", re.IGNORECASE)


def model_family(model):
    words = re.findall(r"[a-z]+", (model or "").lower())
    return next((word for word in words if word in MODEL_TIERS), None)


def codex_default_model():
    try:
        text = (Path.home() / ".codex/config.toml").read_text()
    except OSError:
        return ""
    found = re.search(r'^model\s*=\s*"([^"]+)"', text, re.MULTILINE)
    return found.group(1) if found else ""


def model_tier(provider, model):
    """A model's tier; a provider default counts as what it runs, Claude's being its best."""
    if not model:
        model = codex_default_model() if provider == "codex" else "fable"
    return MODEL_TIERS.get(model_family(model))


def tier_models(provider, tier):
    """The provider's models in a tier, best first."""
    if provider == "claude":
        return list(CLAUDE_TIER_MODELS.get(tier, []))
    return [slug for slug in OMNI.codex_model_choices() if MODEL_TIERS.get(model_family(slug)) == tier]


def limit_is_model_only(provider, message):
    """Claude limits one model family (\"You've hit your Fable limit\"); otherwise the whole account is out."""
    return provider == "claude" and bool(CLAUDE_MODEL_LIMIT.search(message or ""))


def fallback_candidates(provider, model, tried, exhausted, available):
    """Equivalent models to try after (provider, model) ran out of usage: the other harness first."""
    other = "codex" if provider == "claude" else "claude"
    tier = model_tier(provider, model)
    candidates = [(other, choice) for choice in tier_models(other, tier)] or [(other, "")]
    candidates += [(provider, choice) for choice in tier_models(provider, tier)]
    return [(name, choice) for name, choice in dict.fromkeys(candidates)
            if name not in exhausted and (name, choice) not in tried and available(name)]


def fallback_agent(agent, provider, model, reason, transcript=None):
    """The agent moved to another harness or model, with the task and how far it got."""
    moved = dict(agent, provider=provider, model=model)
    if provider != agent["provider"]:
        # Permission modes and advanced flags are per harness. Only full bypass
        # has a counterpart; anything else falls to the safer provider default.
        dangerous = OMNI.DANGEROUS_PERMISSIONS
        moved["permission_mode"] = dangerous[provider] \
            if agent.get("permission_mode") == dangerous[agent["provider"]] else ""
        moved["advanced_args"] = []
    note = (f"OmniTerm moved this task here because {reason}. Earlier work on it may already be in the "
            "workspace: check what is done before you continue, and do not redo finished work.")
    if transcript:
        note += f" The earlier session's transcript is {transcript}."
    moved["startup_prompt"] = "\n\n".join(part for part in (agent.get("startup_prompt"), note) if part)
    return moved


