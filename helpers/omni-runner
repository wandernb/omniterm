def provider_environment(source=None):
    """Keep managed interactive agents colorful and independent of any parent session."""
    environment = dict(os.environ if source is None else source)
    for name in PARENT_SESSION_ENVIRONMENT:
        environment.pop(name, None)
    environment.pop("NO_COLOR", None)
    environment["CLICOLOR"] = "1"
    environment["FORCE_COLOR"] = "1"
    environment.setdefault("COLORTERM", "truecolor")
    return environment


def login_shell_path(environment):
    """Ask the user's login shell for PATH; GUI launches only get launchd's minimal one."""
    shell = environment.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/zsh"
    try:
        result = subprocess.run([shell, "-lic", f'printf "{PATH_MARKER}%s{PATH_MARKER}" "$PATH"'],
                                stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL,
                                errors="replace",
                                timeout=LOGIN_SHELL_TIMEOUT,
                                start_new_session=True)
    except (OSError, subprocess.SubprocessError):
        return ""
    fields = result.stdout.split(PATH_MARKER)
    return fields[1] if len(fields) == 3 else ""


def provider_search_path(environment):
    """Combine the login-shell PATH, the inherited PATH, and the usual install locations."""
    directories = login_shell_path(environment).split(":")
    directories += environment.get("PATH", "").split(":")
    directories += [os.path.expanduser(directory) for directory in FALLBACK_PATH_DIRECTORIES]
    return ":".join(dict.fromkeys(directory for directory in directories if directory))


def trust_root(workspace):
    """Claude keys folder trust on the repository root, or the folder outside a repository."""
    path = Path(os.path.realpath(workspace))
    home = Path.home()
    for folder in (path, *path.parents):
        if folder == home:
            break
        if (folder / ".git").exists():
            return str(folder)
    return str(path)


def codex_trust_override(workspace):
    """Trust the workspace for this run only. A dotted -c key cannot hold a path, so use a table."""
    folders = dict.fromkeys((os.path.realpath(workspace), trust_root(workspace)))
    tables = ",".join(f'{json.dumps(folder)}={{trust_level="trusted"}}' for folder in folders)
    return f"projects={{{tables}}}"


def ensure_claude_trust(workspace):
    """Pre-accept Claude's folder trust, which no CLI flag can skip in an interactive run.

    A scheduled agent's workspace was chosen explicitly, and nobody is there to answer the prompt.
    An unreadable config is left alone: a prompt is better than damaging provider state.
    """
    config = Path(os.path.realpath(Path.home() / ".claude.json"))
    temporary = config.with_name(f".claude.json.omni-{os.getpid()}")
    root = trust_root(workspace)
    try:
        data = json.loads(config.read_text())
        project = data.setdefault("projects", {}).setdefault(root, {})
        if project.get("hasTrustDialogAccepted") is True:
            return
        project["hasTrustDialogAccepted"] = True
        temporary.write_text(json.dumps(data, indent=2))
        temporary.chmod(config.stat().st_mode & 0o777)
        os.replace(temporary, config)
    except (OSError, ValueError, AttributeError):
        try:
            temporary.unlink()
        except OSError:
            pass


def acquire_start_slot():
    """Space out provider starts across runners.

    Claude refreshes its login in the macOS Keychain at startup, and runs that start
    together fail there with exit 1. This also serializes the ~/.claude.json trust write.
    Waiting is bounded: a stuck holder must delay a run, never lose it.
    """
    try:
        slot = os.open(START_SLOT, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return None
    for _ in range(START_SLOT_ATTEMPTS):
        try:
            fcntl.flock(slot, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return slot
        except BlockingIOError:
            time.sleep(START_SLOT_POLL)
        except OSError:
            break
    os.close(slot)
    return None


def release_start_slot(slot, delay=0):
    """Closing releases the lock. The kernel also releases it if the runner dies first."""
    if slot is None:
        return
    timer = threading.Timer(delay, os.close, (slot,))
    timer.daemon = True
    timer.start()


class ErrorTail:
    """Show a provider's stderr in its tab and keep the end, because the tab closes with the run."""

    def __init__(self):
        self.read_end, self.write_end = os.pipe()
        self.tail = b""
        self.thread = threading.Thread(target=self.pump, daemon=True)
        self.thread.start()

    def pump(self):
        while True:
            try:
                chunk = os.read(self.read_end, 65536)
            except OSError:
                return
            if not chunk:
                return
            self.tail = (self.tail + chunk)[-RUN_LOG_BYTES:]
            try:
                os.write(2, chunk)
            except OSError:
                pass  # The tab has gone; the tail is still worth keeping.

    def close_write_end(self):
        os.close(self.write_end)

    def text(self):
        self.thread.join(1)  # Something the provider left behind may hold the pipe open.
        return TERMINAL_ESCAPE.sub("", self.tail.decode(errors="replace")).strip()


def save_run_log(run_id, text):
    """Keep a failed run's error output, newest logs only."""
    try:
        RUN_LOG_DIRECTORY.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(RUN_LOG_DIRECTORY / f"{run_id}.log", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text + "\n")
        logs = sorted(RUN_LOG_DIRECTORY.glob("*.log"), key=lambda path: path.stat().st_mtime, reverse=True)
        for path in logs[RUN_LOGS_KEPT:]:
            path.unlink()
    except OSError:
        pass  # A log is a diagnostic; it must never change the run's outcome.


def claude_turn_event(event):
    """Whether one Claude transcript event ends a turn, starts one, or says nothing about it."""
    if event.get("isSidechain") or event.get("isMeta"):
        return None
    # Compacting an idle session writes its summary as a user event. Nobody
    # asked anything: the agent still waits at its prompt.
    if event.get("isCompactSummary") or event.get("isVisibleInTranscriptOnly"):
        return None
    if event.get("type") == "user":
        return False
    if event.get("type") != "assistant":
        return None
    message = event.get("message")
    stop_reason = message.get("stop_reason") if isinstance(message, dict) else None
    return stop_reason == "end_turn" and not event.get("isApiErrorMessage")


def codex_turn_event(event):
    """Whether one Codex session event ends a turn, starts one, or says nothing about it."""
    payload = event.get("payload")
    kind = payload.get("type") if event.get("type") == "event_msg" and isinstance(payload, dict) else None
    if kind == "task_complete":
        # Codex closes a turn it refused for usage as complete: no work was done.
        return usage_limit_event(event, "codex") is None
    return False if kind in ("task_started", "turn_aborted") else None


def codex_user_text(event):
    """Read exact user input from either Codex transcript representation."""
    payload = event.get("payload")
    if not isinstance(payload, dict):
        return None
    if event.get("type") == "event_msg" and payload.get("type") == "user_message":
        text = payload.get("message")
        return text if isinstance(text, str) else None
    if event.get("type") == "response_item" and payload.get("type") == "message" \
            and payload.get("role") == "user":
        content = payload.get("content")
        if isinstance(content, list) and len(content) == 1 and isinstance(content[0], dict) \
                and content[0].get("type") == "input_text":
            text = content[0].get("text")
            return text if isinstance(text, str) else None
    return None


def capped(text, limit):
    text = text.strip()
    return text if len(text) <= limit else text[:limit - 1].rstrip() + "…"


def claude_text(message):
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, str):
        return content.strip()
    blocks = content if isinstance(content, list) else []
    return "\n\n".join(block["text"].strip() for block in blocks
                       if isinstance(block, dict) and block.get("type") == "text"
                       and isinstance(block.get("text"), str) and block["text"].strip())


def claude_final_message(event, earlier):
    """The text of the message that ended the turn.

    Claude writes one message as several events, one per content block, sharing the message ID,
    so the end_turn event may hold only the last block.
    """
    message = event.get("message")
    identifier = message.get("id")
    parts = [claude_text(message)]
    for previous in earlier if identifier else ():
        if previous.get("isSidechain") or previous.get("isMeta"):
            continue
        if previous.get("type") == "user":
            break
        if previous.get("type") != "assistant":
            continue
        prior = previous.get("message")
        if not isinstance(prior, dict) or prior.get("id") != identifier:
            break
        parts.append(claude_text(prior))
    return "\n\n".join(part for part in reversed(parts) if part) or None


def codex_final_message(event, earlier):
    """Codex records the turn's last answer on task_complete, but sometimes leaves it null."""
    message = event["payload"].get("last_agent_message")
    if isinstance(message, str) and message.strip():
        return message.strip()
    for previous in earlier:
        payload = previous.get("payload")
        if previous.get("type") != "event_msg" or not isinstance(payload, dict):
            continue
        if payload.get("type") == "agent_message" and isinstance(payload.get("message"), str) \
                and payload["message"].strip():
            return payload["message"].strip()
        if payload.get("type") in ("task_started", "task_complete", "turn_aborted"):
            break
    return None


def usage_limit_event(event, provider):
    """The provider's message when this event says it refused the turn for usage, else None."""
    if provider == "claude":
        if event.get("type") != "assistant" or not event.get("isApiErrorMessage") \
                or event.get("isSidechain") or event.get("error") != "rate_limit":
            return None
        text = claude_text(event.get("message"))
        # A transient 429 is retried by Claude itself; only a spent allowance stops the turn.
        if event.get("apiError") == "usage_limit_reached" or "hit your" in text.lower():
            return text or "usage limit reached"
        return None
    payload = event.get("payload")
    if event.get("type") == "event_msg" and isinstance(payload, dict) and payload.get("type") == "task_complete":
        error = payload.get("error")
        if isinstance(error, dict) and error.get("codex_error_info") == "usage_limit_exceeded":
            return error.get("message") if isinstance(error.get("message"), str) else "usage limit reached"
    return None


def last_usage_limit(path, provider, after_offset=0):
    """The limit message if the transcript's latest turn ended on a usage limit."""
    classify = TURN_READERS["claude" if provider == "claude" else "codex"][0]
    for event in transcript_tail(path, after_offset):
        message = usage_limit_event(event, provider)
        if message:
            return message
        if classify(event) is not None:
            return None
    return None


TURN_READERS = {"claude": (claude_turn_event, claude_final_message),
                "codex": (codex_turn_event, codex_final_message)}


def transcript_events(lines):
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue  # The provider may still be writing the last line.
        if isinstance(event, dict):
            yield event


def transcript_tail(path, after_offset=0):
    """A transcript's end, newest event first."""
    try:
        with path.open("rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            offset = max(after_offset, size - TURN_TAIL_BYTES, 0)
            handle.seek(offset)
            lines = handle.read().splitlines()
    except OSError:
        return iter(())
    if offset > after_offset:
        lines = lines[1:]  # The tail starts mid-line.
    return transcript_events(reversed(lines))


def last_turn(path, classify, final_message=None, after_offset=0):
    """Read a transcript's end, newest event first: whether the turn finished, and its final answer.

    A state of None means nothing there settles it.
    """
    events = transcript_tail(path, after_offset)
    for event in events:
        state = classify(event)
        if state is not None:
            message = final_message(event, events) if state and final_message else None
            return state, capped(message, FINAL_MESSAGE_CHARACTERS) if message else None
    return None, None


def last_turn_state(path, classify):
    return last_turn(path, classify)[0]


class TurnTracker:
    """Follow whether the agent finished its turn, and what it said last.

    An interactive provider stays open at its prompt after finishing, so how the
    process ends says nothing about the work. Its transcript does.
    """

    def __init__(self, provider, session_id):
        self.provider = provider
        self.session_id = session_id
        self.path = None
        self.modified = None
        self.finished = False
        self.final_message = None
        self.after_offset = 0
        self.limit = None

    def baseline(self):
        """Ignore a resumed session's previous completed turn before launching it."""
        path = self.transcript()
        if path:
            try:
                self.after_offset = path.stat().st_size
            except OSError:
                pass

    def transcript(self):
        if not self.path and self.session_id:
            if self.provider == "claude":
                matches = (Path.home() / ".claude/projects").glob(f"*/{self.session_id}.jsonl")
            else:
                matches = (Path.home() / ".codex/sessions").rglob(f"*{self.session_id}.jsonl")
            self.path = next(iter(matches), None)
        return self.path

    def check(self):
        path = self.transcript()
        if not path:
            return self.finished
        try:
            modified = path.stat().st_mtime_ns
        except OSError:
            return self.finished
        if modified != self.modified:
            self.modified = modified
            state, message = last_turn(path, *TURN_READERS["claude" if self.provider == "claude" else "codex"],
                                       after_offset=self.after_offset)
            if state is not None:
                self.finished = state
                self.final_message = message
            self.limit = last_usage_limit(path, self.provider, self.after_offset)
        return self.finished


class TurnReporter:
    """Tell the scheduler as the turn changes: a reboot leaves the runner no chance to report.

    A turn that ends with a different answer is a new finished turn, even if no poll saw it start.
    """

    def __init__(self, run_id, tracker, on_finished=None):
        self.run_id = run_id
        self.tracker = tracker
        self.on_finished = on_finished
        self.reported = (False, None)
        self.suspended = False

    def report(self):
        if self.suspended:
            return  # Compaction must not replace the work's final answer/report.
        finished = self.tracker.check()
        current = (finished, self.tracker.final_message if finished else None)
        if current == self.reported:
            return
        payload = {"op": "runner_turn", "run_id": self.run_id, "finished": finished}
        if finished:
            # Orders this turn's summary against later ones: a slow summarizer must not
            # overwrite the summary of a newer turn.
            payload["turn_at"] = time.time()
            if self.tracker.final_message:
                payload["final_message"] = self.tracker.final_message
            if self.tracker.path:
                payload["transcript_path"] = str(self.tracker.path)
        try:
            request(payload)
        except (OSError, ValueError):
            return  # Try again on the next pass.
        self.reported = current
        if finished and self.on_finished:
            self.on_finished(payload["turn_at"])


def context_usage(path, provider):
    """The session's latest context size and window, from the provider's own usage records."""
    if not isinstance(path, Path):
        return None, None
    try:
        with path.open("rb") as handle:
            handle.seek(max(0, path.stat().st_size - CONTEXT_TAIL_BYTES))
            data = handle.read()
    except OSError:
        return None, None
    for event in reversed(list(transcript_events(data.splitlines()))):
        if provider == "claude" and event.get("type") == "assistant" and not event.get("isSidechain"):
            usage = (event.get("message") or {}).get("usage")
            if isinstance(usage, dict):
                tokens = sum(usage.get(key) or 0 for key in
                             ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
                if tokens:
                    return tokens, None
        if provider == "codex" and event.get("type") == "event_msg":
            payload = event.get("payload") or {}
            info = payload.get("info") if payload.get("type") == "token_count" else None
            if isinstance(info, dict) and isinstance(info.get("last_token_usage"), dict):
                tokens = info["last_token_usage"].get("input_tokens") or 0
                if tokens:
                    return tokens, info.get("model_context_window")
        if provider == "claude" and event.get("type") == "system" and event.get("subtype") == "compact_boundary":
            return 0, None  # Nothing recorded since the last compaction.
        if provider == "codex" and event.get("type") == "compacted":
            return 0, None
    return None, None


def needs_compaction(path, provider):
    tokens, window = context_usage(path, provider)
    if not tokens:
        return False
    limit = window // 2 if isinstance(window, int) and window > 0 else COMPACT_CONTEXT_TOKENS
    return tokens >= limit


def compacted_since(path, offset, provider):
    """Require the provider's persisted compaction boundary, never a TTY echo."""
    if not path:
        return False
    try:
        with path.open("rb") as handle:
            handle.seek(offset)
            data = handle.read(TURN_TAIL_BYTES)
    except OSError:
        return False
    for event in transcript_events(data.splitlines()):
        if provider == "claude" and event.get("type") == "system" \
                and event.get("subtype") == "compact_boundary":
            return True
        if provider == "codex" and event.get("type") == "compacted":
            return True
    return False


def user_turn_since(path, offset, provider):
    """Find actual new user work even when start and finish happen between polls.

    Compaction's synthetic task events and summary messages are not human work.
    Return a byte boundary so the tracker can ignore compact's own final answer.
    """
    if not path:
        return None
    try:
        with path.open("rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            start = max(offset, size - TURN_TAIL_BYTES)
            handle.seek(start)
            data = handle.read(TURN_TAIL_BYTES)
    except OSError:
        return None
    position = start
    found = None
    for index, line in enumerate(data.splitlines(keepends=True)):
        line_start, position = position, position + len(line)
        if index == 0 and start > offset:
            continue
        event = next(transcript_events([line]), {})
        text = None
        if provider == "codex":
            text = codex_user_text(event)
        elif provider == "claude" and event.get("type") == "user" \
                and not any(event.get(key) for key in ("isMeta", "isSidechain", "isCompactSummary")):
            text = claude_text(event.get("message"))
            # Claude records slash-command output as a user event without
            # isMeta. It is provider bookkeeping, not a person's follow-up.
            if text.lstrip().startswith(("<local-command-stdout>", "<local-command-stderr>")):
                continue
        if isinstance(text, str) and text.strip() and not text.lstrip().startswith("/compact") \
                and "<command-name>/compact</command-name>" not in text:
            found = line_start
    return found


def queue_codex_warning(session_id, message, workspace, environment):
    """Queue via Codex's control transport, never keystrokes or another writer.

    A successful CLI exit proves queued, not consumed. Timeout or a nonzero
    result can happen after enqueueing, so both leave delivery uncertain.
    """
    try:
        if not isinstance(session_id, str) or str(uuid.UUID(session_id)) != session_id.lower():
            return "failed"
    except ValueError:
        return "failed"
    try:
        result = subprocess.run(
            ["codex", "queue", "--thread", session_id, "--message", message],
            cwd=workspace, env=environment, stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=QUEUE_TIMEOUT_SECONDS, check=False)
        return "queued" if result.returncode == 0 else "uncertain"
    except subprocess.TimeoutExpired:
        return "uncertain"
    except OSError:
        return "failed"


def queued_warning_receipt(path, offset, message, provider="codex"):
    if not path or offset is None:
        return None
    try:
        with path.open("rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            start = max(offset, size - TURN_TAIL_BYTES)
            handle.seek(start)
            data = handle.read(TURN_TAIL_BYTES)
    except OSError:
        return None
    position = start
    for index, line in enumerate(data.splitlines(keepends=True)):
        line_start, position = position, position + len(line)
        if index == 0 and start > offset:
            continue
        event = next(transcript_events([line]), {})
        # Match exact input, never an assistant quote or a substring echo.
        if provider == "codex" and codex_user_text(event) == message:
            return line_start
        if provider == "claude" and event.get("type") == "user" and not event.get("isSidechain"):
            # Peer transport wraps the attributed message in escaped XML text.
            text = html.unescape(claude_text(event.get("message")))
            if text == message or ("<cross-session-message" in text and message in text):
                return line_start
    return None


class SessionLifecycle:
    """One occurrence's soft reminder and optional compact-before-reuse handshake.

    PTY delivery is delegated to the native run-scoped handler. A queued command
    is never evidence of compaction. Failure leaves the provider alive.
    """

    def __init__(self, agent, run_id, tracker, started, environment=None):
        self.agent, self.run_id, self.tracker = agent, run_id, tracker
        self.started = started
        self.warned = False
        self.compact_requested = False
        self.compact_offset = None
        self.compact_started = None
        self.compact_complete = False
        self.compact_wanted = None
        self.ended = False
        self.notified = False
        self.warning_notified = False
        self.finish_requested = False
        self.human_intervened = False
        self.compact_acknowledged = False
        self.environment = environment
        self.warning_queue_state = None
        self.warning_offset = None
        self.warning_consumed = False
        self.warning_queued_at = None
        self.warning_request_id = str(uuid.uuid4())
        self.warning_message = (
            f"[OmniTerm wrap-up {run_id}:{self.warning_request_id}] "
            "This occurrence is approaching its soft work budget. "
            "Start wrapping up: finish the current safe unit, verify it, record remaining work, "
            "and return your final report. This is not a kill deadline; do not abandon work unsafely.")

    def queue_warning(self):
        path = self.tracker.transcript()
        try:
            self.warning_offset = path.stat().st_size if path else None
        except OSError:
            self.warning_offset = None
        if self.warning_offset is None:
            self.warning_queue_state = "failed"
        elif self.agent.get("provider") == "claude":
            # Peer delivery can reach a busy provider without typing into its
            # TTY. An ambiguous socket outcome must never be retried.
            try:
                response = request({"op": "send_session_message",
                                    "session_id": f"claude:{self.tracker.session_id}",
                                    "request_id": self.warning_request_id,
                                    "message": self.warning_message,
                                    "sender_name": "OmniTerm wrap-up"})
                receipt = response.get("receipt")
                state = receipt.get("state") if isinstance(receipt, dict) else None
                if response.get("ok") and state in ("queued", "sending", "sent", "delivered"):
                    self.warning_queue_state = "queued"
                elif state in ("rejected", "failed"):
                    self.warning_queue_state = "failed"
                else:
                    self.warning_queue_state = "uncertain"
            except (OSError, ValueError):
                self.warning_queue_state = "uncertain"
        elif self.agent.get("provider") == "codex" and self.environment is not None:
            self.warning_queue_state = queue_codex_warning(
                self.tracker.session_id, self.warning_message, self.agent["workspace"], self.environment)
        else:
            self.warning_queue_state = "failed"
        if self.warning_queue_state != "queued":
            self.report_warning_failure()

    def confirm_warning(self):
        if self.warning_queue_state not in ("queued", "uncertain") or self.warning_consumed:
            return
        offset = queued_warning_receipt(self.tracker.transcript(), self.warning_offset, self.warning_message,
                                         self.tracker.provider)
        if offset is not None:
            self.warning_consumed = True
            # The earlier task's final answer cannot close the provider while
            # its queued reminder is still starting a new turn.
            self.tracker.after_offset = offset
            self.tracker.modified = None
            self.tracker.finished = False
            self.tracker.check()

    def warning_pending(self):
        return self.warning_queue_state in ("queued", "uncertain") and not self.warning_consumed

    def resume_reporting(self, reporter):
        if self.compact_offset is None or self.human_intervened:
            return
        offset = user_turn_since(self.tracker.transcript(), self.compact_offset, self.tracker.provider)
        if offset is not None:
            self.human_intervened = True
            self.tracker.after_offset = offset
            self.tracker.modified = None
            reporter.suspended = False
            reporter.reported = (False, None)

    def confirm_compaction(self):
        if self.compact_offset is not None and not self.compact_complete \
                and self.input_status("compact") == "delivered" \
                and compacted_since(self.tracker.transcript(), self.compact_offset, self.tracker.provider):
            self.compact_complete = True
        if self.compact_complete and not self.compact_acknowledged:
            try:
                self.compact_acknowledged = request({"op": "runner_compacted", "run_id": self.run_id}).get("ok", False)
            except (OSError, ValueError):
                pass

    def reuses_session(self):
        return self.agent.get("kind") == "loop" or self.agent.get("session_policy", "resume") != "fresh"

    def wants_compaction(self):
        """Compact a finished turn when asked to, or when a reused session has grown large.

        Decided once per occurrence so the loop and the close path agree.
        """
        if self.compact_wanted is None:
            self.compact_wanted = bool(self.agent.get("compact_on_end")) or (
                self.agent.get("auto_compact", True) and self.reuses_session() and needs_compaction(self.tracker.transcript(), self.tracker.provider))
        return self.compact_wanted

    def input_status(self, action):
        try:
            return request({"op": "runner_input_status", "run_id": self.run_id,
                            "action": action}).get("state")
        except (OSError, ValueError):
            return None

    def report_compact_failure(self, unconfirmed=False):
        if self.notified:
            return
        self.notified = True
        try:
            request(OMNI.notify_payload(
                "Session compaction needs attention",
                body=("OmniTerm could not confirm compaction within five minutes. " if unconfirmed else
                      "OmniTerm could not safely submit /compact. ") + "The completed session remains open; "
                     "compact and close it manually to make it available for a later occurrence.",
                severity="attention", run_id=self.run_id, include_diff=False,
                dedupe_key=f"compact-{self.run_id}", kind="compaction"))
        except (OSError, ValueError):
            pass

    def report_warning_failure(self, unconfirmed=False):
        if self.warning_notified:
            return
        self.warning_notified = True
        provider = "Claude" if self.agent.get("provider") == "claude" else "Codex"
        detail = (f"The {provider} wrap-up reminder has not been confirmed in the session transcript "
                  "within five minutes. OmniTerm is leaving the session open."
                  if unconfirmed else
                  f"OmniTerm could not confirm that {provider} accepted its wrap-up reminder. "
                  "It will not retry or close a session with uncertain queued work.")
        try:
            request(OMNI.notify_payload(
                "Wrap-up reminder could not be delivered safely",
                body=detail + " Its startup instructions already include the soft work budget.",
                severity="attention", run_id=self.run_id, include_diff=False,
                dedupe_key=f"wrap-up-{self.run_id}", kind="wrap_up"))
        except (OSError, ValueError):
            pass

    def send(self, action):
        try:
            return request({"op": "runner_input", "run_id": self.run_id,
                            "action": action}).get("ok", False)
        except (OSError, ValueError):
            return False

    def poll(self, now):
        if self.ended:
            return
        self.confirm_warning()
        self.confirm_compaction()
        if self.human_intervened:
            return  # The person owns this session now; never auto-close their follow-up.
        finished = self.tracker.finished
        budget = self.agent.get("run_budget_seconds", 600 if self.agent.get("kind") == "loop" else 0)
        warning = self.agent.get("wrap_up_seconds", 120)
        if budget and not finished and not self.warned and now - self.started >= max(0, budget - warning):
            # At most one request: don't type repeatedly if a UI rejects delivery.
            self.warned = True
            self.warning_queued_at = now
            self.queue_warning()
        if self.warning_pending():
            if self.warning_queued_at is not None and now - self.warning_queued_at >= 300:
                self.report_warning_failure(unconfirmed=True)
            return  # A queued reminder must be consumed before compaction or idle close.
        if not finished:
            return
        reuse = "resume" if self.reuses_session() else "fresh"
        if self.wants_compaction() and not self.compact_complete:
            if not self.compact_requested:
                self.compact_requested = True
                path = self.tracker.transcript()
                try:
                    offset = path.stat().st_size if path else None
                except OSError:
                    offset = None
                if offset is not None and self.send("compact"):
                    self.compact_offset = offset
                    self.compact_started = now
                else:
                    self.report_compact_failure()
                return
            status = self.input_status("compact")
            if status == "rejected":
                self.compact_offset = None
                self.report_compact_failure()
            if status != "delivered":
                if self.compact_started is not None and now - self.compact_started >= 300:
                    self.report_compact_failure(unconfirmed=True)
                return
            if self.compact_offset is None or not compacted_since(
                    self.tracker.transcript(), self.compact_offset, self.tracker.provider):
                if self.compact_started is not None and now - self.compact_started >= 300:
                    self.report_compact_failure(unconfirmed=True)
                return
            self.confirm_compaction()
            if not self.compact_complete:
                return
        # OmniTerm's own housekeeping agents run unattended: nobody answers them,
        # so a finished turn ends the session rather than idling at the prompt.
        unattended = bool(self.agent.get("omni_managed"))
        if self.agent.get("kind") == "loop" or (reuse != "resume" and not unattended):
            return
        if not self.finish_requested:
            self.finish_requested = True
            self.send("finish")
            return
        if self.input_status("finish") != "delivered":
            return
        self.ended = True


class LoopContinuation:
    """Claim one coalesced tick and feed it to the existing idle provider.

    Claims precede external delivery. Ambiguous delivery is never retried; only
    a matching user-message receipt advances the cycle and resets its budget.
    """

    def __init__(self, lifecycle, reporter):
        self.lifecycle, self.reporter = lifecycle, reporter
        self.claim = None
        self.message = None
        self.offset = None
        self.queued_at = None
        self.notified = False

    def call(self, operation, **values):
        payload = {"op": operation, **values}
        if operation != "send_session_message":
            payload["run_id"] = self.lifecycle.run_id
        try:
            return request(payload)
        except (OSError, ValueError):
            return {}

    def notify_pending(self):
        if self.notified:
            return
        self.notified = True
        self.call("notify", **{key: value for key, value in OMNI.notify_payload(
            "Loop continuation needs attention",
            body="The next loop instruction has not been confirmed in the existing session. "
                 "OmniTerm is keeping this single run open and will not create another instance "
                 "or resend an uncertain instruction.",
            severity="attention", run_id=self.lifecycle.run_id, include_diff=False,
            dedupe_key=f"loop-continuation-{self.lifecycle.run_id}", kind="loop_continuation").items() if key != "op"})

    def begin(self, claim, now, recovery=False):
        self.claim = claim
        token = claim["token"]
        agent = claim.get("agent", self.lifecycle.agent)
        self.message = f"[OmniTerm loop tick {token}]\n{claim['startup_prompt']}"
        note = lifecycle_note(agent)
        if note:
            self.message += "\n\n" + note
        path = self.lifecycle.tracker.transcript()
        try:
            self.offset = 0 if recovery else path.stat().st_size
        except (OSError, AttributeError):
            self.offset = None
        self.queued_at = now
        if recovery:
            return  # A preceding supervisor may already have sent it.
        if self.offset is None:
            self.notify_pending()
            return
        tracker = self.lifecycle.tracker
        if agent.get("provider") == "codex":
            state = queue_codex_warning(tracker.session_id, self.message,
                                        agent["workspace"], self.lifecycle.environment)
            if state != "queued":
                self.notify_pending()
        elif agent.get("provider") == "claude":
            response = self.call("send_session_message", session_id=f"claude:{tracker.session_id}",
                                 request_id=token, message=self.message, sender_name="OmniTerm loop")
            if not response.get("ok") or response.get("receipt", {}).get("state") in ("rejected", "failed"):
                self.notify_pending()
        else:
            self.notify_pending()

    def poll(self, now):
        lifecycle = self.lifecycle
        if lifecycle.agent.get("kind") != "loop":
            return
        if self.claim:
            offset = queued_warning_receipt(lifecycle.tracker.transcript(), self.offset, self.message,
                                             lifecycle.tracker.provider)
            if offset is None:
                if now - self.queued_at >= 300:
                    self.notify_pending()
                return
            if not self.call("runner_loop_ack", token=self.claim["token"]).get("ok"):
                return
            agent = dict(self.claim.get("agent", lifecycle.agent))
            tracker = lifecycle.tracker
            tracker.after_offset, tracker.modified, tracker.finished = offset, None, False
            tracker.check()
            lifecycle.__init__(agent, lifecycle.run_id, tracker, now, lifecycle.environment)
            self.reporter.suspended = False
            self.reporter.reported = (False, None)
            self.claim = self.message = self.offset = self.queued_at = None
            self.notified = False
            return
        pending = self.call("runner_loop_poll")
        if pending.get("pending") and not pending.get("startup_prompt"):
            self.notify_pending()
            return
        if pending.get("state") == "claimed" and pending.get("token") and pending.get("startup_prompt"):
            self.begin(pending, now, recovery=True)
            return
        if not lifecycle.tracker.finished or lifecycle.warning_pending():
            return
        # A compaction that already needed attention must not stall the loop.
        if lifecycle.wants_compaction() and not lifecycle.compact_acknowledged and not lifecycle.notified:
            return
        if pending.get("ok") and pending.get("pending") and pending.get("token") \
                and pending.get("startup_prompt"):
            claimed = self.call("runner_loop_claim", token=pending["token"])
            if claimed.get("ok"):
                self.begin(claimed, now)


def watch_turn(reporter, stop, lifecycle=None, on_limit=None):
    continuation = LoopContinuation(lifecycle, reporter) if lifecycle else None
    while not stop.wait(TURN_POLL_SECONDS):
        if on_limit:
            reporter.tracker.check()
            if reporter.tracker.limit:
                on_limit(reporter.tracker.limit)
                return
        if lifecycle:
            lifecycle.confirm_warning()
            lifecycle.resume_reporting(reporter)
            reporter.suspended = lifecycle.warning_pending() or (
                lifecycle.compact_offset is not None and not lifecycle.human_intervened)
        reporter.report()
        if lifecycle:
            # A newly consumed loop instruction starts a fresh budget before
            # the lifecycle can evaluate the preceding cycle's deadline.
            continuation.poll(time.monotonic())
            # Consumption clears native idle status. Publish a turn that
            # already finished before requesting idle-only compaction.
            reporter.report()
            lifecycle.poll(time.monotonic())
            reporter.suspended = lifecycle.warning_pending() or (
                lifecycle.compact_offset is not None and not lifecycle.human_intervened)


def summary_settings():
    """Whether AI summaries are on, and the model. The scheduler may not pass unknown keys through."""
    settings = {}
    try:
        settings = request({"op": "get_settings"}).get("settings") or {}
    except (OSError, ValueError):
        pass
    if "summaries" not in settings or "summary_model" not in settings:
        try:
            stored = json.loads(SETTINGS_FILE.read_text())
        except (OSError, ValueError):
            stored = {}
        if isinstance(stored, dict):
            settings = {**stored, **settings}
    model = settings.get("summary_model")
    if not isinstance(model, str) or not model.strip() or model.strip().startswith("-"):
        model = SUMMARY_DEFAULT_MODEL
    return settings.get("summaries", True) is not False, model.strip()


def listed(items, limit):
    lines = [f"- {item}" for item in items[:limit]]
    if len(items) > limit:
        lines.append(f"- … and {len(items) - limit} more")
    return lines or ["- none"]


def summary_prompt(run):
    """What the summarizer sees: the run's facts and the agent's own last word, capped."""
    def text(key):
        value = run.get(key)
        return value.strip() if isinstance(value, str) else ""

    def items(key):
        value = run.get(key)
        return value if isinstance(value, list) else []

    commits = [capped(str(commit.get("subject") or commit.get("sha") or ""), SUMMARY_LINE_CHARACTERS)
               for commit in items("commits") if isinstance(commit, dict)]
    files = [capped(path, SUMMARY_LINE_CHARACTERS) for path in items("diff_files") if isinstance(path, str)]
    lines = [f"Agent: {text('agent') or 'unknown'} ({text('provider') or 'unknown provider'})",
             f"Run state: {text('state') or 'unknown'} {text('reason')}".rstrip(),
             "The agent has finished its turn. Its session stays open at the prompt afterwards, "
             "so a running state does not mean the work is unfinished.",
             f"Workspace: {text('workspace') or 'unknown'}",
             f"Branch: {text('branch') or 'unknown'}",
             f"Commits made during the run ({len(commits)}):", *listed(commits, SUMMARY_COMMITS_LISTED),
             f"Files changed since the run started ({len(files)}, diff {text('diff_state') or 'unknown'}):",
             *listed(files, SUMMARY_FILES_LISTED),
             "The agent's final message:", "<<<",
             capped(text("final_message"), FINAL_MESSAGE_CHARACTERS) or "(none)", ">>>"]
    return capped("\n".join(lines), SUMMARY_PROMPT_CHARACTERS)


def summarizer_argv(model):
    # --safe-mode: no hooks, plugins, CLAUDE.md or MCP servers, but the normal login.
    # --strict-mcp-config without --mcp-config: no MCP servers, so not the omni one either.
    # --tools "": no tools. --no-session-persistence: no transcript for a hand-started-session
    # watcher to mistake for a run. The prompt goes on stdin: --tools would swallow a positional one.
    return ["claude", "-p", "--model", model, "--safe-mode", "--tools", "", "--strict-mcp-config",
            "--no-session-persistence", "--disable-slash-commands", "--system-prompt", SUMMARY_INSTRUCTIONS,
            "--output-format", "text"]


def summarizer_environment(search_path, source=None):
    """The provider environment, without the run's identity: a summary is not a run."""
    environment = provider_environment(source)
    for name in ("OMNI_RUN_ID", "OMNI_AGENT", "OMNITERM_RUN_ID", "FORCE_COLOR", "CLICOLOR"):
        environment.pop(name, None)
    environment["NO_COLOR"] = "1"
    environment["PATH"] = search_path
    return environment


def run_summarizer(model, prompt, search_path):
    """Return (summary, error)."""
    with tempfile.TemporaryDirectory(prefix="omni-summary-") as folder:
        try:
            process = subprocess.Popen(summarizer_argv(model), cwd=folder,
                                       env=summarizer_environment(search_path),
                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       text=True, errors="replace", start_new_session=True)
        except OSError as error:
            return None, f"could not start claude: {error}"
        try:
            output, errors = process.communicate(prompt, timeout=SUMMARY_TIMEOUT)
        except subprocess.TimeoutExpired:
            signal_group(process.pid, signal.SIGKILL)
            process.communicate()
            return None, f"claude timed out after {SUMMARY_TIMEOUT}s"
    output = TERMINAL_ESCAPE.sub("", output).strip()
    if process.returncode != 0 or not output:
        lines = TERMINAL_ESCAPE.sub("", errors).strip().splitlines()
        detail = lines[-1][:REASON_CHARACTERS] if lines else "no output"
        return None, f"claude exit {process.returncode}: {detail}"
    return capped("\n".join(output.splitlines()[:SUMMARY_LINES]), SUMMARY_CHARACTERS), None


def wait_for_diff(run_id, turn_at=None):
    """The run as the scheduler has it, once its diff is captured or the wait runs out.

    `turn_at` names the finished turn: a loop may record it as a run of its own
    and start its next turn while this waits, and the summary is of that turn.
    """
    deadline = time.monotonic() + SUMMARY_DIFF_WAIT
    query = {"op": "get_run", "id": run_id}
    if turn_at is not None:
        query["turn_at"] = turn_at
    while True:
        response = request(query)
        if not response.get("ok"):
            return None
        run = response.get("run") or {}
        if run.get("diff_state") != "pending" or time.monotonic() >= deadline:
            return run
        time.sleep(SUMMARY_POLL)


def report_summary(run_id, summary, error, turn_at=None):
    payload = {"op": "run_summary", "run_id": run_id, "state": "ready" if summary else "failed"}
    if turn_at is not None:
        payload["turn_at"] = turn_at
    payload.update({"summary": summary} if summary else {"error": capped(error or "no summary", REASON_CHARACTERS)})
    try:
        request(payload)
    except (OSError, ValueError):
        pass  # Surfaces fall back to the final message.


def summarize(run_id, turn_at=None):
    """Write the AI summary of a run's finished turn. Runs detached from the runner."""
    try:
        enabled, model = summary_settings()
        if not enabled:
            return report_summary(run_id, None, "AI summaries are turned off", turn_at)
        run = wait_for_diff(run_id, turn_at)
        if run is None:
            return
        summary, error = run_summarizer(model, summary_prompt(run), os.environ.get("PATH", ""))
        report_summary(run_id, summary, error, turn_at)
    except Exception as error:  # A detached process: anything left unreported stays pending forever.
        report_summary(run_id, None, str(error) or type(error).__name__, turn_at)


def start_summarizer(run_id, search_path, turn_at=None):
    """Summarize in a detached process of its own, so neither the tab nor the provider notices.

    It outlives the runner when the tab closes right after the turn.
    """
    try:
        argv = [sys.executable, os.path.realpath(__file__), "--summarize", run_id]
        if turn_at is not None:
            argv.append(repr(float(turn_at)))
        process = subprocess.Popen(argv,
                                   cwd="/", env=summarizer_environment(search_path),
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return None
    threading.Thread(target=process.wait, daemon=True).start()
    return process


def run_outcome(code, closed, error_text="", turn_finished=False):
    """Separate what a person or the scheduler ended from what actually failed.

    A finished turn is a completed run, whatever ended the idle session afterwards.
    """
    if closed:
        state, reason = "closed", "tab closed"
    elif code == 0:
        return "completed", "exit 0"
    elif code in (-signal.SIGTERM, 128 + signal.SIGTERM):
        state, reason = "stopped", "stopped"
    else:
        lines = error_text.splitlines()
        state, reason = "failed", f"exit {code}: {lines[-1][:REASON_CHARACTERS]}" if lines else f"exit {code}"
    return ("completed", f"agent finished, then {reason}") if turn_finished else (state, reason)


def signal_group(process_group, number):
    try:
        os.killpg(process_group, number)
    except (ProcessLookupError, PermissionError):
        pass


def end_provider(process_group):
    """A closed tab takes the runner's terminal; the provider has its own session, so tell it."""
    signal_group(process_group, signal.SIGHUP)
    timer = threading.Timer(PROVIDER_CLOSE_GRACE, signal_group, (process_group, signal.SIGKILL))
    timer.daemon = True
    timer.start()


def forward_terminal_resize(process_group):
    """Notify the isolated provider group after iTerm updates the PTY size."""
    try:
        os.killpg(process_group, signal.SIGWINCH)
    except (ProcessLookupError, PermissionError):
        pass


def codex_session_files():
    root = Path.home() / ".codex/sessions"
    return {path for path in root.rglob("*.jsonl")} if root.exists() else set()


def codex_session_id(path, workspace, run_id=None):
    try:
        with path.open("rb") as handle:
            # Two loops can start in the same workspace at once. The per-run
            # context note identifies ownership; cwd and newest-file order do not.
            data = handle.read(TURN_TAIL_BYTES)
            if run_id is not None and run_id.encode() not in data:
                return None
            for event in transcript_events(data.splitlines()[:8]):
                if event.get("type") == "session_meta":
                    payload = event.get("payload", {})
                    if payload.get("cwd") == workspace:
                        return payload.get("id")
    except (OSError, ValueError, json.JSONDecodeError):
        return None
    return None


def report_finished(run_id, state, reason, started):
    """Record the outcome; the app closes the tab as soon as this process exits."""
    try: request({"op": "runner_finished", "run_id": run_id, "state": state, "reason": reason})
    except (OSError, ValueError): pass
    runtime = int(time.monotonic() - started)
    try:
        print(f"\n── OmniTerm run {state}: {reason} · {runtime}s ──", flush=True)
    except OSError:
        pass  # A closed tab has no terminal left to print to.


def main():
    if sys.argv[1:2] == ["--summarize"] and len(sys.argv) in (3, 4):
        try:
            turn_at = float(sys.argv[3]) if len(sys.argv) == 4 else None
        except ValueError:
            turn_at = None
        return summarize(sys.argv[2], turn_at)
    run_id = sys.argv[1]
    response = request({"op": "run_spec", "run_id": run_id})
    if not response.get("ok"):
        raise SystemExit(response.get("error", "Run not found"))
    agent = response["agent"]
    run = response["run"]
    resume_session_id = run.get("resume_session_id") if isinstance(run.get("resume_session_id"), str) else None
    automatic_resume = bool(resume_session_id and run.get("reason") != "resumed")
    fresh_fallback = False
    known_session_id = run.get("session_id") if isinstance(run.get("session_id"), str) else None
    tracker = TurnTracker(agent["provider"], known_session_id)
    if automatic_resume and tracker.transcript() is None:
        # Retention outside OmniTerm may have removed the provider's history.
        # A scheduled occurrence still has useful work to do; manual resume
        # deliberately retains the provider's normal missing-session error.
        resume_session_id = None
        automatic_resume = False
        fresh_fallback = True
        known_session_id = run_id if agent["provider"] == "claude" else None
        tracker = TurnTracker(agent["provider"], known_session_id)
    if resume_session_id:
        tracker.baseline()
    started = time.monotonic()
    environment = provider_environment()
    environment["PATH"] = provider_search_path(environment)
    # Lets `omni notify` and notify_user say which run sent a notification.
    environment["OMNI_RUN_ID"] = run_id
    environment["OMNI_AGENT"] = agent["name"]
    closed = threading.Event()
    current = {"child": None}

    def on_close(*_):
        closed.set()
        if current["child"]:
            end_provider(current["child"].pid)

    signal.signal(signal.SIGWINCH,
                  lambda *_: current["child"] and forward_terminal_resize(current["child"].pid))
    signal.signal(signal.SIGHUP, on_close)
    signal.signal(signal.SIGTERM, on_close)
    # A person's reopened session stays theirs: they see the limit and can switch models.
    falls_back = run.get("reason") != "resumed"

    def attempt(launch, tracker, resume_session_id, automatic_resume, session_id=None, first=True):
        """Run the provider once. Returns (exit code, stderr tail, usage-limit message), or None if it could not start."""
        invocation_agent = dict(launch)
        if run.get("reason") == "resumed":
            invocation_agent.update(run_budget_seconds=0)
        argv = provider_argv(invocation_agent, run_id=run_id, resume_session_id=resume_session_id,
                             automatic_resume=automatic_resume, session_id=session_id)
        previous_codex_files = codex_session_files() if launch["provider"] == "codex" and not resume_session_id else set()
        slot = acquire_start_slot()
        if launch["provider"] == "claude":
            ensure_claude_trust(launch["workspace"])
        errors = ErrorTail()
        try:
            child = subprocess.Popen(argv,
                                     cwd=launch["workspace"],
                                     env=environment,
                                     stderr=errors.write_end,
                                     start_new_session=True)
        except OSError as error:
            errors.close_write_end()
            release_start_slot(slot)
            report_finished(run_id, "failed", f"could not start {argv[0]}: {error}", started)
            return None
        release_start_slot(slot, START_SPACING)
        errors.close_write_end()
        current["child"] = child
        if closed.is_set():
            end_provider(child.pid)
        if first:
            started_payload = {"op": "runner_started", "run_id": run_id, "pid": os.getpid(), "pgid": child.pid,
                               "session_id": known_session_id}
            if fresh_fallback:
                started_payload["fresh_session"] = True
            request(started_payload)
        reporter = TurnReporter(run_id, tracker, lambda turn_at: start_summarizer(run_id, environment["PATH"], turn_at))
        stop_watching = threading.Event()
        lifecycle_agent = dict(launch)
        if run.get("reason") == "resumed":
            # A person reopening history is an interactive session, even when the
            # agent's scheduled occurrences reuse and close their sessions.
            lifecycle_agent.update(session_policy="fresh", run_budget_seconds=0, compact_on_end=False, auto_compact=False)
            lifecycle_agent.pop("omni_managed", None)
        lifecycle = SessionLifecycle(lifecycle_agent, run_id, tracker, started, environment)
        limit = {}

        def on_limit(message):
            limit["message"] = message
            end_provider(child.pid)

        watcher = threading.Thread(target=watch_turn, args=(reporter, stop_watching, lifecycle,
                                                            on_limit if falls_back else None), daemon=True)
        watcher.start()
        if launch["provider"] == "codex" and not resume_session_id:
            def find_session():
                for _ in range(60):
                    candidates = codex_session_files() - previous_codex_files
                    candidates = sorted(candidates, key=lambda path: path.stat().st_mtime, reverse=True)
                    for path in candidates:
                        session_id = codex_session_id(path, launch["workspace"], run_id)
                        if session_id:
                            tracker.session_id = session_id
                            # The run row keeps its original harness's session; a
                            # fallback session is only followed here.
                            if first:
                                try: request({"op": "runner_session", "run_id": run_id, "session_id": session_id})
                                except OSError: pass
                            return
                    time.sleep(0.5)
            threading.Thread(target=find_session, daemon=True).start()
        code = child.wait()
        stop_watching.set()
        watcher.join(TURN_POLL_SECONDS)
        if not limit:
            reporter.report()  # A tab closed right after the turn still gets its final message and summary.
        return code, errors.text(), limit.get("message")

    launch = agent
    result = attempt(launch, tracker, resume_session_id, automatic_resume)
    tried = {(agent["provider"], agent.get("model") or "")}
    exhausted = set()
    moves = []
    while result and result[2] and not closed.is_set():
        message = result[2]
        provider, model = launch["provider"], launch.get("model") or ""
        if not limit_is_model_only(provider, message):
            exhausted.add(provider)
        candidates = fallback_candidates(provider, model, tried, exhausted,
                                         lambda name: shutil.which(name, path=environment["PATH"]) is not None)
        if not candidates:
            report_finished(run_id, "failed", capped(f"usage limit on {model_label(provider, model)}, "
                                                     f"no equivalent model available: {message}", REASON_CHARACTERS),
                            started)
            return
        next_provider, next_model = candidates[0]
        tried.add(candidates[0])
        reason = f"{model_label(provider, model)} ran out of usage ({message})"
        moves.append(model_label(next_provider, next_model))
        try:
            print(f"\n── OmniTerm: {reason}. Continuing on {moves[-1]}. ──\n", flush=True)
        except OSError:
            pass
        launch = fallback_agent(launch, next_provider, next_model, reason, tracker.transcript())
        session_id = str(uuid.uuid4()) if next_provider == "claude" else None
        tracker = TurnTracker(next_provider, session_id)
        result = attempt(launch, tracker, None, False, session_id=session_id, first=False)
    if result is None:
        return
    code, error_text, _ = result
    state, reason = run_outcome(code, closed.is_set(), error_text, tracker.check())
    if state == "failed" and falls_back and agent.get("omni_managed") == MEMORY_MANAGED_ID \
            and launch["provider"] == "codex" and shutil.which("claude", path=environment["PATH"]):
        # Memory consolidation is cheap, routine work: when Codex is unavailable
        # (usage, sign-in, a failed start) the same run continues on Claude Haiku.
        save_run_log(run_id, error_text)
        cause = f"{model_label('codex', launch.get('model') or '')} failed ({reason})"
        moves.append(model_label("claude", MEMORY_FALLBACK_MODEL))
        try:
            print(f"\n── OmniTerm: {cause}. Continuing on {moves[-1]}. ──\n", flush=True)
        except OSError:
            pass
        launch = dict(fallback_agent(launch, "claude", MEMORY_FALLBACK_MODEL, cause, tracker.transcript()),
                      permission_mode="auto")
        session_id = str(uuid.uuid4())
        tracker = TurnTracker("claude", session_id)
        result = attempt(launch, tracker, None, False, session_id=session_id, first=False)
        if result is None:
            return
        code, error_text, _ = result
        state, reason = run_outcome(code, closed.is_set(), error_text, tracker.check())
    if moves:
        reason = f"{reason} · fell back to {moves[-1]}"
    if state == "failed" and error_text:
        save_run_log(run_id, error_text)
    report_finished(run_id, state, reason, started)


if __name__ == "__main__":
    main()
