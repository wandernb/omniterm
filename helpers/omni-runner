#!/usr/bin/python3
"""Interactive PTY-side supervisor for one OmniTerm agent run."""

import fcntl
import json
import os
import pwd
import re
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

SOCKET = Path.home() / "Library/Application Support/OmniTerm/scheduler.sock"
CODEX_DANGEROUS_MODE = "dangerous"
PATH_MARKER = "__OMNITERM_PATH__"
LOGIN_SHELL_TIMEOUT = 15
FALLBACK_PATH_DIRECTORIES = ("~/.local/bin", "~/.claude/bin", "/opt/homebrew/bin", "/usr/local/bin",
                             "/usr/bin", "/bin", "/usr/sbin", "/sbin")
RUN_LOG_DIRECTORY = SOCKET.parent / "run-logs"
RUN_LOG_BYTES = 16384
RUN_LOGS_KEPT = 50
REASON_CHARACTERS = 160
PROVIDER_CLOSE_GRACE = 3
START_SLOT = SOCKET.parent / "provider-start.lock"
START_SLOT_ATTEMPTS = 240
START_SLOT_POLL = 0.25
START_SPACING = 2
TURN_POLL_SECONDS = 5
TURN_TAIL_BYTES = 1048576
TERMINAL_ESCAPE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\^_])")


def request(payload):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.connect(str(SOCKET))
        client.sendall(json.dumps(payload).encode() + b"\n")
        try:
            client.shutdown(socket.SHUT_WR)
        except OSError:
            pass  # The scheduler may already have answered and closed.
        data = b""
        while True:
            chunk = client.recv(65536)
            if not chunk: break
            data += chunk
        return json.loads(data)
    finally:
        client.close()


def provider_argv(agent, run_id=None, resume_session_id=None):
    permissions = agent.get("permission_mode")
    if agent["provider"] == "claude":
        argv = ["claude"]
        if resume_session_id:
            argv += ["--resume", resume_session_id]
        else:
            argv += ["--system-prompt", agent.get("system_prompt", "")]
            if run_id:
                argv += ["--session-id", run_id]
        if agent.get("model"): argv += ["--model", agent["model"]]
        if permissions: argv += ["--permission-mode", permissions]
    else:
        argv = ["codex", "-C", agent["workspace"], "-c", f"developer_instructions={json.dumps(agent.get('system_prompt', ''))}",
                "-c", codex_trust_override(agent["workspace"])]
        if agent.get("model"): argv += ["--model", agent["model"]]
        if permissions == CODEX_DANGEROUS_MODE:
            argv.append("--dangerously-bypass-approvals-and-sandbox")
        elif permissions:
            argv += ["--ask-for-approval", permissions]
        if resume_session_id:
            argv += ["resume", resume_session_id]
    argv += agent.get("advanced_args", [])
    if not resume_session_id and agent.get("startup_prompt"): argv.append(agent["startup_prompt"])
    return argv


# Set by a parent agent session. OmniTerm inherits them when it is launched from
# one, and they make Claude treat a run as a child session with no transcript.
PARENT_SESSION_ENVIRONMENT = (
    "ANTHROPIC_MODEL",
    "CLAUDECODE",
    "CLAUDE_ACCOUNT_ACTIVE",
    "CLAUDE_CODE_BRIDGE_SESSION_ID",
    "CLAUDE_CODE_CHILD_SESSION",
    "CLAUDE_CODE_ENTRYPOINT",
    "CLAUDE_CODE_EXECPATH",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS",
    "CLAUDE_CODE_MESSAGING_SOCKET",
    "CLAUDE_CODE_MESSAGING_TOKEN",
    "CLAUDE_CODE_SESSION_ATTENDED",
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_EFFORT",
    "CLAUDE_PID",
    "CLAUDE_PLUGIN_DATA",
    "CODEX_COMPANION_SESSION_ID",
    "CODEX_COMPANION_TRANSCRIPT_PATH",
)


def provider_environment(source=None):
    """Keep managed interactive agents colorful and independent of any parent session."""
    environment = dict(os.environ if source is None else source)
    for name in PARENT_SESSION_ENVIRONMENT:
        environment.pop(name, None)
    environment.pop("NO_COLOR", None)
    environment["CLICOLOR"] = "1"
    environment["FORCE_COLOR"] = "1"
    environment.setdefault("COLORTERM", "truecolor")
    return environment


def login_shell_path(environment):
    """Ask the user's login shell for PATH; GUI launches only get launchd's minimal one."""
    shell = environment.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/zsh"
    try:
        result = subprocess.run([shell, "-lic", f'printf "{PATH_MARKER}%s{PATH_MARKER}" "$PATH"'],
                                stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL,
                                errors="replace",
                                timeout=LOGIN_SHELL_TIMEOUT,
                                start_new_session=True)
    except (OSError, subprocess.SubprocessError):
        return ""
    fields = result.stdout.split(PATH_MARKER)
    return fields[1] if len(fields) == 3 else ""


def provider_search_path(environment):
    """Combine the login-shell PATH, the inherited PATH, and the usual install locations."""
    directories = login_shell_path(environment).split(":")
    directories += environment.get("PATH", "").split(":")
    directories += [os.path.expanduser(directory) for directory in FALLBACK_PATH_DIRECTORIES]
    return ":".join(dict.fromkeys(directory for directory in directories if directory))


def trust_root(workspace):
    """Claude keys folder trust on the repository root, or the folder outside a repository."""
    path = Path(os.path.realpath(workspace))
    home = Path.home()
    for folder in (path, *path.parents):
        if folder == home:
            break
        if (folder / ".git").exists():
            return str(folder)
    return str(path)


def codex_trust_override(workspace):
    """Trust the workspace for this run only. A dotted -c key cannot hold a path, so use a table."""
    folders = dict.fromkeys((os.path.realpath(workspace), trust_root(workspace)))
    tables = ",".join(f'{json.dumps(folder)}={{trust_level="trusted"}}' for folder in folders)
    return f"projects={{{tables}}}"


def ensure_claude_trust(workspace):
    """Pre-accept Claude's folder trust, which no CLI flag can skip in an interactive run.

    A scheduled agent's workspace was chosen explicitly, and nobody is there to answer the prompt.
    An unreadable config is left alone: a prompt is better than damaging provider state.
    """
    config = Path(os.path.realpath(Path.home() / ".claude.json"))
    temporary = config.with_name(f".claude.json.omni-{os.getpid()}")
    root = trust_root(workspace)
    try:
        data = json.loads(config.read_text())
        project = data.setdefault("projects", {}).setdefault(root, {})
        if project.get("hasTrustDialogAccepted") is True:
            return
        project["hasTrustDialogAccepted"] = True
        temporary.write_text(json.dumps(data, indent=2))
        temporary.chmod(config.stat().st_mode & 0o777)
        os.replace(temporary, config)
    except (OSError, ValueError, AttributeError):
        try:
            temporary.unlink()
        except OSError:
            pass


def acquire_start_slot():
    """Space out provider starts across runners.

    Claude refreshes its login in the macOS Keychain at startup, and runs that start
    together fail there with exit 1. This also serializes the ~/.claude.json trust write.
    Waiting is bounded: a stuck holder must delay a run, never lose it.
    """
    try:
        slot = os.open(START_SLOT, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return None
    for _ in range(START_SLOT_ATTEMPTS):
        try:
            fcntl.flock(slot, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return slot
        except BlockingIOError:
            time.sleep(START_SLOT_POLL)
        except OSError:
            break
    os.close(slot)
    return None


def release_start_slot(slot, delay=0):
    """Closing releases the lock. The kernel also releases it if the runner dies first."""
    if slot is None:
        return
    timer = threading.Timer(delay, os.close, (slot,))
    timer.daemon = True
    timer.start()


class ErrorTail:
    """Show a provider's stderr in its tab and keep the end, because the tab closes with the run."""

    def __init__(self):
        self.read_end, self.write_end = os.pipe()
        self.tail = b""
        self.thread = threading.Thread(target=self.pump, daemon=True)
        self.thread.start()

    def pump(self):
        while True:
            try:
                chunk = os.read(self.read_end, 65536)
            except OSError:
                return
            if not chunk:
                return
            self.tail = (self.tail + chunk)[-RUN_LOG_BYTES:]
            try:
                os.write(2, chunk)
            except OSError:
                pass  # The tab has gone; the tail is still worth keeping.

    def close_write_end(self):
        os.close(self.write_end)

    def text(self):
        self.thread.join(1)  # Something the provider left behind may hold the pipe open.
        return TERMINAL_ESCAPE.sub("", self.tail.decode(errors="replace")).strip()


def save_run_log(run_id, text):
    """Keep a failed run's error output, newest logs only."""
    try:
        RUN_LOG_DIRECTORY.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(RUN_LOG_DIRECTORY / f"{run_id}.log", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text + "\n")
        logs = sorted(RUN_LOG_DIRECTORY.glob("*.log"), key=lambda path: path.stat().st_mtime, reverse=True)
        for path in logs[RUN_LOGS_KEPT:]:
            path.unlink()
    except OSError:
        pass  # A log is a diagnostic; it must never change the run's outcome.


def claude_turn_event(event):
    """Whether one Claude transcript event ends a turn, starts one, or says nothing about it."""
    if event.get("isSidechain") or event.get("isMeta"):
        return None
    if event.get("type") == "user":
        return False
    if event.get("type") != "assistant":
        return None
    message = event.get("message")
    stop_reason = message.get("stop_reason") if isinstance(message, dict) else None
    return stop_reason == "end_turn" and not event.get("isApiErrorMessage")


def codex_turn_event(event):
    """Whether one Codex session event ends a turn, starts one, or says nothing about it."""
    payload = event.get("payload")
    kind = payload.get("type") if event.get("type") == "event_msg" and isinstance(payload, dict) else None
    if kind == "task_complete":
        return True
    return False if kind in ("task_started", "turn_aborted") else None


def last_turn_state(path, classify):
    """Read a transcript's end, newest event first. None means nothing there settles it."""
    try:
        with path.open("rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            handle.seek(max(0, size - TURN_TAIL_BYTES))
            lines = handle.read().splitlines()
    except OSError:
        return None
    if size > TURN_TAIL_BYTES:
        lines = lines[1:]  # The tail starts mid-line.
    for line in reversed(lines):
        try:
            event = json.loads(line)
        except ValueError:
            continue  # The provider may still be writing the last line.
        state = classify(event) if isinstance(event, dict) else None
        if state is not None:
            return state
    return None


class TurnTracker:
    """Follow whether the agent finished its turn.

    An interactive provider stays open at its prompt after finishing, so how the
    process ends says nothing about the work. Its transcript does.
    """

    def __init__(self, provider, session_id):
        self.provider = provider
        self.session_id = session_id
        self.path = None
        self.modified = None
        self.finished = False

    def transcript(self):
        if not self.path and self.session_id:
            if self.provider == "claude":
                matches = (Path.home() / ".claude/projects").glob(f"*/{self.session_id}.jsonl")
            else:
                matches = (Path.home() / ".codex/sessions").rglob(f"*{self.session_id}.jsonl")
            self.path = next(iter(matches), None)
        return self.path

    def check(self):
        path = self.transcript()
        if not path:
            return self.finished
        try:
            modified = path.stat().st_mtime_ns
        except OSError:
            return self.finished
        if modified != self.modified:
            self.modified = modified
            state = last_turn_state(path, claude_turn_event if self.provider == "claude" else codex_turn_event)
            if state is not None:
                self.finished = state
        return self.finished


def watch_turn(run_id, tracker, stop):
    """Tell the scheduler as it changes: a reboot leaves the runner no chance to report."""
    reported = False
    while not stop.wait(TURN_POLL_SECONDS):
        finished = tracker.check()
        if finished == reported:
            continue
        try:
            request({"op": "runner_turn", "run_id": run_id, "finished": finished})
            reported = finished
        except (OSError, ValueError):
            pass  # Try again on the next pass.


def run_outcome(code, closed, error_text="", turn_finished=False):
    """Separate what a person or the scheduler ended from what actually failed.

    A finished turn is a completed run, whatever ended the idle session afterwards.
    """
    if closed:
        state, reason = "closed", "tab closed"
    elif code == 0:
        return "completed", "exit 0"
    elif code in (-signal.SIGTERM, 128 + signal.SIGTERM):
        state, reason = "stopped", "stopped"
    else:
        lines = error_text.splitlines()
        state, reason = "failed", f"exit {code}: {lines[-1][:REASON_CHARACTERS]}" if lines else f"exit {code}"
    return ("completed", f"agent finished, then {reason}") if turn_finished else (state, reason)


def signal_group(process_group, number):
    try:
        os.killpg(process_group, number)
    except (ProcessLookupError, PermissionError):
        pass


def end_provider(process_group):
    """A closed tab takes the runner's terminal; the provider has its own session, so tell it."""
    signal_group(process_group, signal.SIGHUP)
    timer = threading.Timer(PROVIDER_CLOSE_GRACE, signal_group, (process_group, signal.SIGKILL))
    timer.daemon = True
    timer.start()


def forward_terminal_resize(process_group):
    """Notify the isolated provider group after iTerm updates the PTY size."""
    try:
        os.killpg(process_group, signal.SIGWINCH)
    except (ProcessLookupError, PermissionError):
        pass


def codex_session_files():
    root = Path.home() / ".codex/sessions"
    return {path for path in root.rglob("*.jsonl")} if root.exists() else set()


def codex_session_id(path, workspace):
    try:
        with path.open(encoding="utf-8") as handle:
            for _ in range(8):
                event = json.loads(handle.readline())
                if event.get("type") == "session_meta":
                    payload = event.get("payload", {})
                    if payload.get("cwd") == workspace:
                        return payload.get("id")
    except (OSError, ValueError, json.JSONDecodeError):
        return None
    return None


def report_finished(run_id, state, reason, started):
    """Record the outcome; the app closes the tab as soon as this process exits."""
    try: request({"op": "runner_finished", "run_id": run_id, "state": state, "reason": reason})
    except (OSError, ValueError): pass
    runtime = int(time.monotonic() - started)
    try:
        print(f"\n── OmniTerm run {state}: {reason} · {runtime}s ──", flush=True)
    except OSError:
        pass  # A closed tab has no terminal left to print to.


def main():
    run_id = sys.argv[1]
    response = request({"op": "run_spec", "run_id": run_id})
    if not response.get("ok"):
        raise SystemExit(response.get("error", "Run not found"))
    agent = response["agent"]
    run = response["run"]
    resume_session_id = run.get("resume_session_id") if isinstance(run.get("resume_session_id"), str) else None
    argv = provider_argv(agent, run_id=run_id, resume_session_id=resume_session_id)
    previous_codex_files = codex_session_files() if agent["provider"] == "codex" and not resume_session_id else set()
    started = time.monotonic()
    environment = provider_environment()
    environment["PATH"] = provider_search_path(environment)
    slot = acquire_start_slot()
    if agent["provider"] == "claude":
        ensure_claude_trust(agent["workspace"])
    errors = ErrorTail()
    try:
        child = subprocess.Popen(argv,
                                 cwd=agent["workspace"],
                                 env=environment,
                                 stderr=errors.write_end,
                                 start_new_session=True)
    except OSError as error:
        errors.close_write_end()
        release_start_slot(slot)
        report_finished(run_id, "failed", f"could not start {argv[0]}: {error}", started)
        return
    release_start_slot(slot, START_SPACING)
    errors.close_write_end()
    closed = threading.Event()

    def on_close(*_):
        closed.set()
        end_provider(child.pid)

    signal.signal(signal.SIGWINCH,
                  lambda *_: forward_terminal_resize(child.pid))
    signal.signal(signal.SIGHUP, on_close)
    signal.signal(signal.SIGTERM, on_close)
    known_session_id = run.get("session_id") if isinstance(run.get("session_id"), str) else None
    request({"op": "runner_started", "run_id": run_id, "pid": os.getpid(), "pgid": child.pid,
             "session_id": known_session_id})
    tracker = TurnTracker(agent["provider"], known_session_id)
    stop_watching = threading.Event()
    threading.Thread(target=watch_turn, args=(run_id, tracker, stop_watching), daemon=True).start()
    if agent["provider"] == "codex" and not resume_session_id:
        def find_session():
            for _ in range(60):
                candidates = codex_session_files() - previous_codex_files
                candidates = sorted(candidates, key=lambda path: path.stat().st_mtime, reverse=True)
                for path in candidates:
                    session_id = codex_session_id(path, agent["workspace"])
                    if session_id:
                        tracker.session_id = session_id
                        try: request({"op": "runner_session", "run_id": run_id, "session_id": session_id})
                        except OSError: pass
                        return
                time.sleep(0.5)
        threading.Thread(target=find_session, daemon=True).start()
    code = child.wait()
    stop_watching.set()
    error_text = errors.text()
    state, reason = run_outcome(code, closed.is_set(), error_text, tracker.check())
    if state == "failed" and error_text:
        save_run_log(run_id, error_text)
    report_finished(run_id, state, reason, started)


if __name__ == "__main__":
    main()
