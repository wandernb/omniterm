#!/usr/bin/python3
"""Application-supervised in-memory transcript indexing worker."""

import argparse
import sys

from omni_knowledge import KnowledgeError, serve


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--serve", action="store_true", required=True)
    parser.add_argument("--socket", required=True)
    parser.add_argument("--owner-pid", type=int, required=True)
    parser.add_argument("--read-index", required=True)
    arguments = parser.parse_args()
    try:
        from omni_knowledge import KnowledgeStore
        serve(arguments.socket, arguments.owner_pid, KnowledgeStore(read_index=arguments.read_index, filter_sidecar=True))
    except (OSError, KnowledgeError) as exc:
        print(f"omni-knowledge: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
