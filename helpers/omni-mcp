def launch_command():
    # LaunchServices also knows every build product, so the bundle ID can open
    # a copy that has no helpers. Prefer the app these helpers belong to.
    if APP_BUNDLE.suffix == ".app":
        return ["open", "-g", str(APP_BUNDLE)]
    return ["open", "-g", "-b", "com.omniterm.app"]


def scheduler_request(payload, launch=True):
    last_error = None
    attempts = 8 if launch else 1
    operation = payload.get("op")
    read_only = operation in {"ping", "get_settings", "list_agents", "show_agent", "list_runs", "get_run",
                              "list_sessions", "get_session", "search_transcripts", "knowledge_status",
                              "search_memories", "get_session_message", "memory_candidates",
                              "list_memories", "get_memory", "memory_events", "memory_overview", "memory_graph",
                              "memory_topics", "merge_candidates", "explain_memory", "weekly_summary_candidates",
                              "list_blocked", "get_block"}
    stable_mutation = ((operation == "send_session_message" and bool(payload.get("request_id"))) or
                       operation in ("answer_block", "skip_block") or
                       (operation == "upsert_memory" and bool(payload.get("id"))) or
                       operation in ("memory_digest", "dismiss_memory_candidate", "dismiss_memory_candidates") or
                       (operation == "update_memory" and payload.get("reinforce") is not True))
    for attempt in range(attempts):
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        # Knowledge requests queue behind indexing in the app; give them time.
        client.settimeout(90 if operation in KNOWLEDGE_DEFINITIONS else 3)
        sent = False
        try:
            client.connect(str(SOCKET))
            # sendall itself can fail after a partial write. A mutation without
            # a stable idempotency key must not be replayed after that point.
            sent = True
            client.sendall(json.dumps(payload, separators=(",", ":")).encode() + b"\n")
            try:
                client.shutdown(socket.SHUT_WR)
            except OSError:
                pass  # The scheduler may already have answered and closed.
            chunks = []
            while True:
                chunk = client.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
            response = json.loads(b"".join(chunks))
            if not isinstance(response, dict):
                raise ValueError("OmniTerm scheduler returned an invalid response")
            if not response.get("ok"):
                raise ValueError(response.get("error", "OmniTerm scheduler request failed"))
            return response
        except (OSError, json.JSONDecodeError) as exc:
            last_error = exc
            if sent and not (read_only or stable_mutation):
                raise RuntimeError("The scheduler response was lost; this mutation was not replayed. "
                                   "Inspect its current state before trying again.") from exc
            if attempt == 0 and launch and not sent:
                subprocess.run(launch_command(),
                               env={"HOME": str(Path.home()), "PATH": "/usr/bin:/bin"},
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if attempt + 1 < attempts:
                time.sleep(0.4)
        finally:
            client.close()
    raise RuntimeError(f"OmniTerm scheduler is unavailable: {last_error}")


def schema(properties=None, required=None):
    value = {"type": "object", "properties": properties or {}, "additionalProperties": False}
    if required:
        value["required"] = required
    return value


def tool(name, title, description, properties=None, required=None, read_only=False,
         destructive=False, idempotent=False):
    return {
        "name": name,
        "title": title,
        "description": description,
        "inputSchema": schema(properties, required),
        "outputSchema": {"type": "object"},
        "annotations": {
            "readOnlyHint": read_only,
            "destructiveHint": destructive,
            "idempotentHint": idempotent,
            "openWorldHint": False,
        },
    }


