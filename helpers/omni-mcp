def run_actor():
    """The run and agent the memory journal attributes this server's mutations to."""
    if not _RUN_ACTOR:
        runs = []

        def list_runs():
            runs.extend(scheduler_request({"op": "list_runs"})["runs"])
            return runs

        try:
            run_id = OMNI.current_run_id(list_runs)
        except Exception:
            return {}  # Attribution is optional; retry it on the next mutation.
        actor = {}
        if run_id:
            agent = (os.environ.get("OMNI_AGENT") or "").strip() or \
                next((run.get("agent") for run in runs if run.get("id") == run_id), None)
            actor = {key: value for key, value in (("run_id", run_id), ("agent", agent))
                     if isinstance(value, str) and 0 < len(value) <= 200}
        _RUN_ACTOR.append(actor)
    return dict(_RUN_ACTOR[0])


def call_tool(name, arguments):
    if name == "set_sidebar_groups":
        if not isinstance(arguments, dict) or set(arguments) != {"groups"}:
            raise ValueError("Provide only the required groups array")
        groups = arguments["groups"]
        if not isinstance(groups, list) or not groups:
            raise ValueError("groups must be a non-empty array of folder paths")
        normalized = [OMNI.normalized_group(group) for group in groups]
        if any(group is None for group in normalized):
            raise ValueError("Folder paths must not be empty")
        response = scheduler_request({"op": "set_sidebar_groups", "groups": list(dict.fromkeys(normalized))})
        return {"groups": response["groups"]}
    if name in KNOWLEDGE_DEFINITIONS:
        validate_knowledge_value(arguments, KNOWLEDGE_DEFINITIONS[name]["inputSchema"])
        if name == "configure_memory":
            return OMNI.configure_memory_agent(provider=arguments.get("provider"),
                                               workspace=arguments.get("workspace"),
                                               enabled=arguments.get("enabled", True),
                                               model=arguments.get("model"),
                                               native_request=scheduler_request)
        if name == "send_session_message":
            for key in ("message", "sender_name"):
                if key in arguments and any((ord(character) < 32 and character not in "\n\t") or
                                            127 <= ord(character) <= 159 or
                                            0xD800 <= ord(character) <= 0xDFFF for character in arguments[key]):
                    raise ValueError(f"{key} contains control characters")
        payload = {"op": name, **arguments}
        if name in ATTRIBUTED_KNOWLEDGE_OPERATIONS:
            payload.update(run_actor())
        response = scheduler_request(payload)
        return {key: value for key, value in response.items() if key != "ok"}
    if name == "list_agents":
        agents = scheduler_request({"op": "list_agents"})["agents"]
        if "enabled" in arguments:
            agents = [agent for agent in agents if bool(agent.get("enabled")) == arguments["enabled"]]
        summaries = [{**{key: agent.get(key) for key in
                         ("name", "provider", "enabled", "workspace", "schedule", "next_run", "overlap",
                          "timeout_seconds")},
                      "kind": agent.get("kind", "scheduled"),
                      "session_policy": agent.get("session_policy", "resume"),
                      **{key: agent[key] for key in OMNI.APPEARANCE_FIELDS if agent.get(key)}}
                     for agent in agents]
        return {"agents": summaries}
    if name == "get_agent":
        return {"agent": scheduler_request({"op": "show_agent", "name": arguments["name"]})["agent"]}
    if name == "list_runs":
        limit = max(1, min(100, int(arguments.get("limit", 20))))
        payload = {"op": "list_runs", "name": arguments.get("agent")}
        if arguments.get("agent"):
            payload["agent"] = arguments["agent"]  # The newer key; name stays for older schedulers.
        if arguments.get("origin"):
            if arguments["origin"] not in ("scheduled", "manual"):
                raise ValueError("origin must be scheduled or manual")
            payload["origin"] = arguments["origin"]
        if arguments.get("before") is not None:
            payload["before"] = float(arguments["before"])
        if not arguments.get("state"):
            payload["limit"] = limit  # A state filter applies here, so the scheduler must not cut first.
        runs = scheduler_request(payload)["runs"]
        if arguments.get("state"):
            runs = [run for run in runs if run.get("state") == arguments["state"]]
        return {"runs": [serializable_run(run) for run in runs[:limit]]}
    if name == "get_run":
        run_id = arguments.get("id")
        if not isinstance(run_id, str) or not run_id.strip():
            raise ValueError("id must be a run ID")
        return {"run": scheduler_request({"op": "get_run", "id": run_id.strip()})["run"]}
    if name == "preview_schedule":
        settings = scheduler_request({"op": "get_settings"})["settings"]
        timezone = settings.get("timezone") or OMNI.system_timezone()
        schedule, cursor = OMNI.parse_schedule(arguments["schedule"], timezone)
        occurrences = []
        for _ in range(max(1, min(20, int(arguments.get("count", 5))))):
            if cursor is None:
                break
            occurrences.append(cursor)
            cursor = OMNI.next_calendar(schedule, timezone, cursor)
        return {"schedule": schedule, "timezone": timezone, "occurrences": occurrences}
    if name == "get_settings":
        response = scheduler_request({"op": "get_settings"})
        result = {"settings": response["settings"]}
        if "loop_mode" in response:
            result["loop_mode"] = response["loop_mode"]
        return result
    if name == "create_agent":
        existing = scheduler_request({"op": "list_agents"})["agents"]
        if any(item["name"] == arguments["name"] for item in existing):
            raise ValueError("Agent already exists; use update_agent")
        agent = build_agent(arguments)
        scheduler_request({"op": "create_agent", "agent": agent})
        return {"agent": scheduler_request({"op": "show_agent", "name": agent["name"]})["agent"]}
    if name == "update_agent":
        existing = scheduler_request({"op": "show_agent", "name": arguments["name"]})["agent"]
        agent = build_agent(arguments, existing)
        scheduler_request({"op": "update_agent", "agent": agent})
        return {"agent": scheduler_request({"op": "show_agent", "name": agent["name"]})["agent"]}
    if name == "set_agent_enabled":
        scheduler_request({"op": "set_enabled", "name": arguments["name"], "enabled": arguments["enabled"]})
        return {"name": arguments["name"], "enabled": arguments["enabled"]}
    if name == "delete_agent":
        scheduler_request({"op": "delete_agent", "name": arguments["name"]})
        return {"name": arguments["name"], "deleted": True}
    if name == "run_agent":
        response = scheduler_request({"op": "run_agent", "name": arguments["name"]})
        return {"name": arguments["name"], "run_id": response["run_id"]}
    if name == "rename_agent":
        if not isinstance(arguments.get("new_name"), str) or not arguments["new_name"].strip():
            raise ValueError("new_name must be a non-empty string")
        new_name = OMNI.normalized_agent_name(arguments["new_name"])
        response = scheduler_request({"op": "rename_agent", "name": arguments["name"], "new_name": new_name})
        return {"agent": response.get("agent") or {"name": new_name}}
    if name == "stop_run":
        scheduler_request({"op": "stop_run", "run_id": arguments["run_id"]})
        return {"run_id": arguments["run_id"], "stopped": True}
    if name == "notify_user":
        title = arguments.get("title")
        if not isinstance(title, str) or not title.strip():
            raise ValueError("title must be a non-empty string")
        run_id = OMNI.current_run_id(lambda: scheduler_request({"op": "list_runs"})["runs"])
        workspace = arguments.get("workspace")
        if not workspace and not run_id:
            workspace = str(OMNI.discover_project(os.getcwd()))
        payload = OMNI.notify_payload(title, body=arguments.get("body"), severity=arguments.get("severity"),
                                      workspace=workspace, include_diff=arguments.get("include_diff"),
                                      dedupe_key=arguments.get("dedupe_key"), run_id=run_id)
        response = scheduler_request(payload)
        result = {"id": response["id"], "stored": True, "severity": response.get("severity")}
        for key in ("run_id", "agent", "deduplicated", "suppressed", "truncated"):
            if response.get(key):
                result[key] = response[key]
        return result
    if name == "resume_run":
        response = scheduler_request({"op": "resume_run", "run_id": arguments["run_id"]})
        return {"source_run_id": arguments["run_id"], "run_id": response["run_id"]}
    raise ValueError(f"Unknown Omni tool: {name}")


def tool_result(value, error=False):
    return {
        "content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False, separators=(",", ":"))}],
        "structuredContent": value,
        "isError": error,
    }


def response_for(message):
    method = message.get("method")
    request_id = message.get("id")
    if request_id is None:
        return None
    if method == "initialize":
        requested = message.get("params", {}).get("protocolVersion")
        protocol = requested if requested in SUPPORTED_PROTOCOLS else SUPPORTED_PROTOCOLS[0]
        result = {"protocolVersion": protocol,
                  "capabilities": {"tools": {"listChanged": False}, "resources": {"listChanged": False}},
                  "serverInfo": {"name": "omni", "title": "OmniTerm Agents and Notifications", "version": "1.1.0"},
                  "instructions": INSTRUCTIONS}
        return {"jsonrpc": "2.0", "id": request_id, "result": result}
    if method == "resources/list":
        resource = {"uri": GUIDE_URI, "name": "omni-guide", "title": "OmniTerm for agents",
                    "description": "How to notify the person with notify_user, and how to schedule agents.",
                    "mimeType": "text/markdown"}
        return {"jsonrpc": "2.0", "id": request_id, "result": {"resources": [resource]}}
    if method == "resources/read":
        uri = (message.get("params") or {}).get("uri")
        if uri != GUIDE_URI:
            return {"jsonrpc": "2.0", "id": request_id,
                    "error": {"code": -32002, "message": f"Resource not found: {uri}"}}
        return {"jsonrpc": "2.0", "id": request_id,
                "result": {"contents": [{"uri": GUIDE_URI, "mimeType": "text/markdown", "text": GUIDE}]}}
    if method == "ping":
        return {"jsonrpc": "2.0", "id": request_id, "result": {}}
    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": request_id, "result": {"tools": TOOLS}}
    if method == "tools/call":
        params = message.get("params", {})
        try:
            result = tool_result(call_tool(params.get("name"), params.get("arguments", {})))
        except Exception as exc:
            result = tool_result({"error": str(exc)}, error=True)
        return {"jsonrpc": "2.0", "id": request_id, "result": result}
    return {"jsonrpc": "2.0", "id": request_id,
            "error": {"code": -32601, "message": f"Method not found: {method}"}}


def main():
    for raw_line in sys.stdin.buffer:
        try:
            message = json.loads(raw_line)
            response = response_for(message)
        except Exception as exc:
            response = {"jsonrpc": "2.0", "id": None,
                        "error": {"code": -32700, "message": f"Parse error: {exc}"}}
        if response is not None:
            sys.stdout.write(json.dumps(response, ensure_ascii=False, separators=(",", ":")) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
