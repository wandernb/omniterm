"""MCP stdio adapter for OmniTerm's native agent scheduler."""

import importlib.machinery
import importlib.util
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

SOCKET = Path.home() / "Library/Application Support/OmniTerm/scheduler.sock"
SUPPORTED_PROTOCOLS = ("2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05")
HELPER_DIR = Path(__file__).resolve().parent
APP_BUNDLE = HELPER_DIR.parents[2]
_OMNI_LOADER = importlib.machinery.SourceFileLoader("omni_cli_for_mcp", str(HELPER_DIR / "omni"))
OMNI = importlib.util.module_from_spec(importlib.util.spec_from_loader("omni_cli_for_mcp", _OMNI_LOADER))
_OMNI_LOADER.exec_module(OMNI)


def launch_command():
    # LaunchServices also knows every build product, so the bundle ID can open
    # a copy that has no helpers. Prefer the app these helpers belong to.
    if APP_BUNDLE.suffix == ".app":
        return ["open", "-g", str(APP_BUNDLE)]
    return ["open", "-g", "-b", "com.omniterm.app"]


def scheduler_request(payload, launch=True):
    last_error = None
    attempts = 8 if launch else 1
    for attempt in range(attempts):
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(3)
        try:
            client.connect(str(SOCKET))
            client.sendall(json.dumps(payload, separators=(",", ":")).encode() + b"\n")
            try:
                client.shutdown(socket.SHUT_WR)
            except OSError:
                pass  # The scheduler may already have answered and closed.
            chunks = []
            while True:
                chunk = client.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
            response = json.loads(b"".join(chunks))
            if not response.get("ok"):
                raise ValueError(response.get("error", "OmniTerm scheduler request failed"))
            return response
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            last_error = exc
            if attempt == 0 and launch:
                subprocess.run(launch_command(),
                               env={"HOME": str(Path.home()), "PATH": "/usr/bin:/bin"},
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if attempt + 1 < attempts:
                time.sleep(0.4)
        finally:
            client.close()
    raise RuntimeError(f"OmniTerm scheduler is unavailable: {last_error}")


def schema(properties=None, required=None):
    value = {"type": "object", "properties": properties or {}, "additionalProperties": False}
    if required:
        value["required"] = required
    return value


def tool(name, title, description, properties=None, required=None, read_only=False,
         destructive=False, idempotent=False):
    return {
        "name": name,
        "title": title,
        "description": description,
        "inputSchema": schema(properties, required),
        "outputSchema": {"type": "object"},
        "annotations": {
            "readOnlyHint": read_only,
            "destructiveHint": destructive,
            "idempotentHint": idempotent,
            "openWorldHint": False,
        },
    }


