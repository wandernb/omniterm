def interactive_agent_form(initial, existing=None, validator=None):
    """Edit an agent in one resize-aware screen with no nested picker panels."""
    values = {key: str(value or "") for key, value in initial.items()}
    existing = existing or {}

    def screen(window):
        palette = tui_palette()
        window.keypad(True)
        window.timeout(-1)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        active = 0
        cursors = {key: len(values.get(key, "")) for key, _ in AGENT_FORM_FIELDS}
        selected = 0
        field_scroll = 0
        status = ""
        status_error = False
        escape_at = 0.0
        tab_state = {"query": None, "matches": [], "index": -1}
        mouse_fields = []
        mouse_options = []

        def current():
            return AGENT_FORM_FIELDS[active]

        def reset_selection():
            nonlocal selected, tab_state
            field_key, _ = current()
            choices = agent_form_choices(field_key, values)
            current_value = values.get(field_key, "")
            shown_value = ("provider default"
                           if field_key == "model" and not current_value else current_value)
            if field_key == "permission_mode" and shown_value == "auto":
                shown_value = "auto-mode"
            selected = choices.index(shown_value) if shown_value in choices else 0
            tab_state = {"query": None, "matches": [], "index": -1}

        def move(delta):
            nonlocal active, status, status_error
            active = max(0, min(len(AGENT_FORM_FIELDS) - 1, active + delta))
            status = ""
            status_error = False
            reset_selection()

        def visible_options(key):
            nonlocal selected
            if key == "workspace":
                if tab_state.get("matches"):
                    options = [("child", item) for item in tab_state["matches"]]
                    selected = tab_state.get("index", 0)
                    return options
                return workspace_path_options(values.get(key, ""))
            choices = agent_form_choices(key, values)
            query = values.get(key, "").lower()
            if query in {str(item).lower() for item in choices} or key in {"provider", "overlap"}:
                filtered = choices
            else:
                filtered = [item for item in choices
                            if not query or str(item).lower().startswith(query)]
                if not filtered:
                    filtered = choices
            return [("choice", item) for item in filtered]

        while True:
            values["schedule_phrase"] = schedule_phrase_from_form(values)
            key, fallback_label = current()
            label = agent_form_label(key, fallback_label, values)
            options = visible_options(key)
            if options:
                selected = max(0, min(selected, len(options) - 1))
            else:
                selected = 0

            window.erase()
            height, width = window.getmaxyx()
            mouse_fields = []
            mouse_options = []
            tui_cursor(1 if key != "__save__" else 0)
            if height < 14 or width < 56:
                tui_text(window, 1, 2, "OMNI · AGENT", palette["peach"] | curses.A_BOLD, width - 4)
                tui_text(window, 3, 2, "Resize the terminal to at least 56 × 14", palette["muted"], width - 4)
                window.refresh()
                pressed = window.get_wch()
                if pressed == "\x03":
                    raise KeyboardInterrupt
                continue

            tui_text(window, 1, 3, "OMNI", palette["peach"] | curses.A_BOLD)
            tui_text(window, 1, 9, "AGENT CONFIGURATION", curses.A_BOLD)
            mode = "EDIT" if existing else "NEW"
            tui_text(window, 1, max(3, width - len(mode) - 4), mode,
                     palette["green"] | curses.A_BOLD)
            tui_text(window, 2, 3,
                     "← → fields  ·  Tab complete/choose  ·  ↑ ↓ suggestions  ·  Enter select",
                     palette["muted"], width - 6)
            tui_text(window, 3, 3,
                     "⇧/⌥/⌘ Enter newline in prompts  ·  Ctrl-B/F edit cursor  ·  Esc twice cancel",
                     palette["muted"], width - 6)
            tui_text(window, 4, 2, "─" * max(1, width - 4), palette["peach"], width - 4)

            detail_budget = 7 if key in {"workspace", "provider", "model", "repeat_count",
                                         "repeat_unit", "repeat_on", "repeat_time", "schedule_phrase",
                                         "overlap", "timeout", "permission_mode",
                                         "system_prompt", "startup_prompt"} else 4
            list_top = 5
            list_height = max(4, height - list_top - detail_budget - 3)
            field_scroll = min(field_scroll, max(0, len(AGENT_FORM_FIELDS) - list_height))
            if active < field_scroll:
                field_scroll = active
            elif active >= field_scroll + list_height:
                field_scroll = active - list_height + 1

            label_width = 17
            value_x = 4 + label_width
            for offset, (field_key, field_label) in enumerate(
                    AGENT_FORM_FIELDS[field_scroll:field_scroll + list_height]):
                index = field_scroll + offset
                y = list_top + offset
                is_active = index == active
                marker = "◆" if is_active else "·"
                style = palette["peach"] | curses.A_BOLD if is_active else palette["muted"]
                tui_text(window, y, 3, marker, style)
                field_label = agent_form_label(field_key, field_label, values)
                tui_text(window, y, 6, f"{field_label:<15}", style, label_width - 1)
                preview = _field_preview(field_key, values.get(field_key, ""), width - value_x - 4)
                value_style = curses.A_BOLD | (curses.A_REVERSE if is_active else 0)
                if field_key == "__save__" and is_active:
                    value_style |= palette["green"]
                tui_text(window, y, value_x, f" {preview} ", value_style, width - value_x - 3)
                mouse_fields.append((y, index))

            detail_y = list_top + list_height + 1
            tui_text(window, detail_y - 1, 2, "─" * max(1, width - 4), palette["blue"], width - 4)
            tui_text(window, detail_y, 3, label.upper(), palette["blue"] | curses.A_BOLD,
                     width - 6)
            tui_text(window, detail_y + 1, 3, AGENT_FORM_DESCRIPTIONS[key],
                     palette["muted"], width - 6)

            cursor_target = None
            if key in {"system_prompt", "startup_prompt"}:
                text = values.get(key, "")
                cursor = cursors[key]
                content_width = max(12, width - 8)
                rows = editor_visual_rows(text, content_width)
                cursor_row = 0
                cursor_col = 0
                for row_index, (start, end, _) in enumerate(rows):
                    if start <= cursor <= end:
                        cursor_row, cursor_col = row_index, cursor - start
                        break
                first_row = max(0, cursor_row - 2)
                for offset, (_, _, line) in enumerate(rows[first_row:first_row + 3]):
                    tui_text(window, detail_y + 2 + offset, 4, line, 0, content_width)
                cursor_target = (detail_y + 2 + cursor_row - first_row,
                                 4 + min(cursor_col, content_width - 1))
            elif options:
                available = max(1, height - detail_y - 3)
                first_option = max(0, min(selected - available + 1,
                                          max(0, len(options) - available)))
                for offset, (kind, option) in enumerate(options[first_option:first_option + available]):
                    index = first_option + offset
                    shown = str(option) if option != "" else "provider default"
                    is_selected = (index == selected and
                                   (key != "workspace" or bool(tab_state.get("matches"))))
                    option_style = (palette["peach"] | curses.A_BOLD | curses.A_REVERSE
                                    if is_selected else 0)
                    y = detail_y + 2 + offset
                    tui_text(window, y, 5, ("▶ " if is_selected else "  ") + shown,
                             option_style, width - 9)
                    mouse_options.append((y, index))
            elif key != "__save__":
                value = values.get(key, "")
                tui_text(window, detail_y + 2, 4, value, curses.A_BOLD, width - 8)
                cursor_target = (detail_y + 2,
                                 4 + min(cursors[key], max(0, width - 9)))

            message = status or ("Tab completes · Enter accepts this path" if key == "workspace"
                                 else "Enter advances" if not options and key != "__save__"
                                 else "Enter saves" if key == "__save__" else "")
            if message:
                tui_text(window, height - 2, 3, message,
                         (palette["red"] if status_error else palette["muted"]), width - 6)
            if cursor_target:
                try:
                    window.move(*cursor_target)
                except curses.error:
                    pass
            window.refresh()
            pressed = window.get_wch()

            if pressed == curses.KEY_RESIZE:
                continue
            if pressed == "\x03":
                raise KeyboardInterrupt
            if pressed == "\x1b":
                now = time.monotonic()
                if escape_at and now - escape_at < 1.0:
                    return None
                escape_at = now
                status, status_error = "Press Escape again to cancel", False
                continue
            escape_at = 0.0

            if pressed == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    if state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                        for row, index in mouse_fields:
                            if mouse_y == row:
                                active = index
                                reset_selection()
                                break
                        else:
                            for row, index in mouse_options:
                                if mouse_y == row:
                                    selected = index
                                    if current()[0] == "workspace":
                                        options = visible_options("workspace")
                                        values["workspace"] = options[index][1]
                                        cursors["workspace"] = len(values["workspace"])
                                        reset_selection()
                                        pressed = None
                                    else:
                                        pressed = "\n"
                                    break
                            else:
                                continue
                    else:
                        continue
                except curses.error:
                    continue
                if pressed is None:
                    continue

            key, _ = current()
            options = visible_options(key)
            if pressed == curses.KEY_LEFT:
                move(-1)
                continue
            if pressed == curses.KEY_RIGHT:
                if key == "workspace":
                    folder = Path(values[key]).expanduser()
                    if not folder.is_dir():
                        status, status_error = "Choose an existing workspace before continuing", True
                        continue
                    values[key] = str(folder.resolve())
                move(1)
                continue
            if pressed in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_BTAB):
                if options:
                    delta = -1 if pressed in (curses.KEY_UP, curses.KEY_BTAB) else 1
                    selected = (selected + delta) % len(options)
                continue
            if pressed == "\t":
                if key == "workspace":
                    value, tab_state = shell_path_tab(values[key], tab_state)
                    values[key] = value
                    cursors[key] = len(value)
                    selected = max(0, tab_state.get("index", 0))
                elif options:
                    selected = (selected + 1) % len(options)
                continue
            if pressed in ("\n", "\r", curses.KEY_ENTER):
                if key == "__save__":
                    if validator:
                        try:
                            validator(values)
                        except (ValueError, OSError) as exc:
                            message = str(exc)
                            lookup = {
                                "name": "name", "provider": "provider",
                                "workspace": "workspace", "schedule": "schedule_phrase",
                                "overlap": "overlap", "duration": "timeout",
                                "advanced": "advanced_args",
                            }
                            lowered = message.lower()
                            target = next((field for word, field in lookup.items()
                                           if word in lowered), None)
                            if target:
                                active = next(index for index, item in enumerate(AGENT_FORM_FIELDS)
                                              if item[0] == target)
                            status, status_error = message, True
                            reset_selection()
                            continue
                    return values
                if key == "workspace":
                    folder = Path(values[key]).expanduser()
                    if not folder.is_dir():
                        status, status_error = "Complete or enter an existing folder before continuing", True
                        continue
                    values[key] = str(folder.resolve())
                    cursors[key] = len(values[key])
                    move(1)
                    continue
                if options:
                    _, option = options[selected]
                    if key == "model" and option == "provider default":
                        values[key] = ""
                    elif key == "model" and option == "Custom model…":
                        values[key] = ""
                        cursors[key] = 0
                        status, status_error = "Type the custom model name", False
                        continue
                    else:
                        values[key] = option
                    if key == "repeat_unit":
                        normalize_schedule_controls(values)
                    cursors[key] = len(values[key])
                move(1)
                continue
            if pressed == "\x1e" and key in {"system_prompt", "startup_prompt"}:
                cursor = cursors[key]
                values[key] = values[key][:cursor] + "\n" + values[key][cursor:]
                cursors[key] += 1
                continue
            schedule_unused = ((key == "repeat_on" and values.get("repeat_unit") == "minutes") or
                               (key == "repeat_time" and
                                values.get("repeat_unit") not in {"weeks", "months"}))
            if (key in {"__save__", "schedule_phrase"} or schedule_unused or
                    (existing.get("name") and key == "name")):
                continue
            if pressed in ("\x7f", "\b", curses.KEY_BACKSPACE):
                cursor = cursors[key]
                if cursor:
                    values[key] = values[key][:cursor - 1] + values[key][cursor:]
                    cursors[key] -= 1
                reset_selection()
            elif pressed == curses.KEY_DC:
                cursor = cursors[key]
                values[key] = values[key][:cursor] + values[key][cursor + 1:]
                reset_selection()
            elif pressed in (curses.KEY_HOME, "\x01"):
                cursors[key] = 0
            elif pressed in (curses.KEY_END, "\x05"):
                cursors[key] = len(values[key])
            elif pressed == "\x02":
                cursors[key] = max(0, cursors[key] - 1)
            elif pressed == "\x06":
                cursors[key] = min(len(values[key]), cursors[key] + 1)
            elif pressed == "\x15":
                values[key] = ""
                cursors[key] = 0
                reset_selection()
            elif isinstance(pressed, str) and pressed.isprintable():
                cursor = cursors[key]
                values[key] = values[key][:cursor] + pressed + values[key][cursor:]
                cursors[key] += len(pressed)
                reset_selection()

    set_agent_form_terminal_mode(True)
    try:
        return curses.wrapper(screen)
    finally:
        set_agent_form_terminal_mode(False)


def interactive_picker(label, choices, default=None):
    choices = list(dict.fromkeys(([default] if default and default not in choices else []) + list(choices)))

    def screen(window):
        palette = tui_palette()
        tui_cursor(0)
        window.keypad(True)
        window.timeout(-1)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        selected = choices.index(default) if default in choices else 0
        first = 0
        while True:
            window.erase()
            height, width = window.getmaxyx()
            box_width = max(36, min(88, width - 4))
            box_height = max(8, min(height - 4, len(choices) + 6))
            x, y = max(2, (width - box_width) // 2), max(1, (height - box_height) // 2)
            tui_box(window, y, x, box_height, box_width, palette["peach"], label.upper())
            tui_text(window, y + 1, x + 3, "Choose with ↑↓ or mouse · Enter confirms", palette["muted"], box_width - 6)
            visible = max(1, box_height - 4)
            first = max(0, min(first, max(0, len(choices) - visible)))
            if selected < first:
                first = selected
            elif selected >= first + visible:
                first = selected - visible + 1
            for offset, value in enumerate(choices[first:first + visible]):
                index = first + offset
                marker = "▶" if index == selected else " "
                style = (palette["peach"] | curses.A_BOLD | curses.A_REVERSE) if index == selected else 0
                tui_text(window, y + 2 + offset, x + 3, f"{marker} {value}", style, box_width - 6)
            tui_text(window, y + box_height - 2, x + 3, "Esc goes back", palette["muted"], box_width - 6)
            window.refresh()
            key = window.getch()
            if key in (10, 13, curses.KEY_ENTER):
                return choices[selected]
            if key == 27:
                return ":back"
            if key in (curses.KEY_UP, ord("k")):
                selected = (selected - 1) % len(choices)
            elif key in (curses.KEY_DOWN, ord("j")):
                selected = (selected + 1) % len(choices)
            elif key == curses.KEY_HOME:
                selected = 0
            elif key == curses.KEY_END:
                selected = len(choices) - 1
            elif key == curses.KEY_PPAGE:
                selected = max(0, selected - visible)
            elif key == curses.KEY_NPAGE:
                selected = min(len(choices) - 1, selected + visible)
            elif key == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    offset = mouse_y - (y + 2)
                    if x + 1 <= mouse_x < x + box_width - 1 and 0 <= offset < visible:
                        index = first + offset
                        if index < len(choices) and state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED | curses.BUTTON1_RELEASED):
                            return choices[index]
                except curses.error:
                    pass

    return curses.wrapper(screen)


def display_path(path):
    value = str(path)
    home = str(Path.home())
    return "~" + value[len(home):] if value == home or value.startswith(home + os.sep) else value


def interactive_path_picker(label, default):
    def candidates(value):
        matches = path_completion_matches(value)
        expanded = Path(value).expanduser()
        if expanded.is_dir() and not value.endswith(os.sep):
            exact = display_path(expanded.resolve()) + "/"
            if exact not in matches:
                matches.insert(0, exact)
        return matches

    def screen(window):
        palette = tui_palette()
        tui_cursor(1)
        window.keypad(True)
        window.timeout(-1)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        value = display_path(Path(default).expanduser())
        if str(default).endswith(os.sep) and value != os.sep:
            value += os.sep
        selected = 0
        first = 0
        while True:
            options = candidates(value)
            if options:
                selected = min(selected, len(options) - 1)
            else:
                selected = 0
            window.erase()
            height, width = window.getmaxyx()
            box_width = max(48, min(104, width - 4))
            box_height = max(10, min(height - 4, 22))
            x, y = max(2, (width - box_width) // 2), max(1, (height - box_height) // 2)
            visible = box_height - 6
            first = min(first, max(0, len(options) - visible))
            if selected < first:
                first = selected
            elif selected >= first + visible:
                first = selected - visible + 1
            tui_box(window, y, x, box_height, box_width, palette["peach"], label.upper())
            tui_text(window, y + 1, x + 3, "Path", palette["muted"] | curses.A_BOLD, 8)
            tui_text(window, y + 1, x + 9, value, curses.A_BOLD, box_width - 12)
            tui_text(window, y + 2, x + 3, "─" * (box_width - 6), palette["blue"], box_width - 6)
            for offset, option in enumerate(options[first:first + visible]):
                index = first + offset
                marker = "▶" if index == selected else " "
                style = (palette["peach"] | curses.A_BOLD | curses.A_REVERSE) if index == selected else 0
                tui_text(window, y + 3 + offset, x + 3, f"{marker} {option}", style, box_width - 6)
            if not options:
                tui_text(window, y + 4, x + 5, "No matching folders", palette["muted"], box_width - 10)
            tui_text(window, y + box_height - 2, x + 3,
                     "Tab/↑↓ choose · Enter select · → browse · Ctrl-U clear · Esc back",
                     palette["muted"], box_width - 6)
            try:
                window.move(y + 1, x + 9 + min(len(value), box_width - 13))
            except curses.error:
                pass
            window.refresh()
            key = window.get_wch()
            if key in ("\n", "\r", curses.KEY_ENTER):
                chosen = options[selected] if options else value
                resolved = Path(chosen).expanduser().resolve()
                if resolved.is_dir():
                    return str(resolved)
            elif key == "\x1b":
                return ":back"
            elif key == "\x03":
                raise KeyboardInterrupt
            elif key in ("\t", curses.KEY_DOWN):
                if options:
                    selected = (selected + 1) % len(options)
            elif key in (curses.KEY_BTAB, curses.KEY_UP):
                if options:
                    selected = (selected - 1) % len(options)
            elif key == curses.KEY_NPAGE and options:
                selected = min(len(options) - 1, selected + visible)
            elif key == curses.KEY_PPAGE and options:
                selected = max(0, selected - visible)
            elif key in (curses.KEY_RIGHT, "/") and options:
                value = options[selected].rstrip("/") + "/"
                selected = first = 0
            elif key in ("\x7f", "\b", curses.KEY_BACKSPACE):
                value = value[:-1]
                selected = first = 0
            elif key == "\x15":
                value = ""
                selected = first = 0
            elif key == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    offset = mouse_y - (y + 3)
                    if x + 1 <= mouse_x < x + box_width - 1 and 0 <= offset < visible:
                        index = first + offset
                        if index < len(options) and state & curses.BUTTON1_DOUBLE_CLICKED:
                            return str(Path(options[index]).expanduser().resolve())
                        if index < len(options) and state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                            selected = index
                except curses.error:
                    pass
            elif isinstance(key, str) and key.isprintable():
                value += key
                selected = first = 0

    return curses.wrapper(screen)


def editor_visual_rows(text, width):
    rows = []
    start = 0
    for logical in text.split("\n"):
        if not logical:
            rows.append((start, start, ""))
        else:
            for offset in range(0, len(logical), width):
                chunk = logical[offset:offset + width]
                rows.append((start + offset, start + offset + len(chunk), chunk))
        start += len(logical) + 1
    return rows or [(0, 0, "")]


def interactive_text_editor(label, default=""):
    def screen(window):
        palette = tui_palette()
        window.keypad(True)
        window.timeout(-1)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        text = default
        cursor = len(text)
        scroll = 0
        while True:
            window.erase()
            height, width = window.getmaxyx()
            box_width = max(44, min(100, width - 4))
            box_height = max(9, min(height - 4, 20))
            x, y = max(2, (width - box_width) // 2), max(1, (height - box_height) // 2)
            content_width = max(8, box_width - 6)
            rows = editor_visual_rows(text, content_width)
            cursor_row = len(rows) - 1
            cursor_column = 0
            for index, (start, end, _) in enumerate(rows):
                if start <= cursor <= end:
                    cursor_row = index
                    cursor_column = cursor - start
                    break
            visible = box_height - 5
            scroll = min(scroll, max(0, len(rows) - visible))
            if cursor_row < scroll:
                scroll = cursor_row
            elif cursor_row >= scroll + visible:
                scroll = cursor_row - visible + 1
            tui_box(window, y, x, box_height, box_width, palette["peach"], label.upper())
            tui_text(window, y + 1, x + 3, "Enter saves · ⌘Enter new line · click to place cursor", palette["muted"], box_width - 6)
            for offset, (_, _, value) in enumerate(rows[scroll:scroll + visible]):
                tui_text(window, y + 2 + offset, x + 3, value, 0, content_width)
            tui_text(window, y + box_height - 2, x + 3, "Esc goes back", palette["muted"], box_width - 6)
            try:
                tui_cursor(1)
                window.move(y + 2 + cursor_row - scroll, x + 3 + min(cursor_column, content_width - 1))
            except curses.error:
                pass
            window.refresh()
            key = window.get_wch()
            if key in ("\n", "\r", curses.KEY_ENTER):
                return text
            if key == "\x1e":
                text = text[:cursor] + "\n" + text[cursor:]
                cursor += 1
            elif key == "\x1b":
                return ":back"
            elif key == "\x03":
                raise KeyboardInterrupt
            elif key in ("\x7f", "\b", curses.KEY_BACKSPACE):
                if cursor:
                    text = text[:cursor - 1] + text[cursor:]
                    cursor -= 1
            elif key == curses.KEY_DC:
                text = text[:cursor] + text[cursor + 1:]
            elif key == curses.KEY_LEFT:
                cursor = max(0, cursor - 1)
            elif key == curses.KEY_RIGHT:
                cursor = min(len(text), cursor + 1)
            elif key == curses.KEY_HOME:
                cursor = rows[cursor_row][0]
            elif key == curses.KEY_END:
                cursor = rows[cursor_row][1]
            elif key in (curses.KEY_UP, curses.KEY_DOWN):
                target = cursor_row + (-1 if key == curses.KEY_UP else 1)
                if 0 <= target < len(rows):
                    cursor = min(rows[target][0] + cursor_column, rows[target][1])
            elif key == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    row = scroll + mouse_y - (y + 2)
                    if 0 <= row < len(rows) and x + 3 <= mouse_x < x + box_width - 3 and state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                        cursor = min(rows[row][0] + mouse_x - (x + 3), rows[row][1])
                except curses.error:
                    pass
            elif isinstance(key, str) and key.isprintable():
                text = text[:cursor] + key + text[cursor:]
                cursor += len(key)

    return curses.wrapper(screen)


def tui_confirm(window, message, palette):
    height, width = window.getmaxyx()
    box_width = min(max(len(message) + 8, 44), width - 4)
    y, x = max(1, height // 2 - 2), max(2, (width - box_width) // 2)
    tui_box(window, y, x, 5, box_width, palette["peach"], "CONFIRM")
    tui_text(window, y + 2, x + 3, message, curses.A_BOLD, box_width - 6)
    tui_text(window, y + 3, x + 3, "Enter confirm  ·  Esc cancel", palette["muted"], box_width - 6)
    window.refresh()
    while True:
        key = window.getch()
        if is_dashboard_activate_key(key):
            return True
        if key in (27, ord("q")):
            return False


def tui_view_text(window, title, content, palette):
    """Show a resize-aware, scrollable prompt viewer over the dashboard."""
    scroll = 0
    window.timeout(-1)
    try:
        while True:
            window.erase()
            height, width = window.getmaxyx()
            if height < 9 or width < 32:
                tui_text(window, 1, 2, title, palette["peach"] | curses.A_BOLD, width - 4)
                tui_text(window, 3, 2, "Resize to view this prompt", palette["muted"], width - 4)
                window.refresh()
            else:
                box_height = height - 4
                box_width = width - 4
                y, x = 2, 2
                body_width = box_width - 6
                visible_rows = max(1, box_height - 5)
                lines = wrapped_content(content, body_width)
                scroll = min(scroll, max(0, len(lines) - visible_rows))
                tui_box(window, y, x, box_height, box_width, palette["peach"], title)
                position = f"{scroll + 1}–{min(len(lines), scroll + visible_rows)} / {len(lines)}"
                tui_text(window, y + 1, x + 3, position, palette["blue"] | curses.A_BOLD, body_width)
                for offset, line in enumerate(lines[scroll:scroll + visible_rows]):
                    tui_text(window, y + 2 + offset, x + 3, line, 0, body_width)
                help_text = "↑↓ scroll  ·  PgUp/PgDn  ·  Home/End  ·  Enter or Esc closes"
                tui_text(window, y + box_height - 2, x + 3, help_text, palette["muted"], body_width)
                window.refresh()

            key = window.getch()
            page = max(1, (height - 4) - 6)
            if is_dashboard_activate_key(key) or key in (27, ord("q")):
                return
            if key in (curses.KEY_UP, ord("k")):
                scroll = max(0, scroll - 1)
            elif key in (curses.KEY_DOWN, ord("j")):
                scroll += 1
            elif key == curses.KEY_PPAGE:
                scroll = max(0, scroll - page)
            elif key == curses.KEY_NPAGE:
                scroll += page
            elif key == curses.KEY_HOME:
                scroll = 0
            elif key == curses.KEY_END:
                scroll = 1 << 30
            elif key == curses.KEY_MOUSE:
                try:
                    _, _, _, _, state = curses.getmouse()
                    if state & getattr(curses, "BUTTON4_PRESSED", 0):
                        scroll = max(0, scroll - 3)
                    elif state & getattr(curses, "BUTTON5_PRESSED", 0):
                        scroll += 3
                except curses.error:
                    pass
    finally:
        window.timeout(1000)
        window.clear()


def tui_suspend(window, callback):
    set_dashboard_terminal_mode(False)
    curses.def_prog_mode()
    curses.endwin()
    try:
        callback()
    except SystemExit as exc:
        message = str(exc)
        if message and message != "Cancelled":
            print(message)
            input("Press return…")
    finally:
        curses.reset_prog_mode()
        tui_cursor(0)
        window.keypad(True)
        window.clear()
        window.refresh()
        set_dashboard_terminal_mode(True)


def has_dangerous_permissions(agent):
    return agent.get("permission_mode") == DANGEROUS_PERMISSIONS.get(agent.get("provider"))


def workspace_repo(workspace):
    """Return the repository holding a workspace, or the workspace outside any repository."""
    path = Path(workspace)
    home = Path.home()
    for folder in (path, *path.parents):
        if folder == home:
            break
        if (folder / ".git").exists():
            # Worktree layouts keep each checkout in an @branch folder inside the repository.
            return str(folder.parent if folder.name.startswith("@") else folder)
    return str(workspace)


def repo_labels(repos):
    """Name repositories by what distinguishes them: their path below the shared folder."""
    unique = sorted(set(repos))
    if len(unique) < 2:
        return {repo: Path(repo).name or repo for repo in unique}
    shared = os.path.commonpath(unique)
    return {repo: os.path.relpath(repo, shared) if repo != shared else Path(repo).name or repo
            for repo in unique}


def group_agents(agents, by_repo):
    """Return [(label, agents)] in display order; a flat list has one unlabelled group."""
    if not by_repo:
        return [(None, list(agents))]
    repos = {agent["name"]: workspace_repo(agent["workspace"]) for agent in agents}
    labels = repo_labels(repos.values())
    groups = {}
    for agent in agents:
        groups.setdefault(labels[repos[agent["name"]]], []).append(agent)
    return [(label, sorted(groups[label], key=lambda agent: agent["name"].lower()))
            for label in sorted(groups, key=str.lower)]


def agent_list_rows(groups, selected, capacity):
    """Lay out the visible part of the list, keeping the selection and its group in view.

    Returns ("header", label, count) and ("agent", index) rows from top to bottom.
    """
    entries, owners, selected_entry, index = [], [], 0, 0
    for label, members in groups:
        header = ("header", label, len(members)) if label is not None else None
        if header:
            entries.append(header)
            owners.append(header)
        for _ in members:
            if index == selected:
                selected_entry = len(entries)
            entries.append(("agent", index))
            owners.append(header)
            index += 1

    def height(entry):
        return 1 if entry[0] == "header" else AGENT_CARD_ROWS

    def pinned(start):
        return [owners[start]] if owners[start] and entries[start][0] == "agent" else []

    start = 0
    while start < selected_entry and (
            sum(height(entry) for entry in pinned(start) + entries[start:selected_entry + 1]) > capacity):
        start += 1
    rows, used = pinned(start), len(pinned(start))
    for entry in entries[start:]:
        used += height(entry)
        if used > capacity and entry is not entries[selected_entry]:
            break
        rows.append(entry)
    return rows[:-1] if rows and rows[-1][0] == "header" else rows


def load_repo_grouping():
    try:
        return json.loads(DASHBOARD_STATE.read_text()).get("group_by_repo") is True
    except (OSError, ValueError, AttributeError):
        return False


def save_repo_grouping(enabled):
    try:
        DASHBOARD_STATE.write_text(json.dumps({"group_by_repo": enabled}) + "\n")
    except OSError:
        pass


def dashboard_screen(window):
    palette = tui_palette()
    tui_cursor(0)
    window.keypad(True)
    window.timeout(1000)
    set_dashboard_terminal_mode(True)
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        print("\033[?1003h", end="", flush=True)
    except curses.error:
        pass

    selected = 0
    selected_run = 0
    selected_prompt = 0
    focus = "agents"
    message = "Ready"
    agents, runs, groups = [], [], []
    group_by_repo = load_repo_grouping()
    hitboxes = []
    last_refresh = None

    def reload_data(force=False):
        nonlocal agents, runs, groups, selected, last_refresh, message
        if not force and last_refresh is not None and time.monotonic() - last_refresh < 1:
            return
        try:
            groups = group_agents(request({"op": "list_agents"})["agents"], group_by_repo)
            agents = [agent for _, members in groups for agent in members]
            runs = request({"op": "list_runs"})["runs"]
            selected = max(0, min(selected, len(agents) - 1))
            last_refresh = time.monotonic()
        except BaseException as exc:
            message = f"Scheduler reconnecting · {exc}"

    def selected_agent():
        return agents[selected] if agents else None

    def toggle_repo_grouping():
        nonlocal agents, groups, group_by_repo, selected, message
        current = selected_agent()
        group_by_repo = not group_by_repo
        save_repo_grouping(group_by_repo)
        groups = group_agents(agents, group_by_repo)
        agents = [agent for _, members in groups for agent in members]
        if current:
            selected = agents.index(current)
        message = "Agents grouped by repository" if group_by_repo else "Showing all agents"

    def selected_agent_runs():
        agent = selected_agent()
        return [run for run in runs if agent and run["agent"] == agent["name"]]

    def prompt_items():
        agent = selected_agent()
        if not agent:
            return []
        return [
            ("SYSTEM PROMPT", agent.get("system_prompt") or ""),
            ("STARTUP PROMPT", agent.get("startup_prompt") or ""),
        ]

    def move_detail_focus(delta):
        nonlocal focus, selected_prompt, selected_run
        items = [("run_now", 0)]
        items.extend(("prompts", index) for index in range(len(prompt_items())))
        items.extend(("runs", index) for index in range(len(selected_agent_runs())))
        if not items:
            return
        current_item = ((focus, selected_prompt) if focus == "prompts" else
                        (focus, selected_run) if focus == "runs" else
                        ("run_now", 0))
        current_index = items.index(current_item) if current_item in items else 0
        focus, index = items[(current_index + delta) % len(items)]
        if focus == "prompts":
            selected_prompt = index
        elif focus == "runs":
            selected_run = index

    def view_prompt(index=None):
        nonlocal selected_prompt, message
        prompts = prompt_items()
        if not prompts:
            message = "No prompt selected"
            return
        if index is not None:
            selected_prompt = max(0, min(index, len(prompts) - 1))
        title, content = prompts[selected_prompt]
        tui_view_text(window, f"{selected_agent()['name']} · {title}", content, palette)
        message = f"Viewed {title.lower()}"

    def perform(action):
        nonlocal message, selected, selected_run
        agent = selected_agent()
        try:
            if action == "add":
                tui_suspend(window, edit_agent)
                message = "Agent created"
            elif action == "edit" and agent:
                tui_suspend(window, lambda: edit_agent(request({"op": "show_agent", "name": agent["name"]})["agent"]))
                message = f"Updated {agent['name']}"
            elif action == "run" and agent:
