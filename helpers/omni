        if value not in (None, ""):
            value = str(value).splitlines()[0]
            plain = f"{summary_key.replace('_', ' ').title():17}  {value}"
            rendered = styled(f"{summary_key.replace('_', ' ').title():17}", MUTED) + "  " + styled(value, BOLD)
            summary.append((plain, rendered))
    print_panel(summary or [("No values entered yet", styled("No values entered yet", MUTED))], width, "AGENT PREVIEW", BLUE)
    print()
    print(styled("    Tab", PEACH, BOLD) + styled(" autocomplete   ", MUTED) +
          styled(":back", PEACH, BOLD) + styled(" previous   ", MUTED) +
          styled(":cancel", PEACH, BOLD) + styled(" abort   ", MUTED) +
          styled("Return", PEACH, BOLD) + styled(" accept default", MUTED))
    print()


def edit_agent(existing=None, seed_path=None):
    old = existing or {}
    global_settings = request({"op": "get_settings"})["settings"]
    default_timeout = int(global_settings.get("default_timeout_seconds", 7200))
    global_timezone = global_settings.get("timezone") or system_timezone()
    project = discover_project(seed_path) if seed_path and not old else None
    values = {
        "name": old.get("name", ""), "provider": old.get("provider", "codex"),
        "workspace": old.get("workspace", str(project or Path.cwd())), "system_prompt": old.get("system_prompt", ""),
        "startup_prompt": old.get("startup_prompt", ""), "model": old.get("model", ""),
        "schedule_phrase": old.get("schedule", {}).get("phrase", "daily at 09:00"),
        "overlap": old.get("overlap", "replace"),
        "timeout": "off" if "timeout_seconds" in old and old.get("timeout_seconds") is None else f"{old.get('timeout_seconds', default_timeout)}s",
        "permission_mode": old.get("permission_mode", ""),
        "advanced_args": shlex.join(old.get("advanced_args", [])),
    }
    fields = [
        ("name", "Name", {}),
        ("provider", "Provider", {"choices": ["codex", "claude"], "picker": True}),
        ("workspace", "Workspace", {"path_picker": True}),
        ("system_prompt", "System prompt", {"multiline": True}),
        ("startup_prompt", "Startup prompt", {"multiline": True}),
        ("model", "Model", {"picker": True}),
        ("schedule_phrase", "Schedule", {"choices": ["every 30 minutes", "every 1 hour", "daily at 09:00", "weekdays at 9am", "weekly on monday at 10:00", "once at "]}),
        ("overlap", "Overlap", {"choices": ["replace", "parallel"]}),
        ("timeout", "Timeout", {"choices": ["30m", "1h", "2h", "4h", "8h", "off"]}),
        ("permission_mode", "Permission mode", {"choices": ["", "default", "acceptEdits", "bypassPermissions", "untrusted", "on-request", "never"]}),
        ("advanced_args", "Advanced arguments", {}),
    ]
    index = 0
    while index < len(fields):
        key, label, options = fields[index]
        options = dict(options)
        if key == "model":
            options["choices"] = model_choices(values["provider"])
        wizard_header(index, fields, values)
        try:
            if options.pop("picker", False):
                current = values.get(key) or ("provider default" if key == "model" else None)
                value = interactive_picker(label, options.pop("choices"), current)
                if value == "Custom model…":
                    value = ask("Custom model", values.get(key))
                elif key == "model" and value == "provider default":
                    value = ""
            elif options.pop("path_picker", False):
                value = interactive_path_picker(label, values.get(key) or str(Path.cwd()))
            else:
                value = ask(label, values.get(key), **options)
        except (EOFError, KeyboardInterrupt):
            raise SystemExit("Cancelled")
        if value == ":cancel":
            raise SystemExit("Cancelled")
        if value == ":back":
            index = max(0, index - 1)
            continue
        values[key] = value
        index += 1
    name = values["name"] or generated_agent_name(values["workspace"], values["startup_prompt"])
    if old.get("name") and name != old["name"]:
        raise SystemExit("Agent names are immutable; create a new agent to use another name")
    provider = values["provider"].lower()
    if provider not in {"codex", "claude"}:
        raise SystemExit("Provider must be codex or claude")
    workspace = str(Path(values["workspace"]).expanduser().resolve())
    if not Path(workspace).is_dir():
        raise SystemExit(f"Workspace does not exist: {workspace}")
    system_prompt = values["system_prompt"]
    startup_prompt = values["startup_prompt"]
    model = values["model"]
    phrase = values["schedule_phrase"]
    schedule, next_run = parse_schedule(phrase, global_timezone)
    overlap = values["overlap"]
    if overlap not in {"replace", "parallel"}:
        raise SystemExit("Overlap must be replace or parallel")
    timeout = parse_duration(values["timeout"])
    permissions = values["permission_mode"]
    advanced = shlex.split(values["advanced_args"])
    reserved = {"-C", "--cd", "--cwd", "--system-prompt", "--model", "-m", "--permission-mode", "--ask-for-approval", "-a", "--sandbox"}
    if any(value.split("=", 1)[0] in reserved for value in advanced):
        raise SystemExit("Advanced arguments contain an OmniTerm-owned flag")
    agent = {"name": name, "provider": provider, "workspace": workspace,
             "system_prompt": system_prompt, "startup_prompt": startup_prompt,
             "model": model, "schedule": schedule,
             "next_run": next_run, "overlap": overlap, "timeout_seconds": timeout,
             "permission_mode": "" if permissions == "default" else permissions, "advanced_args": advanced,
             "enabled": old.get("enabled", True)}
    os.system("clear")
    width = terminal_width()
    print(styled("OMNITERM", PEACH, BOLD) + styled("  ·  AGENT REVIEW", BOLD))
    print(styled("Confirm the normalized configuration before saving", MUTED))
    print()
    review = []
    for label, value in (
        ("Name", name), ("Provider", provider), ("Workspace", workspace),
        ("Model", model or "provider default"), ("Schedule", schedule["phrase"]),
        ("Timezone", f"{global_timezone} (global)"), ("Overlap", overlap),
        ("Retention", "off" if timeout is None else values["timeout"]),
    ):
        plain = f"{label:15}  {value}"
        review.append((plain, styled(f"{label:15}", MUTED) + "  " + styled(value, BOLD)))
    print_panel(review, width, "CONFIGURATION", PEACH)
    print()
    next_lines = []
    cursor = next_run
    for _ in range(3):
        value = dt.datetime.fromtimestamp(cursor, ZoneInfo(global_timezone)).strftime("%a %d %b %Y · %H:%M %Z")
        next_lines.append((f"◷  {value}", styled("◷  ", GREEN) + styled(value, BOLD)))
        cursor = next_calendar(schedule, global_timezone, cursor)
        if cursor is None:
            break
    print_panel(next_lines, width, "NEXT RUNS", BLUE)
    print()
    if ask("Save agent? (y/n)", "y").lower() != "y":
        raise SystemExit("Cancelled")
    request({"op": "save_agent", "agent": agent})
    print(styled(f"  ● Saved {name}", GREEN, BOLD))


def fmt_time(value, timezone=None):
    if not isinstance(value, (int, float)):
        return "—"
    zone = ZoneInfo(timezone) if timezone else None
    return dt.datetime.fromtimestamp(value, zone).strftime("%Y-%m-%d %H:%M")


def tui_text(window, y, x, text, style=0, width=None):
    try:
        height, columns = window.getmaxyx()
        if y < 0 or y >= height or x < 0 or x >= columns:
            return
        limit = max(0, min(width if width is not None else columns - x, columns - x - 1))
        window.addnstr(y, x, str(text), limit, style)
    except curses.error:
        pass


def tui_cursor(visibility):
    """Change cursor visibility when supported by the active terminal."""
    try:
        curses.curs_set(visibility)
    except curses.error:
        pass


def wrapped_preview(value, width, max_lines):
    value = (value or "").strip()
    if not value:
        return ["—"]
    lines = []
    for paragraph in value.splitlines() or [value]:
        lines.extend(textwrap.wrap(paragraph, width=max(8, width),
                                   replace_whitespace=True,
                                   drop_whitespace=True) or [""])
    if len(lines) > max_lines:
        lines = lines[:max_lines]
        lines[-1] = lines[-1][:max(1, width - 1)].rstrip() + "…"
    return lines


def wrapped_content(value, width):
    """Wrap complete prompt content while preserving intentional blank lines."""
    value = value or ""
    if not value.strip():
        return ["— No prompt configured —"]
    lines = []
    for paragraph in value.splitlines():
        if paragraph:
            lines.extend(textwrap.wrap(paragraph, width=max(8, width),
                                       replace_whitespace=False,
                                       drop_whitespace=True) or [""])
        else:
            lines.append("")
    if value.endswith("\n"):
        lines.append("")
    return lines


def tui_box(window, y, x, height, width, style=0, title=None):
    if height < 2 or width < 2:
        return
    tui_text(window, y, x, "╭" + "─" * (width - 2) + "╮", style, width)
    for row in range(y + 1, y + height - 1):
        tui_text(window, row, x, "│", style)
        tui_text(window, row, x + width - 1, "│", style)
    tui_text(window, y + height - 1, x, "╰" + "─" * (width - 2) + "╯", style, width)
    if title:
        tui_text(window, y, x + 2, f" {title} ", style | curses.A_BOLD, width - 4)


def tui_palette():
    curses.start_color()
    if not curses.has_colors() or curses.COLORS <= 0:
        return {name: 0 for name in ("peach", "green", "blue", "muted", "red")}
    background = -1
    try:
        curses.use_default_colors()
    except curses.error:
        background = curses.COLOR_BLACK
    colors = {
        "peach": 209 if curses.COLORS >= 256 else curses.COLOR_YELLOW,
        "green": 78 if curses.COLORS >= 256 else curses.COLOR_GREEN,
        "blue": 111 if curses.COLORS >= 256 else curses.COLOR_CYAN,
        "muted": 245 if curses.COLORS >= 256 else curses.COLOR_WHITE,
        "red": 203 if curses.COLORS >= 256 else curses.COLOR_RED,
    }
    for index, name in enumerate(colors, 1):
        curses.init_pair(index, colors[name], background)
    return {name: curses.color_pair(index) for index, name in enumerate(colors, 1)}


def interactive_picker(label, choices, default=None):
    choices = list(dict.fromkeys(([default] if default and default not in choices else []) + list(choices)))

    def screen(window):
        palette = tui_palette()
        tui_cursor(0)
        window.keypad(True)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        selected = choices.index(default) if default in choices else 0
        first = 0
        while True:
            window.erase()
            height, width = window.getmaxyx()
            box_width = max(36, min(88, width - 4))
            box_height = max(8, min(height - 4, len(choices) + 6))
            x, y = max(2, (width - box_width) // 2), max(1, (height - box_height) // 2)
            tui_box(window, y, x, box_height, box_width, palette["peach"], label.upper())
            tui_text(window, y + 1, x + 3, "Choose with ↑↓ or mouse · Enter confirms", palette["muted"], box_width - 6)
            visible = max(1, box_height - 4)
            first = max(0, min(first, max(0, len(choices) - visible)))
            if selected < first:
                first = selected
            elif selected >= first + visible:
                first = selected - visible + 1
            for offset, value in enumerate(choices[first:first + visible]):
                index = first + offset
                marker = "▶" if index == selected else " "
                style = (palette["peach"] | curses.A_BOLD | curses.A_REVERSE) if index == selected else 0
                tui_text(window, y + 2 + offset, x + 3, f"{marker} {value}", style, box_width - 6)
            tui_text(window, y + box_height - 2, x + 3, "Esc goes back", palette["muted"], box_width - 6)
            window.refresh()
            key = window.getch()
            if key in (10, 13, curses.KEY_ENTER):
                return choices[selected]
            if key == 27:
                return ":back"
            if key in (curses.KEY_UP, ord("k")):
                selected = (selected - 1) % len(choices)
            elif key in (curses.KEY_DOWN, ord("j")):
                selected = (selected + 1) % len(choices)
            elif key == curses.KEY_HOME:
                selected = 0
            elif key == curses.KEY_END:
                selected = len(choices) - 1
            elif key == curses.KEY_PPAGE:
                selected = max(0, selected - visible)
            elif key == curses.KEY_NPAGE:
                selected = min(len(choices) - 1, selected + visible)
            elif key == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    offset = mouse_y - (y + 2)
                    if x + 1 <= mouse_x < x + box_width - 1 and 0 <= offset < visible:
                        index = first + offset
                        if index < len(choices) and state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED | curses.BUTTON1_RELEASED):
                            return choices[index]
                except curses.error:
                    pass

    return curses.wrapper(screen)


def display_path(path):
    value = str(path)
    home = str(Path.home())
    return "~" + value[len(home):] if value == home or value.startswith(home + os.sep) else value


def interactive_path_picker(label, default):
    def candidates(value):
        matches = path_completion_matches(value)
        expanded = Path(value).expanduser()
        if expanded.is_dir() and not value.endswith(os.sep):
            exact = display_path(expanded.resolve()) + "/"
            if exact not in matches:
                matches.insert(0, exact)
        return matches

    def screen(window):
        palette = tui_palette()
        tui_cursor(1)
        window.keypad(True)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        value = display_path(Path(default).expanduser())
        if str(default).endswith(os.sep) and value != os.sep:
            value += os.sep
        selected = 0
        first = 0
        while True:
            options = candidates(value)
            if options:
                selected = min(selected, len(options) - 1)
            else:
                selected = 0
            window.erase()
            height, width = window.getmaxyx()
            box_width = max(48, min(104, width - 4))
            box_height = max(10, min(height - 4, 22))
            x, y = max(2, (width - box_width) // 2), max(1, (height - box_height) // 2)
            visible = box_height - 6
            first = min(first, max(0, len(options) - visible))
            if selected < first:
                first = selected
            elif selected >= first + visible:
                first = selected - visible + 1
            tui_box(window, y, x, box_height, box_width, palette["peach"], label.upper())
            tui_text(window, y + 1, x + 3, "Path", palette["muted"] | curses.A_BOLD, 8)
            tui_text(window, y + 1, x + 9, value, curses.A_BOLD, box_width - 12)
            tui_text(window, y + 2, x + 3, "─" * (box_width - 6), palette["blue"], box_width - 6)
            for offset, option in enumerate(options[first:first + visible]):
                index = first + offset
                marker = "▶" if index == selected else " "
                style = (palette["peach"] | curses.A_BOLD | curses.A_REVERSE) if index == selected else 0
                tui_text(window, y + 3 + offset, x + 3, f"{marker} {option}", style, box_width - 6)
            if not options:
                tui_text(window, y + 4, x + 5, "No matching folders", palette["muted"], box_width - 10)
            tui_text(window, y + box_height - 2, x + 3,
                     "Tab/↑↓ choose · Enter select · → browse · Ctrl-U clear · Esc back",
                     palette["muted"], box_width - 6)
            try:
                window.move(y + 1, x + 9 + min(len(value), box_width - 13))
            except curses.error:
                pass
            window.refresh()
            key = window.get_wch()
            if key in ("\n", "\r", curses.KEY_ENTER):
                chosen = options[selected] if options else value
                resolved = Path(chosen).expanduser().resolve()
                if resolved.is_dir():
                    return str(resolved)
            elif key == "\x1b":
                return ":back"
            elif key == "\x03":
                raise KeyboardInterrupt
            elif key in ("\t", curses.KEY_DOWN):
                if options:
                    selected = (selected + 1) % len(options)
            elif key in (curses.KEY_BTAB, curses.KEY_UP):
                if options:
                    selected = (selected - 1) % len(options)
            elif key == curses.KEY_NPAGE and options:
                selected = min(len(options) - 1, selected + visible)
            elif key == curses.KEY_PPAGE and options:
                selected = max(0, selected - visible)
            elif key in (curses.KEY_RIGHT, "/") and options:
                value = options[selected].rstrip("/") + "/"
                selected = first = 0
            elif key in ("\x7f", "\b", curses.KEY_BACKSPACE):
                value = value[:-1]
                selected = first = 0
            elif key == "\x15":
                value = ""
                selected = first = 0
            elif key == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    offset = mouse_y - (y + 3)
                    if x + 1 <= mouse_x < x + box_width - 1 and 0 <= offset < visible:
                        index = first + offset
                        if index < len(options) and state & curses.BUTTON1_DOUBLE_CLICKED:
                            return str(Path(options[index]).expanduser().resolve())
                        if index < len(options) and state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                            selected = index
                except curses.error:
                    pass
            elif isinstance(key, str) and key.isprintable():
                value += key
                selected = first = 0

    return curses.wrapper(screen)


def editor_visual_rows(text, width):
    rows = []
    start = 0
    for logical in text.split("\n"):
        if not logical:
            rows.append((start, start, ""))
        else:
            for offset in range(0, len(logical), width):
                chunk = logical[offset:offset + width]
                rows.append((start + offset, start + offset + len(chunk), chunk))
        start += len(logical) + 1
    return rows or [(0, 0, "")]


def interactive_text_editor(label, default=""):
    def screen(window):
        palette = tui_palette()
        window.keypad(True)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        text = default
        cursor = len(text)
        scroll = 0
        while True:
            window.erase()
            height, width = window.getmaxyx()
            box_width = max(44, min(100, width - 4))
            box_height = max(9, min(height - 4, 20))
            x, y = max(2, (width - box_width) // 2), max(1, (height - box_height) // 2)
            content_width = max(8, box_width - 6)
            rows = editor_visual_rows(text, content_width)
            cursor_row = len(rows) - 1
            cursor_column = 0
            for index, (start, end, _) in enumerate(rows):
                if start <= cursor <= end:
                    cursor_row = index
                    cursor_column = cursor - start
                    break
            visible = box_height - 5
            scroll = min(scroll, max(0, len(rows) - visible))
            if cursor_row < scroll:
                scroll = cursor_row
            elif cursor_row >= scroll + visible:
                scroll = cursor_row - visible + 1
            tui_box(window, y, x, box_height, box_width, palette["peach"], label.upper())
            tui_text(window, y + 1, x + 3, "Enter saves · ⌘Enter new line · click to place cursor", palette["muted"], box_width - 6)
            for offset, (_, _, value) in enumerate(rows[scroll:scroll + visible]):
                tui_text(window, y + 2 + offset, x + 3, value, 0, content_width)
            tui_text(window, y + box_height - 2, x + 3, "Esc goes back", palette["muted"], box_width - 6)
            try:
                tui_cursor(1)
                window.move(y + 2 + cursor_row - scroll, x + 3 + min(cursor_column, content_width - 1))
            except curses.error:
                pass
            window.refresh()
            key = window.get_wch()
            if key in ("\n", "\r", curses.KEY_ENTER):
                return text
            if key == "\x1e":
                text = text[:cursor] + "\n" + text[cursor:]
                cursor += 1
            elif key == "\x1b":
                return ":back"
            elif key == "\x03":
                raise KeyboardInterrupt
            elif key in ("\x7f", "\b", curses.KEY_BACKSPACE):
                if cursor:
                    text = text[:cursor - 1] + text[cursor:]
                    cursor -= 1
            elif key == curses.KEY_DC:
                text = text[:cursor] + text[cursor + 1:]
            elif key == curses.KEY_LEFT:
                cursor = max(0, cursor - 1)
            elif key == curses.KEY_RIGHT:
                cursor = min(len(text), cursor + 1)
            elif key == curses.KEY_HOME:
                cursor = rows[cursor_row][0]
            elif key == curses.KEY_END:
                cursor = rows[cursor_row][1]
            elif key in (curses.KEY_UP, curses.KEY_DOWN):
                target = cursor_row + (-1 if key == curses.KEY_UP else 1)
                if 0 <= target < len(rows):
                    cursor = min(rows[target][0] + cursor_column, rows[target][1])
            elif key == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    row = scroll + mouse_y - (y + 2)
                    if 0 <= row < len(rows) and x + 3 <= mouse_x < x + box_width - 3 and state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                        cursor = min(rows[row][0] + mouse_x - (x + 3), rows[row][1])
                except curses.error:
                    pass
            elif isinstance(key, str) and key.isprintable():
                text = text[:cursor] + key + text[cursor:]
                cursor += len(key)

    return curses.wrapper(screen)


def tui_confirm(window, message, palette):
    height, width = window.getmaxyx()
    box_width = min(max(len(message) + 8, 44), width - 4)
    y, x = max(1, height // 2 - 2), max(2, (width - box_width) // 2)
    tui_box(window, y, x, 5, box_width, palette["peach"], "CONFIRM")
    tui_text(window, y + 2, x + 3, message, curses.A_BOLD, box_width - 6)
    tui_text(window, y + 3, x + 3, "Enter confirm  ·  Esc cancel", palette["muted"], box_width - 6)
    window.refresh()
    while True:
        key = window.getch()
        if key in (10, 13):
            return True
        if key in (27, ord("q")):
            return False


def tui_view_text(window, title, content, palette):
    """Show a resize-aware, scrollable prompt viewer over the dashboard."""
    scroll = 0
    window.timeout(-1)
    try:
        while True:
            window.erase()
            height, width = window.getmaxyx()
            if height < 9 or width < 32:
                tui_text(window, 1, 2, title, palette["peach"] | curses.A_BOLD, width - 4)
                tui_text(window, 3, 2, "Resize to view this prompt", palette["muted"], width - 4)
                window.refresh()
            else:
                box_height = height - 4
                box_width = width - 4
                y, x = 2, 2
                body_width = box_width - 6
                visible_rows = max(1, box_height - 5)
                lines = wrapped_content(content, body_width)
                scroll = min(scroll, max(0, len(lines) - visible_rows))
                tui_box(window, y, x, box_height, box_width, palette["peach"], title)
                position = f"{scroll + 1}–{min(len(lines), scroll + visible_rows)} / {len(lines)}"
                tui_text(window, y + 1, x + 3, position, palette["blue"] | curses.A_BOLD, body_width)
                for offset, line in enumerate(lines[scroll:scroll + visible_rows]):
                    tui_text(window, y + 2 + offset, x + 3, line, 0, body_width)
                help_text = "↑↓ scroll  ·  PgUp/PgDn  ·  Home/End  ·  Enter or Esc closes"
                tui_text(window, y + box_height - 2, x + 3, help_text, palette["muted"], body_width)
                window.refresh()

            key = window.getch()
            page = max(1, (height - 4) - 6)
            if key in (10, 13, 27, ord("q")):
                return
            if key in (curses.KEY_UP, ord("k")):
                scroll = max(0, scroll - 1)
            elif key in (curses.KEY_DOWN, ord("j")):
                scroll += 1
            elif key == curses.KEY_PPAGE:
                scroll = max(0, scroll - page)
            elif key == curses.KEY_NPAGE:
                scroll += page
            elif key == curses.KEY_HOME:
                scroll = 0
            elif key == curses.KEY_END:
                scroll = 1 << 30
            elif key == curses.KEY_MOUSE:
                try:
                    _, _, _, _, state = curses.getmouse()
                    if state & getattr(curses, "BUTTON4_PRESSED", 0):
                        scroll = max(0, scroll - 3)
                    elif state & getattr(curses, "BUTTON5_PRESSED", 0):
                        scroll += 3
                except curses.error:
                    pass
    finally:
        window.timeout(1000)
        window.clear()


def tui_suspend(window, callback):
    curses.def_prog_mode()
    curses.endwin()
    try:
        callback()
    except SystemExit as exc:
        message = str(exc)
        if message and message != "Cancelled":
            print(message)
            input("Press return…")
    finally:
        curses.reset_prog_mode()
        tui_cursor(0)
        window.keypad(True)
        window.clear()
        window.refresh()


def dashboard_screen(window):
    palette = tui_palette()
    tui_cursor(0)
    window.keypad(True)
    window.timeout(1000)
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        print("\033[?1003h", end="", flush=True)
    except curses.error:
        pass

    selected = 0
    selected_run = 0
    selected_prompt = 0
    focus = "agents"
    message = "Ready"
    agents, runs = [], []
    hitboxes = []
    last_refresh = 0

    def reload_data(force=False):
        nonlocal agents, runs, selected, last_refresh, message
        if not force and time.monotonic() - last_refresh < 1:
            return
        try:
            agents = request({"op": "list_agents"})["agents"]
            runs = request({"op": "list_runs"})["runs"]
            selected = max(0, min(selected, len(agents) - 1))
            last_refresh = time.monotonic()
        except BaseException as exc:
            message = f"Scheduler reconnecting · {exc}"

    def selected_agent():
        return agents[selected] if agents else None

    def selected_agent_runs():
        agent = selected_agent()
        return [run for run in runs if agent and run["agent"] == agent["name"]]

    def prompt_items():
        agent = selected_agent()
        if not agent:
            return []
        return [
            ("SYSTEM PROMPT", agent.get("system_prompt") or ""),
            ("STARTUP PROMPT", agent.get("startup_prompt") or ""),
        ]

    def focus_panels():
        panels = ["agents"]
        if prompt_items():
            panels.append("prompts")
        if selected_agent_runs():
            panels.append("runs")
        return panels

    def view_prompt(index=None):
        nonlocal selected_prompt, message
        prompts = prompt_items()
        if not prompts:
            message = "No prompt selected"
            return
        if index is not None:
            selected_prompt = max(0, min(index, len(prompts) - 1))
        title, content = prompts[selected_prompt]
        tui_view_text(window, f"{selected_agent()['name']} · {title}", content, palette)
        message = f"Viewed {title.lower()}"

    def perform(action):
        nonlocal message, selected, selected_run
        agent = selected_agent()
        try:
            if action == "add":
                tui_suspend(window, edit_agent)
                message = "Agent created"
            elif action == "edit" and agent:
                tui_suspend(window, lambda: edit_agent(request({"op": "show_agent", "name": agent["name"]})["agent"]))
                message = f"Updated {agent['name']}"
            elif action == "run" and agent:
                run_id = request({"op": "run_agent", "name": agent["name"]})["run_id"]
                message = f"Started {agent['name']} · {run_id[:8]}"
            elif action == "toggle" and agent:
                request({"op": "set_enabled", "name": agent["name"], "enabled": not agent["enabled"]})
                message = f"{'Enabled' if not agent['enabled'] else 'Paused'} {agent['name']}"
            elif action == "delete" and agent and tui_confirm(window, f"Delete {agent['name']}?", palette):
                request({"op": "delete_agent", "name": agent["name"]})
                selected = max(0, selected - 1)
                message = f"Deleted {agent['name']}"
            elif action == "stop" and agent:
                active = next((run for run in runs if run["agent"] == agent["name"] and run["state"] in {"starting", "running"}), None)
                if active:
                    request({"op": "stop_run", "run_id": active["id"]})
                    message = f"Stopping {agent['name']}"
                else:
                    message = "No active run for this agent"
            elif action == "resume":
                recent = selected_agent_runs()
                if recent:
                    source = recent[min(selected_run, len(recent) - 1)]
                    run_id = request({"op": "resume_run", "run_id": source["id"]})["run_id"]
                    message = f"Resumed {source['id'][:8]} in a new tab · {run_id[:8]}"
                else:
                    message = "No recent run selected"
            reload_data(True)
        except BaseException as exc:
            message = f"Error · {exc}"

    def render():
        nonlocal hitboxes
        window.erase()
        height, width = window.getmaxyx()
        hitboxes = []
        if height < 24 or width < 76:
            tui_box(window, 1, 1, max(3, height - 2), max(3, width - 2), palette["peach"])
            tui_text(window, height // 2 - 1, 4, "OMNITERM", palette["peach"] | curses.A_BOLD)
            tui_text(window, height // 2 + 1, 4, "Resize to at least 76 × 24", palette["muted"])
            window.refresh()
            return

        logo = [
            "  ___   __  __  _   _  ___ ",
            " / _ \\ |  \\/  || \\ | ||_ _|",
            "| | | || |\\/| ||  \\| | | | ",
            "| |_| || |  | || |\\  | | | ",
            " \\___/ |_|  |_||_| \\_||___|",
        ]
        for row, line in enumerate(logo):
            tui_text(window, row, 2, line, palette["peach"] | curses.A_BOLD, min(32, width - 4))
        header_x = 36
        tui_text(window, 1, header_x, "OmniTerm Agents", curses.A_BOLD, width - header_x - 2)
        tui_text(window, 2, header_x, "Interactive scheduler · Codex + Claude", palette["muted"], width - header_x - 2)
        active_count = sum(run["state"] in {"starting", "running"} for run in runs)
        tui_text(window, 3, header_x, f"● {active_count} active   ◆ {len(agents)} agents   ◷ {len(runs)} runs", palette["green"], width - header_x - 2)
        tui_text(window, 4, header_x, "mouse enabled  ·  ↑↓ navigate  ·  Enter opens selection", palette["blue"], width - header_x - 2)

        body_y = 6
        body_height = height - 11
        left_width = max(38, min(58, width // 2))
        right_x = left_width + 2
        right_width = width - right_x - 1
        tui_box(window, body_y, 1, body_height, left_width, palette["peach"], "AGENTS")
        tui_box(window, body_y, right_x, body_height, right_width, palette["blue"], "DETAILS")

        visible_cards = max(1, (body_height - 3) // 4)
        first = max(0, min(selected - visible_cards + 1, max(0, len(agents) - visible_cards)))
        if not agents:
            tui_text(window, body_y + 3, 4, "◇ No agents yet", palette["muted"] | curses.A_BOLD)
            tui_text(window, body_y + 5, 4, "Click ＋ Add agent to create one.", palette["muted"])
        for position, agent in enumerate(agents[first:first + visible_cards]):
            index = first + position
            y = body_y + 2 + position * 4
            chosen = index == selected
