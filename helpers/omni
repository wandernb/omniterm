def notify_payload(title, body=None, severity=None, workspace=None, include_diff=None,
                   dedupe_key=None, run_id=None, kind=None):
    payload = {"op": "notify", "title": title}
    if kind:
        if kind not in NOTIFICATION_KINDS:
            raise ValueError("Unknown notification kind")
        payload["kind"] = kind
    if body:
        payload["body"] = body
    if severity:
        if severity not in NOTIFICATION_SEVERITIES:
            raise ValueError("Severity must be info, attention or urgent")
        payload["severity"] = severity
    if workspace:
        payload["workspace"] = str(Path(workspace).expanduser().resolve())
    if include_diff is not None:
        payload["include_diff"] = bool(include_diff)
    if dedupe_key:
        payload["dedupe_key"] = dedupe_key
    if run_id:
        payload["run_id"] = run_id
    return payload


