def edit_agent(existing=None, seed_path=None):
    old = existing or {}
    global_settings = request({"op": "get_settings"})["settings"]
    default_timeout = int(global_settings.get("default_timeout_seconds", 7200))
    defaults = agent_defaults(global_settings)
    default_provider = old.get("provider", defaults["provider"])
    global_timezone = global_settings.get("timezone") or system_timezone()
    project = discover_project(seed_path) if seed_path and not old else None
    schedule_phrase = old.get("schedule", {}).get("phrase", "daily at 09:00")
    values = {
        "name": old.get("name", ""), "provider": default_provider,
        "workspace": old.get("workspace", str(project or Path.cwd())), "system_prompt": old.get("system_prompt", ""),
        "startup_prompt": old.get("startup_prompt", ""),
        "model": old.get("model", "" if old else defaults["models"][default_provider]),
        "schedule_phrase": schedule_phrase,
        "overlap": old.get("overlap", defaults["overlap"]),
        "timeout": "off" if "timeout_seconds" in old and old.get("timeout_seconds") is None else f"{old.get('timeout_seconds', default_timeout)}s",
        "permission_mode": old.get("permission_mode", "" if old else defaults["permission_modes"][default_provider]),
        "advanced_args": shlex.join(old.get("advanced_args", [])),
    }
    values.update(schedule_form_values(schedule_phrase))
    values.update({key: str(value).lower() if isinstance(value, bool) else str(value)
                   for key, value in lifecycle_fields(old).items()})
    normalize_schedule_controls(values)
    try:
        values = interactive_agent_form(
            values,
            existing=old,
            validator=lambda candidate: normalized_agent(candidate, old, global_timezone))
    except (EOFError, KeyboardInterrupt):
        raise SystemExit("Cancelled")
    if values is None:
        raise SystemExit("Cancelled")

    agent = normalized_agent(values, old, global_timezone)
    request({"op": "save_agent", "agent": agent})
    print(styled(f"  ● Saved {agent['name']}", GREEN, BOLD))


def lifecycle_fields(candidate):
    """Validate lifecycle policy shared by the native form, CLI and MCP."""
    kind = candidate.get("kind", "scheduled")
    if kind not in {"scheduled", "loop"}:
        raise ValueError("Kind must be scheduled or loop")
    policy = candidate.get("session_policy", "resume")
    if policy not in {"fresh", "resume"}:
        raise ValueError("Session policy must be fresh or resume")
    if kind == "loop":
        policy = "resume"
    compact = candidate.get("compact_on_end", False)
    if not isinstance(compact, bool):
        raise ValueError("compact_on_end must be a boolean")
    result = {"kind": kind, "session_policy": policy, "compact_on_end": compact}
    for key, default in (("run_budget_seconds", 600 if kind == "loop" else 0), ("wrap_up_seconds", 120)):
        value = candidate.get(key, default)
        if isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 604800:
            raise ValueError(f"{key} must be whole seconds between 0 and 604800")
        result[key] = value
    if result["run_budget_seconds"] and result["wrap_up_seconds"] > result["run_budget_seconds"]:
        raise ValueError("Wrap-up warning cannot exceed the soft run budget")
    return result


def normalized_agent(values, old, global_timezone):
    """Validate form values and produce the scheduler's canonical agent object."""
    name = values["name"] or generated_agent_name(values["workspace"], values["startup_prompt"])
    if old.get("name") and name != old["name"]:
        raise ValueError("Agent names are immutable; create a new agent to use another name")
    provider = values["provider"].lower()
    if provider not in {"codex", "claude"}:
        raise ValueError("Provider must be codex or claude")
    workspace = str(Path(values["workspace"]).expanduser().resolve())
    if not Path(workspace).is_dir():
        raise ValueError(f"Workspace does not exist: {workspace}")
    system_prompt = values["system_prompt"]
    startup_prompt = values["startup_prompt"]
    model = values["model"]
    phrase = (schedule_phrase_from_form(values)
              if values.get("repeat_unit") else values["schedule_phrase"])
    values["schedule_phrase"] = phrase
    schedule, next_run = parse_schedule(phrase, global_timezone)
    overlap = values["overlap"]
    if overlap not in {"replace", "parallel"}:
        raise ValueError("Overlap must be replace or parallel")
    timeout = parse_duration(values["timeout"])
    permissions = stored_permission_mode(values["permission_mode"])
    advanced = shlex.split(values["advanced_args"])
    if any(value.split("=", 1)[0] in RESERVED_ADVANCED_ARGS for value in advanced):
        raise ValueError("Advanced arguments contain an OmniTerm-owned flag")
    appearance, errors = appearance_errors({key: values[key] if key in values else old.get(key)
                                            for key in APPEARANCE_FIELDS})
    if errors:
        raise ValueError(next(iter(errors.values())))
    lifecycle_candidate = {**old, **values}
    for key in ("run_budget_seconds", "wrap_up_seconds"):
        if isinstance(lifecycle_candidate.get(key), str):
            lifecycle_candidate[key] = int(lifecycle_candidate[key])
    if isinstance(lifecycle_candidate.get("compact_on_end"), str):
        if lifecycle_candidate["compact_on_end"] not in {"true", "false"}:
            raise ValueError("Compact on end must be true or false")
        lifecycle_candidate["compact_on_end"] = lifecycle_candidate["compact_on_end"] == "true"
    lifecycle = lifecycle_fields(lifecycle_candidate)
    if lifecycle["kind"] == "loop":
        overlap = "parallel"
    return with_appearance({**lifecycle, "name": name, "provider": provider, "workspace": workspace,
                            "system_prompt": system_prompt, "startup_prompt": startup_prompt,
                            "model": model, "schedule": schedule,
                            "next_run": next_run, "overlap": overlap, "timeout_seconds": timeout,
                            "permission_mode": permissions,
                            "advanced_args": advanced, "enabled": old.get("enabled", True)}, appearance)


def nested_setting(key, value):
    """`a.b.c` and a value as the nested object `set_settings` takes."""
    parts = [part for part in key.split(".")]
    if not all(parts):
        raise ValueError(f"Invalid setting name: {key}")
    for part in reversed(parts[1:]):
        value = {part: value}
    return {parts[0]: value}


def parsed_setting_value(text):
    try:
        return json.loads(text)
    except ValueError:
        return text


def mute_until(duration, now=None):
    """The `muted_until` value for a duration: seconds since the epoch, or "forever"."""
    now = time.time() if now is None else now
    duration = duration.strip().lower()
    if duration in {"forever", "", "on"}:
        return "forever"
    if duration == "tomorrow":
        moment = dt.datetime.fromtimestamp(now)
        morning = (moment + dt.timedelta(days=1)).replace(hour=8, minute=0, second=0, microsecond=0)
        return int(morning.timestamp())
    match = re.fullmatch(r"(\d+)\s*([mh])", duration)
    if not match or int(match.group(1)) <= 0:
        raise ValueError("Give a duration such as 30m, 2h, tomorrow or forever")
    seconds = int(match.group(1)) * (3600 if match.group(2) == "h" else 60)
    return int(now) + seconds


def set_setting(key, text):
    try:
        changes = nested_setting(key, parsed_setting_value(text))
    except ValueError as error:
        raise SystemExit(str(error))
    response = request({"op": "set_settings", "settings": changes})
    if not response.get("ok"):
        raise SystemExit(response.get("error") or "Could not change the setting")
    print(f"Saved {key}.")


def stored_settings():
    """Global settings read from their file, without the scheduler.

    The app runs these helpers for its own editor, so they must not wait on its socket.
    """
    try:
        settings = json.loads(SETTINGS_FILE.read_text())
    except (OSError, ValueError):
        return {}
    return settings if isinstance(settings, dict) else {}


def schedule_preview(phrase, timezone, count=5):
    """The canonical schedule for a phrase and its next occurrences, as the editor shows them."""
    schedule, cursor = parse_schedule(phrase, timezone)
    next_run, occurrences = cursor, []
    for _ in range(max(1, min(20, count))):
        if cursor is None:
            break
        occurrences.append(cursor)
        cursor = next_calendar(schedule, timezone, cursor)
    return {"ok": True, "schedule": schedule, "phrase": schedule["phrase"], "timezone": timezone,
            "next_run": next_run, "occurrences": occurrences}


def parse_schedule_json(phrase, count=5, settings=None):
    settings = stored_settings() if settings is None else settings
    try:
        return schedule_preview(phrase, settings.get("timezone") or system_timezone(), count)
    except (ValueError, KeyError, OverflowError) as error:
        return {"ok": False, "error": str(error) or "Invalid schedule"}


def agent_form_values(candidate, default_timeout):
    """Map an agent object (agent-file shape, or with schedule_phrase/timeout) onto the editor's form
    values, collecting per-field errors the editor would refuse."""
    errors = {}
    try:
        lifecycle = lifecycle_fields(candidate)
    except ValueError as error:
        lifecycle = {}
        errors["lifecycle"] = str(error)
    if candidate.get("kind") == "loop":
        default_timeout = 86400

    def text(key):
        value = candidate.get(key)
        if value is None:
            return ""
        if not isinstance(value, str):
            errors[key] = f"{key} must be a string"
            return ""
        return value

    values = {key: text(key) for key in ("name", "provider", "workspace", "system_prompt", "startup_prompt",
                                         "model", "overlap", "permission_mode")}
    values["provider"] = values["provider"].lower() or agent_defaults(stored_settings())["provider"]
    values.update(lifecycle)
    values["overlap"] = values["overlap"] or "replace"
    if values["provider"] not in PERMISSION_MODES:
        errors["provider"] = "Provider must be codex or claude"
    elif stored_permission_mode(values["permission_mode"]) not in STORED_PERMISSION_MODES[values["provider"]]:
        errors["permission_mode"] = f"Invalid permission mode for {values['provider']}"
    if not values["workspace"].strip():
        errors["workspace"] = "Workspace is required"
    elif not Path(values["workspace"]).expanduser().is_dir():
        errors["workspace"] = f"Workspace does not exist: {Path(values['workspace']).expanduser().resolve()}"
    if values["overlap"] not in {"replace", "parallel"}:
        errors["overlap"] = "Overlap must be replace or parallel"

    phrase = candidate.get("schedule_phrase")
    if phrase is None and isinstance(candidate.get("schedule"), dict):
        phrase = candidate["schedule"].get("phrase")
    if not isinstance(phrase, str) or not phrase.strip():
        errors["schedule"] = "Schedule is required"
        phrase = ""
    values["schedule_phrase"] = phrase

    if "timeout" in candidate:
        timeout = candidate["timeout"]
        values["timeout"] = "off" if timeout is None else str(timeout)
    elif "timeout_seconds" in candidate:
        timeout = candidate["timeout_seconds"]
        if timeout is not None and (isinstance(timeout, bool) or not isinstance(timeout, int)):
            errors["timeout"] = "timeout_seconds must be a whole number of seconds or null"
        values["timeout"] = "off" if timeout is None else f"{timeout}s"
    else:
        values["timeout"] = f"{default_timeout}s"
    if "timeout" not in errors:
        try:
            parse_duration(values["timeout"])
        except ValueError as error:
            errors["timeout"] = str(error)

    advanced = candidate.get("advanced_args") or []
    if isinstance(advanced, list) and all(isinstance(item, str) for item in advanced):
        values["advanced_args"] = shlex.join(advanced)
    elif isinstance(advanced, str):
        values["advanced_args"] = advanced
    else:
        errors["advanced_args"] = "advanced_args must be a list of strings"
        values["advanced_args"] = ""
    try:
        if any(item.split("=", 1)[0] in RESERVED_ADVANCED_ARGS for item in shlex.split(values["advanced_args"])):
            errors["advanced_args"] = "Advanced arguments contain an OmniTerm-owned flag"
    except ValueError as error:
        errors["advanced_args"] = str(error)
    return values, errors


def normalize_agent_json(candidate, settings=None):
    """Validate an agent the way the editor does and return its canonical form. Writes nothing.

    Dangerous permission modes are accepted, as in the editor: only a person uses it.
    """
    if not isinstance(candidate, dict):
        return {"ok": False, "errors": {"agent": "Agent must be a JSON object"}}
    settings = stored_settings() if settings is None else settings
    timezone = settings.get("timezone") or system_timezone()
    values, errors = agent_form_values(candidate, int(settings.get("default_timeout_seconds", 7200)))
    if "schedule" not in errors:
        try:
            parse_schedule(values["schedule_phrase"], timezone)
        except (ValueError, KeyError, OverflowError) as error:
            errors["schedule"] = str(error) or "Invalid schedule"
    appearance, appearance_problems = appearance_errors({key: candidate.get(key) for key in APPEARANCE_FIELDS})
    errors.update(appearance_problems)
    values.update(appearance)
    if errors:
        return {"ok": False, "errors": errors}
    try:
        agent = normalized_agent(values, {"enabled": candidate.get("enabled", True) is not False}, timezone)
    except (ValueError, KeyError, OverflowError) as error:
        return {"ok": False, "errors": {"agent": str(error)}}
    return {"ok": True, "agent": agent, "dangerous": has_dangerous_permissions(agent)}


def fmt_time(value, timezone=None):
    if not isinstance(value, (int, float)):
        return "—"
    zone = ZoneInfo(timezone) if timezone else None
    return dt.datetime.fromtimestamp(value, zone).strftime("%Y-%m-%d %H:%M")


def tui_text(window, y, x, text, style=0, width=None):
    try:
        height, columns = window.getmaxyx()
        if y < 0 or y >= height or x < 0 or x >= columns:
            return
        limit = max(0, min(width if width is not None else columns - x, columns - x - 1))
        window.addnstr(y, x, str(text), limit, style)
    except curses.error:
        pass


def tui_cursor(visibility):
    """Change cursor visibility when supported by the active terminal."""
    try:
        curses.curs_set(visibility)
    except curses.error:
        pass


def wrapped_preview(value, width, max_lines):
    value = (value or "").strip()
    if not value:
        return ["—"]
    lines = []
    for paragraph in value.splitlines() or [value]:
        lines.extend(textwrap.wrap(paragraph, width=max(8, width),
                                   replace_whitespace=True,
                                   drop_whitespace=True) or [""])
    if len(lines) > max_lines:
        lines = lines[:max_lines]
        lines[-1] = lines[-1][:max(1, width - 1)].rstrip() + "…"
    return lines


def wrapped_content(value, width):
    """Wrap complete prompt content while preserving intentional blank lines."""
    value = value or ""
    if not value.strip():
        return ["— No prompt configured —"]
    lines = []
    for paragraph in value.splitlines():
        if paragraph:
            lines.extend(textwrap.wrap(paragraph, width=max(8, width),
                                       replace_whitespace=False,
                                       drop_whitespace=True) or [""])
        else:
            lines.append("")
    if value.endswith("\n"):
        lines.append("")
    return lines


def tui_box(window, y, x, height, width, style=0, title=None):
    if height < 2 or width < 2:
        return
    tui_text(window, y, x, "╭" + "─" * (width - 2) + "╮", style, width)
    for row in range(y + 1, y + height - 1):
        tui_text(window, row, x, "│", style)
        tui_text(window, row, x + width - 1, "│", style)
    tui_text(window, y + height - 1, x, "╰" + "─" * (width - 2) + "╯", style, width)
    if title:
        tui_text(window, y, x + 2, f" {title} ", style | curses.A_BOLD, width - 4)


def tui_palette():
    curses.start_color()
    if not curses.has_colors() or curses.COLORS <= 0:
        return {name: 0 for name in ("peach", "green", "blue", "muted", "red")}
    background = -1
    try:
        curses.use_default_colors()
    except curses.error:
        background = curses.COLOR_BLACK
    colors = {
        "peach": 209 if curses.COLORS >= 256 else curses.COLOR_YELLOW,
        "green": 78 if curses.COLORS >= 256 else curses.COLOR_GREEN,
        "blue": 111 if curses.COLORS >= 256 else curses.COLOR_CYAN,
        "muted": 245 if curses.COLORS >= 256 else curses.COLOR_WHITE,
        "red": 203 if curses.COLORS >= 256 else curses.COLOR_RED,
    }
    for index, name in enumerate(colors, 1):
        curses.init_pair(index, colors[name], background)
    return {name: curses.color_pair(index) for index, name in enumerate(colors, 1)}


