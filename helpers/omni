def request(payload):
    if payload.get("op") in {"save_agent", "create_agent", "update_agent"} and \
            isinstance(payload.get("agent"), dict) and payload["agent"].get("kind") == "loop":
        if request({"op": "get_settings"}).get("loop_mode") != "persistent":
            raise SystemExit("This OmniTerm build does not support persistent loops; update the app before saving a loop.")
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        try:
            client.connect(str(SOCKET))
        except OSError as exc:
            raise SystemExit(f"OmniTerm scheduler is unavailable: {exc}")
        client.sendall(json.dumps(payload).encode() + b"\n")
        try:
            client.shutdown(socket.SHUT_WR)
        except OSError:
            pass  # The scheduler may already have answered and closed.
        chunks = []
        while True:
            chunk = client.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
        response = json.loads(b"".join(chunks))
        if not response.get("ok"):
            raise SystemExit(response.get("error", "Scheduler request failed"))
        return response
    finally:
        client.close()


