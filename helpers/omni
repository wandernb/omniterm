def parse_duration(value):
    text = value.strip().lower()
    if text in {"off", "none", "disabled", "0"}:
        return None
    units = {"s": 1, "sec": 1, "m": 60, "min": 60, "h": 3600, "hour": 3600, "d": 86400, "day": 86400}
    for suffix, factor in sorted(units.items(), key=lambda item: -len(item[0])):
        if text.endswith(suffix):
            seconds = int(float(text[:-len(suffix)].strip()) * factor)
            if seconds < 1:
                raise ValueError("Duration must be positive or off")
            return seconds
    raise ValueError("Use a duration such as 30m, 2h, 1d, or off")


def parse_time(value):
    value = value.strip().lower()
    for pattern in ("%H:%M", "%I%p", "%I:%M%p"):
        try:
            parsed = dt.datetime.strptime(value, pattern)
            return parsed.hour, parsed.minute
        except ValueError:
            pass
    raise ValueError("Use a time such as 09:00 or 9am")


def parse_schedule(phrase, timezone=None, now=None):
    phrase = " ".join(phrase.lower().split())
    zone = ZoneInfo(timezone or system_timezone())
    current = now or dt.datetime.now(zone)
    interval_match = re.fullmatch(
        r"every (\d+) (minute|minutes|hour|hours|day|days|week|weeks|month|months)"
        r"(?: at minute (\d{1,2})| at ([^ ]+)| on ([a-z]+)(?: at ([^ ]+))?"
        r"| on day (\d{1,2})(?: at ([^ ]+))?)?", phrase)
    if interval_match:
        amount = int(interval_match.group(1))
        unit = interval_match.group(2).rstrip("s")
        if amount < 1:
            raise ValueError("Repeat count must be positive")
        minute_value, direct_time, weekday_value, weekday_time, month_day, month_time = interval_match.groups()[2:]
        if unit == "minute":
            if any((minute_value, direct_time, weekday_value, month_day)):
                raise ValueError("Minute intervals do not use an on/at value")
            seconds = amount * 60
            return {"kind": "interval", "phrase": phrase,
                    "interval_seconds": seconds}, current.timestamp() + seconds
        if unit == "hour" and not minute_value:
            if any((direct_time, weekday_value, month_day)):
                raise ValueError("Use ‘every 2 hours at minute 15’")
            seconds = amount * 3600
            return {"kind": "interval", "phrase": phrase,
                    "interval_seconds": seconds}, current.timestamp() + seconds

        schedule = {"kind": "calendar_interval", "phrase": phrase,
                    "interval": amount, "unit": unit}
        if unit == "hour":
            minute = int(minute_value)
            if not 0 <= minute <= 59:
                raise ValueError("Minute must be between 0 and 59")
            candidate = current.replace(minute=minute, second=0, microsecond=0)
            if candidate <= current:
                candidate += dt.timedelta(hours=1)
            schedule["minute"] = minute
        elif unit == "day":
            if weekday_value or month_day or minute_value:
                raise ValueError("Use ‘every 2 days at 09:00’")
            if direct_time:
                hour, minute = parse_time(direct_time)
                candidate = current.replace(hour=hour, minute=minute, second=0, microsecond=0)
                if candidate <= current:
                    candidate += dt.timedelta(days=1)
                schedule.update(hour=hour, minute=minute)
            else:
                candidate = current + dt.timedelta(days=amount)
        elif unit == "week":
            days = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
            if direct_time or month_day or minute_value or weekday_value not in days:
                raise ValueError("Use ‘every 2 weeks on monday at 09:00’")
            hour, minute = parse_time(weekday_time or current.strftime("%H:%M"))
            weekday = days.index(weekday_value)
            delta = (weekday - current.weekday()) % 7
            candidate = (current + dt.timedelta(days=delta)).replace(
                hour=hour, minute=minute, second=0, microsecond=0)
            if candidate <= current:
                candidate += dt.timedelta(days=7)
            schedule.update(weekday=weekday, hour=hour, minute=minute)
        else:
            if direct_time or weekday_value or minute_value or month_day is None:
                raise ValueError("Use ‘every 2 months on day 15 at 09:00’")
            day = int(month_day)
            if not 1 <= day <= 31:
                raise ValueError("Month day must be between 1 and 31")
            hour, minute = parse_time(month_time or current.strftime("%H:%M"))
            candidate = next_month_day(current, day, hour, minute)
            schedule.update(day=day, hour=hour, minute=minute)
        schedule["anchor"] = candidate.timestamp()
        return schedule, schedule["anchor"]
    if phrase.startswith("daily at ") or phrase.startswith("weekdays at "):
        weekdays = phrase.startswith("weekdays")
        hour, minute = parse_time(phrase.split(" at ", 1)[1])
        candidate = current.replace(hour=hour, minute=minute, second=0, microsecond=0)
        if candidate <= current:
            candidate += dt.timedelta(days=1)
        while weekdays and candidate.weekday() > 4:
            candidate += dt.timedelta(days=1)
        return {"kind": "weekdays" if weekdays else "daily", "phrase": phrase, "hour": hour, "minute": minute}, candidate.timestamp()
    if phrase.startswith("weekly on "):
        rest = phrase[len("weekly on "):]
        day, value = rest.split(" at ", 1)
        days = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        if day not in days:
            raise ValueError("Unknown weekday")
        hour, minute = parse_time(value)
        delta = (days.index(day) - current.weekday()) % 7
        candidate = (current + dt.timedelta(days=delta)).replace(hour=hour, minute=minute, second=0, microsecond=0)
        if candidate <= current:
            candidate += dt.timedelta(days=7)
        return {"kind": "weekly", "phrase": phrase, "weekday": days.index(day), "hour": hour, "minute": minute}, candidate.timestamp()
    if phrase.startswith("once at "):
        value = phrase[len("once at "):]
        candidate = dt.datetime.fromisoformat(value).replace(tzinfo=zone)
        if candidate <= current:
            raise ValueError("One-time schedule must be in the future")
        return {"kind": "once", "phrase": phrase, "at": candidate.timestamp()}, candidate.timestamp()
    raise ValueError("Try ‘every 30 minutes’, ‘every 2 hours at minute 15’, ‘every 3 days at 09:00’, ‘every 2 weeks on monday at 10:00’, or ‘every 1 month on day 15 at 09:00’")


def next_month_day(current, day, hour, minute, month_step=0):
    """Find a month-relative occurrence, clamping short months like Calendar."""
    month_index = current.year * 12 + current.month - 1 + month_step
    while True:
        year, zero_month = divmod(month_index, 12)
        month = zero_month + 1
        clamped = min(day, calendar.monthrange(year, month)[1])
        candidate = current.replace(year=year, month=month, day=clamped,
                                    hour=hour, minute=minute, second=0, microsecond=0)
        if candidate > current or month_step:
            return candidate
        month_index += 1


def next_calendar(schedule, timezone, after):
    zone = ZoneInfo(timezone)
    current = dt.datetime.fromtimestamp(after, zone)
    kind = schedule["kind"]
    if kind == "once":
        return None
    if kind == "interval":
        return after + schedule["interval_seconds"]
    if kind == "calendar_interval":
        anchor = schedule["anchor"]
        if after < anchor:
            return anchor
        interval = schedule["interval"]
        unit = schedule["unit"]
        anchor_date = dt.datetime.fromtimestamp(anchor, zone)
        current = dt.datetime.fromtimestamp(after, zone)
        if unit == "hour":
            step = interval * 3600
            return anchor + (int((after - anchor) // step) + 1) * step
        if unit in {"day", "week"}:
            days = interval * (7 if unit == "week" else 1)
            elapsed = max(0, (current.date() - anchor_date.date()).days)
            multiples = elapsed // days
            candidate = anchor_date + dt.timedelta(days=multiples * days)
            if candidate <= current:
                candidate += dt.timedelta(days=days)
            return candidate.timestamp()
        elapsed_months = ((current.year - anchor_date.year) * 12 +
                          current.month - anchor_date.month)
        multiples = max(0, elapsed_months // interval)
        candidate = next_month_day(anchor_date, schedule["day"],
                                   schedule["hour"], schedule["minute"],
                                   multiples * interval)
        if candidate <= current:
            candidate = next_month_day(anchor_date, schedule["day"],
                                       schedule["hour"], schedule["minute"],
                                       (multiples + 1) * interval)
        return candidate.timestamp()
    if kind in {"daily", "weekdays"}:
        candidate = current.replace(hour=schedule["hour"], minute=schedule["minute"], second=0, microsecond=0) + dt.timedelta(days=1)
        while kind == "weekdays" and candidate.weekday() > 4:
            candidate += dt.timedelta(days=1)
        return candidate.timestamp()
    delta = (schedule["weekday"] - current.weekday()) % 7 or 7
    return (current + dt.timedelta(days=delta)).replace(hour=schedule["hour"], minute=schedule["minute"], second=0, microsecond=0).timestamp()


def ask(label, default=None, multiline=False, choices=None, path_completion=False):
    suffix = f" [{default}]" if default not in (None, "") else ""
    if multiline:
        return interactive_text_editor(label, default or "")
    old_completer = readline.get_completer() if readline else None
    old_delims = readline.get_completer_delims() if readline else None
    if readline:
        def complete(text, state):
            if path_completion:
                matches = path_completion_matches(text)
            else:
                matches = [item for item in (choices or []) if item.lower().startswith(text.lower())]
            return matches[state] if state < len(matches) else None
        readline.set_completer(complete)
        readline.set_completer_delims(" \t\n" if path_completion else "\t\n")
        if "libedit" in (readline.__doc__ or "").lower():
            readline.parse_and_bind("bind ^I rl_complete")
        else:
            readline.parse_and_bind("tab: complete")
    value = input(styled(f"  {label}", PEACH, BOLD) + styled(suffix, MUTED) + styled("  › ", PEACH)).strip()
    if readline:
        readline.set_completer(old_completer)
        readline.set_completer_delims(old_delims)
    return value or default or ""


