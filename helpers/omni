            break
        print(dt.datetime.fromtimestamp(cursor, ZoneInfo(timezone)).isoformat())
        cursor = next_calendar(item["schedule"], timezone, cursor)


def configure_memory_agent(provider=None, workspace=None, enabled=True, native_request=None, model=None):
    helper = Path(__file__).resolve().parent / "omni_memory.py"
    spec = importlib.util.spec_from_file_location("omni_memory", helper)
    memory = importlib.util.module_from_spec(spec)
