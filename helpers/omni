SF_SYMBOL = re.compile(r"[a-z0-9.]{1,64}")


def is_control(character):
    # Cc only (C0, DEL, C1): format characters such as the emoji zero-width joiner stay allowed.
    return unicodedata.category(character) == "Cc"


def grapheme_count(text):
    """Extended grapheme clusters, enough for emoji: marks, variation selectors, skin tones, tags and
    keycaps extend the previous character, a zero-width joiner glues the next one on, and regional
    indicators pair up."""
    count, joined, regional = 0, False, False
    for character in text:
        point = ord(character)
        extends = unicodedata.category(character) in ("Mn", "Me", "Mc") or 0xFE00 <= point <= 0xFE0F \
            or 0x1F3FB <= point <= 0x1F3FF or 0xE0020 <= point <= 0xE007F
        if extends and count:
            continue
        if point == 0x200D:
            joined = True
            continue
        if 0x1F1E6 <= point <= 0x1F1FF:
            if regional:
                regional = False
                continue
            regional = True
        else:
            regional = False
        if not joined:
            count += 1
        joined = False
    return count


def is_single_emoji(text):
    """One pictographic grapheme: its first scalar is at or above U+2000, or it has U+FE0F or U+20E3."""
    return (isinstance(text, str) and 0 < len(text.encode("utf-16-le")) // 2 <= EMOJI_UTF16_UNITS
            and not any(character.isspace() for character in text)
            and grapheme_count(text) == 1
            and (ord(text[0]) >= 0x2000 or "\ufe0f" in text or "\u20e3" in text))


def normalized_group(value):
    """"Section" or "Section/Subsection", trimmed; None for no group."""
    if value is None:
        return None
    if not isinstance(value, str):
        raise ValueError("Group must be a string")
    if not value.strip():
        return None
    segments = [segment.strip() for segment in value.split("/")]
    if len(segments) > GROUP_DEPTH:
        raise ValueError("Groups have at most two levels: Section/Subsection")
    for segment in segments:
        if not segment:
            raise ValueError("Group names must not be empty")
        if len(segment) > GROUP_SEGMENT_CHARACTERS:
            raise ValueError(f"Group names are at most {GROUP_SEGMENT_CHARACTERS} characters")
        if any(is_control(character) for character in segment):
            raise ValueError("Group names must not contain control characters")
    return "/".join(segments)


def normalized_icon(value):
    """"sf:<symbol name>" or "emoji:<one emoji>"; None for no icon. AGENT_ICONS is what clients offer."""
    if value is None or value == "":
        return None
    if isinstance(value, str) and value.startswith("sf:") and SF_SYMBOL.fullmatch(value[3:]):
        return value
    if isinstance(value, str) and value.startswith("emoji:") and is_single_emoji(value[6:]):
        return value
    raise ValueError("Icon must be sf:<symbol> or emoji:<one emoji>")


def normalized_color(value):
    if value is None or value == "":
        return None
    if value not in AGENT_COLORS:
        raise ValueError("Color must be one of " + ", ".join(AGENT_COLORS))
    return value


def normalized_agent_name(value):
    """A new agent name: trimmed, 1-100 characters, no control characters."""
    name = value.strip() if isinstance(value, str) else ""
    if not name or len(name) > AGENT_NAME_CHARACTERS or any(is_control(character) for character in name):
        raise ValueError(f"Agent names are 1-{AGENT_NAME_CHARACTERS} characters without control characters")
    return name


APPEARANCE_NORMALIZERS = {"group": normalized_group, "icon": normalized_icon, "color": normalized_color}


def appearance_catalog():
    """What `omni agents appearance --json` prints for pickers: icons with their category and keywords, and colours."""
    icons = [{"name": name, "category": category, "keywords": keywords.split()}
             for category, entries in AGENT_ICON_CATALOG for name, keywords in entries]
    return {"icons": icons, "colors": list(AGENT_COLORS)}


def appearance_errors(fields):
    """The canonical appearance for the fields given (None clears), and per-field errors."""
    values, errors = {}, {}
    for key, value in fields.items():
        try:
            values[key] = APPEARANCE_NORMALIZERS[key](value)
        except ValueError as error:
            errors[key] = str(error)
    return values, errors


def with_appearance(agent, appearance):
    """An agent carries group, icon and color only when set; an absent field means none."""
    for key in APPEARANCE_FIELDS:
        agent.pop(key, None)
        if appearance.get(key) is not None:
            agent[key] = appearance[key]
    return agent
