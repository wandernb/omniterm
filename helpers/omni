def agent_defaults(settings):
    """What a new agent starts with: the Settings page's `agent_defaults`, checked again here.

    Dangerous permission modes are never a default; only a person sets them, per agent."""
    defaults = settings.get("agent_defaults") if isinstance(settings, dict) else None
    defaults = defaults if isinstance(defaults, dict) else {}
    provider = defaults.get("provider") if defaults.get("provider") in PERMISSION_MODES else "claude"
    models = defaults.get("models") if isinstance(defaults.get("models"), dict) else {}
    permissions = defaults.get("permission_modes") if isinstance(defaults.get("permission_modes"), dict) else {}

    def model(name):
        value = models.get(name)
        return value if isinstance(value, str) and not value.startswith("-") and not any(c.isspace() for c in value) else ""

    def permission(name):
        value = permissions.get(name)
        return value if value in STORED_PERMISSION_MODES[name] and value != DANGEROUS_PERMISSIONS[name] else ""

    return {"provider": provider,
            "models": {name: model(name) for name in PERMISSION_MODES},
            "permission_modes": {name: permission(name) for name in PERMISSION_MODES},
            "overlap": defaults.get("overlap") if defaults.get("overlap") in ("replace", "parallel") else "replace"}
