                    marker = "▶" if chosen_prompt else "◇"
                    label_style = palette["blue"] | curses.A_BOLD | (curses.A_REVERSE if chosen_prompt else 0)
                    tui_text(window, prompt_y, x, f"{marker} {prompt_label}  ↗", label_style, prompt_width)
