SOCKET = Path.home() / "Library/Application Support/OmniTerm/scheduler.sock"

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
PEACH = "\033[38;2;247;177;133m"
GREEN = "\033[38;2;105;219;124m"
BLUE = "\033[38;2;125;170;255m"
MUTED = "\033[38;2;145;145;145m"


def styled(text, *styles):
    return "".join(styles) + str(text) + RESET


def terminal_width():
    try:
        return max(60, min(112, os.get_terminal_size().columns - 4))
    except OSError:
        return 88


def print_rule(width, title=None, color=PEACH):
    label = f" {title} " if title else ""
    fill = max(0, width - 3 - len(label))
    print("  " + color + "╭─" + label + "─" * fill + "╮" + RESET)


def print_panel(lines, width, title=None, color=PEACH, padded=True):
    print_rule(width, title, color)
    panel_lines = ([" "] if padded else []) + list(lines) + ([" "] if padded else [])
    for line in panel_lines:
        plain, rendered = line if isinstance(line, tuple) else (str(line), str(line))
        available = width - 6
        if len(plain) > available:
            plain = plain[:max(0, available - 1)] + "…"
            rendered = styled(plain, MUTED)
        print("  " + color + "│" + RESET + "  " + rendered + " " * max(0, width - 4 - len(plain)) + color + "│" + RESET)
    print("  " + color + "╰" + "─" * (width - 2) + "╯" + RESET)


def system_timezone():
    path = Path("/etc/localtime")
    try:
        target = path.resolve()
        marker = "/zoneinfo/"
        if marker in str(target):
            return str(target).split(marker, 1)[1]
    except OSError:
        pass
    return "UTC"


def discover_project(path):
    candidate = Path(path).expanduser().resolve()
    if candidate.is_file():
        candidate = candidate.parent
    if not candidate.is_dir():
        raise SystemExit(f"Workspace does not exist: {candidate}")
    for folder in (candidate, *candidate.parents):
        if (folder / "AGENTS.md").is_file() or (folder / "CLAUDE.md").is_file():
            return folder
    return candidate


def generated_agent_name(workspace, startup_prompt):
    folder = Path(workspace).name or "Agent"
    command = (startup_prompt or "").strip().splitlines()[0] if (startup_prompt or "").strip() else ""
    command = re.sub(r"^[/:]+", "", command)
    command = re.sub(r"[^A-Za-z0-9._:-]+", " ", command).strip()
    return f"{folder} · {command}" if command else folder


def codex_model_choices():
    path = Path.home() / ".codex/models_cache.json"
    try:
        models = json.loads(path.read_text()).get("models", [])
        return [item["slug"] for item in models
                if item.get("slug") and item.get("visibility", "list") == "list"]
    except (OSError, ValueError, TypeError):
        return ["gpt-5.6-sol", "gpt-5.6-terra"]


def claude_model_choices():
    aliases = ["opus", "sonnet", "haiku", "fable"]
    found = []
    pattern = re.compile(r"^(?:claude-(?:opus|sonnet|haiku|fable)-[A-Za-z0-9.\-]+(?:\[1m\])?|opus|sonnet|haiku|fable)$")

    def visit(value):
        if isinstance(value, dict):
            for key, child in value.items():
                if isinstance(key, str) and pattern.match(key):
                    found.append(key)
                visit(child)
        elif isinstance(value, list):
            for child in value:
                visit(child)
        elif isinstance(value, str) and pattern.match(value):
            found.append(value)

    for path in (Path.home() / ".claude/settings.json", Path.home() / ".claude.json"):
        try:
            visit(json.loads(path.read_text()))
        except (OSError, ValueError):
            pass
    return list(dict.fromkeys(aliases + sorted(set(found) - set(aliases))))


def model_choices(provider):
    values = codex_model_choices() if provider == "codex" else claude_model_choices()
    return ["provider default", *values, "Custom model…"]


def path_completion_matches(text):
    original = text or ""
    expanded = os.path.expanduser(original or ".")
    if expanded.endswith(os.sep):
        base, prefix = Path(expanded), ""
    else:
        base, prefix = Path(expanded).parent, Path(expanded).name
    try:
        directories = sorted((item for item in base.iterdir()
                              if item.is_dir() and item.name.startswith(prefix)),
                             key=lambda item: item.name.lower())
    except OSError:
        return []
    matches = []
    for item in directories:
        if original.startswith("~"):
            value = "~" + str(item)[len(str(Path.home())):]
        elif os.path.isabs(original):
            value = str(item)
        else:
            parent = os.path.dirname(original)
            value = os.path.join(parent, item.name) if parent else item.name
        matches.append(value + "/")
    return matches


def request(payload):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        try:
            client.connect(str(SOCKET))
        except OSError as exc:
            raise SystemExit(f"OmniTerm scheduler is unavailable: {exc}")
        client.sendall(json.dumps(payload).encode() + b"\n")
        client.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = client.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
        response = json.loads(b"".join(chunks))
        if not response.get("ok"):
            raise SystemExit(response.get("error", "Scheduler request failed"))
        return response
    finally:
        client.close()


def parse_duration(value):
    text = value.strip().lower()
    if text in {"off", "none", "disabled", "0"}:
        return None
    units = {"s": 1, "sec": 1, "m": 60, "min": 60, "h": 3600, "hour": 3600, "d": 86400, "day": 86400}
    for suffix, factor in sorted(units.items(), key=lambda item: -len(item[0])):
        if text.endswith(suffix):
            seconds = int(float(text[:-len(suffix)].strip()) * factor)
            if seconds < 1:
                raise ValueError("Duration must be positive or off")
            return seconds
    raise ValueError("Use a duration such as 30m, 2h, 1d, or off")


def parse_time(value):
    value = value.strip().lower()
    for pattern in ("%H:%M", "%I%p", "%I:%M%p"):
        try:
            parsed = dt.datetime.strptime(value, pattern)
            return parsed.hour, parsed.minute
        except ValueError:
            pass
    raise ValueError("Use a time such as 09:00 or 9am")


def parse_schedule(phrase, timezone=None, now=None):
    phrase = " ".join(phrase.lower().split())
    zone = ZoneInfo(timezone or system_timezone())
    current = now or dt.datetime.now(zone)
    if phrase.startswith("every "):
        words = phrase.split()
        amount = int(words[1])
        unit = words[2].rstrip("s")
        factor = {"minute": 60, "hour": 3600}.get(unit)
        if not factor or amount < 1:
            raise ValueError("Intervals support positive minutes or hours")
        interval = amount * factor
        return {"kind": "interval", "phrase": phrase, "interval_seconds": interval}, current.timestamp() + interval
    if phrase.startswith("daily at ") or phrase.startswith("weekdays at "):
        weekdays = phrase.startswith("weekdays")
        hour, minute = parse_time(phrase.split(" at ", 1)[1])
        candidate = current.replace(hour=hour, minute=minute, second=0, microsecond=0)
        if candidate <= current:
            candidate += dt.timedelta(days=1)
        while weekdays and candidate.weekday() > 4:
            candidate += dt.timedelta(days=1)
        return {"kind": "weekdays" if weekdays else "daily", "phrase": phrase, "hour": hour, "minute": minute}, candidate.timestamp()
    if phrase.startswith("weekly on "):
        rest = phrase[len("weekly on "):]
        day, value = rest.split(" at ", 1)
        days = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        if day not in days:
            raise ValueError("Unknown weekday")
        hour, minute = parse_time(value)
        delta = (days.index(day) - current.weekday()) % 7
        candidate = (current + dt.timedelta(days=delta)).replace(hour=hour, minute=minute, second=0, microsecond=0)
        if candidate <= current:
            candidate += dt.timedelta(days=7)
        return {"kind": "weekly", "phrase": phrase, "weekday": days.index(day), "hour": hour, "minute": minute}, candidate.timestamp()
    if phrase.startswith("once at "):
        value = phrase[len("once at "):]
        candidate = dt.datetime.fromisoformat(value).replace(tzinfo=zone)
        if candidate <= current:
            raise ValueError("One-time schedule must be in the future")
        return {"kind": "once", "phrase": phrase, "at": candidate.timestamp()}, candidate.timestamp()
    raise ValueError("Try ‘every 30 minutes’, ‘daily at 09:00’, ‘weekdays at 9am’, ‘weekly on monday at 10:00’, or ‘once at 2026-08-01 14:00’")


def next_calendar(schedule, timezone, after):
    zone = ZoneInfo(timezone)
    current = dt.datetime.fromtimestamp(after, zone)
    kind = schedule["kind"]
    if kind == "once":
        return None
    if kind == "interval":
        return after + schedule["interval_seconds"]
    if kind in {"daily", "weekdays"}:
        candidate = current.replace(hour=schedule["hour"], minute=schedule["minute"], second=0, microsecond=0) + dt.timedelta(days=1)
        while kind == "weekdays" and candidate.weekday() > 4:
            candidate += dt.timedelta(days=1)
        return candidate.timestamp()
    delta = (schedule["weekday"] - current.weekday()) % 7 or 7
    return (current + dt.timedelta(days=delta)).replace(hour=schedule["hour"], minute=schedule["minute"], second=0, microsecond=0).timestamp()


def ask(label, default=None, multiline=False, choices=None, path_completion=False):
    suffix = f" [{default}]" if default not in (None, "") else ""
    if multiline:
        return interactive_text_editor(label, default or "")
    old_completer = readline.get_completer() if readline else None
    old_delims = readline.get_completer_delims() if readline else None
    if readline:
        def complete(text, state):
            if path_completion:
                matches = path_completion_matches(text)
            else:
                matches = [item for item in (choices or []) if item.lower().startswith(text.lower())]
            return matches[state] if state < len(matches) else None
        readline.set_completer(complete)
        readline.set_completer_delims(" \t\n" if path_completion else "\t\n")
        if "libedit" in (readline.__doc__ or "").lower():
            readline.parse_and_bind("bind ^I rl_complete")
        else:
            readline.parse_and_bind("tab: complete")
    value = input(styled(f"  {label}", PEACH, BOLD) + styled(suffix, MUTED) + styled("  › ", PEACH)).strip()
    if readline:
        readline.set_completer(old_completer)
        readline.set_completer_delims(old_delims)
    return value or default or ""


def wizard_header(index, fields, values):
    os.system("clear")
    width = terminal_width()
    logo = [
        "  ___   __  __  _   _  ___ ",
        " / _ \\ |  \\/  || \\ | ||_ _|",
        "| | | || |\\/| ||  \\| | | | ",
        "| |_| || |  | || |\\  | | | ",
        " \\___/ |_|  |_||_| \\_||___|",
    ]
    for line in logo:
        print("  " + styled(line, PEACH, BOLD))
    print("  " + styled("Agent configuration wizard · Codex + Claude", BOLD))
    print("  " + styled("Create predictable, resumable scheduled sessions", MUTED))

    key, label, options = fields[index]
    completed = "●" * index
    remaining = "○" * (len(fields) - index - 1)
    progress_plain = f"Step {index + 1:02} / {len(fields):02}  {completed}◆{remaining}"
    progress_rendered = (styled(f"Step {index + 1:02} / {len(fields):02}", BOLD) + "  " +
                         styled(completed, GREEN) + styled("◆", PEACH, BOLD) + styled(remaining, MUTED))
    descriptions = {
        "name": "Optional. Blank generates a name from the workspace and startup command.",
        "provider": "Choose the interactive coding agent that opens in the run tab.",
        "workspace": "The folder the agent starts in. Tab completes filesystem paths.",
        "system_prompt": "Persistent role instructions. Enter saves; Command-Enter adds a line.",
        "startup_prompt": "First user command. Enter saves; Command-Enter adds a line.",
        "model": "Provider model name. Leave blank to follow the provider default.",
        "schedule_phrase": "Human-friendly cadence; raw cron syntax is unnecessary.",
        "overlap": "Replace the previous run, or allow runs to execute in parallel.",
        "timeout": "Retention window for older run tabs; the newest ten stay protected.",
        "permission_mode": "Provider permission policy. Blank uses its normal default.",
        "advanced_args": "Optional provider flags not already managed by OmniTerm.",
    }
    print()
    print_panel([(progress_plain, progress_rendered)], width, "PROGRESS", BLUE)
    print()
    field_lines = [
        (label.upper(), styled(label.upper(), PEACH, BOLD)),
        (descriptions[key], styled(descriptions[key], MUTED)),
    ]
    if options.get("choices"):
        choices = "Suggestions  " + "  ·  ".join(item or "provider default" for item in options["choices"][:6])
        field_lines.append((choices, styled("Suggestions  ", BLUE) + styled("  ·  ".join(item or "provider default" for item in options["choices"][:6]), MUTED)))
    print_panel(field_lines, width, "CURRENT FIELD", PEACH)
    print()
    summary = []
    for summary_key in ("name", "provider", "workspace", "model", "schedule_phrase", "overlap", "timeout"):
