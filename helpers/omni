        return
    text = screen_text(response.get("screen"), colour).rstrip("\n")
    print(text + ("\x1b[0m" if colour and text else ""))
    if response.get("truncated"):
        print("── earlier scrollback not kept ──")


TAIL_LINES = 200
TAIL_LINES_MAX = 2000
TAIL_BYTES = 2097152
TAIL_BYTES_MAX = 16777216
TAIL_LINE_CHARACTERS = 500
TAIL_RESULT_LINES = 4
TAIL_ARGUMENT_CHARACTERS = 80
TRANSCRIPT_ROOTS = (Path.home() / ".claude/projects", Path.home() / ".codex/sessions")
SESSION_ID = re.compile(r"^[A-Za-z0-9-]{8,64}$")
TOOL_ARGUMENT_KEYS = ("command", "cmd", "file_path", "path", "pattern", "query", "url", "description",
                      "prompt", "skill")


def owned_transcript(path):
    """A provider transcript file, never anything else a run row might name."""
    try:
        resolved = Path(path).expanduser().resolve()
    except (OSError, RuntimeError, TypeError, ValueError):
        return None
    if resolved.suffix != ".jsonl" or not resolved.is_file():
        return None
    for root in TRANSCRIPT_ROOTS:
        try:
            resolved.relative_to(root.resolve())
            return resolved
        except (OSError, ValueError):
            continue
    return None


def run_transcript(run):
    """The run's transcript: as recorded, else found by session ID as the runner finds it."""
    recorded = run.get("transcript_path")
    if isinstance(recorded, str) and owned_transcript(recorded):
        return owned_transcript(recorded)
    provider = run.get("provider")
    providers = [provider] if provider in ("claude", "codex") else ["claude", "codex"]
    for key in ("session_id", "resume_session_id", "id"):
        session_id = run.get(key)
        if not isinstance(session_id, str) or not SESSION_ID.match(session_id):
            continue
        for name in providers:
            claude_root, codex_root = TRANSCRIPT_ROOTS
            matches = (claude_root.glob(f"*/{session_id}.jsonl") if name == "claude"
                       else codex_root.rglob(f"*{session_id}.jsonl"))
            for match in matches:
                found = owned_transcript(match)
                if found:
                    return found
    return None


def transcript_tail_events(path, limit=TAIL_BYTES):
    """The events at the end of a transcript, oldest first, and whether earlier ones were left out."""
    with path.open("rb") as handle:
        size = handle.seek(0, os.SEEK_END)
        handle.seek(max(0, size - limit))
        lines = handle.read().splitlines()
    if size > limit:
        lines = lines[1:]  # The tail starts mid-line.
    events = []
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict):
            events.append(event)
    return events, size > limit


def tool_call_line(name, arguments):
    if isinstance(arguments, str):
        try:
            arguments = json.loads(arguments)
        except ValueError:
            pass
    summary = arguments
    if isinstance(arguments, dict):
        summary = next((arguments[key] for key in TOOL_ARGUMENT_KEYS if arguments.get(key)), None)
        if summary is None:
            summary = json.dumps(arguments, ensure_ascii=False) if arguments else ""
    if isinstance(summary, list):
        summary = " ".join(str(part) for part in summary)
    summary = " ".join(plain(str(summary or "")).split())
    if len(summary) > TAIL_ARGUMENT_CHARACTERS:
        summary = summary[:TAIL_ARGUMENT_CHARACTERS - 1] + "…"
    return ("tool", plain(str(name or "tool")), summary)


def tool_output_text(output):
    if isinstance(output, list):
        return "\n".join(block.get("text", "") for block in output
                         if isinstance(block, dict) and isinstance(block.get("text"), str))
    if isinstance(output, str):
        try:
            value = json.loads(output)
        except ValueError:
            return output
        if isinstance(value, dict) and isinstance(value.get("output"), str):
            return value["output"]
    return output if isinstance(output, str) else ""


def is_injected_context(text):
    """Text a provider adds to the user's side: environment, instructions, reminders."""
    return text.lstrip().startswith(("<", "# AGENTS.md instructions"))


def claude_transcript_items(event):
    if event.get("isSidechain") or event.get("isMeta") or event.get("type") not in ("user", "assistant"):
        return []
    message = event.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content
    items = []
    for block in blocks if isinstance(blocks, list) else []:
        if not isinstance(block, dict):
            continue
        kind = block.get("type")
        if kind == "text" and isinstance(block.get("text"), str) and block["text"].strip():
            if event["type"] == "assistant":
                items.append(("assistant", block["text"]))
            elif not is_injected_context(block["text"]):
                items.append(("user", block["text"]))
        elif kind == "tool_use" and event["type"] == "assistant":
            items.append(tool_call_line(block.get("name"), block.get("input")))
        elif kind == "tool_result":
            items.append(("result", tool_output_text(block.get("content"))))
    return items


def codex_transcript_items(event):
    payload = event.get("payload")
    if event.get("type") != "response_item" or not isinstance(payload, dict):
        return []
    kind = payload.get("type")
    if kind == "message" and payload.get("role") in ("user", "assistant"):
        texts = [block.get("text") for block in payload.get("content") or []
                 if isinstance(block, dict) and isinstance(block.get("text"), str) and block["text"].strip()]
        if payload["role"] == "user":
            return [("user", text) for text in texts if not is_injected_context(text)]
        return [("assistant", text) for text in texts]
    if kind == "function_call":
        return [tool_call_line(payload.get("name"), payload.get("arguments"))]
    if kind == "custom_tool_call":
        return [tool_call_line(payload.get("name"), payload.get("input"))]
    if kind in ("function_call_output", "custom_tool_call_output"):
        return [("result", tool_output_text(payload.get("output")))]
    return []


def render_transcript_items(items, colour):
    def style(text, code):
        return f"\x1b[{code}m{text}\x1b[0m" if colour else text

    def cut(line):
        return line if len(line) <= TAIL_LINE_CHARACTERS else line[:TAIL_LINE_CHARACTERS - 1] + "…"

    lines = []
    for item in items:
        kind = item[0]
        if kind == "tool":
            _, name, summary = item
            lines.append(f"● {style(name, '1')}({summary})")
            continue
        text_lines = plain(item[1]).strip("\n").splitlines()
        if kind == "user":
            lines.append("")
            lines += [style(cut(("❯ " if index == 0 else "  ") + line), "1") for index, line in enumerate(text_lines)]
            lines.append("")
        elif kind == "assistant":
            lines += [cut(("● " if index == 0 else "  ") + line) for index, line in enumerate(text_lines)]
        else:
            shown = text_lines[:TAIL_RESULT_LINES]
            lines += [style(cut(("  ⎿ " if index == 0 else "    ") + line), "2") for index, line in enumerate(shown)]
            if len(text_lines) > len(shown):
                lines.append(style(f"    … +{len(text_lines) - len(shown)} lines", "2"))
    return lines


def run_tail(run, count=TAIL_LINES, colour=False):
    """The end of a run's provider transcript, rendered like its terminal. Read-only."""
    path = run_transcript(run)
    if not path:
        return {"ok": False, "error": "No transcript found for this run"}
    reader = codex_transcript_items if path.is_relative_to(TRANSCRIPT_ROOTS[1].resolve()) else claude_transcript_items
    count = max(1, min(TAIL_LINES_MAX, count))
    limit = TAIL_BYTES
    while True:
        try:
            events, cut_short = transcript_tail_events(path, limit)
        except OSError as error:
            return {"ok": False, "error": f"Could not read the transcript: {error.strerror or error}"}
        lines = render_transcript_items([item for event in events for item in reader(event)], colour)
        while lines and not lines[-1]:
            lines.pop()
        # Transcripts also hold large bookkeeping events; read further back only when the tail
        # had too little to show.
        if len(lines) >= count or not cut_short or limit >= TAIL_BYTES_MAX:
            break
        limit = min(TAIL_BYTES_MAX, limit * 4)
    return {"ok": True, "text": "\n".join(lines[-count:]).lstrip("\n"), "source": "transcript", "path": str(path),
            "truncated": cut_short or len(lines) > count}


def preview_schedule(name):
