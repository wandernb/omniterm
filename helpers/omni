                ("Workspace", agent["workspace"]), ("Model", agent.get("model") or "provider default"),
                ("Schedule", agent["schedule"]["phrase"]), ("Overlap", agent["overlap"]),
                ("Retention", "off" if agent.get("timeout_seconds") is None else f"{agent['timeout_seconds'] // 60} minutes"),
            ]
            for offset, (label, value) in enumerate(details):
                tui_text(window, y + 3 + offset, x, f"{label:10}", palette["muted"] | curses.A_BOLD, 10)
                tui_text(window, y + 3 + offset, x + 11, value, 0, right_width - 18)
            if body_height >= 19:
