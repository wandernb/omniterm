def edit_agent(existing=None, seed_path=None):
    old = existing or {}
    global_settings = request({"op": "get_settings"})["settings"]
    default_timeout = int(global_settings.get("default_timeout_seconds", 7200))
    global_timezone = global_settings.get("timezone") or system_timezone()
    project = discover_project(seed_path) if seed_path and not old else None
    schedule_phrase = old.get("schedule", {}).get("phrase", "daily at 09:00")
    values = {
        "name": old.get("name", ""), "provider": old.get("provider", "codex"),
        "workspace": old.get("workspace", str(project or Path.cwd())), "system_prompt": old.get("system_prompt", ""),
        "startup_prompt": old.get("startup_prompt", ""), "model": old.get("model", ""),
        "schedule_phrase": schedule_phrase,
        "overlap": old.get("overlap", "replace"),
        "timeout": "off" if "timeout_seconds" in old and old.get("timeout_seconds") is None else f"{old.get('timeout_seconds', default_timeout)}s",
        "permission_mode": old.get("permission_mode", ""),
        "advanced_args": shlex.join(old.get("advanced_args", [])),
    }
    values.update(schedule_form_values(schedule_phrase))
    normalize_schedule_controls(values)
    try:
        values = interactive_agent_form(
            values,
            existing=old,
            validator=lambda candidate: normalized_agent(candidate, old, global_timezone))
    except (EOFError, KeyboardInterrupt):
        raise SystemExit("Cancelled")
    if values is None:
        raise SystemExit("Cancelled")

    agent = normalized_agent(values, old, global_timezone)
    request({"op": "save_agent", "agent": agent})
    print(styled(f"  ● Saved {agent['name']}", GREEN, BOLD))


def normalized_agent(values, old, global_timezone):
    """Validate form values and produce the scheduler's canonical agent object."""
    name = values["name"] or generated_agent_name(values["workspace"], values["startup_prompt"])
    if old.get("name") and name != old["name"]:
        raise ValueError("Agent names are immutable; create a new agent to use another name")
    provider = values["provider"].lower()
    if provider not in {"codex", "claude"}:
        raise ValueError("Provider must be codex or claude")
    workspace = str(Path(values["workspace"]).expanduser().resolve())
    if not Path(workspace).is_dir():
        raise ValueError(f"Workspace does not exist: {workspace}")
    system_prompt = values["system_prompt"]
    startup_prompt = values["startup_prompt"]
    model = values["model"]
    phrase = (schedule_phrase_from_form(values)
              if values.get("repeat_unit") else values["schedule_phrase"])
    values["schedule_phrase"] = phrase
    schedule, next_run = parse_schedule(phrase, global_timezone)
    overlap = values["overlap"]
    if overlap not in {"replace", "parallel"}:
        raise ValueError("Overlap must be replace or parallel")
    timeout = parse_duration(values["timeout"])
    permissions = values["permission_mode"]
    if permissions == "auto-mode":
        permissions = "auto"
    advanced = shlex.split(values["advanced_args"])
    if any(value.split("=", 1)[0] in RESERVED_ADVANCED_ARGS for value in advanced):
        raise ValueError("Advanced arguments contain an OmniTerm-owned flag")
    return {"name": name, "provider": provider, "workspace": workspace,
            "system_prompt": system_prompt, "startup_prompt": startup_prompt,
            "model": model, "schedule": schedule,
            "next_run": next_run, "overlap": overlap, "timeout_seconds": timeout,
            "permission_mode": "" if permissions == "default" else permissions,
            "advanced_args": advanced, "enabled": old.get("enabled", True)}


def fmt_time(value, timezone=None):
    if not isinstance(value, (int, float)):
        return "—"
    zone = ZoneInfo(timezone) if timezone else None
    return dt.datetime.fromtimestamp(value, zone).strftime("%Y-%m-%d %H:%M")


def tui_text(window, y, x, text, style=0, width=None):
    try:
        height, columns = window.getmaxyx()
        if y < 0 or y >= height or x < 0 or x >= columns:
            return
        limit = max(0, min(width if width is not None else columns - x, columns - x - 1))
        window.addnstr(y, x, str(text), limit, style)
    except curses.error:
        pass


def tui_cursor(visibility):
    """Change cursor visibility when supported by the active terminal."""
