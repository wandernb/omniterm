def quick_request(payload, timeout=3):
    """A bounded scheduler call for hooks: never waits long, never raises."""
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        client.connect(str(SOCKET))
        client.sendall(json.dumps(payload).encode() + b"\n")
        client.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = client.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
        return json.loads(b"".join(chunks))
    except (OSError, ValueError):
        return None
    finally:
        client.close()


def run_hook(provider, payload_text, environ=None, send=None):
    """Record a hook event. Hooks must never block or fail the provider session."""
    environ = os.environ if environ is None else environ
    send = send or quick_request
    try:
        blocks = blocks_module()
        if environ.get("OMNITERM_AGENT") in blocks.MANAGED_AGENTS:
            return None
        payload = json.loads(payload_text or "null")
        event = blocks.claude_event(payload) if provider == "claude" else blocks.codex_event(payload)
        if not event:
            return None
        response = send({"op": "record_block", "event": event})
        if response and response.get("ok") and response.get("escalate") and response.get("block"):
            escalate_block(blocks, response["block"], event, environ, send)
        return response
    except Exception:  # noqa: BLE001 - a hook that raises would surface in the provider's TUI
        return None


def escalate_block(blocks, block, event, environ, send):
    notice = blocks.notification_for(block)
    notice.update({"workspace": event.get("cwd") or None, "include_diff": False})
    for key, variable in (("run_id", "OMNITERM_RUN_ID"), ("agent", "OMNITERM_AGENT")):
        if environ.get(variable):
            notice[key] = environ[variable]
    send({key: value for key, value in notice.items() if value is not None})


def permission_hook(payload_text, environ=None, send=None, sleep=time.sleep, clock=time.monotonic):
    """PermissionRequest: on a goal-driven session, hold the dialog for the unblocker.

    Returns the hook's JSON reply when the unblocker allowed the action, else None,
    and Claude Code shows the dialog to the person as usual."""
    environ = os.environ if environ is None else environ
    send = send or (lambda body: quick_request(body, timeout=30))
    try:
        blocks = blocks_module()
        if environ.get("OMNITERM_AGENT") in blocks.MANAGED_AGENTS:
            return None
        payload = json.loads(payload_text or "null")
        event = blocks.claude_event(payload)
        if not blocks.holdable(event):
            return None
        response = send({"op": "record_block", "event": event}) or {}
        block = response.get("block") if response.get("ok") else None
        if not block:
            return None
        if response.get("escalate"):
            escalate_block(blocks, block, event, environ, send)
        if not block.get("held"):
            return None
        deadline = clock() + blocks.HOLD_SECONDS
        while clock() < deadline:
            sleep(4)
            reply = send({"op": "get_block", "block_id": block["block_id"]}) or {}
            current = reply.get("block") or {}
            if current.get("state") == "decided":
                return blocks.permission_output(current.get("decision"), payload.get("tool_input"))
            if reply.get("ok") is False or (current and (current.get("state") != "open" or not current.get("held"))):
                break  # gone, replaced by a newer dialog, skipped or expired
        escalate_block(blocks, block, event, environ, send)
        return None
    except Exception:  # noqa: BLE001 - a hook that raises would surface in the provider's TUI
        return None


def pretool_hook(payload_text, environ=None, send=None):
    """PreToolUse: allow a call only if the unblocker pre-approved exactly it."""
    environ = os.environ if environ is None else environ
    send = send or (lambda body: quick_request(body, timeout=5))
    try:
        blocks = blocks_module()
        if environ.get("OMNITERM_AGENT") in blocks.MANAGED_AGENTS:
            return None
        payload = json.loads(payload_text or "null")
        if not isinstance(payload, dict) or payload.get("hook_event_name") != "PreToolUse":
            return None
        session = blocks._session("claude", payload.get("session_id"))
        if not session:
            return None
        reply = send({"op": "consume_grant", "session_id": session, "tool_name": payload.get("tool_name"),
                      "tool_input": payload.get("tool_input")}) or {}
        return blocks.pretool_output() if reply.get("ok") and reply.get("allow") is True else None
    except Exception:  # noqa: BLE001 - a hook that raises would surface in the provider's TUI
        return None


def print_blocks(blocks):
    if not blocks:
        print("No sessions are waiting.")
        return
    for block in blocks:
        minutes = block.get("age_seconds", 0) // 60
        flag = "answerable" if block.get("answerable") else ("needs you" if block.get("kind") != "idle" else block.get("state"))
        prompt = " ".join((block.get("prompt") or "").split())
        print(f"{block['block_id']}  {block['session_id']}  {block['kind']:<10} {block['state']:<9} {minutes:>4}m  {flag}")
        print(f"    {block.get('cwd') or ''}")
        if prompt:
            print("    " + (prompt[:160] + ("…" if len(prompt) > 160 else "")))


def blocks_command(args):
    blocks = blocks_module()
    if args.command == "hook":
        chained = []
        if args.provider == "codex":
            # Codex appends its event JSON to the notify program's arguments.
            words = list(args.payload)
            payload = words.pop() if words else ""
            if words[:1] == ["--then"]:
                chained = words[1:]
        else:
            payload = sys.stdin.read(1048576)
        if args.provider == "claude" and '"PermissionRequest"' in payload:
            try:
                is_permission = json.loads(payload).get("hook_event_name") == "PermissionRequest"
            except (ValueError, AttributeError):
                return
            if is_permission and blocks.holdable(blocks.claude_event(json.loads(payload))):
                # A goal session waits for this one: it holds the dialog for the unblocker.
                # Any other dialog is only recorded, from the detached child below.
                output = permission_hook(payload)
                if output:
                    print(json.dumps(output))
                return
        if args.provider == "claude" and '"PreToolUse"' in payload:
            # Synchronous and bounded: only a call a go-ahead pre-approved is allowed.
            output = pretool_hook(payload)
            if output:
                print(json.dumps(output))
            return
        if args.provider == "claude" and '"SessionStart"' in payload:
            try:
                if json.loads(payload).get("hook_event_name") == "SessionStart":
                    print(blocks.session_start_output())
                    return
            except (ValueError, AttributeError):
                return
        # Return to the provider at once; record from a detached child, since the
        # request queues behind indexing and must never hold up a prompt.
        try:
            if os.fork():
                return
            os.setsid()
            devnull = os.open(os.devnull, os.O_RDWR)
            for descriptor in (0, 1, 2):
                os.dup2(devnull, descriptor)
        except OSError:
            pass
        try:
            if chained:
                try:
                    subprocess.Popen(chained + [payload], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError:
                    pass
            run_hook(args.provider, payload, send=lambda body: quick_request(body, timeout=60))
        finally:
            os._exit(0)
    if args.command == "hooks":
        providers = tuple(args.provider or ("claude", "codex"))
        try:
            result = (blocks.hooks_status() if args.action == "status" else
                      blocks.install_hooks(install=args.action == "install", providers=providers))
            if args.action != "status":
                # The hooks and the listener that answers are one feature: on together, off together.
                request({"op": "set_settings", "settings": {"unblocker": {"enabled": args.action == "install"}}})
                result["unblocker"] = args.action == "install"
        except (OSError, ValueError) as error:
            raise SystemExit(str(error))
        print(json.dumps(result, indent=None if args.json else 2))
        return
    if args.command == "unblocker":
        unblocker = helper_module("omni_unblocker")
        if args.action == "pass":
            def tolerant(payload):
                # One failed call (a gone block, a busy worker) must not end the pass.
                try:
                    return request(payload)
                except SystemExit as error:
                    return {"ok": False, "error": str(error)}
            result = unblocker.run_pass(tolerant)
        elif args.action == "audit":
            result = {"entries": request({"op": "unblocker_audit", "limit": max(1, min(500, args.limit))})["entries"]}
            if not args.json:
                for entry in result["entries"]:
                    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(entry.get("at", 0)))
                    where = entry.get("cwd") or entry.get("session_id") or ""
                    detail = " ".join((entry.get("detail") or "").split())
                    print(f"{when}  {entry.get('outcome', ''):<12} {where}")
                    if detail:
                        print("    " + detail[:200] + ("…" if len(detail) > 200 else ""))
                return
        else:
            if args.action in ("on", "off"):
                change = {"enabled": args.action == "on"}
                if args.model is not None:
                    change["model"] = args.model
                request({"op": "set_settings", "settings": {"unblocker": change}})
            result = {"unblocker": unblocker.settings_of(request), "hooks": blocks.hooks_status()}
        print(json.dumps(result, indent=None if args.json else 2, ensure_ascii=False))
        return
    if args.command == "unblock":
        payload = {"op": "get_unblock" if args.state is None else "set_unblock", "session_id": args.session_id}
        if args.state is not None:
            payload["enabled"] = args.state == "on"
        response = request(payload)
        response.pop("ok", None)
        print(json.dumps(response, indent=None if args.json else 2, ensure_ascii=False))
        return
    if args.command == "blocked":
        response = request({"op": "list_blocked", "state": "all" if args.all else "open",
                            "min_age_seconds": args.min_age})
        if args.json:
            print(json.dumps({"blocks": response["blocks"]}, ensure_ascii=False))
        else:
            print_blocks(response["blocks"])
        return
    if args.action == "show":
        response = request({"op": "get_block", "block_id": args.block_id})
    elif args.action == "answer":
        if not args.text or not args.reason:
            raise SystemExit("Give a message and a reason: omni block ID answer TEXT --reason WHY")
        response = request({"op": "answer_block", "block_id": args.block_id, "message": args.text,
                            "reason": args.reason})
    else:
        if not args.reason:
            raise SystemExit("Give a reason: omni block ID skip --reason WHY")
        response = request({"op": "skip_block", "block_id": args.block_id, "reason": args.reason})
    response.pop("ok", None)
    print(json.dumps(response, indent=None if args.json else 2, ensure_ascii=False))


def main(argv=None):
    args = cli_parser().parse_args(normalized_cli_argv(sys.argv[1:] if argv is None else argv))
    if args.command in {None, "dashboard"}:
        return dashboard_supervisor()
    if args.command in {"hook", "hooks", "blocked", "block", "unblocker", "unblock"}:
        return blocks_command(args)
    if args.command in {"sessions", "session", "message", "knowledge"}:
        if args.command == "sessions":
            payload = {"op": "list_sessions", "limit": args.limit}
            for key in ("provider", "workspace", "state", "cursor"):
                if getattr(args, key) is not None:
                    payload[key] = getattr(args, key)
        elif args.command == "session":
            if args.action == "send":
                if not args.message:
                    raise SystemExit("Give a message: omni session ID send TEXT")
                payload = {"op": "send_session_message", "session_id": args.session_id,
                           "request_id": args.request_id or str(uuid.uuid4()), "message": args.message}
                for key in ("sender_session_id", "sender_name"):
                    if getattr(args, key) is not None:
                        payload[key] = getattr(args, key)
            else:
                if args.message:
                    raise SystemExit("Unexpected text after session ID; use send TEXT")
                payload = {"op": "get_session", "session_id": args.session_id,
                           "offset": args.offset, "limit": args.limit}
        elif args.command == "message":
            payload = {"op": "get_session_message", "request_id": args.request_id}
        elif args.knowledge_command == "memory":
            try:
                result = configure_memory_agent(provider=args.provider, workspace=args.workspace,
                                                enabled=not args.disabled)
            except ValueError as error:
                raise SystemExit(str(error))
            print(json.dumps(result, indent=None if args.json else 2, ensure_ascii=False))
            return
        elif args.knowledge_command == "status":
            payload = {"op": "knowledge_status"}
        else:
            payload = {"op": "search_memories" if args.knowledge_command == "memories" else "search_transcripts",
                       "mode": args.mode, "limit": args.limit}
            if args.query is not None:
                payload["query"] = args.query
            if args.knowledge_command == "search":
                for key in ("provider", "workspace", "session_id"):
                    if getattr(args, key) is not None:
                        payload[key] = getattr(args, key)
        # JSON escapes terminal controls in transcript and agent-authored text.
        try:
            response = request(payload)
        except SystemExit as error:
            if payload["op"] == "send_session_message":
                raise SystemExit(f"{error}\nMessage request ID: {payload['request_id']}. Reuse it for retries.")
            raise
        print(json.dumps(response, indent=None if args.json else 2, ensure_ascii=False))
        return
    if args.command == "graph":
        return graph_from_cli(args)
    if args.command == "folders":
        try:
            groups = [normalized_group(path) for path in args.paths]
            if any(group is None for group in groups):
                raise ValueError("Folder paths must not be empty")
        except ValueError as error:
            raise SystemExit(str(error))
        response = request({"op": "set_sidebar_groups", "groups": list(dict.fromkeys(groups))})
        if args.json:
            print(json.dumps(response["groups"], ensure_ascii=False))
        else:
            for group in response["groups"]:
                print(plain(group))
        return
    if args.command == "agents":
        if args.agents_command == "add":
            return edit_agent(seed_path=args.path)
        if args.agents_command == "order":
            names = list(dict.fromkeys(name.strip() for name in args.names if name.strip()))
            if not names:
                raise SystemExit("Give agent names, first to last")
            request({"op": "set_sidebar_agent_order", "names": names})
            return
        if args.agents_command == "appearance":
            print(json.dumps(appearance_catalog()))
            return
        if args.agents_command == "normalize":
            try:
                candidate = json.loads(sys.stdin.read())
            except ValueError as error:
                print(json.dumps({"ok": False, "errors": {"agent": f"Invalid JSON: {error}"}}))
                return
            print(json.dumps(normalize_agent_json(candidate)))
            return
        items = request({"op": "list_agents"})["agents"]
        return print_agents(items, args.json)
    if args.command == "agent":
        if args.action == "rename":
            if not (args.new_name or "").strip():
                raise SystemExit("Give the new name: omni agent NAME rename NEW")
            try:
                new_name = normalized_agent_name(args.new_name)
            except ValueError as error:
                raise SystemExit(str(error))
            response = request({"op": "rename_agent", "name": args.name, "new_name": new_name})
            print((response.get("agent") or {}).get("name", new_name))
            return
        if args.action == "set":
            fields = {key: getattr(args, key) for key in APPEARANCE_FIELDS if getattr(args, key) is not None}
            if not fields:
                raise SystemExit("Give --group, --icon or --color (\"\" clears one)")
            values, errors = appearance_errors(fields)
            if errors:
                raise SystemExit("; ".join(errors.values()))
            # "" clears: the socket strips nulls.
            request({"op": "set_agent_appearance", "name": args.name,
                     **{key: "" if value is None else value for key, value in values.items()}})
            return
        if args.action == "edit": return edit_agent(request({"op": "show_agent", "name": args.name})["agent"])
        if args.action == "run": print(request({"op": "run_agent", "name": args.name})["run_id"]); return
        if args.action == "runs": return print_runs(request({"op": "list_runs", "name": args.name})["runs"], args.json)
        if args.action == "schedule": return preview_schedule(args.name)
        if args.action in {"enable", "disable"}: request({"op": "set_enabled", "name": args.name, "enabled": args.action == "enable"}); return
        if args.action == "delete": request({"op": "delete_agent", "name": args.name}); return
        return print_agent(request({"op": "show_agent", "name": args.name})["agent"], args.json)
    if args.command == "notify": return notify_from_cli(args)
    if args.command == "notifications":
        if args.read_all:
            response = request({"op": "notifications_read_all"})
            print(f"Marked {response.get('marked', 0)} as read.")
            return
        return print_notifications(request({"op": "notifications", "unread": args.unread, "limit": 100}), args.json)
    if args.command == "inbox":
        request({"op": "show_inbox", **({"id": args.id} if args.id else {})})
        return
    if args.command == "notification":
        if args.action == "delete":
            request({"op": "notification_delete", "id": args.id})
        else:
            request({"op": "notification_read", "id": args.id, "read": args.action == "read"})
        return
    if args.command == "run" and args.tail:
        colour = not args.plain and (args.json or sys.stdout.isatty())
        try:
            result = run_tail(request({"op": "get_run", "id": args.id})["run"], args.lines, colour)
        except SystemExit as error:
            result = {"ok": False, "error": str(error)}
        if args.json:
            print(json.dumps(result))
        elif not result["ok"]:
            raise SystemExit(result["error"])
        else:
            print(result["text"] + ("\x1b[0m" if colour and result["text"] else ""))
        return
    if args.command == "run" and args.screen:
        return print_run_screen(request({"op": "run_screen", "id": args.id}), args.json,
                                colour=sys.stdout.isatty() and not args.plain)
    if args.command == "run":
        run = request({"op": "get_run", "id": args.id})["run"]
        return print_run(run, request({"op": "run_diff", "id": args.id}) if args.diff else None, args.json)
    if args.command == "resume": print(request({"op": "resume_run", "run_id": args.run_id})["run_id"]); return
    if args.command == "runs": return print_runs(request({"op": "list_runs", "name": args.agent})["runs"], args.json)
    if args.command == "stop": request({"op": "stop_run", "run_id": args.run_id}); return
    if args.command == "settings":
        if getattr(args, "settings_command", None) == "set":
            return set_setting(args.key, args.value)
        print(json.dumps(request({"op": "get_settings"})["settings"], indent=2)); return
    if args.command == "mute": return set_setting("notifications.muted_until", json.dumps(mute_until(args.duration)))
    if args.command == "unmute": return set_setting("notifications.muted_until", "0")
    if args.command == "schedule" and args.schedule_command == "preview": return preview_schedule(args.name)
    if args.command == "schedule" and args.schedule_command == "parse":
        result = parse_schedule_json(args.phrase, args.count)
        if args.json:
            print(json.dumps(result))
        elif not result["ok"]:
            raise SystemExit(result["error"])
        else:
            print(result["phrase"])
            for value in result["occurrences"]:
                print(dt.datetime.fromtimestamp(value, ZoneInfo(result["timezone"])).isoformat())
        return
    if args.command == "mcp":
        if args.mcp_command == "install": return install_mcp(args.quiet)
        if args.mcp_command == "status": return mcp_status(args.json)
        if args.mcp_command == "doctor": print(json.dumps(mcp_round_trip(), indent=2)); return
        if args.mcp_command == "uninstall": return uninstall_mcp()
        return cli_parser().parse_args(["mcp", "--help"])


