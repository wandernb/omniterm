SGR = re.compile(r"\x1b\[[0-9;:]*m")


def screen_text(screen, colour):
    """A recorded terminal screen, safe to print: at most colours (SGR) survive, never cursor
    movement, titles, clears or other control sequences."""
    if not isinstance(screen, str):
        return ""
    if not colour:
        return plain(screen)
    return CONTROL_SEQUENCE.sub(lambda match: match.group(0) if SGR.fullmatch(match.group(0)) else "", screen)


