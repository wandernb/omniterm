CONTROL_SEQUENCE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\^_])|[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def plain(value):
    """Agent-written text, made safe to print: no escape sequences can reach the terminal."""
    return CONTROL_SEQUENCE.sub("", value) if isinstance(value, str) else ""


def run_report_text(run):
    """The summary when there is one, else the agent's final message, labelled as such."""
    summary, final_message = plain(run.get("summary")).strip(), plain(run.get("final_message")).strip()
    if run.get("summary_state") == "ready" and summary:
        return "Summary", summary
    state = run.get("summary_state") or "not available"
    if final_message:
        return f"Final message (AI summary {state})", final_message
    return f"No summary (AI summary {state}) and no final message", ""


