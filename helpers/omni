def styled(text, *styles):
    return "".join(styles) + str(text) + RESET


def terminal_width():
    try:
        return max(60, min(112, os.get_terminal_size().columns - 4))
    except OSError:
        return 88


def print_rule(width, title=None, color=PEACH):
    label = f" {title} " if title else ""
    fill = max(0, width - 3 - len(label))
    print("  " + color + "╭─" + label + "─" * fill + "╮" + RESET)


def print_panel(lines, width, title=None, color=PEACH, padded=True):
    print_rule(width, title, color)
    panel_lines = ([" "] if padded else []) + list(lines) + ([" "] if padded else [])
    for line in panel_lines:
        plain, rendered = line if isinstance(line, tuple) else (str(line), str(line))
        available = width - 6
        if len(plain) > available:
            plain = plain[:max(0, available - 1)] + "…"
            rendered = styled(plain, MUTED)
        print("  " + color + "│" + RESET + "  " + rendered + " " * max(0, width - 4 - len(plain)) + color + "│" + RESET)
    print("  " + color + "╰" + "─" * (width - 2) + "╯" + RESET)


def system_timezone():
    path = Path("/etc/localtime")
    try:
        target = path.resolve()
        marker = "/zoneinfo/"
        if marker in str(target):
            return str(target).split(marker, 1)[1]
    except OSError:
        pass
    return "UTC"


def discover_project(path):
    candidate = Path(path).expanduser().resolve()
    if candidate.is_file():
        candidate = candidate.parent
    if not candidate.is_dir():
        raise SystemExit(f"Workspace does not exist: {candidate}")
    for folder in (candidate, *candidate.parents):
        if (folder / "AGENTS.md").is_file() or (folder / "CLAUDE.md").is_file():
            return folder
    return candidate


def generated_agent_name(workspace, startup_prompt):
    folder = Path(workspace).name or "Agent"
    command = (startup_prompt or "").strip().splitlines()[0] if (startup_prompt or "").strip() else ""
    command = re.sub(r"^[/:]+", "", command)
    command = re.sub(r"[^A-Za-z0-9._:-]+", " ", command).strip()
    return f"{folder} · {command}" if command else folder


def schedule_form_values(phrase):
    """Translate a canonical/legacy phrase into the inline recurrence controls."""
    text = " ".join((phrase or "daily at 09:00").lower().split())
    patterns = [
        (r"every (\d+) minutes?", lambda match: (match[1], "minutes", "", "")),
        (r"every (\d+) hours?(?: at minute (\d{1,2}))?",
         lambda match: (match[1], "hours", match[2] or "", "")),
        (r"every (\d+) days?(?: at ([^ ]+))?",
         lambda match: (match[1], "days", match[2] or "", "")),
        (r"every (\d+) weeks? on ([a-z]+)(?: at ([^ ]+))?",
         lambda match: (match[1], "weeks", match[2], match[3] or "09:00")),
        (r"every (\d+) months? on day (\d{1,2})(?: at ([^ ]+))?",
         lambda match: (match[1], "months", match[2], match[3] or "09:00")),
        (r"daily at ([^ ]+)", lambda match: ("1", "days", match[1], "")),
        (r"weekdays at ([^ ]+)", lambda match: ("1", "weekdays", match[1], "")),
        (r"weekly on ([a-z]+) at ([^ ]+)",
         lambda match: ("1", "weeks", match[1], match[2])),
        (r"once at (.+)", lambda match: ("1", "once", match[1], "")),
    ]
    for pattern, convert in patterns:
        match = re.fullmatch(pattern, text)
        if match:
            count, unit, on_value, at_value = convert(match)
            return {"repeat_count": count, "repeat_unit": unit,
                    "repeat_on": on_value, "repeat_time": at_value}
    return {"repeat_count": "1", "repeat_unit": "days",
            "repeat_on": "09:00", "repeat_time": ""}


def schedule_phrase_from_form(values):
    count = (values.get("repeat_count") or "1").strip()
    unit = values.get("repeat_unit") or "days"
    on_value = (values.get("repeat_on") or "").strip().lower()
    at_value = (values.get("repeat_time") or "").strip().lower()
    singular = count == "1"
    if unit == "once":
        return f"once at {on_value}"
    if unit == "weekdays":
        return f"weekdays at {on_value or '09:00'}"
    noun = unit[:-1] if singular else unit
    phrase = f"every {count} {noun}"
    if unit == "hours" and on_value:
        phrase += f" at minute {on_value}"
    elif unit == "days" and on_value:
        phrase += f" at {on_value}"
    elif unit == "weeks":
        phrase += f" on {on_value or 'monday'} at {at_value or '09:00'}"
    elif unit == "months":
        phrase += f" on day {on_value or '1'} at {at_value or '09:00'}"
    return phrase


def normalize_schedule_controls(values):
    """Populate context-sensitive recurrence controls after changing period."""
    unit = values.get("repeat_unit")
    on_value = values.get("repeat_on", "")
    at_value = values.get("repeat_time", "")
    weekdays = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    if unit == "minutes":
        values["repeat_on"] = values["repeat_time"] = ""
    elif unit == "hours":
        values["repeat_on"] = on_value if on_value.isdigit() and 0 <= int(on_value) <= 59 else "00"
        values["repeat_time"] = ""
    elif unit in {"days", "weekdays"}:
        try:
            parse_time(on_value)
        except ValueError:
            values["repeat_on"] = "09:00"
        values["repeat_time"] = ""
    elif unit == "weeks":
        values["repeat_on"] = on_value if on_value in weekdays else "monday"
        try:
            parse_time(at_value)
        except ValueError:
            values["repeat_time"] = "09:00"
    elif unit == "months":
        values["repeat_on"] = on_value if on_value.isdigit() and 1 <= int(on_value) <= 31 else "1"
        try:
            parse_time(at_value)
        except ValueError:
            values["repeat_time"] = "09:00"
    elif unit == "once" and not on_value:
        tomorrow = dt.datetime.now() + dt.timedelta(days=1)
        values["repeat_on"] = tomorrow.strftime("%Y-%m-%d 09:00")
        values["repeat_time"] = ""
    values["schedule_phrase"] = schedule_phrase_from_form(values)


