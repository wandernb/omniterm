def wrapped_preview(value, width, max_lines):
    value = (value or "").strip()
    if not value:
        return ["—"]
    lines = []
    for paragraph in value.splitlines() or [value]:
        lines.extend(textwrap.wrap(paragraph, width=max(8, width),
                                   replace_whitespace=True,
                                   drop_whitespace=True) or [""])
    if len(lines) > max_lines:
        lines = lines[:max_lines]
        lines[-1] = lines[-1][:max(1, width - 1)].rstrip() + "…"
    return lines


def wrapped_content(value, width):
    """Wrap complete prompt content while preserving intentional blank lines."""
    value = value or ""
    if not value.strip():
        return ["— No prompt configured —"]
    lines = []
    for paragraph in value.splitlines():
        if paragraph:
            lines.extend(textwrap.wrap(paragraph, width=max(8, width),
                                       replace_whitespace=False,
                                       drop_whitespace=True) or [""])
        else:
            lines.append("")
    if value.endswith("\n"):
        lines.append("")
    return lines


def tui_box(window, y, x, height, width, style=0, title=None):
    if height < 2 or width < 2:
        return
    tui_text(window, y, x, "╭" + "─" * (width - 2) + "╮", style, width)
    for row in range(y + 1, y + height - 1):
        tui_text(window, row, x, "│", style)
        tui_text(window, row, x + width - 1, "│", style)
    tui_text(window, y + height - 1, x, "╰" + "─" * (width - 2) + "╯", style, width)
    if title:
        tui_text(window, y, x + 2, f" {title} ", style | curses.A_BOLD, width - 4)


def tui_palette():
    curses.start_color()
    if not curses.has_colors() or curses.COLORS <= 0:
        return {name: 0 for name in ("peach", "green", "blue", "muted", "red")}
    background = -1
    try:
        curses.use_default_colors()
    except curses.error:
        background = curses.COLOR_BLACK
    colors = {
        "peach": 209 if curses.COLORS >= 256 else curses.COLOR_YELLOW,
        "green": 78 if curses.COLORS >= 256 else curses.COLOR_GREEN,
        "blue": 111 if curses.COLORS >= 256 else curses.COLOR_CYAN,
        "muted": 245 if curses.COLORS >= 256 else curses.COLOR_WHITE,
        "red": 203 if curses.COLORS >= 256 else curses.COLOR_RED,
    }
    for index, name in enumerate(colors, 1):
        curses.init_pair(index, colors[name], background)
    return {name: curses.color_pair(index) for index, name in enumerate(colors, 1)}


