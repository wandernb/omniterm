def agent_marker(agent):
    """A terminal stand-in for the sidebar icon: the emoji itself, else a dot in the agent's colour."""
    icon, color = agent.get("icon"), agent.get("color")
    if isinstance(icon, str) and icon.startswith("emoji:"):
        marker = icon[6:]
    elif icon or color:
        marker = "●"
    else:
        return "  "
    rgb = AGENT_COLOR_RGB.get(color)
    return (f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m{marker}{RESET} " if rgb else f"{marker} ")


def display_width(text):
    """Terminal columns, ignoring colour sequences: wide characters take two, joiners none."""
    width = 0
    for character in CONTROL_SEQUENCE.sub("", text):
        if unicodedata.combining(character) or unicodedata.category(character) in ("Mn", "Me", "Cf") \
                or 0xFE00 <= ord(character) <= 0xFE0F:
            continue
        width += 2 if unicodedata.east_asian_width(character) in ("W", "F") else 1
    return width


def agent_groups(items, order=None, agent_order=None):
    """Ungrouped agents first, then each section with its own agents and its subsections, in the
    sidebar's order: settings sidebar_groups for groups and sidebar_agent_order for the agents in
    each, then alphabetically."""
    order = [path for path in order if isinstance(path, str)] if isinstance(order, list) else []
    agent_order = [name for name in agent_order if isinstance(name, str)] if isinstance(agent_order, list) else []
    agent_positions = {}
    for name in agent_order:
        agent_positions.setdefault(name, len(agent_positions))

    def agent_key(item):
        name = str(item.get("name", ""))
        return (agent_positions.get(name, len(agent_positions)), name.lower(), name)

    positions = {}
    for path in order:
        positions.setdefault(path, len(positions))
        positions.setdefault(path.partition("/")[0], len(positions))

    def key(path):
        return (path != "", positions.get(path, len(positions)), path.lower())

    sections = {}
    for item in items:
        group = item.get("group") if isinstance(item.get("group"), str) else ""
        section, _, subsection = group.partition("/")
        sections.setdefault(section, {}).setdefault(subsection, []).append(item)
    ordered = []
    for section in sorted(sections, key=key):
        for subsection in sorted(sections[section], key=lambda name: key(f"{section}/{name}" if name else "")):
            ordered.append((section, subsection, sorted(sections[section][subsection], key=agent_key)))
    return ordered


def legacy_sidebar_rows(items, settings):
    """Rows for settings without sidebar_order: ungrouped agents, then sections, each with its
    agents before its subsections."""
    rows, shown_section = [], None
    for section, subsection, agents in agent_groups(items, settings.get("sidebar_groups"),
                                                    settings.get("sidebar_agent_order")):
        if section and section != shown_section:
            rows.append(("group", 0, section))
            shown_section = section
        if subsection:
            rows.append(("group", 1, subsection))
        depth = (1 if section else 0) + (1 if subsection else 0)
        rows += [("agent", depth, item) for item in agents]
    return rows


def sidebar_rows(items, order):
    """Rows in the sidebar's order: at each level groups and agents interleave by their index in
    sidebar_order ("group:<path>", "agent:<name>"); unknown ones follow, groups then agents,
    alphabetically. Groups without agents are not listed."""
    positions = {}
    for key in order:
        if isinstance(key, str):
            positions.setdefault(key, len(positions))
    root = {"agents": [], "groups": {}}
    for item in items:
        group = item.get("group") if isinstance(item.get("group"), str) else ""
        node, path = root, ""
        for segment in (group.split("/") if group else []):
            path = f"{path}/{segment}" if path else segment
            node = node["groups"].setdefault(segment, {"path": path, "agents": [], "groups": {}})
        node["agents"].append(item)

    def walk(node, depth):
        entries = [(f"group:{child['path']}", 0, name, child) for name, child in node["groups"].items()]
        entries += [(f"agent:{item.get('name', '')}", 1, str(item.get("name", "")), item) for item in node["agents"]]
        entries.sort(key=lambda entry: (positions[entry[0]], 0, "", "") if entry[0] in positions
                     else (len(positions), entry[1], entry[2].lower(), entry[2]))
        rows = []
        for _, kind, name, value in entries:
            if kind == 0:
                rows.append(("group", depth, name))
                rows += walk(value, depth + 1)
            else:
                rows.append(("agent", depth, value))
        return rows

    return walk(root, 0)


def print_agents(items, as_json=False, tty=None):
    if as_json:
