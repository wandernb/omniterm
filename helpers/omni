                    preview = wrapped_preview(prompt_value, max(8, prompt_width - 21), 1)[0]
                    line = f"{marker} {prompt_label:<14} {preview}  ↗"
                    tui_text(window, prompt_y + prompt_index, x, line, style, prompt_width)
                    hitboxes.append((prompt_y + prompt_index, prompt_y + prompt_index,
                                     x, x + prompt_width - 1, "view_prompt", prompt_index))
                run_y = prompt_y + len(prompt_items()) + 1
            panel_bottom = body_y + body_height - 2
            if run_y < panel_bottom:
                tui_text(window, run_y, x, "RECENT RUNS", palette["blue"] | curses.A_BOLD, right_width - 6)
            max_run_rows = max(0, panel_bottom - run_y - 1)
            agent_runs = [run for run in runs if run["agent"] == agent["name"]][:max_run_rows]
            for offset, run in enumerate(agent_runs):
                state_style = palette["green"] if run["state"] == "running" else palette["red"] if run["state"] in {"failed", "timed_out"} else palette["muted"]
                chosen_run = focus == "runs" and offset == selected_run
                symbol = "▶" if chosen_run else "●" if run["state"] == "running" else "◆"
                style = state_style | (curses.A_BOLD | curses.A_REVERSE if chosen_run else 0)
                tui_text(window, run_y + 1 + offset, x, f"{symbol} {run['state']:<10} {fmt_time(run['started'])[5:]}  {run['id'][:8]}", style, right_width - 6)
                hitboxes.append((run_y + 1 + offset, run_y + 1 + offset, x, x + right_width - 7, "resume_run", offset))

        actions = [("add", "＋ Add"), ("edit", "✎ Edit"), ("run", "▶ Run"), ("resume", "↻ Resume"), ("stop", "■ Stop"), ("toggle", "◉ Toggle"), ("delete", "⌫ Delete")]
        footer_y = height - 4
        cursor_x = 2
        for action, label in actions:
            button = f" {label} "
            if cursor_x + len(button) + 1 >= width:
                break
            style = palette["red"] if action == "delete" else palette["peach"]
            tui_text(window, footer_y, cursor_x, "[" + button + "]", style | curses.A_BOLD)
            hitboxes.append((footer_y, footer_y, cursor_x, cursor_x + len(button) + 1, action, None))
            cursor_x += len(button) + 4
        tui_text(window, height - 2, 2, "● " + message, palette["green"] if not message.startswith("Error") else palette["red"], width - 4)
        tui_text(window, height - 1, 2, "↑↓ navigate · ←→/Tab switch panel · Enter open/run/resume · a add · e edit · q refresh", palette["muted"], width - 4)
        window.refresh()

    try:
        while True:
            reload_data()
            render()
            key = window.getch()
            if key == -1 or key == ord("q"):
                reload_data(True)
            elif key in (curses.KEY_LEFT, curses.KEY_RIGHT, 9, curses.KEY_BTAB):
                panels = focus_panels()
                current = panels.index(focus) if focus in panels else 0
                direction = -1 if key in (curses.KEY_LEFT, curses.KEY_BTAB) else 1
                focus = panels[(current + direction) % len(panels)]
                selected_run = min(selected_run, max(0, len(selected_agent_runs()) - 1))
            elif key in (curses.KEY_UP, ord("k")) and agents:
                if focus == "runs" and selected_agent_runs():
                    selected_run = (selected_run - 1) % len(selected_agent_runs())
                elif focus == "prompts":
                    selected_prompt = (selected_prompt - 1) % len(prompt_items())
                else:
                    selected = (selected - 1) % len(agents)
                    selected_run = 0
                    selected_prompt = 0
            elif key in (curses.KEY_DOWN, ord("j")) and agents:
                if focus == "runs" and selected_agent_runs():
                    selected_run = (selected_run + 1) % len(selected_agent_runs())
                elif focus == "prompts":
                    selected_prompt = (selected_prompt + 1) % len(prompt_items())
                else:
                    selected = (selected + 1) % len(agents)
                    selected_run = 0
                    selected_prompt = 0
            elif key in (10, 13):
                if focus == "prompts":
                    view_prompt()
                else:
                    perform("resume" if focus == "runs" else "run")
            elif key == ord("r"):
                perform("run")
            elif key == ord("a"):
                perform("add")
            elif key == ord("e"):
                perform("edit")
            elif key == ord("s"):
                perform("stop")
            elif key in (ord("t"), ord(" ")):
                perform("toggle")
            elif key == ord("R"):
                perform("resume")
            elif key in (ord("d"), curses.KEY_DC):
                perform("delete")
            elif key == curses.KEY_MOUSE:
                try:
                    _, mouse_x, mouse_y, _, state = curses.getmouse()
                    if state & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                        for y1, y2, x1, x2, action, value in reversed(hitboxes):
                            if y1 <= mouse_y <= y2 and x1 <= mouse_x <= x2:
                                if action == "select":
                                    selected = value
                                    selected_run = 0
                                    selected_prompt = 0
                                    focus = "agents"
                                elif action == "view_prompt":
                                    selected_prompt = value
                                    focus = "prompts"
                                    view_prompt(value)
                                elif action == "resume_run":
                                    selected_run = value
                                    focus = "runs"
                                    perform("resume")
                                else:
                                    perform(action)
                                break
                except curses.error:
                    pass
            elif key == curses.KEY_RESIZE:
                window.clear()
    finally:
        print("\033[?1003l", end="", flush=True)


def dashboard():
    instance_id = request({"op": "ping"})["instance_id"]
    def heartbeat():
        while True:
            time.sleep(2)
            try:
                if request({"op": "ping"})["instance_id"] != instance_id:
                    os._exit(0)
            except BaseException:
                # The app may briefly replace its socket while rebuilding or
                # waking. Keep the dashboard alive and compare instance IDs
                # once the scheduler is reachable again.
                continue
    threading.Thread(target=heartbeat, daemon=True).start()
    curses.wrapper(dashboard_screen)


def dashboard_supervisor():
    while True:
        try:
            dashboard()
        except SystemExit:
            time.sleep(1)
        except BaseException as exc:
            print(f"\nDashboard restarting after error: {exc}", file=sys.stderr)
            time.sleep(1)


def normalized_cli_argv(argv):
    """Translate the original verb-first agent syntax for compatibility."""
    argv = list(argv)
    if len(argv) >= 2 and argv[0] == "agent":
        legacy = argv[1]
        if legacy == "add":
            return ["agents", "add", *argv[2:]]
        if legacy == "list":
            return ["agents", *argv[2:]]
        if legacy in {"edit", "show", "enable", "disable", "delete"} and len(argv) >= 3:
            action = [] if legacy == "show" else [legacy]
            return ["agent", argv[2], *action, *argv[3:]]
    return argv


def mcp_launcher_path():
    return Path.home() / ".local/bin/omni-mcp"


def provider_mcp_state(provider):
    command = [provider, "mcp", "get", "omni"]
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    output = result.stdout.strip()
    launcher = str(mcp_launcher_path())
    if result.returncode != 0:
        return {"provider": provider, "state": "missing", "detail": output}
    if launcher in output or str(mcp_launcher_path().resolve()) in output:
        return {"provider": provider, "state": "installed", "detail": output}
    return {"provider": provider, "state": "conflict", "detail": output}


def install_mcp(quiet=False):
    launcher = mcp_launcher_path()
    if not launcher.exists():
        raise SystemExit(f"Missing MCP launcher: {launcher}. Rebuild OmniTerm first.")
    results = []
    for provider in ("claude", "codex"):
        if not shutil.which(provider):
            results.append({"provider": provider, "state": "unavailable"})
            continue
        state = provider_mcp_state(provider)
        if state["state"] == "missing":
            command = ([provider, "mcp", "add", "--scope", "user", "omni", "--", str(launcher)]
                       if provider == "claude" else
                       [provider, "mcp", "add", "omni", "--", str(launcher)])
            installed = subprocess.run(command, text=True, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT)
            state = provider_mcp_state(provider) if installed.returncode == 0 else {
                "provider": provider, "state": "error", "detail": installed.stdout.strip()}
        results.append(state)
    if not quiet:
        for item in results:
            print(f"{item['provider']:8} {item['state']}")
            if item["state"] in {"conflict", "error"} and item.get("detail"):
                print("  " + item["detail"].replace("\n", "\n  "))
    return results


def mcp_status(as_json=False):
    states = []
    for provider in ("claude", "codex"):
        if shutil.which(provider):
            states.append(provider_mcp_state(provider))
        else:
            states.append({"provider": provider, "state": "unavailable"})
    try:
        instance = request({"op": "ping"})["instance_id"]
        scheduler = {"state": "connected", "instance_id": instance}
    except BaseException as exc:
        scheduler = {"state": "unavailable", "detail": str(exc)}
    value = {"launcher": str(mcp_launcher_path()), "launcher_exists": mcp_launcher_path().exists(),
             "scheduler": scheduler, "providers": states}
    if as_json:
        print(json.dumps(value, indent=2))
    else:
        print(f"launcher  {'ready' if value['launcher_exists'] else 'missing'}  {value['launcher']}")
        print(f"scheduler {scheduler['state']}")
        for item in states:
            print(f"{item['provider']:9} {item['state']}")
    return value


def mcp_round_trip():
    process = subprocess.Popen([str(mcp_launcher_path())], stdin=subprocess.PIPE,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               text=True, bufsize=1)
    try:
        def exchange(message):
            process.stdin.write(json.dumps(message) + "\n")
            process.stdin.flush()
            return json.loads(process.stdout.readline())
        initialized = exchange({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                                "params": {"protocolVersion": "2025-11-25", "capabilities": {},
                                           "clientInfo": {"name": "omni-doctor", "version": "1"}}})
        tools = exchange({"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}})
        agents = exchange({"jsonrpc": "2.0", "id": 3, "method": "tools/call",
                           "params": {"name": "list_agents", "arguments": {}}})
        if "error" in initialized or "error" in tools or agents.get("result", {}).get("isError"):
            raise RuntimeError("MCP round trip returned an error")
        return {"protocol": initialized["result"]["protocolVersion"],
                "tool_count": len(tools["result"]["tools"]),
                "agent_count": len(agents["result"]["structuredContent"]["agents"])}
    finally:
        process.terminate()
        process.wait(timeout=3)


def uninstall_mcp():
    for provider in ("claude", "codex"):
        if not shutil.which(provider):
            continue
        state = provider_mcp_state(provider)
        if state["state"] != "installed":
            print(f"{provider:8} {state['state']} (unchanged)")
            continue
        command = ([provider, "mcp", "remove", "--scope", "user", "omni"]
                   if provider == "claude" else [provider, "mcp", "remove", "omni"])
        result = subprocess.run(command, text=True, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT)
        print(f"{provider:8} {'removed' if result.returncode == 0 else 'error'}")


def cli_parser():
    parser = argparse.ArgumentParser(
        prog="omni",
        description="Manage scheduled Codex and Claude agents in OmniTerm.",
        epilog='''examples:
  omni                         Open the interactive dashboard
  omni agents                  List configured agents
  omni agents add .            Add the nearest AGENTS.md/CLAUDE.md project
  omni agent "Daily review"    Show one agent
  omni agent "Daily review" run
  omni runs --agent "Daily review"''',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subs = parser.add_subparsers(dest="command", metavar="COMMAND")
    subs.add_parser("dashboard", help="open the full-screen interactive interface")

    agents = subs.add_parser("agents", help="list agents or create a new one")
    agents.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    agent_commands = agents.add_subparsers(dest="agents_command", metavar="ACTION")
    add = agent_commands.add_parser("add", help="create an agent with an optional project path")
    add.add_argument("path", nargs="?", help="folder or file used for project discovery")
    listing = agent_commands.add_parser("list", help="list agents (same as ‘omni agents’)")
    listing.add_argument("--json", action="store_true", help="emit machine-readable JSON")

    agent = subs.add_parser("agent", help="show or operate on one named agent")
    agent.add_argument("name", help="agent name")
    agent.add_argument("action", nargs="?", default="show",
                       choices=["show", "edit", "run", "runs", "schedule", "enable", "disable", "delete"],
                       help="action to perform (default: show)")
    agent.add_argument("--json", action="store_true", help="emit machine-readable JSON")

    run = subs.add_parser("run", help="start an agent now"); run.add_argument("name")
    resume = subs.add_parser("resume", help="resume a recent provider session in a new tab"); resume.add_argument("run_id")
    runs = subs.add_parser("runs", help="list recent runs"); runs.add_argument("--agent"); runs.add_argument("--json", action="store_true")
    stop = subs.add_parser("stop", help="stop an active run"); stop.add_argument("run_id")
    subs.add_parser("settings", help="show global ~/.omni/settings.json values")
    schedule = subs.add_parser("schedule", help="preview an agent schedule").add_subparsers(dest="schedule_command")
    preview = schedule.add_parser("preview", help="show the next five occurrences"); preview.add_argument("name")
    mcp = subs.add_parser("mcp", help="install and diagnose Claude/Codex MCP access").add_subparsers(dest="mcp_command")
    mcp.add_parser("install", help="register Omni globally in Claude Code and Codex").add_argument("--quiet", action="store_true")
    mcp.add_parser("status", help="show launcher, scheduler, and provider registration state").add_argument("--json", action="store_true")
    mcp.add_parser("doctor", help="perform an MCP initialize, tool-list, and scheduler round trip")
    mcp.add_parser("uninstall", help="remove only OmniTerm-owned MCP registrations")
    return parser


def print_agents(items, as_json=False):
    if as_json:
        print(json.dumps(items, indent=2))
        return
    if not items:
        print("No agents configured. Run ‘omni agents add .’ to create one.")
        return
    print(f"{'NAME':28} {'PROVIDER':9} {'STATE':9} SCHEDULE")
    for item in items:
        print(f"{item['name'][:28]:28} {item['provider']:9} {'enabled' if item['enabled'] else 'disabled':9} {item['schedule']['phrase']}")


def print_agent(agent, as_json=False):
    if as_json:
        print(json.dumps(agent, indent=2))
        return
    timeout = agent.get("timeout_seconds")
    values = [
        ("Name", agent["name"]), ("Provider", agent["provider"]),
        ("State", "enabled" if agent["enabled"] else "disabled"),
        ("Workspace", agent["workspace"]), ("Model", agent.get("model") or "provider default"),
        ("Schedule", agent["schedule"]["phrase"]), ("Overlap", agent["overlap"]),
        ("Retention", "off" if timeout is None else f"{timeout}s"),
        ("Next run", fmt_time(agent.get("next_run"))),
    ]
    for label, value in values:
        print(f"{label:12} {value}")


def print_runs(items, as_json=False):
    if as_json:
        print(json.dumps(items, indent=2))
        return
    if not items:
        print("No runs found.")
        return
    print(f"{'RUN ID':36} {'AGENT':24} {'STATE':11} STARTED")
    for item in items:
        print(f"{item['id']:36} {item['agent'][:24]:24} {item['state']:11} {fmt_time(item['started'])}")


def preview_schedule(name):
    item = request({"op": "show_agent", "name": name})["agent"]
    timezone = request({"op": "get_settings"})["settings"].get("timezone") or system_timezone()
    cursor = item["next_run"]
    for _ in range(5):
        if cursor is None:
            break
        print(dt.datetime.fromtimestamp(cursor, ZoneInfo(timezone)).isoformat())
        cursor = next_calendar(item["schedule"], timezone, cursor)


def main(argv=None):
    args = cli_parser().parse_args(normalized_cli_argv(sys.argv[1:] if argv is None else argv))
    if args.command in {None, "dashboard"}:
        return dashboard_supervisor()
    if args.command == "agents":
        if args.agents_command == "add":
            return edit_agent(seed_path=args.path)
        items = request({"op": "list_agents"})["agents"]
        return print_agents(items, args.json)
    if args.command == "agent":
        if args.action == "edit": return edit_agent(request({"op": "show_agent", "name": args.name})["agent"])
        if args.action == "run": print(request({"op": "run_agent", "name": args.name})["run_id"]); return
        if args.action == "runs": return print_runs(request({"op": "list_runs", "name": args.name})["runs"], args.json)
        if args.action == "schedule": return preview_schedule(args.name)
        if args.action in {"enable", "disable"}: request({"op": "set_enabled", "name": args.name, "enabled": args.action == "enable"}); return
        if args.action == "delete": request({"op": "delete_agent", "name": args.name}); return
        return print_agent(request({"op": "show_agent", "name": args.name})["agent"], args.json)
    if args.command == "run": print(request({"op": "run_agent", "name": args.name})["run_id"]); return
    if args.command == "resume": print(request({"op": "resume_run", "run_id": args.run_id})["run_id"]); return
    if args.command == "runs": return print_runs(request({"op": "list_runs", "name": args.agent})["runs"], args.json)
    if args.command == "stop": request({"op": "stop_run", "run_id": args.run_id}); return
    if args.command == "settings": print(json.dumps(request({"op": "get_settings"})["settings"], indent=2)); return
    if args.command == "schedule" and args.schedule_command == "preview": return preview_schedule(args.name)
    if args.command == "mcp":
        if args.mcp_command == "install": return install_mcp(args.quiet)
        if args.mcp_command == "status": return mcp_status(args.json)
        if args.mcp_command == "doctor": print(json.dumps(mcp_round_trip(), indent=2)); return
        if args.mcp_command == "uninstall": return uninstall_mcp()
        return cli_parser().parse_args(["mcp", "--help"])


if __name__ == "__main__":
    main()
