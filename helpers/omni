            marker = "▶" if chosen and focus == "agents" else "◆" if chosen else " "
            state = "● ON" if agent["enabled"] else "○ OFF"
            state_style = palette["green"] if agent["enabled"] else palette["muted"]
            tui_text(window, y, 3, f"{marker} {agent['name']}", card_style, left_width - 18)
            tui_text(window, y, left_width - 10, state, state_style | curses.A_BOLD, 7)
            tui_text(window, y + 1, 5, f"{agent['provider']}  ·  {agent['schedule']['phrase']}", palette["muted"], left_width - 8)
            next_text = fmt_time(agent.get("next_run"))
            tui_text(window, y + 2, 5, f"◷ {next_text}   ↻ {agent['overlap']}", palette["blue"], left_width - 8)
            hitboxes.append((y, y + 2, 2, left_width, "select", index))

