ACTIVE_RUN_STATES = {"starting", "running"}


def process_ancestors(start=None):
    """Parent, grandparent, … of this process, from one ps snapshot."""
    try:
        output = subprocess.run(["/bin/ps", "-axo", "pid=,ppid="], text=True, capture_output=True,
                                timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    parents = {}
    for line in output.splitlines():
        fields = line.split()
        if len(fields) == 2 and fields[0].isdigit() and fields[1].isdigit():
            parents[int(fields[0])] = int(fields[1])
    ancestors = []
    pid = os.getppid() if start is None else start
    while pid > 1 and pid not in ancestors and len(ancestors) < 64:
        ancestors.append(pid)
        pid = parents.get(pid, 0)
    return ancestors


def current_run_id(list_runs, environment=None, ancestors=None):
    """The OmniTerm run this process belongs to, if any.

    The runner exports OMNI_RUN_ID. Providers that clear the environment of
    their tool servers (Codex does) are matched by process ancestry instead:
    the runner records its own PID and the provider's process group.
    """
    environment = os.environ if environment is None else environment
    run_id = (environment.get("OMNI_RUN_ID") or "").strip()
    if run_id:
        return run_id
    ancestry = set(process_ancestors() if ancestors is None else ancestors)
    if not ancestry:
        return None
    for run in list_runs():
        if run.get("state") not in ACTIVE_RUN_STATES:
            continue
        if run.get("pid") in ancestry or run.get("pgid") in ancestry:
            return run.get("id")
    return None


# What OmniTerm's own producers may call a notification. Agents never pass a
