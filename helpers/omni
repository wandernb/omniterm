def agent_form_choices(key, values):
    choices = {
        "provider": ["codex", "claude"],
        "repeat_count": [str(value) for value in range(1, 31)],
        "repeat_unit": ["minutes", "hours", "days", "weekdays", "weeks", "months", "once"],
        "overlap": ["replace", "parallel"],
        "timeout": ["30m", "1h", "2h", "4h", "8h", "off"],
    }
    if key == "model":
        return model_choices(values.get("provider", "codex"))
    if key == "permission_mode":
        if values.get("provider") == "claude":
            return ["", "default", "auto-mode", "acceptEdits", "bypassPermissions",
                    "manual", "dontAsk", "plan"]
        return ["", "default", "untrusted", "on-request", "never", DANGEROUS_PERMISSIONS["codex"]]
    if key == "repeat_on":
        unit = values.get("repeat_unit")
        if unit == "hours":
            return [f"{value:02}" for value in range(60)]
        if unit in {"days", "weekdays"}:
            return [f"{hour:02}:{minute:02}" for hour in range(24) for minute in (0, 15, 30, 45)]
        if unit == "weeks":
            return ["monday", "tuesday", "wednesday", "thursday",
                    "friday", "saturday", "sunday"]
        if unit == "months":
            return [str(value) for value in range(1, 32)]
        return []
    if key == "repeat_time":
        if values.get("repeat_unit") in {"weeks", "months"}:
            return [f"{hour:02}:{minute:02}" for hour in range(24) for minute in (0, 15, 30, 45)]
        return []
    return choices.get(key, [])


def agent_form_label(key, fallback, values):
    unit = values.get("repeat_unit")
    if key == "repeat_on":
        return {"hours": "At minute", "days": "At time", "weekdays": "At time",
                "weeks": "On weekday", "months": "On day", "once": "Run once at"}.get(unit,
                                                                                         "Alignment")
    if key == "repeat_time" and unit not in {"weeks", "months"}:
        return "At time · unused"
    return fallback


def workspace_path_options(value):
    """Return directory completions beneath the current shell-style path input."""
    shown = value or "."
    expanded = Path(shown).expanduser()
    if expanded.is_dir():
        current = expanded.resolve()
        prefix = display_path(current)
        query = prefix + ("" if prefix == os.sep else os.sep)
        return [("child", child) for child in path_completion_matches(query)]
    return [("child", match) for match in path_completion_matches(shown)]


def shell_path_tab(value, state):
    """Apply shell-like directory completion and preserve a repeated-Tab cycle."""
    if (state.get("matches") and
            (value == state.get("query") or value in state.get("matches", []))):
        state["index"] = (state.get("index", -1) + 1) % len(state["matches"])
        return state["matches"][state["index"]], state

    matches = path_completion_matches(value)
    expanded = Path(value or ".").expanduser()
    if expanded.is_dir() and not value.endswith(os.sep):
        completed = display_path(expanded.resolve())
        completed += "" if completed == os.sep else os.sep
        return completed, {"query": None, "matches": [], "index": -1}
    if not matches:
        return value, {"query": value, "matches": [], "index": -1}

    common = os.path.commonprefix(matches)
    if len(common) > len(value):
        return common, {"query": None, "matches": [], "index": -1}
    return matches[0], {"query": value, "matches": matches, "index": 0}


def _field_preview(key, value, width):
    if key == "__save__":
        return "Save configuration"
    if key == "model" and not value:
        return "provider default"
    if key == "permission_mode" and not value:
        return "provider default"
    if key == "permission_mode" and value == "auto":
        return "auto-mode"
    if key in {"system_prompt", "startup_prompt"}:
        value = (value or "").replace("\n", " ↵ ")
    value = str(value or "")
    return value if len(value) <= width else "…" + value[-max(1, width - 1):]


