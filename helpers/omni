def notification_counts(notifications):
    """Unread counts per agent, and notification counts per run, for the dashboard."""
    per_agent, per_run = {}, {}
    for item in notifications:
        agent, run_id = item.get("agent"), item.get("run_id")
        if agent and item.get("unread"):
            per_agent[agent] = per_agent.get(agent, 0) + 1
        if run_id:
            unread, total = per_run.get(run_id, (0, 0))
            per_run[run_id] = (unread + bool(item.get("unread")), total + 1)
    return per_agent, per_run


