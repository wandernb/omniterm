def run_state_label(run):
    """A live run whose agent finished its turn is idle, waiting for the person, not running."""
    if run.get("state") in ACTIVE_RUN_STATES and run.get("turn_finished") == 1:
        return "idle"
    if run.get("state") == "evicted" and run.get("turn_finished") is None:
        return "ended"  # Closed by retention before turns were tracked: the outcome is unknown.
    return run.get("state", "")


