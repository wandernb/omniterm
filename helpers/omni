                    for line in wrapped_preview(prompt_value, prompt_width, line_limit):
                        tui_text(window, prompt_y, x + 2, line, palette["muted"], prompt_width - 2)
                        prompt_y += 1
                    hitboxes.append((block_y, prompt_y - 1, x, x + prompt_width - 1,
                                     "view_prompt", prompt_index))
                    prompt_y += 1
                run_y = prompt_y
            else:
                prompt_y = y + 3 + len(details)
                prompt_width = right_width - 6
                for prompt_index, (prompt_label, prompt_value) in enumerate(prompt_items()):
                    chosen_prompt = focus == "prompts" and prompt_index == selected_prompt
                    marker = "▶" if chosen_prompt else "◇"
