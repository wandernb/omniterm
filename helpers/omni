    return ["provider default", *values, "Custom model…"]


def path_completion_matches(text):
    original = text or ""
    expanded = os.path.expanduser(original or ".")
    if expanded.endswith(os.sep):
        base, prefix = Path(expanded), ""
    else:
        base, prefix = Path(expanded).parent, Path(expanded).name
    try:
        directories = sorted((item for item in base.iterdir()
                              if item.is_dir() and item.name.startswith(prefix)),
                             key=lambda item: item.name.lower())
    except OSError:
        return []
    matches = []
    for item in directories:
        if original.startswith("~"):
            value = "~" + str(item)[len(str(Path.home())):]
        elif os.path.isabs(original):
            value = str(item)
        else:
            parent = os.path.dirname(original)
            value = os.path.join(parent, item.name) if parent else item.name
        matches.append(value + "/")
    return matches


def _graph_node(node):
    return f"{node['path']}:{node['line']}  {node['kind']} {node['qualname']}"


def _graph_edge(edge):
    mark = "" if edge["confidence"] == "extracted" else "  [inferred]"
    if "to" in edge:
        return f"{_graph_node(edge['to'])}{mark}"
    return f"{edge['path']}:{edge['line']}  {edge['from']}{mark}"


def graph_text(mode, result):
    """Short lines for a person; --json keeps the full answer."""
    text = _graph_text(mode, result)
    indexing = result.get("indexing")
    if indexing:
        text += f"\n(Still indexing this project: {indexing.get('pending_files', 0)} files queued; the answer may be partial.)"
    return text


def _graph_text(mode, result):
    lines = []
    if result.get("ambiguous"):
        lines.append("Several matches; give a dotted name, --project or a path:")
        lines.extend("  " + _graph_node(node) for node in result["candidates"])
        return "\n".join(lines)
    if result.get("found") is False:
        return "No match" + (f" (searched {result['searched']} nodes)" if "searched" in result else "") + "."
    if mode == "query":
        lines.extend(_graph_node(node) for node in result["results"])
        if result["total"] > len(result["results"]):
            lines.append(f"... {result['total'] - len(result['results'])} more")
        return "\n".join(lines) or "No match."
    if mode == "explain":
        lines.append(_graph_node(result["node"]))
        if result.get("file_error"):
            lines.append(f"  (file only partly read: {result['file_error']})")
        for key in ("callers", "callees", "importers", "subclasses", "members", "memories"):
            items = result.get(key) or []
            total = result.get("counts", {}).get(key, len(items))
            if not items:
                continue
            lines.append(f"{key.capitalize()} ({total}):")
            for item in items:
                if key == "members":
                    lines.append("  " + _graph_node(item))
                elif key == "memories":
                    lines.append(f"  {item.get('id')}  {item.get('title')}")
                else:
                    lines.append("  " + _graph_edge(item))
        return "\n".join(lines)
    if mode == "neighbors":
        lines.append(_graph_node(result["node"]))
        for item in result["neighbors"]:
            arrow = "<-" if item["direction"] == "in" else "->"
            mark = "" if item["confidence"] == "extracted" else "  [inferred]"
            lines.append(f"  {arrow} {item['edge']:<8} {_graph_node(item['node'])}{mark}")
        return "\n".join(lines)
    if mode == "affected":
        lines.append(f"{result['total']} dependents of {result['node']['qualname']}"
                     + (" (stopped at the limit)" if result.get("truncated") else "") + ":")
        for item in result["affected"]:
            mark = "" if item["confidence"] == "extracted" else "  [inferred]"
            lines.append(f"  {item['depth']}  {_graph_node(item['node'])}  via {item['via']}{mark}")
        if result.get("files"):
            lines.append("Files: " + ", ".join(result["files"]))
        return "\n".join(lines)
    if mode == "path":
        lines.append(f"{result['length']} hops, {result['confidence']}:")
        if result["hops"]:
            lines.append("  " + _graph_node(result["hops"][0]["from"]))
        for hop in result["hops"]:
            arrow = "->" if hop["direction"] == "out" else "<-"
            lines.append(f"  {arrow} {hop['edge']:<8} {_graph_node(hop['to'])}")
        return "\n".join(lines)
    if mode == "stats":
        status = result["status"]
        lines.append(f"{status['projects']} projects, {status['indexed_files']} of {status['files']} files indexed"
                     + (f", {status['pending']} queued" if status.get("pending") else ""))
        for project in result["projects"]:
            languages = ", ".join(f"{name} {count}" for name, count in sorted(project["languages"].items()))
            lines.append(f"  {project['label'] or project['project']}: {project['nodes']} nodes, "
                         f"{project['references']} references ({languages or 'no source files'})"
                         + (f", {project['pending']} queued" if project["pending"] else ""))
        for error in result.get("file_errors") or []:
            lines.append(f"  ! {error['path']}: {error['error']}")
        return "\n".join(lines)
    return result.get("markdown") or json.dumps(result, indent=2, ensure_ascii=False)


def graph_from_cli(args):
